            "serving_size": "",
            "calories": "",
            "nutrients_text": "",
            "panel_footnote": "* Percent Daily Values are based on a 2,000 calorie diet.",
            "callout_1_title": "Why D3 + K2 together?",
            "callout_1_body": "Research increasingly points to their relationship in supporting where calcium actually ends up in the body. Vitamin D3 without K2 is a conversation half finished.",
            "callout_1_accent": "#1fa8a1",
            "callout_2_title": "Why 1,200mg sodium daily?",
            "callout_2_body": "Sodium drives fluid absorption — without enough of it, water passes through instead of reaching your cells. Daily replacement is foundational.",
            "callout_2_accent": "#e8833a",
            "callout_3_title": "Why no caffeine?",
            "callout_3_body": "Everyday is for the long game — your daily ritual, any time of day. If you want a clean lift, Energy is built for those moments.",
            "callout_3_accent": "#8e8e93"
          }
        },
        "product_tab_hhytyE": {
          "type": "product_tab",
          "settings": {
