        "faq_item_VDHqY3": {
          "type": "faq_item",
          "settings": {
            "question": "Why Natural Caffeine in Energy but not Everyday?",
            "answer": "Energy is for performance moments. Everyday is your daily foundation, caffeine-free by design.",
            "tags": "energy,everyday",
            "open_by_default": true
          }
        },
        "faq_item_LK8NMF": {
          "type": "faq_item",
          "settings": {
            "question": "Is there any sugar in Fortified Energy?",
            "answer": "Zero added sugar. We sweeten with monk fruit and a touch of stevia. The 3g of carbs are trace from whole-food ingredients.",
            "tags": "energy",
            "open_by_default": false
          }
        },
        "faq_item_7pGjbQ": {
          "type": "faq_item",
          "settings": {
            "question": "Why such high sodium?",
            "answer": "Sodium drives fluid absorption and is the primary electrolyte lost in sweat. Our 1,210mg dose matches what active adults actually lose during exertion.",
            "tags": "energy,everyday",
            "open_by_default": false
          }
        },
        "faq_item_33BHkV": {
          "type": "faq_item",
          "settings": {
            "question": "Is creatine safe long-term?",
            "answer": "Creatine monohydrate has more peer-reviewed safety data than nearly any sports supplement. 500+ studies and decades of use.",
            "tags": "creatine",
            "open_by_default": false
          }
        },
        "faq_item_fjt8Mp": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to cycle creatine?",
            "answer": "No. The data is clear: continuous daily dosing is both safe and more effective than cycling.",
            "tags": "creatine",
            "open_by_default": false
          }
        },
        "faq_item_nNC7VQ": {
          "type": "faq_item",
          "settings": {
            "question": "Why no proprietary blends?",
            "answer": "Because you deserve to know exactly what you are putting in your body. Every milligram, every ingredient, fully disclosed.",
            "tags": "energy,everyday,creatine",
            "open_by_default": false
          }
