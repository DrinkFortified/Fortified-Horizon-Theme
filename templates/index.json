            "tab_image": "shopify://shop_images/Energy.svg",
            "accent_color": "#ef3a53",
            "start_active": false,
            "eyebrow": "Why These Numbers Matter",
            "heading": "Energy label",
            "panel_title": "Supplement Facts",
            "servings_per": "",
            "serving_size": "",
            "calories": "",
            "nutrients_text": "",
            "panel_footnote": "* Percent Daily Values are based on a 2,000 calorie diet.",
            "callout_1_title": "Why 150mg natural caffeine?",
            "callout_1_body": "A meaningful lift — about a strong cup of coffee — from the same source humans have used for centuries, delivered without the synthetic-stimulant baggage.",
            "callout_1_accent": "#e8833a",
            "callout_2_title": "Why 1,200mg sodium?",
            "callout_2_body": "Sodium is the primary electrolyte lost in sweat and the one that actually drives fluid absorption. Most hydration brands underdose it; we don't.",
            "callout_2_accent": "#1fa8a1",
            "callout_3_title": "Why no D3 on Energy?",
            "callout_3_body": "Energy is your performance moment. Vitamin D3 belongs in your daily foundation — that's what Everyday is for.",
