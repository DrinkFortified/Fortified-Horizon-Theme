{% render 'fortified-base' %}

{%- liquid
  assign tab_labels = ''
  for block in section.blocks
    if block.type == 'fortified-tab'
      assign tab_labels = tab_labels | append: block.settings.tab_label | append: '|'
    endif
  endfor
  assign tab_array = tab_labels | split: '|'
-%}

<section
  id="FortifiedIngredients-{{ section.id }}"
  class="fortified-ingredients color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  data-fortified-ingredients
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 100 }}px {{ section.settings['padding-block-end'] | default: 100 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 40 }}px {{ section.settings['padding-inline-end'] | default: 40 }}px;"
>
  <div class="fortified-ingredients__inner">
    <header class="fortified-ingredients__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-ingredients__eyebrow">{{ section.settings.eyebrow | replace: '*', '' }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-ingredients__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="fortified-ingredients__body">{% render 'fortified-accent-text', text: section.settings.body %}</p>
      {% endif %}

      {% if tab_array.size > 0 %}
        <div class="fortified-ingredients__tabs" role="tablist">
          {% for label in tab_array %}
            {% if label != blank %}
              <button
                type="button"
                class="fortified-ingredients__tab {% if forloop.first %}is-active{% endif %}"
                role="tab"
                data-tab="{{ label | handleize }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <span class="fortified-ingredients__tab-label">{{ label }}</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </header>

    <div class="fortified-ingredients__panels">
      {%- assign first_tab = tab_array | first | handleize -%}
      {% for block in section.blocks %}
        {% if block.type == 'fortified-ingredient' %}
          {%- assign tab_handle = block.settings.tab | handleize -%}
          <article
            class="fortified-ingredients__row"
            data-tab-target="{{ tab_handle }}"
            {% unless tab_handle == first_tab %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- assign ing_badge = block.settings.badge_label | default: block.settings.benefit_badge -%}
            {%- assign ing_dose_amount = block.settings.dosage_amount | default: block.settings.dosage_badge -%}
            <div class="fortified-ingredients__row-main">
              <div class="fortified-ingredients__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag:
                      widths: '220, 440, 600',
                      sizes: '220px',
                      class: 'fortified-ingredients__img',
                      alt: block.settings.ingredient_name,
                      loading: 'lazy' }}
                {% else %}
                  <div class="fortified-ingredients__img fortified-ingredients__img--placeholder" aria-hidden="true"></div>
                {% endif %}
              </div>
              <div class="fortified-ingredients__info">
                <h3 class="fortified-ingredients__name">{% render 'fortified-accent-text', text: block.settings.ingredient_name %}</h3>
                {% if block.settings.description != blank %}
                  <p class="fortified-ingredients__desc">{% render 'fortified-accent-text', text: block.settings.description %}</p>
                {% endif %}
                {% if ing_badge != blank %}
                  <span class="fortified-ingredients__badge">{{ ing_badge }}</span>
                {% endif %}
              </div>
            </div>
            {% if ing_dose_amount != blank or block.settings.dosage_unit != blank %}
              <div class="fortified-ingredients__divider" aria-hidden="true"></div>
              <div class="fortified-ingredients__dosage">
                {% if ing_dose_amount != blank %}
                  <p class="fortified-ingredients__dosage-amount">{{ ing_dose_amount }}</p>
                {% endif %}
                {% if block.settings.dosage_unit != blank %}
                  <p class="fortified-ingredients__dosage-unit">{{ block.settings.dosage_unit }}</p>
                {% endif %}
              </div>
            {% endif %}
            {% if block.settings.benefit_title != blank or block.settings.benefit_icon != blank %}
              <div class="fortified-ingredients__divider" aria-hidden="true"></div>
              <div class="fortified-ingredients__benefit">
                {% if block.settings.benefit_icon != blank %}
                  {{ block.settings.benefit_icon | image_url: width: 164 | image_tag:
                      widths: '82, 164',
                      sizes: '82px',
                      class: 'fortified-ingredients__benefit-icon',
                      alt: '',
                      loading: 'lazy' }}
                {% endif %}
                <div class="fortified-ingredients__benefit-text">
                  {% if block.settings.benefit_title != blank %}
                    <p class="fortified-ingredients__benefit-title">{% render 'fortified-accent-text', text: block.settings.benefit_title %}</p>
                  {% endif %}
                  {% if block.settings.benefit_description != blank %}
                    <p class="fortified-ingredients__benefit-desc">{% render 'fortified-accent-text', text: block.settings.benefit_description %}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-ingredients__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('FortifiedIngredients-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.fortified-ingredients__tab');
    var panels = root.querySelectorAll('.fortified-ingredients__row');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          if (panel.getAttribute('data-tab-target') === target) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      });
    });
  })();
</script>

{% stylesheet %}
  .fortified-ingredients {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-ingredients__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    max-width: var(--fortified-container);
    margin-inline: auto;
  }
  .fortified-ingredients__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 42px;
    max-width: 720px;
    text-align: center;
  }
  .fortified-ingredients__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-ingredients__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-ingredients__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }

  .fortified-ingredients__tabs {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .fortified-ingredients__tab {
    flex: 0 0 240px;
    background: transparent;
    border: 0;
    padding: 0 0 8px;
    cursor: pointer;
    border-bottom: 2px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    text-align: center;
  }
  .fortified-ingredients__tab-label {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-transform: uppercase;
  }
  .fortified-ingredients__tab.is-active {
    border-bottom-color: var(--color-foreground);
  }
  .fortified-ingredients__tab.is-active .fortified-ingredients__tab-label {
    font-weight: 600;
  }

  .fortified-ingredients__panels {
    display: flex;
    flex-direction: column;
    gap: 42px;
    width: 100%;
  }
  .fortified-ingredients__row {
    display: flex;
    align-items: center;
    gap: 42px;
    width: 100%;
  }
  .fortified-ingredients__row[hidden] { display: none; }

  .fortified-ingredients__row-main {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .fortified-ingredients__media {
    flex: 0 0 220px;
    width: 220px;
    height: 137px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .fortified-ingredients__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .fortified-ingredients__img--placeholder {
    background:
      linear-gradient(135deg,
        color-mix(in srgb, var(--color-foreground) 4%, transparent),
        color-mix(in srgb, var(--color-foreground) 14%, transparent));
    border-radius: 10px;
  }
  .fortified-ingredients__info {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .fortified-ingredients__name {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-ingredients__desc {
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    margin: 0;
  }
  .fortified-ingredients__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 41px;
    min-width: 183px;
    padding: 0 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    font-family: var(--font-fortified-display);
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .fortified-ingredients__divider {
    flex: 0 0 1px;
    width: 1px;
    height: 137px;
    background: color-mix(in srgb, var(--color-foreground) 22%, transparent);
  }

  .fortified-ingredients__dosage {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-foreground);
  }
  .fortified-ingredients__dosage-amount {
    font-family: var(--font-fortified-display);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .fortified-ingredients__dosage-unit {
    font-family: var(--font-fortified-display);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .fortified-ingredients__benefit {
    flex: 0 0 auto;
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .fortified-ingredients__benefit-icon {
    width: 82px;
    height: 82px;
    object-fit: contain;
    flex: 0 0 82px;
  }
  .fortified-ingredients__benefit-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fortified-ingredients__benefit-title {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-ingredients__benefit-desc {
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    margin: 0;
  }

  .fortified-ingredients__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-ingredients__inner { gap: 48px; }
    .fortified-ingredients__heading { font-size: 44px; }
    .fortified-ingredients__row { flex-wrap: wrap; gap: 24px; }
    .fortified-ingredients__row-main { flex: 1 0 100%; }
    .fortified-ingredients__divider { display: none; }
  }
  @media (max-width: 749px) {
    .fortified-ingredients__heading { font-size: 32px; }
    .fortified-ingredients__tab { flex: 1 0 0; }
    .fortified-ingredients__tab-label { font-size: 20px; }
    .fortified-ingredients__row-main { flex-direction: column; align-items: flex-start; }
    .fortified-ingredients__media { width: 100%; flex: 1 0 auto; }
    .fortified-ingredients__cta { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "06 — Ingredients",
  "tag": "section",
  "class": "fortified-ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color. Use line breaks to split into multiple lines.",
      "default": "WHY WE BEAT THE REST\n*electrolytes*"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "Electrolytes don't provide full recovery."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP FORTIFIED NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fortified-tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Hydration"
        }
      ]
    },
    {
      "type": "fortified-ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "tab",
          "label": "Tab",
          "info": "Type the tab label this ingredient belongs to.",
          "default": "Hydration"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image"
        },
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient name",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Sodium Citrate"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Essential electrolyte to support fluid balance, hydration, and muscle function"
        },
        {
          "type": "text",
          "id": "badge_label",
          "label": "Badge label",
          "default": "HYDRATION"
        },
        {
          "type": "text",
          "id": "dosage_amount",
          "label": "Dosage amount",
          "default": "1200MG"
        },
        {
          "type": "text",
          "id": "dosage_unit",
          "label": "Dosage unit",
          "default": "PER SERVINGS"
        },
        {
          "type": "image_picker",
          "id": "benefit_icon",
          "label": "Benefit icon"
        },
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit title",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Hydration Facts"
        },
        {
          "type": "textarea",
          "id": "benefit_description",
          "label": "Benefit description",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Supports muscle function\nand reduces cramps"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "06 — Ingredients",
      "category": "Fortified Home",
      "settings": {},
      "blocks": [
        { "type": "fortified-tab", "settings": { "tab_label": "Hydration" } },
        { "type": "fortified-tab", "settings": { "tab_label": "Performance" } },
        { "type": "fortified-ingredient", "settings": { "tab": "Hydration", "ingredient_name": "Sodium Citrate", "badge_label": "HYDRATION", "dosage_amount": "1200MG" } },
        { "type": "fortified-ingredient", "settings": { "tab": "Hydration", "ingredient_name": "Magnesium Glycinate", "badge_label": "HYDRATION", "dosage_amount": "150MG" } },
        { "type": "fortified-ingredient", "settings": { "tab": "Performance", "ingredient_name": "Creatine", "badge_label": "PERFORMANCE", "dosage_amount": "3G" } }
      ]
    }
  ]
}
{% endschema %}
