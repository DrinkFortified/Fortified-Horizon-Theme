{% render 'fortified-base' %}

<div
  id="FortifiedAnnouncement-{{ section.id }}"
  class="fortified-announcement color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--fa-bg: ; --fa-text: ; --fa-speed: {{ section.settings.speed }}s;"
>
  <div class="fortified-announcement__track" aria-hidden="false">
    <div class="fortified-announcement__group">
      {% assign items = section.settings.marquee_text | newline_to_br | split: '<br />' %}
      {% for raw in items %}
        {% assign txt = raw | strip %}
        {% if txt != blank %}
          <span class="fortified-announcement__item">{{ txt }}</span>
          <span class="fortified-announcement__sep" aria-hidden="true">·</span>
        {% endif %}
      {% endfor %}
    </div>
    <div class="fortified-announcement__group" aria-hidden="true">
      {% for raw in items %}
        {% assign txt = raw | strip %}
        {% if txt != blank %}
          <span class="fortified-announcement__item">{{ txt }}</span>
          <span class="fortified-announcement__sep" aria-hidden="true">·</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fortified-announcement {
    background: var(--fa-bg, var(--color-background));
    color: var(--fa-text, var(--color-foreground));
    overflow: hidden;
    width: 100%;
    padding: 10px 0;
  }
  .fortified-announcement__track {
    display: flex;
    width: max-content;
    animation: fortified-marquee var(--fa-speed, 28s) linear infinite;
  }
  .fortified-announcement__group {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-inline: 14px;
    flex-shrink: 0;
  }
  .fortified-announcement__item {
    font-family: var(--font-fortified-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .fortified-announcement__sep {
    opacity: .7;
    font-size: 12px;
  }
  @keyframes fortified-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fortified-announcement__track { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Announcement Bar",
  "tag": "section",
  "class": "fortified-announcement-section",
  "settings": [
    {
      "type": "textarea",
      "id": "marquee_text",
      "label": "Marquee text (one per line)",
      "default": "Science Based\nNo Sugar\nZero Crash\nClean Ingredients\nClinically Backed"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (seconds)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 28
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#1FA8A1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Fortified Announcement Bar",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
