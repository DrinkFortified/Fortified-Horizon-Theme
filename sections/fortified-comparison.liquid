{% comment %}
  Section: FTD - Comparison Table
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Comparison grid of Fortified vs N competitor brands. Feature rows are
  blocks; competitor columns are blocks. The Fortified column is built
  from section settings and the fortified_value of each feature_row.

  Desktop: full table grid with Fortified column emphasized.
  Mobile : feature labels sticky on the left, columns scroll horizontally
           with scroll-snap; Fortified column comes first.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'ftcmp-' | append: sid
  assign anchor_id = section.settings.anchor_id | strip | handleize
  if anchor_id != blank
    assign root = anchor_id
  endif

  assign feature_rows = section.blocks | where: 'type', 'feature_row'
  assign competitors  = section.blocks | where: 'type', 'competitor'

  # Per-product override via product.fortified.pdp_extra metaobject.
  assign px = product.metafields.fortified.pdp_extra.value
  assign use_pdp_rows = false
  assign use_pdp_competitors = false
  assign eyebrow_v    = section.settings.eyebrow
  assign heading_v    = section.settings.heading
  assign subheading_v = section.settings.subheading
  assign cta_label_v  = section.settings.cta_label
  if px != blank
    if px.comparison_eyebrow != blank
      assign eyebrow_v = px.comparison_eyebrow
    endif
    if px.comparison_heading != blank
      assign heading_v = px.comparison_heading
    endif
    if px.comparison_subheading != blank
      assign subheading_v = px.comparison_subheading
    endif
    if px.comparison_cta_label != blank
      assign cta_label_v = px.comparison_cta_label
    endif
    if px.comparison_rows.value != blank and px.comparison_rows.value.size > 0
      assign feature_rows = px.comparison_rows.value
      assign use_pdp_rows = true
    endif
    if px.comparison_competitors.value != blank and px.comparison_competitors.value.size > 0
      assign competitors = px.comparison_competitors.value
      assign use_pdp_competitors = true
    endif
  endif

  assign col_count = competitors.size | plus: 2
  assign cta_style = section.settings.cta_style | default: 'outline'

  # Per-context icon colors. Blank = keep the historical behavior (both the
  # Fortified-column cross and the competitor check circle reused cross_color).
  assign fortified_cross_c = section.settings.fortified_cross_color | default: section.settings.cross_color
  assign comp_check_c = section.settings.comp_check_color | default: section.settings.cross_color
-%}

<style>
  #{{ root }} {
    --{{ root }}-max-w: {{ section.settings.content_max_width }}px;
    --{{ root }}-accent: {{ section.settings.eyebrow_color }};
    --{{ root }}-fcol-bg: {{ section.settings.fortified_column_color }};
    --{{ root }}-fcol-fg: {{ section.settings.fortified_text_color }};
    --{{ root }}-check: {{ section.settings.check_color }};
    --{{ root }}-cross: {{ section.settings.cross_color }};
    --{{ root }}-fcross: {{ fortified_cross_c }};
    --{{ root }}-comp-check: {{ comp_check_c }};
    --{{ root }}-radius: {{ section.settings.table_radius }}px;
  }
  #{{ root }} .{{ root }}__inner {
    max-width: var(--{{ root }}-max-w);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  #{{ root }} .{{ root }}__head {
    text-align: center;
    margin: 0 auto var(--ftd-s7, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ftd-s3, 12px);
    max-width: 720px;
  }
  #{{ root }} .{{ root }}__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: var(--ftd-eyebrow-size);
    font-weight: 700;
    letter-spacing: var(--ftd-eyebrow-spacing);
    text-transform: uppercase;
    color: var(--{{ root }}-accent);
  }
  #{{ root }} .{{ root }}__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: var(--ftd-h2-size);
    font-weight: 800;
    line-height: var(--ftd-h2-line);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  #{{ root }} .{{ root }}__sub {
    margin: 0;
    font-size: var(--ftd-sub-size);
    line-height: var(--ftd-sub-line);
    opacity: 0.78;
  }

  /* Wrap holds the scroll container + the swipe hint */
  #{{ root }} .{{ root }}__wrap { position: relative; }

  /* Horizon renders .section as a CSS grid, and grid items default to
     min-width: auto — they refuse to shrink below their content's
     minimum width. On phones the fixed mobile column widths total more
     than the viewport, so without this the whole PAGE scrolled sideways
     instead of the table scrolling inside its own container. */
  #{{ root }} .{{ root }}__inner,
  #{{ root }} .{{ root }}__wrap,
  #{{ root }} .{{ root }}__grid { min-width: 0; max-width: 100%; }

  /* Desktop / default: CSS grid table */
  #{{ root }} .{{ root }}__grid {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr repeat({{ competitors.size }}, minmax(0, 1fr));
    border-radius: var(--{{ root }}-radius);
    overflow: hidden;
    background: var(--color-background, #FFFFFF);
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
  }
  #{{ root }} .{{ root }}__cell {
    padding: 18px 18px;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    font-size: 15px;
    font-weight: 600;
  }
  #{{ root }} .{{ root }}__cell--label {
    justify-content: flex-start;
    text-align: left;
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  #{{ root }} .{{ root }}__cell--head {
    min-height: 96px;
    font-family: var(--font-heading--family, inherit);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgba(0,0,0,0.03);
  }
  #{{ root }} .{{ root }}__cell--fortified {
    background: var(--{{ root }}-fcol-bg);
    color: var(--{{ root }}-fcol-fg);
    border-bottom-color: rgba(255,255,255,0.08);
  }
  #{{ root }} .{{ root }}__cell--fhead {
    background: var(--{{ root }}-fcol-bg);
    color: var(--{{ root }}-fcol-fg);
    min-height: 120px;
  }
  #{{ root }} .{{ root }}__grid > .{{ root }}__cell:nth-last-child(-n+{{ col_count }}) {
    border-bottom: none;
  }

  #{{ root }} .{{ root }}__logo {
    max-height: 48px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  #{{ root }} .{{ root }}__comp-logo { max-height: 38px; }

  /* Icon visuals */
  #{{ root }} .{{ root }}__icon {
    width: 28px;
    height: 28px;
    display: inline-block;
  }
  #{{ root }} .{{ root }}__check-circle {
    background: var(--{{ root }}-check);
    color: var(--{{ root }}-fcol-bg);
    border-radius: 999px;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #{{ root }} .{{ root }}__cross-circle {
    color: var(--{{ root }}-cross);
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #{{ root }} .{{ root }}__footer {
    display: flex;
    justify-content: center;
    margin-top: 44px;
  }
  #{{ root }} .{{ root }}__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 32px;
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    border: 2px solid var(--color-foreground, #0E0E0E);
    cursor: pointer;
    transition: opacity 0.18s, background 0.18s, color 0.18s;
  }
  #{{ root }} .{{ root }}__cta--filled  { background: var(--color-foreground, #0E0E0E); color: var(--color-background, #FFFFFF); }
  #{{ root }} .{{ root }}__cta--filled:hover { opacity: 0.88; }
  #{{ root }} .{{ root }}__cta--outline { background: transparent; color: var(--color-foreground, #0E0E0E); }
  #{{ root }} .{{ root }}__cta--outline:hover { background: var(--color-foreground, #0E0E0E); color: var(--color-background, #FFFFFF); }

  /* Mobile hint */
  #{{ root }} .{{ root }}__hint {
    position: relative;
    margin-top: 18px;
    text-align: right;
    padding-right: 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
    transition: opacity 0.25s;
    pointer-events: none;
    display: none;
  }
  #{{ root }} .{{ root }}__wrap.is-scrolled .{{ root }}__hint { opacity: 0; }

  @media (max-width: 749px) {
    #{{ root }} .{{ root }}__inner { padding-left: 12px; padding-right: 12px; }
    /* Keep the same row-major grid, but give columns fixed widths so the
       table overflows the viewport and scrolls horizontally. The label
       column stays pinned on the left. */
    #{{ root }} .{{ root }}__grid {
      grid-template-columns: 128px 150px repeat({{ competitors.size }}, 130px);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      box-shadow: none;
      border-radius: 0;
    }
    #{{ root }} .{{ root }}__grid::-webkit-scrollbar { display: none; }
    #{{ root }} .{{ root }}__cell {
      padding: 13px 10px;
      font-size: 13px;
      min-height: 54px;
    }
    #{{ root }} .{{ root }}__cell--label {
      position: sticky;
      left: 0;
      background: var(--color-background, #FFFFFF);
      z-index: 2;
      box-shadow: 6px 0 10px rgba(0,0,0,0.06);
      font-size: 12px;
      padding-left: 12px;
    }
    /* The Fortified header is sticky-tinted so it keeps its dark fill while scrolling */
    #{{ root }} .{{ root }}__cell--head { min-height: 84px; font-size: 14px; }
    #{{ root }} .{{ root }}__cell--fhead { min-height: 96px; }
    #{{ root }} .{{ root }}__hint { display: block; }
  }

  [hidden]{display:none!important}

  /* Primary + secondary CTA row: equal width, side-by-side on all viewports. */
  #{{ root }} .ftd-cta-row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; align-items: stretch; }
  #{{ root }} .ftd-cta-row > .{{ root }}__cta,
  #{{ root }} .ftd-cta-row > .button,
  #{{ root }} .ftd-cta-row > .button-secondary { flex: 0 1 auto; min-width: 12rem; white-space: nowrap; justify-content: center; text-align: center; }

  {{ section.settings.custom_css }}
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="{{ root }}"
  class="{{ root }}__section section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="{{ root }}__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="{{ root }}__head">
        {%- if eyebrow_v != blank -%}<p class="{{ root }}__eyebrow">{{ eyebrow_v }}</p>{%- endif -%}
        {%- if heading_v != blank -%}<h2 class="{{ root }}__heading">{%- render 'ftd-rich-text', text: heading_v -%}</h2>{%- endif -%}
        {%- if subheading_v != blank -%}<div class="{{ root }}__sub">{%- render 'ftd-rich-text', text: subheading_v -%}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="{{ root }}__wrap" data-comparison>

      <div class="{{ root }}__grid" role="table" aria-label="Comparison table">

        {%- assign logo_class = root | append: '__logo' -%}
        {%- assign comp_logo_class = root | append: '__comp-logo' -%}
        {%- comment -%} Header row {%- endcomment -%}
        <div class="{{ root }}__cell {{ root }}__cell--head {{ root }}__cell--label" role="columnheader"></div>
        <div class="{{ root }}__cell {{ root }}__cell--head {{ root }}__cell--fhead" role="columnheader">
          {%- if section.settings.fortified_logo != blank -%}
            {{ section.settings.fortified_logo | image_url: width: 200 | image_tag: class: logo_class, loading: 'lazy', widths: '100,200,300', alt: section.settings.fortified_label }}
          {%- else -%}
            {{ section.settings.fortified_label }}
          {%- endif -%}
        </div>
        {%- for c in competitors -%}
          {%- if use_pdp_competitors -%}
            <div class="{{ root }}__cell {{ root }}__cell--head" role="columnheader">{{ c.name }}</div>
          {%- else -%}
            <div class="{{ root }}__cell {{ root }}__cell--head" role="columnheader" {% if c.settings.highlight_color != blank %}style="color: {{ c.settings.highlight_color }};"{% endif %}>
              {%- if c.settings.logo != blank -%}
                {{ c.settings.logo | image_url: width: 200 | image_tag: class: comp_logo_class, loading: 'lazy', widths: '100,200,300', alt: c.settings.name }}
              {%- else -%}
                {{ c.settings.name }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Feature rows {%- endcomment -%}
        {%- for row in feature_rows -%}
          {%- assign row_index = forloop.index0 -%}
          {%- liquid
            if use_pdp_rows
              assign row_label = row.label
              assign row_icon = row.icon
              assign row_value = row.fortified_value
            else
              assign row_label = row.settings.label
              assign row_icon = row.settings.icon
              assign row_value = row.settings.fortified_value
            endif
          -%}

          <div class="{{ root }}__cell {{ root }}__cell--label" role="rowheader">{{ row_label }}</div>

          {%- comment -%} Fortified cell {%- endcomment -%}
          <div class="{{ root }}__cell {{ root }}__cell--fortified" role="cell">
            {%- case row_icon -%}
              {%- when 'check' -%}
                <span class="{{ root }}__check-circle" aria-label="Yes">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5"/></svg>
                </span>
              {%- when 'cross' -%}
                <span class="{{ root }}__cross-circle" style="color: var(--{{ root }}-fcross);" aria-label="No">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
                </span>
              {%- else -%}
                <span>{{ row_value }}</span>
            {%- endcase -%}
          </div>

          {%- comment -%} Competitor cells: pull index-th line from each competitor's values {%- endcomment -%}
          {%- for c in competitors -%}
            {%- if use_pdp_competitors -%}
              {%- assign comp_values_raw = c.values -%}
            {%- else -%}
              {%- assign comp_values_raw = c.settings.values -%}
            {%- endif -%}
            {%- assign lines = comp_values_raw | newline_to_br | split: '<br />' -%}
            {%- assign raw = lines[row_index] | default: '' | strip -%}
            {%- assign rawd = raw | downcase -%}
            <div class="{{ root }}__cell" role="cell">
              {%- if raw == '✓' or rawd == 'yes' or rawd == 'true' -%}
                <span class="{{ root }}__check-circle" style="background: var(--{{ root }}-comp-check); color: var(--color-background, #FFFFFF);" aria-label="Yes">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5"/></svg>
                </span>
              {%- elsif raw == '✗' or raw == '⊘' or rawd == 'no' or rawd == 'false' -%}
                <span class="{{ root }}__cross-circle" aria-label="No">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
                </span>
              {%- else -%}
                <span>{{ raw }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}

        {%- endfor -%}

      </div>

      {%- if section.settings.mobile_swipe_hint != blank -%}
        <p class="{{ root }}__hint" aria-hidden="true">{{ section.settings.mobile_swipe_hint }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank or section.settings.secondary_button_label != blank -%}
      <div class="{{ root }}__footer ftd-cta-row">
        {%- if section.settings.cta_label != blank -%}
          <a
            class="{{ root }}__cta {{ root }}__cta--{{ cta_style }}"
            {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% else %}href="#" role="button"{% endif %}
          >{{ cta_label_v }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          {%- assign sec_link = section.settings.secondary_button_link | default: '#shopify-section-ftd_c_supp_facts_4JN74r' -%}
          <a class="button button-secondary" href="{{ sec_link }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <script>
    (function(){
      var wrap = document.querySelector('#{{ root }} [data-comparison]');
      if (!wrap) return;
      var grid = wrap.querySelector('.{{ root }}__grid');
      if (!grid) return;
      var onScroll = function(){
        if (grid.scrollLeft > 8) {
          wrap.classList.add('is-scrolled');
          grid.removeEventListener('scroll', onScroll);
        }
      };
      grid.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</section>

{% schema %}
{
  "name": "FTD - Comparison Table",
  "tag": "section",
  "class": "ftd-comparison-section",
  "settings": [
    {
      "type": "header",
      "content": "Anchor"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional. Lets you link to this section, e.g. #ingredients. Letters, numbers, and hyphens only."
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#1FA8A1"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Beat The Rest Electrolytes"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Fortified column"
    },
    {
      "type": "text",
      "id": "fortified_label",
      "label": "Column label",
      "default": "Fortified"
    },
    {
      "type": "image_picker",
      "id": "fortified_logo",
      "label": "Column logo",
      "info": "Optional. Replaces the label text."
    },
    {
      "type": "color",
      "id": "fortified_column_color",
      "label": "Column background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "fortified_text_color",
      "label": "Column text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Icon colors"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Fortified column — check circle",
      "default": "#FFFFFF",
      "info": "The checkmark inside takes the Fortified column background color."
    },
    {
      "type": "color",
      "id": "fortified_cross_color",
      "label": "Fortified column — cross",
      "info": "Optional. Falls back to the competitor cross color."
    },
    {
      "type": "color",
      "id": "comp_check_color",
      "label": "Competitor columns — check circle",
      "info": "Optional. Falls back to the competitor cross color."
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Competitor columns — cross",
      "default": "#9CA3AF"
    },
    {
      "type": "header",
      "content": "t:content.button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Fortified Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "default": "outline",
      "options": [
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    },
    {
      "type": "header",
      "content": "Secondary CTA (Learn More)"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "text",
      "id": "secondary_button_link",
      "label": "Secondary button link",
      "default": "#shopify-section-ftd_c_supp_facts_4JN74r",
      "info": "Defaults to the Supplement Facts section."
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "text",
      "id": "mobile_swipe_hint",
      "label": "Swipe hint text",
      "default": "Swipe to compare →"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "table_radius",
      "label": "Table corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full-width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
