    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "fortified-stat",
      "name": "Stat card",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Number",
          "default": "2.3x"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "Better Hydration"
        },
        {
          "type": "textarea",
          "id": "stat_description",
          "label": "Description"
        },
        {
          "type": "checkbox",
          "id": "show_chart",
          "label": "Show comparison bar chart",
          "default": true
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        }
      ]
    },
    {
      "type": "fortified-checklist-card",
      "name": "Checklist card",
      "settings": [
        {
          "type": "text",
          "id": "headline_number",
          "label": "Headline number",
          "default": "0%"
        },
        {
          "type": "text",
          "id": "headline_label",
          "label": "Headline label",
          "default": "No Sugar. No Crash."
        },
        {
          "type": "text",
          "id": "item_1",
          "label": "Item 1",
          "default": "Improve Hydration"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "Item 2",
          "default": "Boost Energy"
        },
        {
          "type": "text",
          "id": "item_3",
          "label": "Item 3",
          "default": "Support Muscle Function"
        },
        {
          "type": "text",
          "id": "item_4",
          "label": "Item 4"
        },
        {
          "type": "text",
          "id": "item_5",
          "label": "Item 5"
        },
        {
          "type": "text",
          "id": "item_6",
          "label": "Item 6"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "05 \u2014 Stats",
      "category": "Fortified",
      "blocks": [
        {
          "type": "fortified-stat",
          "settings": {
            "stat_number": "2.3x",
            "stat_label": "Better Hydration"
          }
        },
        {
          "type": "fortified-stat",
          "settings": {
            "stat_number": "+24%",
            "stat_label": "Improved Endurance"
          }
        },
        {
          "type": "fortified-checklist-card"
        }
      ]
    }
  ]
}
{% endschema %}
