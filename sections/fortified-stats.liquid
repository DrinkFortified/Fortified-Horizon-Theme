{% render 'fortified-base' %}

<section
  id="FortifiedStats-{{ section.id }}"
  class="fortified-stats color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; --fortified-stats-compare: {{ section.settings.compare_color | default: '#657582' }}; padding-block: {{ section.settings['padding-block-start'] | default: 100 }}px {{ section.settings['padding-block-end'] | default: 100 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 40 }}px {{ section.settings['padding-inline-end'] | default: 40 }}px;"
>
  <div class="fortified-stats__inner">
    {% if section.settings.heading != blank or section.settings.body != blank %}
      <header class="fortified-stats__header">
        {% if section.settings.heading != blank %}
          <h2 class="fortified-stats__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <p class="fortified-stats__body">{% render 'fortified-accent-text', text: section.settings.body %}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="fortified-stats__grid">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-stat' %}
          <article class="fortified-stats__card" {{ block.shopify_attributes }}>
            <div class="fortified-stats__card-head">
              <div class="fortified-stats__number">{{ block.settings.stat_number }}</div>
              <div class="fortified-stats__label">{% render 'fortified-accent-text', text: block.settings.stat_label %}</div>
              {% if block.settings.stat_description != blank %}
                <p class="fortified-stats__desc">{% render 'fortified-accent-text', text: block.settings.stat_description %}</p>
              {% endif %}
            </div>
            {% if block.settings.show_chart %}
              {%- assign their_h = block.settings.their_value | default: 40 -%}
              {%- assign ours_h = block.settings.ours_value | default: 100 -%}
              <div class="fortified-stats__chart" aria-hidden="true">
                <div class="fortified-stats__bar fortified-stats__bar--theirs" style="height: {{ their_h }}%"><span>{{ block.settings.their_label | default: 'water' }}</span></div>
                <div class="fortified-stats__bar fortified-stats__bar--ours" style="height: {{ ours_h }}%"><span>{{ block.settings.ours_label | default: 'us' }}</span></div>
              </div>
            {% endif %}
            {% if block.settings.footnote != blank %}
              <p class="fortified-stats__footnote">{% render 'fortified-accent-text', text: block.settings.footnote %}</p>
            {% endif %}
          </article>
        {% elsif block.type == 'fortified-checklist-card' %}
          <article class="fortified-stats__card fortified-stats__card--list" {{ block.shopify_attributes }}>
            <div class="fortified-stats__card-head">
              <div class="fortified-stats__number">{{ block.settings.headline_number | default: '0%' }}</div>
              <div class="fortified-stats__label">{% render 'fortified-accent-text', text: block.settings.headline_label | default: 'No Sugar. No Crash.' %}</div>
              {% if block.settings.description != blank %}
                <p class="fortified-stats__desc">{% render 'fortified-accent-text', text: block.settings.description %}</p>
              {% endif %}
            </div>
            <ul class="fortified-stats__list">
              {% for i in (1..6) %}
                {%- assign key = 'item_' | append: i -%}
                {%- assign val = block.settings[key] -%}
                {% if val != blank %}
                  <li><span class="fortified-stats__check" aria-hidden="true">✓</span>{% render 'fortified-accent-text', text: val %}</li>
                {% endif %}
              {% endfor %}
            </ul>
            {% if block.settings.footnote != blank %}
              <p class="fortified-stats__footnote">{% render 'fortified-accent-text', text: block.settings.footnote %}</p>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-stats__btn">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-stats {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-stats__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 42px;
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
  }
  .fortified-stats__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 720px;
    text-align: center;
  }
  .fortified-stats__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-stats__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .fortified-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    width: 100%;
  }
  .fortified-stats__card {
    border: 1.5px solid var(--color-foreground);
    border-radius: 14px;
    padding: 52px 42px;
    display: flex;
    flex-direction: column;
    gap: 42px;
    color: var(--color-foreground);
    background: transparent;
  }
  .fortified-stats__card-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .fortified-stats__number {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
  }
  .fortified-stats__label {
    font-family: var(--font-fortified-display);
    font-size: 38px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
  }
  .fortified-stats__desc {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    margin: 8px 0 0;
  }
  .fortified-stats__chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    gap: 24px;
    height: 240px;
    width: 100%;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    padding: 0 12px;
  }
  .fortified-stats__bar {
    position: relative;
    width: 30%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    color: transparent;
  }
  .fortified-stats__bar span {
    position: absolute;
    bottom: -28px;
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
    font-size: 16px;
    line-height: 1.2;
  }
  .fortified-stats__bar--theirs { background: var(--fortified-stats-compare, #657582); }
  .fortified-stats__bar--ours { background: var(--fortified-accent); }
  .fortified-stats__footnote {
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    margin: 24px 0 0;
  }
  .fortified-stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .fortified-stats__list li {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-fortified-body);
    font-size: 22px;
    line-height: 1.1;
    color: var(--color-foreground);
    text-transform: capitalize;
  }
  .fortified-stats__check {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--fortified-accent);
    color: var(--color-background);
    font-weight: 700;
    font-size: 18px;
  }

  .fortified-stats__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-stats__grid { grid-template-columns: 1fr; }
    .fortified-stats__heading { font-size: 44px; }
    .fortified-stats__body { font-size: 18px; }
    .fortified-stats__number { font-size: 48px; }
    .fortified-stats__label { font-size: 28px; }
    .fortified-stats__card { padding: 36px 32px; gap: 32px; }
  }
  @media (max-width: 749px) {
    .fortified-stats__heading { font-size: 32px; }
    .fortified-stats__card { padding: 28px 24px; }
    .fortified-stats__btn { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "05 \u2014 Stats",
  "tag": "section",
  "class": "fortified-stats-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color. Use line breaks to split into multiple lines.",
      "default": "WHY WE BEAT THE REST\n*electrolytes*"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "Electrolytes don't provide full recovery."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "EXPLORE ALL FLAVORS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "blocks_alignment",
      "label": "Blocks row position",
      "info": "How the row/grid of blocks sits inside the section. Use Center to push blocks to the middle of the section width.",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Comparison bar color",
      "info": "Color for the 'theirs' bar in stat comparison charts.",
      "default": "#657582"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for accent bars, CTA backgrounds, checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fortified-stat",
      "name": "Stat card",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Number",
          "default": "2.3x"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Better Hydration"
        },
        {
          "type": "textarea",
          "id": "stat_description",
          "label": "Description",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "vs. water alone"
        },
        {
          "type": "checkbox",
          "id": "show_chart",
          "label": "Show comparison bar chart",
          "default": true
        },
        {
          "type": "text",
          "id": "their_label",
          "label": "Comparison bar label",
          "default": "water"
        },
        {
          "type": "range",
          "id": "their_value",
          "label": "Comparison bar height (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 40
        },
        {
