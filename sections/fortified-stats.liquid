{% render 'fortified-base' %}

<section
  id="FortifiedStats-{{ section.id }}"
  class="fortified-stats color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-stats__inner">
    {% if section.settings.heading != blank %}
      <header class="fortified-stats__header">
        {% if section.settings.eyebrow != blank %}
          <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      </header>
    {% endif %}

    <div class="fortified-stats__grid" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-stat' %}
          <div class="fortified-stats__card" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <div class="fortified-stats__number">{{ block.settings.stat_number }}</div>
            <div class="fortified-stats__label">{{ block.settings.stat_label }}</div>
            {% if block.settings.stat_description != blank %}
              <p class="fortified-stats__desc">{{ block.settings.stat_description }}</p>
            {% endif %}
            {% if block.settings.show_chart %}
              <div class="fortified-stats__chart" aria-hidden="true">
                <div class="fortified-stats__bar" style="--h: 40%"></div>
                <div class="fortified-stats__bar fortified-stats__bar--ours" style="--h: 92%"></div>
              </div>
            {% endif %}
          </div>
        {% elsif block.type == 'fortified-checklist-card' %}
          <div class="fortified-stats__card fortified-stats__card--list" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <div class="fortified-stats__number">{{ block.settings.headline_number | default: "0%" }}</div>
            <div class="fortified-stats__label">{{ block.settings.headline_label | default: "No Sugar." }}</div>
            <ul class="fortified-checklist">
              {% for i in (1..6) %}
                {%- assign key = 'item_' | append: i -%}
                {%- assign val = block.settings[key] -%}
                {% if val != blank %}<li>{{ val }}</li>{% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="fortified-stats__cta">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-stats {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-stats__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(28px, 4vw, 48px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  .fortified-stats__header {
    text-align: center;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fortified-stats__header .fortified-heading {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .fortified-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    width: 100%;
  }
  @media (min-width: 750px) {
    .fortified-stats__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .fortified-stats__card {
    background: color-mix(in srgb, var(--color-foreground) 4%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: clamp(20px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 220px;
    position: relative;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  
  .fortified-stats__number {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    color: var(--fortified-accent, var(--color-foreground-heading));
    letter-spacing: -0.02em;
  }
  .fortified-stats__label {
    font-family: var(--font-fortified-display);
    font-weight: 700;
    font-size: clamp(15px, 1.4vw, 18px);
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--color-foreground-heading);
    margin-top: 4px;
  }
  .fortified-stats__desc {
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.65;
    margin: 0;
  }
  .fortified-stats__chart {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 80px;
    width: 100%;
    padding-top: 16px;
  }
  .fortified-stats__bar {
    flex: 1;
    height: var(--h, 50%);
    background: color-mix(in srgb, var(--color-foreground) 15%, transparent);
    border-radius: 6px 6px 0 0;
    transition: height .35s ease;
  }
  .fortified-stats__bar--ours {
    background: var(--fortified-accent, var(--color-foreground));
  }
  .fortified-stats__card--list {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: transparent;
  }
  .fortified-stats__card--list .fortified-stats__number,
  .fortified-stats__card--list .fortified-stats__label { color: var(--color-background); }
  .fortified-stats__card--list .fortified-checklist {
    margin-top: 8px;
    width: 100%;
  }
  .fortified-stats__card--list .fortified-checklist li {
    color: var(--color-background);
    font-size: 13px;
    line-height: 1.4;
  }
  .fortified-stats__card--list .fortified-checklist li::before {
    color: var(--fortified-accent, var(--color-background));
  }
  .fortified-stats__cta {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }
  .fortified-stats__cta .fortified-btn {
    padding: 14px 32px;
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 48px;
  }
{% endstylesheet %}

