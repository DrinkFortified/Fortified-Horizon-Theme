{% comment %}
  Section: FTD - Selector Gold
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Forked from "FTD - Product Selector D" so the layout could be reworked
  without touching the live homepage section, then rebuilt as a two-column
  selector: the wizard runs in the main column and the order stays visible
  in the aside on every step.

  Two steps only — Plan and Bundle. There is no Review step; the aside is
  the review. If a third "Review" pill ever appears on a live page, the
  theme is serving a stale copy of this file, not this version.

  Layout revision 2 (aside + two steps).
  The creatine add-on ("addon_*") is the upsell section.

  The preset carries the homepage's bullets and function cards but not its
  announce-fomo bar: that block is disabled on the homepage, and a preset
  has no way to express "present but off" — 'disabled' is template grammar,
  not preset grammar, and including it makes Shopify reject the whole
  section. Add the block from the editor if you want the bar.

  Shares the runtime, the stylesheet and the child blocks with Product
  Selector D. It also shares CART_OWNER, so the two must not be rendered
  on the same page — they would fight over the same cart lines.
  ----------------------------------------------------------------------
  Renders the same wizard
  (Plan -> Products -> Upsells -> Cart) as the slide-over sibling
  (blocks/ftd-product-selector-c-slideover.liquid) but inline in the
  page flow.

  Architecture: child theme blocks (_ftd-c-function, _ftd-c-bullet,
  _ftd-c-upsell) self-render their own markup with data-slot attrs.
  We render them via content_for 'blocks' into a hidden staging div,
  then JS moves each one into the right container on init.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign show_onetime   = section.settings.show_onetime
  assign show_monthly   = section.settings.show_monthly
  assign show_quarterly = section.settings.show_quarterly
  assign bundle_count   = section.settings.bundle_count | default: 3
  assign addon = section.settings.addon_product
  comment
    Shopify's product setting type accepts no default, so a freshly added
    section has no creatine and the whole add-on row — the paid one-time and
    monthly offers included — renders as nothing at all. The preset can seed
    the hydration function blocks but not this. Falling back to a handle gives
    it a real default; picking a product in the editor still wins.
  endcomment
  if addon == blank and section.settings.addon_product_handle != blank
    assign addon = all_products[section.settings.addon_product_handle]
  endif
  assign addon_variant_id = ''
  if addon != blank and addon.selected_or_first_available_variant != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif
  assign acc_monthly   = section.settings.monthly_accent_color   | default: '#1FA8A1'
  assign acc_quarterly = section.settings.quarterly_accent_color | default: '#E8833A'
  assign acc_onetime   = section.settings.onetime_accent_color   | default: '#8E8E93'
  assign anchor_id = section.settings.anchor_id | strip | handleize
  if anchor_id == blank
    assign anchor_id = 'section-' | append: section.id
  endif
-%}

{{ 'ftdc.css' | asset_url | stylesheet_tag }}

<style>
  /* Per-plan accent: override --ftdc-accent on each plan card so EVERYTHING
     that reads the accent (badge background, top stripe, selected border,
     tick, glow) uses that plan's color consistently. */
  #ftdc-{{ sid }} .ftdc__plan[data-plan="monthly"] { --ftdc-accent: {{ acc_monthly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="quarterly"] { --ftdc-accent: {{ acc_quarterly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] { --ftdc-accent: {{ acc_onetime }}; }
  #ftdc-{{ sid }} .ftdc__plan { border-top: 4px solid var(--ftdc-accent, var(--color-primary-button-background)); }
  /* Golden split, written as fractions so the ratio holds at every width
     rather than only at the one it was measured at. Was
     minmax(300px, 460px) 1fr, which resolved to 1.908:1 at 1360px. */
  #ftdc-{{ sid }} .ftdc__step--has-image.is-active { display: grid; grid-template-columns: minmax(300px, 1fr) 1.618fr; gap: 2.125rem; align-items: start; }
  #ftdc-{{ sid }} .ftdc__plans-image { position: sticky; top: 1rem; }
  #ftdc-{{ sid }} .ftdc__plans-image img { width: 100%; height: auto; aspect-ratio: 1 / 1.618; display: block; border-radius: var(--ftdc-radius, 13px); object-fit: cover; }
  /* Plan layout: the two subscriptions side-by-side on top, Buy Once
     spanning the full width beneath them. */
  #ftdc-{{ sid }} .ftdc__plans { grid-template-columns: 1fr 1fr; }
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-column: 1 / -1; }
  /* Center the bundle (Step 2) cards: fixed-width tracks + justify-content
     so a partial row sits centered instead of left-aligned. Desktop only —
     the mobile 2-column layout from ftdc.css is left as-is. */
  #ftdc-{{ sid }} .ftdc__grid { justify-content: center; }
  @media (min-width: 600px) {
    /* auto-fit (not auto-fill): collapses unused tracks to 0 width so a
       partial row of cards centers as a group instead of leaving trailing
       empty columns that push the visible cards to the left. */
    /* superseded by the one-row rule below */
  }
  @media (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__step--has-image.is-active { grid-template-columns: 1fr; gap: 1rem; }
    #ftdc-{{ sid }} .ftdc__plans-image { position: static; }
    #ftdc-{{ sid }} .ftdc__plans-image img { max-height: 220px; }
    #ftdc-{{ sid }} .ftdc__plans { grid-template-columns: 1fr; }
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-column: auto; }
  }
  /* Announcement bar (slot above wizard header). One or more bars stacked. */
  #ftdc-{{ sid }} .ftdc__announce { display: flex; flex-direction: column; margin: -1rem -1rem 1rem; }
  #ftdc-{{ sid }} .ftdc__announce[hidden] { display: none; }
  #ftdc-{{ sid }} .ftdc__announce-bar { padding: 0.55rem 1rem; font-size: var(--ftd-small-size); line-height: 1.3; text-align: center; }
  #ftdc-{{ sid }} .ftdc__announce-bar--fomo { padding: 0.55rem 1rem 0.65rem; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-row { display: block; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-line strong { font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-bar { display: block; margin: 0.4rem auto 0; max-width: 320px; height: var(--ftdc-fomo-h, 6px); background: var(--ftdc-fomo-track); border-radius: 999px; overflow: hidden; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-bar-fill { height: 100%; background: var(--ftdc-fomo-fill); transition: width 0.35s ease; }
  #ftdc-{{ sid }} .ftdc__announce-link { text-decoration: none; }
  #ftdc-{{ sid }} .ftdc__announce-link:hover { text-decoration: underline; }

  /* Bottom action bar: no longer pinned — sits in normal flow at the end of
     the step content, so visitors scroll down to reach it. */
  #ftdc-{{ sid }} .ftdc__bar { position: static; bottom: auto; }
  /* Review step has its own Checkout button — the bar would duplicate it. */
  #ftdc-{{ sid }}[data-active-step="review"] .ftdc__bar { display: none; }

  /* "Add N more selections to continue" now lives under the progress bar
     instead of inside the bottom pill (where it broke the pill's rounded
     shape and looked visually broken). */
  #ftdc-{{ sid }} .ftdc__bundle-warning {
    margin: 0.5rem auto 0;
    max-width: 32em;
    font-size: var(--ftd-small-size);
    font-weight: 700;
    text-align: center;
    color: #92400E;
  }
  #ftdc-{{ sid }} .ftdc__bundle-warning[hidden] { display: none; }

  /* The progress header used to be pinned inside the products step. It now
     rides in the aside, which is pinned as a whole, so that rule is gone. */

  /* Badge: tighter, closer to the text. justify-self: start stops it from
     stretching to the full grid-column width (its parent .ftdc__plan is a
     CSS Grid, so with no justify-self it defaults to stretch — the badge
     was filling the whole card width instead of wrapping its own text). */
  #ftdc-{{ sid }} .ftdc__plan-badge { padding: 0.05rem 0.4rem; line-height: 1.5; justify-self: start; }

  /* Header description: room for ~4 lines of copy without feeling cramped. */
  #ftdc-{{ sid }} .ftdc__desc { max-width: 44em; }

  /* Bullets in two columns instead of one stacked column, kept tight to
     their own dot/text pairing (not stretched by the grid). */
  #ftdc-{{ sid }} .ftdc__bullets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 1.75rem; max-width: 34em; align-items: start; }
  #ftdc-{{ sid }} .ftdc__bullet { justify-self: start; gap: 0.5rem; }

  /* "Was" price: keep the muted styling, drop the strikethrough. */
  #ftdc-{{ sid }} .ftdc__plan-was { text-decoration: none; }

  /* Header (heading/description/bullets) only makes sense on the Plan step. */

  /* ───── Gold: two columns, split on φ ─────────────────────────────────
     The wizard runs in the main column; the order stays visible in the
     aside on every step, which is the whole point of this variant. 1.618fr
     to 1fr, so the split holds at any width. */
  #ftdc-{{ sid }} .ftdcg__cols {
    display: grid;
    grid-template-columns: 1.618fr minmax(280px, 1fr);
    gap: 2.125rem;                       /* 34 — Fibonacci */
    align-items: start;
  }
  #ftdc-{{ sid }} .ftdcg__main { min-width: 0; }

  #ftdc-{{ sid }} .ftdcg__aside { position: sticky; min-width: 0; }
  #ftdc-{{ sid }} .ftdcg__aside-inner { display: flex; flex-direction: column; gap: 0.8125rem; }

  #ftdc-{{ sid }} .ftdcg__summary {
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: var(--ftdc-radius, 13px);
    background: var(--color-background);
    padding: 1.3125rem;
  }
  #ftdc-{{ sid }} .ftdcg__summary-label {
    margin: 0 0 0.5rem; font-size: var(--font-size--xs, 0.786rem);
    font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }
  #ftdc-{{ sid }} .ftdcg__summary .ftdc__review-plan { margin: 0 0 0.5rem; font-weight: 700; }
  #ftdc-{{ sid }} .ftdcg__summary-note {
    margin: 0.8125rem 0 0; font-size: var(--font-size--3xs, 0.618rem); line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  /* Free-shipping reassurance line */
  #ftdc-{{ sid }} .ftdcg__ship {
    display: flex; align-items: center; gap: 0.4375rem; margin: 0;
    font-size: var(--font-size--2xs, 0.697rem); font-weight: 700;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }
  #ftdc-{{ sid }} .ftdcg__ship-tick { flex: none; color: #17a34a; }

  /* ───── Which plan is selected ────────────────────────────────────────
     Selection used to be drawn entirely in the plan's own accent — border,
     ring and tick. That works for the orange and teal subscriptions and
     fails completely for Buy Once, whose accent is grey (#8e8e93): picking
     it turned every selection cue grey, the least selected-looking colour
     available. The accent still brands the offer (badge, top stripe); the
     picked state now has a colour of its own, so it reads the same on all
     three cards. */
  #ftdc-{{ sid }} .ftdc__plans { --ftdcg-selected: var(--color-foreground); }
  #ftdc-{{ sid }} .ftdc__plan.is-active {
    border-color: var(--ftdcg-selected);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    box-shadow: 0 0 0 3px rgb(var(--color-foreground-rgb) / 0.16);
  }
  #ftdc-{{ sid }} .ftdc__plan.is-active .ftdc__plan-tick {
    background: var(--ftdcg-selected);
    border-color: var(--ftdcg-selected);
  }
  /* Buy Once is deliberately recessive when unpicked; picking it must still
     lift it clear of that. */
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"].is-active {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }
  #ftdc-{{ sid }} .ftdcg__plan-selected {
    position: absolute;
    top: 13px;
    right: 42px;
    display: none;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--ftdcg-selected);
    color: var(--color-background);
    font-size: var(--font-size--3xs, 0.618rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.7;
    text-transform: uppercase;
    white-space: nowrap;
  }
  #ftdc-{{ sid }} .ftdc__plan.is-active .ftdcg__plan-selected { display: block; }
  /* Below this the badge and the marker would meet. */
  @media screen and (max-width: 520px) {
    #ftdc-{{ sid }} .ftdcg__plan-selected { display: none !important; }
  }
  /* Buy Once is a single compact row, so an absolutely positioned marker
     lands on top of the price. Give it a track of its own instead and let
     the price shift left.
     The .is-active qualifier is load-bearing, not decoration: the Buy Once
     layout block above uses the same selector and the same !important, so a
     plain repeat here loses on source order and the marker lands in the
     price's track. It also means the fourth track only exists while there is
     a marker to put in it. */
  @media screen and (min-width: 750px) {
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"].is-active {
      grid-template-columns: auto minmax(0, 1fr) auto auto !important;
    }
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"].is-active .ftdcg__plan-selected {
      position: static;
      grid-row: 1;
      grid-column: 3;
      align-self: center;
    }
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"].is-active .ftdc__plan-pricing {
      grid-row: 1;
      grid-column: 4;
    }
  }
  /* Narrower than that the row has no room for it at all. */
  @media screen and (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdcg__plan-selected { display: none !important; }
  }

  /* Creatine's own row under the flavour grid. Laid out horizontally so it
     reads as an add-on rather than a fourth flavour, and so it does not have
     to guess how many flavour columns there are. */
  #ftdc-{{ sid }} .ftdcg__creatine-slot { margin-top: 0.85rem; }
  #ftdc-{{ sid }} .ftdcg__creatine-slot[hidden] { display: none; }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card--creatine {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 1rem;
    width: 100%;
  }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card-media { aspect-ratio: 1; width: 5.5rem; }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card-body {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    padding-inline: 0;
  }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card-spec-top { flex-basis: 100%; }
  /* The grid card clamps its name to three lines and reserves height for
     them; on one line that reads as a gap. */
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card-name {
    min-height: 0;
    -webkit-line-clamp: 2;
    font-size: 14px;
  }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card-creatine-pricing { margin-top: 0; }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__add,
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__qty {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    margin: 0 0.9rem 0 0;
  }
  /* Both stretch to their column by default, which is right in a narrow
     grid card and far too wide across a full-width row. */
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__add { width: auto; padding-inline: 1.5rem; }
  #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__qty { width: 8.5rem; }
  @media screen and (max-width: 599px) {
    #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card--creatine {
      grid-template-columns: 4rem minmax(0, 1fr);
    }
    #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__card-media { width: 4rem; }
    #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__add,
    #ftdc-{{ sid }} .ftdcg__creatine-slot .ftdc__qty {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
      padding-inline-end: 0;
    }
  }

  /* ───── The creatine card ─────────────────────────────────────────────
     It sits in the flavour grid beside the hydration cards, so it inherits
     .ftdc__card wholesale; only its price block is its own. */
  #ftdc-{{ sid }} .ftdc__card-creatine-desc {
    margin: 0.125rem 0 0;
    font-size: var(--font-size--2xs, 0.697rem);
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }
  #ftdc-{{ sid }} .ftdc__card-creatine-desc:empty { display: none; }
  #ftdc-{{ sid }} .ftdc__card-creatine-pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.3125rem;
  }
  #ftdc-{{ sid }} .ftdc__card-creatine-price { font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__card-creatine-was {
    font-size: var(--font-size--2xs, 0.697rem);
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }
  #ftdc-{{ sid }} .ftdc__card-creatine-was:empty { display: none; }

  /* Quantity stepper on the creatine row (one-time orders). */
  #ftdc-{{ sid }} .ftdcg__addon-qty {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    overflow: hidden;
  }
  #ftdc-{{ sid }} .ftdcg__addon-qty[hidden] { display: none; }
  #ftdc-{{ sid }} .ftdcg__addon-qty button {
    border: 0;
    background: none;
    cursor: pointer;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    color: var(--color-foreground);
    font-size: var(--font-size--sm, 0.887rem);
    line-height: 1;
  }
  #ftdc-{{ sid }} .ftdcg__addon-qty button:hover { background: rgb(var(--color-foreground-rgb) / 0.06); }
  #ftdc-{{ sid }} .ftdcg__addon-qty-input {
    width: 2rem;
    border: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--font-size--xs, 0.786rem);
    text-align: center;
    -moz-appearance: textfield;
  }
  #ftdc-{{ sid }} .ftdcg__addon-qty-input::-webkit-outer-spin-button,
  #ftdc-{{ sid }} .ftdcg__addon-qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* Cart errors, shown beside the button that caused them. */
  #ftdc-{{ sid }} .ftdcg__error {
    margin: 0;
    padding: 0.6875rem 0.8125rem;
    border-radius: var(--ftdc-radius, 13px);
    border: 2px solid #B42318;
    background: #FEF3F2;
    color: #B42318;
    font-size: var(--font-size--2xs, 0.697rem);
    font-weight: 700;
    line-height: 1.4;
  }
  #ftdc-{{ sid }} .ftdcg__error[hidden] { display: none; }

  #ftdc-{{ sid }} .ftdcg__cta {
    width: 100%; border: 0; cursor: pointer;
    padding: 1.125rem 1.3125rem;
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    background: var(--color-foreground); color: var(--color-background);
    font-family: var(--font-heading--family, inherit);
    font-size: var(--font-size--sm, 0.887rem); font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; line-height: 1;
  }
  #ftdc-{{ sid }} .ftdcg__cta:hover { opacity: 0.9; }
  #ftdc-{{ sid }} .ftdcg__once {
    margin: 0; text-align: center;
    font-size: var(--font-size--2xs, 0.697rem);
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }
  #ftdc-{{ sid }} .ftdcg__review-hint {
    margin: 0 0 1.125rem; color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  @media screen and (max-width: 989px) {
    #ftdc-{{ sid }} .ftdcg__cols { grid-template-columns: 1fr; gap: 1.3125rem; }
    #ftdc-{{ sid }} .ftdcg__aside { position: static; }
  }


  /* ───── Gold: the aside stays put ─────────────────────────────────────
     The column used to carry progress, add-ons and the whole order on every
     step, which made it tall enough to need its own scrollbar running beside
     the page's. It is now scoped per step (see "one job per step" below), so
     on a normal desktop viewport it simply fits and no nested scroll region is
     needed. Short viewports keep the cap, because there the alternative is
     content pinned off the bottom of the screen with no way to reach it. */
  @media screen and (max-height: 780px) {
    #ftdc-{{ sid }} .ftdcg__aside {
      max-height: calc(100vh - var(--ftdcg-aside-top) - 1.3125rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      padding-right: 0.3125rem;
    }
  }
  /* A long flavour list is the one genuinely unbounded part of the column.
     Bound that, rather than making the whole column scroll. */
  #ftdc-{{ sid }} .ftdcg__summary .ftdc__review-lines {
    max-height: 15.5rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__bundle-head {
    padding: 0.8125rem 0 0;
  }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__bundle-bar { max-width: none; }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__upsell { padding: 0.6875rem 0.8125rem; gap: 0.6875rem; grid-template-columns: 55px minmax(0, 1fr) auto; }

  /* ───── Flavour cards: one row, always ────────────────────────────────
     auto-fill wrapped to a second row as soon as the cards would go under
     220px. The count comes from the Function blocks, so let the track count
     follow the cards rather than the width: one column per card, each free
     to shrink. Below the breakpoint they scroll sideways instead of wrapping. */
  #ftdc-{{ sid }} .ftdc__grid {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    justify-content: stretch;
  }
  @media screen and (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__grid {
      grid-auto-columns: minmax(46%, 1fr);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }
    #ftdc-{{ sid }} .ftdc__grid > * { scroll-snap-align: start; }
  }


  /* ───── Gold: the advance control ─────────────────────────────────────
     The shared bar is normally sticky at the bottom of the viewport. Here it
     sits inline at the foot of the main column, directly under whatever step
     you are on, so it never floats over the flavour grid or the aside — and
     so there is always something visible saying what happens next.
     Overriding position rather than hiding it matters: this is the only
     element the runtime binds the advance action to. */
  #ftdc-{{ sid }} .ftdc__bar {
    position: static;
    max-width: none;
    width: 100%;
    margin: 1.3125rem 0 0;
    box-shadow: none;
    border-radius: var(--ftdc-radius, 13px);
    padding: 0.8125rem 1.3125rem;
    gap: 1.3125rem;
  }
  #ftdc-{{ sid }} .ftdc__bar-action { padding-inline: 2.125rem; }


  /* ───── Upgrade banner ────────────────────────────────────────────────
     Visible only while the 3-month plan is not the selected one. */
  #ftdc-{{ sid }} .ftdcg__upgrade {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8125rem 1.3125rem;
    margin: 1.3125rem 0 0;
    padding: 0.8125rem 1.3125rem;
    border-radius: var(--ftdc-radius, 13px);
    border: 2px solid var(--ftdc-accent, #1fa8a1);
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }
  #ftdc-{{ sid }} .ftdcg__upgrade-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3125rem;
    flex: 1 1 18rem;
    min-width: 0;
  }
  /* Aside copy of the same nudge: one narrow column, not a wide banner. */
  #ftdc-{{ sid }} .ftdcg__upgrade--aside {
    flex-direction: column;
    align-items: stretch;
    gap: 0.6875rem;
    margin: 0;
    padding: 0.8125rem;
  }
  #ftdc-{{ sid }} .ftdcg__upgrade--aside .ftdcg__upgrade-copy { flex: 1 1 auto; }
  #ftdc-{{ sid }} .ftdcg__upgrade--aside .ftdcg__upgrade-cta { text-align: center; }
  #ftdc-{{ sid }}:has(.ftdc__plan[data-plan="quarterly"] input:checked) .ftdcg__upgrade { display: none; }
  #ftdc-{{ sid }} .ftdcg__upgrade-badge {
    align-self: flex-start;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background: var(--ftdc-accent, #1fa8a1);
    color: #fff;
    font-size: var(--font-size--3xs, 0.618rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  #ftdc-{{ sid }} .ftdcg__upgrade-title { margin: 0; font-weight: 700; font-size: var(--font-size--lg, 1.128rem); line-height: 1.206; }
  #ftdc-{{ sid }} .ftdcg__upgrade-body  { margin: 0; font-size: var(--font-size--2xs, 0.697rem); line-height: 1.412; color: rgb(var(--color-foreground-rgb) / 0.7); }
  #ftdc-{{ sid }} .ftdcg__upgrade-cta {
    display: block;
    flex: 0 0 auto;
    padding: 0.6875rem 1.3125rem;
    text-align: center;
    cursor: pointer;
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    background: var(--ftdc-accent, #1fa8a1);
    color: #fff;
    font-family: var(--font-heading--family, inherit);
    font-size: var(--font-size--2xs, 0.697rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }
  #ftdc-{{ sid }} .ftdcg__upgrade-cta:hover { opacity: 0.9; }

  /* ───── No stacking, no overlap ───────────────────────────────────────
     The only pinned element left is the aside. Give it a top offset that
     clears a sticky header, and keep it below any theme overlay. */
  #ftdc-{{ sid }} {
    --ftdcg-aside-top: {{ section.settings.aside_offset | default: 21 }}px;
  }
  #ftdc-{{ sid }} .ftdcg__aside {
    top: var(--ftdcg-aside-top);
    z-index: 1;
  }


  /* ───── Advance button on the plan screen ─────────────────────────────
     The 3-month plan is preselected, so clicking the already-selected card
     fires no change event and nothing happens. This is the explicit way
     forward. The shared bar is hidden here so there is one control, not two. */
  #ftdc-{{ sid }} .ftdcg__advance {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6875rem;
    width: 100%;
    max-width: 34rem;
    margin: 1.3125rem auto 0;
    padding: 1.125rem 2.125rem;
    border: 0;
    cursor: pointer;
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-heading--family, inherit);
    font-size: var(--font-size--sm, 0.887rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }
  #ftdc-{{ sid }} .ftdcg__advance:hover { opacity: 0.9; }
  #ftdc-{{ sid }} .ftdcg__advance-arrow { transition: transform 0.18s; }
  #ftdc-{{ sid }} .ftdcg__advance:hover .ftdcg__advance-arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    #ftdc-{{ sid }} .ftdcg__advance-arrow { transition: none; }
  }
  #ftdc-{{ sid }}[data-active-step="plans"] .ftdc__bar { display: none; }

  /* ───── Upsell cards in the aside: stop the image overflowing ─────────
     .ftdc__upsell-media is a fixed 80x80 box. Narrowing only the grid track
     left the box 25px wider than its column, so it ran under the text — the
     overlap on the Creatine cards. Track and box now match at 55 (Fibonacci),
     and the text column gets a 0 floor so long words cannot push out either. */
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__upsell-media { width: 55px; height: 55px; flex: none; }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__upsell-body { min-width: 0; }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__upsell-title,
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__upsell-desc { overflow-wrap: anywhere; }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__upsell { margin-bottom: 0; }


  /* ───── Order lines in the aside ──────────────────────────────────────
     Same failure mode as the upsell cards: a 56px thumb plus a 1fr column
     that will not shrink past its longest word, inside a ~240px aside. The
     name column gets a 0 floor so it wraps instead of shoving the price out,
     and the thumb drops to 34 (Fibonacci) to match the tighter column. */
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-line {
    grid-template-columns: 34px minmax(0, 1fr) auto auto;
    gap: 0.6875rem;
    padding: 0.6875rem 0;
  }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-extra .ftdc__review-line--extra {
    grid-template-columns: 34px minmax(0, 1fr) auto;
  }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-line-thumb { width: 34px; height: 34px; }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-line-name {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--font-size--sm, 0.887rem);
  }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-line-qty,
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-line-price { font-size: var(--font-size--sm, 0.887rem); white-space: nowrap; }

  #ftdc-{{ sid }}[data-active-step="products"] .ftdc__header,
  #ftdc-{{ sid }}[data-active-step="review"] .ftdc__header { display: none; }


  @media (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__bullets { grid-template-columns: 1fr; }
  }

  /* Merged step 2 add-ons section (was step 3) */
  #ftdc-{{ sid }} .ftdc__bundle-addons { display: flex; flex-direction: column; gap: 0.5rem; }
  #ftdc-{{ sid }} .ftdc__bundle-addons-head { margin: 0 0 0.25rem; }
  #ftdc-{{ sid }} .ftdc__step-pill { transition: opacity 0.15s; }
  #ftdc-{{ sid }} .ftdc__step-pill:hover { opacity: 0.85; }

  /* Step 4 — Review */
  #ftdc-{{ sid }} .ftdc__review-plan { margin: 0.25rem 0 0; font-weight: 700; }
  #ftdc-{{ sid }} .ftdc__review-lines { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  #ftdc-{{ sid }} .ftdc__review-line { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto auto; align-items: center; gap: 0.85rem; padding: 0.75rem 0; border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12); }
  #ftdc-{{ sid }} .ftdc__review-line:first-child { border-top: 0; padding-top: 0; }
  #ftdc-{{ sid }} .ftdc__review-line-thumb { width: 56px; height: 56px; border-radius: 8px; background: rgb(var(--color-foreground-rgb) / 0.06); overflow: hidden; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  #ftdc-{{ sid }} .ftdc__review-line-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ftdc-{{ sid }} .ftdc__review-line-name { font-weight: 700; line-height: 1.25; }
  #ftdc-{{ sid }} .ftdc__review-line-qty { color: rgb(var(--color-foreground-rgb) / 0.6); font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-line-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-line-price--free { color: var(--ftdc-accent, #1FA8A1); }
  #ftdc-{{ sid }} .ftdc__review-extra { margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed rgb(var(--color-foreground-rgb) / 0.2); }
  #ftdc-{{ sid }} .ftdc__review-extra .ftdc__review-line--extra { grid-template-columns: 56px minmax(0, 1fr) auto; border-top: 0; padding-top: 0.5rem; padding-bottom: 0.5rem; }
  /* With a multiplier the extra row needs the pouch lines' four tracks. */
  #ftdc-{{ sid }} .ftdc__review-extra .ftdc__review-line--extra-qty { grid-template-columns: 56px minmax(0, 1fr) auto auto; }
  #ftdc-{{ sid }} .ftdcg__aside .ftdc__review-extra .ftdc__review-line--extra-qty { grid-template-columns: 34px minmax(0, 1fr) auto auto; }
  /* Review totals: price breakdown (Original -> Saved -> Total), anchored
     right above the buttons. Label left, value right, adidas-style. */
  #ftdc-{{ sid }} .ftdc__review-totals { margin: 1rem 0 1.25rem auto; padding-top: 0.75rem; border-top: 2px solid rgb(var(--color-foreground-rgb) / 0.2); display: flex; flex-direction: column; gap: 0.35rem; width: 100%; max-width: 24em; }
  #ftdc-{{ sid }} .ftdc__review-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; margin: 0; }
  #ftdc-{{ sid }} .ftdc__review-row--original { opacity: 0.65; }
  #ftdc-{{ sid }} .ftdc__review-row dt { margin: 0; font-weight: 700; }
  #ftdc-{{ sid }} .ftdc__review-row dd { margin: 0; font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-row--total dt, #ftdc-{{ sid }} .ftdc__review-row--total dd { font-size: 1.15rem; font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__review-row--saved dd { color: var(--ftdc-accent, #1FA8A1); }


  /* ───── One job per step ──────────────────────────────────────────────
     The whole premise of Gold is that the order stays visible while you
     build it. That is right on the Bundle step and wrong on the Plan step,
     where it showed a filled bundle bar, an add-on toggle and a priced line
     list for flavours that had not been chosen yet — a summary of decisions
     nobody had made. Each panel now belongs to the step it answers for. */
  #ftdc-{{ sid }}[data-active-step="plans"]    .ftdcg__only-bundle { display: none !important; }
  #ftdc-{{ sid }}[data-active-step="products"] .ftdcg__only-plans  { display: none !important; }

  /* ───── The plan step has no sidebar ──────────────────────────────────
     Nothing exists to summarise before a single choice has been made, so
     the column could only ever repeat the cards beside it — which is
     exactly what it did. Worse, holding a column open cost the cards the
     width they needed: at a 1000px viewport the main column came out at
     548px and the Buy Once row tore into three lines. The plan step gets
     the whole width; the aside returns on Bundle, where there is an order
     to show. */
  #ftdc-{{ sid }}[data-active-step="plans"] .ftdcg__cols { grid-template-columns: 1fr; }
  #ftdc-{{ sid }}[data-active-step="plans"] .ftdcg__aside { display: none; }
  /* Full width is not the same as unlimited: two cards spread across a
     1900px monitor read worse than two sensible ones. */
  #ftdc-{{ sid }} .ftdc__step[data-step="plans"] { max-width: 60rem; margin-inline: auto; }


  /* ───── Steps read as progress, not as a choice ───────────────────────
     Two filled pills side by side read as a segmented control — "1 Plan" or
     "Bundle", pick one — which is the opposite of what they mean. Numbered
     nodes joined by a connector, with the finished one ticked, say "step 1
     of 2" instead. */
  #ftdc-{{ sid }} .ftdc__steps { align-items: center; gap: 0; }
  #ftdc-{{ sid }} .ftdc__step-pill {
    background: none;
    padding: 0.4rem 0.6rem;
    color: rgb(var(--color-foreground-rgb) / 0.45);
  }
  #ftdc-{{ sid }} .ftdc__step-pill.is-active { background: none; color: var(--color-foreground); }
  #ftdc-{{ sid }} .ftdc__step-pill.is-done   { color: rgb(var(--color-foreground-rgb) / 0.7); }
  #ftdc-{{ sid }} .ftdc__step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    border: 2px solid currentColor;
    background: none;
    color: inherit;
    font-size: var(--font-size--2xs, 0.697rem);
  }
  #ftdc-{{ sid }} .ftdc__step-pill.is-active .ftdc__step-num {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }
  #ftdc-{{ sid }} .ftdc__step-pill.is-done .ftdc__step-num {
    background: var(--ftdc-accent, #1fa8a1);
    border-color: var(--ftdc-accent, #1fa8a1);
    color: #fff;
    font-size: 0;
  }
  #ftdc-{{ sid }} .ftdc__step-pill.is-done .ftdc__step-num::after { content: '\2713'; font-size: 0.75rem; line-height: 1; }
  #ftdc-{{ sid }} .ftdc__step-pill + .ftdc__step-pill::before {
    content: '';
    width: clamp(1.5rem, 6vw, 3.5rem);
    height: 2px;
    border-radius: 2px;
    background: rgb(var(--color-foreground-rgb) / 0.18);
  }
  #ftdc-{{ sid }} .ftdc__step-pill.is-active + .ftdc__step-pill::before,
  #ftdc-{{ sid }} .ftdc__step-pill.is-done + .ftdc__step-pill::before { background: var(--color-foreground); }


  /* ───── Plan hierarchy ────────────────────────────────────────────────
     Buy Once spanned the full width beneath the two subscriptions, so the
     option with the least value for the customer was the largest object on
     the screen and the last word on the page. It keeps the span — the row
     reads cleanly — but is styled as the footnote it is: half the padding,
     price inline instead of stacked, muted surface.

     Explicit grid placement, not flex-wrap: wrap re-flowed on the width
     left over after the badge and the title, so the price landed on its own
     line at some widths and beside the title at others. Placed cells cannot
     do that — the middle column absorbs the slack instead. */
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] {
    display: grid !important;
    /* !important: ftdc.css pins every plan card to a single-column track
       list with !important, so an unweighted declaration here loses and
       columns 2 and 3 get auto-created as implicit tracks instead. */
    grid-template-columns: auto minmax(0, 1fr) auto !important;
    align-items: center;
    column-gap: 0.75rem !important;
    row-gap: 0.25rem !important;
    padding: 0.75rem 3rem 0.75rem 1.1rem !important;
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-badge   { grid-row: 1; grid-column: 1; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-title   { grid-row: 1; grid-column: 2; width: auto !important; padding-right: 0; font-size: 15px; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-pricing { grid-row: 1; grid-column: 3; width: auto !important; margin: 0; justify-content: flex-end; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-price   { font-size: 18px; }
  /* The bullets become one compact inline row rather than a stacked list. */
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-desc    { grid-row: 2; grid-column: 1 / -1; width: auto !important; font-size: 12px; }
  /* Too narrow for one line: badge on top, then title and price paired. */
  @media screen and (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-template-columns: minmax(0, 1fr) auto !important; }
    #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-badge   { grid-row: 1; grid-column: 1 / -1; }
    #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-title   { grid-row: 2; grid-column: 1; }
    #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-pricing { grid-row: 2; grid-column: 2; }
    #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-desc    { grid-row: 3; }
  }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-desc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] .ftdc__plan-desc li { margin: 0; }
  /* The two subscription cards carry different numbers of bullets, so their
     prices landed at different heights and could not be compared at a glance.
     Column flex plus an auto top margin drops both prices to the same line. */
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan:not([data-plan="onetime"]) { display: flex !important; flex-direction: column; }
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan:not([data-plan="onetime"]) .ftdc__plan-pricing { margin-top: auto; }
  /* Lift the recommended plan clear of its neighbour. */
  #ftdc-{{ sid }} .ftdc__plan[data-plan="quarterly"].is-active { box-shadow: 0 0 0 3px color-mix(in srgb, var(--ftdc-accent) 18%, transparent), 0 6px 20px rgb(var(--color-foreground-rgb) / 0.1); }

  /* A one-time order has no target size, so updateProgress() hides the track
     rather than show a bar that reads "complete" at every quantity. */
  #ftdc-{{ sid }} .ftdc__bundle-bar[hidden] { display: none; }

  /* Desktop: the aside CTA is on screen at all times, so the inline bar is a
     second button doing the same job. Mobile: the aside stacks below the
     grid, so the bar is the action actually to hand — keep it there. */
  @media screen and (min-width: 990px) {
    #ftdc-{{ sid }} .ftdc__bar { display: none; }
  }
</style>

<div id="{{ anchor_id }}">
<section
  id="ftdc-{{ sid }}"
  class="ftdc color-{{ section.settings.color_scheme }}"
  data-section-id="{{ sid }}"
  style="--ftdc-accent: {{ section.settings.accent_color }}; --ftdc-radius: {{ section.settings.card_radius }}px; --ftdc-max-w: {{ section.settings.content_max_width }}px; padding-block-start: {{ section.settings.padding-block-start | default: 64 }}px; padding-block-end: {{ section.settings.padding-block-end | default: 64 }}px;"
  {{ section.shopify_attributes }}
>
  <div class="ftdc__inner">

    <div class="ftdc__announce" data-announce hidden></div>

    <header class="ftdc__header">
      {%- if section.settings.heading != blank -%}<h2 class="ftdc__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}<div class="ftdc__desc">{{ section.settings.description }}</div>{%- endif -%}
      <ul class="ftdc__bullets list-unstyled" data-bullets hidden></ul>
    </header>

    <ol class="ftdc__steps" role="list" aria-label="Order steps">
      <li class="ftdc__step-pill is-active" data-step-pill="plans" role="button" tabindex="0"><span class="ftdc__step-num">1</span><span class="ftdc__step-label">{{ section.settings.step_label_1 | default: 'Plan' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="products" role="button" tabindex="0"><span class="ftdc__step-num">2</span><span class="ftdc__step-label">{{ section.settings.step_label_2 | default: 'Bundle' }}</span></li>
    </ol>

    <div class="ftdcg__cols">
      <div class="ftdcg__main">

    {%- comment %} ───── STEP 1 — PLANS ───── {%- endcomment %}
    {%- assign plan_img_mob  = section.settings.plan_image_mobile | default: section.settings.plan_image -%}
    {%- assign plan_img_desk = section.settings.plan_image        | default: section.settings.plan_image_mobile -%}
    {%- assign has_plan_img  = false -%}
    {%- if section.settings.plan_image != blank or section.settings.plan_image_mobile != blank -%}
      {%- assign has_plan_img = true -%}
    {%- endif -%}
    <div class="ftdc__step is-active{% if has_plan_img %} ftdc__step--has-image{% endif %}" data-step="plans">
      {%- if has_plan_img -%}
        <div class="ftdc__plans-image">
          <picture>
            {%- if plan_img_mob != blank -%}
              <source media="(max-width: 749px)" srcset="{{ plan_img_mob | image_url: width: 800 }}">
            {%- endif -%}
            <img src="{{ plan_img_desk | image_url: width: 1000 }}" alt="" width="460" height="460" loading="lazy">
          </picture>
        </div>
      {%- endif -%}
      <div class="ftdc__plans" data-plan-order="{{ section.settings.plan_order | default: 'quarterly,monthly,onetime' }}">
        {%- if show_quarterly -%}
          <label class="ftdc__plan is-active" data-plan="quarterly">
            <input type="radio" id="ftdc-plan-q-{{ sid }}" name="ftdc-plan-{{ sid }}" value="quarterly" checked>
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            <span class="ftdcg__plan-selected" aria-hidden="true">{{ section.settings.selected_label | default: 'Selected' }}</span>
            {%- if section.settings.quarterly_badge != blank -%}<span class="ftdc__plan-badge">{{ section.settings.quarterly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ section.settings.quarterly_title | default: '3 Pouches Every 3 Months' }}</div>
            {%- if section.settings.quarterly_desc != blank -%}<div class="ftdc__plan-desc">{{ section.settings.quarterly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ section.settings.quarterly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ section.settings.quarterly_period | default: '/ month' }}</span></div>
            {%- if section.settings.quarterly_was != blank -%}<div class="ftdc__plan-was">{{ section.settings.quarterly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_monthly -%}
          <label class="ftdc__plan" data-plan="monthly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="monthly">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            <span class="ftdcg__plan-selected" aria-hidden="true">{{ section.settings.selected_label | default: 'Selected' }}</span>
            {%- if section.settings.monthly_badge != blank -%}<span class="ftdc__plan-badge">{{ section.settings.monthly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ section.settings.monthly_title | default: '1 Pouch Every Month' }}</div>
            {%- if section.settings.monthly_desc != blank -%}<div class="ftdc__plan-desc">{{ section.settings.monthly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ section.settings.monthly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ section.settings.monthly_period | default: '/ month' }}</span></div>
            {%- if section.settings.monthly_was != blank -%}<div class="ftdc__plan-was">{{ section.settings.monthly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_onetime -%}
          <label class="ftdc__plan" data-plan="onetime">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="onetime">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            <span class="ftdcg__plan-selected" aria-hidden="true">{{ section.settings.selected_label | default: 'Selected' }}</span>
            {%- if section.settings.onetime_badge != blank -%}<span class="ftdc__plan-badge">{{ section.settings.onetime_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ section.settings.onetime_title | default: 'Single Pouch' }}</div>
            {%- if section.settings.onetime_desc != blank -%}<div class="ftdc__plan-desc">{{ section.settings.onetime_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ section.settings.onetime_price | default: '$59.00' }}</span><span class="ftdc__plan-period">{{ section.settings.onetime_period | default: '/ pouch' }}</span></div>
            {%- assign _ow = section.settings.onetime_was | strip -%}
            {%- if _ow != blank and _ow != '-' and _ow != '—' -%}<div class="ftdc__plan-was">{{ section.settings.onetime_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
      </div>
      {%- comment %} The nudge to the 3-month plan, directly under the cards it
        is talking about. It lived in the aside, which the plan step no longer
        has. Shown only while the 3-month plan is NOT selected, via CSS :has()
        on the radio, so it needs no script and cannot drift out of sync with
        the runtime. The CTA is a label bound to the quarterly radio, so
        clicking it fires a real change event.

        Plan step only: switching plans clears every flavour already picked, so
        offering this beside a half-built bundle would invite the customer to
        throw their own work away. {%- endcomment %}
      {%- comment %} The 3-month nudge, captured here and rendered once, in the
        aside beneath "Your Bundle" on the Bundle step. It used to appear as a
        banner under the plan cards as well; that copy is gone, because the
        plan cards already state the 3-month offer immediately above it and the
        second ask read as clutter on the first screen. {%- endcomment %}
      {%- capture upgrade_inner -%}
        <div class="ftdcg__upgrade-copy">
          {%- if section.settings.upgrade_badge != blank -%}
            <span class="ftdcg__upgrade-badge">{{ section.settings.upgrade_badge }}</span>
          {%- endif -%}
          <p class="ftdcg__upgrade-title">{{ section.settings.upgrade_title }}</p>
          {%- if section.settings.upgrade_body != blank -%}
            <p class="ftdcg__upgrade-body">{{ section.settings.upgrade_body }}</p>
          {%- endif -%}
        </div>
        {%- comment %} A <label for> already activates its radio on click and the
          radio itself is keyboard-reachable, so role="button" only mislabelled
          it — and its tabindex led to a stop where Enter did nothing. {%- endcomment %}
        <label class="ftdcg__upgrade-cta" for="ftdc-plan-q-{{ sid }}">
          {{ section.settings.upgrade_cta | default: 'Switch to 3-month' }}
        </label>
      {%- endcapture -%}
      {%- comment %} The plan screen gets its own advance button. The shared bar is
        hidden on this step so there is exactly one thing to press. {%- endcomment %}
      <button class="ftdcg__advance" type="button" data-action="next">
        <span>{{ section.settings.plan_continue_label | default: 'Choose your flavors' }}</span>
        <span class="ftdcg__advance-arrow" aria-hidden="true">→</span>
      </button>
    </div>

    {%- comment %} ───── STEP 2 — PRODUCTS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="products" hidden>
      <button class="ftdc__back" type="button" data-step-back="plans" aria-label="Back to plan"><span aria-hidden="true">←</span> {{ section.settings.back_label | default: 'Back' }}</button>
      <div class="ftdc__empty" data-grid-empty hidden>
        <p><strong>No products configured yet.</strong></p>
        <p>In the theme editor sidebar, click each <em>Function</em> block inside this selector and pick a Shopify product. Each product variant will render as a selectable card here.</p>
      </div>
      <div class="ftdc__grid" data-grid></div>

      {%- comment %} The creatine card sits under the flavours rather than as
        another column beside them: it is an add-on, not a flavour, and the
        grid lays its children out as equal columns. One-time only. {%- endcomment %}
      <div class="ftdcg__creatine-slot" data-creatine-slot hidden></div>

      {%- comment %} ── Add-ons (merged from old Step 3) ── {%- endcomment %}
    </div>

        <div class="ftdc__bar" data-bar>
          <div class="ftdc__bar-summary">
            <span class="ftdc__bar-total"><strong>{{ section.settings.total_label | default: 'Total' }}:</strong> <span data-bar-total>$0.00</span></span>
            <span class="ftdc__bar-saved" data-bar-saved-wrap hidden>({{ section.settings.saved_word | default: 'Saved' }} <span data-bar-saved>$0.00</span>)</span>
          </div>
          <button class="ftdc__bar-action" type="button" data-action="next"><span data-bar-label>{{ section.settings.action_label_step1 | default: 'Continue' }}</span></button>
        </div>

      </div>{%- comment %} /.ftdcg__main {%- endcomment %}

      {%- comment %} ───── ORDER SUMMARY — visible on every step ───── {%- endcomment %}
      <aside class="ftdcg__aside" aria-label="{{ section.settings.summary_label | default: 'Your Order' | escape }}">
        <div class="ftdcg__aside-inner">

          {%- comment %} Bundle progress, then the add-ons. Both live in the
            aside so they stay put while the customer scrolls the flavour grid. {%- endcomment %}
          <div class="ftdc__bundle-head ftdcg__only-bundle">
            <p class="ftdc__bundle-eyebrow">{{ section.settings.bundle_label | default: 'Your Bundle' }}</p>
            <p class="ftdc__bundle-progress-text" data-progress-text>0 {{ section.settings.of_word | default: 'of' }} {{ bundle_count }} {{ section.settings.selected_word | default: 'selected' }}</p>
            <div class="ftdc__bundle-bar" data-progress-track><div class="ftdc__bundle-bar-fill" data-progress-fill style="width:0%"></div></div>
            <p class="ftdc__bundle-warning" data-bar-warning hidden role="status"></p>
          </div>

          {%- comment %} The same 3-month upsell, directly under "Your Bundle".
            Hidden by the :has() rule below once the 3-month plan is selected.
            Switching plans from here keeps the flavours already chosen —
            reclampSelections() trims them to the new plan instead of emptying
            the build. {%- endcomment %}
          {%- if section.settings.upgrade_title != blank -%}
            <div class="ftdcg__upgrade ftdcg__upgrade--aside ftdcg__only-bundle">{{ upgrade_inner }}</div>
          {%- endif -%}

          <div class="ftdc__bundle-addons ftdcg__only-bundle">
            <p class="ftdc__bundle-eyebrow ftdc__bundle-addons-head">{{ section.settings.addons_label | default: 'Add to your order' }}</p>

            {%- comment %} The creatine block drops its gift row in here; the card
              half of the same block goes into the flavour grid. {%- endcomment %}

          </div>

          <div class="ftdc__upsells ftdcg__only-bundle" data-upsells></div>

          <div class="ftdcg__summary ftdcg__only-bundle">
            <p class="ftdcg__summary-label">{{ section.settings.summary_label | default: 'Your Order' }}</p>
            <p class="ftdc__review-plan" data-review-plan></p>
            <ul class="ftdc__review-lines list-unstyled" data-review-lines></ul>
            <div class="ftdc__review-extra" data-review-extra hidden></div>
            <dl class="ftdc__review-totals">
              <div class="ftdc__review-row ftdc__review-row--original" data-review-original-wrap hidden>
                <dt>{{ section.settings.original_label | default: 'Original price' }}</dt>
                <dd data-review-original>$0.00</dd>
              </div>
              <div class="ftdc__review-row ftdc__review-row--saved" data-review-saved-wrap hidden>
                <dt>{{ section.settings.saved_word | default: 'Saved' }}</dt>
                <dd data-review-saved>$0.00</dd>
              </div>
              <div class="ftdc__review-row ftdc__review-row--total">
                <dt>{{ section.settings.total_label | default: 'Total' }}</dt>
                <dd data-review-total>$0.00</dd>
              </div>
            </dl>
            {%- if section.settings.summary_note != blank -%}
              <p class="ftdcg__summary-note">{{ section.settings.summary_note }}</p>
            {%- endif -%}
          </div>

          {%- if section.settings.shipping_note != blank -%}
            {%- comment %} Was a green bar rendered permanently at 100% — a
              progress indicator with nothing to progress toward, which is the
              same thing that made the bundle bar meaningless on a one-time
              order. It is a reassurance line, so it now looks like one. {%- endcomment %}
            <p class="ftdcg__ship">
              <svg class="ftdcg__ship-tick" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4 4 10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ section.settings.shipping_note }}</span>
            </p>
          {%- endif -%}

          {%- comment %} Cart failures land here rather than in a browser alert.
            role="alert" so it is announced when it appears. {%- endcomment %}
          <p class="ftdcg__error ftdcg__only-bundle" data-cart-error role="alert" hidden></p>

          <button class="ftdcg__cta ftdcg__only-bundle" type="button" data-action="checkout">
            {{ section.settings.checkout_label | default: 'Add to Cart' }}
          </button>

          {%- if section.settings.purchase_once_label != blank -%}
            <p class="ftdcg__once ftdcg__only-bundle">{{ section.settings.purchase_once_label }}</p>
          {%- endif -%}

        </div>
      </aside>
    </div>{%- comment %} /.ftdcg__cols {%- endcomment %}


  </div>

  {%- comment %} Hidden staging: child theme blocks render here, JS moves them. {%- endcomment %}
  <div style="display:none" data-ftdc-stage aria-hidden="true">{% content_for 'blocks' %}</div>
</section>
</div>


<script>
  (window.__ftdGoldQueue = window.__ftdGoldQueue || []).push({
    SID: {{ section.id | json }},
    BUNDLE_COUNT: {{ bundle_count | json }},
    GIFT_MIN: {{ section.settings.gift_threshold | default: 3 | json }},
    LIVE_SUMMARY: true,   /* aside shows the order on every step, not just Review */
    SKIP_REVIEW: true,      /* no Review step — the aside is the review */
    ADVANCE_ON_PLAN: true,  /* picking a plan moves straight to the flavours */
    CTA_ADDS_TO_CART: true, /* final button adds to cart and opens the drawer */
    PLAN_NAMES: {
    monthly:   {{ section.settings.monthly_title   | default: 'Monthly Subscription' | json }},
    quarterly: {{ section.settings.quarterly_title | default: 'Quarterly Bundle'     | json }},
    onetime:   {{ section.settings.onetime_title   | default: 'One-Time Purchase'    | json }}
  },
    BAR_LABELS: {
    plans:    {{ section.settings.action_label_step1 | default: 'Continue'     | json }},
    products: {{ section.settings.action_label_step2 | default: 'Review Order' | json }},
    review:   {{ section.settings.checkout_label      | default: 'Add to Cart'  | json }}
  },
    LOOP_BUNDLE: {
    enabled:           {{ section.settings.loop_bundle_enabled | json }},
    bundleId:          {{ section.settings.loop_bundle_id | default: '' | json }},
    bundleVariantId:   {{ section.settings.loop_bundle_variant_id | default: '' | json }},
    bundleDiscountId:  {{ section.settings.loop_bundle_discount_id | default: '' | json }},
    apiSellingPlanId:  {{ section.settings.loop_bundle_api_selling_plan_id | default: '' | json }},
    cartSellingPlanId: {{ section.settings.loop_bundle_selling_plan_id | default: '' | json }},
    bundleName:        {{ section.settings.loop_bundle_name | default: '' | json }},
    propKey:           {{ section.settings.loop_bundle_property_key | default: '_bundleId' | json }}
  },
    MONTHLY_PCT: {{ section.settings.monthly_estimate_pct | default: 90 }},
    QUARTERLY_PCT: {{ section.settings.quarterly_estimate_pct | default: 90 }}
  });
  if (window.__ftdGoldMain) window.__ftdGoldMain();
</script>
<script src="{{ 'ftd-selector-gold-core.js' | asset_url }}" defer></script>
<script src="{{ 'ftd-selector-gold.js' | asset_url }}" defer></script>

