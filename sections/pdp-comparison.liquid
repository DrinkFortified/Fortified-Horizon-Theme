{% render 'fortified-base' %}

<section
  id="PdpComparison-{{ section.id }}"
  class="pdp-cmp"
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container">
    <header class="pdp-cmp__head">
      <p class="pdp-cmp__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pdp-cmp__title">{{ section.settings.title }}</h2>
    </header>

    <div class="pdp-cmp__table-wrap">
      <table class="pdp-cmp__table">
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col" class="pdp-cmp__th--ours">
              <span class="p-energy">{{ section.settings.energy_col_name }}</span>
              <span class="p-everyday">{{ section.settings.everyday_col_name }}</span>
            </th>
            <th scope="col">{{ section.settings.competitor_1_name }}</th>
            <th scope="col">{{ section.settings.competitor_2_name }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'cmp_row' %}
              <tr style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
                <th scope="row" class="pdp-cmp__row-label" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">{{ block.settings.row_label }}</th>
                <td class="pdp-cmp__td pdp-cmp__td--ours">
                  {% if block.settings.is_checkmark %}
                    {% if block.settings.ours == 'yes' %}<span class="pdp-cmp__check">✓</span>{% else %}<span class="pdp-cmp__x">×</span>{% endif %}
                  {% else %}
                    {{ block.settings.ours }}
                  {% endif %}
                </td>
                <td class="pdp-cmp__td">
                  {% if block.settings.is_checkmark %}
                    {% if block.settings.comp1 == 'yes' %}<span class="pdp-cmp__check">✓</span>{% else %}<span class="pdp-cmp__x">×</span>{% endif %}
                  {% else %}
                    {{ block.settings.comp1 }}
                  {% endif %}
                </td>
                <td class="pdp-cmp__td">
                  {% if block.settings.is_checkmark %}
                    {% if block.settings.comp2 == 'yes' %}<span class="pdp-cmp__check">✓</span>{% else %}<span class="pdp-cmp__x">×</span>{% endif %}
                  {% else %}
                    {{ block.settings.comp2 }}
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-cmp { background: var(--color-foreground); color: var(--color-background); padding-block: clamp(40px, 6vw, 84px); font-family: var(--font-fortified-body); }
  .pdp-cmp__head { text-align: center; margin-bottom: 28px; }
  .pdp-cmp__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,.7); margin: 0 0 8px; }
  .pdp-cmp__title { font-family: var(--font-fortified-display); font-size: clamp(26px, 3.6vw, 40px); margin: 0; text-transform: uppercase; letter-spacing: 0.02em; }
  .pdp-cmp__table-wrap { overflow-x: auto; border-radius: 18px; border: 1px solid rgba(255,255,255,.12); }
  .pdp-cmp__table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .pdp-cmp__table th, .pdp-cmp__table td { padding: 14px 16px; text-align: center; font-size: 14px; border-bottom: 1px solid rgba(255,255,255,.1); }
  .pdp-cmp__table thead th { font-family: var(--font-fortified-display); text-transform: uppercase; letter-spacing: 0.06em; font-size: 12px; background: rgba(255,255,255,.04); color: rgba(255,255,255,.85); }
  body[data-product="energy"] .pdp-cmp__th--ours { background: var(--fortified-accent, var(--color-foreground)); color: var(--color-foreground); }
  body[data-product="everyday"] .pdp-cmp__th--ours { background: var(--fortified-accent, var(--fortified-accent, var(--color-foreground))); color: var(--color-background); }
  body[data-product="energy"] .pdp-cmp__th--ours .p-everyday,
  body[data-product="everyday"] .pdp-cmp__th--ours .p-energy { display: none; }
  .pdp-cmp__row-label { text-align: left; font-weight: 600; color: rgba(255,255,255,.9); background: rgba(255,255,255,.03); }
  body[data-product="energy"] .pdp-cmp__td--ours { background: rgba(242,169,59,.12); color: var(--fortified-accent, var(--color-foreground)); font-weight: 700; }
  body[data-product="everyday"] .pdp-cmp__td--ours { background: rgba(31,168,161,.12); color: var(--fortified-accent, var(--fortified-accent, var(--color-foreground))); font-weight: 700; }
  .pdp-cmp__check { color: var(--fortified-accent, var(--fortified-accent, var(--color-foreground))); font-weight: 700; font-size: 18px; }
  body[data-product="energy"] .pdp-cmp__td--ours .pdp-cmp__check { color: var(--fortified-accent, var(--color-foreground)); }
  .pdp-cmp__x { color: rgba(255,255,255,.4); font-size: 18px; }
{% endstylesheet %}

