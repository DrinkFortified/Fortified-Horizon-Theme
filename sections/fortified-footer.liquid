{% render 'fortified-base' %}

<footer
  id="FortifiedFooter-{{ section.id }}"
  class="fortified-footer color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
>
  <div class="fortified-container fortified-footer__inner">
    <div class="fortified-footer__brand">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'fortified-footer__logo' }}
      {% else %}
        <span class="fortified-footer__wordmark">{{ section.settings.logo_text | default: "FORTIFIED" }}</span>
      {% endif %}
      <p class="fortified-footer__desc">{{ section.settings.brand_description }}</p>
      <div class="fortified-footer__socials">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.5 8.3a6.4 6.4 0 0 1-3.7-1.2v7.6a5.4 5.4 0 1 1-5.4-5.4c.3 0 .6 0 .9.1v2.7a2.7 2.7 0 1 0 1.9 2.6V3h2.7a3.7 3.7 0 0 0 3.6 3.5v1.8Z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="fortified-footer__col">
      <h4 class="fortified-footer__col-title">{{ section.settings.shop_title | default: "SHOP" }}</h4>
      <ul>
        {% if section.settings.shop_menu != blank %}
          {% for link in section.settings.shop_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>

    <div class="fortified-footer__col">
      <h4 class="fortified-footer__col-title">{{ section.settings.learn_title | default: "LEARN" }}</h4>
      <ul>
        {% if section.settings.learn_menu != blank %}
          {% for link in section.settings.learn_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>

    <div class="fortified-footer__col fortified-footer__newsletter">
      <h4 class="fortified-footer__col-title">{{ section.settings.newsletter_title | default: "JOIN NEWSLETTER" }}</h4>
      <p class="fortified-footer__newsletter-body">{{ section.settings.newsletter_body }}</p>
      {% form 'customer', class: 'fortified-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="fortified-footer__field">
          <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" required>
          <button type="submit" class="fortified-btn fortified-btn--primary">Sign Up</button>
        </div>
        {% if form.posted_successfully? %}
          <p class="fortified-footer__success">Thanks for subscribing.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="fortified-container fortified-footer__bottom">
    <p class="fortified-footer__copy">{{ section.settings.copyright | replace: "{year}", "now" | date: "%Y" }} {{ section.settings.copyright_text }}</p>
    <ul class="fortified-footer__legal">
      {% if section.settings.legal_menu != blank %}
        {% for link in section.settings.legal_menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</footer>

{% stylesheet %}
  .fortified-footer {
    background: var(--color-background, #0A0A0A);
    color: var(--color-foreground, #FFFFFF);
    padding-block: clamp(48px, 7vw, 96px);
  }
  .fortified-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 750px) {
    .fortified-footer__inner {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 48px;
    }
  }
  .fortified-footer__brand { display: flex; flex-direction: column; gap: 14px; }
  .fortified-footer__wordmark {
    font-family: var(--font-fortified-display);
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--fortified-accent, var(--color-foreground));
  }
  .fortified-footer__logo { max-width: 200px; height: auto; }
  .fortified-footer__desc {
    font-family: var(--font-fortified-body);
    font-size: 14px;
    line-height: 1.55;
    opacity: .85;
    max-width: 360px;
  }
  .fortified-footer__socials {
    display: flex;
    gap: 14px;
    margin-top: 4px;
  }
  .fortified-footer__socials a {
    color: currentColor;
    width: 38px;
    height: 38px;
    border: 1px solid currentColor;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: .9;
  }
  .fortified-footer__socials a:hover { background: var(--fortified-accent, var(--color-foreground)); border-color: var(--fortified-accent, var(--color-foreground)); color: var(--color-foreground, #fff); }
  .fortified-footer__col-title {
    font-family: var(--font-fortified-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
    color: var(--fortified-accent, var(--color-foreground));
  }
  .fortified-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fortified-footer__col a {
    color: currentColor;
    text-decoration: none;
    font-family: var(--font-fortified-body);
    font-size: 14px;
    opacity: .85;
  }
  .fortified-footer__col a:hover { opacity: 1; color: var(--fortified-accent, var(--color-foreground)); }
  .fortified-footer__newsletter-body {
    font-size: 14px;
    line-height: 1.55;
    opacity: .85;
    margin: 0 0 14px;
  }
  .fortified-footer__field {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .fortified-footer__field input {
    flex: 1 1 200px;
    min-height: 44px;
    background: transparent;
    border: 1px solid currentColor;
    color: inherit;
    border-radius: var(--fortified-radius-pill);
    padding: 10px 18px;
    font-family: var(--font-fortified-body);
  }
  .fortified-footer__field input::placeholder { color: inherit; opacity: .65; }
  .fortified-footer__success { color: var(--fortified-success); font-size: 13px; margin-top: 8px; }
  .fortified-footer__bottom {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    justify-content: space-between;
  }
  @media (min-width: 750px) {
    .fortified-footer__bottom { flex-direction: row; align-items: center; }
  }
  .fortified-footer__copy { margin: 0; font-size: 12px; opacity: .75; }
  .fortified-footer__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .fortified-footer__legal a { color: currentColor; text-decoration: none; font-size: 12px; opacity: .8; }

  /* center-aware block alignment — when section is centered, push block content to center */
  [style*="text-align: center"] [class*="__card"],
  [style*="text-align: center"] [class*="__item"],
  [style*="text-align: center"] [class*="__panel"],
  [style*="text-align: center"] [class*="__cell"] { align-items: center !important; }
  [style*="text-align: left"] [class*="__card"],
  [style*="text-align: left"] [class*="__item"],
  [style*="text-align: left"] [class*="__panel"],
  [style*="text-align: left"] [class*="__cell"] { align-items: flex-start !important; }
  [style*="text-align: right"] [class*="__card"],
  [style*="text-align: right"] [class*="__item"],
  [style*="text-align: right"] [class*="__panel"],
  [style*="text-align: right"] [class*="__cell"] { align-items: flex-end !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Footer",
  "tag": "section",
  "class": "fortified-footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Wordmark fallback",
      "default": "FORTIFIED"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Premium hydration and electrolytes. Clinically backed, clean ingredients, zero sugar."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "text",
      "id": "shop_title",
      "label": "Shop column title",
      "default": "SHOP"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "text",
      "id": "learn_title",
      "label": "Learn column title",
      "default": "LEARN"
    },
    {
      "type": "link_list",
      "id": "learn_menu",
      "label": "Learn menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "JOIN NEWSLETTER"
    },
    {
      "type": "textarea",
      "id": "newsletter_body",
      "label": "Newsletter body",
      "default": "Get 10% off your first order plus exclusive drops."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "FORTIFIED. All rights reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Fortified Footer",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
