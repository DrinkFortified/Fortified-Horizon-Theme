{% render 'fortified-base' %}

<section
  id="FortifiedFAQ-{{ section.id }}"
  class="fortified-faq color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  <div class="fortified-container fortified-faq__inner">
    <aside class="fortified-faq__side">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--ghost">{{ section.settings.cta_label }}</a>
      {% endif %}
    </aside>

    <div class="fortified-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-faq-item' %}
          <details class="fortified-faq__item" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <summary class="fortified-faq__q">
              <span>{{ block.settings.question }}</span>
              <span class="fortified-faq__icon" aria-hidden="true">+</span>
            </summary>
            <div class="fortified-faq__a">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-faq {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-faq__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 64px);
  }
  @media (min-width: 1024px) {
    .fortified-faq__inner { grid-template-columns: 1fr 1.4fr; }
  }
  .fortified-faq__side { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .fortified-faq__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fortified-faq__item {
    border-bottom: 1px solid var(--fortified-gray-light);
    padding: 4px 0;
  }
  .fortified-faq__q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    font-family: var(--font-fortified-body);
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 600;
    min-height: 44px;
  }
  .fortified-faq__q::-webkit-details-marker { display: none; }
  .fortified-faq__icon {
    font-size: 22px;
    line-height: 1;
    color: var(--fortified-teal);
    transition: transform .2s ease;
  }
  .fortified-faq__item[open] .fortified-faq__icon { transform: rotate(45deg); }
  .fortified-faq__a {
    overflow: hidden;
    max-height: 0;
    transition: max-height .3s ease;
    padding: 0 4px;
    font-family: var(--font-fortified-body);
    font-size: 15px;
    line-height: 1.6;
    opacity: .85;
  }
  .fortified-faq__item[open] .fortified-faq__a {
    max-height: 1000px;
    padding: 0 4px 18px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "08 \u2014 FAQ",
  "tag": "section",
  "class": "fortified-faq-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "READ ALL REVIEWS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "fortified-faq-item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is Fortified?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Premium electrolytes formulated for performance.</p>"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "08 \u2014 FAQ",
      "category": "Fortified",
      "blocks": [
        {
          "type": "fortified-faq-item",
          "settings": {
            "question": "What is Fortified?"
          }
        },
        {
          "type": "fortified-faq-item",
          "settings": {
            "question": "Why is it Important?"
          }
        },
        {
          "type": "fortified-faq-item",
          "settings": {
            "question": "Who should take it?"
          }
        },
        {
          "type": "fortified-faq-item",
          "settings": {
            "question": "What is the recommended dosage?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
