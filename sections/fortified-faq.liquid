{% render 'fortified-base' %}

<section
  id="FortifiedFAQ-{{ section.id }}"
  class="fortified-faq color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 100 }}px {{ section.settings['padding-block-end'] | default: 100 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 40 }}px {{ section.settings['padding-inline-end'] | default: 40 }}px;"
>
  <div class="fortified-faq__inner">
    <aside class="fortified-faq__side">
      {% if section.settings.heading != blank %}
        <h2 class="fortified-faq__heading">{{ section.settings.heading | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="fortified-faq__body">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-faq__cta">{{ section.settings.cta_label }}</a>
      {% endif %}
    </aside>

    <div class="fortified-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-faq-item' %}
          <details class="fortified-faq__item" {{ block.shopify_attributes }}>
            <summary class="fortified-faq__q">
              <span class="fortified-faq__q-text">{{ block.settings.question }}</span>
              <span class="fortified-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="fortified-faq__a">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-faq {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-faq__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 80px;
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
  }
  .fortified-faq__side {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    text-align: left;
    position: sticky;
    top: 24px;
  }
  .fortified-faq__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-faq__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .fortified-faq__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
  }

  .fortified-faq__list {
    flex: 0 0 628px;
    max-width: 628px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .fortified-faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    padding-bottom: 12px;
  }
  .fortified-faq__q {
    list-style: none;
    cursor: pointer;
    padding: 0 0 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .fortified-faq__q::-webkit-details-marker { display: none; }
  .fortified-faq__q-text {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
  }
  .fortified-faq__icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    position: relative;
  }
  .fortified-faq__icon::before,
  .fortified-faq__icon::after {
    content: '';
    position: absolute;
    background: var(--color-foreground);
  }
  .fortified-faq__icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }
  .fortified-faq__icon::after {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%);
  }
  .fortified-faq__item[open] .fortified-faq__icon::after { display: none; }

  .fortified-faq__a {
    padding: 16px 0 12px;
    font-family: var(--font-fortified-body);
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-foreground);
    text-align: left;
  }
  .fortified-faq__a p { margin: 0 0 12px; }
  .fortified-faq__a p:last-child { margin: 0; }

  @media (max-width: 990px) {
    .fortified-faq__inner { flex-direction: column; gap: 48px; }
    .fortified-faq__side { position: static; }
    .fortified-faq__heading { font-size: 44px; }
    .fortified-faq__body { font-size: 18px; }
    .fortified-faq__list { flex: 1 1 auto; max-width: 100%; width: 100%; }
    .fortified-faq__q-text { font-size: 22px; }
    .fortified-faq__a { font-size: 18px; }
  }
  @media (max-width: 749px) {
    .fortified-faq__heading { font-size: 32px; }
    .fortified-faq__cta { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

