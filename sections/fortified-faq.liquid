{% render 'fortified-base' %}

<section
  id="FortifiedFAQ-{{ section.id }}"
  class="fortified-faq color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-faq__inner">
    <aside class="fortified-faq__side">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--ghost">{{ section.settings.cta_label }}</a>
      {% endif %}
    </aside>

    <div class="fortified-faq__list" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-faq-item' %}
          <details class="fortified-faq__item" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <summary class="fortified-faq__q">
              <span>{{ block.settings.question }}</span>
              <span class="fortified-faq__icon" aria-hidden="true">+</span>
            </summary>
            <div class="fortified-faq__a">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-faq {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-faq__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 56px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
    align-items: start;
  }
  @media (min-width: 990px) {
    .fortified-faq__inner { grid-template-columns: 1fr 1.6fr; }
  }
  .fortified-faq__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
    position: sticky;
    top: 100px;
  }
  .fortified-faq__side .fortified-heading {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .fortified-faq__side .fortified-btn--ghost {
    background: transparent;
    color: var(--color-foreground);
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    padding: 12px 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background .15s ease, border-color .15s ease;
  }
  .fortified-faq__side .fortified-btn--ghost:hover {
    background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
    border-color: var(--color-foreground);
  }

  .fortified-faq__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }
  .fortified-faq__item {
    border-bottom: 1px solid var(--color-border);
    padding: 4px 0;
  }
  .fortified-faq__item:first-child {
    border-top: 1px solid var(--color-border);
  }
  .fortified-faq__q {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-fortified-body);
    font-size: clamp(14px, 1.1vw, 16px);
    font-weight: 600;
    color: var(--color-foreground-heading);
    text-align: left;
    transition: color .15s ease;
  }
  .fortified-faq__q::-webkit-details-marker { display: none; }
  .fortified-faq__q:hover { color: var(--fortified-accent, var(--color-foreground)); }
  .fortified-faq__item[open] .fortified-faq__q { color: var(--fortified-accent, var(--color-foreground)); }

  .fortified-faq__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 400;
    color: var(--color-foreground);
    transition: all .2s ease;
  }
  .fortified-faq__item[open] .fortified-faq__icon {
    transform: none;
    background: var(--fortified-accent, var(--color-foreground));
    color: var(--color-background);
    border-color: var(--fortified-accent, var(--color-foreground));
  }

  .fortified-faq__a {
    padding: 0 0 24px;
    font-family: var(--font-fortified-body);
    font-size: clamp(13.5px, 1vw, 15px);
    line-height: 1.65;
    color: var(--color-foreground);
    opacity: 0.85;
    max-width: 680px;
    text-align: left;
  }
  .fortified-faq__a p { margin: 0 0 12px; }
  .fortified-faq__a p:last-child { margin: 0; }

  @media (max-width: 989px) {
    .fortified-faq__side { position: static; }
  }
{% endstylesheet %}

