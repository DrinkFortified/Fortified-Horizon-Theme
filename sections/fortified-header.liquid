{% render 'fortified-base' %}

<header
  id="FortifiedHeader-{{ section.id }}"
  class="fortified-header color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-sticky="{{ section.settings.sticky }}"
>
  <div class="fortified-header__inner fortified-container">
    <button
      class="fortified-header__toggle"
      type="button"
      aria-controls="FortifiedDrawer-{{ section.id }}"
      aria-expanded="false"
      aria-label="Open menu"
      data-fortified-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="fortified-header__logo">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag:
            alt: shop.name,
            class: 'fortified-header__logo-img',
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 750px) 200px, 140px' }}
      {% else %}
        <span class="fortified-header__wordmark">{{ section.settings.logo_text | default: shop.name }}</span>
      {% endif %}
    </a>

    <nav class="fortified-header__nav" aria-label="Primary">
      {% if section.settings.menu != blank %}
        <ul class="fortified-header__menu">
          {% for link in section.settings.menu.links limit: 6 %}
            <li><a href="{{ link.url }}" class="fortified-header__link">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="fortified-header__actions">
      <a href="{{ routes.account_url }}" class="fortified-header__action" aria-label="Account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        <span class="fortified-header__action-label">Account</span>
      </a>
      <a href="{{ routes.cart_url }}" class="fortified-header__action fortified-header__action--cart" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 7h12l-1.2 12.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
        <span class="fortified-header__action-label">Cart</span>
        <span class="fortified-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="fortified-header__drawer" id="FortifiedDrawer-{{ section.id }}" data-fortified-drawer hidden>
    <ul class="fortified-header__drawer-menu">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      {% endif %}
      <li><a href="{{ routes.account_url }}">Account</a></li>
      <li><a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a></li>
    </ul>
  </div>
</header>

<script>
  (function () {
    var root = document.getElementById('FortifiedHeader-{{ section.id }}');
    if (!root) return;
    var toggle = root.querySelector('[data-fortified-toggle]');
    var drawer = root.querySelector('[data-fortified-drawer]');
    if (!toggle || !drawer) return;
    toggle.addEventListener('click', function () {
      var open = drawer.hasAttribute('hidden') === false;
      if (open) {
        drawer.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        drawer.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>

{% stylesheet %}
  .fortified-header {
    background: var(--fortified-teal);
    color: var(--color-foreground, #fff);
    width: 100%;
  }
  .fortified-header[data-sticky="true"] {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .fortified-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding-block: 14px;
  }
  .fortified-header__logo {
    text-decoration: none;
    color: inherit;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .fortified-header__logo-img { max-height: 36px; width: auto; display: block; }
  .fortified-header__wordmark {
    font-family: var(--font-fortified-display);
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: 0.05em;
    color: var(--color-foreground, #fff);
    line-height: 1;
  }
  .fortified-header__menu {
    display: flex;
    gap: clamp(16px, 2.4vw, 36px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fortified-header__link {
    color: var(--color-foreground, #fff);
    text-decoration: none;
    font-family: var(--font-fortified-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 2px;
  }
  .fortified-header__link:hover { opacity: .85; }
  .fortified-header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }
  .fortified-header__action {
    color: var(--color-foreground, #fff);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-fortified-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    min-height: 44px;
  }
  .fortified-header__action-label { display: none; }
  @media (min-width: 1024px) {
    .fortified-header__action-label { display: inline; }
  }
  .fortified-header__cart-count {
    background: #fff;
    color: var(--fortified-teal);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 5px;
    margin-left: 2px;
  }
  .fortified-header__toggle {
    background: transparent;
    border: 0;
    padding: 8px;
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
  }
  .fortified-header__toggle span {
    width: 22px;
    height: 2px;
    background: #fff;
    display: block;
  }
  .fortified-header__nav { display: none; }
  @media (min-width: 1024px) {
    .fortified-header__nav { display: block; }
    .fortified-header__toggle { display: none; }
  }
  .fortified-header__drawer {
    position: fixed;
    inset: 64px 0 0 0;
    background: var(--fortified-teal);
    z-index: 99;
    padding: 32px 24px;
  }
  .fortified-header__drawer-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .fortified-header__drawer-menu a {
    color: var(--color-foreground, #fff);
    text-decoration: none;
    font-family: var(--font-fortified-display);
    font-size: 28px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Header",
  "tag": "section",
  "class": "fortified-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo wordmark (used when no image)",
      "default": "FORTIFIED"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky on scroll",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Fortified Header",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
