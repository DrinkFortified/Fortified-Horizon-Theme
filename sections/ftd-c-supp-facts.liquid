{% comment %}
  Section: FTD-C - Supp Facts
  Category: Fortified Sections
  --------------------------------------------------------------------
  Tabbed variant of FTD-B - Supp Facts. Each tab is a child theme
  block (_ftd-c-supp-product) holding one product + its panel data +
  per-product callouts.

  Child blocks self-render into a hidden staging div via
  {% content_for 'blocks' %}; JS reads each rendered <article
  data-slot="supp-panel">, builds a tab button from its data-* attrs,
  and moves the panel into the active panel container. First tab is
  active on initial load.

  Per-product data priority (inside each tab):
    1. Inline override on the child block
    2. Product metafield (fortified.pdp_content metaobject)
    3. (Globally) no further fallback — the tab simply hides that field
{% endcomment %}

{%- liquid
  assign sid = section.id
  if section.settings.section_width == 'full-width'
    assign ftcsf_max_w = '100%'
  else
    assign ftcsf_max_w = section.settings.content_max_width | append: 'px'
  endif
  assign panel_pos = section.settings.panel_position | default: 'left'
  assign tab_style = section.settings.tab_style | default: 'pill'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="ftcsf section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }} ftcsf--panel-{{ panel_pos }} ftcsf--tabs-{{ tab_style }}"
  id="ftcsf-{{ sid }}"
  data-section-id="{{ sid }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --ftcsf-max-w: {{ ftcsf_max_w }};
    --ftcsf-accent: {{ section.settings.default_accent_color | default: '#1FA8A1' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="ftcsf__inner">

    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <header class="ftcsf__section-head">
        {%- if section.settings.eyebrow != blank -%}<p class="ftcsf__section-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="ftcsf__section-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      </header>
    {%- endif -%}

    {%- comment %} Tabs row (JS-built from staged panels) {%- endcomment -%}
    <div class="ftcsf__tabs" role="tablist" aria-label="{{ section.settings.tablist_label | default: 'Compare products' | escape }}" data-ftcsf-tabs></div>

    {%- comment %} Panel container (JS moves each <article data-slot="supp-panel"> here) {%- endcomment -%}
    <div class="ftcsf__panels" data-ftcsf-panels>
      <p class="ftcsf__empty" data-ftcsf-empty>
        <strong>No products configured yet.</strong>
        Add a <em>Supp Facts Product Tab</em> block in the editor and pick a Shopify product.
      </p>
    </div>

  </div>

  {%- comment %} Hidden staging: child blocks render here, JS moves them. {%- endcomment -%}
  <div style="display:none" data-ftcsf-stage aria-hidden="true">{% content_for 'blocks' %}</div>
</section>

<style>
  #ftcsf-{{ sid }} { --ftcsf-fg: var(--color-foreground); }
  .ftcsf__inner { max-width: var(--ftcsf-max-w); margin: 0 auto; padding: 0 1rem; }
  .ftcsf__section-head { text-align: center; margin: 0 0 1.5rem; }
  .ftcsf__section-eyebrow { margin: 0 0 0.35rem; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ftcsf-accent); }
  .ftcsf__section-heading { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.15; }

  /* Tabs */
  .ftcsf__tabs { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin: 0 0 1.6rem; padding: 0; }
  .ftcsf__tabs:empty { display: none; }
  .ftcsf__tab { appearance: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.55rem 1rem; border-radius: 999px; border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.18); background: var(--color-background); color: var(--color-foreground); font: inherit; font-size: 0.85rem; font-weight: 700; transition: background 0.15s, border-color 0.15s, color 0.15s; }
  .ftcsf__tab:hover { border-color: rgb(var(--color-foreground-rgb) / 0.4); }
  .ftcsf__tab.is-active { background: var(--tab-accent, var(--ftcsf-accent)); border-color: var(--tab-accent, var(--ftcsf-accent)); color: #fff; }
  .ftcsf__tab-thumb { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; background: rgb(var(--color-foreground-rgb) / 0.08); }
  .ftcsf--tabs-underline .ftcsf__tab { border-radius: 0; border: 0; border-bottom: 2px solid transparent; padding: 0.55rem 0.4rem; background: transparent; color: rgb(var(--color-foreground-rgb) / 0.6); }
  .ftcsf--tabs-underline .ftcsf__tab.is-active { background: transparent; color: var(--color-foreground); border-bottom-color: var(--tab-accent, var(--ftcsf-accent)); }

  /* Panels */
  .ftcsf__panels { position: relative; }
  .ftcsf__empty { text-align: center; opacity: 0.6; font-size: 0.9rem; line-height: 1.45; padding: 2rem 1rem; }
  .ftcsf__empty[hidden] { display: none !important; }
  .ftcsf__panel { display: grid; grid-template-columns: minmax(280px, 360px) 1fr; gap: 2.4rem; align-items: start; }
  .ftcsf--panel-right .ftcsf__panel { grid-template-columns: 1fr minmax(280px, 360px); }
  .ftcsf--panel-right .ftcsf__panel-wrap { order: 2; }
  .ftcsf--panel-right .ftcsf__body { order: 1; }
  .ftcsf__panel[hidden] { display: none !important; }
  @media (max-width: 749px) { .ftcsf__panel { grid-template-columns: 1fr; gap: 1.5rem; } .ftcsf--panel-right .ftcsf__panel-wrap { order: 1; } .ftcsf--panel-right .ftcsf__body { order: 2; } }

  /* Nutrition Facts panel (mirrors B's structure, prefixed ftcsf) */
  .ftcsf__nfp { border: 2px solid var(--color-foreground); padding: 0.85rem 1rem; background: var(--color-background); font-family: Helvetica, Arial, sans-serif; }
  .ftcsf__nfp-title { font-size: 1.8rem; font-weight: 900; line-height: 1; padding-bottom: 0.3rem; border-bottom: 6px solid var(--color-foreground); }
  .ftcsf__nfp-meta { margin: 0.4rem 0 0; font-size: 0.85rem; }
  .ftcsf__nfp-meta--bold { display: flex; justify-content: space-between; font-weight: 700; }
  .ftcsf__rule { display: block; margin: 0.35rem 0; background: var(--color-foreground); }
  .ftcsf__rule--thin { height: 1px; }
  .ftcsf__rule--med { height: 3px; }
  .ftcsf__rule--thick { height: 6px; }
  .ftcsf__amount-per { margin-top: 0.5rem; font-size: 0.8rem; font-style: italic; font-weight: 700; }
  .ftcsf__cal-row { display: flex; justify-content: space-between; align-items: flex-end; }
  .ftcsf__cal-label { font-size: 1.1rem; font-weight: 900; }
  .ftcsf__cal-num { font-size: 1.6rem; font-weight: 900; line-height: 1; }
  .ftcsf__dv-head { text-align: right; font-size: 0.78rem; font-weight: 700; }
  .ftcsf__rows { margin-top: 0.2rem; }
  .ftcsf__row { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.86rem; padding: 0.25rem 0; }
  .ftcsf__row--indent-1 { padding-left: 1rem; }
  .ftcsf__row--indent-2 { padding-left: 2rem; }
  .ftcsf__row--indent-3 { padding-left: 3rem; }
  .ftcsf__row-label--bold { font-weight: 800; }
  .ftcsf__row-amount { margin-left: 0.35rem; font-weight: 500; }
  .ftcsf__row-dv { font-weight: 800; white-space: nowrap; }
  .ftcsf__footnote { margin: 0.5rem 0 0; font-size: 0.7rem; line-height: 1.4; opacity: 0.7; }

  /* Right column */
  .ftcsf__head { margin: 0 0 1.2rem; }
  .ftcsf__eyebrow { margin: 0 0 0.35rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ftcsf-accent); }
  .ftcsf__heading { margin: 0; font-size: clamp(1.4rem, 2.2vw, 1.9rem); line-height: 1.2; }
  .ftcsf__callouts { display: flex; flex-direction: column; gap: 1rem; }
  .ftcsf__callout { padding: 1rem 1.1rem; border-radius: 12px; background: color-mix(in srgb, var(--ftcsf-callout-accent, var(--ftcsf-accent)) 7%, var(--color-background)); border-left: 4px solid var(--ftcsf-callout-accent, var(--ftcsf-accent)); }
  .ftcsf__callout-title { margin: 0 0 0.3rem; font-size: 1rem; font-weight: 800; color: var(--color-foreground); }
  .ftcsf__callout-body { margin: 0; font-size: 0.88rem; line-height: 1.5; color: var(--color-foreground); opacity: 0.85; }
</style>

<script>
(function () {
  var SID  = {{ sid | json }};
  var root = document.getElementById('ftcsf-' + SID);
  if (!root) return;
  var stage  = root.querySelector('[data-ftcsf-stage]');
  var tabs   = root.querySelector('[data-ftcsf-tabs]');
  var panels = root.querySelector('[data-ftcsf-panels]');
  var empty  = root.querySelector('[data-ftcsf-empty]');
  if (!stage || !tabs || !panels) return;

  function activate(id) {
    panels.querySelectorAll('.ftcsf__panel').forEach(function (p) {
      var on = p.dataset.tabId === id;
      if (on) { p.removeAttribute('hidden'); p.classList.add('is-active'); }
      else    { p.setAttribute('hidden', '');  p.classList.remove('is-active'); }
    });
    tabs.querySelectorAll('.ftcsf__tab').forEach(function (b) {
      var on = b.dataset.tabId === id;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  function build() {
    if (!stage) return;
    /* Move each staged panel into the panels container. */
    var staged = Array.prototype.slice.call(stage.querySelectorAll('[data-slot="supp-panel"]'));
    staged.forEach(function (p) { panels.appendChild(p); });

    /* Rebuild the tab row from whatever panels are now in place. */
    var all = panels.querySelectorAll('.ftcsf__panel');
    tabs.innerHTML = '';
    all.forEach(function (p, i) {
      var id = p.dataset.tabId;
      var label = p.dataset.tabLabel || ('Tab ' + (i + 1));
      var thumb = p.dataset.tabThumb;
      var accent = p.dataset.tabAccent;
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ftcsf__tab';
      btn.dataset.tabId = id;
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-selected', 'false');
      if (accent) btn.style.setProperty('--tab-accent', accent);
      btn.innerHTML = (thumb ? '<img class="ftcsf__tab-thumb" src="' + thumb + '" alt="" width="22" height="22">' : '') +
                      '<span class="ftcsf__tab-label">' + label.replace(/[<>&]/g, function (c) { return ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]; }) + '</span>';
      btn.addEventListener('click', function () { activate(id); });
      tabs.appendChild(btn);
    });

    if (empty) empty.hidden = all.length > 0;
    if (all.length > 0) activate(all[0].dataset.tabId);
  }

  build();
  if (typeof MutationObserver !== 'undefined') {
    var mo = new MutationObserver(function () { build(); });
    mo.observe(stage, { childList: true, subtree: true });
  }
})();
</script>

{% schema %}
{
  "name": "FTD-C - Supp Facts",
  "tag": "section",
  "class": "ftd-c-supp-facts",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 800, "max": 1600, "step": 20, "default": 1200, "unit": "px" },
    {
      "type": "select",
      "id": "panel_position",
      "label": "Nutrition panel position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "options": [
        { "value": "pill",      "label": "Pill" },
        { "value": "underline", "label": "Underline" }
      ],
      "default": "pill"
    },
    { "type": "color", "id": "default_accent_color", "label": "Default accent color", "default": "#1FA8A1" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "tablist_label", "label": "Tablist aria-label", "default": "Compare products" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top",    "label": "Top padding",    "min": 0, "max": 200, "step": 4, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "default": 64, "unit": "px" }
  ],
  "blocks": [
    { "type": "_ftd-c-supp-product" }
  ],
  "presets": [
    {
      "name": "FTD-C - Supp Facts",
      "category": "Fortified Sections",
      "settings": {
        "eyebrow": "Compare",
        "heading": "How each formula breaks down",
        "panel_position": "left",
        "tab_style": "pill"
      },
      "blocks": {
        "p1": { "type": "_ftd-c-supp-product" },
        "p2": { "type": "_ftd-c-supp-product" }
      }
    }
  ]
}
{% endschema %}
