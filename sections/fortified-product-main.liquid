{% render 'fortified-base' %}

{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
-%}

<section
  id="FortifiedProductMain-{{ section.id }}"
  class="fortified-product-main color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
>
  <div class="fortified-container fortified-product-main__hero">
    {% comment %} Top of PDP — gallery + form column {% endcomment %}
    <div class="fortified-product-main__gallery-col">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-product-gallery' %}
          {% render 'fortified-product-gallery', product: product, block: block %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="fortified-product-main__form-col" data-loop-product-id="{{ product.id }}">
      {%- assign form_id = 'FortifiedProductForm-' | append: section.id -%}
      {% form 'product', product, id: form_id, class: 'fortified-product-form' %}
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          data-fortified-variant-input
        >
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'fortified-product-info' %}
              {% render 'fortified-product-info', product: product, block: block %}
            {% when 'fortified-variant-picker' %}
              {% render 'fortified-variant-picker', product: product, block: block, current_variant: current_variant %}
            {% when 'fortified-purchase-options' %}
              {% render 'fortified-purchase-options', product: product, block: block %}
            {% when 'fortified-subscription' %}
              {% render 'fortified-subscription', product: product, block: block, current_variant: current_variant %}
            {% when 'fortified-atc' %}
              {% render 'fortified-atc', product: product, block: block %}
            {% when 'fortified-upsell' %}
              {% render 'fortified-upsell', block: block %}
            {% when 'fortified-trust-badges' %}
              {% render 'fortified-trust-badges', block: block %}
          {% endcase %}
        {% endfor %}
      {% endform %}
    </div>
  </div>

  {% comment %} Below-the-fold content blocks render in document flow {% endcomment %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'fortified-brand-story' %}
        {% render 'fortified-brand-story', block: block %}
      {% when 'fortified-clinically-backed' %}
        {% render 'fortified-clinically-backed', block: block %}
      {% when 'fortified-testimonial' %}
        {% render 'fortified-testimonial', block: block %}
      {% when 'fortified-stats-row' %}
        {% render 'fortified-stats-row', block: block %}
      {% when 'fortified-flavors-cta' %}
        {% render 'fortified-flavors-cta', block: block %}
      {% when 'fortified-comparison-table' %}
        <div class="fortified-comparison color-{{ section.settings.color_scheme | default: 'scheme-1' }}">
          <div class="fortified-container">
            <h2 class="fortified-heading fortified-h2 fortified-comparison__heading">{{ block.settings.heading }}</h2>
            <div class="fortified-comparison__wrap">
              <table class="fortified-comparison__table">
                <thead>
                  <tr>
                    <th></th>
                    <th class="fortified-comparison__th fortified-comparison__th--ours">FORTIFIED</th>
                    <th class="fortified-comparison__th">{{ block.settings.competitor_1_name }}</th>
                    {% if block.settings.competitor_2_name != blank %}<th class="fortified-comparison__th">{{ block.settings.competitor_2_name }}</th>{% endif %}
                    {% if block.settings.competitor_3_name != blank %}<th class="fortified-comparison__th">{{ block.settings.competitor_3_name }}</th>{% endif %}
                  </tr>
                </thead>
                <tbody>
                  {% for sub_block in section.blocks %}
                    {% if sub_block.type == 'fortified-comparison-row' %}
                      <tr>
                        <th scope="row" class="fortified-comparison__row-label" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">{{ sub_block.settings.row_label }}</th>
                        {% if sub_block.settings.is_checkmark_row %}
                          <td class="fortified-comparison__td fortified-comparison__td--ours">{% if sub_block.settings.fortified_value contains 'yes' or sub_block.settings.fortified_value == '✓' %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>
                          <td class="fortified-comparison__td">{% if sub_block.settings.comp_1_value contains 'yes' or sub_block.settings.comp_1_value == '✓' %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>
                          {% if block.settings.competitor_2_name != blank %}<td class="fortified-comparison__td">{% if sub_block.settings.comp_2_value contains 'yes' or sub_block.settings.comp_2_value == '✓' %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                          {% if block.settings.competitor_3_name != blank %}<td class="fortified-comparison__td">{% if sub_block.settings.comp_3_value contains 'yes' or sub_block.settings.comp_3_value == '✓' %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                        {% else %}
                          <td class="fortified-comparison__td fortified-comparison__td--ours">{{ sub_block.settings.fortified_value }}</td>
                          <td class="fortified-comparison__td">{{ sub_block.settings.comp_1_value }}</td>
                          {% if block.settings.competitor_2_name != blank %}<td class="fortified-comparison__td">{{ sub_block.settings.comp_2_value }}</td>{% endif %}
                          {% if block.settings.competitor_3_name != blank %}<td class="fortified-comparison__td">{{ sub_block.settings.comp_3_value }}</td>{% endif %}
                        {% endif %}
                      </tr>
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      {% when 'fortified-lifestyle-strip-block' %}
        {% render 'fortified-lifestyle-strip-block', block: block %}
      {% when 'fortified-reviews' %}
        {% render 'fortified-reviews', product: product, block: block %}
      {% when 'fortified-faq-block' %}
        {% render 'fortified-faq-block', block: block %}
      {% when 'fortified-subscribe-block' %}
        {% render 'fortified-subscribe-block', block: block %}
    {% endcase %}
  {% endfor %}
</section>

{% stylesheet %}
  .fortified-product-main {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
  }
  .fortified-product-main__hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 64px);
    padding-block: clamp(24px, 4vw, 64px);
  }
  @media (min-width: 1024px) {
    .fortified-product-main__hero { grid-template-columns: 1.2fr 1fr; }
  }
  .fortified-product-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .fortified-comparison {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-comparison__heading { text-align: center; margin-bottom: 32px; }
  .fortified-comparison__wrap { overflow-x: auto; }
  .fortified-comparison__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-fortified-body);
    min-width: 600px;
  }
  .fortified-comparison__th {
    padding: 14px 12px;
    text-align: center;
    font-family: var(--font-fortified-display);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--fortified-gray-light);
    color: var(--fortified-black);
    border-bottom: 2px solid var(--fortified-gray-light);
  }
  .fortified-comparison__th--ours { background: var(--fortified-teal); color: var(--color-foreground, #fff); }
  .fortified-comparison__row-label {
    text-align: left;
    padding: 14px 12px;
    font-weight: 600;
    font-size: 14px;
    background: var(--fortified-off-white);
    border-bottom: 1px solid var(--fortified-gray-light);
  }
  .fortified-comparison__td {
    padding: 14px 12px;
    text-align: center;
    font-size: 14px;
    border-bottom: 1px solid var(--fortified-gray-light);
  }
  .fortified-comparison__td--ours { background: rgb(0 184 184 / .08); font-weight: 700; color: var(--fortified-teal); }
  .fortified-comparison__check { color: var(--fortified-teal); font-weight: 700; font-size: 18px; }
  .fortified-comparison__x { color: var(--fortified-gray-mid); font-size: 18px; }
{% endstylesheet %}

