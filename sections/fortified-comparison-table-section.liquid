{% render 'fortified-base' %}

<section
  id="FortifiedComparison-{{ section.id }}"
  class="fortified-comparison color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 100 }}px {{ section.settings['padding-block-end'] | default: 100 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 40 }}px {{ section.settings['padding-inline-end'] | default: 40 }}px;"
>
  <div class="fortified-comparison__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="fortified-comparison__header">
        {% if section.settings.eyebrow != blank %}
          <p class="fortified-comparison__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="fortified-comparison__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h2>
        {% endif %}
      </header>
    {% endif %}

    {%- liquid
      assign rows = ''
      for block in section.blocks
        if block.type == 'fortified-comparison-row'
          assign rows = rows | append: block.settings.label | append: '||'
        endif
      endfor
      assign row_labels = rows | split: '||'
    -%}

    <div class="fortified-comparison__table">
      <div class="fortified-comparison__labels">
        <div class="fortified-comparison__label-head" aria-hidden="true"></div>
        {% for block in section.blocks %}
          {% if block.type == 'fortified-comparison-row' %}
            <div class="fortified-comparison__label">{% render 'fortified-accent-text', text: block.settings.label %}</div>
          {% endif %}
        {% endfor %}
      </div>

      {% for c in (1..4) %}
        {%- assign brand_key = 'col_' | append: c | append: '_brand' -%}
        {%- assign brand = section.settings[brand_key] -%}
        {%- if brand != blank or c == 1 -%}
          {%- assign is_ours = false -%}
          {%- if c == 1 -%}{%- assign is_ours = true -%}{%- endif -%}
          <div class="fortified-comparison__column {% if is_ours %}fortified-comparison__column--ours{% endif %}">
            {% if is_ours %}
              <div class="fortified-comparison__brand fortified-comparison__brand--ours">
                {% if section.settings.col_1_logo != blank %}
                  {{ section.settings.col_1_logo | image_url: width: 380 | image_tag:
                      widths: '190, 380',
                      sizes: '190px',
                      class: 'fortified-comparison__logo',
                      alt: section.settings.col_1_brand | default: 'Fortified',
                      loading: 'lazy' }}
                {% else %}
                  <p class="fortified-comparison__brand-text">{{ section.settings.col_1_brand | default: 'Fortified' }}</p>
                {% endif %}
              </div>
            {% else %}
              <p class="fortified-comparison__brand-text">{{ brand }}</p>
            {% endif %}
            {% for block in section.blocks %}
              {% if block.type == 'fortified-comparison-row' %}
                {%- assign val_key = 'col_' | append: c | append: '_value' -%}
                {%- assign val = block.settings[val_key] -%}
                <div class="fortified-comparison__cell">
                  {%- if val == 'true' or val == '✓' -%}
                    <span class="fortified-comparison__check" aria-hidden="true">✓</span>
                  {%- elsif val == 'false' or val == '✗' or val == 'x' -%}
                    <span class="fortified-comparison__x" aria-hidden="true">✕</span>
                  {%- elsif val != blank -%}
                    <span class="fortified-comparison__value">{{ val }}</span>
                  {%- else -%}
                    <span class="fortified-comparison__x" aria-hidden="true">—</span>
                  {%- endif -%}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {%- endif -%}
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-comparison__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-comparison {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-comparison__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
  }
  .fortified-comparison__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    max-width: 720px;
    text-align: center;
    text-transform: uppercase;
  }
  .fortified-comparison__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    margin: 0;
  }
  .fortified-comparison__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-comparison__table {
    display: flex;
    gap: 0;
    width: 100%;
    align-items: stretch;
  }
  .fortified-comparison__labels {
    flex: 0 0 26%;
    display: flex;
    flex-direction: column;
    padding: 52px 0;
  }
  .fortified-comparison__label-head {
    height: 32px;
    margin-bottom: 58px;
  }
  .fortified-comparison__label {
    font-family: var(--font-fortified-body);
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    min-height: 42px;
    display: flex;
    align-items: center;
    margin-bottom: 58px;
  }
  .fortified-comparison__label:last-of-type { margin-bottom: 0; }

  .fortified-comparison__column {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 58px;
    padding: 52px 24px;
    border-radius: 14px;
    background: transparent;
    color: var(--color-foreground);
  }
  .fortified-comparison__column--ours {
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .fortified-comparison__brand {
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fortified-comparison__brand-text {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: inherit;
    margin: 0;
    height: 32px;
    display: flex;
    align-items: center;
  }
  .fortified-comparison__logo {
    height: 32px;
    width: auto;
    filter: invert(1) brightness(2);
  }
  .fortified-comparison__cell {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .fortified-comparison__value {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: inherit;
  }
  .fortified-comparison__column--ours .fortified-comparison__value {
    font-weight: 600;
  }
  .fortified-comparison__check {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--fortified-accent);
    color: var(--color-background);
    font-size: 22px;
    font-weight: 700;
  }
  .fortified-comparison__column--ours .fortified-comparison__check {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-comparison__x {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, currentColor 35%, transparent);
    color: color-mix(in srgb, currentColor 55%, transparent);
    font-size: 18px;
  }

  .fortified-comparison__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 412px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-comparison__inner { gap: 48px; }
    .fortified-comparison__heading { font-size: 44px; }
    .fortified-comparison__labels { flex: 0 0 32%; }
    .fortified-comparison__label, .fortified-comparison__value, .fortified-comparison__brand-text { font-size: 18px; }
    .fortified-comparison__column { padding: 32px 16px; gap: 40px; }
    .fortified-comparison__label { margin-bottom: 40px; }
  }
  @media (max-width: 749px) {
    .fortified-comparison__heading { font-size: 32px; }
    .fortified-comparison__labels { flex: 0 0 38%; }
    .fortified-comparison__check, .fortified-comparison__x { width: 28px; height: 28px; font-size: 14px; }
    .fortified-comparison__cta { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP-05 — Comparison Table",
  "tag": "section",
  "class": "fortified-comparison-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color. Use line breaks to split into multiple lines.",
      "default": "WHY WE BEAT THE REST\n*electrolytes*"
    },
    {
      "type": "header",
      "content": "Column 1 (Fortified — highlighted)"
    },
    {
      "type": "image_picker",
      "id": "col_1_logo",
      "label": "Logo (image)"
    },
    {
      "type": "text",
      "id": "col_1_brand",
      "label": "Brand (fallback text)",
      "default": "Fortified"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "col_2_brand",
      "label": "Brand",
      "default": "Liquid IV"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "col_3_brand",
      "label": "Brand",
      "default": "Liquid IV"
    },
    {
      "type": "header",
      "content": "Column 4"
    },
    {
      "type": "text",
      "id": "col_4_brand",
      "label": "Brand",
      "default": "Liquid IV"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP FORTIFIED NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fortified-comparison-row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Sodium per serving"
        },
        {
          "type": "text",
          "id": "col_1_value",
          "label": "Column 1 value",
          "info": "Use ✓ for checkmark, ✗ for X, or any text/number.",
          "default": "1000mg"
        },
        {
          "type": "text",
          "id": "col_2_value",
          "label": "Column 2 value",
          "default": "500mg"
        },
        {
          "type": "text",
          "id": "col_3_value",
          "label": "Column 3 value",
          "default": "1000mg"
        },
        {
          "type": "text",
          "id": "col_4_value",
          "label": "Column 4 value",
          "default": "270mg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP-05 — Comparison Table",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        { "type": "fortified-comparison-row", "settings": { "label": "Sodium per serving", "col_1_value": "1000mg", "col_2_value": "500mg", "col_3_value": "1000mg", "col_4_value": "270mg" } },
        { "type": "fortified-comparison-row", "settings": { "label": "Sugar-free", "col_1_value": "✓", "col_2_value": "✓", "col_3_value": "✓", "col_4_value": "✓" } },
        { "type": "fortified-comparison-row", "settings": { "label": "Energy version (caffeine)", "col_1_value": "✓", "col_2_value": "✓", "col_3_value": "✓", "col_4_value": "✓" } },
        { "type": "fortified-comparison-row", "settings": { "label": "Real fruit flavor", "col_1_value": "✓", "col_2_value": "✓", "col_3_value": "✓", "col_4_value": "✓" } },
        { "type": "fortified-comparison-row", "settings": { "label": "Magnesium glycinate", "col_1_value": "✓", "col_2_value": "✓", "col_3_value": "✓", "col_4_value": "✓" } },
        { "type": "fortified-comparison-row", "settings": { "label": "Trial price (3 sticks)", "col_1_value": "$1.99", "col_2_value": "$8.97", "col_3_value": "$5.97", "col_4_value": "$5.97" } }
      ]
    },
    {
      "name": "Comparison Table",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": [
        { "type": "fortified-comparison-row" },
        { "type": "fortified-comparison-row" },
        { "type": "fortified-comparison-row" }
      ]
    }
  ]
}
{% endschema %}
