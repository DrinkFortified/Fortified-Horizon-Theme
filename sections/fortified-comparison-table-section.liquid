{% render 'fortified-base' %}

<section
  id="FortifiedComparison-{{ section.id }}"
  class="fortified-comparison color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container">
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2 fortified-comparison__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="fortified-comparison__wrap">
      <table class="fortified-comparison__table">
        <thead>
          <tr>
            <th></th>
            <th class="fortified-comparison__th fortified-comparison__th--ours">FORTIFIED</th>
            <th class="fortified-comparison__th">{{ section.settings.competitor_1_name }}</th>
            {% if section.settings.competitor_2_name != blank %}<th class="fortified-comparison__th">{{ section.settings.competitor_2_name }}</th>{% endif %}
            {% if section.settings.competitor_3_name != blank %}<th class="fortified-comparison__th">{{ section.settings.competitor_3_name }}</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'fortified-comparison-row' %}
              <tr style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
                <th scope="row" class="fortified-comparison__row-label" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">{{ block.settings.row_label }}</th>
                {% if block.settings.is_checkmark_row %}
                  <td class="fortified-comparison__td fortified-comparison__td--ours">{% if block.settings.fortified_value contains "yes" or block.settings.fortified_value == "✓" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>
                  <td class="fortified-comparison__td">{% if block.settings.comp_1_value contains "yes" or block.settings.comp_1_value == "✓" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>
                  {% if section.settings.competitor_2_name != blank %}<td class="fortified-comparison__td">{% if block.settings.comp_2_value contains "yes" or block.settings.comp_2_value == "✓" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                  {% if section.settings.competitor_3_name != blank %}<td class="fortified-comparison__td">{% if block.settings.comp_3_value contains "yes" or block.settings.comp_3_value == "✓" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                {% else %}
                  <td class="fortified-comparison__td fortified-comparison__td--ours">{{ block.settings.fortified_value }}</td>
                  <td class="fortified-comparison__td">{{ block.settings.comp_1_value }}</td>
                  {% if section.settings.competitor_2_name != blank %}<td class="fortified-comparison__td">{{ block.settings.comp_2_value }}</td>{% endif %}
                  {% if section.settings.competitor_3_name != blank %}<td class="fortified-comparison__td">{{ block.settings.comp_3_value }}</td>{% endif %}
                {% endif %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if section.settings.cta_label != blank %}
      <div class="fortified-comparison__cta">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-comparison {
    background: var(--color-background, #1a1a1a);
    color: var(--color-foreground, #fff);
    overflow: hidden;
  }
  .fortified-comparison__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 36px);
  }
  .fortified-comparison__heading {
    color: var(--color-foreground, #fff);
    text-align: center;
    margin-bottom: 8px;
  }
  .fortified-comparison__body {
    text-align: center;
    color: rgba(255,255,255,0.7);
    font-size: 14px;
    max-width: 520px;
    margin: 0 auto 16px;
  }
  .fortified-comparison__wrap {
    width: 100%;
    overflow-x: auto;
    border-radius: 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .fortified-comparison__table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    background: transparent;
  }
  .fortified-comparison__th,
  .fortified-comparison__table th {
    padding: 16px 14px;
    text-align: center;
    font-family: var(--font-fortified-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .fortified-comparison__th--ours,
  .fortified-comparison__table th:nth-child(2) {
    background: var(--fortified-accent, var(--fortified-teal));
    color: var(--color-foreground, #1a1a1a);
  }
  .fortified-comparison__table td {
    padding: 14px;
    text-align: center;
    font-size: 13.5px;
    color: rgba(255,255,255,0.5);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .fortified-comparison__table td:first-child {
    text-align: left;
    color: rgba(255,255,255,0.85);
    font-weight: 500;
  }
  .fortified-comparison__table td:nth-child(2) {
    color: var(--color-foreground, #fff);
    font-weight: 600;
    background: rgba(242,169,59,0.08);
  }
  .fortified-comparison__check {
    color: var(--fortified-success);
    font-weight: 700;
  }
  .fortified-comparison__no {
    color: rgba(224,112,112,0.7);
    font-size: 18px;
  }
  .fortified-comparison__cta {
    margin-top: 4px;
    background: #fff;
    color: var(--color-foreground, #1a1a1a);
    align-self: center;
  }
{% endstylesheet %}

