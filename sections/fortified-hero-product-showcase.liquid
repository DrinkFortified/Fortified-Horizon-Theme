{% comment %}
  Section: FTD - Hero Showcase
{% endcomment %}

{%- liquid
  assign overlay_a = section.settings.overlay_opacity | divided_by: 100.0
  assign focal = section.settings.background_image_focal
  assign focal_pos = 'center center'
  case focal
    when 'top-left'
      assign focal_pos = 'top left'
    when 'top-center'
      assign focal_pos = 'top center'
    when 'top-right'
      assign focal_pos = 'top right'
    when 'center-left'
      assign focal_pos = 'center left'
    when 'center'
      assign focal_pos = 'center center'
    when 'center-right'
      assign focal_pos = 'center right'
    when 'bottom-left'
      assign focal_pos = 'bottom left'
    when 'bottom-center'
      assign focal_pos = 'bottom center'
    when 'bottom-right'
      assign focal_pos = 'bottom right'
  endcase
  if section.settings.text_color == 'dark'
    assign hero_text_color = 'var(--color-foreground)'
    assign hero_btn_outline_text = 'var(--color-foreground)'
  else
    assign hero_text_color = '#ffffff'
    assign hero_btn_outline_text = '#ffffff'
  endif
  assign cta_class = 'fths__cta fths__cta--' | append: section.settings.button_style
  if section.settings.section_width == 'full-width'
    assign fths_max_w = '100%'
  else
    assign fths_max_w = section.settings.content_max_width | append: 'px'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="fths section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --fths-max-w: {{ fths_max_w }};
    --fths-left-w: {{ section.settings.left_width_desktop }}%;
    --fths-card-gap: {{ section.settings.card_gap }}px;
    --fths-card-radius: {{ section.settings.card_radius }}px;
    --fths-overlay-color: {{ section.settings.overlay_color }};
    --fths-overlay-alpha: {{ overlay_a }};
    --fths-text-color: {{ hero_text_color }};
    --fths-btn-outline-text: {{ hero_btn_outline_text }};
    --fths-focal: {{ focal_pos }};
  "
  {{ section.shopify_attributes }}
>
  <div class="fths__inner">
    <div class="fths__hero">
      {%- if section.settings.background_image != blank -%}
        {%- assign bg_url = section.settings.background_image | image_url: width: 1600 -%}
        <div class="fths__hero-bg" style="background-image:url('{{ bg_url }}');" aria-hidden="true"></div>
      {%- endif -%}
      <div class="fths__hero-overlay" aria-hidden="true"></div>
      <div class="fths__hero-content">
        {%- if section.settings.eyebrow != blank -%}<p class="fths__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="fths__heading">{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<p class="fths__body">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    </div>
    <div class="fths__cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
          {%- assign product = block.settings.product -%}
          {%- if block.settings.name_override != blank -%}{%- assign card_name = block.settings.name_override -%}{%- elsif product != blank -%}{%- assign card_name = product.title -%}{%- else -%}{%- assign card_name = '' -%}{%- endif -%}
          {%- if block.settings.button_link_override != blank -%}{%- assign card_link = block.settings.button_link_override -%}{%- elsif product != blank -%}{%- assign card_link = product.url -%}{%- else -%}{%- assign card_link = '' -%}{%- endif -%}
          {%- if block.settings.card_image_override != blank -%}{%- assign card_image = block.settings.card_image_override -%}{%- elsif product != blank and product.featured_image != blank -%}{%- assign card_image = product.featured_image -%}{%- else -%}{%- assign card_image = blank -%}{%- endif -%}
          {%- if block.settings.price_override != blank -%}{%- assign price_text = block.settings.price_override -%}{%- elsif product != blank -%}{%- assign price_text = product.price | money -%}{%- else -%}{%- assign price_text = '' -%}{%- endif -%}
          {%- assign show_compare = false -%}
          {%- assign compare_text = '' -%}
          {%- if block.settings.show_compare_at -%}
            {%- if block.settings.compare_at_override != blank -%}
              {%- assign override = block.settings.compare_at_override | strip -%}
              {%- if override != '0' and override != '' -%}
                {%- assign show_compare = true -%}
                {%- assign compare_text = block.settings.compare_at_override -%}
              {%- endif -%}
            {%- elsif product != blank and product.compare_at_price_max > product.price -%}
              {%- assign show_compare = true -%}
              {%- assign compare_text = product.compare_at_price_max | money -%}
            {%- endif -%}
          {%- endif -%}
          {%- assign btn_class = 'fths-card__btn fths-card__btn--' | append: block.settings.button_style -%}
          <article class="fths-card" {{ block.shopify_attributes }}>
            <div class="fths-card__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 800 | image_tag: class: 'fths-card__img', loading: 'lazy', widths: '200,400,600,800,1000', alt: card_name }}
              {%- else -%}
                <div class="fths-card__img fths-card__img--placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="fths-card__body">
              {%- if card_name != blank -%}<h3 class="fths-card__name">{{ card_name }}</h3>{%- endif -%}
              {%- if price_text != blank or show_compare -%}
                <div class="fths-card__prices">
                  {%- if price_text != blank -%}<span class="fths-card__price">{{ price_text }}</span>{%- endif -%}
                  {%- if show_compare -%}<s class="fths-card__compare">{{ compare_text }}</s>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                {%- if card_link != blank -%}<a class="{{ btn_class }}" href="{{ card_link }}">{{ block.settings.button_label }}</a>{%- else -%}<span class="{{ btn_class }}" role="button">{{ block.settings.button_label }}</span>{%- endif -%}
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="fths__cta-wrap">
        {%- if section.settings.button_link != blank -%}<a class="{{ cta_class }}" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- else -%}<span class="{{ cta_class }}" role="button">{{ section.settings.button_label }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.fths { display: block; }
.fths__inner { max-width: var(--fths-max-w, 1240px); margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); display: grid; grid-template-columns: var(--fths-left-w, 42%) 1fr; grid-template-areas: "hero cards" "hero cards"; gap: clamp(20px, 3vw, 32px); align-items: stretch; }
.fths__hero { position: relative; grid-area: hero; min-height: clamp(420px, 56vw, 640px); border-radius: var(--fths-card-radius, 12px); overflow: hidden; display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 4vw, 56px); isolation: isolate; background-color: #0a0a0a; }
.fths__hero-bg { position: absolute; inset: 0; background-size: cover; background-position: var(--fths-focal, center center); background-repeat: no-repeat; z-index: 0; }
.fths__hero-overlay { position: absolute; inset: 0; background-color: var(--fths-overlay-color, #000); opacity: var(--fths-overlay-alpha, 0.25); z-index: 1; pointer-events: none; }
.fths__hero-content { position: relative; z-index: 2; display: flex; flex-direction: column; gap: clamp(12px, 1.6vw, 18px); color: var(--fths-text-color, #fff); max-width: 32rem; }
.fths__eyebrow { margin: 0; font-family: var(--font-heading--family, inherit); font-size: 13px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: inherit; }
.fths__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-size: clamp(32px, 5vw, 64px); font-weight: 800; line-height: 1.02; text-transform: uppercase; color: inherit; }
.fths__body { margin: 0; font-size: 16px; line-height: 1.55; color: inherit; opacity: 0.92; max-width: 28rem; }
.fths__cards { grid-area: cards; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--fths-card-gap, 16px); align-content: stretch; }
.fths-card { display: flex; flex-direction: column; background: var(--color-background, #fff); color: var(--color-foreground, #111); border-radius: var(--fths-card-radius, 12px); overflow: hidden; box-shadow: 0 6px 20px rgb(var(--color-foreground-rgb) / 0.08); border: 1px solid rgb(var(--color-foreground-rgb) / 0.06); }
.fths-card__media { position: relative; width: 100%; aspect-ratio: 1 / 1; background: rgb(var(--color-foreground-rgb) / 0.04); overflow: hidden; }
.fths-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.fths-card__img--placeholder { background: linear-gradient(135deg, rgb(var(--color-foreground-rgb) / 0.06), rgb(var(--color-foreground-rgb) / 0.12)); }
.fths-card__body { display: flex; flex-direction: column; gap: 10px; padding: clamp(14px, 1.6vw, 20px); align-items: flex-start; }
.fths-card__name { margin: 0; font-family: var(--font-heading--family, inherit); font-size: clamp(15px, 1.4vw, 18px); font-weight: 700; line-height: 1.2; color: var(--color-foreground, #111); }
.fths-card__prices { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.fths-card__price { font-size: clamp(15px, 1.4vw, 18px); font-weight: 700; color: var(--color-primary-button-background, var(--color-foreground)); }
.fths-card__compare { font-size: 13px; color: rgb(var(--color-foreground-rgb) / 0.55); text-decoration: line-through; }
.fths-card__btn { display: inline-flex; align-items: center; justify-content: center; margin-top: 4px; padding: 10px 18px; font-family: var(--font-heading--family, inherit); font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; border-radius: var(--style-border-radius-buttons-primary, 8px); border: 2px solid var(--color-primary-button-background, var(--color-foreground)); cursor: pointer; transition: opacity 0.18s ease, background 0.18s ease, color 0.18s ease; }
.fths-card__btn--filled { background: var(--color-primary-button-background, var(--color-foreground)); color: var(--color-primary-button-text, var(--color-background)); }
.fths-card__btn--filled:hover { opacity: 0.88; }
.fths-card__btn--outline { background: transparent; color: var(--color-primary-button-background, var(--color-foreground)); }
.fths-card__btn--outline:hover { background: var(--color-primary-button-background, var(--color-foreground)); color: var(--color-primary-button-text, var(--color-background)); }
.fths__cta-wrap { grid-area: hero; align-self: end; justify-self: start; position: relative; z-index: 3; margin: clamp(20px, 3vw, 32px) 0 0 clamp(28px, 4vw, 56px); padding-bottom: clamp(28px, 4vw, 56px); pointer-events: none; }
.fths__cta { pointer-events: auto; display: inline-flex; align-items: center; justify-content: center; padding: 14px 32px; font-family: var(--font-heading--family, inherit); font-size: 14px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; border-radius: var(--style-border-radius-buttons-primary, 8px); border: 2px solid var(--fths-btn-outline-text, #fff); cursor: pointer; transition: opacity 0.18s ease, background 0.18s ease, color 0.18s ease; }
.fths__cta--outline { background: transparent; color: var(--fths-btn-outline-text, #fff); }
.fths__cta--outline:hover { background: var(--fths-btn-outline-text, #fff); color: #0a0a0a; }
.fths__cta--filled { background: var(--color-primary-button-background, var(--fths-btn-outline-text, #fff)); color: var(--color-primary-button-text, #0a0a0a); }
.fths__cta--filled:hover { opacity: 0.88; }
@media (max-width: 749px) {
  .fths__inner { grid-template-columns: 1fr; grid-template-areas: "hero" "cards" "cta"; gap: clamp(16px, 4vw, 24px); padding-inline: clamp(14px, 4vw, 24px); }
  .fths__hero { min-height: clamp(320px, 70vw, 460px); padding: clamp(24px, 6vw, 36px); text-align: center; align-items: center; justify-content: center; }
  .fths__hero-content { align-items: center; text-align: center; }
  .fths__cards { grid-template-columns: 1fr; gap: var(--fths-card-gap, 16px); }
  .fths-card { flex-direction: row; align-items: stretch; }
  .fths-card__media { flex: 0 0 40%; aspect-ratio: 1 / 1; width: auto; }
  .fths-card__body { flex: 1 1 auto; justify-content: center; padding: clamp(12px, 4vw, 18px); }
  .fths__cta-wrap { grid-area: cta; align-self: stretch; justify-self: stretch; margin: 0; padding: 0; display: flex; justify-content: center; }
  .fths__cta { width: 100%; max-width: 28rem; }
}
[hidden] { display: none !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "FTD - Hero Showcase",
  "tag": "section",
  "class": "fths-section",
  "settings": [
    { "type": "header", "content": "Hero text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Fuel Your Every Move." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Electrolytes don't provide full recovery. UNDO Regenerate combines hydration." },
    { "type": "header", "content": "Hero button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore All Flavors" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "outline", "options": [ { "value": "outline", "label": "Outline" }, { "value": "filled", "label": "Filled" } ] },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "select", "id": "background_image_focal", "label": "Background focal point", "default": "center", "options": [ { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" }, { "value": "center-left", "label": "Center left" }, { "value": "center", "label": "Center" }, { "value": "center-right", "label": "Center right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" } ] },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25 },
    { "type": "select", "id": "text_color", "label": "Hero text color", "default": "light", "options": [ { "value": "light", "label": "Light (white)" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "left_width_desktop", "label": "Hero column width (desktop)", "min": 30, "max": 60, "step": 2, "unit": "%", "default": 42 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "page-width", "options": [ { "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" } ] },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 600, "max": 1800, "step": 20, "unit": "px", "default": 1240 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 64 },
    { "type": "header", "content": "Advanced" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "info": "Targets this section." }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "card_image_override", "label": "Image override", "info": "Optional. Defaults to the product featured image." },
        { "type": "text", "id": "name_override", "label": "Name override", "info": "Optional. Defaults to product title." },
        { "type": "text", "id": "price_override", "label": "Price override", "info": "Optional. Overrides product price display." },
        { "type": "text", "id": "compare_at_override", "label": "Compare-at override", "info": "Optional. Pass 0 or blank to hide compare-at." },
        { "type": "checkbox", "id": "show_compare_at", "label": "Show compare-at price", "default": true },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
        { "type": "url", "id": "button_link_override", "label": "Button link override", "info": "Optional. Defaults to product URL." },
        { "type": "select", "id": "button_style", "label": "Button style", "default": "filled", "options": [ { "value": "filled", "label": "Filled" }, { "value": "outline", "label": "Outline" } ] }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "FTD - Hero Showcase",
      "category": "Fortified Sections",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
