{% comment %}
  Section: FTD-B - Comparison
{% endcomment %}

{%- liquid
  assign heading_html = section.settings.heading
  assign emphasis_word = section.settings.heading_emphasis_word
  if heading_html != blank and emphasis_word != blank
    assign em_open = '<em class="ftbcm__em">'
    assign em_close = '</em>'
    assign emphasized = em_open | append: emphasis_word | append: em_close
    assign heading_html = heading_html | replace_first: emphasis_word, emphasized
  endif
  assign feature_rows = section.blocks | where: 'type', 'feature_row'
  assign competitors  = section.blocks | where: 'type', 'competitor'
  assign muted_opacity = section.settings.panel_text_muted_opacity | divided_by: 100.0
-%}

<section
  class="ftbcm section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %} --ftbcm-max-w: {{ section.settings.content_max_width }}px; --ftbcm-eyebrow: {{ section.settings.eyebrow_color }}; --ftbcm-panel-bg: {{ section.settings.panel_background }}; --ftbcm-panel-fg: {{ section.settings.panel_text_color }}; --ftbcm-panel-muted-fg: {{ section.settings.panel_text_color }}; --ftbcm-muted-opacity: {{ muted_opacity }}; --ftbcm-fcol-bg: {{ section.settings.fortified_column_color }}; --ftbcm-fcol-fg: {{ section.settings.fortified_column_text }}; --ftbcm-yes: {{ section.settings.yes_color }}; --ftbcm-no: {{ section.settings.no_color }}; --ftbcm-partial: {{ section.settings.partial_color }}; --ftbcm-cols: {{ competitors.size }};"
  {{ section.shopify_attributes }}
>
  <div class="ftbcm__inner">
    {%- if section.settings.eyebrow != blank or heading_html != blank or section.settings.body != blank -%}
      <div class="ftbcm__head">
        {%- if section.settings.eyebrow != blank -%}<p class="ftbcm__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if heading_html != blank -%}<h2 class="ftbcm__heading">{{ heading_html | newline_to_br }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<p class="ftbcm__body">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ftbcm__panel">
      <div class="ftbcm__wrap" data-ftbcm-wrap>
        <div class="ftbcm__scroll" data-ftbcm-scroll>
          <table class="ftbcm__table">
            <thead>
              <tr>
                <th scope="col" class="ftbcm__th ftbcm__th--label"></th>
                <th scope="col" class="ftbcm__th ftbcm__th--fortified">
                  {%- if section.settings.fortified_logo != blank -%}
                    {{ section.settings.fortified_logo | image_url: width: 200 | image_tag: class: 'ftbcm__logo', loading: 'lazy', widths: '100,200,300', alt: section.settings.fortified_label }}
                  {%- else -%}
                    <span>{{ section.settings.fortified_label }}</span>
                  {%- endif -%}
                </th>
                {%- for c in competitors -%}<th scope="col" class="ftbcm__th ftbcm__th--comp">{{ c.settings.name }}</th>{%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in feature_rows -%}
                {%- assign row_index = forloop.index0 -%}
                <tr class="ftbcm__row" {{ row.shopify_attributes }}>
                  <th scope="row" class="ftbcm__td ftbcm__td--label">{{ row.settings.label }}</th>
                  <td class="ftbcm__td ftbcm__td--fortified">
                    {%- case row.settings.fortified_icon -%}
                      {%- when 'yes' -%}
                        <span class="ftbcm__icon ftbcm__icon--yes" aria-label="Yes"><svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5"/></svg></span>
                      {%- when 'no' -%}
                        <span class="ftbcm__icon ftbcm__icon--no" aria-label="No"><svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3.5" y1="3.5" x2="12.5" y2="12.5"/><line x1="12.5" y1="3.5" x2="3.5" y2="12.5"/></svg></span>
                      {%- when 'partial' -%}
                        <span class="ftbcm__icon ftbcm__icon--partial" aria-label="Partial"><svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="8" x2="13" y2="8"/></svg></span>
                      {%- else -%}
                        <span class="ftbcm__val ftbcm__val--fortified">{{ row.settings.fortified_value }}</span>
                    {%- endcase -%}
                  </td>
                  {%- for c in competitors -%}
                    {%- assign lines = c.settings.values | strip | newline_to_br | split: '<br />' -%}
                    {%- assign raw = lines[row_index] | default: '' | strip -%}
                    {%- assign rawd = raw | downcase -%}
                    <td class="ftbcm__td ftbcm__td--comp">
                      {%- if rawd == 'yes' -%}
                        <span class="ftbcm__icon ftbcm__icon--yes" aria-label="Yes"><svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5"/></svg></span>
                      {%- elsif rawd == 'no' -%}
                        <span class="ftbcm__icon ftbcm__icon--no" aria-label="No"><svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3.5" y1="3.5" x2="12.5" y2="12.5"/><line x1="12.5" y1="3.5" x2="3.5" y2="12.5"/></svg></span>
                      {%- elsif rawd == 'partial' -%}
                        <span class="ftbcm__icon ftbcm__icon--partial" aria-label="Partial"><svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="8" x2="13" y2="8"/></svg></span>
                      {%- else -%}
                        <span class="ftbcm__val">{{ raw }}</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- if section.settings.mobile_swipe_hint != blank -%}<p class="ftbcm__hint" aria-hidden="true">{{ section.settings.mobile_swipe_hint }}</p>{%- endif -%}
      </div>
    </div>
  </div>
  <script>
    (function(){
      var wraps = document.querySelectorAll('[data-ftbcm-wrap]');
      wraps.forEach(function(wrap){
        var scroller = wrap.querySelector('[data-ftbcm-scroll]');
        if (!scroller) return;
        var onScroll = function(){
          if (scroller.scrollLeft > 8) {
            wrap.classList.add('is-scrolled');
            scroller.removeEventListener('scroll', onScroll);
          }
        };
        scroller.addEventListener('scroll', onScroll, { passive: true });
      });
    })();
  </script>
</section>

{% stylesheet %}
.ftbcm { display: block; }
.ftbcm__inner { max-width: var(--ftbcm-max-w, 1240px); margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); }
.ftbcm__head { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin: 0 0 clamp(24px, 4vw, 40px); max-width: 820px; }
.ftbcm__eyebrow { margin: 0; font-family: var(--font-heading--family, inherit); font-size: 13px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ftbcm-eyebrow, var(--color-foreground)); }
.ftbcm__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-size: clamp(28px, 4.4vw, 52px); font-weight: 800; line-height: 1.04; letter-spacing: -0.01em; text-transform: uppercase; color: var(--color-foreground); }
.ftbcm__em { color: var(--ftbcm-eyebrow, var(--color-foreground)); font-style: italic; }
.ftbcm__body { margin: 0; font-size: 16px; line-height: 1.6; color: var(--color-foreground); opacity: 0.78; max-width: 70ch; }
.ftbcm__panel { background: var(--ftbcm-panel-bg, #0A0A0A); color: var(--ftbcm-panel-fg, #FFFFFF); border-radius: 12px; overflow: hidden; padding: clamp(16px, 2vw, 24px); }
.ftbcm__wrap { position: relative; }
.ftbcm__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.ftbcm__scroll::-webkit-scrollbar { display: none; }
.ftbcm__table { width: 100%; border-collapse: collapse; color: var(--ftbcm-panel-fg, #FFFFFF); }
.ftbcm__th, .ftbcm__td { padding: 14px 14px; text-align: center; vertical-align: middle; border-bottom: 1px solid rgb(255 255 255 / 0.08); font-size: 14px; font-weight: 600; }
.ftbcm__row:last-child .ftbcm__td { border-bottom: none; }
.ftbcm__th { font-family: var(--font-heading--family, inherit); font-size: 13px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 18px 14px; background: rgb(255 255 255 / 0.04); }
.ftbcm__th--label { text-align: left; background: transparent; }
.ftbcm__td--label { text-align: left; font-family: var(--font-heading--family, inherit); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; background: transparent; }
.ftbcm__th--fortified, .ftbcm__td--fortified { background: var(--ftbcm-fcol-bg, #1FA8A1); color: var(--ftbcm-fcol-fg, #FFFFFF); border-bottom-color: rgb(255 255 255 / 0.18); }
.ftbcm__th--fortified { font-size: 14px; letter-spacing: 0.14em; }
.ftbcm__td--comp { opacity: 0.92; }
.ftbcm__val--fortified { font-weight: 800; color: var(--ftbcm-fcol-fg, #FFFFFF); }
.ftbcm__logo { max-height: 32px; width: auto; display: inline-block; object-fit: contain; }
.ftbcm__icon { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 999px; }
.ftbcm__icon--yes { color: var(--ftbcm-yes, #16A34A); }
.ftbcm__icon--no { color: var(--ftbcm-no, #E07070); }
.ftbcm__icon--partial { color: var(--ftbcm-partial, #D4A844); }
.ftbcm__td--fortified .ftbcm__icon--yes { color: var(--ftbcm-fcol-fg, #FFFFFF); }
.ftbcm__hint { margin: 10px 0 0; text-align: center; font-family: var(--font-heading--family, inherit); font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ftbcm-panel-fg, #FFFFFF); opacity: var(--ftbcm-muted-opacity, 0.4); transition: opacity 0.25s; display: none; }
.ftbcm__wrap.is-scrolled .ftbcm__hint { opacity: 0; }
@media (max-width: 749px) {
  .ftbcm__panel { padding: 12px; border-radius: 10px; }
  .ftbcm__table { min-width: 540px; }
  .ftbcm__th, .ftbcm__td { padding: 12px 10px; font-size: 12.5px; }
  .ftbcm__td--label, .ftbcm__th--label { position: sticky; left: 0; z-index: 2; background: var(--ftbcm-panel-bg, #0A0A0A); box-shadow: 6px 0 10px rgb(0 0 0 / 0.25); min-width: 130px; max-width: 130px; }
  .ftbcm__th--fortified, .ftbcm__td--fortified, .ftbcm__th--comp, .ftbcm__td--comp { min-width: 110px; }
  .ftbcm__hint { display: block; }
}
[hidden] { display: none !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "FTD-B - Comparison",
  "tag": "section",
  "class": "ftd-b-comparison-section",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How We Stack Up" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#1FA8A1" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The clean label difference." },
    { "type": "text", "id": "heading_emphasis_word", "label": "Emphasized word", "info": "First match in the heading is wrapped in an accent italic.", "default": "difference." },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "header", "content": "Panel" },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#0A0A0A" },
    { "type": "color", "id": "panel_text_color", "label": "Panel text color", "default": "#FFFFFF" },
    { "type": "range", "id": "panel_text_muted_opacity", "label": "Panel muted text opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40 },
    { "type": "header", "content": "Fortified column" },
    { "type": "text", "id": "fortified_label", "label": "Column label", "default": "Fortified" },
    { "type": "image_picker", "id": "fortified_logo", "label": "Column logo", "info": "Optional. Replaces the label text." },
    { "type": "color", "id": "fortified_column_color", "label": "Column background", "default": "#1FA8A1" },
    { "type": "color", "id": "fortified_column_text", "label": "Column text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Icon colors" },
    { "type": "color", "id": "yes_color", "label": "Yes color", "default": "#16A34A" },
    { "type": "color", "id": "no_color", "label": "No color", "default": "#E07070" },
    { "type": "color", "id": "partial_color", "label": "Partial color", "default": "#D4A844" },
    { "type": "header", "content": "Mobile" },
    { "type": "text", "id": "mobile_swipe_hint", "label": "Swipe hint", "default": "Swipe to compare" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "page-width", "options": [ { "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" } ] },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 600, "max": 1800, "step": 20, "unit": "px", "default": 1240 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 72 },
    { "type": "header", "content": "Advanced" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "info": "Targets this section." }
  ],
  "blocks": [
    {
      "type": "feature_row",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature label", "default": "Proprietary Blends" },
        { "type": "text", "id": "fortified_value", "label": "Fortified value", "default": "None" },
        { "type": "select", "id": "fortified_icon", "label": "Fortified cell as", "default": "text", "options": [ { "value": "text", "label": "Text value" }, { "value": "yes", "label": "Yes icon" }, { "value": "no", "label": "No icon" }, { "value": "partial", "label": "Partial icon" } ] }
      ]
    },
    {
      "type": "competitor",
      "name": "Competitor",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Competitor A" },
        { "type": "textarea", "id": "values", "label": "Values", "info": "One line per feature row, in order. Use yes / no / partial for icons, anything else renders as text.", "default": "no\nno\nno\nno\nno" }
      ]
    }
  ],
  "max_blocks": 22,
  "presets": [
    {
      "name": "FTD-B - Comparison",
      "category": "Fortified Sections",
      "blocks": [
        { "type": "feature_row", "settings": { "label": "Proprietary Blends", "fortified_value": "None", "fortified_icon": "text" } },
        { "type": "feature_row", "settings": { "label": "Artificial Sweeteners", "fortified_value": "None", "fortified_icon": "text" } },
        { "type": "feature_row", "settings": { "label": "Artificial Dyes", "fortified_icon": "no" } },
        { "type": "feature_row", "settings": { "label": "Natural Caffeine", "fortified_icon": "yes" } },
        { "type": "feature_row", "settings": { "label": "Full Disclosure Label", "fortified_icon": "yes" } },
        { "type": "competitor", "settings": { "name": "Competitor A", "values": "yes\nSucralose\nyes\nno\nno" } },
        { "type": "competitor", "settings": { "name": "Competitor B", "values": "yes\npartial\nyes\nno\npartial" } }
      ]
    }
  ]
}
{% endschema %}
