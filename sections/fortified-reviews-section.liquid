{% render 'fortified-base' %}

<section
  id="FortifiedReviewsSection-{{ section.id }}"
  class="fortified-reviews-section color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 100 }}px {{ section.settings['padding-block-end'] | default: 100 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 0 }}px {{ section.settings['padding-inline-end'] | default: 0 }}px;"
>
  <div class="fortified-reviews-section__inner">
    <header class="fortified-reviews-section__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-reviews-section__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-reviews-section__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>

    <div class="fortified-reviews-section__scroll">
      <div class="fortified-reviews-section__row">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-review-card' %}
            <article class="fortified-reviews-section__card" {{ block.shopify_attributes }}>
              <div class="fortified-reviews-section__card-top">
                <div class="fortified-reviews-section__stars" aria-label="5 out of 5 stars">
                  {% for s in (1..5) %}
                    <svg class="fortified-reviews-section__star" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.95 6.97L22 9.74l-5.27 4.84L18.18 22 12 18.27 5.82 22l1.45-7.42L2 9.74l7.05-.77z"/></svg>
                  {% endfor %}
                </div>
                {% if block.settings.title != blank %}
                  <h3 class="fortified-reviews-section__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.body != blank %}
                  <p class="fortified-reviews-section__body">{{ block.settings.body }}</p>
                {% endif %}
              </div>
              <div class="fortified-reviews-section__author">
                <div class="fortified-reviews-section__avatar">
                  {% if block.settings.avatar != blank %}
                    {{ block.settings.avatar | image_url: width: 116 | image_tag:
                        widths: '58, 116',
                        sizes: '58px',
                        alt: block.settings.author_name,
                        loading: 'lazy' }}
                  {% endif %}
                </div>
                <div class="fortified-reviews-section__author-text">
                  <p class="fortified-reviews-section__author-name">{{ block.settings.author_name }}</p>
                  <p class="fortified-reviews-section__author-meta">{{ block.settings.author_meta | default: 'Verified Buyer' }}</p>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-reviews-section {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-reviews-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    width: 100%;
  }
  .fortified-reviews-section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    max-width: 760px;
    text-align: center;
    padding-inline: 40px;
  }
  .fortified-reviews-section__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-reviews-section__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }

  .fortified-reviews-section__scroll {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-inline: 40px;
  }
  .fortified-reviews-section__scroll::-webkit-scrollbar { display: none; }
  .fortified-reviews-section__row {
    display: flex;
    gap: 28px;
    width: max-content;
    margin-inline: auto;
  }
  .fortified-reviews-section__card {
    flex: 0 0 350px;
    width: 350px;
    min-height: 335px;
    border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: 14px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    color: var(--color-foreground);
  }
  .fortified-reviews-section__card-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .fortified-reviews-section__stars {
    display: flex;
    gap: 4px;
    color: var(--fortified-accent);
  }
  .fortified-reviews-section__star {
    width: 24px;
    height: 24px;
  }
  .fortified-reviews-section__title {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-reviews-section__body {
    font-family: var(--font-fortified-body);
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .fortified-reviews-section__author {
    display: flex;
    gap: 21px;
    align-items: center;
  }
  .fortified-reviews-section__avatar {
    flex: 0 0 58px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
  .fortified-reviews-section__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fortified-reviews-section__author-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fortified-reviews-section__author-name {
    font-family: var(--font-fortified-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-reviews-section__author-meta {
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    margin: 0;
  }

  @media (max-width: 990px) {
    .fortified-reviews-section__inner { gap: 48px; }
    .fortified-reviews-section__heading { font-size: 44px; }
  }
  @media (max-width: 749px) {
    .fortified-reviews-section__heading { font-size: 32px; }
    .fortified-reviews-section__card { flex: 0 0 280px; width: 280px; padding: 24px; }
    .fortified-reviews-section__title { font-size: 22px; }
    .fortified-reviews-section__body { font-size: 16px; }
    .fortified-reviews-section__scroll { padding-inline: 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP-03 — Reviews",
  "tag": "section",
  "class": "fortified-reviews-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "12,400+ customer reviews"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow and stars. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "blocks": [
    {
      "type": "fortified-review-card",
      "name": "Review card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Game changer!"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "I feel the difference in my workouts and recovery. No more cramps."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Sarah J."
        },
        {
          "type": "text",
          "id": "author_meta",
          "label": "Author meta",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP-03 — Reviews",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        { "type": "fortified-review-card" },
        { "type": "fortified-review-card" },
        { "type": "fortified-review-card" },
        { "type": "fortified-review-card" }
      ]
    },
    {
      "name": "Reviews",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": [
        { "type": "fortified-review-card" },
        { "type": "fortified-review-card" },
        { "type": "fortified-review-card" }
      ]
    }
  ]
}
{% endschema %}
