{% render 'fortified-base' %}

<section
  id="FortifiedReviewsSection-{{ section.id }}"
  class="fortified-reviews-section color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-reviews-section__inner">
    <header class="fortified-reviews-section__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>
    <div class="fortified-reviews-section__widget">
      {% render 'judgeme_widgets', widget_type: 'judgeme_carousel_widget', concierge_install: true %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-reviews-section {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-reviews-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 3vw, 36px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  .fortified-reviews-section__header {
    text-align: center;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .fortified-reviews-section__header .fortified-heading {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .fortified-reviews-section__widget {
    width: 100%;
  }
  /* Style the Judge.me carousel widget when present */
  .fortified-reviews-section .jdgm-carousel-wrapper,
  .fortified-reviews-section .jdgm-rev-widg {
    background: transparent !important;
    color: var(--color-foreground) !important;
  }
  .fortified-reviews-section .jdgm-rev {
    background: color-mix(in srgb, var(--color-foreground) 3%, transparent) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 16px !important;
    padding: 20px !important;
  }
  .fortified-reviews-section .jdgm-rev__author,
  .fortified-reviews-section .jdgm-rev__title,
  .fortified-reviews-section .jdgm-rev__body {
    color: var(--color-foreground) !important;
  }
  .fortified-reviews-section .jdgm-star {
    color: var(--fortified-accent, var(--color-foreground)) !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "12 \u2014 Customer Reviews",
  "tag": "section",
  "class": "fortified-reviews-section-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "12,400+ CUSTOMER REVIEWS"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for accent bars, CTA backgrounds, checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "presets": [
    {
      "name": "12 \u2014 Customer Reviews",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "12 \u2014 Customer Reviews",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
