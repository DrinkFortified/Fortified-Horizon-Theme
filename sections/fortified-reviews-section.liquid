{% render 'fortified-base' %}

<section
  id="FortifiedReviewsSection-{{ section.id }}"
  class="fortified-reviews-section color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 64 }}px {{ section.settings["padding-block-end"] | default: 64 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-reviews-section__inner">
    <header class="fortified-reviews-section__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>
    <div class="fortified-reviews-section__widget">
      {% render 'judgeme_widgets', widget_type: 'judgeme_carousel_widget', concierge_install: true %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-reviews-section {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-reviews-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .fortified-reviews-section__header { text-align: center; max-width: 760px; }
  .fortified-reviews-section__widget { width: 100%; }
{% endstylesheet %}

{% schema %}
{
  "name": "12 \u2014 Customer Reviews",
  "tag": "section",
  "class": "fortified-reviews-section-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "12,400+ CUSTOMER REVIEWS"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "12 \u2014 Customer Reviews",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "12 \u2014 Customer Reviews",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
