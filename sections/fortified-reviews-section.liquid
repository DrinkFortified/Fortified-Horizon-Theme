{% render 'fortified-base' %}

<section
  id="FortifiedReviewsSection-{{ section.id }}"
  class="fortified-reviews-section color-{{ section.settings.color_scheme }}"
>
  <div class="fortified-container fortified-reviews-section__inner">
    <header class="fortified-reviews-section__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>
    <div class="fortified-reviews-section__widget">
      {% render 'judgeme_widgets', widget_type: 'judgeme_carousel_widget', concierge_install: true %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-reviews-section {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-reviews-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .fortified-reviews-section__header { text-align: center; max-width: 760px; }
  .fortified-reviews-section__widget { width: 100%; }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Reviews Carousel",
  "tag": "section",
  "class": "fortified-reviews-section-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE TRUTH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "12,400+ CUSTOMER REVIEWS" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified Reviews Carousel", "category": "Fortified" }
  ]
}
{% endschema %}
