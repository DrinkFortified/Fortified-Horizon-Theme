{% comment %}
  Section: FTD - Stats Comparison
  Category: Fortified Sections
  ----------------------------------------------------------------------
  One self-contained section that renders ALL the comparison cards itself
  (no Horizon group, no separate blocks to misalign). Cards are classic
  section blocks rendered directly into a CSS grid, so every card is the
  SAME width and height automatically. On mobile the grid becomes a
  horizontal snap-scroller.

  Each "Card" block is either a bar-chart card (big number + two bars) or a
  checklist card (big number + checkmark list). All cards share the same
  border / radius / padding / background from the section settings, so they
  always look identical.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'ftsc-' | append: sid
  assign cols = section.settings.columns | default: 3
-%}

<style>
  #{{ root }} { padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px; }
  #{{ root }} .{{ root }}__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #{{ root }} .{{ root }}__head { text-align: center; margin: 0 auto 40px; max-width: 760px; display: flex; flex-direction: column; gap: 10px; }
  #{{ root }} .{{ root }}__eyebrow { margin: 0; font-family: var(--font-heading--family, inherit); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: {{ section.settings.accent_color }}; }
  #{{ root }} .{{ root }}__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-size: clamp(30px, 4.5vw, 52px); font-weight: 800; line-height: 1.05; text-transform: uppercase; color: {{ section.settings.heading_color }}; }
  #{{ root }} .{{ root }}__sub { margin: 0; font-size: 16px; line-height: 1.5; color: {{ section.settings.subtitle_color }}; }

  /* ── The grid: equal columns + equal-height rows ── */
  #{{ root }} .{{ root }}__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    align-items: stretch;
    gap: {{ section.settings.card_gap }}px;
  }

  /* ── Card shell (shared look so all cards are identical) ── */
  #{{ root }} .ftsc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    background: {{ section.settings.card_bg }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    text-align: {{ section.settings.text_alignment }};
  }
  #{{ root }} .ftsc-card__num { margin: 0; font-family: var(--font-heading--family, inherit); font-size: {{ section.settings.number_size }}px; font-weight: 800; line-height: 1; letter-spacing: -0.02em; color: {{ section.settings.number_color }}; }
  #{{ root }} .ftsc-card__headline { margin: 6px 0 0; font-family: var(--font-heading--family, inherit); font-size: {{ section.settings.headline_size }}px; font-weight: 700; line-height: 1.15; color: {{ section.settings.heading_color }}; }
  #{{ root }} .ftsc-card__sub { margin: 4px 0 0; font-size: {{ section.settings.subtitle_size }}px; line-height: 1.4; color: {{ section.settings.subtitle_color }}; }

  /* body grows so footnotes line up at the bottom across all cards */
  #{{ root }} .ftsc-card__body { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: flex-end; margin-top: 22px; }
  #{{ root }} .ftsc-card__foot { margin: 18px 0 0; font-size: {{ section.settings.footnote_size }}px; font-style: italic; line-height: 1.4; color: {{ section.settings.footnote_color }}; }

  /* ── Bars ── */
  #{{ root }} .ftsc-chart { position: relative; height: {{ section.settings.chart_height }}px; padding-left: {% if section.settings.show_yaxis %}38{% else %}0{% endif %}px; }
  #{{ root }} .ftsc-y { position: absolute; left: 0; transform: translateY(-50%); color: {{ section.settings.scale_color }}; font-size: 12px; line-height: 1; }
  #{{ root }} .ftsc-y--100 { top: 0; } #{{ root }} .ftsc-y--50 { top: 50%; } #{{ root }} .ftsc-y--0 { top: calc(100% - 1px); }
  #{{ root }} .ftsc-grid-line { position: absolute; left: {% if section.settings.show_yaxis %}38{% else %}0{% endif %}px; right: 0; height: 0; border-top: 1px dashed {{ section.settings.grid_color }}; }
  #{{ root }} .ftsc-grid-line--100 { top: 0; } #{{ root }} .ftsc-grid-line--50 { top: 50%; } #{{ root }} .ftsc-grid-line--0 { top: calc(100% - 1px); }
  #{{ root }} .ftsc-bars { position: absolute; left: {% if section.settings.show_yaxis %}38{% else %}0{% endif %}px; right: 0; top: 0; bottom: 0; display: flex; align-items: flex-end; justify-content: center; gap: {{ section.settings.bar_gap }}px; }
  #{{ root }} .ftsc-bar { width: {{ section.settings.bar_width }}px; max-width: 38%; border-radius: {{ section.settings.bar_radius }}px {{ section.settings.bar_radius }}px 0 0; }
  #{{ root }} .ftsc-lbls { display: flex; justify-content: center; gap: {{ section.settings.bar_gap }}px; padding-left: {% if section.settings.show_yaxis %}38{% else %}0{% endif %}px; margin-top: 14px; }
  #{{ root }} .ftsc-lbl { width: {{ section.settings.bar_width }}px; max-width: 38%; text-align: center; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; color: {{ section.settings.heading_color }}; }

  /* ── Checklist ── */
  #{{ root }} .ftsc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; text-align: left; }
  #{{ root }} .ftsc-list li { display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 600; color: {{ section.settings.heading_color }}; }
  #{{ root }} .ftsc-list svg { width: 22px; height: 22px; flex-shrink: 0; color: {{ section.settings.accent_color }}; }

  /* ── Footer button ── */
  #{{ root }} .{{ root }}__footer { display: flex; justify-content: center; margin-top: 40px; }
  #{{ root }} .{{ root }}__cta { display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-heading--family, inherit); font-size: 16px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none; padding: 16px 40px; border-radius: 8px; cursor: pointer; border: 2px solid {{ section.settings.button_bg }}; background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }}; transition: filter 0.18s; }
  #{{ root }} .{{ root }}__cta:hover { filter: brightness(1.1); }

  /* ── Mobile: scroll sideways instead of stacking ── */
  @media (max-width: 749px) {
    {% if section.settings.mobile_scroll %}
    #{{ root }} .{{ root }}__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding-inline: 16px;
      padding-bottom: 6px;
    }
    #{{ root }} .ftsc-card { scroll-snap-align: start; }
    {% else %}
    #{{ root }} .{{ root }}__grid { grid-template-columns: 1fr; }
    {% endif %}
  }
</style>

<section id="{{ root }}" class="color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="{{ root }}__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="{{ root }}__head">
        {%- if section.settings.eyebrow != blank -%}<h4 class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</h4>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="{{ root }}__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="{{ root }}__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="{{ root }}__grid">
      {%- for block in section.blocks -%}
        <div class="ftsc-card" {{ block.shopify_attributes }}>
          {%- if block.settings.number != blank -%}<p class="ftsc-card__num">{{ block.settings.number }}</p>{%- endif -%}
          {%- if block.settings.headline != blank -%}<p class="ftsc-card__headline">{{ block.settings.headline }}</p>{%- endif -%}
          {%- if block.settings.subtitle != blank -%}<p class="ftsc-card__sub">{{ block.settings.subtitle }}</p>{%- endif -%}

          <div class="ftsc-card__body">
            {%- if block.settings.card_type == 'checklist' -%}
              {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
              <ul class="ftsc-list">
                {%- for item in items -%}
                  {%- assign it = item | strip -%}
                  {%- if it != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/><path d="M7 12.5L10.5 16L17 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span>{{ it }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- else -%}
              <div class="ftsc-chart" role="img" aria-label="{{ block.settings.bar1_label }} {{ block.settings.bar1_value }}, {{ block.settings.bar2_label }} {{ block.settings.bar2_value }}">
                {%- if section.settings.show_yaxis -%}
                  <span class="ftsc-y ftsc-y--100" aria-hidden="true">100</span>
                  <span class="ftsc-y ftsc-y--50" aria-hidden="true">50</span>
                  <span class="ftsc-y ftsc-y--0" aria-hidden="true">0</span>
                {%- endif -%}
                <div class="ftsc-grid-line ftsc-grid-line--100" aria-hidden="true"></div>
                <div class="ftsc-grid-line ftsc-grid-line--50" aria-hidden="true"></div>
                <div class="ftsc-grid-line ftsc-grid-line--0" aria-hidden="true"></div>
                <div class="ftsc-bars" aria-hidden="true">
                  <div class="ftsc-bar" style="height: {{ block.settings.bar1_value }}%; background: {{ block.settings.bar1_color }};"></div>
                  <div class="ftsc-bar" style="height: {{ block.settings.bar2_value }}%; background: {{ block.settings.bar2_color }};"></div>
                </div>
              </div>
              <div class="ftsc-lbls" aria-hidden="true">
                <p class="ftsc-lbl">{{ block.settings.bar1_label }}</p>
                <p class="ftsc-lbl">{{ block.settings.bar2_label }}</p>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.footnote != blank -%}<p class="ftsc-card__foot">{{ block.settings.footnote }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="{{ root }}__footer">
        <a class="{{ root }}__cta" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}>{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "FTD - Stats Comparison",
  "tag": "section",
  "class": "ftd-stats-comparison-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (H4)", "default": "The Truth" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "Why We Beat The Rest" },
    { "type": "textarea", "id": "subheading", "label": "Description", "default": "Electrolytes don't provide full recovery." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Scroll cards sideways on mobile", "default": true },
    { "type": "select", "id": "text_alignment", "label": "Card text alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },

    { "type": "header", "content": "Typography sizes" },
    { "type": "range", "id": "number_size", "label": "Number size", "min": 28, "max": 100, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "headline_size", "label": "Headline size", "min": 14, "max": 40, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "footnote_size", "label": "Footnote size", "min": 10, "max": 16, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Card style" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#E5E7EB" },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "color", "id": "number_color", "label": "Number color", "default": "#0A0A0A" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle / footnote color", "default": "#888888" },

    { "type": "header", "content": "Bars" },
    { "type": "checkbox", "id": "show_yaxis", "label": "Show Y-axis labels (0 / 50 / 100)", "default": true },
    { "type": "range", "id": "chart_height", "label": "Chart height", "min": 120, "max": 360, "step": 10, "unit": "px", "default": 200 },
    { "type": "range", "id": "bar_width", "label": "Bar width", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "bar_gap", "label": "Bar spacing", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "bar_radius", "label": "Bar corner radius", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 4 },
    { "type": "color", "id": "grid_color", "label": "Grid line color", "default": "#D9DEE3" },
    { "type": "color", "id": "scale_color", "label": "Scale label color", "default": "#888888" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow + checks)", "default": "#1FA8A1" },
    { "type": "color", "id": "heading_color", "label": "Heading / text", "default": "#0A0A0A" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore All Flavors" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#0A0A0A" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },

    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "card_type", "label": "Card type", "default": "bars",
          "options": [ { "value": "bars", "label": "Bar chart" }, { "value": "checklist", "label": "Checklist" } ] },
        { "type": "text", "id": "number", "label": "Big number", "default": "2.3x" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Better Hydration" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "vs. water alone *" },
        { "type": "text", "id": "footnote", "label": "Footnote", "default": "* Study: Journal of Strength & Conditioning Research" },
        { "type": "header", "content": "Bar chart (when type = Bar chart)" },
        { "type": "text", "id": "bar1_label", "label": "Bar 1 label", "default": "Water" },
        { "type": "range", "id": "bar1_value", "label": "Bar 1 value", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 38 },
        { "type": "color", "id": "bar1_color", "label": "Bar 1 color", "default": "#7B8794" },
        { "type": "text", "id": "bar2_label", "label": "Bar 2 label", "default": "Fortified" },
        { "type": "range", "id": "bar2_value", "label": "Bar 2 value", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 93 },
        { "type": "color", "id": "bar2_color", "label": "Bar 2 color", "default": "#1FA8A1" },
        { "type": "header", "content": "Checklist (when type = Checklist)" },
        { "type": "textarea", "id": "items", "label": "Checklist items", "info": "One per line.", "default": "Improve Hydration\nBoost Energy Naturally\nSupport Muscle Function" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FTD - Stats Comparison",
      "category": "Fortified Sections",
      "blocks": [
        { "type": "card", "settings": { "card_type": "bars", "number": "2.3x", "headline": "Better Hydration", "subtitle": "vs. water alone *", "bar1_label": "Water", "bar1_value": 38, "bar2_label": "Fortified", "bar2_value": 93, "footnote": "* Study: Journal of Strength & Conditioning Research" } },
        { "type": "card", "settings": { "card_type": "bars", "number": "+24%", "headline": "Improved Endurance", "subtitle": "in high intensity workouts *", "bar1_label": "Water", "bar1_value": 50, "bar2_label": "Fortified", "bar2_value": 88, "footnote": "* Study: Journal of Strength & Conditioning Research" } },
        { "type": "card", "settings": { "card_type": "checklist", "number": "0%", "headline": "No Sugar. No Crash.", "subtitle": "in high intensity workouts *", "items": "Improve Hydration\nBoost Energy Naturally\nSupport Muscle Function", "footnote": "* Based on internal product testing" } }
      ]
    }
  ]
}
{% endschema %}
