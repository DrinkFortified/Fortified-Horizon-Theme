{% render 'fortified-base' %}

<section
  id="PdpBenefits-{{ section.id }}"
  class="pdp-benefits color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="pdp-benefits__layout">
    {% if section.settings.feature_image != blank %}
      <div class="pdp-benefits__media">
        <img src="{{ section.settings.feature_image | image_url: width: 1200 }}" alt="{{ section.settings.feature_image_alt }}" loading="lazy">
      </div>
    {% endif %}

    <div class="pdp-benefits__content">
      <header class="pdp-benefits__head">
        <h2 class="pdp-benefits__title">
          <span class="p-energy">{% render 'fortified-accent-text', text: section.settings.energy_title %}</span>
          <span class="p-everyday">{% render 'fortified-accent-text', text: section.settings.everyday_title %}</span>
        </h2>
        <p class="pdp-benefits__desc">
          <span class="p-energy">{% render 'fortified-accent-text', text: section.settings.energy_desc %}</span>
          <span class="p-everyday">{% render 'fortified-accent-text', text: section.settings.everyday_desc %}</span>
        </p>
      </header>

      <div class="pdp-benefits__grid">
        {% for block in section.blocks %}
          {% if block.type == 'benefit_energy' %}
            <article class="pdp-benefit p-energy" {{ block.shopify_attributes }}>
              <div class="pdp-benefit__icon">
                {% if block.settings.icon_image != blank %}
                  <img src="{{ block.settings.icon_image | image_url: width: 164 }}" alt="" width="82" height="82" loading="lazy">
                {% else %}
                  <span class="pdp-benefit__icon-text">{{ block.settings.icon }}</span>
                {% endif %}
              </div>
              <div class="pdp-benefit__text">
                <h3 class="pdp-benefit__title">{% render 'fortified-accent-text', text: block.settings.title %}</h3>
                <p class="pdp-benefit__body">{% render 'fortified-accent-text', text: block.settings.body %}</p>
              </div>
            </article>
          {% elsif block.type == 'benefit_everyday' %}
            <article class="pdp-benefit p-everyday" {{ block.shopify_attributes }}>
              <div class="pdp-benefit__icon">
                {% if block.settings.icon_image != blank %}
                  <img src="{{ block.settings.icon_image | image_url: width: 164 }}" alt="" width="82" height="82" loading="lazy">
                {% else %}
                  <span class="pdp-benefit__icon-text">{{ block.settings.icon }}</span>
                {% endif %}
              </div>
              <div class="pdp-benefit__text">
                <h3 class="pdp-benefit__title">{% render 'fortified-accent-text', text: block.settings.title %}</h3>
                <p class="pdp-benefit__body">{% render 'fortified-accent-text', text: block.settings.body %}</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.cta_label != blank %}
        <a class="pdp-benefits__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-benefits {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
  }
  .pdp-benefits__layout {
    display: flex;
    align-items: center;
    gap: 52px;
  }
  .pdp-benefits__media {
    flex: 1;
    min-width: 0;
    height: 700px;
    overflow: hidden;
  }
  .pdp-benefits__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .pdp-benefits__content {
    flex: 0 0 auto;
    width: 678px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 62px;
  }
  .pdp-benefits__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pdp-benefits__title {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 62px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }
  .pdp-benefits__desc {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .pdp-benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 42px 32px;
    width: 669px;
    max-width: 100%;
  }
  .pdp-benefit {
    display: flex;
    align-items: center;
    gap: 18px;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .pdp-benefit__icon {
    flex-shrink: 0;
    width: 82px; height: 82px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pdp-benefit__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .pdp-benefit__icon-text { font-size: 36px; line-height: 1; }
  .pdp-benefit__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .pdp-benefit__title {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }
  .pdp-benefit__body {
    font-family: var(--font-fortified-body);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    margin: 0;
  }
  .pdp-benefits__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 350px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
  }
  body[data-product="energy"] .p-everyday { display: none; }
  body[data-product="everyday"] .p-energy { display: none; }
  @media (max-width: 1200px) {
    .pdp-benefits__layout { flex-direction: column; align-items: stretch; }
    .pdp-benefits__media { width: 100%; height: 420px; }
    .pdp-benefits__content { width: 100%; gap: 42px; }
    .pdp-benefits__grid { width: 100%; }
  }
  @media (max-width: 700px) {
    .pdp-benefits__title { font-size: 42px; }
    .pdp-benefits__grid { grid-template-columns: 1fr; gap: 24px; }
  }
{% endstylesheet %}

