{% comment %}
  Section: FTD - Stats Row
  Category: Fortified Sections
  --------------------------------------------------------------------
  Row of stat blocks. Each stat has a big number, a configurable
  divider (dashed/dotted/solid/none), a small label, and a description.
  Desktop = N columns; mobile (<=749px) = stacked single column.
{% endcomment %}

{%- liquid
  assign cols = section.settings.desktop_columns
  assign align = section.settings.align

  if section.settings.section_width == 'full-width'
    assign frs_max_w = '100%'
  else
    assign frs_max_w = section.settings.content_max_width | append: 'px'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="frs section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --frs-max-w: {{ frs_max_w }};
    --frs-cols: {{ cols }};
    --frs-col-gap: {{ section.settings.column_gap }}px;
    --frs-divider-style: {{ section.settings.divider_style }};
    --frs-divider-color: {{ section.settings.divider_color }};
    --frs-divider-thickness: {{ section.settings.divider_thickness }}px;
    --frs-align: {% if align == 'center' %}center{% else %}left{% endif %};
  "
  {{ section.shopify_attributes }}
>
  <div class="frs__inner">

    {%- liquid
      assign pdp = product.metafields.fortified.pdp_content.value
      assign eyebrow_v = section.settings.eyebrow
      assign heading_v = section.settings.heading
      assign subheading_v = section.settings.subheading
      assign use_pdp_stats = false
      if pdp != blank
        if pdp.stat_1_number != blank
          assign use_pdp_stats = true
        endif
      endif
    -%}
    {%- if eyebrow_v != blank or heading_v != blank or subheading_v != blank -%}
      <div class="frs__head">
        {%- if eyebrow_v != blank -%}
          <p class="frs__eyebrow">{{ eyebrow_v }}</p>
        {%- endif -%}
        {%- if heading_v != blank -%}
          <h2 class="frs__heading">{{ heading_v }}</h2>
        {%- endif -%}
        {%- if subheading_v != blank -%}
          <p class="frs__sub">{{ subheading_v }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <dl class="frs__grid">
        {%- if use_pdp_stats -%}
          {%- for i in (1..3) -%}
            {%- assign nkey = 'stat_' | append: i | append: '_number' -%}
            {%- assign lkey = 'stat_' | append: i | append: '_label' -%}
            {%- assign dkey = 'stat_' | append: i | append: '_description' -%}
            {%- assign num = pdp[nkey] -%}
            {%- assign lab = pdp[lkey] -%}
            {%- assign desc = pdp[dkey] -%}
            {%- if num != blank or lab != blank -%}
              <div class="frs__stat">
                <dt class="frs__stat-number">{{ num }}</dt>
                <div class="frs__stat-text">
                  {%- if lab != blank -%}<dd class="frs__stat-label">{{ lab }}</dd>{%- endif -%}
                  {%- if desc != blank -%}<dd class="frs__stat-desc">{{ desc }}</dd>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            {%- assign num_color = block.settings.number_color | default: 'var(--color-foreground)' -%}

            {%- capture stat_inner -%}
              <dt class="frs__stat-number" style="color: {{ num_color }};">{{ block.settings.number }}</dt>
              {%- if section.settings.divider_style != 'none' -%}
                <hr class="frs__stat-divider" aria-hidden="true">
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <dd class="frs__stat-label">{{ block.settings.label }}</dd>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <dd class="frs__stat-desc">{{ block.settings.description }}</dd>
              {%- endif -%}
            {%- endcapture -%}

            {%- if block.settings.link != blank -%}
              <a class="frs__stat frs__stat--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                {{ stat_inner }}
              </a>
            {%- else -%}
              <div class="frs__stat" {{ block.shopify_attributes }}>
                {{ stat_inner }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- endif -%}
      </dl>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.frs {
  display: block;
}

.frs__inner {
  max-width: var(--frs-max-w, 1240px);
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 40px);
  text-align: var(--frs-align, left);
}

/* Header */
.frs__head {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0 0 clamp(24px, 4vw, 40px);
  align-items: flex-start;
}

.frs[style*="--frs-align: center"] .frs__head,
.frs__inner[style*="--frs-align: center"] .frs__head {
  align-items: center;
}

.frs__eyebrow {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: var(--ftd-eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--ftd-eyebrow-spacing);
  text-transform: uppercase;
  color: var(--color-foreground);
  opacity: 0.85;
}

.frs__heading {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: var(--ftd-h2-size);
  font-weight: var(--ftd-heading-weight, 800);
  line-height: var(--ftd-h2-line, 1.1);
  color: var(--color-foreground);
}

.frs__sub {
  margin: 0;
  font-size: var(--ftd-sub-size);
  line-height: var(--ftd-sub-line, 1.6);
  color: var(--color-foreground);
  opacity: 0.78;
  max-width: 48rem;
}

/* Grid */
.frs__grid {
  display: grid;
  grid-template-columns: repeat(var(--frs-cols, 3), minmax(0, 1fr));
  gap: var(--frs-col-gap, 40px);
  margin: 0;
  padding: 0;
  list-style: none;
}

/* Stat */
.frs__stat {
  display: flex;
  flex-direction: column;
  align-items: var(--frs-align, flex-start);
  text-align: var(--frs-align, left);
  gap: clamp(12px, 1.6vw, 18px);
  text-decoration: none;
  color: inherit;
}

.frs__stat--link {
  transition: opacity 0.18s ease;
}

.frs__stat--link:hover {
  opacity: 0.82;
}

.frs__stat-number {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: clamp(40px, 6vw, 72px);
  font-weight: 800;
  line-height: 1;
  color: var(--color-foreground);
}

.frs__stat-divider {
  width: 100%;
  height: 0;
  margin: 0;
  border: 0;
  border-top: var(--frs-divider-thickness, 1px) var(--frs-divider-style, dashed) var(--frs-divider-color, #9CA3AF);
}

.frs__stat-label {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: var(--ftd-small-size);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-foreground);
}

.frs__stat-desc {
  margin: 0;
  font-size: var(--ftd-body-size);
  line-height: 1.55;
  color: var(--color-foreground);
  opacity: 0.75;
}

@media (max-width: 749px) {
  .frs__grid {
    grid-template-columns: 1fr;
    gap: clamp(28px, 6vw, 40px);
  }

  .frs__stat {
    align-items: flex-start;
    text-align: left;
  }

  .frs__stat-number {
    font-size: clamp(40px, 11vw, 64px);
  }
}

[hidden] { display: none !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "FTD - Stats Row",
  "tag": "section",
  "class": "frs-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "default": "dashed",
      "options": [
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#9CA3AF"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Divider thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "page-width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:content.advanced"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Targets this section."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "Over 18"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years of research"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "In collaboration with the Swiss Federal Institute of Technology de Lausanne (EPFL)"
        },
        {
          "type": "color",
          "id": "number_color",
          "label": "Number color",
          "info": "Optional. Falls back to the scheme foreground color."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Wraps the whole stat in an anchor."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "FTD - Stats Row",
      "category": "Fortified",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "Over 18",
            "label": "Years of research",
            "description": "In collaboration with the Swiss Federal Institute of Technology de Lausanne (EPFL)"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "500+",
            "label": "Studies referenced",
            "description": "Peer-reviewed studies guiding every formulation decision we make."
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "95.6%",
            "label": "Bioavailability",
            "description": "Mineral absorption rate validated by independent third-party testing."
          }
        }
      ]
    }
  ]
}
{% endschema %}
