{% render 'fortified-base' %}

<section
  id="FortifiedSubscribe-{{ section.id }}"
  class="fortified-subscribe color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-subscribe__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-subscribe__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
    {% endif %}
    <ul class="fortified-checklist fortified-subscribe__list">
      {% for i in (1..4) %}
        {%- assign key = 'benefit_' | append: i -%}
        {%- assign val = section.settings[key] -%}
        {% if val != blank %}<li>{{ val }}</li>{% endif %}
      {% endfor %}
    </ul>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-subscribe {
    position: relative;
    background: var(--color-background, #0A0A0A);
    color: var(--color-foreground, #fff);
    padding-block: var(--fortified-section-py);
    isolation: isolate;
    overflow: hidden;
  }
  .fortified-subscribe__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: .35;
  }
  .fortified-subscribe::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / .6), rgb(0 0 0 / .8));
    z-index: -1;
  }
  .fortified-subscribe__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 720px;
  }
  .fortified-subscribe__list {
    margin: 8px 0 16px;
    text-align: left;
  }
  .fortified-subscribe__list li { color: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "10 \u2014 Subscribe & Save",
  "tag": "section",
  "class": "fortified-subscribe-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUBSCRIBE & SAVE 15%"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Improve Hydration"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Boost Energy Naturally"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Support Muscle Function"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SUBSCRIBE NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "10 \u2014 Subscribe & Save",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    },
    {
      "name": "10 \u2014 Subscribe & Save",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "10 \u2014 Subscribe & Save",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
