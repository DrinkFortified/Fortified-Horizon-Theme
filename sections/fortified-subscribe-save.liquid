    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full-width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
