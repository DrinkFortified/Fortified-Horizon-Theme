{% render 'fortified-base' %}

<section
  id="FortifiedSubscribe-{{ section.id }}"
  class="fortified-subscribe color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-subscribe__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-subscribe__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
    {% endif %}
    <ul class="fortified-checklist fortified-subscribe__list">
      {% for i in (1..4) %}
        {%- assign key = 'benefit_' | append: i -%}
        {%- assign val = section.settings[key] -%}
        {% if val != blank %}<li>{{ val }}</li>{% endif %}
      {% endfor %}
    </ul>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-subscribe {
    position: relative;
    isolation: isolate;
    background: var(--color-background);
    color: var(--color-foreground);
    overflow: hidden;
  }
  .fortified-subscribe__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .fortified-subscribe::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-foreground) 18%, transparent) 0%,
      color-mix(in srgb, var(--color-foreground) 55%, transparent) 100%);
    pointer-events: none;
  }
  .fortified-subscribe__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 720px;
    margin-inline: auto;
    padding-block: clamp(56px, 7vw, 96px);
    padding-inline: clamp(20px, 3vw, 48px);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .fortified-subscribe__inner .fortified-eyebrow {
    color: var(--color-background);
    opacity: 0.85;
  }
  .fortified-subscribe__inner .fortified-heading {
    color: var(--color-background);
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .fortified-subscribe__list {
    margin: 8px 0 16px;
    gap: 8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .fortified-subscribe__list li {
    color: var(--color-background);
    font-size: 14px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .fortified-subscribe__list li::before {
    color: var(--fortified-accent, var(--color-background));
    font-size: 14px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-background) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-background) 40%, transparent);
  }
  .fortified-subscribe__inner .fortified-btn {
    background: var(--color-background);
    color: var(--color-foreground);
    border: 0;
    padding: 16px 36px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-height: 50px;
    margin-top: 4px;
    
  }
  .fortified-subscribe__inner .fortified-btn:hover {
    background: var(--fortified-accent, var(--color-foreground));
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "10 \u2014 Subscribe & Save",
  "tag": "section",
  "class": "fortified-subscribe-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUBSCRIBE & SAVE 15%"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Improve Hydration"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Boost Energy Naturally"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Support Muscle Function"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SUBSCRIBE NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for accent bars, CTA backgrounds, checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "presets": [
    {
      "name": "10 \u2014 Subscribe & Save",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    },
    {
      "name": "10 \u2014 Subscribe & Save",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "10 \u2014 Subscribe & Save",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
