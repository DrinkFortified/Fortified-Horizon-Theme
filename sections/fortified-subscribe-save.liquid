{% comment %}
  Section: FTD - Subscribe & Save
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Promotional two-column section with eyebrow + heading + checklist on
  one side and a product image on the other. Optional background image
  with overlay.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'ftss-' | append: sid
  assign anchor_id = section.settings.anchor_id | strip | handleize
  if anchor_id != blank
    assign root = anchor_id
  endif
  assign btn_style = section.settings.button_style | default: 'outline'
  assign tone = section.settings.text_color | default: 'light'
  assign image_position = section.settings.image_position | default: 'right'
  assign bg_class = root | append: '__bg'
  assign img_alt  = section.settings.heading | default: ''
  assign focal = section.settings.foreground_image_focal | default: 'center'
  assign focal_css = focal | replace: '-', ' '
  assign overlay_dec = section.settings.background_overlay | divided_by: 100.0
-%}

<style>
  #{{ root }} {
    position: relative;
    --{{ root }}-max-w: {{ section.settings.content_max_width }}px;
    --{{ root }}-accent: {{ section.settings.eyebrow_color }};
    isolation: isolate;
  }
  #{{ root }} .{{ root }}__bg,
  #{{ root }} .{{ root }}__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  #{{ root }} .{{ root }}__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #{{ root }} .{{ root }}__overlay {
    background-color: #000000;
    opacity: {{ overlay_dec }};
    z-index: 1;
  }
  #{{ root }} .{{ root }}__inner {
    position: relative;
    z-index: 2;
    max-width: var(--{{ root }}-max-w);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  #{{ root }} .{{ root }}__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  #{{ root }} .{{ root }}__grid--image-left {
    grid-template-columns: 1fr 1.05fr;
  }
  #{{ root }} .{{ root }}__grid--image-left .{{ root }}__text  { order: 2; }
  #{{ root }} .{{ root }}__grid--image-left .{{ root }}__media { order: 1; }

  #{{ root }} .{{ root }}--light { color: #FFFFFF; }
  #{{ root }} .{{ root }}--dark  { color: #0E0E0E; }

  #{{ root }} .{{ root }}__text {
    display: flex;
    flex-direction: column;
    gap: var(--ftd-s4, 16px);
    max-width: 560px;
  }
  #{{ root }} .{{ root }}__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: var(--ftd-eyebrow-size);
    font-weight: 700;
    letter-spacing: var(--ftd-eyebrow-spacing);
    text-transform: uppercase;
    color: var(--{{ root }}-accent);
  }
  #{{ root }} .{{ root }}__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: var(--ftd-h2-size);
    font-weight: 800;
    line-height: var(--ftd-h2-line);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  #{{ root }} .{{ root }}__list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #{{ root }} .{{ root }}__item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    line-height: 1.4;
  }
  #{{ root }} .{{ root }}__check {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1.5px solid var(--{{ root }}-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--{{ root }}-accent);
  }
  #{{ root }} .{{ root }}__check img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 999px;
    display: block;
  }
  #{{ root }} .{{ root }}__check svg { display: block; }

  #{{ root }} .{{ root }}__btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    margin-top: 8px;
    border: 2px solid currentColor;
    transition: background 0.18s, color 0.18s, opacity 0.18s;
    cursor: pointer;
  }
  #{{ root }} .{{ root }}__btn--outline { background: transparent; }
  #{{ root }} .{{ root }}--light .{{ root }}__btn--outline:hover { background: #FFFFFF; color: #0E0E0E; }
  #{{ root }} .{{ root }}--dark  .{{ root }}__btn--outline:hover { background: #0E0E0E; color: #FFFFFF; }
  #{{ root }} .{{ root }}--light .{{ root }}__btn--filled { background: #FFFFFF; color: #0E0E0E; }
  #{{ root }} .{{ root }}--dark  .{{ root }}__btn--filled { background: #0E0E0E; color: #FFFFFF; }
  #{{ root }} .{{ root }}__btn--filled:hover { opacity: 0.88; }

  #{{ root }} .{{ root }}__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 560px;
  }
  #{{ root }} .{{ root }}__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: {{ focal_css }};
    display: block;
  }

  @media (max-width: 749px) {
    #{{ root }} .{{ root }}__grid,
    #{{ root }} .{{ root }}__grid--image-left {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    #{{ root }} .{{ root }}__grid--image-left .{{ root }}__text  { order: 1; }
    #{{ root }} .{{ root }}__grid--image-left .{{ root }}__media { order: 2; }
    #{{ root }} .{{ root }}__media { aspect-ratio: 4 / 3; }
  }

  [hidden]{display:none!important}
  {{ section.settings.custom_css }}
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="{{ root }}"
  class="{{ root }}__section {{ root }}--{{ tone }} section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  {%- if section.settings.background_image != blank -%}
    {{ section.settings.background_image | image_url: width: 2000 | image_tag:
      class: bg_class,
      loading: 'lazy',
      widths: '600,1000,1400,1800,2200',
      alt: ''
    }}
    <div class="{{ root }}__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="{{ root }}__inner">
    <div class="{{ root }}__grid {% if image_position == 'left' %}{{ root }}__grid--image-left{% endif %}">

      <div class="{{ root }}__text">
        {%- liquid
          assign px = product.metafields.fortified.pdp_extra.value
          assign eyebrow_v = section.settings.eyebrow
          assign heading_v = section.settings.heading
          assign cta_label_v = section.settings.button_label
          assign use_pdp_benefits = false
          if px != blank
            if px.subscribe_eyebrow != blank
              assign eyebrow_v = px.subscribe_eyebrow
            endif
            if px.subscribe_heading != blank
              assign heading_v = px.subscribe_heading
            endif
            if px.subscribe_cta_label != blank
              assign cta_label_v = px.subscribe_cta_label
            endif
            if px.subscribe_benefits.value != blank and px.subscribe_benefits.value.size > 0
              assign use_pdp_benefits = true
            endif
          endif
        -%}
        {%- if eyebrow_v != blank -%}
          <p class="{{ root }}__eyebrow">{{ eyebrow_v }}</p>
        {%- endif -%}
        {%- if heading_v != blank -%}
          <h2 class="{{ root }}__heading">{%- render 'ftd-rich-text', text: heading_v -%}</h2>
        {%- endif -%}

        {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
        {%- if use_pdp_benefits -%}
          <ul class="{{ root }}__list" role="list">
            {%- for txt in px.subscribe_benefits.value -%}
              <li class="{{ root }}__item">
                <span class="{{ root }}__check" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 8.5 6.5 12 13 4.5"/></svg>
                </span>
                <span>{{ txt }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif benefits.size > 0 -%}
          <ul class="{{ root }}__list">
            {%- for block in benefits -%}
              <li class="{{ root }}__item" {{ block.shopify_attributes }}>
                <span class="{{ root }}__check" aria-hidden="true">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 60 | image_tag: loading: 'lazy', widths: '30,60', alt: '' }}
                  {%- else -%}
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 8.5 6.5 12 13 4.5"/></svg>
                  {%- endif -%}
                </span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="{{ root }}__btn {{ root }}__btn--{{ btn_style }}"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}
          >{{ cta_label_v }}</a>
        {%- endif -%}
      </div>

      <div class="{{ root }}__media">
        {%- if section.settings.foreground_image != blank -%}
          {{ section.settings.foreground_image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            widths: '400,700,1000,1300',
            alt: img_alt
          }}
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "FTD - Subscribe & Save",
  "tag": "section",
  "class": "ftd-subscribe-save-section",
  "settings": [
    {
      "type": "header",
      "content": "Anchor"
    },
    {
      "type": "text",
