{% render 'fortified-base' %}

<section
  id="FortifiedSubscribe-{{ section.id }}"
  class="fortified-subscribe color-{{ section.settings.color_scheme | default: 'scheme-2' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 0 }}px {{ section.settings['padding-block-end'] | default: 0 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 0 }}px {{ section.settings['padding-inline-end'] | default: 0 }}px;"
>
  <div class="fortified-subscribe__frame{% if section.settings.background_image == blank %} fortified-subscribe__frame--placeholder{% endif %}">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2880 | image_tag:
          widths: '800, 1200, 1800, 2400, 2880',
          sizes: '100vw',
          class: 'fortified-subscribe__bg',
          alt: '',
          loading: 'lazy' }}
    {% endif %}

    <div class="fortified-subscribe__content">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-subscribe__eyebrow">{{ section.settings.eyebrow | replace: '*', '' }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-subscribe__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h2>
      {% endif %}
      <ul class="fortified-subscribe__list">
        {% for i in (1..6) %}
          {%- assign key = 'benefit_' | append: i -%}
          {%- assign val = section.settings[key] -%}
          {% if val != blank %}
            <li>
              <span class="fortified-subscribe__check" aria-hidden="true">✓</span>
              <span>{% render 'fortified-accent-text', text: val %}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-subscribe__btn">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-subscribe {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-subscribe__frame {
    position: relative;
    width: 100%;
    min-height: 620px;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
  }
  .fortified-subscribe__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    z-index: 0;
  }
  .fortified-subscribe__frame--placeholder {
    background:
      radial-gradient(circle at 80% 50%,
        color-mix(in srgb, var(--fortified-accent) 24%, transparent) 0%,
        transparent 60%),
      linear-gradient(135deg,
        color-mix(in srgb, var(--color-foreground) 6%, transparent),
        color-mix(in srgb, var(--color-foreground) 14%, transparent));
  }
  .fortified-subscribe__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 42px;
    padding: 100px 40px;
    color: var(--color-foreground);
    max-width: 720px;
  }
  .fortified-subscribe__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-subscribe__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-subscribe__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 420px;
  }
  .fortified-subscribe__list li {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--font-fortified-body);
    font-size: 28px;
    font-weight: 400;
    line-height: 1;
    text-transform: capitalize;
    color: var(--color-foreground);
  }
  .fortified-subscribe__check {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--fortified-accent);
    color: var(--color-background);
    font-weight: 700;
    font-size: 22px;
  }
  .fortified-subscribe__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-subscribe__frame { min-height: 520px; }
    .fortified-subscribe__heading { font-size: 44px; }
    .fortified-subscribe__list li { font-size: 22px; }
    .fortified-subscribe__content { padding: 72px 32px; gap: 32px; }
  }
  @media (max-width: 749px) {
    .fortified-subscribe__frame { min-height: 480px; }
    .fortified-subscribe__content { padding: 56px 24px; gap: 24px; }
    .fortified-subscribe__heading { font-size: 32px; }
    .fortified-subscribe__eyebrow { font-size: 18px; }
    .fortified-subscribe__list li { font-size: 18px; gap: 16px; }
    .fortified-subscribe__check { flex: 0 0 32px; width: 32px; height: 32px; font-size: 16px; }
    .fortified-subscribe__btn { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "10 — Subscribe & Save",
  "tag": "section",
  "class": "fortified-subscribe-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color. Use line breaks to split into multiple lines.",
      "default": "subscribe\n*& save 15%*"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Improve hydration"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Boost energy naturally"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "support muscle function"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4"
    },
    {
      "type": "text",
      "id": "benefit_5",
      "label": "Benefit 5"
    },
    {
      "type": "text",
      "id": "benefit_6",
      "label": "Benefit 6"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SUBSCRIBE NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow and checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "10 — Subscribe & Save",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    },
    {
      "name": "10 — Subscribe & Save",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "10 — Subscribe & Save",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
