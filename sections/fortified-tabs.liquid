{% comment %}
  Section: FTD - Tabbed Content
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Pure-CSS tabs (no JS) that hold STRUCTURED content. Two block types:
    • "Tab"  — starts a new tab (label + optional rich intro).
    • "Row"  — an ingredient/fact row (image, title, description, button,
               per-serving stat, and a facts column). Rows belong to the
               Tab that precedes them, so you build each tab by adding a
               Tab block then any number of Row blocks under it.
  Switching is hidden-radio + `:checked ~` CSS — rendered as real siblings,
  so Horizon can't break it. Includes standard section options: width,
  padding, color scheme, and custom CSS.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'fttabs-' | append: sid

  assign tab_total = 0
  assign active = 1
  assign found = false
  for b in section.blocks
    if b.type == 'tab'
      assign tab_total = tab_total | plus: 1
      if b.settings.start_active and found == false
        assign active = tab_total
        assign found = true
      endif
    endif
  endfor

  assign btn_style = section.settings.button_style

  assign accent_c       = section.settings.accent_color       | default: 'var(--color-primary)'
  assign heading_c      = section.settings.heading_color      | default: 'var(--color-foreground-heading)'
  assign subtitle_c     = section.settings.subtitle_color     | default: 'var(--color-foreground)'
  assign tab_inactive_c = section.settings.tab_inactive_color | default: 'var(--color-foreground)'
  assign tab_line_c     = section.settings.tab_line_color     | default: 'var(--color-border)'
  assign divider_c      = section.settings.divider_color      | default: 'var(--color-border)'
  assign button_bg_c    = section.settings.button_bg          | default: 'var(--color-primary-button-background)'
  assign button_tx_c    = section.settings.button_text        | default: 'var(--color-primary-button-text)'
-%}

<style>
  #{{ root }} { background: var(--color-background); overflow-x: clip; max-width: 100%; }
  #{{ root }} .{{ root }}__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #{{ root }} .{{ root }}__head { text-align: center; max-width: 760px; margin: 0 auto 32px; display: flex; flex-direction: column; gap: 10px; }
  #{{ root }} .{{ root }}__eyebrow { margin: 0; font-family: var(--font-heading--family, inherit); font-size: 13px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: {{ accent_c }}; }
  #{{ root }} .{{ root }}__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-size: clamp(28px, 4.4vw, 52px); font-weight: 800; line-height: 1.05; text-transform: uppercase; color: {{ heading_c }}; }
  #{{ root }} .{{ root }}__sub { margin: 0; font-size: 16px; line-height: 1.5; color: {{ subtitle_c }}; }

  #{{ root }} .{{ root }}__radio { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #{{ root }} .{{ root }}__tablist { display: flex; flex-wrap: wrap; justify-content: center; gap: 48px; border-bottom: 1px solid {{ tab_line_c }}; padding-top: 8px; margin-bottom: 8px; }
  #{{ root }} .{{ root }}__btn { display: inline-block; padding: 12px 4px; margin-bottom: -1px; cursor: pointer; user-select: none; font-family: var(--font-heading--family, inherit); font-size: 18px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: {{ tab_inactive_c }}; border-bottom: 2px solid transparent; transition: color 0.18s, border-color 0.18s; }
  #{{ root }} .{{ root }}__btn:hover { color: {{ heading_c }}; }
  #{{ root }} .{{ root }}__panel { display: none; padding: 8px 0 0; }
  #{{ root }} .{{ root }}__intro { font-size: 15px; line-height: 1.6; color: {{ subtitle_c }}; margin: 8px 0 16px; }

  /* ── Ingredient / fact row ── */
  #{{ root }} .{{ root }}__row { display: grid; grid-template-columns: 150px minmax(0,1fr) 150px minmax(0,1.1fr); gap: 28px; align-items: center; padding: 22px 0; }
  #{{ root }} .{{ root }}__row--nomedia { grid-template-columns: minmax(0,1fr) 150px minmax(0,1.1fr); }
  #{{ root }} .{{ root }}__row + .{{ root }}__row { border-top: 1px solid {{ tab_line_c }}; }
  #{{ root }} .{{ root }}__row-media { width: 150px; height: 100px; border-radius: 8px; overflow: hidden; background: rgb(var(--color-foreground-rgb) / 0.06); }
  #{{ root }} .{{ root }}__row-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #{{ root }} .{{ root }}__row-title { margin: 0 0 4px; font-family: var(--font-heading--family, inherit); font-size: 19px; font-weight: 800; color: {{ heading_c }}; }
  #{{ root }} .{{ root }}__row-desc { margin: 0 0 10px; font-size: 13px; line-height: 1.5; color: {{ subtitle_c }}; }
  #{{ root }} .{{ root }}__row-btn { display: inline-flex; align-items: center; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 8px 16px; border: 1px solid {{ heading_c }}; border-radius: 4px; color: {{ heading_c }}; transition: background 0.18s, color 0.18s; }
  #{{ root }} .{{ root }}__row-btn:hover { background: {{ heading_c }}; color: var(--color-background); }
  #{{ root }} .{{ root }}__row-stat { border-left: 1px dashed {{ divider_c }}; padding-left: 28px; }
  #{{ root }} .{{ root }}__row-num { font-family: var(--font-heading--family, inherit); font-size: 26px; font-weight: 800; line-height: 1; color: {{ heading_c }}; }
  #{{ root }} .{{ root }}__row-num-label { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: {{ subtitle_c }}; margin-top: 4px; }
  #{{ root }} .{{ root }}__row-fact { display: flex; align-items: center; gap: 16px; border-left: 1px dashed {{ divider_c }}; padding-left: 28px; }
  #{{ root }} .{{ root }}__row-fact-icon { flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%; background: {{ heading_c }}; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; }
  #{{ root }} .{{ root }}__row-fact-icon img { width: 60%; height: 60%; object-fit: contain; }
  #{{ root }} .{{ root }}__row-fact-title { font-family: var(--font-heading--family, inherit); font-size: 17px; font-weight: 800; color: {{ heading_c }}; margin-bottom: 2px; }
  #{{ root }} .{{ root }}__row-fact-desc { margin: 0; font-size: 12.5px; line-height: 1.45; color: {{ subtitle_c }}; }

  {%- assign ci = 0 -%}
  {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign ci = ci | plus: 1 -%}
    #{{ root }}-r-{{ ci }}:checked ~ .{{ root }}__tablist .{{ root }}__btn--{{ ci }} { color: {{ accent_c }}; border-bottom-color: {{ accent_c }}; }
    #{{ root }}-r-{{ ci }}:checked ~ .{{ root }}__panels .{{ root }}__panel--{{ ci }} { display: block; }
    #{{ root }}-r-{{ ci }}:focus-visible ~ .{{ root }}__tablist .{{ root }}__btn--{{ ci }} { outline: 2px solid {{ accent_c }}; outline-offset: 4px; }
  {%- endif -%}{%- endfor -%}

  #{{ root }} .{{ root }}__footer { display: flex; justify-content: center; margin-top: 36px; }
  #{{ root }} .{{ root }}__cta { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; font-family: var(--font-heading--family, inherit); font-size: 14px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 40px; border-radius: var(--style-border-radius-buttons-primary, 8px); border: 2px solid {{ button_bg_c }};
    {% if btn_style == 'outline' %}background: transparent; color: {{ button_bg_c }};
    {% elsif btn_style == 'ghost' %}background: transparent; color: {{ button_bg_c }}; border-color: transparent; text-decoration: underline;
    {% else %}background: {{ button_bg_c }}; color: {{ button_tx_c }};{% endif %}
    transition: filter 0.18s; }
  #{{ root }} .{{ root }}__cta:hover { filter: brightness(1.1); }

  @media (max-width: 749px) {
    /* Contain everything to the viewport and give the tab content the same
       16px side padding the header/footer use, so the bleed-scroller below
       (margin-inline: -16px) lines up with the screen edge instead of
       overflowing it. */
    #{{ root }} .{{ root }}__inner { max-width: 100%; overflow-x: clip; }
    #{{ root }} .{{ root }}__tabwrap { padding-inline: 16px; }
    #{{ root }} .{{ root }}__head { max-width: 100%; padding-inline: 16px; text-align: center; margin-bottom: 24px; }
    #{{ root }} .{{ root }}__eyebrow { font-size: 12px; letter-spacing: 0.22em; overflow-wrap: break-word; }
    #{{ root }} .{{ root }}__heading { font-size: clamp(24px, 7vw, 34px); line-height: 1.12; overflow-wrap: break-word; }
    #{{ root }} .{{ root }}__sub { font-size: 14px; line-height: 1.55; max-width: 100%; overflow-wrap: break-word; }

    #{{ root }} .{{ root }}__footer { padding-inline: 16px; }
    #{{ root }} .{{ root }}__cta { width: 100%; max-width: 100%; min-height: 44px; white-space: normal; text-align: center; padding: 14px 24px; font-size: 14px; }

    #{{ root }} .{{ root }}__tablist { gap: 22px; }
    #{{ root }} .{{ root }}__btn { font-size: 15px; }

    /* Rows become swipeable cards: horizontal snap-scroller, one card peeking each side. */
    #{{ root }} .{{ root }}__rows {
      display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch; scroll-padding-inline: 16px;
      padding: 4px 16px 12px; margin: 0 -16px;
    }
    #{{ root }} .{{ root }}__rows::-webkit-scrollbar { height: 0; }
    #{{ root }} .{{ root }}__row {
      flex: 0 0 80%; min-width: 0; scroll-snap-align: center;
      grid-template-columns: 1fr; gap: 0; text-align: center;
      border: 1px solid {{ tab_line_c }}; border-radius: 16px; padding: 22px 18px;
    }
    #{{ root }} .{{ root }}__row + .{{ root }}__row { border-top: 1px solid {{ tab_line_c }}; }
    #{{ root }} .{{ root }}__row-media { width: 100%; max-width: 260px; height: 220px; margin: 0 auto 16px; }
    #{{ root }} .{{ root }}__row-main { display: flex; flex-direction: column; align-items: center; }
    #{{ root }} .{{ root }}__row-stat { border-left: 0; padding: 16px 0 0; margin-top: 16px; border-top: 1px dashed {{ divider_c }}; }
    #{{ root }} .{{ root }}__row-fact { flex-direction: column; align-items: center; text-align: center; gap: 10px; border-left: 0; padding: 16px 0 0; margin-top: 16px; border-top: 1px dashed {{ divider_c }}; }
  }

  /* Primary + secondary CTA row: equal width, side-by-side on all viewports. */
  #{{ root }} .ftd-cta-row { display: flex; gap: 12px; flex-wrap: nowrap; justify-content: center; align-items: stretch; }
  #{{ root }} .ftd-cta-row > .button,
  #{{ root }} .ftd-cta-row > .button-secondary { flex: 1 1 0; min-width: 0; max-width: 260px; justify-content: center; text-align: center; }

  {{ section.settings.custom_css }}
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="{{ root }}"
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="{{ root }}__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="{{ root }}__head">
        {%- if section.settings.eyebrow != blank -%}<h4 class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</h4>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="{{ root }}__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="{{ root }}__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if tab_total > 0 -%}
      <div class="{{ root }}__tabwrap">
        {%- comment -%} 1) radios {%- endcomment -%}
        {%- assign ci = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign ci = ci | plus: 1 -%}
          <input type="radio" class="{{ root }}__radio" name="{{ root }}-state" id="{{ root }}-r-{{ ci }}" {% if ci == active %}checked{% endif %}>
        {%- endif -%}{%- endfor -%}

        {%- comment -%} 2) tab buttons {%- endcomment -%}
        <div class="{{ root }}__tablist" role="tablist">
          {%- assign ci = 0 -%}
          {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}{%- assign ci = ci | plus: 1 -%}
            <label class="{{ root }}__btn {{ root }}__btn--{{ ci }}" for="{{ root }}-r-{{ ci }}" role="tab" {{ b.shopify_attributes }}>{{ b.settings.tab_label | default: 'Tab' }}</label>
          {%- endif -%}{%- endfor -%}
        </div>

        {%- comment -%} 3) panels: open at each Tab, Rows belong to the current Tab {%- endcomment -%}
        <div class="{{ root }}__panels">
          {%- assign ti = 0 -%}
          {%- for b in section.blocks -%}
            {%- if b.type == 'tab' -%}
              {%- if ti > 0 -%}</div></div>{%- endif -%}
              {%- assign ti = ti | plus: 1 -%}
              <div class="{{ root }}__panel {{ root }}__panel--{{ ti }}" role="tabpanel">
                {%- if b.settings.intro != blank -%}<div class="{{ root }}__intro rte">{{ b.settings.intro }}</div>{%- endif -%}
                <div class="{{ root }}__rows">
            {%- elsif b.type == 'row' and ti > 0 -%}
              <div class="{{ root }}__row{% if b.settings.image == blank %} {{ root }}__row--nomedia{% endif %}" {{ b.shopify_attributes }}>
                {%- if b.settings.image != blank -%}<div class="{{ root }}__row-media"><img src="{{ b.settings.image | image_url: width: 400 }}" alt="{{ b.settings.title | escape }}" loading="lazy" width="150" height="100"></div>{%- endif -%}
                <div class="{{ root }}__row-main">
                  {%- if b.settings.title != blank -%}<h3 class="{{ root }}__row-title">{{ b.settings.title }}</h3>{%- endif -%}
                  {%- if b.settings.description != blank -%}<p class="{{ root }}__row-desc">{{ b.settings.description }}</p>{%- endif -%}
                  {%- if b.settings.button_label != blank -%}<a class="{{ root }}__row-btn" {% if b.settings.button_link != blank %}href="{{ b.settings.button_link }}"{% else %}href="#"{% endif %}>{{ b.settings.button_label }}</a>{%- endif -%}
                </div>
                <div class="{{ root }}__row-stat">
                  {%- if b.settings.stat_number != blank -%}<div class="{{ root }}__row-num">{{ b.settings.stat_number }}</div>{%- endif -%}
                  {%- if b.settings.stat_label != blank -%}<div class="{{ root }}__row-num-label">{{ b.settings.stat_label }}</div>{%- endif -%}
                </div>
                <div class="{{ root }}__row-fact">
                  <span class="{{ root }}__row-fact-icon">{%- if b.settings.icon != blank -%}<img src="{{ b.settings.icon | image_url: width: 80 }}" alt="">{%- endif -%}</span>
                  <div class="{{ root }}__row-fact-text">
                    {%- if b.settings.fact_title != blank -%}<div class="{{ root }}__row-fact-title">{{ b.settings.fact_title }}</div>{%- endif -%}
                    {%- if b.settings.fact_text != blank -%}<p class="{{ root }}__row-fact-desc">{{ b.settings.fact_text }}</p>{%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if ti > 0 -%}</div></div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.secondary_button_label != blank -%}
      <div class="{{ root }}__footer ftd-cta-row">
        {%- if section.settings.button_label != blank -%}
          <a class="button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}>{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          {%- assign sec_link = section.settings.secondary_button_link | default: '#shopify-section-ftd_c_supp_facts_4JN74r' -%}
          <a class="button button-secondary" href="{{ sec_link }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "FTD - Tabbed Content",
  "tag": "section",
  "class": "ftd-tabs-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (H4)", "default": "The Truth" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "Why We Beat The Rest" },
    { "type": "textarea", "id": "subheading", "label": "Description", "default": "Electrolytes don't provide full recovery." },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Fortified Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Secondary CTA (Learn More)" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Learn More" },
    { "type": "text", "id": "secondary_button_link",  "label": "Secondary button link",  "default": "#shopify-section-ftd_c_supp_facts_4JN74r", "info": "Defaults to the Supplement Facts section." },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "filled",
      "options": [ { "value": "filled", "label": "Filled" }, { "value": "outline", "label": "Outline" }, { "value": "ghost", "label": "Ghost" } ] },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#0A0A0A" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow + active tab)", "default": "#1FA8A1" },
    { "type": "color", "id": "heading_color", "label": "Heading / text", "default": "#0A0A0A" },
    { "type": "color", "id": "subtitle_color", "label": "Body / muted text", "default": "#666666" },
    { "type": "color", "id": "tab_inactive_color", "label": "Inactive tab", "default": "#888888" },
    { "type": "color", "id": "tab_line_color", "label": "Lines & dividers", "default": "#E5E7EB" },
    { "type": "color", "id": "divider_color", "label": "Row column dividers", "default": "#C9CDD2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "page-width", "options": [ { "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" } ] },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1280 },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 },

    { "type": "header", "content": "Advanced" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "info": "Targets this section. Use the selector prefix shown on its elements (e.g. .fttabs-… )." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "paragraph", "content": "Add a Tab, then add Row blocks under it. Rows belong to the Tab above them." },
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Hydration" },
        { "type": "checkbox", "id": "start_active", "label": "Show this tab first", "default": false },
        { "type": "richtext", "id": "intro", "label": "Intro text (optional)" }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sodium Citrate" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Essential electrolyte to support fluid balance, hydration, and muscle function" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Hydration" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Stat column" },
        { "type": "text", "id": "stat_number", "label": "Stat number", "default": "1200MG" },
        { "type": "text", "id": "stat_label", "label": "Stat label", "default": "Per Serving" },
        { "type": "header", "content": "Facts column" },
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "fact_title", "label": "Fact title", "default": "Hydration Facts" },
        { "type": "textarea", "id": "fact_text", "label": "Fact text", "default": "Supports muscle function and reduces cramps" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FTD - Tabbed Content",
      "category": "Fortified Sections",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "Hydration", "start_active": true } },
        { "type": "row" },
        { "type": "row" },
        { "type": "tab", "settings": { "tab_label": "Performance" } },
        { "type": "row", "settings": { "title": "Magnesium Malate", "description": "Supports energy production and reduces cramps in high-intensity workouts", "fact_title": "Performance Facts" } }
      ]
    }
  ]
}
{% endschema %}
