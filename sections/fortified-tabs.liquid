{% comment %}
  FTD - Tabbed Content
  ----------------------------------------------------------------------
  A tabbed content section. Each child "fortified-tab-panel" block is one
  tab; the section auto-generates a button per tab. Each panel accepts any
  Horizon (@theme / @app) blocks as children.

  STRUCTURE (top to bottom):
    - Eyebrow  <h4>
    - Heading  <h2>
    - Description  <p>
    - Tab selector + tab content (panels)
    - Bottom button (label + link + style)

  SWITCHING — bulletproof JavaScript, structure independent
  ----------------------------------------------------------------------
  In Horizon, `{% content_for 'blocks' %}` WRAPS each top-level block in a
  Shopify-generated container element (it carries the block's editor
  attributes). That wrapper — not the inner `.ft-tabs__panel` — is the
  element that actually participates in the panels container's layout, so
  toggling display only on the inner panel can leave the wrapper (and thus
  the content) on screen. Earlier CSS `:checked ~ sibling` attempts also
  broke because the wrapper severs the sibling chain.

  This version is wrapper agnostic:
    - Everything is scoped to the section root by id.
    - We find every `.ft-tabs__panel`, then resolve the element that is a
      DIRECT child of the `__panels` container (the wrapper Shopify injected,
      or the panel itself if there is no wrapper) and toggle visibility on
      THAT element. So whichever element controls layout is the one hidden.
    - Tab buttons use event delegation on the section root, so clicks work
      no matter how the buttons end up wrapped.
    - Buttons match panels by a shared 1-based index
      (button data-ft-tab  <->  panel data-ftp-index). The button loop and
      the panel block's index computation both iterate the SAME
      `where: 'type', 'fortified-tab-panel'` set in the SAME order.
    - Re-initialises immediately, on DOMContentLoaded, and on
      shopify:section:load (theme editor re-render).
    - shopify:block:select reveals the panel whose block (or descendant) is
      being edited.
    - On first paint exactly ONE panel is visible (start_active, else first).
{% endcomment %}

{% liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign root = 'ft-tabs-' | append: sid
  assign panels = section.blocks | where: 'type', 'fortified-tab-panel'

  assign active_index = 1
  assign found_active = false
  for block in panels
    if block.settings.start_active and found_active == false
      assign active_index = forloop.index
      assign found_active = true
    endif
  endfor

  assign btn_style = section.settings.button_style
%}

<style>
  .{{ root }} {
    width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_h }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    color: {{ section.settings.heading_color }};
    background: {{ section.settings.background_color }};
    font-family: var(--font-body--family, inherit);
  }
  .{{ root }}__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; text-align: center; }
  .{{ root }}__eyebrow { font-family: var(--font-heading--family, inherit); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: {{ section.settings.accent_color }}; margin: 0; }
  .{{ root }}__heading { font-family: var(--font-heading--family, inherit); font-size: clamp(32px, 5vw, 56px); font-weight: 800; line-height: 1.05; letter-spacing: -0.01em; text-transform: uppercase; color: {{ section.settings.heading_color }}; margin: 0; }
  .{{ root }}__subtitle { font-family: var(--font-body--family, inherit); font-size: 16px; line-height: 1.5; color: {{ section.settings.subtitle_color }}; margin: 0; }

  .{{ root }}__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 48px; border-bottom: 1px solid {{ section.settings.tab_line_color }}; padding: 16px 0 0; }
  .{{ root }}__btn {
    appearance: none; background: none; border: 0; padding: 12px 4px; margin-bottom: -1px;
    font-family: var(--font-heading--family, inherit); font-size: 18px; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase; color: {{ section.settings.tab_inactive_color }};
    border-bottom: 2px solid transparent; cursor: pointer; transition: color 0.18s, border-color 0.18s;
    display: inline-block; user-select: none;
  }
  .{{ root }}__btn:hover { color: {{ section.settings.heading_color }}; }
  .{{ root }}__btn.is-active { color: {{ section.settings.accent_color }}; border-bottom-color: {{ section.settings.accent_color }}; }
  .{{ root }}__btn:focus-visible { outline: 2px solid {{ section.settings.accent_color }}; outline-offset: 4px; border-radius: 2px; }

  .{{ root }}__panels { text-align: left; }

  /* Wrapper-agnostic hide/show. The section JS adds .ft-is-hidden to
     whichever element actually controls the panel's layout (the panel OR
     the Shopify-injected wrapper around it). !important guarantees it beats
     any inline display set by a wrapped child block. */
  .{{ root }} .ft-is-hidden { display: none !important; }

  .{{ root }} .ft-tabs__panel { flex-direction: column; gap: var(--ftp-gap, 24px); padding: var(--ftp-pad-top, 16px) 0 var(--ftp-pad-bottom, 16px); }

  .{{ root }}__footer { display: flex; justify-content: center; }
  .{{ root }}__cta {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-heading--family, inherit); font-size: 16px; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none;
    padding: 16px 36px; border-radius: 6px; cursor: pointer;
    transition: background-color 0.18s, color 0.18s, border-color 0.18s;
    border: 2px solid {{ section.settings.accent_color }};
  }
  {% if btn_style == 'outline' %}
  .{{ root }}__cta { background: transparent; color: {{ section.settings.accent_color }}; }
  .{{ root }}__cta:hover { background: {{ section.settings.accent_color }}; color: #ffffff; }
  {% elsif btn_style == 'ghost' %}
  .{{ root }}__cta { background: transparent; color: {{ section.settings.accent_color }}; border-color: transparent; }
  .{{ root }}__cta:hover { color: {{ section.settings.heading_color }}; text-decoration: underline; }
  {% else %}
  .{{ root }}__cta { background: {{ section.settings.accent_color }}; color: #ffffff; }
  .{{ root }}__cta:hover { filter: brightness(0.92); }
  {% endif %}

  @media (max-width: 600px) {
    .{{ root }}__tabs { gap: 24px; }
    .{{ root }}__btn  { font-size: 15px; }
  }
</style>

<section id="{{ root }}" class="{{ root }}" data-active-index="{{ active_index }}" {{ section.shopify_attributes }}>
  <div class="{{ root }}__inner">

    {% if section.settings.eyebrow != blank %}<h4 class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</h4>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="{{ root }}__heading">{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subtitle != blank %}<p class="{{ root }}__subtitle">{{ section.settings.subtitle }}</p>{% endif %}

    {% if panels.size > 0 %}
      <div class="{{ root }}__tabs" role="tablist" aria-label="{{ section.settings.aria_label | default: 'Information tabs' }}">
        {% for block in panels %}
          <button
            type="button"
            class="{{ root }}__btn{% if forloop.index == active_index %} is-active{% endif %}"
            data-ft-tab="{{ forloop.index }}"
            role="tab"
            aria-selected="{% if forloop.index == active_index %}true{% else %}false{% endif %}"
          >{{ block.settings.tab_label | default: 'Tab' }}</button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="{{ root }}__panels">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="{{ root }}__footer">
        <a
          class="{{ root }}__cta"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}
        >{{ section.settings.button_label }}</a>
      </div>
    {% endif %}

  </div>
</section>

<script>
  (function () {
    var ROOT_ID = '{{ root }}';
    var SECTION_ID = {{ section.id | json }};

    function init(root) {
      if (!root || root.dataset.ftInit === '1') {
        if (root) reflectInitial(root);
        return;
      }
      root.dataset.ftInit = '1';

      /* Event delegation: one listener on the root catches every tab click,
         regardless of how the buttons get wrapped. */
      root.addEventListener('click', function (e) {
        var btn = e.target.closest('.' + ROOT_ID + '__btn');
        if (!btn || !root.contains(btn)) return;
        e.preventDefault();
        activate(root, btn.getAttribute('data-ft-tab'));
      });

      reflectInitial(root);
    }

    /* The element that actually controls a panel's layout: the direct child
       of the __panels container. Shopify may wrap each block, so the panel
       can be nested below that wrapper; we hide the wrapper, else the panel. */
    function layoutEl(root, panel) {
      var container = root.querySelector('.' + ROOT_ID + '__panels');
      var el = panel;
      while (el && el.parentElement && el.parentElement !== container) {
        el = el.parentElement;
      }
      return (el && el.parentElement === container) ? el : panel;
    }

    function panels(root) { return root.querySelectorAll('.ft-tabs__panel'); }
    function tabs(root)   { return root.querySelectorAll('.' + ROOT_ID + '__btn'); }

    function activate(root, idx) {
      idx = String(idx);
      var matched = false;
      panels(root).forEach(function (p) {
        var on = p.getAttribute('data-ftp-index') === idx;
        layoutEl(root, p).classList.toggle('ft-is-hidden', !on);
        p.classList.toggle('is-active', on);
        if (on) matched = true;
      });
      tabs(root).forEach(function (b) {
        var on = b.getAttribute('data-ft-tab') === idx;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      return matched;
    }

    /* Force exactly one visible panel: the requested index, else the first. */
    function reflectInitial(root) {
      var wanted = root.getAttribute('data-active-index') || '1';
      if (!activate(root, wanted)) {
        var first = root.querySelector('.ft-tabs__panel');
        if (first) {
          activate(root, first.getAttribute('data-ftp-index'));
        } else {
          /* No panels matched and none exist: hide everything to avoid
             showing all at once. */
          panels(root).forEach(function (p) { layoutEl(root, p).classList.add('ft-is-hidden'); });
        }
      }
    }

    function boot() { init(document.getElementById(ROOT_ID)); }

    /* Run immediately (script is inline, after the markup) ... */
    boot();
    /* ... and on full load ... */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    }
    /* ... and whenever the theme editor re-renders this section. */
    document.addEventListener('shopify:section:load', function (e) {
      if (!e.detail || e.detail.sectionId !== SECTION_ID) return;
      var r = document.getElementById(ROOT_ID);
      if (r) { r.dataset.ftInit = ''; init(r); }
    });

    /* Reveal a panel when its block (or a descendant block) is selected. */
    document.addEventListener('shopify:block:select', function (e) {
      var root = document.getElementById(ROOT_ID);
      if (!root || !e.target || !root.contains(e.target)) return;
      var panel = e.target.closest('.ft-tabs__panel');
      if (!panel && e.target.classList && e.target.classList.contains('ft-tabs__panel')) {
        panel = e.target;
      }
      if (panel) activate(root, panel.getAttribute('data-ftp-index'));
    });
  })();
</script>

{% schema %}
{
  "name": "FTD - Tabbed Content",
  "tag": "section",
  "class": "fortified-tabs-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",  "default": "THE TRUTH" },
    { "type": "text",     "id": "heading",  "label": "Heading",  "default": "WHY WE BEAT THE REST ELECTROLYTES" },
    { "type": "textarea", "id": "subtitle", "label": "Description", "default": "Electrolytes don't provide full recovery." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color",        "label": "Accent",           "default": "#1FA8A1" },
    { "type": "color", "id": "heading_color",       "label": "Heading",          "default": "#0A0A0A" },
    { "type": "color", "id": "subtitle_color",      "label": "Subtitle",         "default": "#444444" },
    { "type": "color", "id": "tab_inactive_color",  "label": "Inactive tab",     "default": "#888888" },
    { "type": "color", "id": "tab_line_color",      "label": "Tab divider line", "default": "#E5E7EB" },
    { "type": "color", "id": "background_color",    "label": "Background",       "default": "#FFFFFF" },

    { "type": "header", "content": "Bottom button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url",  "id": "button_link",  "label": "Button link" },
    {
      "type": "select", "id": "button_style", "label": "Button style", "default": "filled",
      "options": [
        { "value": "filled",  "label": "Filled" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost",   "label": "Ghost" }
      ]
    },

    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "aria_label", "label": "ARIA label for the tab group", "default": "Information tabs" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width",      "label": "Max width (px)",          "min": 600, "max": 1600, "step": 20, "default": 1200 },
    { "type": "range", "id": "padding_top",    "label": "Padding top (px)",        "min": 0,   "max": 160,  "step": 4,  "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)",     "min": 0,   "max": 160,  "step": 4,  "default": 80 },
    { "type": "range", "id": "padding_h",      "label": "Padding horizontal (px)", "min": 0,   "max": 100,  "step": 4,  "default": 24 }
  ],
  "blocks": [
    { "type": "fortified-tab-panel" }
  ],
  "presets": [
    {
      "name": "FTD - Tabbed Content",
      "category": "Fortified Sections",
      "blocks": [
        {
          "type": "fortified-tab-panel",
          "settings": { "tab_label": "Hydration", "start_active": true },
          "blocks": [
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "fortified-tab-panel",
          "settings": { "tab_label": "Performance" },
          "blocks": [
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
