{% comment %}
  Fortified Tabs Section
  ----------------------------------------------------------------------
  A tabbed content section. Each child "fortified-tab-panel" block is
  rendered as one tab. The section auto-generates a button per tab.

  The first panel (or the one with start_active=true) is shown by
  default. Selecting a tab shows the matching panel.

  Tab panels accept any theme block as their children — drop in native
  group/text/image blocks, or custom blocks (e.g. checkmark-list). So
  one panel can hold any composition the merchant builds.

  IMPLEMENTATION — pure-CSS tabs (no JS required)
  ----------------------------------------------------------------------
  Switching is driven entirely by hidden radio inputs + the CSS
  `:checked ~` sibling combinator, so it is immune to the JS-execution /
  theme-editor-iframe timing issues that broke previous attempts.

  Why the OLD approach failed: the panel block emitted an inline
  `style="display: flex; ..."` on its root <div class="ft-tabs__panel">.
  An inline `display:flex` ALWAYS beats a stylesheet rule, so the
  `.ft-tabs__panel { display: none }` / `.is-active { display: block }`
  rules could never hide/show anything — every panel stayed visible and
  clicking a tab appeared to do nothing. (The JS index-matching itself
  was fine; the CSS just couldn't take effect.)

  DOM layout that makes the pure-CSS selectors work:
    .{root}__panels
      > input.{root}__radio  (one per panel, in block order; first checked)
      > .{root}__tabs > label.{root}__btn ...
      > {% content_for 'blocks' %}  -> N sibling <div class="ft-tabs__panel">
  Because the panels are DIRECT children of .{root}__panels (custom
  section-level blocks render their own root element with NO Shopify
  wrapper), `:nth-of-type` against `.ft-tabs__panel` lines up 1:1 with
  the radios. Radio #N checked -> show the Nth panel.

  No-JS spacing detail: each panel's flex/gap/padding is applied via the
  stylesheet (NOT inline) so the show/hide rule can win.

  Accessibility:
    - Radios are visually hidden but focusable; labels are the tabs.
    - role="tab"/role="tablist"/role="tabpanel" preserved.
{% endcomment %}

{% liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign root = 'ft-tabs-' | append: sid
  assign panels = section.blocks | where: 'type', 'fortified-tab-panel'

  # Determine which panel index should start active (first with start_active,
  # else the first panel).
  assign active_index = 0
  assign found_active = false
  for block in panels
    if block.settings.start_active and found_active == false
      assign active_index = forloop.index0
      assign found_active = true
    endif
  endfor
%}

<style>
  .{{ root }} {
    width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_h }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    color: {{ section.settings.heading_color }};
    background: {{ section.settings.background_color }};
    font-family: var(--font-body--family, inherit);
  }
  .{{ root }}__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    text-align: center;
  }
  .{{ root }}__eyebrow {
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0;
  }
  .{{ root }}__heading {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }
  .{{ root }}__subtitle {
    font-family: var(--font-body--family, inherit);
    font-size: 16px;
    line-height: 1.5;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
  }

  /* Visually-hidden radio inputs that drive the tab state. Kept in the
     DOM (not display:none) so they stay focusable for keyboard users. */
  .{{ root }}__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Tab button row */
  .{{ root }}__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 48px;
    border-bottom: 1px solid {{ section.settings.tab_line_color }};
    padding: 16px 0 0;
  }
  .{{ root }}__btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 12px 4px;
    margin-bottom: -1px;
    font-family: var(--font-heading--family, inherit);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: {{ section.settings.tab_inactive_color }};
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.18s, border-color 0.18s;
    display: inline-block;
    user-select: none;
  }

  /* Panels area */
  .{{ root }}__panels {
    text-align: left;
  }

  /* ── Panel base layout (applied here, NOT inline, so the show/hide
     rules below can actually win). Each panel sets its own gap/padding
     via CSS variables emitted on the panel element. ── */
  .{{ root }} .ft-tabs__panel {
    display: none;
    flex-direction: column;
    gap: var(--ftp-gap, 24px);
    padding: var(--ftp-pad-top, 16px) 0 var(--ftp-pad-bottom, 16px);
  }

  /* ── Pure-CSS switching ──────────────────────────────────────────
     Radio #N checked -> activate label #N and show panel #N.
     The radios, the .__tabs label row, and the panels are all
     descendants of .__panels, so the `~` sibling combinator reaches
     both the matching label and the matching panel.

     We match panels by an explicit [data-ftp-index] attribute rather
     than :nth-of-type, because the .__tabs <div> is also a sibling
     <div> of the panels and would throw nth-of-type counting off.
     Attribute matching is exact and order-independent. */
  {% for block in panels %}
    {% assign n = forloop.index %}
    /* Active label highlight */
    #{{ root }}-radio-{{ n }}:checked ~ .{{ root }}__tabs .{{ root }}__btn--{{ n }} {
      color: {{ section.settings.accent_color }};
      border-bottom-color: {{ section.settings.accent_color }};
    }
    /* Show the matching panel */
    #{{ root }}-radio-{{ n }}:checked ~ .ft-tabs__panel[data-ftp-index="{{ n }}"] {
      display: flex;
    }
  {% endfor %}

  /* Focus ring on the label when its radio is focused via keyboard */
  .{{ root }}__radio:focus-visible ~ .{{ root }}__tabs label[for]:hover,
  .{{ root }}__btn:focus-visible {
    outline: 2px solid {{ section.settings.accent_color }};
    outline-offset: 4px;
    border-radius: 2px;
  }
  {% for block in panels %}
    {% assign n = forloop.index %}
    #{{ root }}-radio-{{ n }}:focus-visible ~ .{{ root }}__tabs .{{ root }}__btn--{{ n }} {
      outline: 2px solid {{ section.settings.accent_color }};
      outline-offset: 4px;
      border-radius: 2px;
    }
  {% endfor %}

  @media (max-width: 600px) {
    .{{ root }}__tabs { gap: 24px; }
    .{{ root }}__btn  { font-size: 15px; }
  }
</style>

<section
  id="{{ root }}"
  class="{{ root }}"
  {{ section.shopify_attributes }}
>
  <div class="{{ root }}__inner">

    {% if section.settings.eyebrow != blank %}
      <p class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="{{ root }}__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="{{ root }}__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {%- comment -%}
      Radios, the tab/label row, and the panels are ALL direct children of
      .__panels so the `:checked ~` sibling combinator can reach the matching
      label and panel. The radio for the active index is `checked` so the
      correct panel shows with zero JS. Labels point at their radio via `for`.
    {%- endcomment -%}
    <div class="{{ root }}__panels" role="tablist" aria-label="{{ section.settings.aria_label | default: 'Information tabs' }}">

      {%- comment -%} Hidden radios — one per panel, first/active one checked. {%- endcomment -%}
      {% for block in panels %}
        <input
          type="radio"
          class="{{ root }}__radio"
          name="{{ root }}__state"
          id="{{ root }}-radio-{{ forloop.index }}"
          {% if forloop.index0 == active_index %}checked{% endif %}
        >
      {% endfor %}

      {% if panels.size > 0 %}
        <div class="{{ root }}__tabs">
          {% for block in panels %}
            <label
              class="{{ root }}__btn {{ root }}__btn--{{ forloop.index }}"
              for="{{ root }}-radio-{{ forloop.index }}"
              role="tab"
            >
              {{ block.settings.tab_label | default: 'Tab' }}
            </label>
          {% endfor %}
        </div>
      {% endif %}

      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tabbed Content",
  "tag": "section",
  "class": "fortified-tabs-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",  "default": "THE TRUTH" },
    { "type": "text",     "id": "heading",  "label": "Heading",  "default": "WHY WE BEAT THE REST ELECTROLYTES" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Electrolytes don't provide full recovery." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color",        "label": "Accent",           "default": "#1FA8A1" },
    { "type": "color", "id": "heading_color",       "label": "Heading",          "default": "#0A0A0A" },
    { "type": "color", "id": "subtitle_color",      "label": "Subtitle",         "default": "#444444" },
    { "type": "color", "id": "tab_inactive_color",  "label": "Inactive tab",     "default": "#888888" },
    { "type": "color", "id": "tab_line_color",      "label": "Tab divider line", "default": "#E5E7EB" },
    { "type": "color", "id": "background_color",    "label": "Background",       "default": "#FFFFFF" },

    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "aria_label", "label": "ARIA label for the tab group", "default": "Information tabs" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width",      "label": "Max width (px)",          "min": 600, "max": 1600, "step": 20, "default": 1200 },
    { "type": "range", "id": "padding_top",    "label": "Padding top (px)",        "min": 0,   "max": 160,  "step": 4,  "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)",     "min": 0,   "max": 160,  "step": 4,  "default": 80 },
    { "type": "range", "id": "padding_h",      "label": "Padding horizontal (px)", "min": 0,   "max": 100,  "step": 4,  "default": 24 }
  ],
  "blocks": [
    { "type": "fortified-tab-panel" }
  ],
  "presets": [
    {
      "name": "Tabbed Content",
      "blocks": [
        {
          "type": "fortified-tab-panel",
          "settings": { "tab_label": "Hydration", "start_active": true },
          "blocks": [
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "fortified-tab-panel",
          "settings": { "tab_label": "Performance" },
          "blocks": [
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
