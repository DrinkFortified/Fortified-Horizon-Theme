{% comment %}
  Section: FTD - Tabbed Content
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Pure-CSS tabs, rebuilt to be bulletproof. Earlier versions relied on
  JS or on `content_for` blocks staying siblings — both broke inside
  Horizon's block wrapping. This version renders EVERYTHING itself with
  classic section blocks (no content_for, no wrappers): a hidden radio
  per tab, the label row, and the panels are all real siblings, so the
  `#radio:checked ~ .panel` selector switches them with zero JavaScript.

  Each "Tab" block holds a label + rich text content (text, images,
  lists, links). Add as many tabs as you like.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'fttabs-' | append: sid
  assign tabs = section.blocks

  assign active = 1
  assign found = false
  for block in tabs
    if block.settings.start_active and found == false
      assign active = forloop.index
      assign found = true
    endif
  endfor

  assign btn_style = section.settings.button_style
-%}

<style>
  #{{ root }} { padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px; background: rgb(var(--color-background)); }
  #{{ root }} .{{ root }}__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #{{ root }} .{{ root }}__head { text-align: center; max-width: 760px; margin: 0 auto 32px; display: flex; flex-direction: column; gap: 10px; }
  #{{ root }} .{{ root }}__eyebrow { margin: 0; font-family: var(--font-heading--family, inherit); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: {{ section.settings.accent_color }}; }
  #{{ root }} .{{ root }}__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-size: clamp(30px, 4.5vw, 52px); font-weight: 800; line-height: 1.05; text-transform: uppercase; color: {{ section.settings.heading_color }}; }
  #{{ root }} .{{ root }}__sub { margin: 0; font-size: 16px; line-height: 1.5; color: {{ section.settings.subtitle_color }}; }

  /* The tab system — radios are visually hidden but keep working */
  #{{ root }} .{{ root }}__radio { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #{{ root }} .{{ root }}__tablist { display: flex; flex-wrap: wrap; justify-content: center; gap: 48px; border-bottom: 1px solid {{ section.settings.tab_line_color }}; padding-top: 8px; margin-bottom: 8px; }
  #{{ root }} .{{ root }}__btn {
    display: inline-block; padding: 12px 4px; margin-bottom: -1px; cursor: pointer; user-select: none;
    font-family: var(--font-heading--family, inherit); font-size: 18px; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase; color: {{ section.settings.tab_inactive_color }};
    border-bottom: 2px solid transparent; transition: color 0.18s, border-color 0.18s;
  }
  #{{ root }} .{{ root }}__btn:hover { color: {{ section.settings.heading_color }}; }
  #{{ root }} .{{ root }}__panel { display: none; padding: 24px 0; }
  #{{ root }} .{{ root }}__panel .rte > * { margin: 0 0 1em; }
  #{{ root }} .{{ root }}__panel .rte > *:last-child { margin-bottom: 0; }
  #{{ root }} .{{ root }}__panel img { max-width: 100%; height: auto; border-radius: 8px; }

  /* Pure-CSS switching: checked radio -> matching label active + matching panel shown.
     Radios, tablist and panels are all direct children of .__tabwrap, so the
     general-sibling combinator (~) reaches both. */
  {% for block in tabs %}
    {% assign n = forloop.index %}
    #{{ root }}-r-{{ n }}:checked ~ .{{ root }}__tablist .{{ root }}__btn--{{ n }} { color: {{ section.settings.accent_color }}; border-bottom-color: {{ section.settings.accent_color }}; }
    #{{ root }}-r-{{ n }}:checked ~ .{{ root }}__panels .{{ root }}__panel--{{ n }} { display: block; }
    #{{ root }}-r-{{ n }}:focus-visible ~ .{{ root }}__tablist .{{ root }}__btn--{{ n }} { outline: 2px solid {{ section.settings.accent_color }}; outline-offset: 4px; }
  {% endfor %}

  #{{ root }} .{{ root }}__footer { display: flex; justify-content: center; margin-top: 36px; }
  #{{ root }} .{{ root }}__cta {
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;
    font-family: var(--font-heading--family, inherit); font-size: 16px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 16px 40px; border-radius: 8px; border: 2px solid {{ section.settings.button_bg }};
    {% if btn_style == 'outline' %}background: transparent; color: {{ section.settings.button_bg }};
    {% elsif btn_style == 'ghost' %}background: transparent; color: {{ section.settings.button_bg }}; border-color: transparent; text-decoration: underline;
    {% else %}background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};{% endif %}
    transition: filter 0.18s;
  }
  #{{ root }} .{{ root }}__cta:hover { filter: brightness(1.1); }

  @media (max-width: 600px) {
    #{{ root }} .{{ root }}__tablist { gap: 22px; }
    #{{ root }} .{{ root }}__btn { font-size: 15px; }
  }
</style>

<section id="{{ root }}" class="color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="{{ root }}__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="{{ root }}__head">
        {%- if section.settings.eyebrow != blank -%}<h4 class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</h4>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="{{ root }}__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="{{ root }}__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if tabs.size > 0 -%}
      <div class="{{ root }}__tabwrap">
        {%- comment -%} 1) Hidden radios — one per tab, the active one checked. {%- endcomment -%}
        {%- for block in tabs -%}
          <input type="radio" class="{{ root }}__radio" name="{{ root }}-state" id="{{ root }}-r-{{ forloop.index }}" {% if forloop.index == active %}checked{% endif %} {{ block.shopify_attributes }}>
        {%- endfor -%}

        {%- comment -%} 2) Tab buttons (labels point at their radio). {%- endcomment -%}
        <div class="{{ root }}__tablist" role="tablist">
          {%- for block in tabs -%}
            <label class="{{ root }}__btn {{ root }}__btn--{{ forloop.index }}" for="{{ root }}-r-{{ forloop.index }}" role="tab">{{ block.settings.tab_label | default: 'Tab' }}</label>
          {%- endfor -%}
        </div>

        {%- comment -%} 3) Panels. {%- endcomment -%}
        <div class="{{ root }}__panels">
          {%- for block in tabs -%}
            <div class="{{ root }}__panel {{ root }}__panel--{{ forloop.index }}" role="tabpanel">
              <div class="rte">{{ block.settings.content }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="{{ root }}__footer">
        <a class="{{ root }}__cta" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}>{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "FTD - Tabbed Content",
  "tag": "section",
  "class": "ftd-tabs-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (H4)", "default": "The Truth" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "Why We Beat The Rest" },
    { "type": "textarea", "id": "subheading", "label": "Description", "default": "Electrolytes don't provide full recovery." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1280 },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "filled",
      "options": [ { "value": "filled", "label": "Filled" }, { "value": "outline", "label": "Outline" }, { "value": "ghost", "label": "Ghost" } ] },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#0A0A0A" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow + active tab)", "default": "#1FA8A1" },
    { "type": "color", "id": "heading_color", "label": "Heading / text", "default": "#0A0A0A" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle", "default": "#444444" },
    { "type": "color", "id": "tab_inactive_color", "label": "Inactive tab", "default": "#888888" },
    { "type": "color", "id": "tab_line_color", "label": "Tab divider line", "default": "#E5E7EB" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Hydration" },
        { "type": "checkbox", "id": "start_active", "label": "Show this tab first", "default": false, "info": "If several are ticked, the first one wins." },
        { "type": "richtext", "id": "content", "label": "Tab content", "default": "<p>Add this tab's content here — text, images, lists, and links.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FTD - Tabbed Content",
      "category": "Fortified Sections",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "Hydration", "start_active": true, "content": "<p><strong>Sodium Citrate</strong> — Essential electrolyte to support fluid balance, hydration, and muscle function.</p>" } },
        { "type": "tab", "settings": { "tab_label": "Performance", "content": "<p><strong>Magnesium Malate</strong> — Supports energy production and reduces cramps during high-intensity workouts.</p>" } }
      ]
    }
  ]
}
{% endschema %}
