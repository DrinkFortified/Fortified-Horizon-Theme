{% comment %}
  Fortified Tabs Section
  ----------------------------------------------------------------------
  A tabbed content section. Each child "fortified-tab-panel" block is
  rendered as one tab. The section auto-generates a button per tab.

  The first panel (or the one with start_active=true) is shown by
  default. Clicking a button hides all panels and shows the matching
  one (matched via block.id).

  Tab panels accept any theme block as their children — drop in native
  group/text/image blocks, or custom blocks (e.g. checkmark-list). So
  one panel can hold any composition the merchant builds.

  No section-level CTA — add a native Button block inside a tab panel
  or in a separate section below if you want a CTA.

  Accessibility:
    - Buttons have role="tab" + aria-selected
    - Panels have role="tabpanel" + aria-labelledby
    - Keyboard arrow navigation between tabs
{% endcomment %}

{% liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign root = 'ft-tabs-' | append: sid
  assign panels = section.blocks | where: 'type', 'fortified-tab-panel'
%}

<style>
  .{{ root }} {
    width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_h }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    color: {{ section.settings.heading_color }};
    background: {{ section.settings.background_color }};
    font-family: var(--font-body--family, inherit);
  }
  .{{ root }}__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    text-align: center;
  }
  .{{ root }}__eyebrow {
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0;
  }
  .{{ root }}__heading {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }
  .{{ root }}__subtitle {
    font-family: var(--font-body--family, inherit);
    font-size: 16px;
    line-height: 1.5;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
  }

  /* Tab button row */
  .{{ root }}__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 48px;
    border-bottom: 1px solid {{ section.settings.tab_line_color }};
    padding: 16px 0 0;
  }
  .{{ root }}__btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 12px 4px;
    margin-bottom: -1px;
    font-family: var(--font-heading--family, inherit);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: {{ section.settings.tab_inactive_color }};
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.18s, border-color 0.18s;
  }
  .{{ root }}__btn[aria-selected="true"] {
    color: {{ section.settings.accent_color }};
    border-bottom-color: {{ section.settings.accent_color }};
  }
  .{{ root }}__btn:focus-visible {
    outline: 2px solid {{ section.settings.accent_color }};
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Panels area */
  .{{ root }}__panels {
    text-align: left;
  }
  .{{ root }}__panels > [role="tabpanel"] {
    display: none;
  }
  .{{ root }}__panels > [role="tabpanel"].is-active {
    display: block;
  }

  @media (max-width: 600px) {
    .{{ root }}__tabs { gap: 24px; }
    .{{ root }}__btn  { font-size: 15px; }
  }
</style>

<section
  id="{{ root }}"
  class="{{ root }}"
  {{ section.shopify_attributes }}
>
  <div class="{{ root }}__inner">

    {% if section.settings.eyebrow != blank %}
      <p class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="{{ root }}__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="{{ root }}__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% if panels.size > 0 %}
      <div class="{{ root }}__tabs" role="tablist" aria-label="{{ section.settings.aria_label | default: 'Information tabs' }}">
        {% for block in panels %}
          <button
            type="button"
            class="{{ root }}__btn"
            role="tab"
            id="{{ root }}-btn-{{ block.id }}"
            data-tab-target="{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="{{ root }}-panel-{{ block.id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          >
            {{ block.settings.tab_label | default: 'Tab' }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="{{ root }}__panels">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById({{ root | json }});
    if (!section) return;

    function init () {
      var buttons = Array.prototype.slice.call(section.querySelectorAll('[role="tab"]'));
      var panels  = Array.prototype.slice.call(section.querySelectorAll('[role="tabpanel"]'));

      if (!buttons.length || !panels.length) return;

      // Ensure exactly one panel starts active.
      var hasActive = panels.some(function (p) { return p.classList.contains('is-active'); });
      if (!hasActive) panels[0].classList.add('is-active');

      function activate (btn) {
        var target = btn.getAttribute('data-tab-target');
        buttons.forEach(function (b) {
          var on = b === btn;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.setAttribute('tabindex', on ? '0' : '-1');
        });
        panels.forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-panel-id') === target);
        });
      }

      buttons.forEach(function (btn) {
        // Avoid double-binding if init runs twice
        if (btn.dataset.tabsBound === '1') return;
        btn.dataset.tabsBound = '1';
        btn.addEventListener('click', function () { activate(btn); });
      });

      section.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        var current = document.activeElement;
        var i = buttons.indexOf(current);
        if (i === -1) return;
        e.preventDefault();
        var next = e.key === 'ArrowRight'
          ? (i + 1) % buttons.length
          : (i - 1 + buttons.length) % buttons.length;
        buttons[next].focus();
        activate(buttons[next]);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Re-init when Shopify re-renders the section in the editor
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.contains(section)) init();
    });
  })();
</script>

{% schema %}
{
  "name": "Tabbed Content",
  "tag": "section",
  "class": "fortified-tabs-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",  "default": "THE TRUTH" },
    { "type": "text",     "id": "heading",  "label": "Heading",  "default": "WHY WE BEAT THE REST ELECTROLYTES" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Electrolytes don't provide full recovery." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color",        "label": "Accent",           "default": "#1FA8A1" },
    { "type": "color", "id": "heading_color",       "label": "Heading",          "default": "#0A0A0A" },
    { "type": "color", "id": "subtitle_color",      "label": "Subtitle",         "default": "#444444" },
    { "type": "color", "id": "tab_inactive_color",  "label": "Inactive tab",     "default": "#888888" },
    { "type": "color", "id": "tab_line_color",      "label": "Tab divider line", "default": "#E5E7EB" },
    { "type": "color", "id": "background_color",    "label": "Background",       "default": "#FFFFFF" },

    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "aria_label", "label": "ARIA label for the tab group", "default": "Information tabs" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width",      "label": "Max width (px)",          "min": 600, "max": 1600, "step": 20, "default": 1200 },
    { "type": "range", "id": "padding_top",    "label": "Padding top (px)",        "min": 0,   "max": 160,  "step": 4,  "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)",     "min": 0,   "max": 160,  "step": 4,  "default": 80 },
    { "type": "range", "id": "padding_h",      "label": "Padding horizontal (px)", "min": 0,   "max": 100,  "step": 4,  "default": 24 }
  ],
  "blocks": [
    { "type": "fortified-tab-panel" }
  ],
  "presets": [
    {
      "name": "Tabbed Content",
      "blocks": [
        {
          "type": "fortified-tab-panel",
          "settings": { "tab_label": "Hydration", "start_active": true },
          "blocks": [
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "settings": { "content_direction": "row", "gap": 24, "vertical_alignment": "center" },
              "blocks": [
                { "type": "image", "settings": { "image_ratio": "square", "width": "fixed", "custom_width": 30 } },
                {
                  "type": "group",
                  "settings": { "content_direction": "column", "gap": 8, "width": "fill" },
                  "blocks": [
                    { "type": "text", "settings": { "text": "<h3>Ingredient name</h3>", "type_preset": "h3" } },
                    { "type": "text", "settings": { "text": "<p>Short description of what this ingredient does.</p>", "type_preset": "rte" } }
                  ]
                }
              ]
            }
          ]
        },
        {
