{% render 'fortified-base' %}

<section
  id="PdpCreatine-{{ section.id }}"
  class="pdp-cr"
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container pdp-cr__grid" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
    <div class="pdp-cr__visual">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image_alt }}" loading="lazy" width="700" height="700">
      {% else %}
        <div class="pdp-cr__canister">
          <div class="pdp-cr__canister-top"></div>
          <div class="pdp-cr__canister-body">
            <span class="pdp-cr__canister-mark">CRE</span>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="pdp-cr__copy">
      <p class="pdp-cr__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pdp-cr__title">{{ section.settings.title }}</h2>
      <p class="pdp-cr__desc">{{ section.settings.desc }}</p>

      <ul class="pdp-cr__bullets">
        {% for block in section.blocks %}
          {% if block.type == 'bullet' %}
            <li style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}><strong>{{ block.settings.label }}</strong> {{ block.settings.body }}</li>
          {% endif %}
        {% endfor %}
      </ul>

      <div class="pdp-cr__pricing" role="radiogroup" aria-label="Creatine purchase option">
        <label class="pdp-cr__opt is-selected">
          <input type="radio" name="pdp-cr-{{ section.id }}" value="bundle" checked>
          <div>
            <div class="pdp-cr__opt-title">{{ section.settings.opt_bundle_title }}</div>
            <div class="pdp-cr__opt-meta">{{ section.settings.opt_bundle_meta }}</div>
          </div>
          <div class="pdp-cr__opt-price"><s>{{ section.settings.opt_bundle_compare }}</s> <strong>FREE</strong></div>
        </label>
        <label class="pdp-cr__opt">
          <input type="radio" name="pdp-cr-{{ section.id }}" value="sub">
          <div>
            <div class="pdp-cr__opt-title">{{ section.settings.opt_sub_title }}</div>
            <div class="pdp-cr__opt-meta">{{ section.settings.opt_sub_meta }}</div>
          </div>
          <div class="pdp-cr__opt-price">{{ section.settings.opt_sub_price }}</div>
        </label>
        <label class="pdp-cr__opt">
          <input type="radio" name="pdp-cr-{{ section.id }}" value="one">
          <div>
            <div class="pdp-cr__opt-title">{{ section.settings.opt_one_title }}</div>
            <div class="pdp-cr__opt-meta">{{ section.settings.opt_one_meta }}</div>
          </div>
          <div class="pdp-cr__opt-price">{{ section.settings.opt_one_price }}</div>
        </label>
      </div>

      <a href="{{ section.settings.cta_url | default: '#PdpHero' }}" class="pdp-cr__cta">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-cr {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
  }
  .pdp-cr__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px;
    align-items: center;
  }
  @media (max-width: 960px) { .pdp-cr__grid { grid-template-columns: 1fr; gap: 32px; } }
  .pdp-cr__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border-radius: 14px;
    overflow: hidden;
    min-height: 360px;
  }
  .pdp-cr__visual img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pdp-cr__canister { width: 220px; }
  .pdp-cr__canister-top {
    width: 100%; height: 30px;
    background: var(--color-foreground);
    border-radius: 14px 14px 4px 4px;
  }
  .pdp-cr__canister-body {
    background: var(--color-background);
    border: 1.5px solid var(--color-foreground);
    border-top: 0;
    padding: 60px 16px;
    text-align: center;
    border-radius: 0 0 14px 14px;
  }
  .pdp-cr__canister-mark {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 48px;
    letter-spacing: -0.03em;
  }
  .pdp-cr__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pdp-cr__eyebrow {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--fortified-accent);
    margin: 0;
  }
  .pdp-cr__title {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 62px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }
  .pdp-cr__desc {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .pdp-cr__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pdp-cr__bullets li {
    position: relative;
    padding-left: 28px;
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: var(--color-foreground);
  }
  .pdp-cr__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4em;
    width: 14px; height: 9px;
    background: var(--fortified-accent);
    clip-path: polygon(0 50%, 38% 100%, 100% 0, 100% 18%, 38% 100%, 0 68%);
  }
  .pdp-cr__pricing {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pdp-cr__opt {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: 14px;
    cursor: pointer;
    align-items: center;
    position: relative;
    background: var(--color-background);
  }
  .pdp-cr__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .pdp-cr__opt.is-selected {
    border-color: var(--fortified-accent);
    border-width: 2px;
    background: color-mix(in srgb, var(--fortified-accent) 6%, var(--color-background));
  }
  .pdp-cr__opt-title {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  .pdp-cr__opt-meta {
    font-family: var(--font-fortified-body);
    font-size: 16px;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    margin-top: 4px;
  }
  .pdp-cr__opt-price {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.03em;
    text-align: right;
    color: var(--color-foreground);
  }
  .pdp-cr__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 350px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity .15s ease;
  }
  .pdp-cr__cta:hover { opacity: 0.92; }
{% endstylesheet %}

<script>
  (function() {
    var root = document.getElementById('PdpCreatine-{{ section.id }}');
    if (!root) return;
    var opts = root.querySelectorAll('.pdp-cr__opt');
    opts.forEach(function(o) {
      o.addEventListener('click', function() {
        opts.forEach(function(x){ x.classList.remove('is-selected'); var i = x.querySelector('input'); if(i) i.checked = false; });
        o.classList.add('is-selected');
        var i = o.querySelector('input'); if(i) i.checked = true;
      });
    });
  })();
</script>

