{% comment %}
  Section: FTD - Truth
  Category: Fortified Sections
  ----------------------------------------------------------------------
  A "The Truth" feature-cards section. The OUTER section spans full width
  and uses the section color scheme (default scheme-1 / white), so the
  area outside the page width shows the page background. The INNER box is
  constrained to page width (content_max_width), uses its own color scheme
  (default scheme-2 / dark), and holds the eyebrow + heading + subheading,
  a grid of tall cover-image cards, and a CTA.

  Colors are driven by the color schemes (--color-background,
  --color-foreground, --color-foreground-heading, --color-primary) so
  designers/developers can restyle via standard Shopify schemes. Each
  color setting is an OPTIONAL override: leave blank to inherit the scheme.

  Cards are classic section blocks (addable / reorderable). Each card
  fills a fixed-height area (object-fit: cover) so images never collapse.
  Desktop = N-column grid; mobile (<=749px) = single stacked column.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'fttc-' | append: sid
  assign cols = section.settings.columns_desktop
  assign eyebrow_c = section.settings.eyebrow_color | default: 'var(--color-primary)'
  assign heading_c = section.settings.heading_color | default: 'var(--color-foreground-heading)'
  assign text_c    = section.settings.text_color    | default: 'var(--color-foreground)'
  assign button_c  = section.settings.button_color  | default: 'var(--color-foreground)'
  assign label_c   = section.settings.card_label_color   | default: '#FFFFFF'
  assign caption_c = section.settings.card_caption_color | default: '#E6E6E6'
-%}

<style>
  #{{ root }} {
    background: var(--color-background, #ffffff);
  }

  /* Page-width dark content box */
  #{{ root }} .{{ root }}__inner {
    position: relative;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    background: var(--color-background, #0E0E0E);
    color: {{ text_c }};
    border-radius: {{ section.settings.content_radius }}px;
    padding: {{ section.settings.content_padding }}px;
    overflow: hidden;
  }
  #{{ root }} .{{ root }}__bgtex {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }
  #{{ root }} .{{ root }}__content { position: relative; z-index: 1; }

  /* Header */
  #{{ root }} .{{ root }}__head {
    text-align: center;
    margin: 0 auto 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  #{{ root }} .{{ root }}__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ eyebrow_c }};
  }
  #{{ root }} .{{ root }}__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(30px, 4.8vw, 56px);
    font-weight: 800;
    line-height: 1.04;
    text-transform: uppercase;
    color: {{ heading_c }};
  }
  #{{ root }} .{{ root }}__sub {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.55;
    color: {{ text_c }};
  }

  /* Grid */
  #{{ root }} .{{ root }}__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    align-items: stretch;
    gap: {{ section.settings.gap }}px;
  }

  /* Card */
  #{{ root }} .{{ root }}-card {
    position: relative;
    display: block;
    width: 100%;
    height: {{ section.settings.card_height }}px;
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.card_bg }};
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
  }
  #{{ root }} .{{ root }}-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #{{ root }} .{{ root }}-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.35) 42%, rgba(0,0,0,0) 70%);
    z-index: 1;
  }
  #{{ root }} .{{ root }}-card__content {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  #{{ root }} .{{ root }}-card__icon {
    flex: 0 0 auto;
    display: inline-flex;
    color: {{ label_c }};
    margin-top: 2px;
  }
  #{{ root }} .{{ root }}-card__icon svg { display: block; }
  #{{ root }} .{{ root }}-card__icon img { width: 28px; height: 28px; object-fit: contain; display: block; }
  #{{ root }} .{{ root }}-card__text { min-width: 0; }
  #{{ root }} .{{ root }}-card__label {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
    color: {{ label_c }};
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  }
  #{{ root }} .{{ root }}-card__caption {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.4;
    color: {{ caption_c }};
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }

  /* Footer button */
  #{{ root }} .{{ root }}__footer { display: flex; justify-content: center; margin-top: 40px; }
  #{{ root }} .{{ root }}__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family, inherit);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 38px;
    border-radius: 6px;
    cursor: pointer;
    border: 2px solid {{ button_c }};
    transition: background 0.18s, color 0.18s, opacity 0.18s;
  }
  #{{ root }} .{{ root }}__cta--outline { background: transparent; color: {{ button_c }}; }
  #{{ root }} .{{ root }}__cta--outline:hover { background: {{ button_c }}; color: var(--color-background, #0E0E0E); }
  #{{ root }} .{{ root }}__cta--filled { background: {{ button_c }}; color: var(--color-background, #0E0E0E); }
  #{{ root }} .{{ root }}__cta--filled:hover { opacity: 0.88; }

  /* Mobile: single stacked column */
  @media (max-width: 749px) {
    #{{ root }} .{{ root }}__grid { grid-template-columns: minmax(0, 1fr); }
    #{{ root }} .{{ root }}-card { height: {{ section.settings.card_height_mobile }}px; }
    #{{ root }} .{{ root }}__inner { padding: {{ section.settings.content_padding | times: 0.6 | round }}px; }
  }

  [hidden]{display:none!important}
  {{ section.settings.custom_css }}
</style>

{%- assign bg_tex = section.settings.background_image -%}
{%- assign cta_class = root | append: '__cta--' | append: section.settings.button_style -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="{{ root }}"
  class="ftd-truth section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="{{ root }}__inner color-{{ section.settings.content_color_scheme }}">

    {%- if bg_tex != blank -%}
      {%- assign bg_tex_url = bg_tex | image_url: width: 1600 -%}
      <div class="{{ root }}__bgtex" style="background-image:url('{{ bg_tex_url }}')" aria-hidden="true"></div>
    {%- endif -%}

    <div class="{{ root }}__content">

      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="{{ root }}__head">
          {%- if section.settings.eyebrow != blank -%}<p class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="{{ root }}__heading">{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="{{ root }}__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="{{ root }}__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            {%- assign card_tag = 'a' -%}
          {%- else -%}
            {%- assign card_tag = 'div' -%}
          {%- endif -%}
          {%- assign img_class = root | append: '-card__img' -%}
          <{{ card_tag }} class="{{ root }}-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: class: img_class, loading: 'lazy', widths: '300,500,700,900,1100', alt: block.settings.category }}
            {%- endif -%}

            <div class="{{ root }}-card__overlay" aria-hidden="true"></div>

            <div class="{{ root }}-card__content">
              <span class="{{ root }}-card__icon">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,80', alt: '' }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3Z" opacity=".95"/><path d="M12.7 7.5 9 13h2.3l-.6 4 3.6-5.6H12l.7-3.9Z" fill="#0E0E0E"/></svg>
                {%- endif -%}
              </span>
              <span class="{{ root }}-card__text">
                {%- if block.settings.category != blank -%}<p class="{{ root }}-card__label">{{ block.settings.category }}</p>{%- endif -%}
                {%- if block.settings.caption != blank -%}<p class="{{ root }}-card__caption">{{ block.settings.caption }}</p>{%- endif -%}
              </span>
            </div>
          </{{ card_tag }}>
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="{{ root }}__footer">
          <a class="{{ root }}__cta {{ cta_class }}" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}>{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "FTD - Truth",
  "tag": "section",
  "class": "ftd-truth-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Truth" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "More Than Hydration Its Daily Support" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Electrolytes don't provide full recovery. UNDO Regenerate combines hydration." },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore All Flavors" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "outline", "options": [ { "value": "outline", "label": "Outline (ghost)" }, { "value": "filled", "label": "Filled" } ] },

    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "card_height", "label": "Card height", "min": 240, "max": 640, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "card_height_mobile", "label": "Card height (mobile)", "min": 220, "max": 560, "step": 10, "unit": "px", "default": 360 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "corner_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "color", "id": "card_bg", "label": "Card background (no image)", "default": "#1A1A1A" },

    { "type": "header", "content": "Content box" },
    { "type": "paragraph", "content": "The dark box is constrained to this width; the area outside it shows the section background (white)." },
    { "type": "range", "id": "content_max_width", "label": "Content width (page width)", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "content_padding", "label": "Inner padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "content_radius", "label": "Box corner radius", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 28 },
    { "type": "color_scheme", "id": "content_color_scheme", "label": "Content box color scheme", "default": "scheme-2" },
    { "type": "image_picker", "id": "background_image", "label": "Content background texture", "info": "Optional. Layered inside the box at low opacity." },

    { "type": "header", "content": "Colors" },
    { "type": "paragraph", "content": "Leave a color blank to inherit it from the color scheme." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section color scheme (outside the box)", "default": "scheme-1" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#9DBE5B" },
    { "type": "color", "id": "heading_color", "label": "Heading" },
    { "type": "color", "id": "text_color", "label": "Body text" },
    { "type": "color", "id": "card_label_color", "label": "Card label", "default": "#FFFFFF" },
    { "type": "color", "id": "card_caption_color", "label": "Card caption", "default": "#E6E6E6" },
    { "type": "color", "id": "button_color", "label": "Button" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "full-width", "options": [ { "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" } ] },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 72 },

    { "type": "header", "content": "Advanced" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "info": "Targets this section." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Tall portrait image. Fills the card (cover)." },
        { "type": "text", "id": "category", "label": "Category label", "default": "+ ENERGY" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Electrolytes don't provide full recovery." },
        { "type": "image_picker", "id": "icon", "label": "Icon override", "info": "Optional. Defaults to a shield + bolt icon." },
        { "type": "url", "id": "link", "label": "Card link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FTD - Truth",
      "category": "Fortified Sections",
      "blocks": [
        { "type": "card", "settings": { "category": "+ ENERGY", "caption": "Electrolytes don't provide full recovery." } },
        { "type": "card", "settings": { "category": "+ PERFORMANCE", "caption": "Electrolytes don't provide full recovery." } },
        { "type": "card", "settings": { "category": "+ HYDRATION", "caption": "Electrolytes don't provide full recovery." } },
        { "type": "card", "settings": { "category": "+ FOCUS", "caption": "Electrolytes don't provide full recovery." } }
      ]
    }
  ]
}
{% endschema %}
