      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "card_accent_color",
      "label": "Card accent color",
      "default": "#1FA8A1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
