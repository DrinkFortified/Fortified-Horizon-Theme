{% comment %}
  Section: FTD-B - Benefits
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Header (eyebrow + heading with optional emphasized word + lead) above a
  responsive grid of benefit cards. Each card has a top accent stripe,
  optional icon image (or emoji fallback), title, description, citation.

  Desktop: N-column grid. Mobile (<=749px): 1 column.

  Stable class prefix: ftbbn
{% endcomment %}

{%- liquid
  assign heading_html = section.settings.heading
  assign emphasis_word = section.settings.heading_emphasis_word
  if heading_html != blank and emphasis_word != blank
    assign em_open = '<em class="ftbbn__em">'
    assign em_close = '</em>'
    assign emphasized = em_open | append: emphasis_word | append: em_close
    assign heading_html = heading_html | replace_first: emphasis_word, emphasized
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="ftbbn section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %} --ftbbn-max-w: {{ section.settings.content_max_width }}px; --ftbbn-eyebrow: {{ section.settings.eyebrow_color }}; --ftbbn-accent: {{ section.settings.card_accent_color }}; --ftbbn-accent-top: {{ section.settings.card_accent_top_thickness }}px; --ftbbn-radius: {{ section.settings.card_radius }}px; --ftbbn-cols: {{ section.settings.desktop_columns }};"
  {{ section.shopify_attributes }}
>
  <div class="ftbbn__inner">

    {%- if section.settings.eyebrow != blank or heading_html != blank or section.settings.body != blank -%}
      <div class="ftbbn__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ftbbn__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if heading_html != blank -%}
          <h2 class="ftbbn__heading">{{ heading_html | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="ftbbn__body">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ftbbn__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <article class="ftbbn-card" {{ block.shopify_attributes }}>
              <span class="ftbbn-card__stripe" aria-hidden="true"></span>
              <div class="ftbbn-card__icon">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48,96,144', alt: block.settings.title }}
                {%- elsif block.settings.icon_emoji != blank -%}
                  <span class="ftbbn-card__emoji" aria-hidden="true">{{ block.settings.icon_emoji }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="ftbbn-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ftbbn-card__desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.citation != blank -%}
                <p class="ftbbn-card__cite">{{ block.settings.citation }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.ftbbn {
  display: block;
}

.ftbbn__inner {
  max-width: var(--ftbbn-max-w, 1240px);
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 40px);
}

.ftbbn__head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  margin: 0 0 clamp(28px, 4vw, 48px);
  max-width: 820px;
}

.ftbbn__eyebrow {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ftbbn-eyebrow, var(--color-foreground));
}

.ftbbn__heading {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: clamp(28px, 4.4vw, 52px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--color-foreground);
}

.ftbbn__em {
  color: var(--ftbbn-accent, var(--color-foreground));
  font-style: italic;
}

.ftbbn__body {
  margin: 0;
  font-size: 16px;
  line-height: 1.6;
  color: var(--color-foreground);
  opacity: 0.78;
  max-width: 70ch;
}

.ftbbn__grid {
  display: grid;
  grid-template-columns: repeat(var(--ftbbn-cols, 3), minmax(0, 1fr));
  gap: clamp(16px, 2vw, 24px);
}

.ftbbn-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 28px 24px 26px;
  background: var(--color-background);
  color: var(--color-foreground);
  border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  border-radius: var(--ftbbn-radius, 12px);
  overflow: hidden;
}

.ftbbn-card__stripe {
  position: absolute;
  inset: 0 0 auto 0;
  height: var(--ftbbn-accent-top, 3px);
  background: var(--ftbbn-accent, #1FA8A1);
  display: block;
}

.ftbbn-card__icon {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 44px;
  height: 44px;
}

.ftbbn-card__icon img {
  width: 44px;
  height: 44px;
  object-fit: contain;
  display: block;
}

.ftbbn-card__emoji {
  font-size: 30px;
  line-height: 1;
}

.ftbbn-card__title {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: 18px;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  color: var(--color-foreground);
}

.ftbbn-card__desc {
  margin: 0;
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--color-foreground);
  opacity: 0.82;
}

.ftbbn-card__cite {
  margin: 6px 0 0;
  font-size: 12px;
  line-height: 1.4;
  color: var(--color-foreground);
  opacity: 0.6;
  font-style: italic;
  border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  padding-top: 12px;
}

@media (max-width: 749px) {
  .ftbbn__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .ftbbn-card {
    padding: 24px 20px 22px;
  }
}

[hidden] { display: none !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "FTD-B - Benefits",
  "tag": "section",
  "class": "ftd-b-benefits-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Fortified Energy"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#1FA8A1"
    },
    {
      "type": "textarea",
      "id": "heading",
