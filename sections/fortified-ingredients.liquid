{% comment %}
  Section: FTD - Ingredients
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Heading area, a grid (or mobile carousel) of ingredient cards, and a
  centered CTA button.
{% endcomment %}

{%- liquid
  assign sid  = section.id | replace: '_', '' | downcase
  assign root = 'ftin-' | append: sid
  assign cols = section.settings.desktop_columns
  assign gap  = section.settings.card_gap
  assign radius = section.settings.card_radius
  assign cta_style = section.settings.cta_style | default: 'filled'
  assign mobile_layout = section.settings.mobile_layout | default: 'carousel'
-%}

<style>
  #{{ root }} {
    --{{ root }}-max-w: {{ section.settings.content_max_width }}px;
    --{{ root }}-accent: {{ section.settings.eyebrow_color }};
  }
  #{{ root }} .{{ root }}__inner {
    max-width: var(--{{ root }}-max-w);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  #{{ root }} .{{ root }}__head {
    text-align: center;
    margin: 0 auto 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 720px;
  }
  #{{ root }} .{{ root }}__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--{{ root }}-accent);
  }
  #{{ root }} .{{ root }}__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(28px, 4.4vw, 52px);
    font-weight: 800;
    line-height: 1.04;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-foreground, inherit);
  }
  #{{ root }} .{{ root }}__sub {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    opacity: 0.78;
  }

  #{{ root }} .{{ root }}__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: {{ gap }}px;
  }

  #{{ root }} .{{ root }}-card {
    display: flex;
    flex-direction: column;
    background: var(--color-background, #FFFFFF);
    border-radius: {{ radius }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(0,0,0,0.06);
  }
  #{{ root }} .{{ root }}-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #0E0E0E;
  }
  #{{ root }} .{{ root }}-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #{{ root }} .{{ root }}-card__body {
    padding: 22px 20px 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  #{{ root }} .{{ root }}-card__name {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  #{{ root }} .{{ root }}-card__desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    opacity: 0.72;
    max-width: 30ch;
  }
  #{{ root }} .{{ root }}-card__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 8px 18px;
    border-radius: 999px;
    font-family: var(--font-heading--family, inherit);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    text-decoration: none;
  }

  #{{ root }} .{{ root }}__footer {
    display: flex;
    justify-content: center;
    margin-top: 44px;
  }
  #{{ root }} .{{ root }}__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family, inherit);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 40px;
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    border: 2px solid var(--color-foreground, #0E0E0E);
    cursor: pointer;
    transition: opacity 0.18s, background 0.18s, color 0.18s;
  }
  #{{ root }} .{{ root }}__cta--filled  { background: var(--color-foreground, #0E0E0E); color: var(--color-background, #FFFFFF); }
  #{{ root }} .{{ root }}__cta--filled:hover { opacity: 0.88; }
  #{{ root }} .{{ root }}__cta--outline { background: transparent; color: var(--color-foreground, #0E0E0E); }
  #{{ root }} .{{ root }}__cta--outline:hover { background: var(--color-foreground, #0E0E0E); color: var(--color-background, #FFFFFF); }

  @media (max-width: 749px) {
    {%- if mobile_layout == 'carousel' -%}
    #{{ root }} .{{ root }}__grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding: 4px 4px 16px;
      margin: 0 -24px;
      padding-left: 24px;
      padding-right: 24px;
      scrollbar-width: none;
    }
    #{{ root }} .{{ root }}__grid::-webkit-scrollbar { display: none; }
    #{{ root }} .{{ root }}-card {
      flex: 0 0 78%;
      min-width: 78%;
      scroll-snap-align: center;
    }
    {%- else -%}
    #{{ root }} .{{ root }}__grid { grid-template-columns: minmax(0, 1fr); }
    {%- endif -%}
  }

  [hidden]{display:none!important}
  {{ section.settings.custom_css }}
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="{{ root }}"
  class="{{ root }}__section section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="{{ root }}__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="{{ root }}__head">
        {%- if section.settings.eyebrow != blank -%}<p class="{{ root }}__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="{{ root }}__heading">{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="{{ root }}__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="{{ root }}__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ingredient' -%}
          {%- if block.settings.link != blank -%}
            {%- assign card_tag = 'a' -%}
          {%- else -%}
            {%- assign card_tag = 'div' -%}
          {%- endif -%}
          {%- assign img_alt = block.settings.name | default: '' -%}
          <{{ card_tag }} class="{{ root }}-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            <div class="{{ root }}-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,700,900', alt: img_alt }}
              {%- endif -%}
            </div>
            <div class="{{ root }}-card__body">
              {%- if block.settings.name != blank -%}
                <h3 class="{{ root }}-card__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="{{ root }}-card__desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.tag_label != blank -%}
                <span class="{{ root }}-card__tag" style="color: {{ block.settings.tag_color }};">{{ block.settings.tag_label }}</span>
              {%- endif -%}
            </div>
          </{{ card_tag }}>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="{{ root }}__footer">
        <a
          class="{{ root }}__cta {{ root }}__cta--{{ cta_style }}"
          {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% else %}href="#" role="button"{% endif %}
        >{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "FTD - Ingredients",
  "tag": "section",
  "class": "ftd-ingredients-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#1FA8A1"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Beat The Rest Electrolytes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Electrolytes don't provide full recovery."
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "carousel",
      "options": [
        {
          "value": "carousel",
          "label": "Horizontal carousel"
        },
        {
          "value": "grid",
          "label": "Stacked grid"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Fortified Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "default": "filled",
      "options": [
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full-width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "t:content.advanced"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Targets this section."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sodium Citrate"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Essential electrolyte to support fluid balance, hydration, and muscle function."
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Tag label",
          "default": "Hydration"
        },
        {
          "type": "color",
          "id": "tag_color",
          "label": "Tag color",
          "default": "#0A0A0A"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link",
          "info": "Optional. Wraps the whole card."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FTD - Ingredients",
      "category": "Fortified",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Sodium Citrate",
            "tag_label": "Hydration"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Magnesium Glycinate",
            "tag_label": "Recovery"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Potassium",
            "tag_label": "Performance"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Vitamin C",
            "tag_label": "Immunity"
          }
        }
      ]
    }
  ]
}
{% endschema %}
