{% render 'fortified-base' %}

{%- liquid
  assign p = section.settings.product
-%}

<section
  id="FortifiedFeaturedProductCard-{{ section.id }}"
  class="fortified-featured-card color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-featured-card__inner">
    <div class="fortified-featured-card__media">
      {% if p != blank and p.featured_image != blank %}
        {{ p.featured_image | image_url: width: 1200 | image_tag:
            widths: '500, 800, 1200',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'fortified-featured-card__img',
            alt: p.title,
            loading: 'lazy' }}
      {% endif %}
      {% if section.settings.badge_text != blank %}
        <span class="fortified-badge fortified-badge--dark fortified-featured-card__doctor">{{ section.settings.badge_text }}</span>
      {% endif %}
      {% if section.settings.show_rating %}
        <div class="fortified-featured-card__rating">
          <span class="fortified-featured-card__stars">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}
    </div>

    <div class="fortified-featured-card__body">
      {% if section.settings.bestseller %}
        <span class="fortified-badge fortified-badge--teal">BESTSELLER</span>
      {% endif %}
      <h2 class="fortified-heading fortified-h2">{{ p.title | default: section.settings.fallback_title }}</h2>
      <div class="fortified-featured-card__prices">
        {% if section.settings.sale_label != blank %}
          <span class="fortified-featured-card__sale">{{ section.settings.sale_label }}</span>
        {% endif %}
        {% if section.settings.regular_price_label != blank %}
          <span class="fortified-featured-card__regular">{{ section.settings.regular_price_label }}</span>
        {% endif %}
      </div>
      <ul class="fortified-checklist">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-include-item' %}
            <li style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
      <a href="{{ section.settings.cta_url | default: p.url | default: '#' }}" class="fortified-btn fortified-btn--primary fortified-featured-card__cta">{{ section.settings.cta_label | default: "SHOP FORTIFIED" }}</a>
      {% if section.settings.trust_line != blank %}
        <p class="fortified-featured-card__trust">{{ section.settings.trust_line }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-featured-card {
    background: var(--color-background, var(--fortified-off-white, #F4EEE7));
    overflow: hidden;
  }
  .fortified-featured-card__inner {
    background: #fff;
    border: 1px solid var(--fortified-gray-light);
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 750px) {
    .fortified-featured-card__inner { grid-template-columns: 1fr 1.1fr; align-items: stretch; }
  }
  .fortified-featured-card__media {
    background: linear-gradient(135deg, #F4EEE7 0%, #E5D9C5 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    position: relative;
    min-height: 280px;
  }
  .fortified-featured-card__badge {
    position: absolute;
    top: 14px; left: 14px;
    background: var(--color-background, #0A0A0A);
    color: var(--color-foreground, #fff);
    font-family: var(--font-fortified-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }
  .fortified-featured-card__product-img {
    max-width: 240px;
    max-height: 320px;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(0,0,0,0.12));
  }
  .fortified-featured-card__body {
    padding: clamp(20px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fortified-featured-card__rating {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--fortified-gray-mid);
  }
  .fortified-featured-card__stars { color: #F2A93B; letter-spacing: 2px; }
  .fortified-featured-card__title {
    font-family: var(--font-fortified-display);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--color-foreground, #0A0A0A);
  }
  .fortified-featured-card__price-row {
    display: flex; align-items: baseline; gap: 10px;
  }
  .fortified-featured-card__sale {
    font-family: var(--font-fortified-display);
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    color: var(--color-foreground, #0A0A0A);
    line-height: 1;
  }
  .fortified-featured-card__regular {
    font-size: 14px;
    color: var(--fortified-gray-mid);
    text-decoration: line-through;
  }
  .fortified-featured-card__tags {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-top: 2px;
  }
  .fortified-featured-card__tag {
    display: inline-flex; align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background: #F4EEE7;
    color: var(--color-foreground, #0A0A0A);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .fortified-featured-card__cta {
    background: var(--color-background, #0A0A0A);
    color: var(--color-foreground, #fff);
    width: 100%;
    margin-top: 6px;
    border-radius: 999px;
    padding: 14px 24px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    transition: transform .15s ease, opacity .15s ease;
    display: inline-block;
  }
  .fortified-featured-card__cta:hover { transform: translateY(-1px); opacity: .92; }
  .fortified-featured-card__trust {
    font-size: 11px;
    color: var(--fortified-gray-mid);
    margin-top: 4px;
    display: flex; align-items: center; gap: 6px;
  }
  .fortified-featured-card__trust::before {
    content: '★';
    color: var(--fortified-success);
    font-size: 12px;
  }
{% endstylesheet %}

{% schema %}
{
