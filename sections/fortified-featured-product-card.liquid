{% render 'fortified-base' %}

{%- liquid
  assign p = section.settings.product
-%}

<section
  id="FortifiedFeaturedProductCard-{{ section.id }}"
  class="fortified-featured-card color-{{ section.settings.color_scheme }}"
>
  <div class="fortified-container fortified-featured-card__inner">
    <div class="fortified-featured-card__media">
      {% if p != blank and p.featured_image != blank %}
        {{ p.featured_image | image_url: width: 1200 | image_tag:
            widths: '500, 800, 1200',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'fortified-featured-card__img',
            alt: p.title,
            loading: 'lazy' }}
      {% endif %}
      {% if section.settings.badge_text != blank %}
        <span class="fortified-badge fortified-badge--dark fortified-featured-card__doctor">{{ section.settings.badge_text }}</span>
      {% endif %}
      {% if section.settings.show_rating %}
        <div class="fortified-featured-card__rating">
          <span class="fortified-featured-card__stars">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}
    </div>

    <div class="fortified-featured-card__body">
      {% if section.settings.bestseller %}
        <span class="fortified-badge fortified-badge--teal">BESTSELLER</span>
      {% endif %}
      <h2 class="fortified-heading fortified-h2">{{ p.title | default: section.settings.fallback_title }}</h2>
      <div class="fortified-featured-card__prices">
        {% if section.settings.sale_label != blank %}
          <span class="fortified-featured-card__sale">{{ section.settings.sale_label }}</span>
        {% endif %}
        {% if section.settings.regular_price_label != blank %}
          <span class="fortified-featured-card__regular">{{ section.settings.regular_price_label }}</span>
        {% endif %}
      </div>
      <ul class="fortified-checklist">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-include-item' %}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
      <a href="{{ section.settings.cta_url | default: p.url | default: '#' }}" class="fortified-btn fortified-btn--primary fortified-featured-card__cta">{{ section.settings.cta_label | default: "SHOP FORTIFIED" }}</a>
      {% if section.settings.trust_line != blank %}
        <p class="fortified-featured-card__trust">{{ section.settings.trust_line }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-featured-card {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-featured-card__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 56px);
    align-items: center;
    background: var(--fortified-off-white);
    border-radius: 24px;
    padding: clamp(16px, 2vw, 32px);
  }
  @media (min-width: 750px) {
    .fortified-featured-card__inner { grid-template-columns: 1fr 1fr; }
  }
  .fortified-featured-card__media { position: relative; }
  .fortified-featured-card__img { width: 100%; height: auto; border-radius: 16px; display: block; }
  .fortified-featured-card__doctor {
    position: absolute;
    top: 14px;
    left: 14px;
  }
  .fortified-featured-card__rating {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background: rgb(255 255 255 / .92);
    color: var(--fortified-black);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .fortified-featured-card__stars { color: var(--fortified-gold); }
  .fortified-featured-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .fortified-featured-card__prices { display: flex; align-items: baseline; gap: 12px; }
  .fortified-featured-card__sale {
    font-family: var(--font-fortified-display);
    font-size: clamp(28px, 3.5vw, 40px);
    color: var(--fortified-teal);
  }
  .fortified-featured-card__regular {
    font-size: 16px;
    text-decoration: line-through;
    opacity: .55;
  }
  .fortified-featured-card__cta { margin-top: 4px; }
  .fortified-featured-card__trust {
    font-size: 12px;
    color: var(--fortified-gray-mid);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "15 — Featured Product Card",
  "tag": "section",
  "class": "fortified-featured-card-section",
  "max_blocks": 6,
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "EVERYDAY HYDRATION" },
    { "type": "text", "id": "badge_text", "label": "Top-left badge", "default": "DOCTOR RECOMMENDED" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating overlay", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 stars / 4.6k reviews" },
    { "type": "checkbox", "id": "bestseller", "label": "Show bestseller badge", "default": true },
    { "type": "text", "id": "sale_label", "label": "Sale price label", "default": "$1.99" },
    { "type": "text", "id": "regular_price_label", "label": "Regular price label", "default": "$9.97" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "SHOP FORTIFIED" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "Fast shipping within US (1 to 4 days)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "fortified-include-item",
      "name": "Included item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Energy Hydration Stick — Salty Orange" }
      ]
    }
  ],
  "presets": [
    {
      "name": "15 — Featured Product Card",
      "category": "Fortified",
      "blocks": [
        { "type": "fortified-include-item", "settings": { "text": "Energy Hydration Stick — Salty Orange K2" } },
        { "type": "fortified-include-item", "settings": { "text": "Energy Hydration Stick — Salty Palau K2" } },
        { "type": "fortified-include-item", "settings": { "text": "Free USA Shipping" } },
        { "type": "fortified-include-item", "settings": { "text": "Money-Back Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
