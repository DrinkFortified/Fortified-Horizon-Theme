{% render 'fortified-base' %}

{%- liquid
  assign p = section.settings.product
-%}

<section
  id="FortifiedFeaturedProductCard-{{ section.id }}"
  class="fortified-featured-card color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 80 }}px {{ section.settings['padding-block-end'] | default: 80 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 40 }}px {{ section.settings['padding-inline-end'] | default: 40 }}px;"
>
  <div class="fortified-featured-card__inner">
    <div class="fortified-featured-card__media">
      {%- assign hero_image = section.settings.image -%}
      {%- if hero_image == blank and p != blank -%}
        {%- assign hero_image = p.featured_image -%}
      {%- endif -%}
      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 1400 | image_tag:
            widths: '500, 800, 1200, 1400',
            sizes: '(min-width: 990px) 694px, 100vw',
            class: 'fortified-featured-card__img',
            alt: hero_image.alt | default: section.settings.heading,
            loading: 'lazy' }}
      {% else %}
        <div class="fortified-featured-card__placeholder"></div>
      {% endif %}
    </div>

    <div class="fortified-featured-card__panel">
      <div class="fortified-featured-card__top">
        {% if section.settings.badge_label != blank %}
          <span class="fortified-featured-card__badge">{{ section.settings.badge_label }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="fortified-featured-card__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h2>
        {% endif %}
        <div class="fortified-featured-card__price">
          {% if section.settings.price_caption != blank %}
            <p class="fortified-featured-card__price-caption">{% render 'fortified-accent-text', text: section.settings.price_caption %}</p>
          {% endif %}
          <div class="fortified-featured-card__price-row">
            {% if section.settings.price != blank %}
              <p class="fortified-featured-card__price-amount">{{ section.settings.price }}</p>
            {% endif %}
            {% if section.settings.price_compare != blank %}
              <p class="fortified-featured-card__price-compare">{{ section.settings.price_compare }}</p>
            {% endif %}
          </div>
        </div>
      </div>

      <ul class="fortified-featured-card__includes">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-include-item' %}
            <li {{ block.shopify_attributes }}>
              <span class="fortified-featured-card__icon" aria-hidden="true">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 104 | image_tag:
                      widths: '52, 104',
                      sizes: '52px',
                      alt: '',
                      loading: 'lazy' }}
                {% else %}✓{% endif %}
              </span>
              <div class="fortified-featured-card__icon-text">
                <p class="fortified-featured-card__icon-title">{% render 'fortified-accent-text', text: block.settings.title %}</p>
                {% if block.settings.body != blank %}
                  <p class="fortified-featured-card__icon-body">{% render 'fortified-accent-text', text: block.settings.body %}</p>
                {% endif %}
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      <div class="fortified-featured-card__divider" aria-hidden="true"></div>

      <div class="fortified-featured-card__cta-wrap">
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_url | default: p.url | default: '#' }}" class="fortified-featured-card__cta">{{ section.settings.cta_label }}</a>
        {% endif %}
        {% if section.settings.shipping_note != blank %}
          <p class="fortified-featured-card__shipping">{% render 'fortified-accent-text', text: section.settings.shipping_note %}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-featured-card {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-featured-card__inner {
    display: flex;
    gap: 52px;
    align-items: stretch;
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
  }
  .fortified-featured-card__media {
    flex: 0 0 694px;
    width: 694px;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }
  .fortified-featured-card__img,
  .fortified-featured-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fortified-featured-card__panel {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    color: var(--color-foreground);
  }
  .fortified-featured-card__top {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fortified-featured-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 18px 32px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    font-family: var(--font-fortified-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-transform: uppercase;
    align-self: flex-start;
  }
  .fortified-featured-card__heading {
    font-family: var(--font-fortified-display);
    font-size: 58px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-featured-card__price {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fortified-featured-card__price-caption {
    font-family: var(--font-fortified-body);
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    margin: 0;
  }
  .fortified-featured-card__price-row {
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }
  .fortified-featured-card__price-amount {
    font-family: var(--font-fortified-display);
    font-size: 42px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
    text-transform: capitalize;
  }
  .fortified-featured-card__price-compare {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    text-decoration: line-through;
    margin: 0;
  }

  .fortified-featured-card__includes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .fortified-featured-card__includes li {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .fortified-featured-card__icon {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fortified-accent) 18%, transparent);
    color: var(--fortified-accent);
    font-size: 22px;
    font-weight: 700;
  }
  .fortified-featured-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }
  .fortified-featured-card__icon-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fortified-featured-card__icon-title {
    font-family: var(--font-fortified-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: capitalize;
    margin: 0;
  }
  .fortified-featured-card__icon-body {
    font-family: var(--font-fortified-body);
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    margin: 0;
  }

  .fortified-featured-card__divider {
    height: 1px;
    background: color-mix(in srgb, var(--color-foreground) 18%, transparent);
    width: 100%;
  }
  .fortified-featured-card__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .fortified-featured-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    box-sizing: border-box;
  }
  .fortified-featured-card__shipping {
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1;
    color: var(--color-foreground);
    margin: 0;
  }

  @media (max-width: 990px) {
    .fortified-featured-card__inner { flex-direction: column; gap: 32px; }
    .fortified-featured-card__media { flex: 1 0 auto; width: 100%; aspect-ratio: 1; }
    .fortified-featured-card__heading { font-size: 40px; }
    .fortified-featured-card__price-amount { font-size: 32px; }
  }
  @media (max-width: 749px) {
    .fortified-featured-card__heading { font-size: 32px; }
    .fortified-featured-card__cta { height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP-04 — Featured Product",
  "tag": "section",
  "class": "fortified-featured-product-card-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product (optional)",
      "info": "If set, falls back to product image and link when section image / CTA URL are empty."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge",
      "default": "bestseller"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "Everyday Hydration"
    },
    {
      "type": "text",
      "id": "price_caption",
      "label": "Price caption",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "You pay today:"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$1.99"
    },
    {
      "type": "text",
      "id": "price_compare",
      "label": "Compare-at price",
      "default": "$10.97"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP FORTIFIED"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "Fast shipping within US (under 24 hours)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fortified-include-item",
      "name": "Include row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Energy Hydration stick"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "200mg caffeine, 1000mg electrolytes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP-04 — Featured Product",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        { "type": "fortified-include-item", "settings": { "title": "Energy Hydration stick - salty orange x2", "body": "200mg caffeine, 1000mg electrolytes" } },
        { "type": "fortified-include-item", "settings": { "title": "Energy Hydration stick - salty Melon x2", "body": "200mg caffeine, 1000mg electrolytes" } },
        { "type": "fortified-include-item", "settings": { "title": "Free USA Shipping", "body": "Ships in 24 hours" } },
        { "type": "fortified-include-item", "settings": { "title": "Money-back guarantee", "body": "Don't love it? Get a refund" } }
      ]
    }
  ]
}
{% endschema %}
