{% comment %}
  Section: FTD - Ingredients Callout
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Two-column section: large product image on one side, heading +
  description + N-column ingredient block grid + CTA on the other.
  Mobile stacks the layout and reflows ingredients into a single column.
{% endcomment %}

{%- liquid
  assign img_pos       = section.settings.image_position_desktop
  assign btn_style     = section.settings.button_style
  assign cols_d        = section.settings.desktop_ingredients_columns
  assign icon_size     = section.settings.icon_size
  assign icon_bg       = section.settings.icon_background_color
  assign icon_color    = section.settings.icon_color
  assign img_bg        = section.settings.product_image_background
  assign img_max_h     = section.settings.product_image_max_height

  assign ing_blocks = section.blocks | where: 'type', 'ingredient'
  assign pdp = product.metafields.fortified.pdp_content.value
  assign heading_v = section.settings.heading
  assign subheading_v = section.settings.subheading
  assign cta_label_v = section.settings.button_label
  assign use_pdp_ing = false
  if pdp != blank
    if pdp.ingredients_heading != blank
      assign heading_v = pdp.ingredients_heading
    endif
    if pdp.ingredients_subheading != blank
      assign subheading_v = pdp.ingredients_subheading
    endif
    if pdp.cta_label != blank
      assign cta_label_v = pdp.cta_label
    endif
    if pdp.ingredients.value != blank and pdp.ingredients.value.size > 0
      assign use_pdp_ing = true
    endif
  endif
  assign sid = section.id | replace: '_', '' | downcase
  assign root = 'ftic-' | append: sid
  assign anchor_id = section.settings.anchor_id | strip | handleize
  if anchor_id != blank
    assign root = anchor_id
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="{{ root }}"
  class="ftd-ic section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }} ftd-ic--img-{{ img_pos }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --ftic-max-w: {{ section.settings.content_max_width }}px;
    --ftic-cols-d: {{ cols_d }};
    --ftic-icon-size: {{ icon_size }}px;
    --ftic-icon-bg: {{ icon_bg }};
    --ftic-icon-color: {{ icon_color }};
    --ftic-img-bg: {{ img_bg }};
    --ftic-img-max-h: {{ img_max_h }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="ftd-ic__inner">

    <div class="ftd-ic__media">
      <div class="ftd-ic__media-frame">
        {%- if section.settings.product_image != blank -%}
          {{ section.settings.product_image | image_url: width: 1000 | image_tag:
            class: 'ftd-ic__img',
            loading: 'lazy',
            widths: '400,600,800,1000',
            alt: section.settings.heading
          }}
        {%- else -%}
          <div class="ftd-ic__img ftd-ic__img--placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>

    <div class="ftd-ic__content">
      {%- if heading_v != blank -%}
        <h2 class="ftd-ic__heading">{%- render 'ftd-rich-text', text: heading_v -%}</h2>
      {%- endif -%}
      {%- if subheading_v != blank -%}
        <div class="ftd-ic__sub">{%- render 'ftd-rich-text', text: subheading_v -%}</div>
      {%- endif -%}

      {%- if use_pdp_ing or ing_blocks.size > 0 -%}
        <ul class="ftd-ic__grid">
          {%- if use_pdp_ing -%}
            {%- for ing in pdp.ingredients.value -%}
              <li class="ftd-ic__card">
                {%- if ing.icon != blank -%}
                  <span class="ftd-ic__icon-wrap" style="background: var(--ftic-icon-bg); color: var(--ftic-icon-color); width: var(--ftic-icon-size); height: var(--ftic-icon-size);">
                    {{ ing.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: ing.name }}
                  </span>
                {%- else -%}
                  <span class="ftd-ic__icon-wrap ftd-ic__icon-wrap--default" style="background: var(--ftic-icon-bg); color: var(--ftic-icon-color); width: var(--ftic-icon-size); height: var(--ftic-icon-size);" aria-hidden="true"></span>
                {%- endif -%}
                <div class="ftd-ic__card-body">
                  {%- if ing.name != blank -%}<p class="ftd-ic__name">{{ ing.name }}</p>{%- endif -%}
                  {%- if ing.amount != blank or ing.description != blank -%}
                    <p class="ftd-ic__desc">
                      {%- if ing.amount != blank -%}<strong>{{ ing.amount }}</strong>{%- if ing.description != blank -%} — {%- endif -%}{%- endif -%}
                      {{- ing.description -}}
                    </p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          {%- else -%}
          {%- for block in ing_blocks -%}
            {%- assign per_color = block.settings.icon_color_override -%}
            <li class="ftd-ic__item" {{ block.shopify_attributes }}>
              <span
                class="ftd-ic__icon"
                {% if per_color != blank %}style="--ftic-icon-color: {{ per_color }};"{% endif %}
                aria-hidden="true"
              >
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 96 | image_tag:
                    class: 'ftd-ic__icon-img',
                    loading: 'lazy',
                    widths: '48,72,96',
                    alt: ''
                  }}
                {%- else -%}
                  <svg class="ftd-ic__icon-svg" viewBox="0 0 24 24" width="60%" height="60%" aria-hidden="true" focusable="false">
                    <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="currentColor"/>
                  </svg>
                {%- endif -%}
              </span>
              <div class="ftd-ic__item-text">
                {%- if block.settings.name != blank -%}
                  <p class="ftd-ic__name">{{ block.settings.name }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="ftd-ic__desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- capture cta_buttons -%}
        {%- if cta_label_v != blank -%}
          {%- assign _ic_cls = 'button' -%}
          {%- if btn_style == 'outline' -%}{%- assign _ic_cls = 'button button-secondary' -%}{%- endif -%}
          <a
            class="{{ _ic_cls }}"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#" role="button"{% endif %}
          >{{ cta_label_v }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          {%- assign sec_link = section.settings.secondary_button_link | default: '#shopify-section-ftd_c_supp_facts_4JN74r' -%}
          <a class="button button-secondary" href="{{ sec_link }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      {%- endcapture -%}

      {%- assign cta_trimmed = cta_buttons | strip -%}
      {%- unless section.settings.center_cta -%}
        {%- if cta_trimmed != blank -%}
          <div class="ftd-ic__cta-wrap">{{ cta_buttons }}</div>
        {%- endif -%}
      {%- endunless -%}
    </div>

  </div>

  {%- comment %} Centered mode: the CTA leaves the text column and gets its
      own full-width row under the image/content grid, so it centers on the
      SECTION (and screen), not on the 70% text column. {%- endcomment %}
  {%- if section.settings.center_cta and cta_trimmed != blank -%}
    <div class="ftd-ic__cta-row">{{ cta_buttons }}</div>
  {%- endif -%}
</section>

{% stylesheet %}
.ftd-ic {
  display: block;
  color: var(--color-foreground);
  background: var(--color-background);
}

.ftd-ic__inner {
  max-width: var(--ftic-max-w, 1240px);
  margin-inline: auto;
  padding-inline: clamp(16px, 5vw, 48px);
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(28px, 5vw, 56px);
  align-items: start;
}

/* Media */
.ftd-ic__media {
  width: 100%;
}
.ftd-ic__media-frame {
  background: var(--ftic-img-bg, #F2F2F0);
  border-radius: 8px;
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 12px;
  min-height: 280px;
}
.ftd-ic__img {
  display: block;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: var(--ftic-img-max-h, 500px);
  object-fit: contain;
}
.ftd-ic__img--placeholder {
  width: 60%;
  aspect-ratio: 3 / 4;
  background: rgb(var(--color-foreground-rgb) / 0.08);
  border-radius: 8px;
}

/* Content */
.ftd-ic__content {
  display: flex;
  flex-direction: column;
  gap: clamp(26px, 2.4vw, 36px);
  min-width: 0;
}
.ftd-ic__heading {
  margin: 0;
  font-family: var(--font-heading--family, inherit);
  font-size: var(--ftd-h2-size);
  font-weight: 800;
  line-height: var(--ftd-h2-line);
  text-transform: uppercase;
  color: var(--color-foreground);
}
.ftd-ic__sub {
  margin: 0;
  font-size: var(--ftd-sub-size);
  line-height: var(--ftd-sub-line);
  color: rgb(var(--color-foreground-rgb) / 0.7);
  max-width: 60ch;
}

/* Ingredient grid */
.ftd-ic__grid {
  list-style: none;
  margin: clamp(10px, 1.6vw, 22px) 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(26px, 3vw, 40px);
}
.ftd-ic__item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  min-width: 0;
}
.ftd-ic__icon {
  flex: 0 0 auto;
  width: var(--ftic-icon-size, 48px);
  height: var(--ftic-icon-size, 48px);
  border-radius: 999px;
  background: var(--ftic-icon-bg, #0A0A0A);
  color: var(--ftic-icon-color, #FFFFFF);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ftd-ic__icon-img {
  display: block;
  width: 62%;
  height: 62%;
  object-fit: contain;
}
.ftd-ic__icon-svg { display: block; color: var(--ftic-icon-color, #FFFFFF); }
.ftd-ic__item-text { min-width: 0; }
.ftd-ic__name {
  margin: 0 0 4px;
  font-family: var(--font-heading--family, inherit);
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-foreground);
}
.ftd-ic__desc {
  margin: 0;
  font-size: 14px;
  line-height: 1.45;
  color: rgb(var(--color-foreground-rgb) / 0.7);
}

/* CTA */
.ftd-ic__cta-wrap { display: flex; gap: 14px; flex-wrap: wrap; margin-top: clamp(10px, 1.6vw, 22px); align-items: stretch; }
/* Centered mode: full-width row below the grid, aligned to the section. */
.ftd-ic__cta-row {
  max-width: var(--ftic-max-w, 1240px);
  margin: clamp(20px, 3vw, 36px) auto 0;
  padding-inline: clamp(16px, 5vw, 48px);
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  align-items: stretch;
}
.ftd-ic__cta-row > .button,
.ftd-ic__cta-row > .button-secondary { flex: 0 1 auto; min-width: 12rem; white-space: nowrap; justify-content: center; text-align: center; }
.ftd-ic__cta-wrap > .ftd-ic__cta,
.ftd-ic__cta-wrap > .button,
.ftd-ic__cta-wrap > .button-secondary { flex: 0 1 auto; min-width: 12rem; white-space: nowrap; justify-content: center; text-align: center; }
.ftd-ic__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading--family, inherit);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 15px 32px;
  border-radius: var(--style-border-radius-buttons-primary, 8px);
  cursor: pointer;
  border: 2px solid var(--color-primary-button-background);
  transition: background 0.18s, color 0.18s, opacity 0.18s;
}
.ftd-ic__cta--outline {
  background: transparent;
  color: var(--color-foreground);
}
.ftd-ic__cta--outline:hover {
  background: var(--color-primary-button-background);
  color: var(--color-primary-button-text);
}
.ftd-ic__cta--filled {
  background: var(--color-primary-button-background);
  color: var(--color-primary-button-text);
}
.ftd-ic__cta--filled:hover { opacity: 0.88; }

/* Mobile */
@media (max-width: 749px) {
  .ftd-ic__grid { grid-template-columns: 1fr !important; }
  .ftd-ic__cta-wrap > .ftd-ic__cta,
  .ftd-ic__cta-wrap > .button,
  .ftd-ic__cta-wrap > .button-secondary,
  .ftd-ic__cta-row > .button,
  .ftd-ic__cta-row > .button-secondary { flex: 1 1 auto; min-width: 0; }
}

/* Desktop. The image column is always the 30fr (narrower) track and the
   content column is always 70fr, regardless of which side the image
   appears on. We swap the order of the column widths AND the order of
   the children so each lands in its intended track — using `order:` on
   its own would re-render the items but leave the image in the 70fr
   column, which made the image balloon when set to 'right'. */
@media (min-width: 750px) {
  .ftd-ic__inner {
    gap: clamp(32px, 5vw, 56px);
  }
  .ftd-ic--img-left  .ftd-ic__inner { grid-template-columns: 30fr 70fr; }
  .ftd-ic--img-right .ftd-ic__inner { grid-template-columns: 70fr 30fr; }
  .ftd-ic--img-left  .ftd-ic__media   { order: 1; }
  .ftd-ic--img-left  .ftd-ic__content { order: 2; }
  .ftd-ic--img-right .ftd-ic__content { order: 1; }
  .ftd-ic--img-right .ftd-ic__media   { order: 2; }
  .ftd-ic__grid {
    grid-template-columns: repeat(var(--ftic-cols-d, 2), minmax(0, 1fr));
  }
}
{% endstylesheet %}

<style>
  {{ section.settings.custom_css }}
</style>

{% schema %}
{
  "name": "FTD - Ingredients Callout",
  "tag": "section",
  "class": "ftd-ingredients-callout-section",
  "settings": [
    {
      "type": "header",
      "content": "Anchor"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional. Lets you link to this section, e.g. #ingredients. Letters, numbers, and hyphens only."
    },
    {
      "type": "header",
      "content": "t:content.content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Clinically Backed Ingredients"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Electrolytes don't provide full recovery. Regenerate hydration.</p>"
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "color",
      "id": "product_image_background",
      "label": "Image background",
      "default": "#F2F2F0"
    },
    {
      "type": "range",
      "id": "product_image_max_height",
      "label": "Image max height",
      "min": 280,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Ingredients grid"
    },
    {
      "type": "range",
      "id": "desktop_ingredients_columns",
      "label": "Ingredient columns (desktop)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:content.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Fortified Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "center_cta",
      "label": "Center button in section",
      "default": false,
      "info": "Moves the button to its own centered row below the image and text."
    },
    {
      "type": "header",
      "content": "Secondary CTA (Learn More)"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "text",
      "id": "secondary_button_link",
      "label": "Secondary button link",
      "default": "#shopify-section-ftd_c_supp_facts_4JN74r",
      "info": "Defaults to the Supplement Facts section on the homepage."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "outline",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "filled",
          "label": "Filled"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "page-width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:content.advanced"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Targets this section."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Sodium"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Supports body hydration"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "Optional. Leave blank for the built-in SVG fallback."
        },
        {
          "type": "color",
          "id": "icon_color_override",
          "label": "Icon color override",
          "info": "Optional. Falls back to the section icon color."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FTD - Ingredients Callout",
      "category": "Fortified",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Sodium",
            "description": "Supports body hydration"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Potassium",
            "description": "Helps muscle and nerve function"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Magnesium",
            "description": "Aids energy and recovery"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Collagen",
            "description": "Supports skin and joint health"
          }
        }
      ]
    }
  ]
}
{% endschema %}
