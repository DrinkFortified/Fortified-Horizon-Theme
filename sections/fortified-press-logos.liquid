{% render 'fortified-base' %}

<section
  id="FortifiedPress-{{ section.id }}"
  class="fortified-press color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container">
    {% if section.settings.heading != blank %}
      <p class="fortified-press__heading">{{ section.settings.heading }}</p>
    {% endif %}
    <div class="fortified-press__row">
      {% for i in (1..6) %}
        {%- assign img_key = 'logo_' | append: i -%}
        {%- assign alt_key = 'logo_' | append: i | append: '_alt' -%}
        {%- assign img = section.settings[img_key] -%}
        {% if img != blank %}
          <div class="fortified-press__item">
            {{ img | image_url: width: 320 | image_tag:
                widths: '120, 200, 320',
                sizes: '160px',
                class: 'fortified-press__logo',
                alt: section.settings[alt_key] | default: img.alt | default: 'Press logo',
                loading: 'lazy' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-press {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-press .fortified-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 32px;
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: 40px;
  }
  .fortified-press__heading {
    font-family: var(--font-fortified-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-align: center;
    margin: 0;
  }
  .fortified-press__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    width: 100%;
  }
  .fortified-press__item {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }
  .fortified-press__logo {
    max-height: 36px;
    width: auto;
    display: block;
  }
  @media (max-width: 749px) {
    .fortified-press__row { justify-content: center; gap: 24px; }
    .fortified-press__logo { max-height: 28px; }
    .fortified-press .fortified-container { padding-inline: 24px; }
  }
{% endstylesheet %}

