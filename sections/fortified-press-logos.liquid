{% render 'fortified-base' %}

<section
  id="FortifiedPress-{{ section.id }}"
  class="fortified-press color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  <div class="fortified-container">
    {% if section.settings.heading != blank %}
      <p class="fortified-press__heading">{{ section.settings.heading }}</p>
    {% endif %}
    <div class="fortified-press__row">
      {% for i in (1..6) %}
        {%- assign img_key = 'logo_' | append: i -%}
        {%- assign alt_key = 'logo_' | append: i | append: '_alt' -%}
        {%- assign img = section.settings[img_key] -%}
        {% if img != blank %}
          <div class="fortified-press__item">
            {{ img | image_url: width: 320 | image_tag:
                widths: '120, 200, 320',
                sizes: '160px',
                class: 'fortified-press__logo',
                alt: section.settings[alt_key] | default: img.alt | default: 'Press logo',
                loading: 'lazy' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-press {
    background: var(--color-background, #fff);
    padding-block: clamp(36px, 5vw, 64px);
  }
  .fortified-press__heading {
    text-align: center;
    font-family: var(--font-fortified-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fortified-gray-mid);
    margin: 0 0 24px;
  }
  .fortified-press__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vw, 56px);
  }
  .fortified-press__item {
    flex: 0 0 auto;
  }
  .fortified-press__logo {
    max-height: 36px;
    width: auto;
    filter: grayscale(100%);
    opacity: .65;
    transition: filter .2s ease, opacity .2s ease;
  }
  .fortified-press__logo:hover { filter: grayscale(0); opacity: 1; }
  @media (max-width: 749px) {
    .fortified-press__row { gap: 20px; }
    .fortified-press__logo { max-height: 26px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "02 \u2014 Press Logos",
  "tag": "section",
  "class": "fortified-press-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN IN"
    },
    {
      "type": "image_picker",
      "id": "logo_1",
      "label": "Logo 1"
    },
    {
      "type": "text",
      "id": "logo_1_alt",
      "label": "Logo 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "Logo 2"
    },
    {
      "type": "text",
      "id": "logo_2_alt",
      "label": "Logo 2 alt text"
    },
    {
      "type": "image_picker",
      "id": "logo_3",
      "label": "Logo 3"
    },
    {
      "type": "text",
      "id": "logo_3_alt",
      "label": "Logo 3 alt text"
    },
    {
      "type": "image_picker",
      "id": "logo_4",
      "label": "Logo 4"
    },
    {
      "type": "text",
      "id": "logo_4_alt",
      "label": "Logo 4 alt text"
    },
    {
      "type": "image_picker",
      "id": "logo_5",
      "label": "Logo 5"
    },
    {
      "type": "text",
      "id": "logo_5_alt",
      "label": "Logo 5 alt text"
    },
    {
      "type": "image_picker",
      "id": "logo_6",
      "label": "Logo 6"
    },
    {
      "type": "text",
      "id": "logo_6_alt",
      "label": "Logo 6 alt text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "02 \u2014 Press Logos",
      "category": "Fortified"
    }
  ]
}
{% endschema %}
