{% render 'fortified-base' %}

<section
  id="PdpHero-{{ section.id }}"
  class="pdp-hero"
  data-pdp-hero
  {{ section.shopify_attributes }}
 style="text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container pdp-hero__grid" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
    {%- comment -%} ============= GALLERY ============= {%- endcomment -%}
    <div class="pdp-hero__gallery">
      <div class="pdp-hero__main p-energy">
        {% if section.settings.energy_main_image != blank %}
          <img src="{{ section.settings.energy_main_image | image_url: width: 1200 }}" alt="{{ section.settings.energy_main_alt }}" loading="eager" width="800" height="800">
        {% else %}
          <div class="pdp-hero__placeholder pdp-hero__placeholder--energy">
            <span>{{ section.settings.energy_placeholder_label }}</span>
          </div>
        {% endif %}
      </div>
      <div class="pdp-hero__main p-everyday">
        {% if section.settings.everyday_main_image != blank %}
          <img src="{{ section.settings.everyday_main_image | image_url: width: 1200 }}" alt="{{ section.settings.everyday_main_alt }}" loading="eager" width="800" height="800">
        {% else %}
          <div class="pdp-hero__placeholder pdp-hero__placeholder--everyday">
            <span>{{ section.settings.everyday_placeholder_label }}</span>
          </div>
        {% endif %}
      </div>

      <div class="pdp-hero__thumbs">
        {% for i in (1..4) %}
          {% assign t_key = 'thumb_' | append: i | append: '_image' %}
          <button type="button" class="pdp-hero__thumb {% if forloop.first %}is-active{% endif %}" aria-label="Thumbnail {{ forloop.index }}">
            {% if section.settings[t_key] != blank %}
              <img src="{{ section.settings[t_key] | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
            {% endif %}
          </button>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} ============= BUY MODULE ============= {%- endcomment -%}
    <div class="pdp-hero__buy">
      <div class="pdp-hero__head">
        <p class="pdp-hero__eyebrow p-energy">{{ section.settings.energy_eyebrow }}</p>
        <p class="pdp-hero__eyebrow p-everyday">{{ section.settings.everyday_eyebrow }}</p>

        <h1 class="pdp-hero__title">
          <span class="p-energy">{{ section.settings.energy_title }}</span>
          <span class="p-everyday">{{ section.settings.everyday_title }}</span>
        </h1>

        <p class="pdp-hero__desc">
          <span class="p-energy">{{ section.settings.energy_desc }}</span>
          <span class="p-everyday">{{ section.settings.everyday_desc }}</span>
        </p>

        <div class="pdp-hero__reviews">
          <span class="pdp-hero__stars" aria-hidden="true">★★★★★</span>
          <span>{{ section.settings.review_text }}</span>
        </div>
      </div>

      {%- comment -%} ===== STEP 1: PLAN ===== {%- endcomment -%}
      <section class="pdp-step is-active" data-step="1" aria-labelledby="StepPlan-{{ section.id }}">
        <header class="pdp-step__head">
          <span class="pdp-step__num">1</span>
          <h2 id="StepPlan-{{ section.id }}" class="pdp-step__title">{{ section.settings.step1_title }}</h2>
        </header>
        <div class="pdp-step__body">
          <div class="pdp-plan" role="radiogroup" aria-label="Plan">
            {% for block in section.blocks %}
              {% if block.type == 'plan' %}
                <label
                  class="pdp-plan__opt{% if block.settings.is_default %} is-selected{% endif %}"
                  data-plan="{{ block.settings.plan_id | default: block.id }}"
                  data-pouches="{{ block.settings.pouch_count }}"
                  data-price="{{ block.settings.price_cents }}"
                  style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}
                >
                  <input type="radio" name="pdp-plan-{{ section.id }}" value="{{ block.settings.plan_id | default: block.id }}" {% if block.settings.is_default %}checked{% endif %}>
                  <span class="pdp-plan__main">
                    {% if block.settings.badge != blank %}<span class="pdp-plan__badge">{{ block.settings.badge }}</span>{% endif %}
                    <span class="pdp-plan__name">{{ block.settings.label }}</span>
                    <span class="pdp-plan__detail">{{ block.settings.detail }}</span>
                  </span>
                  <span class="pdp-plan__price">
                    <span class="pdp-plan__price-now">{{ block.settings.price_display }}</span>
                    {% if block.settings.compare_at != blank %}
                      <span class="pdp-plan__price-was">{{ block.settings.compare_at }}</span>
                    {% endif %}
                  </span>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>

      {%- comment -%} ===== STEP 2: FUNCTION + FLAVOR ===== {%- endcomment -%}
      <section class="pdp-step is-locked" data-step="2" aria-labelledby="StepFF-{{ section.id }}">
        <header class="pdp-step__head">
          <span class="pdp-step__num">2</span>
          <h2 id="StepFF-{{ section.id }}" class="pdp-step__title">{{ section.settings.step2_title }}</h2>
        </header>
        <div class="pdp-step__body" data-pouches-host>
          {%- comment -%} Pouches rendered by JS based on plan {%- endcomment -%}
          <p class="pdp-step__hint">{{ section.settings.step2_hint }}</p>
        </div>
      </section>

      {%- comment -%} ===== STEP 3: CREATINE ===== {%- endcomment -%}
      <section class="pdp-step is-locked" data-step="3" aria-labelledby="StepC-{{ section.id }}">
        <header class="pdp-step__head">
          <span class="pdp-step__num">3</span>
          <h2 id="StepC-{{ section.id }}" class="pdp-step__title">{{ section.settings.step3_title }}</h2>
        </header>
        <div class="pdp-step__body">
          <div class="pdp-creatine">
            <div class="pdp-creatine__row pdp-creatine__row--free" data-creatine-row="free" hidden>
              <div>
                <div class="pdp-creatine__title">{{ section.settings.creatine_free_title }}</div>
                <div class="pdp-creatine__meta">{{ section.settings.creatine_free_meta }}</div>
              </div>
              <div class="pdp-creatine__price"><s>{{ section.settings.creatine_compare }}</s> <strong>FREE</strong></div>
            </div>
            <label class="pdp-creatine__row" data-creatine-row="extra" hidden>
              <input type="checkbox" data-creatine-extra>
              <div>
                <div class="pdp-creatine__title">{{ section.settings.creatine_extra_title }}</div>
                <div class="pdp-creatine__meta">{{ section.settings.creatine_extra_meta }}</div>
              </div>
              <div class="pdp-creatine__price">+{{ section.settings.creatine_extra_price }}</div>
            </label>
            <label class="pdp-creatine__row" data-creatine-row="sub" hidden>
              <input type="checkbox" data-creatine-sub>
              <div>
                <div class="pdp-creatine__title">{{ section.settings.creatine_sub_title }}</div>
                <div class="pdp-creatine__meta">{{ section.settings.creatine_sub_meta }}</div>
              </div>
              <div class="pdp-creatine__price">+{{ section.settings.creatine_sub_price }}</div>
            </label>
          </div>
        </div>
      </section>

      {%- comment -%} ===== SUMMARY + CTA ===== {%- endcomment -%}
      <div class="pdp-summary" data-summary>
        <div class="pdp-summary__row"><span>{{ section.settings.summary_label_plan }}</span><span data-sum-plan>—</span></div>
        <div class="pdp-summary__row"><span>{{ section.settings.summary_label_addons }}</span><span data-sum-addons>—</span></div>
        <div class="pdp-summary__row pdp-summary__row--total"><span>{{ section.settings.summary_label_total }}</span><span data-sum-total>—</span></div>
      </div>

      <button type="button" class="pdp-cta" data-cta disabled>
        <span data-cta-label>{{ section.settings.cta_incomplete }}</span>
      </button>

      <ul class="pdp-trust">
        {% if section.settings.trust_1 != blank %}<li>{{ section.settings.trust_1 }}</li>{% endif %}
        {% if section.settings.trust_2 != blank %}<li>{{ section.settings.trust_2 }}</li>{% endif %}
        {% if section.settings.trust_3 != blank %}<li>{{ section.settings.trust_3 }}</li>{% endif %}
      </ul>
    </div>
  </div>
</section>

{%- comment -%} ============= TEMPLATES FOR POUCH OPTIONS ============= {%- endcomment -%}
<template id="PdpPouchTpl-{{ section.id }}">
  <div class="pdp-pouch" data-pouch>
    <div class="pdp-pouch__head"><span class="pdp-pouch__num"></span></div>
    <div class="pdp-pouch__group">
      <label class="pdp-pouch__lbl">{{ section.settings.pouch_function_label }}</label>
      <div class="pdp-pouch__opts" data-functions></div>
    </div>
    <div class="pdp-pouch__group">
      <label class="pdp-pouch__lbl">{{ section.settings.pouch_flavor_label }}</label>
      <div class="pdp-pouch__opts" data-flavors></div>
    </div>
  </div>
</template>

{% stylesheet %}
  .pdp-hero { background: var(--fortified-off-white); padding-block: clamp(28px, 5vw, 64px); font-family: var(--font-fortified-body); color: var(--fortified-black); }
  .pdp-hero__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  @media (max-width: 960px) { .pdp-hero__grid { grid-template-columns: 1fr; } }

  .pdp-hero__main { background: var(--fortified-white); border: 1px solid var(--fortified-gray-light); border-radius: 24px; overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
  .pdp-hero__main img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pdp-hero__placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-family: var(--font-fortified-display); font-size: 28px; letter-spacing: 0.06em; text-transform: uppercase; }
  .pdp-hero__placeholder--energy { background: linear-gradient(180deg, var(--fortified-orange), var(--fortified-gold)); color: var(--fortified-black); }
  .pdp-hero__placeholder--everyday { background: linear-gradient(180deg, var(--fortified-teal), var(--fortified-teal-dark)); color: var(--fortified-white); }
  .pdp-hero__thumbs { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-top: 12px; }
  .pdp-hero__thumb { border: 1px solid var(--fortified-gray-light); border-radius: 14px; overflow: hidden; padding: 0; cursor: pointer; background: var(--fortified-white); aspect-ratio: 1/1; }
  .pdp-hero__thumb.is-active { border-color: var(--fortified-black); }
  .pdp-hero__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .pdp-hero__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fortified-gray-mid); margin: 0 0 8px; }
  body[data-product="energy"] .pdp-hero__eyebrow.p-energy { color: var(--fortified-gold); }
  body[data-product="everyday"] .pdp-hero__eyebrow.p-everyday { color: var(--fortified-teal-dark); }
  .pdp-hero__title { font-family: var(--font-fortified-display); font-size: clamp(28px, 4vw, 44px); line-height: 1.05; margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.01em; }
  .pdp-hero__desc { color: var(--fortified-gray-mid); margin: 0 0 16px; font-size: 15px; line-height: 1.5; max-width: 52ch; }
  .pdp-hero__reviews { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--fortified-gray-mid); margin-bottom: 24px; }
  .pdp-hero__stars { color: var(--fortified-orange); letter-spacing: 2px; }

  .pdp-step { border: 1px solid var(--fortified-gray-light); border-radius: 18px; background: var(--fortified-white); margin-bottom: 14px; transition: opacity .2s ease; }
  .pdp-step.is-locked { opacity: .5; pointer-events: none; }
  .pdp-step__head { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--fortified-gray-light); }
  .pdp-step__num { width: 28px; height: 28px; border-radius: 50%; background: var(--fortified-black); color: var(--fortified-white); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-fortified-display); font-size: 14px; }
  .pdp-step__title { font-family: var(--font-fortified-display); font-size: 14px; text-transform: uppercase; letter-spacing: 0.08em; margin: 0; }
  .pdp-step__body { padding: 16px 18px; }
  .pdp-step__hint { color: var(--fortified-gray-mid); font-size: 13px; margin: 0; }

  .pdp-plan { display: grid; gap: 10px; }
  .pdp-plan__opt { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 14px 16px; border: 1.5px solid var(--fortified-gray-light); border-radius: 14px; cursor: pointer; transition: border-color .15s ease, background .15s ease; }
  .pdp-plan__opt:hover { border-color: var(--fortified-gray-mid); }
  .pdp-plan__opt.is-selected { border-color: var(--fortified-black); background: rgba(10,10,10,.025); }
  .pdp-plan__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .pdp-plan__badge { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; background: var(--fortified-black); color: var(--fortified-white); padding: 3px 8px; border-radius: 999px; margin-bottom: 6px; }
  body[data-product="energy"] .pdp-plan__opt.is-selected .pdp-plan__badge { background: var(--fortified-gold); }
  body[data-product="everyday"] .pdp-plan__opt.is-selected .pdp-plan__badge { background: var(--fortified-teal); }
  .pdp-plan__name { display: block; font-family: var(--font-fortified-display); font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; }
  .pdp-plan__detail { display: block; color: var(--fortified-gray-mid); font-size: 12px; margin-top: 2px; }
  .pdp-plan__price { text-align: right; }
  .pdp-plan__price-now { display: block; font-family: var(--font-fortified-display); font-size: 18px; }
  .pdp-plan__price-was { display: block; font-size: 12px; color: var(--fortified-gray-mid); text-decoration: line-through; }

  .pdp-pouch { padding: 14px; border: 1px dashed var(--fortified-gray-light); border-radius: 12px; margin-bottom: 10px; }
  .pdp-pouch__num { display: inline-block; font-family: var(--font-fortified-display); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fortified-gray-mid); margin-bottom: 8px; }
  .pdp-pouch__lbl { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fortified-gray-mid); margin: 8px 0 6px; }
  .pdp-pouch__opts { display: flex; flex-wrap: wrap; gap: 6px; }
  .pdp-chip { border: 1px solid var(--fortified-gray-light); border-radius: 999px; background: var(--fortified-white); padding: 7px 12px; font-size: 12px; cursor: pointer; font-family: var(--font-fortified-body); transition: all .12s ease; }
  .pdp-chip:hover { border-color: var(--fortified-gray-mid); }
  .pdp-chip.is-selected { background: var(--fortified-black); color: var(--fortified-white); border-color: var(--fortified-black); }

  .pdp-creatine { display: grid; gap: 8px; }
  .pdp-creatine__row { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 12px 14px; border: 1px solid var(--fortified-gray-light); border-radius: 12px; cursor: pointer; }
  .pdp-creatine__row--free { grid-template-columns: 1fr auto; background: rgba(31,168,161,.06); border-color: var(--fortified-teal); cursor: default; }
  .pdp-creatine__title { font-family: var(--font-fortified-display); font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; }
  .pdp-creatine__meta { color: var(--fortified-gray-mid); font-size: 12px; margin-top: 2px; }
  .pdp-creatine__price { font-family: var(--font-fortified-display); font-size: 15px; }

  .pdp-summary { background: var(--fortified-off-white); border: 1px solid var(--fortified-gray-light); border-radius: 14px; padding: 14px 18px; margin: 18px 0 12px; font-size: 14px; }
  .pdp-summary__row { display: flex; justify-content: space-between; padding: 6px 0; }
  .pdp-summary__row--total { border-top: 1px solid var(--fortified-gray-light); margin-top: 6px; padding-top: 12px; font-family: var(--font-fortified-display); font-size: 18px; }

  .pdp-cta { width: 100%; padding: 16px 20px; border-radius: 999px; border: 0; cursor: pointer; font-family: var(--font-fortified-display); font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--fortified-black); color: var(--fortified-white); transition: background .15s ease; }
  .pdp-cta:disabled { background: var(--fortified-gray-light); color: var(--fortified-gray-mid); cursor: not-allowed; }
  body[data-product="energy"] .pdp-cta:not(:disabled) { background: var(--fortified-gold); color: var(--fortified-black); }
  body[data-product="everyday"] .pdp-cta:not(:disabled) { background: var(--fortified-teal); color: var(--fortified-white); }

  .pdp-trust { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--fortified-gray-mid); }
  .pdp-trust li::before { content: "✓"; color: var(--fortified-teal); margin-right: 6px; font-weight: 700; }

  body[data-product="energy"] .p-everyday { display: none; }
  body[data-product="everyday"] .p-energy { display: none; }
{% endstylesheet %}

<script>
  (function() {
    var root = document.getElementById('PdpHero-{{ section.id }}');
    if (!root) return;

    var FUNCTIONS = {
      energy: {{ section.settings.energy_functions | default: 'Focus, Pump, Endurance' | json }},
      everyday: {{ section.settings.everyday_functions | default: 'Hydration, Recovery, Sleep' | json }}
    };
    var FLAVORS = {
      energy: {{ section.settings.energy_flavors | default: 'Citrus, Berry, Tropical' | json }},
      everyday: {{ section.settings.everyday_flavors | default: 'Lemon, Watermelon, Grape' | json }}
    };

    var planEls = root.querySelectorAll('[data-plan]');
    var pouchHost = root.querySelector('[data-pouches-host]');
    var steps = root.querySelectorAll('.pdp-step');
    var sumPlan = root.querySelector('[data-sum-plan]');
    var sumAddons = root.querySelector('[data-sum-addons]');
    var sumTotal = root.querySelector('[data-sum-total]');
    var cta = root.querySelector('[data-cta]');
    var ctaLabel = root.querySelector('[data-cta-label]');
    var tpl = document.getElementById('PdpPouchTpl-{{ section.id }}');

    var state = {
      plan: null,
      pouches: [],
      creatineExtra: false,
      creatineSub: false
    };

    function currentProduct() { return document.body.dataset.product || 'energy'; }
    function fmt(c) { return '$' + (c/100).toFixed(2); }
    function list(s) { return String(s||'').split(',').map(function(x){return x.trim();}).filter(Boolean); }

    function selectPlan(el) {
      planEls.forEach(function(p){ p.classList.remove('is-selected'); var i=p.querySelector('input'); if(i)i.checked=false; });
      el.classList.add('is-selected');
      var i = el.querySelector('input'); if(i) i.checked = true;
      state.plan = {
        id: el.dataset.plan,
        pouches: parseInt(el.dataset.pouches, 10) || 1,
        price: parseInt(el.dataset.price, 10) || 0,
        label: el.querySelector('.pdp-plan__name').textContent.trim()
      };
      state.pouches = [];
      for (var n=0; n<state.plan.pouches; n++) state.pouches.push({ fn: null, fl: null });
      renderPouches();
      updateSteps();
      updateCreatine();
      updateSummary();
    }

    function renderPouches() {
      pouchHost.innerHTML = '';
      var p = currentProduct();
      var fns = list(FUNCTIONS[p]);
      var fls = list(FLAVORS[p]);

      state.pouches.forEach(function(pouch, idx) {
        var node = tpl.content.firstElementChild.cloneNode(true);
        node.querySelector('.pdp-pouch__num').textContent = 'Pouch ' + (idx + 1);
        var fnHost = node.querySelector('[data-functions]');
        var flHost = node.querySelector('[data-flavors]');
        fns.forEach(function(name) {
          var b = document.createElement('button');
          b.type='button'; b.className='pdp-chip'; b.textContent=name; b.dataset.value=name;
          b.addEventListener('click', function() {
            fnHost.querySelectorAll('.pdp-chip').forEach(function(c){c.classList.remove('is-selected');});
            b.classList.add('is-selected');
            state.pouches[idx].fn = name; updateSteps(); updateSummary();
          });
          fnHost.appendChild(b);
        });
        fls.forEach(function(name) {
          var b = document.createElement('button');
          b.type='button'; b.className='pdp-chip'; b.textContent=name; b.dataset.value=name;
          b.addEventListener('click', function() {
            flHost.querySelectorAll('.pdp-chip').forEach(function(c){c.classList.remove('is-selected');});
            b.classList.add('is-selected');
            state.pouches[idx].fl = name; updateSteps(); updateSummary();
          });
          flHost.appendChild(b);
        });
        pouchHost.appendChild(node);
      });
    }

    function step1Done() { return !!state.plan; }
    function step2Done() { return state.plan && state.pouches.length > 0 && state.pouches.every(function(p){ return p.fn && p.fl; }); }
    function step3Done() { return step2Done(); }

    function updateSteps() {
      steps.forEach(function(s) {
        var n = parseInt(s.dataset.step, 10);
        var unlocked = (n===1) || (n===2 && step1Done()) || (n===3 && step2Done());
        s.classList.toggle('is-locked', !unlocked);
      });
      var allDone = step1Done() && step2Done() && step3Done();
      cta.disabled = !allDone;
      ctaLabel.textContent = allDone ? {{ section.settings.cta_complete | json }} : {{ section.settings.cta_incomplete | json }};
    }

    function updateCreatine() {
      var freeRow = root.querySelector('[data-creatine-row="free"]');
      var extraRow = root.querySelector('[data-creatine-row="extra"]');
      var subRow = root.querySelector('[data-creatine-row="sub"]');
      freeRow.hidden = true; extraRow.hidden = true; subRow.hidden = true;
      if (!state.plan) return;
      if (state.plan.id === 'quarterly') {
        freeRow.hidden = false; extraRow.hidden = false;
      } else if (state.plan.id === 'monthly' || state.plan.id === 'sub') {
        subRow.hidden = false;
      } else {
        extraRow.hidden = false;
      }
    }

    function updateSummary() {
      if (!state.plan) { sumPlan.textContent = '—'; sumAddons.textContent = '—'; sumTotal.textContent = '—'; return; }
      sumPlan.textContent = state.plan.label + ' — ' + fmt(state.plan.price);
      var addons = 0; var parts = [];
      if (state.creatineExtra) { addons += {{ section.settings.creatine_extra_cents | default: 1200 }}; parts.push('+Creatine'); }
      if (state.creatineSub) { addons += {{ section.settings.creatine_sub_cents | default: 1500 }}; parts.push('Creatine sub'); }
      sumAddons.textContent = parts.length ? parts.join(', ') + ' — ' + fmt(addons) : 'None';
      sumTotal.textContent = fmt(state.plan.price + addons);
    }

    planEls.forEach(function(el){
      el.addEventListener('click', function(){ selectPlan(el); });
      if (el.classList.contains('is-selected')) selectPlan(el);
    });

    var cExtra = root.querySelector('[data-creatine-extra]');
    if (cExtra) cExtra.addEventListener('change', function(){ state.creatineExtra = cExtra.checked; updateSummary(); });
    var cSub = root.querySelector('[data-creatine-sub]');
    if (cSub) cSub.addEventListener('change', function(){ state.creatineSub = cSub.checked; updateSummary(); });

    window.addEventListener('pdp:product-change', function(){ if (state.plan) renderPouches(); });

    cta.addEventListener('click', function() {
      if (cta.disabled) return;
      try {
        window.dispatchEvent(new CustomEvent('pdp:add-to-cart', { detail: { product: currentProduct(), state: state } }));
      } catch(e){}
    });

    updateSteps();
    updateSummary();
  })();
</script>

