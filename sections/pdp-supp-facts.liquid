{% render 'fortified-base' %}

<section
  id="PdpSuppFacts-{{ section.id }}"
  class="pdp-facts"
  {{ section.shopify_attributes }}
>
  <div class="fortified-container pdp-facts__grid">
    <div class="pdp-facts__panel">
      {%- for variant in 'energy,everyday' | split: ',' -%}
        <div class="pdp-facts__sheet p-{{ variant }}">
          <h2 class="pdp-facts__title">{{ section.settings.panel_title }}</h2>
          {% if variant == 'energy' %}
            <p class="pdp-facts__serving">{{ section.settings.energy_serving }}</p>
          {% else %}
            <p class="pdp-facts__serving">{{ section.settings.everyday_serving }}</p>
          {% endif %}
          <div class="pdp-facts__divider pdp-facts__divider--thick"></div>
          <div class="pdp-facts__row pdp-facts__row--head">
            <span>{{ section.settings.head_amount }}</span>
            <span>{{ section.settings.head_dv }}</span>
          </div>
          <div class="pdp-facts__divider"></div>
          {% for block in section.blocks %}
            {% if block.type == 'fact_energy' and variant == 'energy' %}
              <div class="pdp-facts__row" {{ block.shopify_attributes }}>
                <span class="pdp-facts__name">{{ block.settings.name }} <em>{{ block.settings.amount }}</em></span>
                <span class="pdp-facts__dv">{{ block.settings.dv }}</span>
              </div>
            {% elsif block.type == 'fact_everyday' and variant == 'everyday' %}
              <div class="pdp-facts__row" {{ block.shopify_attributes }}>
                <span class="pdp-facts__name">{{ block.settings.name }} <em>{{ block.settings.amount }}</em></span>
                <span class="pdp-facts__dv">{{ block.settings.dv }}</span>
              </div>
            {% endif %}
          {% endfor %}
          <div class="pdp-facts__divider pdp-facts__divider--thick"></div>
          <p class="pdp-facts__foot">{{ section.settings.foot_note }}</p>
        </div>
      {%- endfor -%}
    </div>

    <aside class="pdp-facts__callouts">
      <h3 class="pdp-facts__callout-title">
        <span class="p-energy">{{ section.settings.energy_callout_title }}</span>
        <span class="p-everyday">{{ section.settings.everyday_callout_title }}</span>
      </h3>
      {% for block in section.blocks %}
        {% if block.type == 'callout_energy' %}
          <div class="pdp-facts__callout p-energy" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.body }}</p>
          </div>
        {% elsif block.type == 'callout_everyday' %}
          <div class="pdp-facts__callout p-everyday" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.body }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </aside>
  </div>
</section>

{% stylesheet %}
  .pdp-facts { background: var(--fortified-off-white); padding-block: clamp(40px, 6vw, 84px); font-family: var(--font-fortified-body); color: var(--fortified-black); }
  .pdp-facts__grid { display: grid; grid-template-columns: 380px 1fr; gap: 32px; align-items: start; }
  @media (max-width: 800px) { .pdp-facts__grid { grid-template-columns: 1fr; } }
  .pdp-facts__panel { background: var(--fortified-white); border: 2px solid var(--fortified-black); border-radius: 6px; padding: 18px 22px; }
  body[data-product="energy"] .pdp-facts__sheet.p-everyday,
  body[data-product="everyday"] .pdp-facts__sheet.p-energy { display: none; }
  .pdp-facts__title { font-family: var(--font-fortified-display); font-size: 22px; text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 4px; }
  .pdp-facts__serving { font-size: 12px; color: var(--fortified-black); margin: 0 0 8px; }
  .pdp-facts__divider { height: 1px; background: var(--fortified-black); margin: 6px 0; }
  .pdp-facts__divider--thick { height: 6px; background: var(--fortified-black); margin: 8px 0; }
  .pdp-facts__row { display: flex; justify-content: space-between; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--fortified-gray-light); font-size: 13px; }
  .pdp-facts__row--head { font-weight: 700; border-bottom: 0; padding-bottom: 0; }
  .pdp-facts__name em { font-style: normal; font-weight: 600; margin-left: 6px; }
  .pdp-facts__dv { font-weight: 700; }
  .pdp-facts__foot { font-size: 11px; color: var(--fortified-gray-mid); margin: 8px 0 0; line-height: 1.4; }
  .pdp-facts__callouts { display: grid; gap: 12px; }
  .pdp-facts__callout-title { font-family: var(--font-fortified-display); font-size: 18px; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 4px; }
  .pdp-facts__callout { background: var(--fortified-white); border: 1px solid var(--fortified-gray-light); border-radius: 14px; padding: 16px 18px; }
  .pdp-facts__callout h4 { font-family: var(--font-fortified-display); font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 6px; }
  body[data-product="energy"] .pdp-facts__callout.p-everyday,
  body[data-product="everyday"] .pdp-facts__callout.p-energy { display: none; }
  body[data-product="energy"] .pdp-facts__callout h4 { color: var(--fortified-gold); }
  body[data-product="everyday"] .pdp-facts__callout h4 { color: var(--fortified-teal-dark); }
  .pdp-facts__callout p { color: var(--fortified-gray-mid); font-size: 14px; margin: 0; line-height: 1.5; }
  body[data-product="energy"] .pdp-facts__callout-title .p-everyday,
  body[data-product="everyday"] .pdp-facts__callout-title .p-energy { display: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "06-Omni-Supplement Facts",
  "tag": "section",
  "class": "pdp-section pdp-section--facts",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "panel_title", "label": "Panel title", "default": "Supplement Facts" },
    { "type": "text", "id": "energy_serving", "label": "Energy — serving line", "default": "Serving size: 1 pouch (8.2g)" },
    { "type": "text", "id": "everyday_serving", "label": "Everyday — serving line", "default": "Serving size: 1 pouch (7.6g)" },
    { "type": "text", "id": "head_amount", "label": "Header — amount", "default": "Amount per serving" },
    { "type": "text", "id": "head_dv", "label": "Header — daily value", "default": "% DV" },
    { "type": "textarea", "id": "foot_note", "label": "Footnote", "default": "Percent Daily Values are based on a 2,000 calorie diet. Daily Value not established for some ingredients." },
    { "type": "header", "content": "Callouts" },
    { "type": "text", "id": "energy_callout_title", "label": "Energy callouts title", "default": "WHY THESE DOSES" },
    { "type": "text", "id": "everyday_callout_title", "label": "Everyday callouts title", "default": "WHY THESE DOSES" }
  ],
  "blocks": [
    {
      "type": "fact_energy",
      "name": "Energy fact row",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Caffeine" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "200mg" },
        { "type": "text", "id": "dv", "label": "% DV", "default": "**" }
      ]
    },
    {
      "type": "fact_everyday",
      "name": "Everyday fact row",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Sodium" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "1,200mg" },
        { "type": "text", "id": "dv", "label": "% DV", "default": "52%" }
      ]
    },
    {
      "type": "callout_energy",
      "name": "Energy callout",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Clinically-dosed caffeine" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "200mg is the sweet spot for cognition and performance without overshoot." }
      ]
    },
    {
      "type": "callout_everyday",
      "name": "Everyday callout",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Athlete-grade sodium" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "1,200mg matches what you actually lose during a hot training session." }
      ]
    }
  ],
  "presets": [
    {
      "name": "06-Omni-Supplement Facts",
      "category": "Fortified",
      "blocks": [
        { "type": "fact_energy", "settings": { "name": "Caffeine", "amount": "200mg", "dv": "**" } },
        { "type": "fact_energy", "settings": { "name": "L-Theanine", "amount": "200mg", "dv": "**" } },
        { "type": "fact_energy", "settings": { "name": "Sodium", "amount": "1,000mg", "dv": "43%" } },
        { "type": "fact_energy", "settings": { "name": "Magnesium glycinate", "amount": "300mg", "dv": "71%" } },
        { "type": "fact_energy", "settings": { "name": "Beta-alanine", "amount": "2g", "dv": "**" } },
        { "type": "fact_everyday", "settings": { "name": "Sodium", "amount": "1,200mg", "dv": "52%" } },
        { "type": "fact_everyday", "settings": { "name": "Magnesium glycinate", "amount": "400mg", "dv": "95%" } },
        { "type": "fact_everyday", "settings": { "name": "Potassium citrate", "amount": "300mg", "dv": "6%" } },
        { "type": "fact_everyday", "settings": { "name": "Calcium", "amount": "100mg", "dv": "8%" } },
        { "type": "fact_everyday", "settings": { "name": "Vitamin K2 (MK-7)", "amount": "90mcg", "dv": "75%" } },
        { "type": "callout_energy", "settings": { "title": "Clinically-dosed caffeine", "body": "200mg is the sweet spot for cognition and performance without overshoot." } },
        { "type": "callout_energy", "settings": { "title": "Why L-theanine?", "body": "Smooths the caffeine curve — calm focus without the crash." } },
        { "type": "callout_everyday", "settings": { "title": "Athlete-grade sodium", "body": "1,200mg matches what you actually lose during a hot training session." } },
        { "type": "callout_everyday", "settings": { "title": "Glycinate, not oxide", "body": "We use the most bioavailable form so your body actually absorbs it." } }
      ]
    }
  ]
}
{% endschema %}
