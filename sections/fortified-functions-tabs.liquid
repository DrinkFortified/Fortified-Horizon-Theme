{% render 'fortified-base' %}

{%- liquid
  assign content_align = section.settings.content_alignment | default: 'center'
  assign blocks_align = section.settings.blocks_alignment | default: 'center'
  # Collect tabs (each tab block defines a panel)
  assign tab_blocks = ''
  for block in section.blocks
    if block.type == 'tab'
      assign tab_blocks = tab_blocks | append: forloop.index0 | append: ','
    endif
  endfor
  assign tab_indexes = tab_blocks | split: ','
-%}

<section
  id="FortifiedFunctionsTabs-{{ section.id }}"
  class="fortified-functions-tabs color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ content_align }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;"
  data-fortified-functions-tabs
  {{ section.shopify_attributes }}
>
  <div class="fortified-container fortified-functions-tabs__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="fortified-functions-tabs__body fortified-body">{{ section.settings.body }}</div>
    {% endif %}

    <div class="fortified-functions-tabs__tablist" role="tablist"
         style="justify-content: {{ blocks_align }};">
      {%- assign tab_index = 0 -%}
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <button
            type="button"
            role="tab"
            class="fortified-functions-tabs__tab{% if tab_index == 0 %} is-active{% endif %}"
            data-tab-target="tab-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
            style="--tab-accent: {{ block.settings.accent_color | default: 'var(--fortified-teal)' }};"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.icon != blank %}
              <span class="fortified-functions-tabs__tab-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {% endif %}
            <span class="fortified-functions-tabs__tab-label">{{ block.settings.label }}</span>
            {% if block.settings.tagline != blank %}
              <span class="fortified-functions-tabs__tab-tagline">{{ block.settings.tagline }}</span>
            {% endif %}
          </button>
          {%- assign tab_index = tab_index | plus: 1 -%}
        {% endif %}
      {% endfor %}
    </div>

    <div class="fortified-functions-tabs__panels">
      {%- assign current_tab = '' -%}
      {%- assign pane_index = 0 -%}
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          {%- if current_tab != '' -%}
            </div>
          {%- endif -%}
          <div
            class="fortified-functions-tabs__panel{% if pane_index == 0 %} is-active{% endif %}"
            role="tabpanel"
            id="tab-{{ section.id }}-{{ block.id }}"
            style="justify-content: {{ blocks_align }};"
          >
          {%- assign current_tab = block.id -%}
          {%- assign pane_index = pane_index | plus: 1 -%}
        {% else %}
          {%- if current_tab == '' -%}
            {%- comment -%}Blocks before any tab — render as a default panel{%- endcomment -%}
            <div class="fortified-functions-tabs__panel is-active" role="tabpanel">
            {%- assign current_tab = 'default' -%}
          {%- endif -%}
          <div class="fortified-functions-tabs__panel-block"
               style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};"
               {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="fortified-functions-tabs__text">{{ block.settings.text }}</div>
              {%- when 'image' -%}
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag:
                      widths: '400, 600, 900, 1200',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      class: 'fortified-functions-tabs__image',
                      alt: block.settings.image.alt | default: '',
                      loading: 'lazy' }}
                {% endif %}
              {%- when 'heading' -%}
                <h3 class="fortified-heading fortified-h3">{{ block.settings.heading }}</h3>
              {%- when 'button' -%}
                {% if block.settings.label != blank %}
                  <a href="{{ block.settings.link | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.label }}</a>
                {% endif %}
              {%- when 'feature' -%}
                <article class="fortified-functions-tabs__feature">
                  {% if block.settings.icon != blank %}<span class="fortified-functions-tabs__feature-icon" aria-hidden="true">{{ block.settings.icon }}</span>{% endif %}
                  {% if block.settings.title != blank %}<h4 class="fortified-functions-tabs__feature-title">{{ block.settings.title }}</h4>{% endif %}
                  {% if block.settings.description != blank %}<p class="fortified-functions-tabs__feature-desc">{{ block.settings.description }}</p>{% endif %}
                </article>
              {%- else -%}
                {%- comment -%}Unknown block type — render its content_for body if available{%- endcomment -%}
                {{ block.settings.text }}
            {%- endcase -%}
          </div>
        {% endif %}
      {% endfor %}
      {%- if current_tab != '' -%}
        </div>
      {%- endif -%}
    </div>

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary fortified-functions-tabs__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('FortifiedFunctionsTabs-{{ section.id }}');
  if(!root) return;
  var tabs = root.querySelectorAll('.fortified-functions-tabs__tab');
  var panels = root.querySelectorAll('.fortified-functions-tabs__panel');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      var targetId = tab.getAttribute('data-tab-target');
      tabs.forEach(function(t){
        t.classList.toggle('is-active', t === tab);
        t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
      });
      panels.forEach(function(p){
        p.classList.toggle('is-active', p.id === targetId);
      });
    });
  });
})();
</script>

{% stylesheet %}
  .fortified-functions-tabs {
    background: var(--color-background, #fff);
    color: var(--color-foreground);
    padding-block: var(--fortified-section-py);
    overflow: hidden;
  }
  .fortified-functions-tabs__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3vw, 36px);
  }
  .fortified-functions-tabs__body { max-width: 56ch; }
  .fortified-functions-tabs__tablist {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
    background: var(--color-background);
    padding: 6px;
    border-radius: 999px;
    max-width: 720px;
  }
  .fortified-functions-tabs__tab {
    flex: 1 1 200px;
    background: transparent;
    border: 0;
    padding: 12px 18px;
    cursor: pointer;
    border-radius: 999px;
    font-family: var(--font-fortified-body);
    color: var(--color-foreground);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    transition: background .15s ease;
  }
  .fortified-functions-tabs__tab.is-active {
    background: var(--tab-accent, var(--fortified-accent, var(--fortified-accent, var(--color-foreground))));
    color: var(--color-foreground, #fff);
    
  }
  .fortified-functions-tabs__tab-icon { font-size: 18px; line-height: 1; }
  .fortified-functions-tabs__tab-label {
    font-family: var(--font-fortified-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .fortified-functions-tabs__tab-tagline { font-size: 11px; opacity: .8; }
  .fortified-functions-tabs__panels {
    width: 100%;
    position: relative;
  }
  .fortified-functions-tabs__panel { display: none; }
  .fortified-functions-tabs__panel.is-active {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 28px);
  }
  @media (min-width: 750px) {
    .fortified-functions-tabs__panel.is-active { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 990px) {
    .fortified-functions-tabs__panel.is-active[data-cols="3"],
    .fortified-functions-tabs__panel.is-active { grid-template-columns: repeat(2, 1fr); }
  }
  .fortified-functions-tabs__panel-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fortified-functions-tabs__image {
    width: 100%;
    height: auto;
    border-radius: 16px;
    object-fit: cover;
  }
  .fortified-functions-tabs__feature {
    background: var(--color-background);
    border-radius: 16px;
    padding: clamp(20px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fortified-functions-tabs__feature-icon { font-size: 32px; line-height: 1; }
  .fortified-functions-tabs__feature-title {
    font-family: var(--font-fortified-display);
    font-size: clamp(16px, 1.6vw, 20px);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-functions-tabs__feature-desc {
    font-size: 14px; line-height: 1.55; margin: 0;
    color: var(--color-foreground);
  }
  .fortified-functions-tabs__cta { margin-top: 8px; }
{% endstylesheet %}

