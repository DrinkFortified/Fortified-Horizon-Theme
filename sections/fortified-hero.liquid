{% render 'fortified-base' %}

{%- liquid
  assign img_pos = section.settings.image_position | default: 'right'
-%}

<section
  id="FortifiedHero-{{ section.id }}"
  class="fortified-hero color-{{ section.settings.color_scheme | default: 'scheme-1' }} fortified-hero--image-{{ img_pos }}"
  {% if bg != blank %}style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; --fortified-hero-bg: {{ bg }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;"{% endif %}
>
  <div class="fortified-container fortified-hero__inner">
    <div class="fortified-hero__text">
      {% if section.settings.eyebrow_text != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow_text }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="fortified-heading fortified-h1">{{ section.settings.heading | newline_to_br }}</h1>
      {% endif %}
      {% if section.settings.body_text != blank %}
        <p class="fortified-body fortified-hero__body">{{ section.settings.body_text }}</p>
      {% endif %}
      <div class="fortified-hero__ctas">
        {% if section.settings.cta_primary_label != blank %}
          <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_primary_label }}</a>
        {% endif %}
        {% if section.settings.cta_secondary_label != blank %}
          <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="fortified-btn fortified-btn--ghost">{{ section.settings.cta_secondary_label }}</a>
        {% endif %}
      </div>
    </div>
    <div class="fortified-hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 750px) 45vw, 100vw',
            class: 'fortified-hero__img',
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'eager',
            fetchpriority: 'high' }}
      {% else %}
        <div class="fortified-hero__placeholder"></div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-hero {
    background: var(--color-background);
    color: var(--color-foreground);
    overflow: hidden;
    position: relative;
  }
  .fortified-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    min-height: clamp(420px, 50vw, 620px);
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  @media (min-width: 990px) {
    .fortified-hero__inner { grid-template-columns: 1.05fr 1fr; }
    .fortified-hero--image-left .fortified-hero__inner { grid-template-columns: 1fr 1.05fr; }
    .fortified-hero--image-left .fortified-hero__text { order: 2; }
    .fortified-hero--image-left .fortified-hero__media { order: 1; }
  }

  .fortified-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    text-align: left;
  }
  .fortified-hero__text > .fortified-eyebrow {
    margin: 0;
    color: var(--color-foreground);
    opacity: 0.55;
  }
  .fortified-hero__text > .fortified-heading {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .fortified-hero__body {
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.55;
    max-width: 46ch;
    margin: 0;
    opacity: 0.85;
  }
  .fortified-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .fortified-hero__ctas .fortified-btn {
    padding: 14px 28px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 10px;
    min-height: 48px;
  }

  .fortified-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .fortified-hero__img {
    width: 100%;
    max-width: 560px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.18));
    transform: rotate(-3deg);
    transition: transform .35s ease;
  }
  .fortified-hero__img:hover { transform: rotate(0deg); }
  .fortified-hero__placeholder {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    background:
      radial-gradient(circle at 30% 35%, color-mix(in srgb, var(--fortified-accent, var(--color-foreground)) 18%, transparent), transparent 55%),
      color-mix(in srgb, var(--color-foreground) 5%, transparent);
    border-radius: 24px;
    position: relative;
  }
  .fortified-hero__placeholder::before {
    content: '';
    position: absolute;
    inset: 25%;
    border-radius: 100px;
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--fortified-accent, var(--color-foreground)) 80%, transparent) 0%,
      color-mix(in srgb, var(--fortified-accent, var(--color-foreground)) 40%, transparent) 60%,
      transparent 100%);
    transform: rotate(-8deg);
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  /* Decorative circles in the background — subtle brand element */
  .fortified-hero::before,
  .fortified-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: var(--fortified-accent, var(--color-foreground));
    opacity: 0.04;
    pointer-events: none;
  }
  .fortified-hero::before {
    width: 320px; height: 320px;
    top: -120px; right: -100px;
  }
  .fortified-hero::after {
    width: 240px; height: 240px;
    bottom: -80px; left: -60px;
  }

  @media (max-width: 749px) {
    .fortified-hero__text { gap: 14px; }
    .fortified-hero__ctas { width: 100%; }
    .fortified-hero__ctas .fortified-btn { flex: 1 1 auto; }
    .fortified-hero__img { max-width: 360px; transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "01 \u2014 Hero",
  "tag": "section",
  "class": "fortified-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "FORMULATED FOR"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "HYDRATION THAT HITS"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Premium electrolytes that fuel your every move. Clinically dosed, clean, and zero sugar."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for accent bars, CTA backgrounds, checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "presets": [
    {
      "name": "01 \u2014 Hero",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
