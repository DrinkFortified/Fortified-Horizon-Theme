{% render 'fortified-base' %}

<section
  id="FortifiedHero-{{ section.id }}"
  class="fortified-hero color-{{ section.settings.color_scheme | default: 'scheme-1' }} fortified-hero--align-{{ section.settings.content_alignment | default: 'left' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 24 }}px {{ section.settings['padding-block-end'] | default: 24 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 24 }}px {{ section.settings['padding-inline-end'] | default: 24 }}px;"
>
  <div class="fortified-hero__frame">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2880 | image_tag:
          widths: '720, 1080, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          class: 'fortified-hero__bg',
          alt: section.settings.image.alt | default: section.settings.heading,
          loading: 'eager',
          fetchpriority: 'high' }}
    {% else %}
      <div class="fortified-hero__bg fortified-hero__bg--placeholder"></div>
    {% endif %}

    <div class="fortified-hero__content">
      {% if section.settings.eyebrow_text != blank %}
        <span class="fortified-hero__eyebrow">{{ section.settings.eyebrow_text | replace: '*', '' }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="fortified-hero__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h1>
      {% endif %}
      {% if section.settings.body_text != blank %}
        <p class="fortified-hero__body">{% render 'fortified-accent-text', text: section.settings.body_text %}</p>
      {% endif %}
      {% if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank %}
        <div class="fortified-hero__ctas">
          {% if section.settings.cta_primary_label != blank %}
            <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="fortified-hero__btn fortified-hero__btn--primary">{{ section.settings.cta_primary_label }}</a>
          {% endif %}
          {% if section.settings.cta_secondary_label != blank %}
            <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="fortified-hero__btn fortified-hero__btn--secondary">{{ section.settings.cta_secondary_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-hero {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-hero__frame {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    min-height: 573px;
    display: flex;
    align-items: stretch;
  }
  .fortified-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-hero__bg--placeholder {
    background: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }
  .fortified-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 497px;
    padding: 100px 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    text-align: left;
    color: var(--color-foreground);
  }
  .fortified-hero--align-center .fortified-hero__frame { justify-content: center; }
  .fortified-hero--align-center .fortified-hero__content { align-items: center; text-align: center; margin-inline: auto; }
  .fortified-hero--align-right .fortified-hero__frame { justify-content: flex-end; }
  .fortified-hero--align-right .fortified-hero__content { align-items: flex-end; text-align: right; margin-left: auto; }

  .fortified-hero__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: none;
    margin: 0;
  }
  .fortified-hero__heading {
    font-family: var(--font-fortified-display);
    font-size: 64px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: lowercase;
    margin: 0;
  }
  .fortified-hero__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .fortified-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 0;
  }
  .fortified-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 212px;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid;
    box-sizing: border-box;
  }
  .fortified-hero__btn--primary {
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    border-color: var(--color-primary-button-background, var(--color-foreground));
  }
  .fortified-hero__btn--secondary {
    background: transparent;
    color: var(--color-secondary-button-text, var(--color-foreground));
    border-color: var(--color-secondary-button-text, var(--color-foreground));
  }

  @media (max-width: 990px) {
    .fortified-hero__frame { min-height: 480px; }
    .fortified-hero__content { padding: 64px 32px; max-width: 100%; }
    .fortified-hero__heading { font-size: 48px; }
    .fortified-hero__eyebrow { font-size: 22px; }
    .fortified-hero__body { font-size: 18px; }
  }
  @media (max-width: 749px) {
    .fortified-hero__frame { min-height: 420px; border-radius: 16px; }
    .fortified-hero__content { padding: 48px 24px; gap: 14px; }
    .fortified-hero__heading { font-size: 38px; }
    .fortified-hero__eyebrow { font-size: 18px; }
    .fortified-hero__body { font-size: 16px; }
    .fortified-hero__ctas { width: 100%; gap: 12px; }
    .fortified-hero__btn { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "01 — Hero",
  "tag": "section",
  "class": "fortified-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "Formulated for"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color, e.g. \"hydration *that hits*\". Use line breaks to split into multiple lines.",
      "default": "hydration\n*that hits*"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "Premium electrolytes that fuel your every move. Clinically dosed, clean, and zero sugar."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow text. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "01 — Hero",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
