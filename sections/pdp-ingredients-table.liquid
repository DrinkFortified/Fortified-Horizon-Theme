{% render 'fortified-base' %}

<section
  id="PdpIngredients-{{ section.id }}"
  class="pdp-ingredients"
  {{ section.shopify_attributes }}
 style="text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container">
    <header class="pdp-ingredients__head">
      <p class="pdp-ingredients__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pdp-ingredients__title">
        <span class="p-energy">{{ section.settings.energy_title }}</span>
        <span class="p-everyday">{{ section.settings.everyday_title }}</span>
      </h2>
      <p class="pdp-ingredients__intro">
        <span class="p-energy">{{ section.settings.energy_intro }}</span>
        <span class="p-everyday">{{ section.settings.everyday_intro }}</span>
      </p>
    </header>

    <div class="pdp-ingredients__table-wrap">
      <table class="pdp-ingredients__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_name }}</th>
            <th scope="col">{{ section.settings.col_dose }}</th>
            <th scope="col">{{ section.settings.col_why }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'ing_energy' %}
              <tr class="p-energy" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
                <td><strong>{{ block.settings.name }}</strong></td>
                <td>{{ block.settings.dose }}</td>
                <td>{{ block.settings.why }}</td>
              </tr>
            {% elsif block.type == 'ing_everyday' %}
              <tr class="p-everyday" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
                <td><strong>{{ block.settings.name }}</strong></td>
                <td>{{ block.settings.dose }}</td>
                <td>{{ block.settings.why }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-ingredients { background: var(--fortified-white); padding-block: clamp(40px, 6vw, 84px); font-family: var(--font-fortified-body); color: var(--fortified-black); }
  .pdp-ingredients__head { text-align: center; margin-bottom: 28px; }
  .pdp-ingredients__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fortified-gray-mid); margin: 0 0 8px; }
  .pdp-ingredients__title { font-family: var(--font-fortified-display); font-size: clamp(26px, 3.6vw, 40px); margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.02em; }
  .pdp-ingredients__intro { color: var(--fortified-gray-mid); max-width: 64ch; margin: 0 auto; font-size: 14px; }
  .pdp-ingredients__table-wrap { border: 1px solid var(--fortified-gray-light); border-radius: 18px; overflow: hidden; }
  .pdp-ingredients__table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .pdp-ingredients__table th { text-align: left; padding: 14px 18px; background: var(--fortified-off-white); font-family: var(--font-fortified-display); text-transform: uppercase; letter-spacing: 0.06em; font-size: 12px; border-bottom: 1px solid var(--fortified-gray-light); }
  .pdp-ingredients__table td { padding: 14px 18px; border-bottom: 1px solid var(--fortified-gray-light); vertical-align: top; }
  .pdp-ingredients__table tbody tr:last-child td { border-bottom: 0; }
  body[data-product="energy"] .pdp-ingredients__table tr.p-everyday { display: none; }
  body[data-product="everyday"] .pdp-ingredients__table tr.p-energy { display: none; }
  body[data-product="energy"] .pdp-ingredients__title .p-everyday,
  body[data-product="energy"] .pdp-ingredients__intro .p-everyday,
  body[data-product="everyday"] .pdp-ingredients__title .p-energy,
  body[data-product="everyday"] .pdp-ingredients__intro .p-energy { display: none; }
{% endstylesheet %}

