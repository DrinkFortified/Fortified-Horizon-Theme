{% render 'fortified-base' %}

<section
  id="FortifiedDayBenefits-{{ section.id }}"
  class="fortified-day color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-day__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-day__inner">
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2 fortified-day__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="fortified-day__scroll">
      <div class="fortified-day__row" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-day-column' %}
            <article class="fortified-day__col" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 120 | image_tag:
                    widths: '60, 90, 120',
                    sizes: '60px',
                    class: 'fortified-day__icon',
                    alt: block.settings.heading,
                    loading: 'lazy' }}
              {% endif %}
              {% if block.settings.day_label != blank %}
                <span class="fortified-day__label">{{ block.settings.day_label }}</span>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="fortified-day__title">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <p class="fortified-day__body">{{ block.settings.body }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary fortified-day__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-day {
    position: relative;
    background: var(--fortified-black);
    color: #fff;
    padding-block: var(--fortified-section-py);
    isolation: isolate;
    overflow: hidden;
  }
  .fortified-day__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: .35;
  }
  .fortified-day::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / .55), rgb(0 0 0 / .8));
    z-index: -1;
  }
  .fortified-day__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .fortified-day__heading { text-align: center; max-width: 800px; margin: 0; }
  .fortified-day__scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .fortified-day__scroll::-webkit-scrollbar { display: none; }
  .fortified-day__row {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(12px, 1.6vw, 24px);
  }
  .fortified-day__col {
    flex: 0 0 auto;
    width: clamp(180px, 18vw, 240px);
    background: rgb(255 255 255 / .06);
    backdrop-filter: blur(6px);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid rgb(255 255 255 / .1);
  }
  @media (min-width: 1024px) {
    .fortified-day__row { width: 100%; }
    .fortified-day__col { flex: 1; }
  }
  .fortified-day__icon { width: 48px; height: 48px; object-fit: contain; }
  .fortified-day__label {
    font-family: var(--font-fortified-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fortified-teal);
  }
  .fortified-day__title {
    font-family: var(--font-fortified-display);
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .fortified-day__body {
    font-family: var(--font-fortified-body);
    font-size: 13px;
    line-height: 1.55;
    margin: 0;
    opacity: .85;
  }
{% endstylesheet %}

