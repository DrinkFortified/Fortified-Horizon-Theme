{% render 'fortified-base' %}

<section
  id="FortifiedDayBenefits-{{ section.id }}"
  class="fortified-day color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--day-bg-image: {% if section.settings.image %}url({{ section.settings.image | image_url: width: 2400 }}){% else %}linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%){% endif %}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-day__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-day__inner">
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2 fortified-day__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="fortified-day__scroll">
      <div class="fortified-day__row" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-day-column' %}
            <article class="fortified-day__col" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 120 | image_tag:
                    widths: '60, 90, 120',
                    sizes: '60px',
                    class: 'fortified-day__icon',
                    alt: block.settings.heading,
                    loading: 'lazy' }}
              {% endif %}
              {% if block.settings.day_label != blank %}
                <span class="fortified-day__label">{{ block.settings.day_label }}</span>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="fortified-day__title">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <p class="fortified-day__body">{{ block.settings.body }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary fortified-day__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-day {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    min-height: clamp(360px, 40vw, 520px);
    display: flex;
    align-items: center;
  }
  .fortified-day::before {
    content: '';
    position: absolute; inset: 0; z-index: -2;
    background-image: var(--day-bg-image, linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%));
    background-size: cover; background-position: center;
  }
  .fortified-day::after {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.55) 100%);
  }
  .fortified-day__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 3vw, 40px);
    width: 100%;
  }
  .fortified-day__header { text-align: center; max-width: 720px; }
  .fortified-day__header h2 { color: #fff; }
  .fortified-day__timeline {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    width: 100%;
  }
  @media (min-width: 750px) {
    .fortified-day__timeline { grid-template-columns: repeat(5, 1fr); }
  }
  .fortified-day__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    padding: 16px 8px;
  }
  .fortified-day__step-icon {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: 1.5px solid rgba(255,255,255,0.3);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 22px;
    color: #fff;
  }
  .fortified-day__step-label {
    font-family: var(--font-fortified-display);
    font-size: 12px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #FFD75A;
  }
  .fortified-day__step-title {
    font-family: var(--font-fortified-display);
    font-size: 14px; font-weight: 700;
    color: #fff;
  }
  .fortified-day__step-desc {
    font-size: 11.5px;
    color: rgba(255,255,255,0.75);
    line-height: 1.45;
  }
  .fortified-day__cta {
    background: rgba(255,255,255,0.12);
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.45);
    backdrop-filter: blur(6px);
  }
  .fortified-day__cta:hover { background: rgba(255,255,255,0.2); }
{% endstylesheet %}

