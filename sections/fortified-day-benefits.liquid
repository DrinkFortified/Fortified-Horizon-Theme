{% render 'fortified-base' %}

<section
  id="FortifiedDayBenefits-{{ section.id }}"
  class="fortified-day color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 80 }}px {{ section.settings['padding-block-end'] | default: 80 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 40 }}px {{ section.settings['padding-inline-end'] | default: 40 }}px;"
>
  <div class="fortified-day__inner">
    <div class="fortified-day__content">
      <div class="fortified-day__header">
        {% if section.settings.eyebrow != blank %}
          <p class="fortified-day__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="fortified-day__heading">{% render 'fortified-accent-text', text: section.settings.heading %}</h2>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <ul class="fortified-day__list">
          {% for block in section.blocks %}
            {% if block.type == 'fortified-day-column' %}
              <li {{ block.shopify_attributes }}>
                <span class="fortified-day__icon" aria-hidden="true">
                  {% if block.settings.icon != blank %}
                    {{ block.settings.icon | image_url: width: 84 | image_tag:
                        widths: '42, 84',
                        sizes: '42px',
                        alt: '',
                        loading: 'lazy' }}
                  {% else %}✓{% endif %}
                </span>
                <span class="fortified-day__text">{% render 'fortified-accent-text', text: block.settings.heading | default: block.settings.day_label %}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-day__cta">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>

    <div class="fortified-day__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag:
            widths: '600, 900, 1200, 1800',
            sizes: '(min-width: 990px) 824px, 100vw',
            class: 'fortified-day__img',
            alt: section.settings.heading,
            loading: 'lazy' }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-day {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-day__inner {
    display: flex;
    align-items: center;
    gap: 137px;
    width: 100%;
    max-width: var(--fortified-container);
    margin-inline: auto;
  }
  .fortified-day__content {
    width: 479px;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 52px;
    color: var(--color-foreground);
  }
  .fortified-day__header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-transform: uppercase;
  }
  .fortified-day__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    margin: 0;
  }
  .fortified-day__heading {
    font-family: var(--font-fortified-display);
    font-size: 72px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-day__list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 411px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .fortified-day__list li {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--font-fortified-body);
    font-size: 32px;
    line-height: 1;
    color: var(--color-foreground);
    text-transform: capitalize;
  }
  .fortified-day__icon {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--fortified-accent);
    color: var(--color-background);
    font-weight: 700;
    font-size: 20px;
  }
  .fortified-day__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }
  .fortified-day__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    box-sizing: border-box;
  }
  .fortified-day__media {
    flex: 1 1 0;
    min-width: 0;
    height: 700px;
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }
  .fortified-day__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 990px) {
    .fortified-day__inner { gap: 48px; flex-direction: column; align-items: stretch; }
    .fortified-day__content { width: 100%; gap: 32px; }
    .fortified-day__list { width: 100%; gap: 20px; }
    .fortified-day__list li { font-size: 22px; }
    .fortified-day__heading { font-size: 48px; }
    .fortified-day__eyebrow { font-size: 22px; }
    .fortified-day__media { height: 480px; width: 100%; }
  }
  @media (max-width: 749px) {
    .fortified-day__heading { font-size: 36px; }
    .fortified-day__cta { height: 60px; font-size: 20px; }
    .fortified-day__media { height: 360px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP-06 — Day Benefits",
  "tag": "section",
  "class": "fortified-day-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Formulated for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "your *best day*"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right-side image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "ADD TO CART - $28.99"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow and checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fortified-day-column",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Text",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Improve hydration"
        },
        {
          "type": "text",
          "id": "day_label",
          "label": "Day label (fallback)"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body (unused)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP-06 — Day Benefits",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        { "type": "fortified-day-column", "settings": { "heading": "Improve hydration" } },
        { "type": "fortified-day-column", "settings": { "heading": "Boost energy naturally" } },
        { "type": "fortified-day-column", "settings": { "heading": "support muscle function" } },
        { "type": "fortified-day-column", "settings": { "heading": "reduce fatigue" } },
        { "type": "fortified-day-column", "settings": { "heading": "gut friendly formula" } }
      ]
    }
  ]
}
{% endschema %}
