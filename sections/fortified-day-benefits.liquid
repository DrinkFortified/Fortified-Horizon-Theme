{% render 'fortified-base' %}

<section
  id="FortifiedDayBenefits-{{ section.id }}"
  class="fortified-day color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; --day-bg-image: {% if section.settings.image %}url({{ section.settings.image | image_url: width: 2400 }}){% else %}linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%){% endif %}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-day__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-day__inner">
    {% if section.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2 fortified-day__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="fortified-day__scroll">
      <div class="fortified-day__row" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-day-column' %}
            <article class="fortified-day__col" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                {{ block.settings.icon | image_url: width: 120 | image_tag:
                    widths: '60, 90, 120',
                    sizes: '60px',
                    class: 'fortified-day__icon',
                    alt: block.settings.heading,
                    loading: 'lazy' }}
              {% endif %}
              {% if block.settings.day_label != blank %}
                <span class="fortified-day__label">{{ block.settings.day_label }}</span>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="fortified-day__title">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <p class="fortified-day__body">{{ block.settings.body }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary fortified-day__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-day {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-day__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .fortified-day::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--color-foreground) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-foreground) 55%, transparent) 100%);
    pointer-events: none;
  }
  .fortified-day__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 3vw, 40px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
    padding-block: clamp(56px, 7vw, 96px);
    position: relative;
    z-index: 1;
  }
  .fortified-day__heading {
    text-align: center;
    color: var(--color-background);
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 720px;
    margin: 0;
  }
  .fortified-day__scroll {
    width: 100%;
    overflow-x: auto;
  }
  .fortified-day__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    width: 100%;
  }
  @media (min-width: 750px) {
    .fortified-day__row { grid-template-columns: repeat(5, 1fr); }
  }
  .fortified-day__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 20px 12px;
    background: color-mix(in srgb, var(--color-background) 8%, transparent);
    backdrop-filter: blur(6px);
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--color-background) 12%, transparent);
    color: var(--color-background);
  }
  .fortified-day__icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }
  .fortified-day__label {
    font-family: var(--font-fortified-display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fortified-accent, var(--color-background));
  }
  .fortified-day__title {
    font-family: var(--font-fortified-display);
    font-weight: 700;
    font-size: 14px;
    margin: 0;
    color: var(--color-background);
    line-height: 1.2;
  }
  .fortified-day__body {
    font-size: 11.5px;
    line-height: 1.45;
    opacity: 0.85;
    margin: 0;
  }
  .fortified-day__cta {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: 14px 32px;
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 48px;
  }
{% endstylesheet %}

