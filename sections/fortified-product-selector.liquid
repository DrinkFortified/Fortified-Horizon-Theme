{% comment %}
  Section: Product Selector
  Category: Fortified Elements
  Purpose: Function + Flavor product configurator with Loop subscriptions
{% endcomment %}

{%- liquid
  assign section_id      = section.id
  assign heading         = section.settings.heading
  assign subheading      = section.settings.subheading
  assign show_monthly    = section.settings.show_monthly
  assign show_3months    = section.settings.show_3months
  assign img_position    = section.settings.image_position | default: 'center center'
  assign img_padding     = section.settings.image_padding | default: 0
  assign btn_style       = section.settings.button_style | default: 'filled'
  assign function_blocks = section.blocks | where: "type", "function_item"
  assign flavor_blocks   = section.blocks | where: "type", "flavor_item"
-%}

<section
  id="fe-{{ section_id }}"
  class="fe-section color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section_id }}"
  style="
    --fe-btn-radius: {{ section.settings.button_radius }}px;
    --fe-border-radius: {{ section.settings.card_radius }}px;
    --fe-section-pt: {{ section.settings.padding_top }}px;
    --fe-section-pb: {{ section.settings.padding_bottom }}px;
    --fe-img-padding: {{ img_padding }}px;
    --fe-img-position: {{ img_position }};
    --fe-media-height-mobile: {{ section.settings.media_height_mobile }}px;
    --fe-media-height-desktop: {{ section.settings.media_height_desktop }}px;
    --fe-selection-color: {{ section.settings.selection_color }};
    --fe-panel-width: {{ section.settings.panel_width }}px;
    --fe-max-width: {{ section.settings.content_max_width }}px;
  "
>
  <div class="fe-container" data-layout="{{ section.settings.layout_direction | default: 'image-left' }}">

    {%- comment %} ── LEFT: MEDIA COLUMN ── {%- endcomment %}
    <div class="fe-media-cover" id="fe-media-cover-{{ section_id }}">
      <div class="fe-media-inner">

        {%- comment %} DEFAULT SLIDE — shown before any function is chosen {%- endcomment %}
        <div class="fe-media-slide fe-media-default is-active" id="fe-media-default-{{ section_id }}">
          {%- if section.settings.cover_image != blank -%}
            <img
              class="fe-cover-img"
              src="{{ section.settings.cover_image | image_url: width: 1400 }}"
              srcset="{{ section.settings.cover_image | image_url: width: 600 }} 600w, {{ section.settings.cover_image | image_url: width: 1000 }} 1000w, {{ section.settings.cover_image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 900px) 50vw, 100vw"
              alt="{{ heading | escape }}"
              width="1400" height="700"
              loading="eager"
            >
          {%- else -%}
            <div class="fe-media-placeholder"><span>{{ heading }}</span></div>
          {%- endif -%}
        </div>

        {%- comment %} FUNCTION SLIDES — image comes from the product's featured image via JS {%- endcomment %}
        {%- for block in function_blocks -%}
          {%- if block.settings.enabled -%}
            <div
              class="fe-media-slide"
              data-function-media="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {%- comment %} Placeholder until JS loads the product image {%- endcomment %}
              <img
                class="fe-cover-img"
                data-base-src=""
                src=""
                alt="{{ block.settings.function_label | escape }}"
                loading="lazy"
                width="1400" height="700"
                style="opacity:0;"
              >
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    </div>

    {%- comment %} ── RIGHT: SELECTOR PANEL ── {%- endcomment %}
    <div class="fe-panel color-{{ section.settings.panel_color_scheme }}" id="fe-panel-{{ section_id }}">

      {%- if heading != blank or subheading != blank -%}
        <div class="fe-panel-heading">
          {%- if heading != blank -%}<h2 class="fe-heading">{{ heading }}</h2>{%- endif -%}
          {%- if subheading != blank -%}<p class="fe-subheading">{{ subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- comment %} STEP 1: FUNCTION {%- endcomment %}
      <div class="fe-group fe-step" id="fe-function-group-{{ section_id }}" data-step="function">
        <p class="fe-group-label">
          <span class="fe-step-num">1</span>
          {{ section.settings.function_label | default: 'Choose Your Function' }}
        </p>
        <div class="fe-selector-grid fe-selector-grid--function" role="group" aria-label="Function">
          {%- for block in function_blocks -%}
            {%- if block.settings.enabled -%}
              <button
                class="fe-selector-card"
                data-function-id="{{ block.id }}"
                data-product-handle="{{ block.settings.product.handle }}"
                data-function-label="{{ block.settings.function_label | escape }}"
                data-loop-plan-monthly="{{ block.settings.loop_plan_monthly }}"
                data-loop-plan-quarterly="{{ block.settings.loop_plan_quarterly }}"
                data-thumbnail="{% if block.settings.thumbnail_image != blank %}{{ block.settings.thumbnail_image | image_url: width: 160 }}{% endif %}"
                aria-pressed="false"
                {%- if block.settings.coming_soon %}data-coming-soon="true" aria-disabled="true"{%- endif %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.pill_icon != blank -%}
                  <span class="fe-card-icon" aria-hidden="true">
                    <img src="{{ block.settings.pill_icon | image_url: width: 64 }}" alt="" width="24" height="24">
                  </span>
                {%- endif -%}
                <span class="fe-card-label">
                  {{ block.settings.function_label }}
                  {%- if block.settings.coming_soon -%}
                    <em class="fe-badge">{{ section.settings.coming_soon_text | default: 'Soon' }}</em>
                  {%- endif -%}
                </span>
                <span class="fe-card-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><polyline points="1.5,6 4.5,9 10.5,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment %} STEP 2: FLAVOR — locked until function chosen {%- endcomment %}
      <div class="fe-group fe-step fe-step--locked" id="fe-flavor-group-{{ section_id }}" data-step="flavor" aria-disabled="true">
        <p class="fe-group-label">
          <span class="fe-step-num">2</span>
          {{ section.settings.flavor_label | default: 'Choose Your Flavor' }}
        </p>
        <div class="fe-selector-grid fe-selector-grid--flavor" role="group" aria-label="Flavor">
          {%- for block in flavor_blocks -%}
            {%- if block.settings.enabled -%}
              <button
                class="fe-selector-card"
                data-flavor-id="{{ block.id }}"
                data-flavor-name="{{ block.settings.flavor_name | escape }}"
                data-thumbnail="{% if block.settings.thumbnail_image != blank %}{{ block.settings.thumbnail_image | image_url: width: 160 }}{% endif %}"
                aria-pressed="false"
                disabled
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.pill_icon != blank -%}
                  <span class="fe-card-icon" aria-hidden="true">
                    <img src="{{ block.settings.pill_icon | image_url: width: 64 }}" alt="" width="24" height="24">
                  </span>
                {%- endif -%}
                <span class="fe-card-label">{{ block.settings.flavor_name }}</span>
                <span class="fe-card-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><polyline points="1.5,6 4.5,9 10.5,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment %} STEP 3: PURCHASE — locked until flavor chosen {%- endcomment %}
      <div class="fe-group fe-step fe-step--locked" id="fe-purchase-group-{{ section_id }}" data-step="purchase" aria-disabled="true">
        <p class="fe-group-label">
          <span class="fe-step-num">3</span>
          {{ section.settings.purchase_label | default: 'Purchase Option' }}
        </p>
        <div class="fe-purchase-options" role="group" aria-label="Purchase option">

          <label class="fe-purchase-option">
            <input type="radio" name="fe-purchase-{{ section_id }}" value="onetime" disabled>
            <span class="fe-radio-dot" aria-hidden="true"></span>
            <span class="fe-purchase-inner">
              <span class="fe-purchase-top">
                <span class="fe-purchase-title">{{ section.settings.onetime_label | default: 'Buy Once' }}</span>
                <span class="fe-purchase-price" data-price-type="onetime">--</span>
              </span>
              {%- if section.settings.onetime_description != blank -%}
                <span class="fe-purchase-desc">{{ section.settings.onetime_description }}</span>
              {%- endif -%}
            </span>
          </label>

          {%- if show_monthly -%}
          <label class="fe-purchase-option">
            <input type="radio" name="fe-purchase-{{ section_id }}" value="monthly" disabled>
            <span class="fe-radio-dot" aria-hidden="true"></span>
            <span class="fe-purchase-inner">
              <span class="fe-purchase-top">
                <span class="fe-purchase-title">
                  {{ section.settings.monthly_label | default: 'Monthly' }}
                  {%- if section.settings.monthly_badge != blank -%}
                    <em class="fe-save-badge">{{ section.settings.monthly_badge }}</em>
                  {%- endif -%}
                </span>
                <span class="fe-purchase-price" data-price-type="monthly">--</span>
              </span>
              {%- if section.settings.monthly_description != blank -%}
                <span class="fe-purchase-desc">{{ section.settings.monthly_description }}</span>
              {%- endif -%}
            </span>
          </label>
          {%- endif -%}

          {%- if show_3months -%}
          <label class="fe-purchase-option">
            <input type="radio" name="fe-purchase-{{ section_id }}" value="quarterly" disabled>
            <span class="fe-radio-dot" aria-hidden="true"></span>
            <span class="fe-purchase-inner">
              <span class="fe-purchase-top">
                <span class="fe-purchase-title">
                  {{ section.settings.quarterly_label | default: 'Every 3 Months' }}
                  {%- if section.settings.quarterly_badge != blank -%}
                    <em class="fe-save-badge">{{ section.settings.quarterly_badge }}</em>
                  {%- endif -%}
                </span>
                <span class="fe-purchase-price" data-price-type="quarterly">--</span>
              </span>
              {%- if section.settings.quarterly_description != blank -%}
                <span class="fe-purchase-desc">{{ section.settings.quarterly_description }}</span>
              {%- endif -%}
            </span>
          </label>
          {%- endif -%}

        </div>
      </div>

      {%- comment %} PRODUCT SUMMARY {%- endcomment %}
      <div class="fe-group">
        <p class="fe-group-label">{{ section.settings.summary_label | default: 'Your Order' }}</p>
        <div class="fe-product-summary" id="fe-product-summary-{{ section_id }}" aria-live="polite">
          <div class="fe-product-thumb-wrap">
            <img class="fe-product-thumb" id="fe-product-thumb-{{ section_id }}" src="" alt="" width="120" height="120">
          </div>
          <div class="fe-product-info">
            <p class="fe-product-name" id="fe-product-name-{{ section_id }}">--</p>
            <p class="fe-product-variant" id="fe-product-variant-{{ section_id }}">--</p>
          </div>
        </div>
      </div>

      {%- comment %} ADD TO CART {%- endcomment %}
      <div class="fe-atc-wrap">
        <button
          class="fe-atc-btn fe-atc-btn--{{ btn_style }}"
          id="fe-atc-{{ section_id }}"
          data-section-id="{{ section_id }}"
          disabled
          aria-disabled="true"
        >
          <span class="fe-atc-label">{{ section.settings.atc_label | default: 'Add to Cart' }}</span>
          <span class="fe-atc-loading" aria-hidden="true"></span>
        </button>
        <p class="fe-atc-message" id="fe-atc-msg-{{ section_id }}" aria-live="polite"></p>
      </div>

    </div>
  </div>
</section>

<style>
#fe-{{ section_id }} *,
#fe-{{ section_id }} *::before,
#fe-{{ section_id }} *::after { box-sizing: border-box; }

.fe-section {
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  font-family: inherit;
  overflow: hidden;
  padding-top: var(--fe-section-pt, 0px);
  padding-bottom: var(--fe-section-pb, 0px);
}

/* ── Layout ── */
.fe-container {
  display: grid;
  grid-template-columns: 1fr;
  max-width: var(--fe-max-width, 1400px);
  margin: 0 auto;
  width: 100%;
}

@media (min-width: 900px) {
  .fe-container {
    grid-template-columns: 1fr var(--fe-panel-width, 420px);
  }

  /* Panel on the left: swap column order */
  .fe-container[data-layout="panel-left"] {
    grid-template-columns: var(--fe-panel-width, 420px) 1fr;
  }

  .fe-container[data-layout="panel-left"] .fe-media-cover {
    order: 2;
  }

  .fe-container[data-layout="panel-left"] .fe-panel {
    order: 1;
    border-left: none;
    border-right: 1px solid rgba(var(--color-foreground), 0.06);
  }
}

/* ── Media column ── */
.fe-media-cover {
  position: relative;
  overflow: hidden;
  height: var(--fe-media-height-mobile, 420px);
  background: rgb(var(--color-background));
}

@media (min-width: 900px) {
  .fe-media-cover {
    height: var(--fe-media-height-desktop, 560px);
    min-height: 300px;
  }
}

.fe-media-inner { position: absolute; inset: 0; background: rgb(var(--color-background)); }

.fe-media-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.55s ease;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(var(--color-background));
  padding: var(--fe-img-padding, 0px);
}

.fe-media-slide.is-active { opacity: 1; pointer-events: auto; }

.fe-cover-img {
  width: 100%; height: 100%;
  object-fit: contain;
  object-position: var(--fe-img-position, center center);
  display: block;
  transition: opacity 0.35s ease;
}

.fe-video {
  width: 100%; height: 100%;
  object-fit: contain;
  object-position: var(--fe-img-position, center center);
  display: block;
}

.fe-media-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(var(--color-foreground), 0.25);
  font-size: 1rem; letter-spacing: 0.08em;
}

/* ── Panel ── */
.fe-panel {
  background: rgb(var(--color-background));
  padding: 2rem 1.5rem;
  display: flex; flex-direction: column; gap: 1.75rem;
  border-left: 1px solid rgba(var(--color-foreground), 0.06);
}

@media (min-width: 900px) { .fe-panel { padding: 2.5rem 2rem; } }

.fe-panel-heading { padding-bottom: 1.25rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); }

.fe-heading {
  margin: 0 0 0.3em;
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  font-weight: 700; line-height: 1.1;
  color: rgb(var(--color-foreground));
}

.fe-subheading { margin: 0; font-size: 0.88rem; line-height: 1.5; opacity: 0.6; color: rgb(var(--color-foreground)); }

/* ── Step groups ── */
.fe-group-label {
  display: flex; align-items: center; gap: 0.5rem;
  margin: 0 0 0.85rem;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: rgb(var(--color-foreground));
}

.fe-step-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: 50%;
  background: rgb(var(--color-button)); color: rgb(var(--color-button-label));
  font-size: 0.65rem; font-weight: 800; flex-shrink: 0;
}

/* Locked state — grayed out, non-interactive */
.fe-step--locked {
  opacity: 0.38;
  pointer-events: none;
  user-select: none;
}

.fe-step--locked .fe-step-num {
  background: rgba(var(--color-foreground), 0.2);
  color: rgba(var(--color-foreground), 0.6);
}

/* ── Selector cards (functions + flavors) ── */
.fe-selector-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.fe-selector-card {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.55rem 1rem;
  border-radius: 9999px;
  border: 2px solid rgba(var(--color-foreground), 0.15);
  background: transparent;
  color: rgba(var(--color-foreground), 0.7);
  font-size: 0.85rem; font-weight: 500;
  cursor: pointer; white-space: nowrap;
  transition: border-color 0.18s, color 0.18s, background 0.18s, box-shadow 0.18s;
}

.fe-selector-card:hover:not(:disabled):not([data-coming-soon]) {
  border-color: rgba(var(--color-foreground), 0.4);
  color: rgb(var(--color-foreground));
}

/* Selected state — border + fill using customisable selection color */
.fe-selector-card.is-active {
  border-color: var(--fe-selection-color, rgb(var(--color-button)));
  background: var(--fe-selection-color, rgb(var(--color-button)));
  color: rgb(var(--color-button-label));
  font-weight: 700;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--fe-selection-color, rgb(var(--color-button))) 25%, transparent);
}

/* Checkmark — hidden by default, shown when active */
.fe-card-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px; height: 16px;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  opacity: 0;
  transform: scale(0.5);
  transition: opacity 0.18s, transform 0.18s;
  flex-shrink: 0;
}

.fe-selector-card.is-active .fe-card-check {
  opacity: 1;
  transform: scale(1);
}

.fe-selector-card[data-coming-soon] { opacity: 0.4; cursor: not-allowed; }
.fe-selector-card:disabled { cursor: not-allowed; }

/* Icon — left side, square container */
.fe-card-icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 24px; height: 24px;
  flex-shrink: 0; overflow: hidden; border-radius: 4px;
}

.fe-card-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }

.fe-card-label { flex: 1; display: inline-flex; align-items: center; gap: 0.35rem; }

.fe-badge {
  font-style: normal; font-size: 0.58rem; font-weight: 700;
  letter-spacing: 0.07em; text-transform: uppercase;
  padding: 0.12em 0.5em; border-radius: 9999px;
  background: rgba(var(--color-foreground), 0.15); color: inherit;
}

/* ── Purchase options ── */
.fe-purchase-options { display: flex; flex-direction: column; gap: 0.6rem; }

.fe-purchase-option {
  display: flex; align-items: flex-start; gap: 0.85rem;
  padding: 1rem 1.1rem;
  border: 2px solid rgba(var(--color-foreground), 0.12);
  border-radius: var(--fe-border-radius, 12px);
  background: transparent; cursor: pointer; position: relative;
  transition: border-color 0.18s, background 0.18s, box-shadow 0.18s;
}

.fe-purchase-option:hover:not(:has(input:disabled)) {
  border-color: rgba(var(--color-foreground), 0.3);
}

.fe-purchase-option.is-active {
  border-color: var(--fe-selection-color, rgb(var(--color-button)));
  background: color-mix(in srgb, var(--fe-selection-color, rgb(var(--color-button))) 8%, transparent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--fe-selection-color, rgb(var(--color-button))) 18%, transparent),
              inset 4px 0 0 var(--fe-selection-color, rgb(var(--color-button)));
}

.fe-purchase-option input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }

.fe-radio-dot {
  flex-shrink: 0; width: 18px; height: 18px; border-radius: 50%;
  border: 2px solid rgba(var(--color-foreground), 0.25);
  margin-top: 2px; position: relative; transition: border-color 0.18s;
}

.fe-radio-dot::after {
  content: ''; position: absolute; inset: 3px; border-radius: 50%;
  background: var(--fe-selection-color, rgb(var(--color-button))); opacity: 0; transform: scale(0.4);
  transition: opacity 0.18s, transform 0.18s;
}

.fe-purchase-option.is-active .fe-radio-dot { border-color: var(--fe-selection-color, rgb(var(--color-button))); }
.fe-purchase-option.is-active .fe-radio-dot::after { opacity: 1; transform: scale(1); }

.fe-purchase-inner { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; }
.fe-purchase-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
.fe-purchase-title { font-size: 0.9rem; font-weight: 700; color: rgb(var(--color-foreground)); display: flex; align-items: center; gap: 0.4rem; }
.fe-purchase-desc { font-size: 0.75rem; opacity: 0.5; color: rgb(var(--color-foreground)); line-height: 1.4; }

.fe-save-badge {
  font-style: normal; font-size: 0.6rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  padding: 0.15em 0.6em; border-radius: 9999px;
  background: rgb(var(--color-button)); color: rgb(var(--color-button-label));
}

.fe-purchase-price { font-size: 0.92rem; font-weight: 800; color: rgb(var(--color-button)); white-space: nowrap; flex-shrink: 0; }

/* ── Product summary ── */
.fe-product-summary {
  display: flex; align-items: center; gap: 1rem; padding: 1rem;
  border-radius: var(--fe-border-radius, 12px);
  background: rgba(var(--color-foreground), 0.04);
  border: 1px solid rgba(var(--color-foreground), 0.08); min-height: 80px;
}

.fe-product-thumb-wrap { flex-shrink: 0; width: 64px; height: 64px; border-radius: 8px; overflow: hidden; background: rgba(var(--color-foreground), 0.06); }
.fe-product-thumb { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0; transition: opacity 0.3s; }
.fe-product-thumb.is-loaded { opacity: 1; }
.fe-product-info { flex: 1; min-width: 0; }
.fe-product-name { margin: 0 0 0.2em; font-size: 0.88rem; font-weight: 700; color: rgb(var(--color-foreground)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fe-product-variant { margin: 0; font-size: 0.75rem; opacity: 0.5; color: rgb(var(--color-foreground)); }

/* ── ATC button ── */
.fe-atc-wrap { display: flex; flex-direction: column; gap: 0.5rem; }

.fe-atc-btn {
  display: flex; align-items: center; justify-content: center; gap: 0.75rem;
  width: 100%; padding: 0.9rem 1.5rem;
  border-radius: var(--fe-btn-radius, var(--buttons-radius, 9999px));
  font-size: 0.95rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  cursor: pointer; overflow: hidden;
  transition: filter 0.2s, transform 0.15s, background 0.2s, color 0.2s, border-color 0.2s;
}

/* Filled — uses the scheme's button token exactly as Horizon does */
.fe-atc-btn--filled {
  background: rgb(var(--color-button));
  color: rgb(var(--color-button-label));
  border: none;
  box-shadow: 0 0 0 var(--buttons-border-width, 0px) rgba(var(--color-button), var(--buttons-border-opacity, 0));
}

.fe-atc-btn--filled:hover:not([disabled]):not([aria-disabled="true"]) {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

/* Outline — border in button color, transparent background */
.fe-atc-btn--outline {
  background: transparent;
  color: rgb(var(--color-button));
  border: 2px solid rgb(var(--color-button));
}

.fe-atc-btn--outline:hover:not([disabled]):not([aria-disabled="true"]) {
  background: rgb(var(--color-button));
  color: rgb(var(--color-button-label));
  transform: translateY(-1px);
}

/* Ghost — no border, foreground color text */
.fe-atc-btn--ghost {
  background: transparent;
  color: rgb(var(--color-foreground));
  border: none;
}

.fe-atc-btn--ghost:hover:not([disabled]):not([aria-disabled="true"]) {
  background: rgba(var(--color-foreground), 0.06);
  transform: translateY(-1px);
}

.fe-atc-btn[disabled],
.fe-atc-btn[aria-disabled="true"] {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none;
  filter: none;
}

.fe-atc-loading { width: 16px; height: 16px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; display: none; animation: fe-spin 0.7s linear infinite; }
.fe-atc-btn.is-loading .fe-atc-loading { display: block; }
.fe-atc-btn.is-loading .fe-atc-label { opacity: 0.5; }
@keyframes fe-spin { to { transform: rotate(360deg); } }

.fe-atc-message { margin: 0; font-size: 0.8rem; text-align: center; min-height: 1.2em; color: rgb(var(--color-button)); }
.fe-atc-message.is-error { color: rgb(var(--color-error, 176 0 0)); }

@media (prefers-reduced-motion: reduce) {
  .fe-media-slide, .fe-cover-img, .fe-selector-card,
  .fe-purchase-option, .fe-radio-dot::after, .fe-card-check { transition: none; }
}
</style>

<script>
(function () {
  'use strict';

  var SECTION_ID   = {{ section_id | json }};
  var SHOW_MONTHLY = {{ show_monthly | json }};
  var SHOW_3MONTHS = {{ show_3months | json }};

  var FUNCTIONS = [
    {%- for block in function_blocks -%}
      {%- if block.settings.enabled -%}
        {
          id:            {{ block.id | json }},
          label:         {{ block.settings.function_label | json }},
          handle:        {{ block.settings.product.handle | json }},
          comingSoon:    {{ block.settings.coming_soon | json }},
          planMonthly:   {{ block.settings.loop_plan_monthly | json }},
          planQuarterly: {{ block.settings.loop_plan_quarterly | json }},
          thumbnail:     "{% if block.settings.thumbnail_image != blank %}{{ block.settings.thumbnail_image | image_url: width: 160 }}{% endif %}",
        },
      {%- endif -%}
    {%- endfor -%}
  ];

  var FLAVORS = [
    {%- for block in flavor_blocks -%}
      {%- if block.settings.enabled -%}
        {
          id:        {{ block.id | json }},
          name:      {{ block.settings.flavor_name | json }},
          thumbnail: "{% if block.settings.thumbnail_image != blank %}{{ block.settings.thumbnail_image | image_url: width: 160 }}{% endif %}",
        },
      {%- endif -%}
    {%- endfor -%}
  ];

  /* ── State ── */
  var state = {
    functionId:    null,   /* null = not yet chosen */
    handle:        null,
    planMonthly:   null,
    planQuarterly: null,
    flavorName:    null,   /* null = not yet chosen */
    purchaseType:  null,   /* null = not yet chosen */
    product:       null,
    variant:       null,
  };

  /* ── DOM ── */
  var root    = document.getElementById('fe-' + SECTION_ID);
  if (!root) return;

  var atcBtn  = root.querySelector('#fe-atc-' + SECTION_ID);
  var atcMsg  = root.querySelector('#fe-atc-msg-' + SECTION_ID);
  var thumbEl = root.querySelector('#fe-product-thumb-' + SECTION_ID);
  var nameEl  = root.querySelector('#fe-product-name-' + SECTION_ID);
  var varEl   = root.querySelector('#fe-product-variant-' + SECTION_ID);

  var flavorGroup   = root.querySelector('#fe-flavor-group-' + SECTION_ID);
  var purchaseGroup = root.querySelector('#fe-purchase-group-' + SECTION_ID);

  /* ── Utilities ── */
  function formatMoney(cents) {
    return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  }

  function setAtcMsg(msg, isError) {
    if (!atcMsg) return;
    atcMsg.textContent = msg;
    atcMsg.classList.toggle('is-error', !!isError);
  }

  function pushEvent(event, data) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({ event: event, section_id: SECTION_ID, section_type: 'fortified-elements' }, data));
  }

  function cleanSrc(src) { return (src || '').split('?')[0]; }

  /* ── Step locking ── */
  function unlockGroup(group) {
    if (!group) return;
    group.classList.remove('fe-step--locked');
    group.removeAttribute('aria-disabled');
    group.querySelectorAll('button, input').forEach(function(el) {
      el.removeAttribute('disabled');
    });
  }

  function lockGroup(group) {
    if (!group) return;
    group.classList.add('fe-step--locked');
    group.setAttribute('aria-disabled', 'true');
    group.querySelectorAll('button, input').forEach(function(el) {
      el.setAttribute('disabled', '');
    });
  }

  /* ── Product cache ── */
  var productCache = {};

  function fetchProduct(handle) {
    if (!handle) return Promise.resolve(null);
    if (productCache[handle]) return Promise.resolve(productCache[handle]);
    return fetch('/products/' + handle + '.js')
      .then(function(res) { return res.ok ? res.json() : null; })
      .then(function(data) { if (data) productCache[handle] = data; return data; })
      .catch(function() { return null; });
  }

  /* ── Variant resolution ── */
  function findVariant(product, flavorName) {
    if (!product || !product.variants.length) return null;
    var fl = (flavorName || '').toLowerCase().trim();
    if (!fl) return product.variants.find(function(v) { return v.available; }) || product.variants[0];

    var match = product.variants.find(function(v) {
      return v.options.some(function(o) { return o.toLowerCase() === fl; }) && v.available;
    });
    if (!match) match = product.variants.find(function(v) {
      return v.options.some(function(o) { return o.toLowerCase() === fl; });
    });
    if (!match) match = product.variants.find(function(v) {
      return v.title.toLowerCase().indexOf(fl) !== -1 && v.available;
    });
    if (!match) match = product.variants.find(function(v) { return v.available; });
    return match || product.variants[0];
  }

  /* ── Selling plan ── */
  function findSellingPlanId(product, loopPlanId) {
    if (!product || !loopPlanId) return null;
    var id = parseInt(loopPlanId, 10);
    var groups = product.selling_plan_groups || [];
    for (var i = 0; i < groups.length; i++) {
      var plans = groups[i].selling_plans || [];
      for (var j = 0; j < plans.length; j++) {
        if (plans[j].id === id) return plans[j].id;
      }
    }
    return null;
  }

  function getSubscriptionPrice(product, variant, loopPlanId) {
    if (!product || !variant || !loopPlanId) return null;
    var planId = parseInt(loopPlanId, 10);
    var groups = product.selling_plan_groups || [];
    for (var i = 0; i < groups.length; i++) {
      var plans = groups[i].selling_plans || [];
      for (var j = 0; j < plans.length; j++) {
        if (plans[j].id !== planId) continue;
        var adj = plans[j].price_adjustments && plans[j].price_adjustments[0];
        if (!adj) return variant.price;
        if (adj.value_type === 'percentage')   return Math.round(variant.price * (1 - adj.value / 100));
        if (adj.value_type === 'fixed_amount') return Math.max(0, variant.price - adj.value);
        if (adj.value_type === 'price')        return adj.value;
        return variant.price;
      }
    }
    return null;
  }

  /* ── Prices ── */
  function updatePrices(product, variant) {
    var oneTimeEl   = root.querySelector('[data-price-type="onetime"]');
    var monthlyEl   = root.querySelector('[data-price-type="monthly"]');
    var quarterlyEl = root.querySelector('[data-price-type="quarterly"]');

    if (!variant) {
      [oneTimeEl, monthlyEl, quarterlyEl].forEach(function(el) { if (el) el.textContent = '--'; });
      return;
    }

    if (oneTimeEl) oneTimeEl.textContent = formatMoney(variant.price);
    if (monthlyEl && SHOW_MONTHLY) {
      var pm = getSubscriptionPrice(product, variant, state.planMonthly);
      monthlyEl.textContent = pm !== null ? formatMoney(pm) : formatMoney(variant.price);
    }
    if (quarterlyEl && SHOW_3MONTHS) {
      var pq = getSubscriptionPrice(product, variant, state.planQuarterly);
      quarterlyEl.textContent = pq !== null ? formatMoney(pq) : formatMoney(variant.price);
    }
  }

  /* ── Media column image swap ── */
  function switchFunctionMedia(functionId, productFeaturedImage) {
    /* Hide default cover */
    var defaultSlide = root.querySelector('#fe-media-default-' + SECTION_ID);
    if (defaultSlide) defaultSlide.classList.remove('is-active');

    root.querySelectorAll('[data-function-media]').forEach(function(slide) {
      var active = slide.dataset.functionMedia === functionId;
      slide.classList.toggle('is-active', active);
      if (active && productFeaturedImage) {
        var img = slide.querySelector('.fe-cover-img');
        if (img) {
          img.dataset.baseSrc = productFeaturedImage;
          if (cleanSrc(img.src) !== cleanSrc(productFeaturedImage)) {
            img.style.opacity = '0';
            img.onload = function() { img.style.opacity = '1'; };
            img.src = productFeaturedImage;
          }
        }
      }
    });
  }

  function showVariantImage(variant) {
    var activeSlide = root.querySelector('[data-function-media].is-active');
    if (!activeSlide) return;
    var img = activeSlide.querySelector('.fe-cover-img');
    if (!img) return;

    /*
      Priority:
      1. Active flavor pill's data-thumbnail (set from block thumbnail_image)
      2. Variant's own featured_image from Shopify
      3. Base function image (data-base-src — the product featured image)
    */
    var nextSrc = '';

    var flavorBtn = root.querySelector('[data-flavor-id].is-active');
    if (flavorBtn && flavorBtn.dataset.thumbnail) {
      nextSrc = flavorBtn.dataset.thumbnail;
    } else if (variant && variant.featured_image && variant.featured_image.src) {
      nextSrc = variant.featured_image.src;
    }

    /* Fall back to the function's base image */
    if (!nextSrc) nextSrc = img.dataset.baseSrc || '';

    if (!nextSrc) {
      img.style.opacity = '1';
      return;
    }

    /* If already showing this image just make sure it's visible */
    if (cleanSrc(img.src) === cleanSrc(nextSrc)) {
      img.style.opacity = '1';
      return;
    }

    img.style.opacity = '0';
    img.onload  = function() { img.style.opacity = '1'; };
    img.onerror = function() { img.style.opacity = '1'; };
    img.src = nextSrc;
    img.alt = variant ? variant.title : '';
  }

  /* ── Summary thumbnail ── */
  function getActiveThumbnail(variant, product) {
    /* Priority: flavor thumbnail > function thumbnail > variant image > product image */
    var flavorBtn = root.querySelector('[data-flavor-id].is-active');
    if (flavorBtn && flavorBtn.dataset.thumbnail) return flavorBtn.dataset.thumbnail;

    var fnBtn = root.querySelector('[data-function-id].is-active');
    if (fnBtn && fnBtn.dataset.thumbnail) return fnBtn.dataset.thumbnail;

    if (variant && variant.featured_image && variant.featured_image.src) return variant.featured_image.src;
    if (product && product.featured_image) return product.featured_image;
    return '';
  }

  function updateSummary(product, variant) {
    if (!product || !variant) {
      if (nameEl)  nameEl.textContent = '--';
      if (varEl)   varEl.textContent  = '--';
      if (thumbEl) { thumbEl.src = ''; thumbEl.classList.remove('is-loaded'); }
      return;
    }

    if (nameEl) nameEl.textContent = product.title;
    if (varEl)  varEl.textContent  = variant.title;

    if (thumbEl) {
      var src = getActiveThumbnail(variant, product);
      if (src && cleanSrc(src) !== cleanSrc(thumbEl.src)) {
        thumbEl.classList.remove('is-loaded');
        thumbEl.onload = function() { thumbEl.classList.add('is-loaded'); };
        thumbEl.src = src;
      }
      thumbEl.alt = product.title + ' - ' + variant.title;
    }
  }

  /* ── ATC enable/disable ── */
  function setAtcEnabled(enabled) {
    if (!atcBtn) return;
    if (enabled) {
      atcBtn.removeAttribute('disabled');
      atcBtn.removeAttribute('aria-disabled');
    } else {
      atcBtn.setAttribute('disabled', '');
      atcBtn.setAttribute('aria-disabled', 'true');
    }
  }

  /* ── Apply variant (prices, image, summary) ── */
  function applyVariant(product, variant) {
    state.product = product;
    state.variant = variant;
    updateSummary(product, variant);
    updatePrices(product, variant);
    showVariantImage(variant);

    if (state.purchaseType) {
      var isComing = FUNCTIONS.some(function(f) { return f.id === state.functionId && f.comingSoon; });
      setAtcEnabled(!isComing && !!product);
    }
  }

  /* ── Load product for selected function ── */
  function loadProduct() {
    if (!state.handle) return;
    setAtcMsg('');
    setAtcEnabled(false);

    fetchProduct(state.handle).then(function(product) {
      if (!product) {
        setAtcMsg('Product not found. Check the product handle in theme settings.', true);
        return;
      }

      /* Set the cover image from the product featured image */
      var featured = product.featured_image || (product.images && product.images[0] && product.images[0].src) || '';
      switchFunctionMedia(state.functionId, featured);

      var variant = findVariant(product, state.flavorName);
      applyVariant(product, variant);

      pushEvent('fe_product_loaded', {
        function_id: state.functionId,
        flavor:      state.flavorName,
        variant_id:  variant && variant.id,
        product:     product.title,
      });
    });
  }

  /* ── Add to cart ── */
  function addToCart() {
    /* Re-resolve variant at click time to ensure it's current */
    if (state.product && state.flavorName) {
      state.variant = findVariant(state.product, state.flavorName);
    }

    if (!state.product) {
      setAtcMsg('Please select a function first.', true);
      return;
    }
    if (!state.variant) {
      setAtcMsg('Could not find this variant. Please try again.', true);
      return;
    }

    var checkedRadio = root.querySelector('input[name="fe-purchase-' + SECTION_ID + '"]:checked');
    var purchaseType = state.purchaseType || (checkedRadio && checkedRadio.value);
    if (!purchaseType) {
      setAtcMsg('Please select a purchase option.', true);
      return;
    }

    pushEvent('fe_add_to_cart_attempt', {
      variant_id: state.variant.id, purchase_type: purchaseType,
      function_id: state.functionId, flavor: state.flavorName,
    });

    atcBtn.classList.add('is-loading');
    setAtcEnabled(false);
    setAtcMsg('');

    var body, planId, resolvedPlanId;

    if (purchaseType === 'monthly' || purchaseType === 'quarterly') {
      planId         = purchaseType === 'monthly' ? state.planMonthly : state.planQuarterly;
      resolvedPlanId = findSellingPlanId(state.product, planId);

      if (!resolvedPlanId) {
        atcBtn.classList.remove('is-loading');
        setAtcEnabled(true);
        setAtcMsg('Subscription plan not found. Check the Loop Plan IDs in theme settings.', true);
        return;
      }
      body = JSON.stringify({ id: state.variant.id, quantity: 1, selling_plan: resolvedPlanId });
    } else {
      body = JSON.stringify({ id: state.variant.id, quantity: 1 });
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: body,
    })
    .then(function(res) {
      if (!res.ok) return res.json().then(function(e) { throw new Error(e.description || 'Cart error'); });

      pushEvent(purchaseType !== 'onetime' ? 'fe_subscription_added' : 'fe_add_to_cart_success', {
        variant_id: state.variant.id, purchase_type: purchaseType,
      });

      /*
        Open Horizon's cart drawer.

        From the actual Horizon source (cart-drawer.js):
          - The element is <cart-drawer-component>
          - It has a public .open() method that calls this.showDialog()
          - It listens for CartAddEvent ('cart:add') to auto-open if
            the auto-open attribute is present AND to update the count

        We call .open() directly first (no attribute check needed),
        then dispatch 'cart:add' so Horizon re-renders the drawer
        contents and updates the cart bubble count in the header.
      */
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var cartDrawer = document.querySelector('cart-drawer-component');

          /* Open the drawer immediately */
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          }

          /* Then dispatch cart:add so Horizon refreshes drawer contents + count */
          document.dispatchEvent(new CustomEvent('cart:add', {
            bubbles: true,
            detail: { resource: { item_count: cart.item_count } }
          }));
        })
        .catch(function() {
          /* /cart.js failed — open drawer with stale content */
          var cartDrawer = document.querySelector('cart-drawer-component');
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          }
        });

      setAtcMsg('');
    })
    .catch(function(err) {
      setAtcMsg(err.message || 'Something went wrong. Please try again.', true);
      pushEvent('fe_add_to_cart_error', { variant_id: state.variant.id, error: err.message });
    })
    .finally(function() {
      atcBtn.classList.remove('is-loading');
      var isComing = FUNCTIONS.some(function(f) { return f.id === state.functionId && f.comingSoon; });
      setAtcEnabled(!isComing && !!state.purchaseType);
    });
  }

  /* ── Event: Function cards ── */
  root.querySelectorAll('[data-function-id]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.dataset.comingSoon === 'true') return;

      /* Mark selected */
      root.querySelectorAll('[data-function-id]').forEach(function(b) {
        b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');

      state.functionId    = btn.dataset.functionId;
      state.handle        = btn.dataset.productHandle;
      state.planMonthly   = btn.dataset.loopPlanMonthly   || null;
      state.planQuarterly = btn.dataset.loopPlanQuarterly || null;

      /* Unlock flavors, reset downstream selections */
      unlockGroup(flavorGroup);

      /* Reset flavor + purchase selections when function changes */
      root.querySelectorAll('[data-flavor-id]').forEach(function(b) {
        b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
      });
      root.querySelectorAll('.fe-purchase-option').forEach(function(l) { l.classList.remove('is-active'); });
      root.querySelectorAll('input[name="fe-purchase-' + SECTION_ID + '"]').forEach(function(r) { r.checked = false; });

      state.flavorName   = null;
      state.purchaseType = null;
      lockGroup(purchaseGroup);
      setAtcEnabled(false);

      pushEvent('fe_function_selected', { function_id: state.functionId, label: btn.dataset.functionLabel });
      loadProduct();
    });
  });

  /* ── Event: Flavor cards ── */
  root.querySelectorAll('[data-flavor-id]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      /* Mark selected */
      root.querySelectorAll('[data-flavor-id]').forEach(function(b) {
        b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');

      state.flavorName = btn.dataset.flavorName;

      /* Unlock purchase options */
      unlockGroup(purchaseGroup);

      /* Reset purchase selection when flavor changes */
      root.querySelectorAll('.fe-purchase-option').forEach(function(l) { l.classList.remove('is-active'); });
      root.querySelectorAll('input[name="fe-purchase-' + SECTION_ID + '"]').forEach(function(r) { r.checked = false; });
      state.purchaseType = null;
      setAtcEnabled(false);

      pushEvent('fe_flavor_selected', { flavor: state.flavorName });

      if (state.product) {
        var variant = findVariant(state.product, state.flavorName);
        applyVariant(state.product, variant);
      }
    });
  });

  /* ── Event: Purchase options ──
     Bound on document so pointer-events:none on the locked group
     never blocks the event from being captured. We check the group
     is not locked before acting.
  ── */
  document.addEventListener('click', function(e) {
    var label = e.target.closest('.fe-purchase-option');
    if (!label) return;
    if (!root.contains(label)) return;
    if (purchaseGroup && purchaseGroup.classList.contains('fe-step--locked')) return;

    var radio = label.querySelector('input[type="radio"]');
    if (!radio) return;

    radio.disabled = false;
    radio.checked  = true;

    root.querySelectorAll('.fe-purchase-option').forEach(function(l) { l.classList.remove('is-active'); });
    label.classList.add('is-active');

    state.purchaseType = radio.value;
    pushEvent('fe_purchase_type_selected', { type: radio.value });

    var isComing = FUNCTIONS.some(function(f) { return f.id === state.functionId && f.comingSoon; });
    setAtcEnabled(!isComing);
  });

  if (atcBtn) atcBtn.addEventListener('click', addToCart);

})();
</script>

{% schema %}
{
  "name": "Product Selector",
  "class": "fortified-elements-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Content layout",
      "options": [
        { "value": "image-left", "label": "Image left, selector right" },
        { "value": "panel-left", "label": "Selector left, image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Section max width",
      "info": "How wide the section gets before centering. Lower this to stop it stretching edge to edge.",
      "min": 600,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "panel_width",
      "label": "Selector panel width",
      "info": "Width of the selector panel on desktop. The image fills the rest.",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Default cover image",
      "info": "Shown in the left image area before a function is selected. Once a function is selected the product image loads automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for Every Body"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose your function. Choose your flavor."
    },
    {
      "type": "text",
      "id": "summary_label",
      "label": "Order summary label",
      "default": "Your Order"
    },
    {
      "type": "text",
      "id": "function_label",
      "label": "Function selector label",
      "default": "Choose Your Function"
    },
    {
      "type": "text",
      "id": "flavor_label",
      "label": "Flavor selector label",
      "default": "Choose Your Flavor"
    },
    {
      "type": "text",
      "id": "purchase_label",
      "label": "Purchase option label",
      "default": "Purchase Option"
    },
    {
      "type": "text",
      "id": "coming_soon_text",
      "label": "Coming Soon badge text",
      "default": "Soon"
    },
