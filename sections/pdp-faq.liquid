{% render 'fortified-base' %}

<section
  id="PdpFaq-{{ section.id }}"
  class="pdp-faq"
  data-pdp-faq
  {{ section.shopify_attributes }}
>
  <div class="fortified-container">
    <header class="pdp-faq__head">
      <p class="pdp-faq__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pdp-faq__title">{{ section.settings.title }}</h2>
    </header>

    <div class="pdp-faq__tabs" role="tablist">
      <button type="button" class="pdp-faq__tab is-active" role="tab" data-faq-tab="all">{{ section.settings.tab_all }}</button>
      <button type="button" class="pdp-faq__tab" role="tab" data-faq-tab="energy">{{ section.settings.tab_energy }}</button>
      <button type="button" class="pdp-faq__tab" role="tab" data-faq-tab="everyday">{{ section.settings.tab_everyday }}</button>
      <button type="button" class="pdp-faq__tab" role="tab" data-faq-tab="creatine">{{ section.settings.tab_creatine }}</button>
    </div>

    <div class="pdp-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'qa' %}
          <details class="pdp-faq__item" data-faq-category="{{ block.settings.category }}" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <summary class="pdp-faq__q">
              <span>{{ block.settings.question }}</span>
              <span class="pdp-faq__chev" aria-hidden="true">+</span>
            </summary>
            <div class="pdp-faq__a">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-faq { background: var(--fortified-off-white); padding-block: clamp(40px, 6vw, 84px); font-family: var(--font-fortified-body); color: var(--fortified-black); }
  .pdp-faq__head { text-align: center; margin-bottom: 24px; }
  .pdp-faq__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fortified-gray-mid); margin: 0 0 8px; }
  .pdp-faq__title { font-family: var(--font-fortified-display); font-size: clamp(26px, 3.6vw, 40px); text-transform: uppercase; letter-spacing: 0.02em; margin: 0; }
  .pdp-faq__tabs { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 24px; }
  .pdp-faq__tab { border: 1px solid var(--fortified-gray-light); background: var(--fortified-white); border-radius: 999px; padding: 9px 18px; font-family: var(--font-fortified-display); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; color: var(--fortified-gray-mid); }
  .pdp-faq__tab.is-active { background: var(--fortified-black); color: var(--fortified-white); border-color: var(--fortified-black); }
  .pdp-faq__list { max-width: 820px; margin: 0 auto; display: grid; gap: 10px; }
  .pdp-faq__item { background: var(--fortified-white); border: 1px solid var(--fortified-gray-light); border-radius: 14px; padding: 0; }
  .pdp-faq__item[hidden] { display: none; }
  .pdp-faq__q { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 18px; cursor: pointer; list-style: none; font-family: var(--font-fortified-display); font-size: 14px; letter-spacing: 0.04em; text-transform: uppercase; }
  .pdp-faq__q::-webkit-details-marker { display: none; }
  .pdp-faq__chev { font-size: 20px; line-height: 1; transition: transform .2s ease; color: var(--fortified-gray-mid); }
  .pdp-faq__item[open] .pdp-faq__chev { transform: rotate(45deg); color: var(--fortified-teal); }
  .pdp-faq__a { padding: 0 18px 16px; color: var(--fortified-gray-mid); font-size: 14px; line-height: 1.55; }
{% endstylesheet %}

<script>
  (function() {
    var root = document.getElementById('PdpFaq-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-faq-tab]');
    var items = root.querySelectorAll('[data-faq-category]');
    function show(cat) {
      tabs.forEach(function(t){ t.classList.toggle('is-active', t.dataset.faqTab === cat); });
      items.forEach(function(it) {
        var c = it.dataset.faqCategory;
        var match = (cat === 'all') || (c === cat) || (c === 'all');
        it.hidden = !match;
      });
    }
    tabs.forEach(function(t){ t.addEventListener('click', function(){ show(t.dataset.faqTab); }); });
    window.addEventListener('pdp:product-change', function(e) {
      var p = (e.detail && e.detail.product) || 'energy';
      show(p);
    });
  })();
</script>

{% schema %}
{
  "name": "11-Omni-FAQ",
  "tag": "section",
  "class": "pdp-section pdp-section--faq",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Frequently asked"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "GOT QUESTIONS?"
    },
    {
      "type": "text",
      "id": "tab_all",
      "label": "Tab: All",
      "default": "All"
    },
    {
      "type": "text",
      "id": "tab_energy",
      "label": "Tab: Energy",
      "default": "Energy"
    },
    {
      "type": "text",
      "id": "tab_everyday",
      "label": "Tab: Everyday",
      "default": "Everyday"
    },
    {
      "type": "text",
      "id": "tab_creatine",
      "label": "Tab: Creatine",
      "default": "Creatine"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            {
              "value": "all",
              "label": "All / general"
            },
            {
              "value": "energy",
              "label": "Energy"
            },
            {
              "value": "everyday",
              "label": "Everyday"
            },
            {
              "value": "creatine",
              "label": "Creatine"
            }
          ],
          "default": "all"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How is Fortified different?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We publish every dose on the label. No proprietary blends, no fillers, no surprises.</p>"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "11-Omni-FAQ",
      "category": "Fortified",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "category": "all",
            "question": "How is Fortified different?",
            "answer": "<p>Every dose is printed on the label. No proprietary blends, no fillers, no surprises \u2014 and clinical doses across the board.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "all",
            "question": "When will I get my first order?",
            "answer": "<p>Orders ship within 1 business day. US delivery is typically 2\u20135 days.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "energy",
            "question": "How much caffeine is in Fortified Energy?",
            "answer": "<p>200mg from green coffee bean \u2014 paired with 200mg L-theanine for smooth, focused energy without a crash.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "energy",
            "question": "Can I take it on an empty stomach?",
            "answer": "<p>Yes \u2014 but if you're caffeine-sensitive, start with half a pouch.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "everyday",
            "question": "Why so much sodium?",
            "answer": "<p>1,200mg matches what an active adult actually loses through sweat and daily life. Most other brands underdose by 60\u201380%.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "everyday",
            "question": "Is it safe for kids?",
            "answer": "<p>Yes \u2014 Everyday is caffeine-free. We typically suggest half a pouch for kids 8+.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "creatine",
            "question": "Is creatine safe?",
            "answer": "<p>Creatine monohydrate is the single most-researched sports supplement in history. Daily 5g doses are well-studied for safety and effectiveness.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category": "creatine",
            "question": "How long until I see results?",
            "answer": "<p>Most people notice strength and recovery improvements within 2\u20134 weeks of daily use.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
