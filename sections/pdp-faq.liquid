{% render 'fortified-base' %}

<section
  id="PdpFaq-{{ section.id }}"
  class="pdp-faq"
  data-pdp-faq
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="pdp-faq__inner">
    <div class="pdp-faq__lead">
      <header class="pdp-faq__head">
        <h2 class="pdp-faq__title">{{ section.settings.title }}</h2>
        {% if section.settings.desc != blank %}<p class="pdp-faq__desc">{{ section.settings.desc }}</p>{% endif %}
      </header>

      {% if section.settings.cta_label != blank %}
        <a class="pdp-faq__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>

    <div class="pdp-faq__body">
      {% if section.settings.show_tabs %}
        <div class="pdp-faq__tabs" role="tablist">
          <button type="button" class="pdp-faq__tab is-active" role="tab" data-faq-tab="all">{{ section.settings.tab_all }}</button>
          <button type="button" class="pdp-faq__tab" role="tab" data-faq-tab="energy">{{ section.settings.tab_energy }}</button>
          <button type="button" class="pdp-faq__tab" role="tab" data-faq-tab="everyday">{{ section.settings.tab_everyday }}</button>
          <button type="button" class="pdp-faq__tab" role="tab" data-faq-tab="creatine">{{ section.settings.tab_creatine }}</button>
        </div>
      {% endif %}

      <div class="pdp-faq__list">
        {% for block in section.blocks %}
          {% if block.type == 'qa' %}
            <details class="pdp-faq__item{% if forloop.first %} is-open{% endif %}" {% if forloop.first %}open{% endif %} data-faq-category="{{ block.settings.category }}" {{ block.shopify_attributes }}>
              <summary class="pdp-faq__q">
                <span>{{ block.settings.question }}</span>
                <span class="pdp-faq__chev" aria-hidden="true">
                  <svg width="19" height="11" viewBox="0 0 19 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L9.5 9.5L18 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <div class="pdp-faq__a">{{ block.settings.answer }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-faq {
    background: color-mix(in srgb, var(--color-foreground) 4%, var(--color-background));
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
  }
  .pdp-faq__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 52px;
    width: 100%;
  }
  .pdp-faq__lead {
    display: flex; flex-direction: column;
    gap: 32px;
    flex-shrink: 0;
  }
  .pdp-faq__head { display: flex; flex-direction: column; gap: 12px; }
  .pdp-faq__title {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 62px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }
  .pdp-faq__desc {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .pdp-faq__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px; max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .15s ease, color .15s ease;
  }
  .pdp-faq__cta:hover { background: var(--color-foreground); color: var(--color-background); }
  .pdp-faq__body {
    width: 628px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pdp-faq__tabs {
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .pdp-faq__tab {
    border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    background: transparent;
    border-radius: 999px;
    padding: 10px 18px;
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--color-foreground);
    transition: background .15s ease, color .15s ease, border-color .15s ease;
  }
  .pdp-faq__tab.is-active {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  .pdp-faq__list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pdp-faq__item {
    background: transparent;
    border: 0;
    padding: 0 0 24px;
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }
  .pdp-faq__item[hidden] { display: none; }
  .pdp-faq__q {
    display: flex; justify-content: space-between; align-items: center;
    gap: 24px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    padding: 0;
  }
  .pdp-faq__q::-webkit-details-marker { display: none; }
  .pdp-faq__chev {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px; height: 19px;
    flex-shrink: 0;
    color: var(--color-foreground);
    transition: transform .2s ease;
  }
  .pdp-faq__item[open] .pdp-faq__chev { transform: rotate(180deg); }
  .pdp-faq__a {
    margin-top: 16px;
    font-family: var(--font-fortified-body);
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-foreground);
  }
  @media (max-width: 960px) {
    .pdp-faq__inner { flex-direction: column; gap: 42px; }
    .pdp-faq__body { width: 100%; }
    .pdp-faq__title { font-size: 42px; }
    .pdp-faq__q { font-size: 22px; }
    .pdp-faq__a { font-size: 18px; }
  }
{% endstylesheet %}

<script>
  (function() {
    var root = document.getElementById('PdpFaq-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-faq-tab]');
    var items = root.querySelectorAll('[data-faq-category]');
    function show(cat) {
      tabs.forEach(function(t){ t.classList.toggle('is-active', t.dataset.faqTab === cat); });
      items.forEach(function(it) {
        var c = it.dataset.faqCategory;
        var match = (cat === 'all') || (c === cat) || (c === 'all');
        it.hidden = !match;
      });
    }
    tabs.forEach(function(t){ t.addEventListener('click', function(){ show(t.dataset.faqTab); }); });
    window.addEventListener('pdp:product-change', function(e) {
      var p = (e.detail && e.detail.product) || 'energy';
      show(p);
    });
  })();
</script>

