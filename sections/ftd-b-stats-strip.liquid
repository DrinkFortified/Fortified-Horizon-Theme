    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1,200"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit",
          "default": "mg"
        },
        {
