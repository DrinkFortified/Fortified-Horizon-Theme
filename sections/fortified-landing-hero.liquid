{% render 'fortified-base' %}

<section
  id="FortifiedLandingHero-{{ section.id }}"
  class="fortified-landing-hero color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 24 }}px {{ section.settings['padding-block-end'] | default: 24 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 24 }}px {{ section.settings['padding-inline-end'] | default: 24 }}px;"
>
  <div class="fortified-landing-hero__frame">
    {% if section.settings.image_1 != blank %}
      {{ section.settings.image_1 | image_url: width: 2880 | image_tag:
          widths: '720, 1080, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          class: 'fortified-landing-hero__bg',
          alt: section.settings.headline_line_1,
          loading: 'eager',
          fetchpriority: 'high' }}
    {% endif %}

    <div class="fortified-landing-hero__content">
      <div class="fortified-landing-hero__headline">
        {% if section.settings.headline_line_1 != blank %}
          <p class="fortified-landing-hero__line">{{ section.settings.headline_line_1 }}</p>
        {% endif %}
        {% if section.settings.headline_line_2 != blank %}
          {%- assign hl = section.settings.highlight_word | default: '' -%}
          {%- if hl != blank -%}
            {%- assign accented = '<span class="fortified-landing-hero__accent">' | append: hl | append: '</span>' -%}
            <p class="fortified-landing-hero__line">{{ section.settings.headline_line_2 | replace: hl, accented }}</p>
          {%- else -%}
            <p class="fortified-landing-hero__line">{{ section.settings.headline_line_2 }}</p>
          {%- endif -%}
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <ul class="fortified-landing-hero__benefits">
          {% for block in section.blocks %}
            {% if block.type == 'fortified-benefit-item' %}
              <li {{ block.shopify_attributes }}>
                <span class="fortified-landing-hero__icon" aria-hidden="true">
                  {% if block.settings.icon_image != blank %}
                    {{ block.settings.icon_image | image_url: width: 104 | image_tag:
                        widths: '52, 104',
                        sizes: '52px',
                        alt: '',
                        loading: 'lazy' }}
                  {% else %}✓{% endif %}
                </span>
                <span class="fortified-landing-hero__benefit-text">{{ block.settings.text }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      <div class="fortified-landing-hero__footer">
        {% if section.settings.asterisk_disclaimer != blank %}
          <p class="fortified-landing-hero__disclaimer">{{ section.settings.asterisk_disclaimer }}</p>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-landing-hero__btn">{{ section.settings.cta_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-landing-hero {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-landing-hero__frame {
    position: relative;
    width: 100%;
    min-height: 662px;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
  }
  .fortified-landing-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-landing-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 460px;
    padding: 62px 40px;
    display: flex;
    flex-direction: column;
    gap: 42px;
    color: var(--color-foreground);
  }
  .fortified-landing-hero__headline {
    width: 423px;
    max-width: 100%;
  }
  .fortified-landing-hero__line {
    font-family: var(--font-fortified-display);
    font-size: 72px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-landing-hero__accent { color: var(--fortified-accent); }

  .fortified-landing-hero__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 394px;
    max-width: 100%;
  }
  .fortified-landing-hero__benefits li {
    display: flex;
    align-items: center;
    gap: 18px;
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-transform: capitalize;
  }
  .fortified-landing-hero__icon {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--fortified-accent);
    color: var(--color-background);
    font-weight: 700;
    font-size: 24px;
  }
  .fortified-landing-hero__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  .fortified-landing-hero__footer {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 394px;
    max-width: 100%;
  }
  .fortified-landing-hero__disclaimer {
    font-family: var(--font-fortified-body);
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-transform: capitalize;
    margin: 0;
  }
  .fortified-landing-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 70px;
    padding: 18px 32px;
    border: 1.5px solid var(--color-primary-button-background, var(--color-foreground));
    border-radius: 8px;
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
    width: 100%;
  }

  @media (max-width: 990px) {
    .fortified-landing-hero__frame { min-height: 540px; }
    .fortified-landing-hero__content { max-width: 100%; padding: 48px 32px; gap: 32px; }
    .fortified-landing-hero__headline { width: 100%; }
    .fortified-landing-hero__line { font-size: 48px; }
    .fortified-landing-hero__benefits { width: 100%; }
    .fortified-landing-hero__benefits li { font-size: 18px; }
    .fortified-landing-hero__footer { width: 100%; }
  }
  @media (max-width: 749px) {
    .fortified-landing-hero__frame { min-height: 480px; border-radius: 16px; }
    .fortified-landing-hero__content { padding: 40px 24px; gap: 24px; }
    .fortified-landing-hero__line { font-size: 36px; }
    .fortified-landing-hero__icon { flex: 0 0 40px; width: 40px; height: 40px; font-size: 18px; }
    .fortified-landing-hero__btn { height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP-01 — Landing Hero",
  "tag": "section",
  "class": "fortified-landing-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "headline_line_1",
      "label": "Headline line 1",
      "default": "TRY 3 STICKS"
    },
    {
      "type": "text",
      "id": "headline_line_2",
      "label": "Headline line 2",
      "default": "FOR FREE*"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlight word",
      "info": "Word in line 2 to color with the highlight/accent color.",
      "default": "FREE*"
    },
    {
      "type": "text",
      "id": "asterisk_disclaimer",
      "label": "Disclaimer",
      "default": "* Just pay $1.99 for shipping"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "TRY 3 STICKS FOR $1.99"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for highlight word + benefit icon circles. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "blocks": [
    {
      "type": "fortified-benefit-item",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Optional. If empty, a circle with a checkmark is shown."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Premium Hydration + Performance"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP-01 — Landing Hero",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        { "type": "fortified-benefit-item", "settings": { "text": "Premium Hydration + Performance" } },
        { "type": "fortified-benefit-item", "settings": { "text": "Zero sugar. Zero crash." } },
        { "type": "fortified-benefit-item", "settings": { "text": "Scientifically backed ingredients" } }
      ]
    }
  ]
}
{% endschema %}
