          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "fortified-benefit-item",
      "name": "Benefit item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "checkmark",
              "label": "Checkmark"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ],
          "default": "checkmark"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium Hydration + Performance"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "13 \u2014 Landing Hero",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        {
          "type": "fortified-benefit-item",
          "settings": {
            "text": "Premium Hydration + Performance"
          }
        },
        {
          "type": "fortified-benefit-item",
          "settings": {
            "text": "Zero Sugar, Zero Crash"
          }
        },
        {
          "type": "fortified-benefit-item",
          "settings": {
            "text": "Scientifically Dosed Ingredients"
          }
        }
      ]
    }
  ]
}
{% endschema %}
