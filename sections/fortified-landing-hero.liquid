{% render 'fortified-base' %}

<section
  id="FortifiedLandingHero-{{ section.id }}"
  class="fortified-landing-hero color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  <div class="fortified-container fortified-landing-hero__inner">
    <div class="fortified-landing-hero__text">
      <h1 class="fortified-heading fortified-h1">
        <span class="fortified-landing-hero__line">{{ section.settings.headline_line_1 }}</span>
        <span class="fortified-landing-hero__line">{{ section.settings.headline_line_2 }}</span>
      </h1>
      <ul class="fortified-landing-hero__benefits" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-benefit-item' %}
            <li class="fortified-landing-hero__benefit" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
              <span class="fortified-landing-hero__icon" aria-hidden="true">
                {% if block.settings.icon == 'star' %}★{% else %}✓{% endif %}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--dark fortified-landing-hero__cta">{{ section.settings.cta_label }}</a>
      {% endif %}
      {% if section.settings.asterisk_disclaimer != blank %}
        <p class="fortified-landing-hero__disclaimer">{{ section.settings.asterisk_disclaimer }}</p>
      {% endif %}
    </div>
    <div class="fortified-landing-hero__media">
      {% if section.settings.image_1 != blank %}
        {{ section.settings.image_1 | image_url: width: 600 | image_tag:
            class: 'fortified-landing-hero__product fortified-landing-hero__product--1',
            widths: '300, 500, 600',
            sizes: '50vw',
            alt: '',
            loading: 'eager' }}
      {% endif %}
      {% if section.settings.image_2 != blank %}
        {{ section.settings.image_2 | image_url: width: 600 | image_tag:
            class: 'fortified-landing-hero__product fortified-landing-hero__product--2',
            widths: '300, 500, 600',
            sizes: '50vw',
            alt: '',
            loading: 'eager' }}
      {% endif %}
      {% if section.settings.image_3 != blank %}
        {{ section.settings.image_3 | image_url: width: 600 | image_tag:
            class: 'fortified-landing-hero__product fortified-landing-hero__product--3',
            widths: '300, 500, 600',
            sizes: '50vw',
            alt: '',
            loading: 'eager' }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-landing-hero {
    background: linear-gradient(135deg, #00B8B8 0%, #008B8B 100%);
    color: #fff;
    padding-block: var(--fortified-section-py);
    overflow: hidden;
  }
  .fortified-landing-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 750px) {
    .fortified-landing-hero__inner { grid-template-columns: 1.1fr 1fr; }
  }
  .fortified-landing-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .fortified-landing-hero__line { display: block; }
  .fortified-landing-hero__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fortified-landing-hero__benefit {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-fortified-body);
    font-size: 16px;
    font-weight: 600;
  }
  .fortified-landing-hero__icon {
    background: #fff;
    color: var(--fortified-teal);
    width: 24px;
    height: 24px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
  }
  .fortified-landing-hero__cta { margin-top: 8px; }
  .fortified-landing-hero__disclaimer {
    font-size: 12px;
    opacity: .85;
    margin: 0;
  }
  .fortified-landing-hero__media {
    position: relative;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fortified-landing-hero__product {
    position: relative;
    max-width: 200px;
    height: auto;
    margin: -20px;
    filter: drop-shadow(0 20px 30px rgb(0 0 0 / .25));
  }
  .fortified-landing-hero__product--1 { transform: rotate(-12deg) translateY(8px); }
  .fortified-landing-hero__product--2 { transform: rotate(4deg); z-index: 2; }
  .fortified-landing-hero__product--3 { transform: rotate(14deg) translateY(-6px); }

  /* center-aware block alignment — when section is centered, push block content to center */
  [style*="text-align: center"] [class*="__card"],
  [style*="text-align: center"] [class*="__item"],
  [style*="text-align: center"] [class*="__panel"],
  [style*="text-align: center"] [class*="__cell"] { align-items: center !important; }
  [style*="text-align: left"] [class*="__card"],
  [style*="text-align: left"] [class*="__item"],
  [style*="text-align: left"] [class*="__panel"],
  [style*="text-align: left"] [class*="__cell"] { align-items: flex-start !important; }
  [style*="text-align: right"] [class*="__card"],
  [style*="text-align: right"] [class*="__item"],
  [style*="text-align: right"] [class*="__panel"],
  [style*="text-align: right"] [class*="__cell"] { align-items: flex-end !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "13 \u2014 Landing Hero",
  "tag": "section",
  "class": "fortified-landing-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "headline_line_1",
      "label": "Headline line 1",
      "default": "TRY 3 STICKS"
    },
    {
      "type": "text",
      "id": "headline_line_2",
      "label": "Headline line 2",
      "default": "FOR FREE*"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "TRY 3 STICKS FOR $1.99"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "asterisk_disclaimer",
      "label": "Asterisk disclaimer",
      "default": "*Just pay shipping. Limited time offer."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Product image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Product image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Product image 3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
