{% render 'fortified-base' %}

<section
  id="PdpPromise-{{ section.id }}"
  class="pdp-promise"
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container pdp-promise__grid" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
    <div class="pdp-promise__copy">
      <p class="pdp-promise__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pdp-promise__title">{{ section.settings.title }}</h2>
      <p class="pdp-promise__body">{{ section.settings.body }}</p>
      <blockquote class="pdp-promise__quote">
        <p>{{ section.settings.quote }}</p>
        <cite>— {{ section.settings.quote_author }}</cite>
      </blockquote>
    </div>

    <div class="pdp-promise__pills">
      <h3 class="pdp-promise__pills-title">{{ section.settings.pills_title }}</h3>
      <ul class="pdp-promise__pills-grid">
        {% for block in section.blocks %}
          {% if block.type == 'no_pill' %}
            <li style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
              <span class="pdp-promise__pill-mark" aria-hidden="true">NO</span>
              <span>{{ block.settings.label }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-promise {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
  }
  .pdp-promise__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px;
    align-items: start;
  }
  @media (max-width: 960px) { .pdp-promise__grid { grid-template-columns: 1fr; gap: 42px; } }
  .pdp-promise__copy {
    display: flex; flex-direction: column;
    gap: 18px;
  }
  .pdp-promise__eyebrow {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--fortified-accent);
    margin: 0;
  }
  .pdp-promise__title {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 62px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }
  .pdp-promise__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .pdp-promise__quote {
    margin: 0;
    padding: 24px 28px;
    border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-left: 4px solid var(--fortified-accent);
    border-radius: 0 14px 14px 0;
    background: color-mix(in srgb, var(--fortified-accent) 4%, var(--color-background));
  }
  .pdp-promise__quote p {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
    color: var(--color-foreground);
  }
  .pdp-promise__quote cite {
    font-style: normal;
    font-family: var(--font-fortified-body);
    font-size: 16px;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }
  .pdp-promise__pills {
    display: flex; flex-direction: column;
    gap: 18px;
  }
  .pdp-promise__pills-title {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }
  .pdp-promise__pills-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (max-width: 500px) { .pdp-promise__pills-grid { grid-template-columns: 1fr; } }
  .pdp-promise__pills-grid li {
    display: flex; align-items: center; gap: 12px;
    background: var(--color-background);
    border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: 14px;
    padding: 14px 16px;
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: var(--color-foreground);
  }
  .pdp-promise__pill-mark {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 42px; height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
{% endstylesheet %}

