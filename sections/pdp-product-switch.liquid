{% render 'fortified-base' %}

<section
  id="PdpProductSwitch-{{ section.id }}"
  class="pdp-switch color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  data-pdp-switch
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container pdp-switch__inner">
    <div class="pdp-switch__tabs" role="tablist" aria-label="{{ section.settings.aria_label }}">
      <button
        type="button"
        class="pdp-switch__tab is-active"
        role="tab"
        aria-selected="true"
        data-product-target="energy"
      >
        <span class="pdp-switch__dot pdp-switch__dot--energy" aria-hidden="true"></span>
        <span class="pdp-switch__label">{{ section.settings.energy_label }}</span>
        <span class="pdp-switch__sub">{{ section.settings.energy_sub }}</span>
      </button>
      <button
        type="button"
        class="pdp-switch__tab"
        role="tab"
        aria-selected="false"
        data-product-target="everyday"
      >
        <span class="pdp-switch__dot pdp-switch__dot--everyday" aria-hidden="true"></span>
        <span class="pdp-switch__label">{{ section.settings.everyday_label }}</span>
        <span class="pdp-switch__sub">{{ section.settings.everyday_sub }}</span>
      </button>
      <span class="pdp-switch__indicator" aria-hidden="true"></span>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-switch {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-background);
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    font-family: var(--font-fortified-body);
    color: var(--color-foreground);
  }
  .pdp-switch__inner {
    display: flex;
    justify-content: center;
    padding-block: 14px;
  }
  .pdp-switch__tabs {
    position: relative;
    display: inline-flex;
    gap: 8px;
    background: transparent;
    border: 1.5px solid var(--color-foreground);
    border-radius: 999px;
    padding: 6px;
  }
  .pdp-switch__tab {
    position: relative;
    z-index: 1;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 12px 24px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-fortified-display);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
    transition: color .2s ease, background .2s ease;
  }
  .pdp-switch__tab.is-active {
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .pdp-switch__label {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .pdp-switch__sub {
    font-family: var(--font-fortified-body);
    font-weight: 400;
    font-size: 14px;
    letter-spacing: -0.02em;
    text-transform: none;
    color: inherit;
    opacity: 0.85;
  }
  .pdp-switch__dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--fortified-accent);
  }
  .pdp-switch__tab.is-active .pdp-switch__dot {
    background: var(--color-background);
  }
  @media (max-width: 600px) {
    .pdp-switch__sub { display: none; }
    .pdp-switch__tab { padding: 10px 16px; font-size: 14px; gap: 8px; }
    .pdp-switch__label { font-size: 14px; }
  }
{% endstylesheet %}

<script>
  (function() {
    var root = document.getElementById('PdpProductSwitch-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-product-target]');
    function setProduct(p) {
      document.body.dataset.product = p;
      tabs.forEach(function(t) {
        var active = t.dataset.productTarget === p;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      try { window.dispatchEvent(new CustomEvent('pdp:product-change', { detail: { product: p } })); } catch(e){}
    }
    if (!document.body.dataset.product) document.body.dataset.product = 'energy';
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { setProduct(t.dataset.productTarget); });
    });
  })();
</script>

