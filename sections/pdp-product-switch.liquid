{% render 'fortified-base' %}

<section
  id="PdpProductSwitch-{{ section.id }}"
  class="pdp-switch"
  data-pdp-switch
  {{ section.shopify_attributes }}
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  <div class="fortified-container pdp-switch__inner">
    <div class="pdp-switch__tabs" role="tablist" aria-label="{{ section.settings.aria_label }}">
      <button
        type="button"
        class="pdp-switch__tab is-active"
        role="tab"
        aria-selected="true"
        data-product-target="energy"
      >
        <span class="pdp-switch__dot pdp-switch__dot--energy" aria-hidden="true"></span>
        <span class="pdp-switch__label">{{ section.settings.energy_label }}</span>
        <span class="pdp-switch__sub">{{ section.settings.energy_sub }}</span>
      </button>
      <button
        type="button"
        class="pdp-switch__tab"
        role="tab"
        aria-selected="false"
        data-product-target="everyday"
      >
        <span class="pdp-switch__dot pdp-switch__dot--everyday" aria-hidden="true"></span>
        <span class="pdp-switch__label">{{ section.settings.everyday_label }}</span>
        <span class="pdp-switch__sub">{{ section.settings.everyday_sub }}</span>
      </button>
      <span class="pdp-switch__indicator" aria-hidden="true"></span>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-switch {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--fortified-off-white);
    border-bottom: 1px solid var(--fortified-gray-light);
    font-family: var(--font-fortified-body);
  }
  .pdp-switch__inner {
    display: flex;
    justify-content: center;
    padding-block: 10px;
  }
  .pdp-switch__tabs {
    position: relative;
    display: inline-flex;
    background: var(--fortified-white);
    border: 1px solid var(--fortified-gray-light);
    border-radius: var(--fortified-radius-pill);
    padding: 4px;
  }
  .pdp-switch__tab {
    position: relative;
    z-index: 1;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 10px 22px;
    border-radius: var(--fortified-radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-fortified-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fortified-gray-mid);
    transition: color .25s ease;
  }
  .pdp-switch__tab.is-active { color: var(--fortified-black); }
  .pdp-switch__sub {
    font-family: var(--font-fortified-body);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--fortified-gray-mid);
  }
  .pdp-switch__dot {
    width: 10px; height: 10px; border-radius: 50%;
  }
  .pdp-switch__dot--energy { background: var(--fortified-orange); }
  .pdp-switch__dot--everyday { background: var(--fortified-teal); }
  @media (max-width: 600px) {
    .pdp-switch__sub { display: none; }
    .pdp-switch__tab { padding: 8px 14px; font-size: 12px; }
  }
{% endstylesheet %}

<script>
  (function() {
    var root = document.getElementById('PdpProductSwitch-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-product-target]');
    function setProduct(p) {
      document.body.dataset.product = p;
      tabs.forEach(function(t) {
        var active = t.dataset.productTarget === p;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      try { window.dispatchEvent(new CustomEvent('pdp:product-change', { detail: { product: p } })); } catch(e){}
    }
    if (!document.body.dataset.product) document.body.dataset.product = 'energy';
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { setProduct(t.dataset.productTarget); });
    });
  })();
</script>

{% schema %}
{
  "name": "01-Omni-Product Switch Tabs",
  "tag": "section",
  "class": "pdp-section pdp-section--switch",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Tablist ARIA label",
      "default": "Choose product"
    },
    {
      "type": "text",
      "id": "energy_label",
      "label": "Energy tab label",
      "default": "Fortified Energy"
    },
    {
      "type": "text",
      "id": "energy_sub",
      "label": "Energy sublabel",
      "default": "Pre-workout / focus"
    },
    {
      "type": "text",
      "id": "everyday_label",
      "label": "Everyday tab label",
      "default": "Fortified Everyday"
    },
    {
      "type": "text",
      "id": "everyday_sub",
      "label": "Everyday sublabel",
      "default": "Daily hydration"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "01-Omni-Product Switch Tabs",
      "category": "Fortified Omni",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
