{% render 'fortified-base' %}

<section
  id="PdpDisclaimer-{{ section.id }}"
  class="pdp-disc color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container pdp-disc__inner">
    <h2 class="pdp-disc__title">{% render 'fortified-accent-text', text: section.settings.title %}</h2>

    <div class="pdp-disc__warnings">
      {% for block in section.blocks %}
        {% if block.type == 'warning' %}
          <div class="pdp-disc__warn" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <strong class="pdp-disc__warn-label">{% render 'fortified-accent-text', text: block.settings.label %}</strong>
            <p>{% render 'fortified-accent-text', text: block.settings.body %}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <p class="pdp-disc__fda">{% render 'fortified-accent-text', text: section.settings.fda_text %}</p>
    {% if section.settings.fineprint != blank %}
      <p class="pdp-disc__fine">{% render 'fortified-accent-text', text: section.settings.fineprint %}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pdp-disc {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
    border-top: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }
  .pdp-disc__inner {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pdp-disc__title {
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
    text-align: center;
  }
  .pdp-disc__warnings {
    display: flex; flex-direction: column;
    gap: 12px;
  }
  .pdp-disc__warn {
    background: color-mix(in srgb, var(--fortified-accent) 4%, var(--color-background));
    border-left: 4px solid var(--fortified-accent);
    padding: 16px 20px;
    border-radius: 0 14px 14px 0;
  }
  .pdp-disc__warn-label {
    display: block;
    font-family: var(--font-fortified-display);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin-bottom: 6px;
  }
  .pdp-disc__warn p {
    margin: 0;
    font-family: var(--font-fortified-body);
    font-size: 16px;
    line-height: 1.4;
  }
  .pdp-disc__fda {
    font-family: var(--font-fortified-body);
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }
  .pdp-disc__fine {
    font-family: var(--font-fortified-body);
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "12-Omni-Disclaimer",
  "tag": "section",
  "class": "pdp-section pdp-section--disclaimer",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Wrap text in *asterisks* to highlight in the accent color, e.g. \"hydration *that hits*\".",
      "default": "Important to know"
    },
    {
      "type": "textarea",
      "id": "fda_text",
      "label": "FDA disclaimer",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "textarea",
      "id": "fineprint",
      "label": "Fine print (optional)",
      "info": "Wrap text in *asterisks* to highlight in the accent color.",
      "default": "Consult your physician before using if you are pregnant, nursing, have a medical condition, or take any medication."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "blocks_alignment",
      "label": "Blocks row position",
      "info": "How the row/grid of blocks sits inside the section. Use Center to push blocks to the middle of the section width.",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for accent bars, CTA backgrounds, checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "warning",
      "name": "Warning callout",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Contains caffeine"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Fortified Energy contains 200mg of caffeine per pouch. Not recommended for children, pregnant women, or anyone sensitive to caffeine."
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        },
        {
          "type": "header",
          "content": "Spacing"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "Padding top",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "Padding bottom",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "Padding left",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "Padding right",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "12-Omni-Disclaimer",
      "category": "Fortified Omni",
      "settings": {},
      "blocks": [
        {
          "type": "warning",
          "settings": {
            "label": "Contains caffeine",
            "body": "Fortified Energy contains 200mg caffeine per pouch \u2014 equivalent to two cups of coffee. Not recommended for children, those pregnant or nursing, or anyone caffeine-sensitive."
          }
        },
        {
          "type": "warning",
          "settings": {
            "label": "Vitamin K2 notice",
            "body": "If you take blood thinners (warfarin, etc.), consult your doctor before using products containing Vitamin K2."
          }
        },
        {
          "type": "warning",
          "settings": {
            "label": "Sodium content",
            "body": "If you have been advised to follow a low-sodium diet, talk to your healthcare provider before regular use."
          }
        }
      ]
    }
  ]
}
{% endschema %}
