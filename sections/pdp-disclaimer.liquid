{% render 'fortified-base' %}

<section
  id="PdpDisclaimer-{{ section.id }}"
  class="pdp-disc"
  {{ section.shopify_attributes }}
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  <div class="fortified-container pdp-disc__inner">
    <h2 class="pdp-disc__title">{{ section.settings.title }}</h2>

    <div class="pdp-disc__warnings">
      {% for block in section.blocks %}
        {% if block.type == 'warning' %}
          <div class="pdp-disc__warn" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            <strong class="pdp-disc__warn-label">{{ block.settings.label }}</strong>
            <p>{{ block.settings.body }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <p class="pdp-disc__fda">{{ section.settings.fda_text }}</p>
    {% if section.settings.fineprint != blank %}
      <p class="pdp-disc__fine">{{ section.settings.fineprint }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pdp-disc { background: var(--fortified-white); padding-block: clamp(32px, 5vw, 64px); font-family: var(--font-fortified-body); color: var(--fortified-gray-mid); border-top: 1px solid var(--fortified-gray-light); }
  .pdp-disc__inner { max-width: 920px; margin: 0 auto; }
  .pdp-disc__title { font-family: var(--font-fortified-display); font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--fortified-black); margin: 0 0 18px; text-align: center; }
  .pdp-disc__warnings { display: grid; gap: 10px; margin-bottom: 20px; }
  .pdp-disc__warn { background: var(--fortified-off-white); border-left: 3px solid var(--fortified-orange); padding: 12px 16px; border-radius: 0 10px 10px 0; }
  .pdp-disc__warn-label { display: block; font-family: var(--font-fortified-display); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fortified-black); margin-bottom: 4px; }
  .pdp-disc__warn p { margin: 0; font-size: 13px; line-height: 1.5; }
  .pdp-disc__fda { font-size: 12px; line-height: 1.55; text-align: center; margin: 0 0 10px; }
  .pdp-disc__fine { font-size: 11px; line-height: 1.5; text-align: center; margin: 0; color: var(--fortified-gray-mid); }
{% endstylesheet %}

{% schema %}
{
  "name": "12-Omni-Disclaimer",
  "tag": "section",
  "class": "pdp-section pdp-section--disclaimer",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Important to know"
    },
    {
      "type": "textarea",
      "id": "fda_text",
      "label": "FDA disclaimer",
      "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "textarea",
      "id": "fineprint",
      "label": "Fine print (optional)",
      "default": "Consult your physician before using if you are pregnant, nursing, have a medical condition, or take any medication."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "blocks_alignment",
      "label": "Blocks row position",
      "info": "How the row/grid of blocks sits inside the section. Use Center to push blocks to the middle of the section width.",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "warning",
      "name": "Warning callout",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Contains caffeine"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Fortified Energy contains 200mg of caffeine per pouch. Not recommended for children, pregnant women, or anyone sensitive to caffeine."
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit from section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "12-Omni-Disclaimer",
      "category": "Fortified Omni",
      "settings": {},
      "blocks": [
        {
          "type": "warning",
          "settings": {
            "label": "Contains caffeine",
            "body": "Fortified Energy contains 200mg caffeine per pouch \u2014 equivalent to two cups of coffee. Not recommended for children, those pregnant or nursing, or anyone caffeine-sensitive."
          }
        },
        {
          "type": "warning",
          "settings": {
            "label": "Vitamin K2 notice",
            "body": "If you take blood thinners (warfarin, etc.), consult your doctor before using products containing Vitamin K2."
          }
        },
        {
          "type": "warning",
          "settings": {
            "label": "Sodium content",
            "body": "If you have been advised to follow a low-sodium diet, talk to your healthcare provider before regular use."
          }
        }
      ]
    }
  ]
}
{% endschema %}
