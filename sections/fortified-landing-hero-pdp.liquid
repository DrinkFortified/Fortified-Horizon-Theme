{% render 'fortified-base' %}

{%- liquid
  assign content_align = section.settings.content_alignment | default: 'center'
  assign blocks_align = section.settings.blocks_alignment | default: 'center'
  assign default_plan_id = ''
  for block in section.blocks
    if block.type == 'plan' and block.settings.is_default
      assign default_plan_id = block.settings.plan_id
    endif
  endfor
-%}

<section
  id="FortifiedLandingHeroPDP-{{ section.id }}"
  class="fortified-landing-hero-pdp color-{{ section.settings.color_scheme }}"
  style="text-align: {{ content_align }};"
  data-fortified-landing-pdp
  data-default-plan="{{ default_plan_id }}"
  {{ section.shopify_attributes }}
>
  <div class="fortified-container fortified-landing-hero-pdp__inner">
    <div class="fortified-landing-hero-pdp__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag:
            widths: '560, 800, 1100, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'fortified-landing-hero-pdp__image',
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'eager',
            fetchpriority: 'high' }}
      {% else %}
        <div class="fortified-landing-hero-pdp__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'fortified-landing-hero-pdp__placeholder-svg' }}
        </div>
      {% endif %}

      <ul class="fortified-landing-hero-pdp__usp"
          style="justify-content: {{ blocks_align }};">
        {% for block in section.blocks %}
          {% if block.type == 'usp' %}
            <li class="fortified-landing-hero-pdp__usp-item"
                style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};"
                {{ block.shopify_attributes }}>
              <span class="fortified-landing-hero-pdp__usp-check" aria-hidden="true">✓</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="fortified-landing-hero-pdp__buy">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="fortified-heading fortified-h1 fortified-landing-hero-pdp__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.rating_text != blank %}
        <div class="fortified-landing-hero-pdp__rating">
          <span class="fortified-landing-hero-pdp__stars">★★★★★</span>
          <span class="fortified-landing-hero-pdp__rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="fortified-landing-hero-pdp__body fortified-body">{{ section.settings.body }}</div>
      {% endif %}

      <fieldset class="fortified-landing-hero-pdp__plans">
        <legend class="fortified-landing-hero-pdp__legend">{{ section.settings.plans_label | default: 'CHOOSE YOUR PLAN' }}</legend>
        <div class="fortified-landing-hero-pdp__plans-grid"
             style="justify-content: {{ blocks_align }};">
          {% for block in section.blocks %}
            {% if block.type == 'plan' %}
              {%- assign is_default = false -%}
              {%- if block.settings.is_default -%}{%- assign is_default = true -%}{%- endif -%}
              <label
                class="fortified-landing-hero-pdp__plan{% if is_default %} is-selected{% endif %}"
                data-plan-id="{{ block.settings.plan_id }}"
                style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};"
                {{ block.shopify_attributes }}
              >
                <input
                  type="radio"
                  name="plan-{{ section.id }}"
                  value="{{ block.settings.plan_id }}"
                  {% if is_default %}checked{% endif %}
                >
                {% if block.settings.badge != blank %}
                  <span class="fortified-landing-hero-pdp__plan-badge">{{ block.settings.badge }}</span>
                {% endif %}
                <span class="fortified-landing-hero-pdp__plan-title">{{ block.settings.label }}</span>
                <span class="fortified-landing-hero-pdp__plan-detail">{{ block.settings.detail }}</span>
                <span class="fortified-landing-hero-pdp__plan-price">
                  {{ block.settings.price_display }}
                  {% if block.settings.compare_at != blank %}
                    <s class="fortified-landing-hero-pdp__plan-compare">{{ block.settings.compare_at }}</s>
                  {% endif %}
                </span>
                {% if block.settings.savings != blank %}
                  <span class="fortified-landing-hero-pdp__plan-savings">{{ block.settings.savings }}</span>
                {% endif %}
              </label>
            {% endif %}
          {% endfor %}
        </div>
      </fieldset>

      <a
        href="{{ section.settings.cta_url | default: '#' }}"
        class="fortified-btn fortified-btn--primary fortified-landing-hero-pdp__cta"
        data-fortified-landing-pdp-cta
      >
        <span class="fortified-landing-hero-pdp__cta-label">{{ section.settings.cta_label | default: 'ADD TO CART' }}</span>
        <span class="fortified-landing-hero-pdp__cta-price" data-cta-price></span>
      </a>

      <ul class="fortified-landing-hero-pdp__trust">
        {% if section.settings.trust_1 != blank %}<li>{{ section.settings.trust_1 }}</li>{% endif %}
        {% if section.settings.trust_2 != blank %}<li>{{ section.settings.trust_2 }}</li>{% endif %}
        {% if section.settings.trust_3 != blank %}<li>{{ section.settings.trust_3 }}</li>{% endif %}
      </ul>

      {% if section.settings.loop_note != blank %}
        <p class="fortified-landing-hero-pdp__loop-note">{{ section.settings.loop_note }}</p>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('FortifiedLandingHeroPDP-{{ section.id }}');
  if(!root) return;
  var plans = root.querySelectorAll('.fortified-landing-hero-pdp__plan');
  var ctaPrice = root.querySelector('[data-cta-price]');
  function selectPlan(planEl){
    plans.forEach(function(p){ p.classList.remove('is-selected'); });
    planEl.classList.add('is-selected');
    var input = planEl.querySelector('input[type="radio"]');
    if(input) input.checked = true;
    var price = planEl.querySelector('.fortified-landing-hero-pdp__plan-price');
    if(price && ctaPrice){
      ctaPrice.textContent = ' — ' + (price.firstChild.textContent || '').trim();
    }
  }
  plans.forEach(function(p){
    p.addEventListener('click', function(){ selectPlan(p); });
  });
  // Init from default
  var pre = root.querySelector('.fortified-landing-hero-pdp__plan.is-selected') || plans[0];
  if(pre) selectPlan(pre);
})();
</script>

{% stylesheet %}
  .fortified-landing-hero-pdp {
    background: var(--color-background, #fff);
    color: var(--color-foreground);
    padding-block: var(--fortified-section-py);
    overflow: hidden;
  }
  .fortified-landing-hero-pdp__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  @media (min-width: 990px) {
    .fortified-landing-hero-pdp__inner { grid-template-columns: 1.05fr 1fr; }
  }
  .fortified-landing-hero-pdp__media {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .fortified-landing-hero-pdp__image,
  .fortified-landing-hero-pdp__placeholder-svg {
    width: 100%;
    max-width: 640px;
    height: auto;
    border-radius: 24px;
    object-fit: cover;
  }
  .fortified-landing-hero-pdp__usp {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 8px 16px;
    width: 100%;
  }
  .fortified-landing-hero-pdp__usp-item {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 500;
  }
  .fortified-landing-hero-pdp__usp-check {
    width: 16px; height: 16px;
    background: var(--fortified-teal); color: #fff;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700;
    flex-shrink: 0;
  }
  .fortified-landing-hero-pdp__buy {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: 14px;
  }
  .fortified-landing-hero-pdp__heading { line-height: 1; }
  .fortified-landing-hero-pdp__rating {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 500;
  }
  .fortified-landing-hero-pdp__stars {
    color: var(--fortified-orange); letter-spacing: 2px;
  }
  .fortified-landing-hero-pdp__body { max-width: 56ch; }
  .fortified-landing-hero-pdp__legend {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fortified-gray-mid);
    margin-bottom: 10px;
  }
  .fortified-landing-hero-pdp__plans {
    border: 0; padding: 0; margin: 0;
    display: flex; flex-direction: column;
    width: 100%;
  }
  .fortified-landing-hero-pdp__plans-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 600px) {
    .fortified-landing-hero-pdp__plans-grid { grid-template-columns: 1fr 1fr; }
  }
  .fortified-landing-hero-pdp__plan {
    border: 1.5px solid var(--fortified-gray-light);
    border-radius: 16px;
    padding: 16px 18px;
    cursor: pointer;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .fortified-landing-hero-pdp__plan:hover { border-color: var(--fortified-gray-mid); transform: translateY(-1px); }
  .fortified-landing-hero-pdp__plan.is-selected {
    border-color: var(--fortified-teal);
    box-shadow: 0 0 0 2px rgba(31, 168, 161, 0.18);
  }
  .fortified-landing-hero-pdp__plan input[type="radio"] {
    position: absolute; opacity: 0; pointer-events: none;
  }
  .fortified-landing-hero-pdp__plan-badge {
    align-self: flex-start;
    background: var(--fortified-teal); color: #fff;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 3px 8px; border-radius: 100px;
    margin-bottom: 4px;
  }
  .fortified-landing-hero-pdp__plan-title {
    font-family: var(--font-fortified-display);
    font-size: 16px; font-weight: 700;
    text-transform: uppercase;
  }
  .fortified-landing-hero-pdp__plan-detail {
    font-size: 12px; color: var(--fortified-gray-mid); line-height: 1.4;
  }
  .fortified-landing-hero-pdp__plan-price {
    font-family: var(--font-fortified-display);
    font-size: 22px; font-weight: 700;
    color: var(--fortified-black);
    margin-top: 4px;
    display: inline-flex; align-items: baseline; gap: 8px;
  }
  .fortified-landing-hero-pdp__plan-compare {
    font-size: 12px; font-weight: 500; color: var(--fortified-gray-mid);
  }
  .fortified-landing-hero-pdp__plan-savings {
    font-size: 11px; font-weight: 600; color: var(--fortified-success);
  }
  .fortified-landing-hero-pdp__cta {
    width: 100%; max-width: 480px;
    margin-top: 8px;
  }
  .fortified-landing-hero-pdp__cta-price {
    margin-left: 2px;
  }
  .fortified-landing-hero-pdp__trust {
    list-style: none; padding: 0; margin: 8px 0 0;
    display: flex; flex-wrap: wrap; gap: 6px 16px;
    font-size: 12px; color: var(--fortified-gray-mid);
  }
  .fortified-landing-hero-pdp__loop-note {
    font-size: 12px; color: var(--fortified-gray-mid);
    margin-top: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP Hero - PDP",
  "tag": "section",
  "class": "fortified-section fortified-section--landing-hero-pdp",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FORTIFIED EVERYDAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HYDRATION THAT HITS" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 — 12,400+ verified reviews" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>1,200mg sodium · 150mg magnesium glycinate · 300mg potassium. Zero sugar. Clinically dosed for real performance.</p>" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },

    { "type": "header", "content": "Purchase flow" },
    { "type": "text", "id": "plans_label", "label": "Plans group label", "default": "CHOOSE YOUR PLAN" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "ADD TO CART" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "trust_1", "label": "Trust line 1", "default": "Free U.S. shipping in 1–4 days" },
    { "type": "text", "id": "trust_2", "label": "Trust line 2", "default": "30-day money-back guarantee" },
    { "type": "text", "id": "trust_3", "label": "Trust line 3", "default": "Cancel anytime via Loop" },
    { "type": "richtext", "id": "loop_note", "label": "Loop note", "default": "<p>Subscriptions managed by Loop. Pause, skip, or cancel anytime from your account.</p>" },

    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "blocks_alignment",
      "label": "Blocks row position",
      "options": [
        { "value": "flex-start",    "label": "Left" },
        { "value": "center",        "label": "Center" },
        { "value": "flex-end",      "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "flex-start"
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Purchase plan",
      "settings": [
        { "type": "text", "id": "plan_id", "label": "Plan ID (slug)", "default": "monthly" },
        { "type": "text", "id": "label", "label": "Plan name", "default": "Monthly subscription" },
        { "type": "text", "id": "detail", "label": "Plan detail", "default": "1 pouch · ships every 30 days" },
        { "type": "text", "id": "badge", "label": "Badge text" },
        { "type": "text", "id": "price_display", "label": "Price (display)", "default": "$32" },
        { "type": "text", "id": "compare_at", "label": "Compare-at price (strike-through)" },
        { "type": "text", "id": "savings", "label": "Savings line", "default": "Save 20%" },
        { "type": "checkbox", "id": "is_default", "label": "Selected by default", "default": false },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            { "value": "inherit", "label": "Inherit from section" },
            { "value": "left",    "label": "Left" },
            { "value": "center",  "label": "Center" },
            { "value": "right",   "label": "Right" }
          ],
          "default": "inherit"
        }
      ]
    },
    {
      "type": "usp",
      "name": "USP / Trust pill",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free U.S. shipping" },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Block alignment",
          "options": [
            { "value": "inherit", "label": "Inherit from section" },
            { "value": "left",    "label": "Left" },
            { "value": "center",  "label": "Center" },
            { "value": "right",   "label": "Right" }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Hero - PDP",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": [
        { "type": "plan", "settings": { "plan_id": "one-time", "label": "One-time", "detail": "1 pouch · no commitment", "price_display": "$40" } },
        { "type": "plan", "settings": { "plan_id": "monthly", "label": "Monthly", "detail": "1 pouch / month · 20% off", "badge": "Most popular", "price_display": "$32", "compare_at": "$40", "savings": "Save 20%", "is_default": true } },
        { "type": "plan", "settings": { "plan_id": "quarterly", "label": "Quarterly", "detail": "3 pouches every 3 months", "badge": "Best value", "price_display": "$84", "compare_at": "$120", "savings": "Save 30%" } },
        { "type": "usp", "settings": { "text": "1,200mg sodium" } },
        { "type": "usp", "settings": { "text": "Zero sugar" } },
        { "type": "usp", "settings": { "text": "Magnesium glycinate" } }
      ]
    }
  ]
}
{% endschema %}
