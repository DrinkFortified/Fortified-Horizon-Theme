{% comment %}
  Section: FTD-B - Promise
{% endcomment %}

{%- liquid
  assign heading_html = section.settings.heading
  assign emphasis_word = section.settings.heading_emphasis_word
  if heading_html != blank and emphasis_word != blank
    assign em_open = '<em class="ftbpr__em">'
    assign em_close = '</em>'
    assign emphasized = em_open | append: emphasis_word | append: em_close
    assign heading_html = heading_html | replace_first: emphasis_word, emphasized
  endif
  assign image_position = section.settings.image_position_desktop | default: 'right'
-%}

<section
  class="ftbpr ftbpr--{{ image_position }} section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %} --ftbpr-max-w: {{ section.settings.content_max_width }}px; --ftbpr-eyebrow: {{ section.settings.eyebrow_color }}; --ftbpr-quote-accent: {{ section.settings.quote_accent_color }}; --ftbpr-box-bg: {{ section.settings.promise_box_bg }}; --ftbpr-box-border: {{ section.settings.promise_box_border }}; --ftbpr-box-fg: {{ section.settings.promise_text_color }};"
  {{ section.shopify_attributes }}
>
  <div class="ftbpr__inner">
    <div class="ftbpr__grid">
      <div class="ftbpr__col ftbpr__col--text">
        {%- if section.settings.eyebrow != blank -%}<p class="ftbpr__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if heading_html != blank -%}<h2 class="ftbpr__heading">{{ heading_html | newline_to_br }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<p class="ftbpr__body">{{ section.settings.body }}</p>{%- endif -%}
        {%- if section.settings.quote != blank -%}<blockquote class="ftbpr__quote">{{ section.settings.quote }}</blockquote>{%- endif -%}
      </div>
      <div class="ftbpr__col ftbpr__col--box">
        <div class="ftbpr__box">
          {%- if section.settings.promise_title != blank -%}<div class="ftbpr__box-title">{{ section.settings.promise_title }}</div>{%- endif -%}
          {%- if section.settings.promise_subtitle != blank -%}<div class="ftbpr__box-sub">{{ section.settings.promise_subtitle }}</div>{%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <div class="ftbpr__pills">
              {%- for block in section.blocks -%}
                {%- if block.type == 'pill' -%}
                  {%- assign kind = block.settings.kind | default: 'included' -%}
                  <span class="ftbpr__pill ftbpr__pill--{{ kind }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.ftbpr { display: block; }
.ftbpr__inner { max-width: var(--ftbpr-max-w, 1240px); margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); }
.ftbpr__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
.ftbpr--left .ftbpr__col--text { order: 2; }
.ftbpr--left .ftbpr__col--box  { order: 1; }
.ftbpr__col--text { display: flex; flex-direction: column; gap: 16px; }
.ftbpr__eyebrow { margin: 0; font-family: var(--font-heading--family, inherit); font-size: var(--ftd-eyebrow-size); font-weight: 700; letter-spacing: var(--ftd-eyebrow-spacing); text-transform: uppercase; color: var(--ftbpr-eyebrow, var(--color-foreground)); }
.ftbpr__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-size: var(--ftd-h2-size); font-weight: var(--ftd-heading-weight, 800); line-height: var(--ftd-h2-line, 1.1); letter-spacing: -0.01em; text-transform: uppercase; color: var(--color-foreground); }
.ftbpr__em { color: var(--ftbpr-quote-accent, var(--color-foreground)); font-style: italic; }
.ftbpr__body { margin: 0; font-size: var(--ftd-sub-size); line-height: var(--ftd-sub-line, 1.6); color: var(--color-foreground); opacity: 0.82; max-width: 60ch; }
.ftbpr__quote { margin: 8px 0 0; padding: 18px 22px; border-left: 4px solid var(--ftbpr-quote-accent, #1FA8A1); background: rgb(var(--color-foreground-rgb) / 0.04); font-family: var(--font-heading--family, inherit); font-size: clamp(16px, 1.6vw, 19px); font-style: italic; line-height: 1.45; color: var(--color-foreground); border-radius: 4px; }
.ftbpr__box { background: var(--ftbpr-box-bg, #E6EFE9); color: var(--ftbpr-box-fg, #1B3F2A); border: 1px solid var(--ftbpr-box-border, #B9CFC0); border-radius: 14px; padding: clamp(22px, 3vw, 32px); }
.ftbpr__box-title { font-family: var(--font-heading--family, inherit); font-size: var(--ftd-h3-size); font-weight: 700; line-height: 1.05; letter-spacing: -0.01em; text-transform: uppercase; color: var(--ftbpr-box-fg, #1B3F2A); }
.ftbpr__box-sub { margin-top: 8px; font-size: var(--ftd-body-size); line-height: 1.45; opacity: 0.85; color: var(--ftbpr-box-fg, #1B3F2A); }
.ftbpr__pills { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px; }
.ftbpr__pill { display: inline-block; padding: 7px 13px; border-radius: 999px; font-family: var(--font-heading--family, inherit); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1; background: rgb(255 255 255 / 0.7); color: var(--ftbpr-box-fg, #1B3F2A); border: 1px solid var(--ftbpr-box-border, #B9CFC0); }
.ftbpr__pill--excluded { background: transparent; color: var(--ftbpr-box-fg, #1B3F2A); opacity: 0.55; text-decoration: line-through; text-decoration-thickness: 1.5px; border-style: dashed; }
@media (max-width: 749px) {
  .ftbpr__grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .ftbpr--left .ftbpr__col--text, .ftbpr--left .ftbpr__col--box, .ftbpr--right .ftbpr__col--text, .ftbpr--right .ftbpr__col--box { order: initial; }
  .ftbpr__col--text { order: 1; }
  .ftbpr__col--box  { order: 2; }
}
[hidden] { display: none !important; }
{% endstylesheet %}

