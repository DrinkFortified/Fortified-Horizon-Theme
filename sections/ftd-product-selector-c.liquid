{% comment %}
  Section: FTD - Product Selector C
  Category: Fortified Sections
  ----------------------------------------------------------------------
  Section version of the C selector. Renders the same wizard
  (Plan -> Products -> Upsells -> Cart) as the slide-over sibling
  (blocks/ftd-product-selector-c-slideover.liquid) but inline in the
  page flow.

  Architecture: child theme blocks (_ftd-c-function, _ftd-c-bullet,
  _ftd-c-upsell) self-render their own markup with data-slot attrs.
  We render them via content_for 'blocks' into a hidden staging div,
  then JS moves each one into the right container on init.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign show_onetime   = section.settings.show_onetime
  assign show_monthly   = section.settings.show_monthly
  assign show_quarterly = section.settings.show_quarterly
  assign bundle_count   = section.settings.bundle_count | default: 3
  assign addon          = section.settings.addon_product
  assign addon_variant_id = ''
  if addon != blank and addon.selected_or_first_available_variant != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif
  assign acc_monthly   = section.settings.monthly_accent_color   | default: '#1FA8A1'
  assign acc_quarterly = section.settings.quarterly_accent_color | default: '#E8833A'
  assign acc_onetime   = section.settings.onetime_accent_color   | default: '#8E8E93'
-%}

{{ 'ftdc.css' | asset_url | stylesheet_tag }}

<style>
  /* Per-plan accent: override --ftdc-accent on each plan card so EVERYTHING
     that reads the accent (badge background, top stripe, selected border,
     tick, glow) uses that plan's color consistently. */
  #ftdc-{{ sid }} .ftdc__plan[data-plan="monthly"] { --ftdc-accent: {{ acc_monthly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="quarterly"] { --ftdc-accent: {{ acc_quarterly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] { --ftdc-accent: {{ acc_onetime }}; }
  #ftdc-{{ sid }} .ftdc__plan { border-top: 4px solid var(--ftdc-accent, var(--color-primary-button-background)); }
  #ftdc-{{ sid }} .ftdc__step--has-image.is-active { display: grid; grid-template-columns: minmax(300px, 460px) 1fr; gap: 1.4rem; align-items: start; }
  #ftdc-{{ sid }} .ftdc__plans-image { position: sticky; top: 1rem; }
  #ftdc-{{ sid }} .ftdc__plans-image img { width: 100%; height: auto; display: block; border-radius: var(--ftdc-radius, 12px); object-fit: cover; }
  /* Plan layout: the two subscriptions side-by-side on top, Buy Once
     spanning the full width beneath them. */
  #ftdc-{{ sid }} .ftdc__plans { grid-template-columns: 1fr 1fr; }
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-column: 1 / -1; }
  /* Center the bundle (Step 2) cards: fixed-width tracks + justify-content
     so a partial row sits centered instead of left-aligned. Desktop only —
     the mobile 2-column layout from ftdc.css is left as-is. */
  #ftdc-{{ sid }} .ftdc__grid { justify-content: center; }
  @media (min-width: 600px) {
    #ftdc-{{ sid }} .ftdc__grid { grid-template-columns: repeat(auto-fill, minmax(200px, 230px)); }
  }
  @media (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__step--has-image.is-active { grid-template-columns: 1fr; gap: 1rem; }
    #ftdc-{{ sid }} .ftdc__plans-image { position: static; }
    #ftdc-{{ sid }} .ftdc__plans-image img { max-height: 220px; }
    #ftdc-{{ sid }} .ftdc__plans { grid-template-columns: 1fr; }
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-column: auto; }
  }
  /* Announcement bar (slot above wizard header). One or more bars stacked. */
  #ftdc-{{ sid }} .ftdc__announce { display: flex; flex-direction: column; margin: -1rem -1rem 1rem; }
  #ftdc-{{ sid }} .ftdc__announce[hidden] { display: none; }
  #ftdc-{{ sid }} .ftdc__announce-bar { padding: 0.55rem 1rem; font-size: 0.82rem; line-height: 1.3; text-align: center; }
  #ftdc-{{ sid }} .ftdc__announce-bar--fomo { padding: 0.55rem 1rem 0.65rem; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-row { display: block; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-line strong { font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-bar { display: block; margin: 0.4rem auto 0; max-width: 320px; height: var(--ftdc-fomo-h, 6px); background: var(--ftdc-fomo-track); border-radius: 999px; overflow: hidden; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-bar-fill { height: 100%; background: var(--ftdc-fomo-fill); transition: width 0.35s ease; }
  #ftdc-{{ sid }} .ftdc__announce-link { text-decoration: none; }
  #ftdc-{{ sid }} .ftdc__announce-link:hover { text-decoration: underline; }

  /* Step 4 — Review */
  #ftdc-{{ sid }} .ftdc__review-plan { margin: 0.25rem 0 0; font-weight: 700; }
  #ftdc-{{ sid }} .ftdc__review-lines { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  #ftdc-{{ sid }} .ftdc__review-line { display: grid; grid-template-columns: 56px 1fr auto auto; align-items: center; gap: 0.85rem; padding: 0.75rem 0; border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12); }
  #ftdc-{{ sid }} .ftdc__review-line:first-child { border-top: 0; padding-top: 0; }
  #ftdc-{{ sid }} .ftdc__review-line-thumb { width: 56px; height: 56px; border-radius: 8px; background: rgb(var(--color-foreground-rgb) / 0.06); overflow: hidden; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  #ftdc-{{ sid }} .ftdc__review-line-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ftdc-{{ sid }} .ftdc__review-line-name { font-weight: 600; line-height: 1.25; }
  #ftdc-{{ sid }} .ftdc__review-line-qty { color: rgb(var(--color-foreground-rgb) / 0.6); font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-line-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-line-price--free { color: var(--ftdc-accent, #1FA8A1); }
  #ftdc-{{ sid }} .ftdc__review-extra { margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed rgb(var(--color-foreground-rgb) / 0.2); }
  #ftdc-{{ sid }} .ftdc__review-extra .ftdc__review-line--extra { grid-template-columns: 56px 1fr auto; border-top: 0; padding-top: 0.5rem; padding-bottom: 0.5rem; }
  #ftdc-{{ sid }} .ftdc__review-totals { margin: 1rem 0 1.25rem; padding-top: 0.75rem; border-top: 2px solid rgb(var(--color-foreground-rgb) / 0.2); display: flex; flex-direction: column; gap: 0.4rem; }
  #ftdc-{{ sid }} .ftdc__review-row { display: flex; align-items: baseline; justify-content: space-between; margin: 0; }
  #ftdc-{{ sid }} .ftdc__review-row dt { margin: 0; font-weight: 600; }
  #ftdc-{{ sid }} .ftdc__review-row dd { margin: 0; font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-row--total dt, #ftdc-{{ sid }} .ftdc__review-row--total dd { font-size: 1.15rem; font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__review-row--saved dd { color: var(--ftdc-accent, #1FA8A1); }
</style>

<section
  id="ftdc-{{ sid }}"
  class="ftdc color-{{ section.settings.color_scheme }}"
  data-section-id="{{ sid }}"
  style="--ftdc-accent: {{ section.settings.accent_color }}; --ftdc-radius: {{ section.settings.card_radius }}px; --ftdc-max-w: {{ section.settings.content_max_width }}px;"
  {{ section.shopify_attributes }}
>
  <div class="ftdc__inner">

    <div class="ftdc__announce" data-announce hidden></div>

    <header class="ftdc__header">
      {%- if section.settings.heading != blank -%}<h2 class="ftdc__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}<div class="ftdc__desc">{{ section.settings.description }}</div>{%- endif -%}
      <ul class="ftdc__bullets list-unstyled" data-bullets hidden></ul>
    </header>

    <ol class="ftdc__steps" role="list" aria-label="Order steps">
      <li class="ftdc__step-pill is-active" data-step-pill="plans"><span class="ftdc__step-num">1</span><span class="ftdc__step-label">{{ section.settings.step_label_1 | default: 'Plan' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="products"><span class="ftdc__step-num">2</span><span class="ftdc__step-label">{{ section.settings.step_label_2 | default: 'Bundle' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="upsells"><span class="ftdc__step-num">3</span><span class="ftdc__step-label">{{ section.settings.step_label_3 | default: 'Boost' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="review"><span class="ftdc__step-num">4</span><span class="ftdc__step-label">{{ section.settings.step_label_4 | default: 'Review' }}</span></li>
    </ol>

    {%- comment %} ───── STEP 1 — PLANS ───── {%- endcomment %}
    <div class="ftdc__step is-active{% if section.settings.plan_image != blank %} ftdc__step--has-image{% endif %}" data-step="plans">
      {%- if section.settings.plan_image != blank -%}
        <div class="ftdc__plans-image">
          <img src="{{ section.settings.plan_image | image_url: width: 1000 }}" alt="" width="460" height="460" loading="lazy">
        </div>
      {%- endif -%}
      <div class="ftdc__plans" data-plan-order="{{ section.settings.plan_order | default: 'quarterly,monthly,onetime' }}">
        {%- if show_quarterly -%}
          <label class="ftdc__plan is-active" data-plan="quarterly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="quarterly" checked>
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if section.settings.quarterly_badge != blank -%}<span class="ftdc__plan-badge">{{ section.settings.quarterly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ section.settings.quarterly_title | default: '3 Pouches Every 3 Months' }}</div>
            {%- if section.settings.quarterly_desc != blank -%}<div class="ftdc__plan-desc">{{ section.settings.quarterly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ section.settings.quarterly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ section.settings.quarterly_period | default: '/ month' }}</span></div>
            {%- if section.settings.quarterly_was != blank -%}<div class="ftdc__plan-was">{{ section.settings.quarterly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_monthly -%}
          <label class="ftdc__plan" data-plan="monthly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="monthly">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if section.settings.monthly_badge != blank -%}<span class="ftdc__plan-badge">{{ section.settings.monthly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ section.settings.monthly_title | default: '1 Pouch Every Month' }}</div>
            {%- if section.settings.monthly_desc != blank -%}<div class="ftdc__plan-desc">{{ section.settings.monthly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ section.settings.monthly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ section.settings.monthly_period | default: '/ month' }}</span></div>
            {%- if section.settings.monthly_was != blank -%}<div class="ftdc__plan-was">{{ section.settings.monthly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_onetime -%}
          <label class="ftdc__plan" data-plan="onetime">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="onetime">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if section.settings.onetime_badge != blank -%}<span class="ftdc__plan-badge">{{ section.settings.onetime_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ section.settings.onetime_title | default: 'Single Pouch' }}</div>
            {%- if section.settings.onetime_desc != blank -%}<div class="ftdc__plan-desc">{{ section.settings.onetime_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ section.settings.onetime_price | default: '$59.00' }}</span><span class="ftdc__plan-period">{{ section.settings.onetime_period | default: '/ pouch' }}</span></div>
            {%- assign _ow = section.settings.onetime_was | strip -%}
            {%- if _ow != blank and _ow != '-' and _ow != '—' -%}<div class="ftdc__plan-was">{{ section.settings.onetime_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
      </div>
    </div>

    {%- comment %} ───── STEP 2 — PRODUCTS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="products" hidden>
      <button class="ftdc__back" type="button" data-step-back="plans" aria-label="Back to plan"><span aria-hidden="true">←</span> {{ section.settings.back_label | default: 'Back' }}</button>
      <div class="ftdc__bundle-head">
        <p class="ftdc__bundle-eyebrow">{{ section.settings.bundle_label | default: 'Your Bundle' }}</p>
        <p class="ftdc__bundle-progress-text" data-progress-text>0 {{ section.settings.of_word | default: 'of' }} {{ bundle_count }} {{ section.settings.selected_word | default: 'selected' }}</p>
        <div class="ftdc__bundle-bar"><div class="ftdc__bundle-bar-fill" data-progress-fill style="width:0%"></div></div>
      </div>
      <div class="ftdc__empty" data-grid-empty hidden>
        <p><strong>No products configured yet.</strong></p>
        <p>In the theme editor sidebar, click each <em>Function</em> block inside this selector and pick a Shopify product. Each product variant will render as a selectable card here.</p>
      </div>
      <div class="ftdc__grid" data-grid></div>
    </div>

    {%- comment %} ───── STEP 3 — UPSELLS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="upsells" hidden>
      <button class="ftdc__back" type="button" data-step-back="products" aria-label="Back to bundle"><span aria-hidden="true">←</span> {{ section.settings.back_label | default: 'Back' }}</button>

      {%- comment %} Hardcoded "Creatine included free" indicator — only
      shown on quarterly. Title/desc/FREE label are not exposed in
      theme settings; image reuses the addon image so the merchant
      only manages one creatine asset. {%- endcomment %}
      {%- assign included_img = section.settings.addon_image | default: addon.featured_image -%}
      <div class="ftdc__upsell ftdc__upsell--included" data-creatine-included hidden aria-hidden="true">
        <div class="ftdc__upsell-media">
          {%- if included_img != blank -%}
            <img src="{{ included_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">
          {%- endif -%}
        </div>
        <div class="ftdc__upsell-body">
          <p class="ftdc__upsell-title">Creatine — Included</p>
          <p class="ftdc__upsell-desc">Free with your 3-month bundle.</p>
          <div class="ftdc__upsell-pricing">
            <span class="ftdc__upsell-price ftdc__upsell-price--free">FREE</span>
          </div>
        </div>
        <div class="ftdc__upsell-toggle">
          <span class="ftdc__included-check" aria-label="Included" role="img">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4 4 10-10" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </div>

      {%- if addon != blank -%}
        <div class="ftdc__upsell ftdc__upsell--creatine" data-upsell-creatine>
          <div class="ftdc__upsell-media">
            {%- assign addon_img = section.settings.addon_image | default: addon.featured_image -%}
            {%- if addon_img != blank -%}<img src="{{ addon_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">{%- endif -%}
          </div>
          <div class="ftdc__upsell-body">
            <p class="ftdc__upsell-title" data-creatine-title>{{ section.settings.addon_label_monthly | default: 'Add Creatine — 50% off' }}</p>
            <p class="ftdc__upsell-desc" data-creatine-desc>{{ section.settings.addon_desc_monthly | default: '' }}</p>
            <div class="ftdc__upsell-pricing">
              <span class="ftdc__upsell-price" data-creatine-price>{{ section.settings.addon_price_monthly | default: '$12.00' }}</span>
              {%- if section.settings.addon_was_monthly != blank -%}<s class="ftdc__upsell-was" data-creatine-was>{{ section.settings.addon_was_monthly }}</s>{%- endif -%}
            </div>
          </div>
          <div class="ftdc__upsell-toggle">
            <input type="checkbox" id="ftdc-cr-{{ sid }}" class="visually-hidden" data-creatine-input data-variant="{{ addon_variant_id }}" data-plan-monthly="{{ section.settings.addon_loop_plan_monthly }}" data-plan-quarterly-free="{{ section.settings.addon_loop_plan_quarterly_free }}" data-plan-quarterly-50off="{{ section.settings.addon_loop_plan_quarterly_50off }}" data-discount-onetime="{{ section.settings.addon_discount_code_onetime }}">
            <label for="ftdc-cr-{{ sid }}" class="ftdc__switch" aria-hidden="true"></label>
          </div>
        </div>
      {%- endif -%}

      <div class="ftdc__upsells" data-upsells></div>

      <div class="ftdc__step-actions">
        <button class="ftdc__btn ftdc__btn--ghost" type="button" data-step-back="products">{{ section.settings.add_more_label | default: 'Add More' }}</button>
        <button class="ftdc__btn ftdc__btn--primary" type="button" data-action="review">{{ section.settings.review_label | default: 'Review Order' }}</button>
      </div>
    </div>

    {%- comment %} ───── STEP 4 — REVIEW ───── {%- endcomment %}
    <div class="ftdc__step" data-step="review" hidden>
      <button class="ftdc__back" type="button" data-step-back="upsells" aria-label="Back to add-ons"><span aria-hidden="true">←</span> {{ section.settings.back_label | default: 'Back' }}</button>
      <div class="ftdc__bundle-head">
        <p class="ftdc__bundle-eyebrow">{{ section.settings.review_eyebrow | default: 'Review your order' }}</p>
        <p class="ftdc__review-plan" data-review-plan></p>
      </div>
      <ul class="ftdc__review-lines list-unstyled" data-review-lines></ul>
      <div class="ftdc__review-extra" data-review-extra hidden></div>
      <dl class="ftdc__review-totals">
        <div class="ftdc__review-row ftdc__review-row--saved" data-review-saved-wrap hidden>
          <dt>{{ section.settings.saved_word | default: 'Saved' }}</dt>
          <dd data-review-saved>$0.00</dd>
        </div>
        <div class="ftdc__review-row ftdc__review-row--total">
          <dt>{{ section.settings.total_label | default: 'Total' }}</dt>
          <dd data-review-total>$0.00</dd>
        </div>
      </dl>
      <div class="ftdc__step-actions">
        <button class="ftdc__btn ftdc__btn--ghost" type="button" data-step-back="upsells">{{ section.settings.edit_order_label | default: 'Edit Order' }}</button>
        <button class="ftdc__btn ftdc__btn--primary" type="button" data-action="checkout">{{ section.settings.checkout_label | default: 'Checkout' }}</button>
      </div>
    </div>

    <div class="ftdc__bar" data-bar>
      <div class="ftdc__bar-summary">
        <span class="ftdc__bar-total"><strong>{{ section.settings.total_label | default: 'Total' }}:</strong> <span data-bar-total>$0.00</span></span>
        <span class="ftdc__bar-saved" data-bar-saved-wrap hidden>({{ section.settings.saved_word | default: 'Saved' }} <span data-bar-saved>$0.00</span>)</span>
      </div>
      <button class="ftdc__bar-action" type="button" data-action="next"><span data-bar-label>{{ section.settings.action_label_step1 | default: 'Continue' }}</span></button>
    </div>

  </div>

  {%- comment %} Hidden staging: child theme blocks render here, JS moves them. {%- endcomment %}
  <div style="display:none" data-ftdc-stage aria-hidden="true">{% content_for 'blocks' %}</div>
</section>


<script>
(function () {
  var SID = {{ section.id | json }};
  var root = document.getElementById('ftdc-' + SID);
  if (!root) return;
  var BUNDLE_COUNT = parseInt({{ bundle_count | json }}, 10) || 3;
  var STEPS_ORDER = ['plans', 'products', 'upsells', 'review'];
  var state = { step: 'plans', plan: 'quarterly', selections: {} };
  var PLAN_NAMES = {
    monthly:   {{ section.settings.monthly_title   | default: 'Monthly Subscription' | json }},
    quarterly: {{ section.settings.quarterly_title | default: 'Quarterly Bundle'     | json }},
    onetime:   {{ section.settings.onetime_title   | default: 'One-Time Purchase'    | json }}
  };

  /* Loop bundle mode (quarterly only). When fully configured, the pouches
     are registered with Loop's Create Bundle Transaction API and the cart
     gets pouch lines stamped with one shared loopBundleGuid so the customer
     can edit the whole bundle in Loop's portal later. */
  var LOOP_BUNDLE = {
    enabled:           {{ section.settings.loop_bundle_enabled | json }},
    bundleId:          {{ section.settings.loop_bundle_id | default: '' | json }},
    bundleVariantId:   {{ section.settings.loop_bundle_variant_id | default: '' | json }},
    bundleDiscountId:  {{ section.settings.loop_bundle_discount_id | default: '' | json }},
    apiSellingPlanId:  {{ section.settings.loop_bundle_api_selling_plan_id | default: '' | json }},
    cartSellingPlanId: {{ section.settings.loop_bundle_selling_plan_id | default: '' | json }},
    bundleName:        {{ section.settings.loop_bundle_name | default: '' | json }},
    propKey:           {{ section.settings.loop_bundle_property_key | default: '_bundleId' | json }}
  };
  var LOOP_BUNDLE_ON = !!(LOOP_BUNDLE.enabled && LOOP_BUNDLE.bundleId && LOOP_BUNDLE.apiSellingPlanId);
  function $(s, c) { return (c || root).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || root).querySelectorAll(s)); }
  function fmtMoney(c) { return '$' + (Math.max(0, c) / 100).toFixed(2); }

  function sortStagedBlocks() {
    var stage = $('[data-ftdc-stage]');
    if (!stage) return;
    var bullets = $('[data-bullets]');
    var grid = $('[data-grid]');
    var upsells = $('[data-upsells]');
    var announce = $('[data-announce]');
    var moved = { bullet: 0, fn: 0, fnPh: 0, up: 0, ann: 0 };
    $$('[data-slot="announce"]', stage).forEach(function (n) { if (announce) { announce.appendChild(n); moved.ann++; } });
    $$('[data-slot="bullet"]', stage).forEach(function (n) { if (bullets) { bullets.appendChild(n); moved.bullet++; } });
    $$('[data-slot="function"]', stage).forEach(function (n) { if (grid) { grid.appendChild(n); moved.fn++; } });
    $$('[data-slot="function-placeholder"]', stage).forEach(function (n) { if (grid) { grid.appendChild(n); moved.fnPh++; } });
    $$('[data-slot="upsell"]', stage).forEach(function (n) { if (upsells) { upsells.appendChild(n); moved.up++; } });
    if (bullets) bullets.hidden = moved.bullet === 0;
    if (announce) announce.hidden = moved.ann === 0;
    var gridEmpty = $('[data-grid-empty]');
    if (gridEmpty) gridEmpty.hidden = (moved.fn > 0);
  }
  sortStagedBlocks();

  var plansContainer = $('.ftdc__plans');
  if (plansContainer && plansContainer.dataset.planOrder) {
    plansContainer.dataset.planOrder.split(',').forEach(function (name) {
      var n = name.trim(); if (!n) return;
      var plan = plansContainer.querySelector('[data-plan="' + n + '"]');
      if (plan) plansContainer.appendChild(plan);
    });
  }
  var firstPlan = plansContainer ? plansContainer.querySelector('.ftdc__plan') : null;
  if (firstPlan) {
    $$('.ftdc__plan').forEach(function (p) { p.classList.remove('is-active'); var r = p.querySelector('input'); if (r) r.checked = false; });
    firstPlan.classList.add('is-active');
    var fr = firstPlan.querySelector('input'); if (fr) { fr.checked = true; state.plan = fr.value; }
  }

  function showStep(name) {
    state.step = name;
    var idx = STEPS_ORDER.indexOf(name);
    $$('.ftdc__step').forEach(function (s) { var m = s.dataset.step === name; s.hidden = !m; s.classList.toggle('is-active', m); });
    $$('.ftdc__step-pill').forEach(function (p) { var pi = STEPS_ORDER.indexOf(p.dataset.stepPill); p.classList.toggle('is-active', pi === idx); p.classList.toggle('is-done', pi < idx); });
    if (name === 'review') renderReview();
    updateBar();
  }

  function updateCreatineIncluded() {
    var el = $('[data-creatine-included]');
    if (el) el.hidden = state.plan !== 'quarterly';
  }

  $$('input[name="ftdc-plan-' + SID + '"]').forEach(function (r) {
    r.addEventListener('change', function () {
      state.plan = r.value;
      $$('.ftdc__plan').forEach(function (p) { p.classList.remove('is-active'); });
      var l = r.closest('.ftdc__plan'); if (l) l.classList.add('is-active');
      state.selections = {};
      $$('.ftdc__card').forEach(reset);
      updateBar(); updateProgress(); updateCreatineIncluded();
    });
  });
  updateCreatineIncluded();

  function reset(c) {
    c.classList.remove('is-selected');
    var a = $('.ftdc__add', c), q = $('.ftdc__qty', c), i = $('.ftdc__qty-input', c);
    if (a) a.hidden = false; if (q) q.hidden = true; if (i) i.value = 0;
  }
  function setQty(c, n) {
    n = Math.max(0, Math.floor(n));
    if (state.plan === 'quarterly') {
      var others = totalQty() - (state.selections[c.dataset.variantId] ? state.selections[c.dataset.variantId].qty : 0);
      n = Math.min(n, Math.max(0, BUNDLE_COUNT - others));
    } else if (state.plan === 'monthly') {
      /* Monthly = exactly 1 pouch total. Selecting another card replaces
         the current selection rather than stacking. */
      n = Math.min(n, 1);
      if (n > 0) {
        Object.keys(state.selections).forEach(function (k) {
          if (k !== c.dataset.variantId) {
            delete state.selections[k];
            var other = root.querySelector('.ftdc__card[data-variant-id="' + k + '"]');
            if (other) {
              other.classList.remove('is-selected');
              var oa = other.querySelector('.ftdc__add'), oq = other.querySelector('.ftdc__qty'), oi = other.querySelector('.ftdc__qty-input');
              if (oa) oa.hidden = false; if (oq) oq.hidden = true; if (oi) oi.value = 0;
            }
          }
        });
      }
    }
    var v = c.dataset.variantId, a = $('.ftdc__add', c), q = $('.ftdc__qty', c), i = $('.ftdc__qty-input', c);
    if (n === 0) {
      delete state.selections[v]; c.classList.remove('is-selected');
      if (a) a.hidden = false; if (q) q.hidden = true; if (i) i.value = 0;
    } else {
      state.selections[v] = { qty: n, variantId: v, fnId: c.dataset.fnId, fnLabel: c.dataset.fnLabel, flavorName: c.dataset.flavorName, planMonthly: c.dataset.planMonthly || '', planQuarterly: c.dataset.planQuarterly || '', price: parseInt(c.dataset.variantPrice, 10) || 0, compareAt: parseInt(c.dataset.variantCompare, 10) || 0 };
      c.classList.add('is-selected');
      if (a) a.hidden = true; if (q) q.hidden = false; if (i) i.value = n;
    }
    updateProgress(); updateBar();
  }

  $$('.ftdc__card[data-slot="function"]').forEach(function (c) {
    c.addEventListener('click', function (e) {
      var b = e.target.closest('[data-card-action]'); if (!b) return;
      var i = $('.ftdc__qty-input', c), cur = parseInt(i ? i.value : 0, 10) || 0;
      if (b.dataset.cardAction === 'add') setQty(c, 1);
      else if (b.dataset.cardAction === 'inc') setQty(c, cur + 1);
      else if (b.dataset.cardAction === 'dec') setQty(c, cur - 1);
    });
    var i = $('.ftdc__qty-input', c);
    if (i) i.addEventListener('change', function () { setQty(c, parseInt(i.value, 10) || 0); });
  });

  function totalQty() { var n = 0; Object.keys(state.selections).forEach(function (k) { n += state.selections[k].qty; }); return n; }
  function bundleSize() { return state.plan === 'quarterly' ? BUNDLE_COUNT : (state.plan === 'monthly' ? 1 : 0); }
  function updateProgress() {
    var n = totalQty(), s = bundleSize(), pt = $('[data-progress-text]'), pf = $('[data-progress-fill]');
    if (!pt || !pf) return;
    if (s) { pt.textContent = n + ' of ' + s + ' selected'; pf.style.width = Math.min(100, n / s * 100) + '%'; }
    else   { pt.textContent = n ? (n + ' selected') : 'Choose your pouches'; pf.style.width = n > 0 ? '100%' : '0%'; }
  }
  function compute() {
    var mu = ({{ section.settings.monthly_estimate_pct | default: 90 }} / 100);
    var qu = ({{ section.settings.quarterly_estimate_pct | default: 90 }} / 100);
    var mul = state.plan === 'monthly' ? mu : state.plan === 'quarterly' ? qu : 1;
    var t = 0, sa = 0;
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k]; var u = s.price * mul; t += u * s.qty;
      var c = s.compareAt > s.price ? s.compareAt : s.price;
      sa += Math.max(0, c - u) * s.qty;
    });
    return { total: Math.round(t), saved: Math.round(sa) };
  }
  function updateBar() {
    var t = compute(), bt = $('[data-bar-total]'), sw = $('[data-bar-saved-wrap]'), sv = $('[data-bar-saved]');
    if (bt) bt.textContent = fmtMoney(t.total);
    if (sw && sv) { if (t.saved > 0) { sw.hidden = false; sv.textContent = fmtMoney(t.saved); } else sw.hidden = true; }
    var lab = $('[data-bar-label]'), btn = $('.ftdc__bar-action'), r = canProc();
    if (state.step === 'plans')         { if (lab) lab.textContent = 'Continue';     if (btn) btn.disabled = false; }
    else if (state.step === 'products') { if (lab) lab.textContent = 'Continue';     if (btn) btn.disabled = !r; }
    else if (state.step === 'upsells')  { if (lab) lab.textContent = 'Review Order'; if (btn) btn.disabled = !r; }
    else                                { if (lab) lab.textContent = 'Checkout';     if (btn) btn.disabled = !r; }
  }
  function canProc() {
    if (state.step === 'plans') return !!state.plan;
    if (state.step === 'products') { var n = totalQty(), s = bundleSize(); return s ? n === s : n > 0; }
    return true;
  }

  function renderReview() {
    var planEl = $('[data-review-plan]');
    if (planEl) planEl.textContent = PLAN_NAMES[state.plan] || state.plan;
    var lines = $('[data-review-lines]');
    if (lines) {
      lines.innerHTML = '';
      var mul = state.plan === 'monthly'   ? ({{ section.settings.monthly_estimate_pct   | default: 90 }} / 100)
              : state.plan === 'quarterly' ? ({{ section.settings.quarterly_estimate_pct | default: 90 }} / 100)
              : 1;
      Object.keys(state.selections).forEach(function (k) {
        var s = state.selections[k];
        var name = s.fnLabel || 'Item';
        if (s.flavorName) name += ' — ' + s.flavorName;
        var lineTotal = Math.round(s.price * mul) * s.qty;
        var card = root.querySelector('.ftdc__card[data-variant-id="' + s.variantId + '"]');
        var img  = card ? card.querySelector('img') : null;
        var imgSrc = img ? (img.currentSrc || img.getAttribute('src') || '') : '';
        var li = document.createElement('li');
        li.className = 'ftdc__review-line';
        var thumb = document.createElement('span'); thumb.className = 'ftdc__review-line-thumb';
        if (imgSrc) { var ti = document.createElement('img'); ti.src = imgSrc; ti.alt = ''; ti.loading = 'lazy'; ti.width = 56; ti.height = 56; thumb.appendChild(ti); }
        var n  = document.createElement('span'); n.className = 'ftdc__review-line-name';  n.textContent  = name;
        var q  = document.createElement('span'); q.className = 'ftdc__review-line-qty';   q.textContent  = '× ' + s.qty;
        var p  = document.createElement('span'); p.className = 'ftdc__review-line-price'; p.textContent  = fmtMoney(lineTotal);
        li.appendChild(thumb); li.appendChild(n); li.appendChild(q); li.appendChild(p);
        lines.appendChild(li);
      });
    }
    var extra = $('[data-review-extra]');
    if (extra) {
      extra.innerHTML = '';
      var extras = [];
      var creatineUpsellImg = (function () {
        var crEl = $('[data-upsell-creatine] .ftdc__upsell-media img') || $('[data-creatine-included] .ftdc__upsell-media img');
        return crEl ? (crEl.currentSrc || crEl.getAttribute('src') || '') : '';
      })();
      if (state.plan === 'quarterly') {
        extras.push({ name: 'Creatine', note: 'Included free with your bundle', price: 'FREE', free: true, imgSrc: creatineUpsellImg });
      }
      var cr = $('[data-creatine-input]');
      if (cr && cr.checked) {
        var priceNode = $('[data-creatine-price]');
        var titleNode = $('[data-creatine-title]');
        extras.push({
          name:  titleNode ? titleNode.textContent.trim() : 'Creatine add-on',
          note:  '',
          price: priceNode ? priceNode.textContent.trim() : '',
          free:  false,
          imgSrc: creatineUpsellImg
        });
      }
      if (extras.length) {
        extra.hidden = false;
        extras.forEach(function (e) {
          var row = document.createElement('div'); row.className = 'ftdc__review-line ftdc__review-line--extra';
          var thumb = document.createElement('span'); thumb.className = 'ftdc__review-line-thumb';
          if (e.imgSrc) { var ti = document.createElement('img'); ti.src = e.imgSrc; ti.alt = ''; ti.loading = 'lazy'; ti.width = 56; ti.height = 56; thumb.appendChild(ti); }
          var n = document.createElement('span'); n.className = 'ftdc__review-line-name'; n.textContent = e.name + (e.note ? ' — ' + e.note : '');
          var p = document.createElement('span'); p.className = 'ftdc__review-line-price' + (e.free ? ' ftdc__review-line-price--free' : ''); p.textContent = e.price;
          row.appendChild(thumb); row.appendChild(n); row.appendChild(p);
          extra.appendChild(row);
        });
      } else {
        extra.hidden = true;
      }
    }
    var t = compute();
    var rt = $('[data-review-total]');
    var sv = $('[data-review-saved]');
    var sw = $('[data-review-saved-wrap]');
    if (rt) rt.textContent = fmtMoney(t.total);
    if (sv && sw) {
      if (t.saved > 0) { sw.hidden = false; sv.textContent = fmtMoney(t.saved); }
      else sw.hidden = true;
    }
  }

  $$('[data-step-back]').forEach(function (b) { b.addEventListener('click', function () { showStep(b.dataset.stepBack); }); });
  var actBtn = $('.ftdc__bar-action');
  if (actBtn) actBtn.addEventListener('click', function () {
    if (state.step === 'plans') showStep('products');
    else if (state.step === 'products') { if (canProc()) showStep('upsells'); }
    else if (state.step === 'upsells') showStep('review');
    else doCheckout();
  });
  $$('[data-action="review"]').forEach(function (b) { b.addEventListener('click', function () { if (canProc()) showStep('review'); }); });
  $$('[data-action="checkout"]').forEach(function (b) { b.addEventListener('click', doCheckout); });

  function buildItems() {
    var items = [];
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k]; var it = { id: parseInt(s.variantId, 10), quantity: s.qty };
      if (state.plan === 'monthly') { var p = parseInt(s.planMonthly, 10); if (p) it.selling_plan = p; }
      else if (state.plan === 'quarterly') {
        var p = parseInt(s.planQuarterly, 10); if (p) it.selling_plan = p;
        /* Marked for Loop bundle grouping; stripped before /cart/add.js. */
        it._bundleable = true;
      }
      items.push(it);
    });
    var cr = $('[data-creatine-input]');
    if (cr && cr.checked) {
      var cv = parseInt(cr.dataset.variant, 10);
      if (cv) {
        var ci = { id: cv, quantity: 1 };
        if (state.plan === 'monthly') { var p = parseInt(cr.dataset.planMonthly, 10); if (p) ci.selling_plan = p; }
        else if (state.plan === 'quarterly') { var p = parseInt(cr.dataset.planQuarterlyFree, 10); if (p) ci.selling_plan = p; }
        else { ci.properties = { _upsell: 'creatine-onetime' }; }
        items.push(ci);
      }
    }
    return items;
  }

  /* Loop's bundle.loopwork.co returns { message, data: { loopBundleGuid } } */
  function extractBundleTxnId(b) {
    var pools = [b, b && b.data, b && b.transaction, b && b.data && b.data.transaction];
    for (var i = 0; i < pools.length; i++) {
      var p = pools[i]; if (!p || typeof p !== 'object') continue;
      var v = (p.data && (p.data.loopBundleGuid || p.data.txnId || p.data.id))
            || p.loopBundleGuid || p.txnId || p.transactionId || p.id;
      if (v) return v;
    }
    return null;
  }
  function loopBundleItems(items) {
    var picks = items.filter(function (it) { return it._bundleable; });
    var rest  = items.filter(function (it) { return !it._bundleable; });
    if (!picks.length) return Promise.resolve(items);
    var body = {
      bundleId:         parseInt(LOOP_BUNDLE.bundleId, 10),
      bundleVariantId:  parseInt(LOOP_BUNDLE.bundleVariantId, 10)  || null,
      bundleDiscountId: parseInt(LOOP_BUNDLE.bundleDiscountId, 10) || null,
      sellingPlanId:    parseInt(LOOP_BUNDLE.apiSellingPlanId, 10)
    };
    return fetch('https://bundle.loopwork.co/api/transactions/create', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) {
        if (!r.ok) throw new Error('Loop bundle API ' + r.status + ': ' + ((b && (b.message || b.error)) || ''));
        return b;
      }); })
      .then(function (b) {
        var txn = extractBundleTxnId(b);
        if (!txn) throw new Error('Loop response missing transaction id');
        var cartPlanId = parseInt(LOOP_BUNDLE.cartSellingPlanId, 10);
        var key = LOOP_BUNDLE.propKey || '_bundleId';
        picks.forEach(function (it) {
          it.properties = it.properties || {};
          it.properties[key] = String(txn);
          if (LOOP_BUNDLE.bundleName) it.properties.bundleName = LOOP_BUNDLE.bundleName;
          if (cartPlanId) it.selling_plan = cartPlanId;
        });
        return picks.concat(rest);
      });
  }

  function doCheckout() {
    if (!canProc()) return;
    var items = buildItems(); if (!items.length) return;
    if (actBtn) actBtn.disabled = true; $$('[data-action="checkout"]').forEach(function (b) { b.disabled = true; });
    var cr = $('[data-creatine-input]');
    var ot = state.plan === 'onetime' && cr && cr.checked;
    var d = ot ? (cr.dataset.discountOnetime || '') : '';

    function postCart(finalItems) {
      finalItems.forEach(function (it) { delete it._bundleable; });
      return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: finalItems }) })
        .then(function (r) { if (!r.ok) return r.json().then(function (b) { throw new Error((b && b.message) || 'Cart error'); }); return r.json(); })
        .then(function () { window.location.href = d ? ('/discount/' + encodeURIComponent(d) + '?redirect=/checkout') : '/checkout'; });
    }

    var run;
    if (LOOP_BUNDLE_ON && state.plan === 'quarterly') {
      run = loopBundleItems(items).then(postCart, function (err) {
        /* Loop unreachable or misconfigured: fall back to individual lines. */
        try { console.warn('[FTDC] Loop bundle failed, falling back. Error:', err); } catch (_) {}
        return postCart(items);
      });
    } else {
      run = postCart(items);
    }
    run.catch(function (e) { if (actBtn) actBtn.disabled = false; $$('[data-action="checkout"]').forEach(function (b) { b.disabled = false; }); alert(e.message || 'Something went wrong'); });
  }

  showStep('plans'); updateProgress(); updateBar();
})();
</script>

