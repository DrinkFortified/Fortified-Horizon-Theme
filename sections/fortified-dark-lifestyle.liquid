{% render 'fortified-base' %}

<section
  id="FortifiedDarkLifestyle-{{ section.id }}"
  class="fortified-dark-lifestyle color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-dark-lifestyle__inner">
    <header class="fortified-dark-lifestyle__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading | newline_to_br }}</h2>
      {% endif %}
    </header>

    <div class="fortified-dark-lifestyle__grid" style="justify-content: {{ section.settings.blocks_alignment | default: 'center' }}; justify-items: {%- if section.settings.blocks_alignment == 'space-between' -%}stretch{%- else -%}{{ section.settings.blocks_alignment | default: 'center' }}{%- endif -%};">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-lifestyle-photo' %}
          <div class="fortified-dark-lifestyle__item" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                  widths: '300, 500, 800',
                  sizes: '(min-width: 1024px) 22vw, 50vw',
                  class: 'fortified-dark-lifestyle__img',
                  alt: block.settings.image.alt | default: block.settings.benefit_label,
                  loading: 'lazy' }}
            {% endif %}
            {% if block.settings.benefit_label != blank %}
              <span class="fortified-dark-lifestyle__badge">{{ block.settings.benefit_label }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="fortified-dark-lifestyle__cta">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--white">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-dark-lifestyle {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-dark-lifestyle__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(28px, 4vw, 48px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  .fortified-dark-lifestyle__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    max-width: 720px;
  }
  .fortified-dark-lifestyle__header .fortified-heading {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .fortified-dark-lifestyle__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    width: 100%;
  }
  @media (min-width: 750px) {
    .fortified-dark-lifestyle__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .fortified-dark-lifestyle__item {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
    cursor: pointer;
    transition: transform .35s ease;
  }
  .fortified-dark-lifestyle__item:hover { transform: scale(1.02); }
  .fortified-dark-lifestyle__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      transparent 50%,
      color-mix(in srgb, var(--color-foreground) 70%, transparent) 100%);
    pointer-events: none;
  }
  .fortified-dark-lifestyle__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fortified-dark-lifestyle__badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(4px);
    color: var(--color-foreground-heading);
    font-family: var(--font-fortified-display);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }
  .fortified-dark-lifestyle__cta {
    display: flex;
    justify-content: center;
  }
  .fortified-dark-lifestyle__cta .fortified-btn {
    padding: 14px 32px;
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 48px;
  }
{% endstylesheet %}

