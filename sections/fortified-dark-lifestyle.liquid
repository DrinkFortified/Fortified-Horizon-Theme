{% render 'fortified-base' %}

<section
  id="FortifiedDarkLifestyle-{{ section.id }}"
  class="fortified-dark-lifestyle color-{{ section.settings.color_scheme | default: 'scheme-2' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 24 }}px {{ section.settings['padding-block-end'] | default: 24 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 24 }}px {{ section.settings['padding-inline-end'] | default: 24 }}px;"
>
  <div class="fortified-dark-lifestyle__frame">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2880 | image_tag:
          widths: '720, 1080, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          class: 'fortified-dark-lifestyle__bg',
          alt: '',
          loading: 'lazy' }}
    {% endif %}

    <div class="fortified-dark-lifestyle__inner">
      <header class="fortified-dark-lifestyle__header">
        {% if section.settings.eyebrow != blank %}
          <span class="fortified-dark-lifestyle__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="fortified-dark-lifestyle__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <p class="fortified-dark-lifestyle__body">{{ section.settings.body }}</p>
        {% endif %}
      </header>

      <div class="fortified-dark-lifestyle__grid">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-lifestyle-photo' %}
            <article class="fortified-dark-lifestyle__card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag:
                    widths: '300, 500, 700, 900',
                    sizes: '(min-width: 750px) 22vw, 50vw',
                    class: 'fortified-dark-lifestyle__card-bg',
                    alt: block.settings.image.alt | default: block.settings.benefit_label,
                    loading: 'lazy' }}
              {% endif %}
              <div class="fortified-dark-lifestyle__card-content">
                <div class="fortified-dark-lifestyle__card-mark">+</div>
                {% if block.settings.benefit_label != blank %}
                  <h3 class="fortified-dark-lifestyle__card-label">{{ block.settings.benefit_label }}</h3>
                {% endif %}
                {% if block.settings.body != blank %}
                  <p class="fortified-dark-lifestyle__card-body">{{ block.settings.body }}</p>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-dark-lifestyle__btn">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-dark-lifestyle {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-dark-lifestyle__frame {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
  }
  .fortified-dark-lifestyle__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-dark-lifestyle__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    padding: 100px 40px;
    color: var(--color-foreground);
  }
  .fortified-dark-lifestyle__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 929px;
    text-align: center;
  }
  .fortified-dark-lifestyle__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-dark-lifestyle__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-dark-lifestyle__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    max-width: 581px;
    margin: 0;
  }

  .fortified-dark-lifestyle__grid {
    display: flex;
    gap: 10px;
    width: 100%;
    align-items: stretch;
  }
  .fortified-dark-lifestyle__card {
    flex: 1 0 0;
    min-width: 0;
    position: relative;
    height: 480px;
    border-radius: 14px;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px 45px 32px 24px;
  }
  .fortified-dark-lifestyle__card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-dark-lifestyle__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 54%, rgba(0,0,0,0.7) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .fortified-dark-lifestyle__card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    color: var(--color-foreground);
  }
  .fortified-dark-lifestyle__card-mark {
    font-family: var(--font-fortified-display);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    color: var(--color-foreground);
    margin-bottom: 6px;
  }
  .fortified-dark-lifestyle__card-label {
    font-family: var(--font-fortified-display);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-dark-lifestyle__card-body {
    font-family: var(--font-fortified-body);
    font-size: 18px;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
    max-width: 241px;
  }

  .fortified-dark-lifestyle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-dark-lifestyle__inner { padding: 72px 32px; gap: 48px; }
    .fortified-dark-lifestyle__heading { font-size: 44px; }
    .fortified-dark-lifestyle__eyebrow { font-size: 22px; }
    .fortified-dark-lifestyle__body { font-size: 18px; }
    .fortified-dark-lifestyle__grid { flex-wrap: wrap; }
    .fortified-dark-lifestyle__card { flex: 1 0 calc(50% - 5px); height: 380px; }
  }
  @media (max-width: 749px) {
    .fortified-dark-lifestyle__inner { padding: 56px 24px; gap: 32px; }
    .fortified-dark-lifestyle__frame { border-radius: 16px; }
    .fortified-dark-lifestyle__heading { font-size: 32px; }
    .fortified-dark-lifestyle__eyebrow { font-size: 16px; }
    .fortified-dark-lifestyle__body { font-size: 16px; }
    .fortified-dark-lifestyle__card { flex: 1 0 100%; height: 320px; padding: 24px; }
    .fortified-dark-lifestyle__card-label { font-size: 26px; }
    .fortified-dark-lifestyle__card-body { font-size: 15px; }
    .fortified-dark-lifestyle__btn { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "04 — Dark Lifestyle",
  "tag": "section",
  "class": "fortified-dark-lifestyle-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "More than hydration\nIt's daily support"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Electrolytes don't provide full recovery. UNDO® Regenerate combines hydration."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Section background image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "EXPLORE ALL FLAVORS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "blocks": [
    {
      "type": "fortified-lifestyle-photo",
      "name": "Lifestyle photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "benefit_label",
          "label": "Benefit label",
          "default": "+ ENERGY"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "Electrolytes don't provide full recovery."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "04 — Dark Lifestyle",
      "category": "Fortified Home",
      "settings": {},
      "blocks": [
        { "type": "fortified-lifestyle-photo", "settings": { "benefit_label": "+ ENERGY" } },
        { "type": "fortified-lifestyle-photo", "settings": { "benefit_label": "+ PERFORMANCE" } },
        { "type": "fortified-lifestyle-photo", "settings": { "benefit_label": "+ HYDRATION" } },
        { "type": "fortified-lifestyle-photo", "settings": { "benefit_label": "+ FOCUS" } }
      ]
    }
  ]
}
{% endschema %}
