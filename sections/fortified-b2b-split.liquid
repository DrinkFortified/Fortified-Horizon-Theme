{% render 'fortified-base' %}

<section
  id="FortifiedB2B-{{ section.id }}"
  class="fortified-b2b color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-b2b__inner">
    {% for block in section.blocks %}
      {% if block.type == 'fortified-b2b-card' %}
        <article class="fortified-b2b__card" style="text-align: {%- if block.settings.content_alignment == 'inherit' or block.settings.content_alignment == blank -%}inherit{%- else -%}{{ block.settings.content_alignment }}{%- endif -%};" {{ block.shopify_attributes }} style="--overlay: {{ block.settings.bg_overlay_opacity | default: 50 }}%;">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag:
                widths: '600, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'fortified-b2b__bg',
                alt: block.settings.heading,
                loading: 'lazy' }}
          {% endif %}
          <div class="fortified-b2b__content">
            {% if block.settings.eyebrow != blank %}
              <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3 class="fortified-heading fortified-h3">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="fortified-b2b__body">{{ block.settings.body }}</p>
            {% endif %}
            {% if block.settings.cta_label != blank %}
              <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .fortified-b2b {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-b2b__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  @media (min-width: 750px) {
    .fortified-b2b__inner { grid-template-columns: 1fr 1fr; }
  }

  .fortified-b2b__card {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    min-height: 240px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
    transition: transform .25s ease, box-shadow .25s ease;
  }

  /* Text column on the left */
  .fortified-b2b__content {
    padding: clamp(20px, 2.4vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    text-align: left;
    z-index: 2;
    position: relative;
  }
  .fortified-b2b__content .fortified-eyebrow {
    color: var(--color-foreground);
    opacity: 0.55;
    font-size: 10px;
    letter-spacing: 0.18em;
    margin: 0;
  }
  .fortified-b2b__content .fortified-heading {
    color: var(--color-foreground-heading);
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.05;
    letter-spacing: -0.005em;
    margin: 0;
  }
  .fortified-b2b__body {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-foreground);
    opacity: 0.7;
    margin: 0;
    max-width: 32ch;
  }
  /* CTA renders as text-link with arrow, not a button */
  .fortified-b2b__content .fortified-btn {
    background: transparent;
    color: var(--color-foreground-heading);
    border: 0;
    padding: 8px 0 0;
    border-radius: 0;
    font-family: var(--font-fortified-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    min-height: auto;
    box-shadow: none;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    transition: color .15s ease, gap .15s ease;
  }
  .fortified-b2b__content .fortified-btn::after {
    content: '→';
    font-size: 14px;
    transition: transform .15s ease;
  }
  .fortified-b2b__content .fortified-btn:hover {
    color: var(--fortified-accent, var(--color-foreground));
    gap: 12px;
  }
  .fortified-b2b__content .fortified-btn:hover::after { transform: translateX(2px); }

  /* Right side: image fills the right half of the card */
  .fortified-b2b__bg {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    grid-column: 2;
  }

  @media (max-width: 749px) {
    .fortified-b2b__card {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .fortified-b2b__bg {
      grid-column: 1;
      order: -1;
      aspect-ratio: 16/9;
    }
  }
{% endstylesheet %}

