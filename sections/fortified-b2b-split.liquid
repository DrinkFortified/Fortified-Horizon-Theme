{% render 'fortified-base' %}

<section
  id="FortifiedB2B-{{ section.id }}"
  class="fortified-b2b color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.accent_italic %} fortified--keep-italics{% endif %}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 0 }}px {{ section.settings['padding-block-end'] | default: 0 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 0 }}px {{ section.settings['padding-inline-end'] | default: 0 }}px;"
>
  <div class="fortified-b2b__inner">
    {% for block in section.blocks %}
      {% if block.type == 'fortified-b2b-card' %}
        {%- assign tone = block.settings.tone | default: 'light' -%}
        <article class="fortified-b2b__card fortified-b2b__card--{{ tone }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1600 | image_tag:
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'fortified-b2b__bg',
                alt: block.settings.heading,
                loading: 'lazy' }}
          {% endif %}
          <div class="fortified-b2b__content">
            {% if block.settings.eyebrow != blank %}
              <span class="fortified-b2b__eyebrow">{{ block.settings.eyebrow | replace: '*', '' }}</span>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3 class="fortified-b2b__heading">{% render 'fortified-accent-text', text: block.settings.heading %}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="fortified-b2b__body">{% render 'fortified-accent-text', text: block.settings.body %}</p>
            {% endif %}
            {% if block.settings.cta_label != blank %}
              <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-b2b__btn">{{ block.settings.cta_label }}</a>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .fortified-b2b {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-b2b__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
  }
  .fortified-b2b__card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 480px;
    display: flex;
    align-items: center;
  }
  .fortified-b2b__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-b2b__card--dark::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(270deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.7) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .fortified-b2b__content {
    position: relative;
    z-index: 2;
    width: 345px;
    max-width: 100%;
    padding: 100px 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .fortified-b2b__card--dark .fortified-b2b__content { color: #fff; }
  .fortified-b2b__card--light .fortified-b2b__content { color: #121212; }

  .fortified-b2b__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-b2b__card--dark .fortified-b2b__eyebrow { color: #c4e1c5; }
  .fortified-b2b__card--light .fortified-b2b__eyebrow { color: var(--fortified-accent); }

  .fortified-b2b__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
    color: inherit;
  }
  .fortified-b2b__body {
    font-family: var(--font-fortified-body);
    font-size: 20px;
    line-height: 1.2;
    color: inherit;
    margin: 0;
  }
  .fortified-b2b__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid currentColor;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
  }

  @media (max-width: 749px) {
    .fortified-b2b__inner { grid-template-columns: 1fr; }
    .fortified-b2b__card { min-height: 380px; }
    .fortified-b2b__content { width: 100%; padding: 64px 24px; }
    .fortified-b2b__heading { font-size: 40px; }
    .fortified-b2b__eyebrow { font-size: 20px; }
    .fortified-b2b__body { font-size: 16px; }
    .fortified-b2b__btn { height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "09 — B2B Split",
  "tag": "section",
  "class": "fortified-b2b-section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the light card eyebrow. Default: Fortified Teal.",
      "default": "#1FA8A1"
    },
    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Render highlighted text in italic style",
      "info": "When off, *highlighted* text is upright in the accent color. When on, it stays italic.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fortified-b2b-card",
      "name": "B2B card",
      "settings": [
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "options": [
            { "value": "dark", "label": "Dark (with gradient overlay)" },
            { "value": "light", "label": "Light" }
          ],
          "default": "light"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "THE TRUTH"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "info": "Wrap text in *asterisks* to highlight in the accent color. Use line breaks to split into multiple lines.",
          "default": "BECOME A\n*partner*"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "info": "Wrap text in *asterisks* to highlight in the accent color.",
          "default": "Electrolytes don't provide full recovery. UNDO® Regenerate combines hydration."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "SUBSCRIBE NOW"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "09 — B2B Split",
      "category": "Fortified Home",
      "settings": {},
      "blocks": [
        {
          "type": "fortified-b2b-card",
          "settings": {
            "tone": "dark",
            "eyebrow": "THE TRUTH",
            "heading": "BECOME A\nwholesaler",
            "body": "Electrolytes don't provide full recovery. UNDO® Regenerate combines hydration.",
            "cta_label": "SUBSCRIBE NOW"
          }
        },
        {
          "type": "fortified-b2b-card",
          "settings": {
            "tone": "light",
            "eyebrow": "THE TRUTH",
            "heading": "BECOME A PARTNER",
            "body": "Electrolytes don't provide full recovery. UNDO® Regenerate combines hydration.",
            "cta_label": "SUBSCRIBE NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
