{% render 'fortified-base' %}

<section
  id="FortifiedStatsBar-{{ section.id }}"
  class="fortified-stats-bar color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-stats-bar__inner">
    {% for i in (1..6) %}
      {%- assign val_key = 'stat_' | append: i | append: '_value' -%}
      {%- assign lbl_key = 'stat_' | append: i | append: '_label' -%}
      {%- assign val = section.settings[val_key] -%}
      {%- assign lbl = section.settings[lbl_key] -%}
      {% if val != blank %}
        <div class="fortified-stats-bar__item">
          <span class="fortified-stats-bar__value">{{ val }}</span>
          <span class="fortified-stats-bar__label">{{ lbl }}</span>
        </div>
        {% unless forloop.last %}<span class="fortified-stats-bar__sep" aria-hidden="true">·</span>{% endunless %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .fortified-stats-bar {
    background: var(--color-background);
    color: var(--color-foreground);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .fortified-stats-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: clamp(16px, 2vw, 32px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
    padding-block: clamp(18px, 2.4vw, 28px);
  }
  .fortified-stats-bar__item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 80px;
  }
  .fortified-stats-bar__value {
    font-family: var(--font-fortified-display);
    font-weight: 800;
    font-size: clamp(16px, 1.6vw, 22px);
    line-height: 1;
    color: var(--color-foreground-heading);
    letter-spacing: -0.005em;
  }
  .fortified-stats-bar__label {
    font-family: var(--font-fortified-body);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.6;
    text-align: center;
  }
  .fortified-stats-bar__sep {
    color: var(--color-foreground);
    opacity: 0.25;
    font-size: 18px;
    line-height: 1;
  }
  @media (max-width: 749px) {
    .fortified-stats-bar__sep { display: none; }
    .fortified-stats-bar__inner {
      justify-content: center;
      gap: 18px 12px;
    }
  }
{% endstylesheet %}

