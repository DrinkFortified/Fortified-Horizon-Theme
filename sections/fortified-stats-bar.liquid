{% render 'fortified-base' %}

<section
  id="FortifiedStatsBar-{{ section.id }}"
  class="fortified-stats-bar color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 64 }}px {{ section.settings["padding-block-end"] | default: 64 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-stats-bar__inner">
    {% for i in (1..6) %}
      {%- assign val_key = 'stat_' | append: i | append: '_value' -%}
      {%- assign lbl_key = 'stat_' | append: i | append: '_label' -%}
      {%- assign val = section.settings[val_key] -%}
      {%- assign lbl = section.settings[lbl_key] -%}
      {% if val != blank %}
        <div class="fortified-stats-bar__item">
          <span class="fortified-stats-bar__value">{{ val }}</span>
          <span class="fortified-stats-bar__label">{{ lbl }}</span>
        </div>
        {% unless forloop.last %}<span class="fortified-stats-bar__sep" aria-hidden="true">·</span>{% endunless %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .fortified-stats-bar {
    background: var(--fortified-black);
    color: #fff;
    padding-block: clamp(18px, 2.6vw, 32px);
  }
  .fortified-stats-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 32px);
  }
  .fortified-stats-bar__item {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-fortified-body);
  }
  .fortified-stats-bar__value {
    font-family: var(--font-fortified-display);
    font-size: clamp(18px, 2.5vw, 26px);
    color: #fff;
    letter-spacing: 0.02em;
  }
  .fortified-stats-bar__label {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(255 255 255 / .8);
    font-weight: 600;
  }
  .fortified-stats-bar__sep {
    color: var(--fortified-teal);
    opacity: .65;
    font-size: 14px;
  }
{% endstylesheet %}

