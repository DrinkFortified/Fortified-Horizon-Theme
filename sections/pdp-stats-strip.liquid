    { "type": "text", "id": "everyday_stat_1_label", "label": "1 label", "default": "Sodium" },
    { "type": "image_picker", "id": "everyday_stat_2_icon", "label": "2 icon" },
    { "type": "text", "id": "everyday_stat_2_value", "label": "2 value", "default": "200MG" },
