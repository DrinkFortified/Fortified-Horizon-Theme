{% render 'fortified-base' %}

<section
  id="PdpStatsStrip-{{ section.id }}"
  class="pdp-stats color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  {{ section.shopify_attributes }}
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container pdp-stats__inner">
    <div class="pdp-stats__set p-energy">
      {% for i in (1..5) %}
        {% assign v = 'energy_stat_' | append: i | append: '_value' %}
        {% assign l = 'energy_stat_' | append: i | append: '_label' %}
        {% assign ic = 'energy_stat_' | append: i | append: '_icon' %}
        {% if section.settings[v] != blank %}
          <div class="pdp-stats__item">
            <span class="pdp-stats__icon" aria-hidden="true">
              {% if section.settings[ic] != blank %}
                <img src="{{ section.settings[ic] | image_url: width: 124 }}" alt="" width="62" height="62" loading="lazy">
              {% endif %}
            </span>
            <span class="pdp-stats__text">
              <span class="pdp-stats__value">{{ section.settings[v] }}</span>
              <span class="pdp-stats__label">{{ section.settings[l] }}</span>
            </span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="pdp-stats__set p-everyday">
      {% for i in (1..5) %}
        {% assign v = 'everyday_stat_' | append: i | append: '_value' %}
        {% assign l = 'everyday_stat_' | append: i | append: '_label' %}
        {% assign ic = 'everyday_stat_' | append: i | append: '_icon' %}
        {% if section.settings[v] != blank %}
          <div class="pdp-stats__item">
            <span class="pdp-stats__icon" aria-hidden="true">
              {% if section.settings[ic] != blank %}
                <img src="{{ section.settings[ic] | image_url: width: 124 }}" alt="" width="62" height="62" loading="lazy">
              {% endif %}
            </span>
            <span class="pdp-stats__text">
              <span class="pdp-stats__value">{{ section.settings[v] }}</span>
              <span class="pdp-stats__label">{{ section.settings[l] }}</span>
            </span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-stats {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-fortified-body);
  }
  .pdp-stats__inner {
    display: flex;
    justify-content: center;
  }
  .pdp-stats__set {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }
  body[data-product="energy"] .pdp-stats__set.p-everyday { display: none; }
  body[data-product="everyday"] .pdp-stats__set.p-energy { display: none; }
  .pdp-stats__item {
    display: inline-flex;
    align-items: center;
    gap: 24px;
  }
  .pdp-stats__icon {
    width: 62px; height: 62px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pdp-stats__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .pdp-stats__text {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
  }
  .pdp-stats__value {
    font-family: var(--font-fortified-display);
    font-weight: 600;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  .pdp-stats__label {
    font-family: var(--font-fortified-body);
    font-weight: 400;
    font-size: 18px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  @media (max-width: 900px) {
    .pdp-stats__set { flex-wrap: wrap; justify-content: center; row-gap: 24px; }
  }
{% endstylesheet %}

{% schema %}
