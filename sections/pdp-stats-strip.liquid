    { "type": "text", "id": "everyday_stat_3_label", "label": "3 label", "default": "Magnesium" },
    { "type": "image_picker", "id": "everyday_stat_4_icon", "label": "4 icon" },
    { "type": "text", "id": "everyday_stat_4_value", "label": "4 value", "default": "100MG" },
    { "type": "text", "id": "everyday_stat_4_label", "label": "4 label", "default": "Vitamin D3" },
    { "type": "image_picker", "id": "everyday_stat_5_icon", "label": "5 icon" },
