    { "type": "image_picker", "id": "energy_stat_3_icon", "label": "3 icon" },
    { "type": "text", "id": "energy_stat_3_value", "label": "3 value", "default": "300MG" },
    { "type": "text", "id": "energy_stat_3_label", "label": "3 label", "default": "Magnesium" },
    { "type": "image_picker", "id": "energy_stat_4_icon", "label": "4 icon" },
    { "type": "text", "id": "energy_stat_4_value", "label": "4 value", "default": "200MG" },
