{% render 'fortified-base' %}

<section
  id="FortifiedLifestyleStrip-{{ section.id }}"
  class="fortified-lifestyle-strip color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 100 }}px {{ section.settings['padding-block-end'] | default: 100 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 0 }}px {{ section.settings['padding-inline-end'] | default: 0 }}px;"
>
  <div class="fortified-lifestyle-strip__inner">
    <header class="fortified-lifestyle-strip__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-lifestyle-strip__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-lifestyle-strip__heading">{{ section.settings.heading | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="fortified-lifestyle-strip__body">{{ section.settings.body }}</p>
      {% endif %}
    </header>

    <div class="fortified-lifestyle-strip__scroll">
      <div class="fortified-lifestyle-strip__row">
        {% for block in section.blocks %}
          {% if block.type == 'fortified-strip-image' %}
            <article class="fortified-lifestyle-strip__card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 700 | image_tag:
                    widths: '300, 500, 700',
                    sizes: '(min-width: 1024px) 18vw, 70vw',
                    class: 'fortified-lifestyle-strip__img',
                    alt: block.settings.image.alt | default: block.settings.handle,
                    loading: 'lazy' }}
              {% endif %}
              {% if block.settings.video_url != blank %}
                <a class="fortified-lifestyle-strip__link" href="{{ block.settings.video_url }}" aria-label="{{ block.settings.handle | default: 'Watch' }}"></a>
              {% endif %}
              <div class="fortified-lifestyle-strip__play" aria-hidden="true">
                <svg viewBox="0 0 62 62" width="62" height="62" fill="none">
                  <circle cx="31" cy="31" r="30" stroke="currentColor" stroke-width="2"/>
                  <path d="M25 21L43 31L25 41V21Z" fill="currentColor"/>
                </svg>
              </div>
              <div class="fortified-lifestyle-strip__meta">
                {% if block.settings.handle != blank %}
                  <p class="fortified-lifestyle-strip__handle">{{ block.settings.handle }}</p>
                {% endif %}
                {% if block.settings.caption != blank %}
                  <p class="fortified-lifestyle-strip__caption">{{ block.settings.caption }}</p>
                {% endif %}
                {% if block.settings.views != blank %}
                  <p class="fortified-lifestyle-strip__views">{{ block.settings.views }}</p>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-lifestyle-strip__cta">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-lifestyle-strip {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-lifestyle-strip__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    width: 100%;
  }
  .fortified-lifestyle-strip__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 929px;
    text-align: center;
    padding-inline: 40px;
  }
  .fortified-lifestyle-strip__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-lifestyle-strip__heading {
    font-family: var(--font-fortified-display);
    font-size: 62px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-lifestyle-strip__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-foreground);
    max-width: 581px;
    margin: 0;
  }

  .fortified-lifestyle-strip__scroll {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-inline: 40px;
  }
  .fortified-lifestyle-strip__scroll::-webkit-scrollbar { display: none; }
  .fortified-lifestyle-strip__row {
    display: flex;
    gap: 18px;
    width: max-content;
  }
  .fortified-lifestyle-strip__card {
    flex: 0 0 auto;
    position: relative;
    width: 250px;
    height: 450px;
    border-radius: 14px;
    overflow: hidden;
    isolation: isolate;
    padding: 189px 18px 24px;
    display: flex;
    flex-direction: column;
    color: #fff;
  }
  .fortified-lifestyle-strip__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-lifestyle-strip__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.55) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .fortified-lifestyle-strip__link {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
  .fortified-lifestyle-strip__play {
    position: absolute;
    top: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: #fff;
    width: 62px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fortified-lifestyle-strip__meta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-top: auto;
  }
  .fortified-lifestyle-strip__handle {
    font-family: var(--font-fortified-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    color: #fff;
  }
  .fortified-lifestyle-strip__caption {
    font-family: var(--font-fortified-body);
    font-size: 16px;
    line-height: 1.1;
    margin: 0;
    color: #fff;
  }
  .fortified-lifestyle-strip__views {
    font-family: var(--font-fortified-body);
    font-size: 16px;
    line-height: 1.1;
    margin: 0;
    color: #fff;
    opacity: 0.85;
  }

  .fortified-lifestyle-strip__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border-radius: 8px;
    background: var(--color-primary-button-background, var(--color-foreground));
    color: var(--color-primary-button-text, var(--color-background));
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-lifestyle-strip__inner { gap: 48px; }
    .fortified-lifestyle-strip__heading { font-size: 44px; }
    .fortified-lifestyle-strip__body { font-size: 18px; }
  }
  @media (max-width: 749px) {
    .fortified-lifestyle-strip__heading { font-size: 32px; }
    .fortified-lifestyle-strip__card { width: 220px; height: 380px; padding: 150px 16px 20px; }
    .fortified-lifestyle-strip__scroll { padding-inline: 24px; }
    .fortified-lifestyle-strip__cta { width: calc(100% - 48px); margin-inline: 24px; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "07 — Lifestyle Strip",
  "tag": "section",
  "class": "fortified-lifestyle-strip-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "More than hydration\nIt's daily support"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Electrolytes don't provide full recovery. UNDO® Regenerate combines hydration."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP FORTIFIED NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "blocks": [
    {
      "type": "fortified-strip-image",
      "name": "Video card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail / background"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Username",
          "default": "@madselly"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "undo before the drinks changes everything"
        },
        {
          "type": "text",
          "id": "views",
          "label": "Views label",
          "default": "2.1k views"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Link / video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "07 — Lifestyle Strip",
      "category": "Fortified Home",
      "settings": {},
      "blocks": [
        { "type": "fortified-strip-image" },
        { "type": "fortified-strip-image" },
        { "type": "fortified-strip-image" },
        { "type": "fortified-strip-image" },
        { "type": "fortified-strip-image" },
        { "type": "fortified-strip-image" }
      ]
    }
  ]
}
{% endschema %}
