{% render 'fortified-base' %}

<section
  id="FortifiedLifestyleStrip-{{ section.id }}"
  class="fortified-lifestyle-strip color-{{ section.settings.color_scheme }}"
 style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
  <div class="fortified-container fortified-lifestyle-strip__inner">
    <header class="fortified-lifestyle-strip__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>
  </div>

  <div class="fortified-lifestyle-strip__scroll">
    <div class="fortified-lifestyle-strip__row">
      {% for block in section.blocks %}
        {% if block.type == 'fortified-strip-image' and block.settings.image != blank %}
          <div class="fortified-lifestyle-strip__item" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 700 | image_tag:
                widths: '300, 500, 700',
                sizes: '(min-width: 1024px) 18vw, 60vw',
                class: 'fortified-lifestyle-strip__img',
                alt: block.settings.image.alt | default: 'Lifestyle photo',
                loading: 'lazy' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.cta_label != blank %}
    <div class="fortified-container fortified-lifestyle-strip__cta">
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_label }}</a>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .fortified-lifestyle-strip {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-lifestyle-strip__inner { margin-bottom: 24px; }
  .fortified-lifestyle-strip__header { text-align: left; max-width: 800px; }
  .fortified-lifestyle-strip__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .fortified-lifestyle-strip__scroll::-webkit-scrollbar { display: none; }
  .fortified-lifestyle-strip__row {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(8px, 1vw, 16px);
    padding-inline: clamp(16px, 4vw, 80px);
  }
  .fortified-lifestyle-strip__item {
    flex: 0 0 auto;
    width: clamp(220px, 18vw, 280px);
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    overflow: hidden;
  }
  .fortified-lifestyle-strip__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fortified-lifestyle-strip__cta { margin-top: 32px; }
{% endstylesheet %}

{% schema %}
{
  "name": "07 \u2014 Lifestyle Strip",
  "tag": "section",
  "class": "fortified-lifestyle-strip-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MORE THAN HYDRATION"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP FORTIFIED NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "fortified-strip-image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "07 \u2014 Lifestyle Strip",
      "category": "Fortified",
      "blocks": [
        {
          "type": "fortified-strip-image"
        },
        {
          "type": "fortified-strip-image"
        },
        {
          "type": "fortified-strip-image"
        },
        {
          "type": "fortified-strip-image"
        },
        {
          "type": "fortified-strip-image"
        }
      ]
    }
  ]
}
{% endschema %}
