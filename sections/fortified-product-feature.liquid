{% render 'fortified-base' %}

<section
  id="FortifiedProductFeature-{{ section.id }}"
  class="fortified-product-feature color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
 style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; text-align: {{ section.settings.content_alignment | default: 'center' }}; padding-block: {{ section.settings["padding-block-start"] | default: 40 }}px {{ section.settings["padding-block-end"] | default: 40 }}px; padding-inline: {{ section.settings["padding-inline-start"] | default: 0 }}px {{ section.settings["padding-inline-end"] | default: 0 }}px;">
  <div class="fortified-container fortified-product-feature__inner">
    <header class="fortified-product-feature__header">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="fortified-body fortified-product-feature__body">{{ section.settings.body }}</p>
      {% endif %}
    </header>

    <div class="fortified-product-feature__products">
      {% for i in (1..4) %}
        {%- assign key = 'product_image_' | append: i -%}
        {%- assign img = section.settings[key] -%}
        {% if img != blank %}
          <div class="fortified-product-feature__item fortified-product-feature__item--{{ i }}">
            {{ img | image_url: width: 700 | image_tag:
                widths: '300, 500, 700',
                sizes: '(min-width: 750px) 22vw, 60vw',
                class: 'fortified-product-feature__img',
                alt: img.alt | default: 'Fortified product',
                loading: 'lazy' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="fortified-product-feature__cta">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fortified-product-feature {
    background: var(--color-background);
    color: var(--color-foreground);
    position: relative;
    overflow: hidden;
  }
  .fortified-product-feature__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 4vw, 56px);
    max-width: var(--fortified-container);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  .fortified-product-feature__header {
    text-align: center;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .fortified-product-feature__header .fortified-heading {
    font-family: var(--font-fortified-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .fortified-product-feature__body {
    font-size: clamp(14px, 1vw, 16px);
    line-height: 1.55;
    opacity: 0.8;
    margin: 0;
    max-width: 56ch;
  }

  /* 4 product packaging shots fanned into a hero composition */
  .fortified-product-feature__products {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: clamp(320px, 36vw, 440px);
    padding: 24px 0;
  }
  .fortified-product-feature__item {
    flex: 0 0 auto;
    width: clamp(140px, 22vw, 240px);
    transition: transform .35s ease;
  }
  .fortified-product-feature__item--1 { transform: none; z-index: 1; }
  .fortified-product-feature__item--2 { transform: none; z-index: 2; margin-left: -8%; }
  .fortified-product-feature__item--3 { transform: none; z-index: 3; margin-left: -8%; }
  .fortified-product-feature__item--4 { transform: none; z-index: 2; margin-left: -8%; }
  .fortified-product-feature__products:hover .fortified-product-feature__item--1 { transform: none; }
  .fortified-product-feature__products:hover .fortified-product-feature__item--4 { transform: none; }

  .fortified-product-feature__img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 24px 48px rgba(0,0,0,0.2));
  }

  /* Subtle warm-tinted ambient glow behind the products */

  .fortified-product-feature__cta .fortified-btn {
    padding: 14px 32px;
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 48px;
  }

  @media (max-width: 749px) {
    .fortified-product-feature__products { gap: 0; min-height: 280px; }
    .fortified-product-feature__item { width: clamp(110px, 30vw, 160px); margin-left: -10%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "03 \u2014 Product Feature",
  "tag": "section",
  "class": "fortified-product-feature-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FORMULATED FOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CLEAN HYDRATION MAX PERFORMANCE"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "EXPLORE ALL FLAVORS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "product_image_1",
      "label": "Product image 1"
    },
    {
      "type": "image_picker",
      "id": "product_image_2",
      "label": "Product image 2"
    },
    {
      "type": "image_picker",
      "id": "product_image_3",
      "label": "Product image 3"
    },
    {
      "type": "image_picker",
      "id": "product_image_4",
      "label": "Product image 4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for accent bars, CTA backgrounds, checkmarks. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "presets": [
    {
      "name": "03 \u2014 Product Feature",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    },
    {
      "name": "03 \u2014 Product Feature",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "03 \u2014 Product Feature",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
