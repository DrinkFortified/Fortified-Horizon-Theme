{% render 'fortified-base' %}

<section
  id="FortifiedProductFeature-{{ section.id }}"
  class="fortified-product-feature color-{{ section.settings.color_scheme | default: 'scheme-1' }} fortified-product-feature--align-{{ section.settings.content_alignment | default: 'left' }}"
  style="--fortified-accent: {{ section.settings.highlight_color | default: '#1FA8A1' }}; padding-block: {{ section.settings['padding-block-start'] | default: 24 }}px {{ section.settings['padding-block-end'] | default: 24 }}px; padding-inline: {{ section.settings['padding-inline-start'] | default: 24 }}px {{ section.settings['padding-inline-end'] | default: 24 }}px;"
>
  <div class="fortified-product-feature__frame">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2880 | image_tag:
          widths: '720, 1080, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          class: 'fortified-product-feature__bg',
          alt: section.settings.background_image.alt | default: section.settings.heading,
          loading: 'lazy' }}
    {% else %}
      <div class="fortified-product-feature__bg fortified-product-feature__bg--placeholder"></div>
    {% endif %}

    <div class="fortified-product-feature__content">
      {% if section.settings.eyebrow != blank %}
        <span class="fortified-product-feature__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fortified-product-feature__heading">{{ section.settings.heading | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="fortified-product-feature__body">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fortified-product-feature__btn">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fortified-product-feature {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .fortified-product-feature__frame {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    min-height: 533px;
    display: flex;
    align-items: stretch;
  }
  .fortified-product-feature__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .fortified-product-feature__bg--placeholder {
    background: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }
  .fortified-product-feature__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: 100px 40px;
    max-width: 560px;
    color: var(--color-foreground);
    align-items: flex-start;
    text-align: left;
  }
  .fortified-product-feature--align-center .fortified-product-feature__frame { justify-content: center; }
  .fortified-product-feature--align-center .fortified-product-feature__content { align-items: center; text-align: center; margin-inline: auto; }
  .fortified-product-feature--align-right .fortified-product-feature__frame { justify-content: flex-end; }
  .fortified-product-feature--align-right .fortified-product-feature__content { align-items: flex-end; text-align: right; margin-left: auto; }

  .fortified-product-feature__eyebrow {
    font-family: var(--font-fortified-display);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--fortified-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .fortified-product-feature__heading {
    font-family: var(--font-fortified-display);
    font-size: 64px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading);
    text-transform: lowercase;
    margin: 0;
  }
  .fortified-product-feature__body {
    font-family: var(--font-fortified-body);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-foreground);
    margin: 0;
  }
  .fortified-product-feature__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 411px;
    max-width: 100%;
    height: 70px;
    padding: 18px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-fortified-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-sizing: border-box;
  }

  @media (max-width: 990px) {
    .fortified-product-feature__frame { min-height: 440px; }
    .fortified-product-feature__content { padding: 64px 32px; max-width: 100%; }
    .fortified-product-feature__heading { font-size: 48px; }
    .fortified-product-feature__eyebrow { font-size: 22px; }
    .fortified-product-feature__body { font-size: 18px; }
  }
  @media (max-width: 749px) {
    .fortified-product-feature__frame { min-height: 400px; border-radius: 16px; }
    .fortified-product-feature__content { padding: 48px 24px; gap: 14px; }
    .fortified-product-feature__heading { font-size: 38px; }
    .fortified-product-feature__eyebrow { font-size: 18px; }
    .fortified-product-feature__body { font-size: 16px; }
    .fortified-product-feature__btn { width: 100%; height: 60px; font-size: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "03 — Product Feature",
  "tag": "section",
  "class": "fortified-product-feature-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Formulated for"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Use line breaks to split into multiple lines.",
      "default": "clean hydration\nmax performance."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Electrolytes don't provide full recovery. Regenerate combines hydration with collagen supporting skin."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "EXPLORE ALL FLAVORS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight / accent color",
      "info": "Used for the eyebrow. Default: Fortified Teal.",
      "default": "#1FA8A1"
    }
  ],
  "presets": [
    {
      "name": "03 — Product Feature",
      "category": "Fortified Home",
      "settings": {},
      "blocks": []
    },
    {
      "name": "03 — Product Feature",
      "category": "Fortified PDP",
      "settings": {},
      "blocks": []
    },
    {
      "name": "03 — Product Feature",
      "category": "Fortified Landing",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
