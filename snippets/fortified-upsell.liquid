{%- liquid
  assign p = block.settings.upsell_product
  assign bg = block.settings.bg_color | default: '#FFE6CC'
-%}

{% if p != blank %}
  <aside class="fortified-upsell" style="--upsell-bg: {{ bg }};">
    <div class="fortified-upsell__media">
      {% if p.featured_image != blank %}
        {{ p.featured_image | image_url: width: 240 | image_tag:
            widths: '120, 180, 240',
            sizes: '120px',
            class: 'fortified-upsell__img',
            alt: p.title,
            loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="fortified-upsell__body">
      <p class="fortified-upsell__label">{{ block.settings.upsell_label }}</p>
      <p class="fortified-upsell__name">{{ p.title }}</p>
      <p class="fortified-upsell__price">ONE TIME PURCHASE {{ p.price | money }}</p>
    </div>
    <form method="post" action="/cart/add" class="fortified-upsell__form">
      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
      <button type="submit" class="fortified-btn fortified-btn--dark fortified-upsell__btn">ADD TO CART</button>
    </form>
  </aside>
{% endif %}

<style>
  .fortified-upsell {
    background: var(--upsell-bg, #FFE6CC);
    border-radius: 16px;
    padding: 14px;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 14px;
    align-items: center;
  }
  .fortified-upsell__img { width: 80px; height: 80px; object-fit: contain; }
  .fortified-upsell__body { display: flex; flex-direction: column; gap: 4px; }
  .fortified-upsell__label {
    margin: 0;
    font-family: var(--font-fortified-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fortified-orange);
  }
  .fortified-upsell__name {
    margin: 0;
    font-family: var(--font-fortified-display);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .fortified-upsell__price { margin: 0; font-size: 12px; font-weight: 600; opacity: .7; }
  .fortified-upsell__form { grid-column: 1 / -1; }
  .fortified-upsell__btn { width: 100%; padding: 12px 18px; font-size: 13px; }
</style>
