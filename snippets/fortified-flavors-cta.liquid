<section class="fortified-flavors-cta">
  {% if block.settings.bg_image != blank %}
    {{ block.settings.bg_image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-flavors-cta__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-flavors-cta__inner">
    {% if block.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h1">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.cta_label != blank %}
      <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<style>
  .fortified-flavors-cta {
    position: relative;
    background: var(--fortified-black);
    color: #fff;
    padding-block: clamp(64px, 9vw, 140px);
    text-align: center;
    isolation: isolate;
    overflow: hidden;
  }
  .fortified-flavors-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: .4;
  }
  .fortified-flavors-cta::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / .4), rgb(0 0 0 / .75));
    z-index: -1;
  }
  .fortified-flavors-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
</style>
