<section class="fortified-lifestyle-strip-block">
  {% if block.settings.heading != blank %}
    <div class="fortified-container">
      <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}
  <div class="fortified-lifestyle-strip-block__scroll">
    <div class="fortified-lifestyle-strip-block__row">
      {% for i in (1..5) %}
        {%- assign key = 'image_' | append: i -%}
        {%- assign img = block.settings[key] -%}
        {% if img != blank %}
          <div class="fortified-lifestyle-strip-block__item">
            {{ img | image_url: width: 700 | image_tag:
                widths: '300, 500, 700',
                sizes: '(min-width: 1024px) 18vw, 60vw',
                class: 'fortified-lifestyle-strip-block__img',
                alt: img.alt | default: '',
                loading: 'lazy' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .fortified-lifestyle-strip-block {
    padding-block: clamp(40px, 6vw, 96px);
    background: var(--fortified-white);
  }
  .fortified-lifestyle-strip-block__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-top: 24px;
  }
  .fortified-lifestyle-strip-block__scroll::-webkit-scrollbar { display: none; }
  .fortified-lifestyle-strip-block__row {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(8px, 1vw, 16px);
    padding-inline: clamp(16px, 4vw, 80px);
  }
  .fortified-lifestyle-strip-block__item {
    flex: 0 0 auto;
    width: clamp(220px, 18vw, 280px);
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    overflow: hidden;
  }
  .fortified-lifestyle-strip-block__img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
