{%- liquid
  assign label = block.settings.label | default: "ADD TO CART"
-%}

<button
  type="submit"
  name="add"
  class="fortified-atc fortified-btn fortified-btn--primary"
  {% unless product.available %}disabled{% endunless %}
  data-fortified-atc
>
  <span class="fortified-atc__label">
    {% if product.available %}{{ label }}{% else %}Sold out{% endif %}
  </span>
  {% if block.settings.show_price and product.available %}
    <span class="fortified-atc__price" data-fortified-atc-price>
      — {{ product.price | money }}
    </span>
  {% endif %}
</button>

<style>
  .fortified-atc {
    width: 100%;
    padding: 18px 24px;
    font-size: 15px;
    min-height: 56px;
    border-radius: var(--fortified-radius-pill);
  }
  .fortified-atc[disabled] { opacity: .55; cursor: not-allowed; }
  .fortified-atc__price { opacity: .92; }
</style>
