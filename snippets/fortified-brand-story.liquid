<section class="fortified-brand-story">
  {% if block.settings.image != blank %}
    {{ block.settings.image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-brand-story__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-brand-story__inner">
    {% if block.settings.eyebrow != blank %}
      <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h1">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.body != blank %}
      <p class="fortified-brand-story__body">{{ block.settings.body }}</p>
    {% endif %}
    {% if block.settings.cta_label != blank %}
      <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--white">{{ block.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<style>
  .fortified-brand-story {
    position: relative;
    background: var(--fortified-black);
    color: #fff;
    padding-block: var(--fortified-section-py);
    overflow: hidden;
    isolation: isolate;
  }
  .fortified-brand-story__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: .55;
  }
  .fortified-brand-story::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / .35), rgb(0 0 0 / .75));
    z-index: -1;
  }
  .fortified-brand-story__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 720px;
  }
  .fortified-brand-story__body { font-family: var(--font-fortified-body); font-size: 16px; line-height: 1.55; opacity: .92; }
</style>
