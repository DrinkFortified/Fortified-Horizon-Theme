{%- comment -%}DEBUG: shows block counts so we can see what section.blocks returns for theme blocks{%- endcomment -%}
{%- assign fb_count = section.blocks | where: 'type', '_ftd-c-function' | size -%}
{%- assign ub_count = section.blocks | where: 'type', '_ftd-c-upsell' | size -%}
{%- assign bb_count = section.blocks | where: 'type', '_ftd-c-bullet' | size -%}
{%- assign all_count = section.blocks | size -%}
<div style="background:#fff3cd;border:2px solid #ffc107;color:#000;padding:14px;margin:10px 0;border-radius:8px;font:14px/1.4 monospace;text-align:left;">
  <strong>FTD-C DIAGNOSTIC</strong><br>
  section.blocks total: <strong>{{ all_count }}</strong><br>
  function blocks: <strong>{{ fb_count }}</strong><br>
  bullet blocks: <strong>{{ bb_count }}</strong><br>
  upsell blocks: <strong>{{ ub_count }}</strong><br>
  <br>
  Raw types found:<br>
  {%- for b in section.blocks -%}
    - {{ b.type }} (id: {{ b.id }})<br>
  {%- endfor -%}
</div>