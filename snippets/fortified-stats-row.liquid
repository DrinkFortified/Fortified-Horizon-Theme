<section class="fortified-stats-row">
  <div class="fortified-container fortified-stats-row__inner">
    {% for i in (1..3) %}
      {%- assign num_key = 'stat_' | append: i | append: '_number' -%}
      {%- assign lbl_key = 'stat_' | append: i | append: '_label' -%}
      {%- assign num = block.settings[num_key] -%}
      {%- assign lbl = block.settings[lbl_key] -%}
      {% if num != blank %}
        <div class="fortified-stats-row__item">
          <span class="fortified-stats-row__number">{{ num }}</span>
          <span class="fortified-stats-row__label">{{ lbl }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  .fortified-stats-row {
    background: var(--fortified-white);
    padding-block: clamp(32px, 4vw, 64px);
    border-block: 1px solid var(--fortified-gray-light);
  }
  .fortified-stats-row__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(12px, 2vw, 32px);
    text-align: center;
  }
  .fortified-stats-row__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .fortified-stats-row__number {
    font-family: var(--font-fortified-display);
    font-size: clamp(28px, 4vw, 48px);
    color: var(--fortified-teal);
    line-height: 1;
  }
  .fortified-stats-row__label {
    font-family: var(--font-fortified-body);
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fortified-gray-mid);
  }
</style>
