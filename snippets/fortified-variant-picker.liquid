{%- liquid
  assign show = false
  if product.variants.size > 1
    assign show = true
  endif
-%}

{% if show %}
  <fieldset class="fortified-variants">
    <legend class="fortified-variants__label">{{ block.settings.label | default: "FLAVOR" }}</legend>
    <div class="fortified-variants__swatches" role="radiogroup">
      {% for variant in product.variants %}
        <label class="fortified-variants__swatch {% if variant.id == current_variant.id %}is-selected{% endif %} {% unless variant.available %}is-unavailable{% endunless %}">
          <input
            type="radio"
            name="fortified-variant"
            value="{{ variant.id }}"
            data-fortified-variant-radio
            {% if variant.id == current_variant.id %}checked{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
          <span class="fortified-variants__swatch-inner">
            {% if variant.image != blank %}
              {{ variant.image | image_url: width: 160 | image_tag:
                  widths: '80, 120, 160',
                  sizes: '80px',
                  class: 'fortified-variants__img',
                  alt: variant.title,
                  loading: 'lazy' }}
            {% elsif variant.featured_image != blank %}
              {{ variant.featured_image | image_url: width: 160 | image_tag:
                  widths: '80, 120, 160',
                  sizes: '80px',
                  class: 'fortified-variants__img',
                  alt: variant.title,
                  loading: 'lazy' }}
            {% else %}
              <span class="fortified-variants__chip"></span>
            {% endif %}
            <span class="fortified-variants__title">{{ variant.title }}</span>
          </span>
        </label>
      {% endfor %}
    </div>
  </fieldset>

  <script>
    (function () {
      var form = document.getElementById('FortifiedProductForm-{{ section.id }}');
      if (!form) return;
      var input = form.querySelector('[data-fortified-variant-input]');
      var radios = form.querySelectorAll('[data-fortified-variant-radio]');
      radios.forEach(function (r) {
        r.addEventListener('change', function () {
          if (!r.checked) return;
          input.value = r.value;
          form.querySelectorAll('.fortified-variants__swatch').forEach(function (label) {
            label.classList.toggle('is-selected', label.contains(r));
          });
          form.setAttribute('data-loop-variant-id', r.value);
          var widget = form.querySelector('[data-loop-variant-id]');
          if (widget) widget.setAttribute('data-loop-variant-id', r.value);
          form.dispatchEvent(new CustomEvent('fortified:variantchange', { detail: { id: r.value } }));
        });
      });
    })();
  </script>
{% endif %}

<style>
  .fortified-variants { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .fortified-variants__label {
    font-family: var(--font-fortified-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fortified-gray-mid);
  }
  .fortified-variants__swatches { display: flex; flex-wrap: wrap; gap: 10px; }
  .fortified-variants__swatch {
    display: inline-flex;
    cursor: pointer;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid transparent;
    background: var(--fortified-off-white);
    padding: 8px;
    min-height: 44px;
  }
  .fortified-variants__swatch input { position: absolute; opacity: 0; pointer-events: none; }
  .fortified-variants__swatch.is-selected { border-color: var(--fortified-teal); }
  .fortified-variants__swatch.is-unavailable { opacity: .4; cursor: not-allowed; }
  .fortified-variants__swatch-inner { display: inline-flex; align-items: center; gap: 8px; }
  .fortified-variants__img { width: 44px; height: 44px; object-fit: cover; border-radius: 8px; }
  .fortified-variants__chip { width: 28px; height: 28px; border-radius: 999px; background: var(--fortified-teal); display: inline-block; }
  .fortified-variants__title {
    font-family: var(--font-fortified-body);
    font-size: 13px;
    font-weight: 600;
  }
</style>
