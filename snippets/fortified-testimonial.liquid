<section class="fortified-testimonial">
  <div class="fortified-container fortified-testimonial__inner">
    <div class="fortified-testimonial__media">
      {% if block.settings.photo != blank %}
        {{ block.settings.photo | image_url: width: 800 | image_tag:
            widths: '400, 600, 800',
            sizes: '(min-width: 750px) 40vw, 100vw',
            class: 'fortified-testimonial__img',
            alt: block.settings.name,
            loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="fortified-testimonial__body">
      <p class="fortified-testimonial__quote">"{{ block.settings.quote }}"</p>
      <p class="fortified-testimonial__attribution">
        <span class="fortified-testimonial__name">{{ block.settings.name }}</span>
        {% if block.settings.title != blank %}
          <span class="fortified-testimonial__title"> — {{ block.settings.title }}</span>
        {% endif %}
      </p>
      {% if block.settings.cta_label != blank %}
        <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .fortified-testimonial {
    background: var(--fortified-off-white);
    color: var(--fortified-black);
    padding-block: var(--fortified-section-py);
  }
  .fortified-testimonial__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }
  @media (min-width: 750px) {
    .fortified-testimonial__inner { grid-template-columns: 1fr 1fr; }
  }
  .fortified-testimonial__img { width: 100%; height: auto; border-radius: 20px; }
  .fortified-testimonial__body { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .fortified-testimonial__quote {
    font-family: var(--font-fortified-display);
    font-size: clamp(22px, 2.8vw, 34px);
    line-height: 1.15;
    margin: 0;
    letter-spacing: 0.01em;
  }
  .fortified-testimonial__attribution {
    margin: 0;
    font-family: var(--font-fortified-body);
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .fortified-testimonial__name { font-weight: 700; text-transform: uppercase; }
  .fortified-testimonial__title { opacity: .65; }
</style>
