<section class="fortified-subscribe-block">
  {% if block.settings.bg_image != blank %}
    {{ block.settings.bg_image | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-subscribe-block__bg',
        alt: '',
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-container fortified-subscribe-block__inner">
    {% if block.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
    {% endif %}
    <ul class="fortified-checklist fortified-subscribe-block__list">
      {% for i in (1..4) %}
        {%- assign key = 'benefit_' | append: i -%}
        {%- assign val = block.settings[key] -%}
        {% if val != blank %}<li>{{ val }}</li>{% endif %}
      {% endfor %}
    </ul>
    {% if block.settings.cta_label != blank %}
      <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<style>
  .fortified-subscribe-block {
    position: relative;
    background: var(--fortified-black);
    color: #fff;
    padding-block: var(--fortified-section-py);
    overflow: hidden;
    isolation: isolate;
  }
  .fortified-subscribe-block__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: .3;
  }
  .fortified-subscribe-block::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / .55), rgb(0 0 0 / .85));
    z-index: -1;
  }
  .fortified-subscribe-block__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 720px;
  }
  .fortified-subscribe-block__list { text-align: left; margin: 8px 0 16px; }
  .fortified-subscribe-block__list li { color: #fff; }
</style>
