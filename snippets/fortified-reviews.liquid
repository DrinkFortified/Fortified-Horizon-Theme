{% comment %} Judge.me full review widget for PDP {% endcomment %}
<section class="fortified-reviews-pdp">
  <div class="fortified-container">
    {% if block.settings.show_star_badge %}
      <div class="fortified-reviews-pdp__badge fortified-reviews-pdp__badge--{{ block.settings.badge_position }}">
        {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: true, product: product %}
      </div>
    {% endif %}
    {% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', concierge_install: true, product: product %}
  </div>
</section>

<style>
  .fortified-reviews-pdp {
    background: var(--fortified-white);
    padding-block: var(--fortified-section-py);
  }
  .fortified-reviews-pdp__badge { margin-bottom: 16px; }
  .fortified-reviews-pdp__badge--inline { display: inline-block; }
  .fortified-reviews-pdp__badge--below { display: block; }
</style>
