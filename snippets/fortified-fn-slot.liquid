{% comment %}
  Fortified Function Slot (consolidated per-slot picker)
  ----------------------------------------------------------------------
  Renders ONE consolidated build slot — used per pouch in the quarterly
  bundle and once in the monthly view. Replaces the per-function-card
  grid. Layout (top to bottom):
      hero image (swaps with the active function)
      description (swaps with the active function)
      "Select your function" + function radial selector
      "Select your flavor" + flavor radial selector (variants of active fn)

  Accepted params:
    config            - 'monthly' | 'q1' | 'q2' | 'q3' …
    function_blocks   - array of _ftd-ps-function blocks
    function_label    - heading above the function radial group
    flavor_label      - heading above the flavor radial group
    coming_soon_text  - badge text for coming-soon functions
{% endcomment %}

{%- assign active_fb_id = '' -%}
{%- for fb in function_blocks -%}
  {%- if fb.settings.enabled and active_fb_id == '' -%}
    {%- assign active_fb_id = fb.id -%}
  {%- endif -%}
{%- endfor -%}

<div class="fe-slot" data-config="{{ config }}">
  <div class="fe-slot-hero">
    {%- assign hero_src = '' -%}
    {%- assign hero_alt = '' -%}
    {%- for fb in function_blocks -%}
      {%- if fb.id == active_fb_id -%}
        {%- assign hero_img = fb.settings.card_image | default: fb.settings.thumbnail_image -%}
        {%- if hero_img == blank and fb.settings.product != blank -%}
          {%- assign hero_img = fb.settings.product.featured_image -%}
        {%- endif -%}
        {%- if hero_img != blank -%}
          {%- assign hero_src = hero_img | image_url: width: 600 -%}
        {%- endif -%}
        {%- assign hero_alt = fb.settings.function_label -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if hero_src != '' -%}
      <img class="fe-slot-hero-img" data-slot-hero src="{{ hero_src }}" alt="{{ hero_alt | escape }}" loading="lazy" width="320" height="320">
    {%- else -%}
      <div class="fe-slot-hero-ph" data-slot-hero aria-hidden="true"></div>
    {%- endif -%}
    <span class="fe-slot-hero-tick" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><polyline points="1.5,6 4.5,9 10.5,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>

  {%- assign active_desc = '' -%}
  {%- for fb in function_blocks -%}
    {%- if fb.id == active_fb_id and fb.settings.description != blank -%}
      {%- assign active_desc = fb.settings.description -%}
    {%- endif -%}
  {%- endfor -%}
  <p class="fe-slot-desc" data-slot-desc>{{ active_desc }}</p>

  <div class="fe-slot-step" data-step="function">
    <p class="fe-step-label">{{ function_label | default: 'Select your function' }}</p>
    <div class="fe-slot-radials fe-slot-radials--functions" role="radiogroup" data-function-group>
      {%- for fb in function_blocks -%}
        {%- if fb.settings.enabled -%}
          {%- assign prod = fb.settings.product -%}
          {%- assign thumb_src = '' -%}
          {%- if fb.settings.thumbnail_image != blank -%}
            {%- assign thumb_src = fb.settings.thumbnail_image | image_url: width: 96 -%}
          {%- elsif fb.settings.card_image != blank -%}
            {%- assign thumb_src = fb.settings.card_image | image_url: width: 96 -%}
          {%- elsif prod != blank and prod.featured_image != blank -%}
            {%- assign thumb_src = prod.featured_image | image_url: width: 96 -%}
          {%- endif -%}

          {%- assign hero_for_fn_src = '' -%}
          {%- if fb.settings.card_image != blank -%}
            {%- assign hero_for_fn_src = fb.settings.card_image | image_url: width: 600 -%}
          {%- elsif fb.settings.thumbnail_image != blank -%}
            {%- assign hero_for_fn_src = fb.settings.thumbnail_image | image_url: width: 600 -%}
          {%- elsif prod != blank and prod.featured_image != blank -%}
            {%- assign hero_for_fn_src = prod.featured_image | image_url: width: 600 -%}
          {%- endif -%}

          {%- comment %} Pick the variant option that holds the flavors {%- endcomment -%}
          {%- assign flavor_opt_name = '' -%}
          {%- if prod != blank and prod.options_with_values.size > 0 -%}
            {%- assign want = fb.settings.flavor_option | downcase | strip -%}
            {%- assign matched = false -%}
            {%- if want != '' -%}
              {%- for opt in prod.options_with_values -%}
                {%- assign have = opt.name | downcase | strip -%}
                {%- if have == want -%}
                  {%- assign flavor_opt_name = opt.name -%}
                  {%- assign matched = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- unless matched -%}
              {%- assign flavor_opt_name = prod.options_with_values.first.name -%}
            {%- endunless -%}
          {%- endif -%}

          {%- comment %} Build the variants JSON for this function {%- endcomment -%}
          {%- capture variants_json -%}
            [
            {%- assign emitted_any = false -%}
            {%- if prod != blank and flavor_opt_name != '' -%}
              {%- for opt in prod.options_with_values -%}
                {%- if opt.name == flavor_opt_name -%}
                  {%- for val in opt.values -%}
                    {%- assign vthumb_src = '' -%}
                    {%- assign vid_str = '' -%}
                    {%- for v in prod.variants -%}
                      {%- if v.options contains val -%}
                        {%- assign vid_str = v.id -%}
                        {%- if v.featured_image != blank -%}
                          {%- assign vthumb_src = v.featured_image | image_url: width: 96 -%}
                        {%- endif -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if emitted_any %},{% endif -%}
                    { "name": {{ val | json }}, "id": {{ vid_str | json }}, "thumb": {{ vthumb_src | json }} }
                    {%- assign emitted_any = true -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- assign manual_lines = fb.settings.manual_flavors | newline_to_br | split: '<br />' -%}
              {%- for m in manual_lines -%}
                {%- assign mt = m | strip -%}
                {%- if mt != '' -%}
                  {%- if emitted_any %},{% endif -%}
                  { "name": {{ mt | json }}, "id": "", "thumb": "" }
                  {%- assign emitted_any = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            ]
          {%- endcapture -%}

          <button type="button"
                  class="fe-flavor-opt fe-radial--function{% if fb.id == active_fb_id %} is-active{% endif %}"
                  data-function-radial
                  data-function-id="{{ fb.id }}"
                  data-product-handle="{{ prod.handle }}"
                  data-function-label="{{ fb.settings.function_label | escape }}"
                  data-plan-monthly="{{ fb.settings.loop_plan_monthly }}"
                  data-plan-quarterly="{{ fb.settings.loop_plan_quarterly }}"
                  data-hero-image="{{ hero_for_fn_src }}"
                  data-thumbnail="{{ thumb_src }}"
                  data-description="{{ fb.settings.description | strip_html | escape }}"
                  data-variants="{{ variants_json | strip | escape }}"
                  aria-pressed="{% if fb.id == active_fb_id %}true{% else %}false{% endif %}"
                  {%- if fb.settings.coming_soon %} data-coming-soon="true" aria-disabled="true"{%- endif %}>
            {%- if thumb_src != '' -%}
              <span class="fe-flavor-swatch"><img src="{{ thumb_src }}" alt="" width="20" height="20"></span>
            {%- endif -%}
            <span class="fe-flavor-name">{{ fb.settings.function_label }}{% if fb.settings.coming_soon %} <em class="fe-badge">{{ coming_soon_text | default: 'Soon' }}</em>{% endif %}</span>
            <span class="fe-flavor-radio" aria-hidden="true"></span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="fe-slot-step" data-step="flavor">
    <p class="fe-step-label">{{ flavor_label | default: 'Select your flavor' }}</p>
    <div class="fe-slot-radials fe-slot-radials--flavors" role="radiogroup" data-flavor-group>
      {%- comment %} Initial render: flavors of the active function. JS will repopulate on function change. {%- endcomment -%}
      {%- for fb in function_blocks -%}
        {%- if fb.id == active_fb_id -%}
          {%- assign prod = fb.settings.product -%}
          {%- assign flavor_opt_name = '' -%}
          {%- if prod != blank and prod.options_with_values.size > 0 -%}
            {%- assign want = fb.settings.flavor_option | downcase | strip -%}
            {%- assign matched = false -%}
            {%- if want != '' -%}
              {%- for opt in prod.options_with_values -%}
                {%- assign have = opt.name | downcase | strip -%}
                {%- if have == want -%}
                  {%- assign flavor_opt_name = opt.name -%}
                  {%- assign matched = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- unless matched -%}
              {%- assign flavor_opt_name = prod.options_with_values.first.name -%}
            {%- endunless -%}
          {%- endif -%}

          {%- if prod != blank and flavor_opt_name != '' -%}
            {%- for opt in prod.options_with_values -%}
              {%- if opt.name == flavor_opt_name -%}
                {%- for val in opt.values -%}
                  {%- assign vthumb_src = '' -%}
                  {%- for v in prod.variants -%}
                    {%- if v.options contains val -%}
                      {%- if v.featured_image != blank -%}
                        {%- assign vthumb_src = v.featured_image | image_url: width: 96 -%}
                      {%- endif -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button type="button" class="fe-flavor-opt" data-flavor-name="{{ val | escape }}" data-thumbnail="{{ vthumb_src }}" aria-pressed="false">
                    {%- if vthumb_src != '' -%}<span class="fe-flavor-swatch"><img src="{{ vthumb_src }}" alt="" width="20" height="20"></span>{%- endif -%}
                    <span class="fe-flavor-name">{{ val }}</span>
                    <span class="fe-flavor-radio" aria-hidden="true"></span>
                  </button>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign manual_lines = fb.settings.manual_flavors | newline_to_br | split: '<br />' -%}
            {%- for m in manual_lines -%}
              {%- assign mt = m | strip -%}
              {%- if mt != '' -%}
                <button type="button" class="fe-flavor-opt" data-flavor-name="{{ mt | escape }}" data-thumbnail="" aria-pressed="false">
                  <span class="fe-flavor-name">{{ mt }}</span>
                  <span class="fe-flavor-radio" aria-hidden="true"></span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
