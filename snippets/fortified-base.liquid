{% comment %}
  Shared FORTIFIED design tokens + utility CSS.
  Render once per page where needed: {% render 'fortified-base' %}
{% endcomment %}
{% unless fortified_base_loaded %}
  {% assign fortified_base_loaded = true %}
  <style>
    :root {
      --fortified-container: 1320px;
      --fortified-section-py: clamp(48px, 7vw, 112px);
      --fortified-radius-pill: 999px;

      --fortified-black: #0A0A0A;
      --fortified-white: #FFFFFF;
      --fortified-off-white: #F4EEE7;
      --fortified-gray-light: #E5E5E5;
      --fortified-gray-mid: #6B6B6B;
      --fortified-teal: #1FA8A1;
      --fortified-teal-dark: #168A84;
      --fortified-orange: #F2A93B;
      --fortified-gold: #D9A24A;
      --fortified-success: #2BB673;

      --font-fortified-display: 'Brother 1816', 'Helvetica Neue', Arial, sans-serif;
      --font-fortified-body: 'Brother 1816', 'Helvetica Neue', Arial, sans-serif;
    }

    .fortified {
      font-family: var(--font-fortified-body);
      color: var(--color-foreground);
    }
    .fortified-container {
      width: 100%;
      max-width: var(--fortified-container);
      margin-inline: auto;
      padding-inline: clamp(16px, 4vw, 80px);
    }
    .fortified-section {
      padding-block: var(--fortified-section-py);
    }
    .fortified-eyebrow {
      display: inline-block;
      font-family: var(--font-fortified-body);
      font-size: clamp(11px, 1vw, 13px);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--fortified-teal);
      margin: 0 0 12px;
    }
    .fortified-heading {
      font-family: var(--font-fortified-display);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.005em;
      line-height: 0.95;
      margin: 0 0 16px;
      color: var(--color-foreground-heading, currentColor);
    }
    .fortified-h1 { font-size: clamp(44px, 8vw, 96px); }
    .fortified-h2 { font-size: clamp(32px, 5.5vw, 64px); }
    .fortified-h3 { font-size: clamp(24px, 3.2vw, 40px); }
    .fortified-body {
      font-family: var(--font-fortified-body);
      font-size: clamp(15px, 1.1vw, 17px);
      font-weight: 400;
      line-height: 1.55;
      color: var(--color-foreground);
    }
    .fortified-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: var(--fortified-radius-pill);
      padding: 14px 32px;
      font-family: var(--font-fortified-body);
      font-size: clamp(12px, 1vw, 14px);
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: transform .15s ease, opacity .15s ease, background-color .15s ease;
      border: 2px solid transparent;
      min-height: 44px;
    }
    .fortified-btn:hover { transform: translateY(-1px); opacity: .92; }
    .fortified-btn--primary {
      background: var(--fortified-teal);
      color: var(--fortified-white);
    }
    .fortified-btn--primary:hover { background: var(--fortified-teal-dark); }
    .fortified-btn--ghost {
      background: transparent;
      color: var(--fortified-teal);
      border-color: var(--fortified-teal);
    }
    .fortified-btn--dark {
      background: var(--fortified-black);
      color: var(--fortified-white);
    }
    .fortified-btn--white {
      background: var(--fortified-white);
      color: var(--fortified-black);
    }
    .fortified-checklist {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .fortified-checklist li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-family: var(--font-fortified-body);
      font-size: 15px;
    }
    .fortified-checklist li::before {
      content: "✓";
      color: var(--fortified-teal);
      font-weight: 700;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .fortified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: var(--fortified-radius-pill);
      font-family: var(--font-fortified-body);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .fortified-badge--teal { background: var(--fortified-teal); color: #fff; }
    .fortified-badge--dark { background: var(--fortified-black); color: #fff; }
    .fortified-badge--white { background: #fff; color: var(--fortified-black); }

    /* === Aggressive horizontal centering for every Fortified element === */

    /* All section/block roots: center the container itself */
    [class*="fortified-"][class*="fortified-container"],
    .fortified-container {
      margin-inline: auto !important;
    }

    /* Every wrapper inside any Fortified block: center its content */
    [class^="fortified-"][class*="__inner"],
    [class*=" fortified-"][class*="__inner"],
    [class^="fortified-"][class*="__copy"],
    [class*=" fortified-"][class*="__copy"],
    [class^="fortified-"][class*="__header"],
    [class*=" fortified-"][class*="__header"],
    [class^="fortified-"][class*="__content"],
    [class*=" fortified-"][class*="__content"],
    [class^="fortified-"][class*="__body"],
    [class*=" fortified-"][class*="__body"],
    [class^="fortified-"][class*="__panel"],
    [class*=" fortified-"][class*="__panel"],
    [class^="fortified-"][class*="__card"],
    [class*=" fortified-"][class*="__card"],
    [class^="fortified-"][class*="__cta"],
    [class*=" fortified-"][class*="__cta"],
    [class^="fortified-"][class*="__row"],
    [class*=" fortified-"][class*="__row"],
    [class^="fortified-"][class*="__grid"],
    [class*=" fortified-"][class*="__grid"],
    [class^="fortified-"][class*="__items"],
    [class*=" fortified-"][class*="__items"],
    [class^="fortified-"][class*="__list"],
    [class*=" fortified-"][class*="__list"],
    [class^="fortified-"][class*="__tabs"],
    [class*=" fortified-"][class*="__tabs"],
    [class^="fortified-"][class*="__panels"],
    [class*=" fortified-"][class*="__panels"],
    [class^="fortified-"][class*="__side"],
    [class*=" fortified-"][class*="__side"],
    [class^="fortified-"][class*="__scroll"],
    [class*=" fortified-"][class*="__scroll"],
    [class^="fortified-"][class*="__products"],
    [class*=" fortified-"][class*="__products"] {
      margin-inline: auto !important;
      text-align: center !important;
    }

    /* Flex containers inside Fortified blocks: center along main axis */
    [class*="fortified-"][class*="__inner"],
    [class*="fortified-"][class*="__copy"],
    [class*="fortified-"][class*="__header"],
    [class*="fortified-"][class*="__content"],
    [class*="fortified-"][class*="__cta"],
    [class*="fortified-"][class*="__row"],
    [class*="fortified-"][class*="__list"],
    [class*="fortified-"][class*="__tabs"],
    [class*="fortified-"][class*="__panels"],
    [class*="fortified-"][class*="__side"],
    [class*="fortified-"][class*="__products"],
    [class*="fortified-"][class*="__items"] {
      justify-content: center !important;
      align-items: center !important;
      justify-items: center !important;
    }

    /* Force grid layouts to center their items in their cells */
    [class*="fortified-"][class*="__grid"] {
      justify-items: center !important;
      align-items: center !important;
    }

    /* All text inside any Fortified block centers */
    [class^="fortified-"] h1,
    [class*=" fortified-"] h1,
    [class^="fortified-"] h2,
    [class*=" fortified-"] h2,
    [class^="fortified-"] h3,
    [class*=" fortified-"] h3,
    [class^="fortified-"] h4,
    [class*=" fortified-"] h4,
    [class^="fortified-"] p,
    [class*=" fortified-"] p,
    [class^="fortified-"] .fortified-heading,
    [class*=" fortified-"] .fortified-heading,
    [class^="fortified-"] .fortified-eyebrow,
    [class*=" fortified-"] .fortified-eyebrow,
    [class^="fortified-"] .fortified-body,
    [class*=" fortified-"] .fortified-body {
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }

    /* Buttons: keep them inline-flex (they're inline-flex by default) but center their containing row */
    [class*="fortified-"] .fortified-btn {
      margin-inline: auto !important;
    }

    /* Comparison table — keep cells readable, but center the table itself */
    .fortified-comparison__table {
      margin-inline: auto !important;
    }
    .fortified-comparison__table th,
    .fortified-comparison__table td {
      text-align: center !important;
    }
  </style>
{% endunless %}
