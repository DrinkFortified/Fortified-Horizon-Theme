{% comment %}
  Shared FORTIFIED design tokens + utility CSS.
  Render once per page where needed: {% render 'fortified-base' %}
{% endcomment %}
{% unless fortified_base_loaded %}
  {% assign fortified_base_loaded = true %}
  <style>
    :root {
      --fortified-container: 1240px;
      --fortified-section-py: clamp(40px, 5vw, 72px);
      --fortified-radius-pill: 999px;
      --fortified-radius-button: 10px;
      --fortified-radius-card: 14px;

      /* === Brand palette (matches Figma) === */
      --fortified-white:        #FFFFFF;
      --fortified-cream:        #FDFAF5;
      --fortified-parchment:    #F7F2E8;
      --fortified-stone:        #EAE4D8;
      --fortified-border:       #DDD7CA;
      --fortified-muted:        #A09488;
      --fortified-ink:          #3D3830;
      --fortified-charcoal:     #2A2520;
      --fortified-black:        #2A2520;
      --fortified-off-white:    #FDFAF5;
      --fortified-gray-light:   #DDD7CA;
      --fortified-gray-mid:     #A09488;

      --fortified-sage:         #6B9478;
      --fortified-sage-tint:    #EDF4EF;
      --fortified-sage-border:  #C2D9C9;
      --fortified-sage-dark:    #2D5C3A;

      --fortified-saffron:      #C97A0A;
      --fortified-saffron-tint: #FBF4E4;
      --fortified-saffron-border:#E8C87A;
      --fortified-saffron-dark: #7A4A05;

      --fortified-mauve:        #8C5F7A;
      --fortified-mauve-tint:   #F5EEF3;
      --fortified-mauve-border: #D4B4C8;
      --fortified-mauve-dark:   #5A2E4A;

      /* Legacy aliases mapped to new tokens — keeps existing CSS working */
      --fortified-teal:         var(--fortified-sage);
      --fortified-teal-dark:    var(--fortified-sage-dark);
      --fortified-orange:       var(--fortified-saffron);
      --fortified-gold:         var(--fortified-saffron-dark);
      --fortified-success:      var(--fortified-sage-dark);

      --font-fortified-display: 'Brother 1816', 'Helvetica Neue', Arial, sans-serif;
      --font-fortified-body: 'Brother 1816', 'Helvetica Neue', Arial, sans-serif;
    }

    .fortified {
      font-family: var(--font-fortified-body);
      color: var(--color-foreground, var(--fortified-ink));
    }
    .fortified-container {
      width: 100%;
      max-width: var(--fortified-container);
      margin-inline: auto;
      padding-inline: clamp(16px, 3vw, 48px);
    }
    .fortified-section {
      padding-block: var(--fortified-section-py);
    }
    .fortified-eyebrow {
      display: inline-block;
      font-family: var(--font-fortified-body);
      font-size: clamp(10px, 0.85vw, 12px);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--fortified-muted);
      margin: 0 0 10px;
    }
    .fortified-heading {
      font-family: var(--font-fortified-display);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.005em;
      line-height: 1;
      margin: 0 0 12px;
      color: var(--color-foreground-heading, var(--fortified-charcoal));
    }
    .fortified-h1 { font-size: clamp(32px, 5vw, 56px); line-height: 0.98; }
    .fortified-h2 { font-size: clamp(26px, 3.5vw, 40px); }
    .fortified-h3 { font-size: clamp(20px, 2.2vw, 28px); }
    .fortified-body {
      font-family: var(--font-fortified-body);
      font-size: clamp(14px, 1vw, 16px);
      font-weight: 400;
      line-height: 1.55;
      color: var(--color-foreground, var(--fortified-ink));
    }
    .fortified-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: var(--fortified-radius-button);
      padding: 12px 22px;
      font-family: var(--font-fortified-body);
      font-size: clamp(11px, 0.9vw, 13px);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: none;
      text-decoration: none;
      cursor: pointer;
      transition: filter .15s ease, transform .15s ease, background-color .15s ease;
      border: 1.5px solid transparent;
      min-height: 40px;
    }
    .fortified-btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
    .fortified-btn--primary {
      background: var(--fortified-charcoal);
      color: var(--fortified-cream);
    }
    .fortified-btn--primary:hover { background: #1A1510; }
    .fortified-btn--ghost {
      background: transparent;
      color: var(--fortified-charcoal);
      border-color: var(--fortified-border);
    }
    .fortified-btn--ghost:hover { background: var(--fortified-parchment); }
    .fortified-btn--dark {
      background: var(--fortified-charcoal);
      color: var(--fortified-cream);
    }
    .fortified-btn--accent {
      background: var(--fortified-saffron);
      color: var(--fortified-white);
    }
    .fortified-btn--sage {
      background: var(--fortified-sage);
      color: var(--fortified-white);
    }
    .fortified-btn--white {
      background: var(--fortified-white);
      color: var(--fortified-charcoal);
      border-color: var(--fortified-border);
    }
    .fortified-checklist {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .fortified-checklist li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-family: var(--font-fortified-body);
      font-size: 15px;
    }
    .fortified-checklist li::before {
      content: "✓";
      color: var(--fortified-teal);
      font-weight: 700;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .fortified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: var(--fortified-radius-pill);
      font-family: var(--font-fortified-body);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .fortified-badge--teal { background: var(--fortified-teal); color: #fff; }
    .fortified-badge--dark { background: var(--fortified-black); color: #fff; }
    .fortified-badge--white { background: #fff; color: var(--fortified-black); }

    /* === Centering for Fortified content (conservative) === */

    /* Wrappers should sit centered on the page */
    .fortified-container,
    .fortified-hero__inner,
    .fortified-product-feature__inner,
    .fortified-dark-lifestyle__inner,
    .fortified-stats__inner,
    .fortified-ingredients__inner,
    .fortified-lifestyle-strip__inner,
    .fortified-faq__inner,
    .fortified-b2b__inner,
    .fortified-subscribe__inner,
    .fortified-comparison-table__inner,
    .fortified-press__row {
      margin-inline: auto;
    }

    /* Single-column content blocks: center their text */
    .fortified-stats__header,
    .fortified-ingredients__header,
    .fortified-reviews__header,
    .fortified-comparison__heading,
    .fortified-lifestyle-strip__header,
    .fortified-subscribe__header {
      text-align: center;
    }

    /* Comparison table cells stay center-aligned */
    .fortified-comparison__table {
      margin-inline: auto;
    }
    .fortified-comparison__table th,
    .fortified-comparison__table td {
      text-align: center;
    }

    /* Position control — section root with text-align cascades to flex/grid children */
    [class*="fortified-"][style*="text-align: center"] [class*="__inner"],
    [class*="fortified-"][style*="text-align: center"] [class*="__header"],
    [class*="fortified-"][style*="text-align: center"] [class*="__row"],
    [class*="fortified-"][style*="text-align: center"] [class*="__grid"],
    [class*="fortified-"][style*="text-align: center"] [class*="__list"] {
      justify-content: center;
      justify-items: center;
      align-items: center;
      margin-inline: auto;
    }
    [class*="fortified-"][style*="text-align: left"] [class*="__inner"],
    [class*="fortified-"][style*="text-align: left"] [class*="__header"],
    [class*="fortified-"][style*="text-align: left"] [class*="__row"],
    [class*="fortified-"][style*="text-align: left"] [class*="__grid"],
    [class*="fortified-"][style*="text-align: left"] [class*="__list"] {
      justify-content: flex-start;
      justify-items: start;
      align-items: flex-start;
    }
    [class*="fortified-"][style*="text-align: right"] [class*="__inner"],
    [class*="fortified-"][style*="text-align: right"] [class*="__header"],
    [class*="fortified-"][style*="text-align: right"] [class*="__row"],
    [class*="fortified-"][style*="text-align: right"] [class*="__grid"],
    [class*="fortified-"][style*="text-align: right"] [class*="__list"] {
      justify-content: flex-end;
      justify-items: end;
      align-items: flex-end;
    }

    /* center-aware block alignment (global) — applies to every Fortified section */
    [style*="text-align: center"] [class*="fortified-"][class*="__card"],
    [style*="text-align: center"] [class*="fortified-"][class*="__item"],
    [style*="text-align: center"] [class*="fortified-"][class*="__panel"],
    [style*="text-align: center"] [class*="fortified-"][class*="__cell"],
    [style*="text-align: center"] [class*="fortified-"][class*="__copy"],
    [style*="text-align: center"] [class*="fortified-"][class*="__content"],
    [style*="text-align: center"] [class*="fortified-"][class*="__body"],
    [style*="text-align: center"] [class*="fortified-"][class*="__inner"] { align-items: center !important; }

    [style*="text-align: left"] [class*="fortified-"][class*="__card"],
    [style*="text-align: left"] [class*="fortified-"][class*="__item"],
    [style*="text-align: left"] [class*="fortified-"][class*="__panel"],
    [style*="text-align: left"] [class*="fortified-"][class*="__cell"],
    [style*="text-align: left"] [class*="fortified-"][class*="__copy"],
    [style*="text-align: left"] [class*="fortified-"][class*="__content"],
    [style*="text-align: left"] [class*="fortified-"][class*="__body"],
    [style*="text-align: left"] [class*="fortified-"][class*="__inner"] { align-items: flex-start !important; }

    [style*="text-align: right"] [class*="fortified-"][class*="__card"],
    [style*="text-align: right"] [class*="fortified-"][class*="__item"],
    [style*="text-align: right"] [class*="fortified-"][class*="__panel"],
    [style*="text-align: right"] [class*="fortified-"][class*="__cell"],
    [style*="text-align: right"] [class*="fortified-"][class*="__copy"],
    [style*="text-align: right"] [class*="fortified-"][class*="__content"],
    [style*="text-align: right"] [class*="fortified-"][class*="__body"],
    [style*="text-align: right"] [class*="fortified-"][class*="__inner"] { align-items: flex-end !important; }

    /* block-row positioning — when block row uses justify-content other than stretch,
       allow grids to auto-size their tracks so blocks can actually center/left/right */
    [style*="justify-content: center"][class*="__grid"],
    [style*="justify-content: flex-start"][class*="__grid"],
    [style*="justify-content: flex-end"][class*="__grid"] {
      grid-auto-flow: column;
      grid-template-columns: repeat(auto-fit, minmax(0, max-content)) !important;
      gap: clamp(16px, 2vw, 32px);
    }
    [style*="justify-content: space-between"][class*="__grid"] {
      justify-items: stretch !important;
    }
    /* For flex rows of blocks */
    [class*="__row"][style*="justify-content"],
    [class*="__items"][style*="justify-content"],
    [class*="__panels"][style*="justify-content"] {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(16px, 2vw, 32px);
    }
  </style>
{% endunless %}
