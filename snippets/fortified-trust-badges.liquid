{% comment %} Trust badges horizontal row {% endcomment %}
<div class="fortified-trust">
  {% for i in (1..6) %}
    {%- assign key = 'badge_' | append: i -%}
    {%- assign img = block.settings[key] -%}
    {% if img != blank %}
      <div class="fortified-trust__item">
        {{ img | image_url: width: 200 | image_tag:
            widths: '80, 120, 200',
            sizes: '80px',
            class: 'fortified-trust__img',
            alt: img.alt | default: 'Trust badge',
            loading: 'lazy' }}
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  .fortified-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.5vw, 18px);
    padding: 14px 0;
    border-block: 1px solid var(--fortified-gray-light);
  }
  .fortified-trust__item { flex: 0 0 auto; }
  .fortified-trust__img { max-height: 40px; width: auto; object-fit: contain; opacity: .8; }
</style>
