{% comment %} Fortified product gallery — main image + thumbnail strip {% endcomment %}
<div class="fortified-gallery" data-fortified-gallery>
  <div class="fortified-gallery__main">
    {% if product.featured_media != blank %}
      {% for media in product.media %}
        <button
          type="button"
          class="fortified-gallery__main-btn {% if forloop.first %}is-active{% endif %}"
          data-media-id="{{ media.id }}"
          {% if block.settings.enable_zoom %}data-zoom{% endif %}
          {% unless forloop.first %}hidden{% endunless %}
          aria-label="View product image {{ forloop.index }}"
        >
          {{ media | image_url: width: 1400 | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 1024px) 50vw, 100vw',
              class: 'fortified-gallery__img',
              alt: media.alt | default: product.title,
              loading: 'eager',
              fetchpriority: 'high' }}
        </button>
      {% endfor %}
    {% else %}
      <div class="fortified-gallery__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>

  {% if block.settings.show_thumbnails and product.media.size > 1 %}
    <div class="fortified-gallery__thumbs" role="tablist">
      {% for media in product.media %}
        <button
          type="button"
          class="fortified-gallery__thumb {% if forloop.first %}is-active{% endif %}"
          data-media-id="{{ media.id }}"
          aria-label="Show image {{ forloop.index }}"
        >
          {{ media | image_url: width: 160 | image_tag:
              widths: '80, 120, 160',
              sizes: '80px',
              class: 'fortified-gallery__thumb-img',
              alt: media.alt,
              loading: 'lazy' }}
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  (function () {
    var galleries = document.querySelectorAll('[data-fortified-gallery]');
    galleries.forEach(function (gallery) {
      var thumbs = gallery.querySelectorAll('.fortified-gallery__thumb');
      var mains = gallery.querySelectorAll('.fortified-gallery__main-btn');
      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          var id = thumb.getAttribute('data-media-id');
          thumbs.forEach(function (t) { t.classList.toggle('is-active', t === thumb); });
          mains.forEach(function (m) {
            if (m.getAttribute('data-media-id') === id) {
              m.removeAttribute('hidden');
              m.classList.add('is-active');
            } else {
              m.setAttribute('hidden', '');
              m.classList.remove('is-active');
            }
          });
        });
      });
      mains.forEach(function (main) {
        if (main.hasAttribute('data-zoom')) {
          main.addEventListener('click', function () {
            main.classList.toggle('is-zoomed');
          });
        }
      });
    });
  })();
</script>

<style>
  .fortified-gallery { display: flex; flex-direction: column; gap: 14px; }
  .fortified-gallery__main { position: relative; background: var(--fortified-off-white); border-radius: 16px; overflow: hidden; }
  .fortified-gallery__main-btn {
    border: 0;
    background: transparent;
    padding: 0;
    width: 100%;
    cursor: zoom-in;
    display: block;
  }
  .fortified-gallery__img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; display: block; transition: transform .3s ease; }
  .fortified-gallery__main-btn.is-zoomed .fortified-gallery__img { transform: scale(1.6); }
  .fortified-gallery__thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fortified-gallery__thumbs::-webkit-scrollbar { display: none; }
  .fortified-gallery__thumb {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid transparent;
    background: var(--fortified-off-white);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
  }
  .fortified-gallery__thumb.is-active { border-color: var(--fortified-teal); }
  .fortified-gallery__thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
