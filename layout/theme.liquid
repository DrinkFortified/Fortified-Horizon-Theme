<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
<head>
  <link rel="stylesheet" href="https://use.typekit.net/utb5zek.css">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {% if settings.transition_to_main_product or settings.page_transition_enabled %}
    <link rel="expect" href="#MainContent" blocking="render" id="view-transition-render-blocker">
  {% endif %}

  {%- render 'meta-tags' -%}
  {%- render 'stylesheets' -%}
  {%- render 'fonts' -%}
  {%- render 'scripts' -%}
  {%- render 'theme-styles-variables' -%}
  {%- render 'color-schemes' -%}

  {% if request.design_mode %}
    {%- render 'theme-editor' -%}
  {% endif %}

  <link rel="preload" href="{{ 'Brother-1816-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'Brother-1816-Black.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

  {%- comment -%} Fortified overrides — must come AFTER Horizon's font/variable renders so :root wins the cascade {%- endcomment -%}
  <style>
    @font-face {
      font-family: "Brother 1816";
      src: url("{{ 'Brother-1816-Regular.woff2' | asset_url }}") format("woff2");
      font-weight: 400; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Brother 1816";
      src: url("{{ 'Brother-1816-Regular-Italic.woff2' | asset_url }}") format("woff2");
      font-weight: 400; font-style: italic; font-display: swap;
    }
    @font-face {
      font-family: "Brother 1816";
      src: url("{{ 'Brother-1816-Medium.woff2' | asset_url }}") format("woff2");
      font-weight: 500; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Brother 1816";
      src: url("{{ 'Brother-1816-Bold.woff2' | asset_url }}") format("woff2");
      font-weight: 700; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Brother 1816";
      src: url("{{ 'Brother-1816-Black.woff2' | asset_url }}") format("woff2");
      font-weight: 900; font-style: normal; font-display: swap;
    }

    :root {
      --font-body--family: "Brother 1816", "Helvetica Neue", Arial, sans-serif;
      --font-heading--family: "Brother 1816", "Helvetica Neue", Arial, sans-serif;
      --font-subheading--family: "Brother 1816", "Helvetica Neue", Arial, sans-serif;
      --font-accent--family: "Brother 1816", "Helvetica Neue", Arial, sans-serif;
      --font-navigation--family: "Brother 1816", "Helvetica Neue", Arial, sans-serif;
    }

    .fortified-accent-text {
      color: #1FA8A1;
      font-style: normal;
    }

    .fortified-accent-green {
      color: #C4E1C5;
      font-style: normal;
    }

    /* Force all headings to display uppercase visually.
       The HTML source keeps its original casing for SEO and accessibility. */
    h1, h2, h3, h4, h5, h6,
    .h1, .h2, .h3, .h4, .h5, .h6 {
      text-transform: uppercase;
    }

    /* ── Unified homepage CTA buttons ──────────────────────────────
       One consistent look for every CTA across the Fortified homepage
       sections: UPPERCASE, 14px, weight 700, 0.14em tracking, 15x34
       padding, same radius. Scoped to the FTD section wrappers, with
       !important so it wins over both Horizon's .button and each
       section's own id-scoped rules. `__cta` / `__btn` = bespoke
       buttons; `.button` / `.button-secondary` = theme buttons that a
       few sections emit. */
    .ftd-truth-section a[class*="__cta"],
    .ftd-stats-comparison-section .ftd-cta-row .button,
    .ftd-comparison-section .ftd-cta-row a[class*="__cta"],
    .ftd-comparison-section .ftd-cta-row .button,
    .ftd-ingredients-callout-section .ftd-ic__cta-wrap .button,
    .ftd-two-column-cta-section a[class*="__btn"],
    .ftd-subscribe-save-section a[class*="__btn"] {
      font-family: var(--font-heading--family, inherit) !important;
      text-transform: uppercase !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      letter-spacing: 0.14em !important;
      line-height: 1 !important;
      padding: 15px 34px !important;
      border-radius: var(--style-border-radius-buttons-primary, 8px) !important;
    }

    /* Primary = solid dark (single-tone sections). Two-Column keeps its
       per-card button colors; only its size/case is normalized above. */
    .ftd-truth-section a[class*="__cta"],
    .ftd-stats-comparison-section .ftd-cta-row .button:not(.button-secondary),
    .ftd-comparison-section .ftd-cta-row a[class*="__cta"],
    .ftd-ingredients-callout-section .ftd-ic__cta-wrap .button:not(.button-secondary),
    .ftd-subscribe-save-section a[class*="__btn"] {
      background: var(--color-foreground) !important;
      color: var(--color-background) !important;
      border: 2px solid var(--color-foreground) !important;
    }

    /* Secondary ("Learn More") = outline. */
    .ftd-stats-comparison-section .ftd-cta-row .button-secondary,
    .ftd-comparison-section .ftd-cta-row .button-secondary,
    .ftd-ingredients-callout-section .ftd-ic__cta-wrap .button-secondary {
      background: transparent !important;
      color: var(--color-foreground) !important;
      border: 2px solid var(--color-foreground) !important;
    }

    .ftd-truth-section a[class*="__cta"]:hover,
    .ftd-stats-comparison-section .ftd-cta-row .button:not(.button-secondary):hover,
    .ftd-comparison-section .ftd-cta-row a[class*="__cta"]:hover,
    .ftd-ingredients-callout-section .ftd-ic__cta-wrap .button:not(.button-secondary):hover,
    .ftd-subscribe-save-section a[class*="__btn"]:hover { opacity: 0.9 !important; }

    .ftd-stats-comparison-section .ftd-cta-row .button-secondary:hover,
    .ftd-comparison-section .ftd-cta-row .button-secondary:hover,
    .ftd-ingredients-callout-section .ftd-ic__cta-wrap .button-secondary:hover {
      background: var(--color-foreground) !important;
      color: var(--color-background) !important;
    }

    /* "Build Your Bundle" slide-over trigger (FTD - ProductSelector-DS),
       wherever it's placed — same canonical look. It's a theme .button
       (filled) or .button.button-secondary (outline). */
    .ftdc-slideover-wrap > .button {
      font-family: var(--font-heading--family, inherit) !important;
      text-transform: uppercase !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      letter-spacing: 0.14em !important;
      line-height: 1 !important;
      padding: 15px 34px !important;
      border-radius: var(--style-border-radius-buttons-primary, 8px) !important;
    }
    .ftdc-slideover-wrap > .button:not(.button-secondary) {
      background: var(--color-foreground) !important;
      color: var(--color-background) !important;
      border: 2px solid var(--color-foreground) !important;
    }
    .ftdc-slideover-wrap > .button-secondary {
      background: transparent !important;
      color: var(--color-foreground) !important;
      border: 2px solid var(--color-foreground) !important;
    }
    .ftdc-slideover-wrap > .button:not(.button-secondary):hover { opacity: 0.9 !important; }
    .ftdc-slideover-wrap > .button-secondary:hover {
      background: var(--color-foreground) !important;
      color: var(--color-background) !important;
    }
  </style>

  {{ content_for_header }}
</head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>
<script>
  (function () {
    // Match **double** first (longer), then *single*. Newlines and stray
    // asterisks can't span a highlight.
    var RE = /\*\*([^*\n]+)\*\*|\*([^*\n]+)\*/g;

    function transformAsterisks(root) {
      // Walk only TEXT nodes — never touches scripts, styles, inputs, or attribute values
      var walker = document.createTreeWalker(
        root,
        NodeFilter.SHOW_TEXT,
        {
          acceptNode: function (node) {
            // Skip text inside <script>, <style>, <textarea>, <input>, <code>, contenteditable
            var p = node.parentNode;
            if (!p) return NodeFilter.FILTER_REJECT;
            var tag = p.nodeName;
            if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'TEXTAREA' || tag === 'INPUT' || tag === 'CODE' || tag === 'PRE') {
              return NodeFilter.FILTER_REJECT;
            }
            if (p.closest && p.closest('[contenteditable="true"]')) {
              return NodeFilter.FILTER_REJECT;
            }
            // Skip if no paired asterisks
            return /\*[^*]+\*/.test(node.nodeValue)
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          }
        }
      );

      var nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);

      nodes.forEach(function (node) {
        var text = node.nodeValue;
        RE.lastIndex = 0;
        if (!RE.test(text)) return;
        RE.lastIndex = 0;

        var frag = document.createDocumentFragment();
        var lastIndex = 0;
        var m;

        while ((m = RE.exec(text)) !== null) {
          if (m.index > lastIndex) {
            frag.appendChild(document.createTextNode(text.slice(lastIndex, m.index)));
          }
          var span = document.createElement('span');
          if (m[1] !== undefined) {
            // **double** → green
            span.className = 'fortified-accent-green';
            span.textContent = m[1];
          } else {
            // *single* → teal
            span.className = 'fortified-accent-text';
            span.textContent = m[2];
          }
          frag.appendChild(span);
          lastIndex = m.index + m[0].length;
        }
        if (lastIndex < text.length) {
          frag.appendChild(document.createTextNode(text.slice(lastIndex)));
        }
        node.parentNode.replaceChild(frag, node);
      });
    }

    function run() {
      transformAsterisks(document.body);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    // Re-run when Shopify sections are re-rendered in the theme editor (live preview)
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target) transformAsterisks(e.target);
    });
  })();
</script>
    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
