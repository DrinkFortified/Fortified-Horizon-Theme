

{% assign block_settings = block.settings %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<dialog-component
  class="popup-link"
  {{ block.shopify_attributes }}
>
  <button
    on:click="/showDialog"
    class="button button-unstyled popup-link__button text-left spacing-style {{ block_settings.type_preset }}"
    style="{% render 'spacing-style', settings: block_settings %}"
  >
    {{- block_settings.heading }}
    {{- 'icon-external.svg' | inline_asset_content -}}
  </button>

  <dialog
    ref="dialog"
    class="popup-link__content dialog-modal color-{{ settings.popover_color_scheme }}{% if block_settings.behavior == 'drawer' %} popup-link__content--drawer dialog-drawer{% elsif block_settings.behavior == 'fullscreen' %} popup-link__content--fullscreen{% endif %}"
    scroll-lock
    aria-labelledby="popup-dialog-heading"
  >
    <h2
      id="popup-dialog-heading"
      class="visually-hidden"
    >
      {{ block_settings.heading }}
    </h2>
    <div class="popup-link__inner">
      {% content_for 'blocks' %}
    </div>
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button popup-link__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </dialog>
</dialog-component>

{% stylesheet %}
  .popup-link__button svg {
    display: inline-block;
    position: relative;
    top: var(--margin-2xs);
  }

  .popup-link__content {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  .popup-link__content[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
  }

  /* Needed to ensure the drawer is full height */
  .popup-link__content--drawer:modal {
    max-height: 100dvh;
  }

  .popup-link__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }

  /* ── Fullscreen behavior ─────────────────────────────────────────
     Lightbox covers the whole viewport and the inner content gets the
     full page width (inner blocks manage their own layout). Double
     class beats the base rule's nested desktop media query without
     resorting to !important. */
  .popup-link__content.popup-link__content--fullscreen {
    position: fixed;
    /* inset: 0 + auto width/height sizes the box to the viewport exactly —
       immune to the 100vw scrollbar overhang and mobile dvh quirks. */
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    border-radius: 0;
    padding: 0;
    overflow-y: auto;
    /* Stray wide content inside the page (RTE images/tables with inline
       widths) must scroll or clip inside — never shove the layout sideways. */
    overflow-x: hidden;
    overscroll-behavior: contain;
  }
  .popup-link__content.popup-link__content--fullscreen:modal {
    max-height: none;
    max-width: none;
  }

  .popup-link__content--fullscreen .popup-link__inner {
    width: 100%;
    /* Match the site's own page container (the body's page-width class
       sets --page-content-width; the store uses "narrow" ≈ 1400px), so
       content in the lightbox lines up with elements on the actual site. */
    max-width: var(--page-content-width, 90rem);
    margin-inline: auto;
    box-sizing: border-box;
    /* Breathing room: top clears the floating close button; sides use the
       same clamp scale as the FTD sections' inner padding. */
    padding: 64px clamp(20px, 5vw, 64px) clamp(32px, 4vw, 56px);
  }

  /* Defensive rules for admin rich-text content on small screens. */
  .popup-link__content--fullscreen .popup-link__inner {
    overflow-wrap: break-word;
  }
  .popup-link__content--fullscreen .popup-link__inner :is(img, video, table) {
    max-width: 100% !important;
    height: auto;
  }
  /* Iframes have no intrinsic aspect ratio, so height: auto collapses them
     to the 150px browser default (squished video bar). Cap the width and
     give video embeds a real 16:9 box instead. */
  .popup-link__content--fullscreen .popup-link__inner iframe {
    max-width: 100% !important;
  }
  .popup-link__content--fullscreen .popup-link__inner :is(iframe[src*="youtube"], iframe[src*="youtu.be"], iframe[src*="vimeo"]) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  @media screen and (max-width: 749px) {
    .popup-link__content--fullscreen .popup-link__inner {
      padding: 64px 16px 32px;
    }
    /* RTE-floated images read as chaos on phones — stack them instead. */
    .popup-link__content--fullscreen .rte img,
    .popup-link__content--fullscreen .rte [style*="float"] {
      float: none !important;
      display: block;
      margin-inline: auto;
    }
  }

  /* Close button matches the FTD slide-over style: 44px round button
     floating above the content, with a backing circle 3px proud on
     every side so it stays legible over whatever it overlaps. */
  .popup-link__content--fullscreen .popup-link__close {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.15);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    z-index: 10;
  }
  .popup-link__content--fullscreen .popup-link__close:hover {
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }
  .popup-link__content--fullscreen .popup-link__close::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-background);
    z-index: -1;
  }
{% endstylesheet %}

