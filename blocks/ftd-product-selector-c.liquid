{% comment %}
  Block: FTD - Product Selector C
  ----------------------------------------------------------------------
  Inline variant of the C selector. Renders the same wizard
  (Plan -> Products -> Upsells -> Cart) as the slide-over sibling
  (ftd-product-selector-c-slideover.liquid) but without any modal
  wrapper — drops straight into the page flow.

  Architecture: child theme blocks (_ftd-c-function, _ftd-c-bullet,
  _ftd-c-upsell) self-render their own markup with data-slot attrs.
  We render them via content_for 'blocks' into a hidden staging div,
  then JS moves each one into the right container on init.
{% endcomment %}

{%- liquid
  assign sid = block.id
  assign show_onetime   = block.settings.show_onetime
  assign show_monthly   = block.settings.show_monthly
  assign show_quarterly = block.settings.show_quarterly
  assign bundle_count   = block.settings.bundle_count | default: 3
  assign addon          = block.settings.addon_product
  assign addon_variant_id = ''
  if addon != blank and addon.selected_or_first_available_variant != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif
-%}

{{ 'ftdc.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign acc_monthly   = block.settings.monthly_accent_color   | default: '#1FA8A1'
  assign acc_quarterly = block.settings.quarterly_accent_color | default: '#E8833A'
  assign acc_onetime   = block.settings.onetime_accent_color   | default: '#8E8E93'
-%}

<style>
  /* Per-plan accent — mirrors Product Selector A's pattern:
     each plan card gets a colored top stripe, the SELECTED state stays
     universal (--ftdc-accent). Schema defaults match A's defaults. */
  #ftdc-{{ sid }} .ftdc__plan { border-top: 4px solid transparent; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="monthly"]   { border-top-color: {{ acc_monthly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="quarterly"] { border-top-color: {{ acc_quarterly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"]   { border-top-color: {{ acc_onetime }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="monthly"]   .ftdc__plan-badge { color: {{ acc_monthly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="quarterly"] .ftdc__plan-badge { color: {{ acc_quarterly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"]   .ftdc__plan-badge { color: {{ acc_onetime }}; }

  /* Optional static image to the left of the plan picker (Step 1 only).
     When set, Step 1 becomes a 2-col grid: image | plans. When blank,
     Step 1 stays a single block exactly like before (no wrapper changes). */
  {%- if block.settings.plan_image != blank -%}
  #ftdc-{{ sid }} .ftdc__step[data-step="plans"].is-active {
    display: grid;
    grid-template-columns: minmax(180px, 320px) 1fr;
    gap: 1.4rem;
    align-items: start;
  }
  #ftdc-{{ sid }} .ftdc__plans-image { position: sticky; top: 1rem; }
  #ftdc-{{ sid }} .ftdc__plans-image img { width: 100%; height: auto; display: block; border-radius: var(--ftdc-radius, 12px); object-fit: cover; }
  @media (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__step[data-step="plans"].is-active { grid-template-columns: 1fr; gap: 1rem; }
    #ftdc-{{ sid }} .ftdc__plans-image { position: static; }
    #ftdc-{{ sid }} .ftdc__plans-image img { max-height: 220px; }
  }
  {%- endif -%}
</style>

<section
  id="ftdc-{{ sid }}"
  class="ftdc color-{{ block.settings.color_scheme }}"
  data-section-id="{{ sid }}"
  style="--ftdc-accent: {{ block.settings.accent_color }}; --ftdc-radius: {{ block.settings.card_radius }}px; --ftdc-max-w: {{ block.settings.content_max_width }}px;"
  {{ block.shopify_attributes }}
>
  <div class="ftdc__inner">

    <header class="ftdc__header">
      {%- if block.settings.heading != blank -%}<h2 class="ftdc__heading">{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.description != blank -%}<div class="ftdc__desc">{{ block.settings.description }}</div>{%- endif -%}
      <ul class="ftdc__bullets list-unstyled" data-bullets hidden></ul>
    </header>

    <ol class="ftdc__steps" role="list" aria-label="Order steps">
      <li class="ftdc__step-pill is-active" data-step-pill="plans"><span class="ftdc__step-num">1</span><span class="ftdc__step-label">{{ block.settings.step_label_1 | default: 'Plan' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="products"><span class="ftdc__step-num">2</span><span class="ftdc__step-label">{{ block.settings.step_label_2 | default: 'Bundle' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="upsells"><span class="ftdc__step-num">3</span><span class="ftdc__step-label">{{ block.settings.step_label_3 | default: 'Boost' }}</span></li>
    </ol>

    {%- comment %} ───── STEP 1 — PLANS ───── {%- endcomment %}
    <div class="ftdc__step is-active" data-step="plans">
      {%- if block.settings.plan_image != blank -%}
        {%- assign _pimg = block.settings.plan_image -%}
        <div class="ftdc__plans-image">
          <img
            src="{{ _pimg | image_url: width: 800 }}"
            srcset="{{ _pimg | image_url: width: 400 }} 400w, {{ _pimg | image_url: width: 800 }} 800w, {{ _pimg | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 749px) 100vw, 320px"
            alt="{{ _pimg.alt | default: '' | escape }}"
            width="{{ _pimg.width }}"
            height="{{ _pimg.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
      <div class="ftdc__plans" data-plan-order="{{ block.settings.plan_order | default: 'quarterly,monthly,onetime' }}">
        {%- if show_quarterly -%}
          <label class="ftdc__plan is-active" data-plan="quarterly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="quarterly" checked>
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if block.settings.quarterly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.quarterly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ block.settings.quarterly_title | default: '3 Pouches Every 3 Months' }}</div>
            {%- if block.settings.quarterly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.quarterly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.quarterly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ block.settings.quarterly_period | default: '/ month' }}</span></div>
            {%- if block.settings.quarterly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.quarterly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_monthly -%}
          <label class="ftdc__plan" data-plan="monthly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="monthly">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if block.settings.monthly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.monthly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ block.settings.monthly_title | default: '1 Pouch Every Month' }}</div>
            {%- if block.settings.monthly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.monthly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.monthly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ block.settings.monthly_period | default: '/ month' }}</span></div>
            {%- if block.settings.monthly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.monthly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_onetime -%}
          <label class="ftdc__plan" data-plan="onetime">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="onetime">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if block.settings.onetime_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.onetime_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ block.settings.onetime_title | default: 'Single Pouch' }}</div>
            {%- if block.settings.onetime_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.onetime_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.onetime_price | default: '$59.00' }}</span><span class="ftdc__plan-period">{{ block.settings.onetime_period | default: '/ pouch' }}</span></div>
            {%- assign _ow = block.settings.onetime_was | strip -%}
            {%- if _ow != blank and _ow != '-' and _ow != '—' -%}<div class="ftdc__plan-was">{{ block.settings.onetime_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
      </div>{%- comment %} /.ftdc__plans {%- endcomment %}
    </div>

    {%- comment %} ───── STEP 2 — PRODUCTS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="products" hidden>
      <button class="ftdc__back" type="button" data-step-back="plans" aria-label="Back to plan"><span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}</button>
      <div class="ftdc__bundle-head">
        <p class="ftdc__bundle-eyebrow">{{ block.settings.bundle_label | default: 'Your Bundle' }}</p>
        <p class="ftdc__bundle-progress-text" data-progress-text>0 {{ block.settings.of_word | default: 'of' }} {{ bundle_count }} {{ block.settings.selected_word | default: 'selected' }}</p>
        <div class="ftdc__bundle-bar"><div class="ftdc__bundle-bar-fill" data-progress-fill style="width:0%"></div></div>
      </div>
      <div class="ftdc__empty" data-grid-empty hidden>
        <p><strong>No products configured yet.</strong></p>
        <p>In the theme editor sidebar, click each <em>Function</em> block inside this selector and pick a Shopify product. Each product variant will render as a selectable card here.</p>
      </div>
      <div class="ftdc__grid" data-grid></div>
    </div>

    {%- comment %} ───── STEP 3 — UPSELLS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="upsells" hidden>
      <button class="ftdc__back" type="button" data-step-back="products" aria-label="Back to bundle"><span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}</button>

      {%- comment %} Hardcoded "Creatine included free" indicator — only
      shown on quarterly. Title/desc/FREE label are not exposed in
      theme settings; image reuses the addon image so the merchant
      only manages one creatine asset. {%- endcomment %}
      {%- assign included_img = block.settings.addon_image | default: addon.featured_image -%}
      <div class="ftdc__upsell ftdc__upsell--included" data-creatine-included hidden aria-hidden="true">
        <div class="ftdc__upsell-media">
          {%- if included_img != blank -%}
            <img src="{{ included_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">
          {%- endif -%}
        </div>
        <div class="ftdc__upsell-body">
          <p class="ftdc__upsell-title">Creatine — Included</p>
          <p class="ftdc__upsell-desc">Free with your 3-month bundle.</p>
          <div class="ftdc__upsell-pricing">
            <span class="ftdc__upsell-price ftdc__upsell-price--free">FREE</span>
          </div>
        </div>
        <div class="ftdc__upsell-toggle">
          <span class="ftdc__included-check" aria-label="Included" role="img">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4 4 10-10" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </div>

      {%- if addon != blank -%}
        <div class="ftdc__upsell ftdc__upsell--creatine" data-upsell-creatine>
          <div class="ftdc__upsell-media">
            {%- assign addon_img = block.settings.addon_image | default: addon.featured_image -%}
            {%- if addon_img != blank -%}<img src="{{ addon_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">{%- endif -%}
          </div>
          <div class="ftdc__upsell-body">
            <p class="ftdc__upsell-title" data-creatine-title>{{ block.settings.addon_label_monthly | default: 'Add Creatine — 50% off' }}</p>
            <p class="ftdc__upsell-desc" data-creatine-desc>{{ block.settings.addon_desc_monthly | default: '' }}</p>
            <div class="ftdc__upsell-pricing">
              <span class="ftdc__upsell-price" data-creatine-price>{{ block.settings.addon_price_monthly | default: '$12.00' }}</span>
              {%- if block.settings.addon_was_monthly != blank -%}<s class="ftdc__upsell-was" data-creatine-was>{{ block.settings.addon_was_monthly }}</s>{%- endif -%}
            </div>
          </div>
          <div class="ftdc__upsell-toggle">
            <input type="checkbox" id="ftdc-cr-{{ sid }}" class="visually-hidden" data-creatine-input data-variant="{{ addon_variant_id }}" data-plan-monthly="{{ block.settings.addon_loop_plan_monthly }}" data-plan-quarterly-free="{{ block.settings.addon_loop_plan_quarterly_free }}" data-plan-quarterly-50off="{{ block.settings.addon_loop_plan_quarterly_50off }}" data-discount-onetime="{{ block.settings.addon_discount_code_onetime }}">
            <label for="ftdc-cr-{{ sid }}" class="ftdc__switch" aria-hidden="true"></label>
          </div>
        </div>
      {%- endif -%}

      <div class="ftdc__upsells" data-upsells></div>

      <div class="ftdc__step-actions">
        <button class="ftdc__btn ftdc__btn--ghost" type="button" data-step-back="products">{{ block.settings.add_more_label | default: 'Add More' }}</button>
        <button class="ftdc__btn ftdc__btn--primary" type="button" data-action="checkout">{{ block.settings.checkout_label | default: 'Checkout' }}</button>
      </div>
    </div>

    <div class="ftdc__bar" data-bar>
      <div class="ftdc__bar-summary">
        <span class="ftdc__bar-total"><strong>{{ block.settings.total_label | default: 'Total' }}:</strong> <span data-bar-total>$0.00</span></span>
        <span class="ftdc__bar-saved" data-bar-saved-wrap hidden>({{ block.settings.saved_word | default: 'Saved' }} <span data-bar-saved>$0.00</span>)</span>
      </div>
      <button class="ftdc__bar-action" type="button" data-action="next"><span data-bar-label>{{ block.settings.action_label_step1 | default: 'Continue' }}</span></button>
    </div>

  </div>

  {%- comment %} Hidden staging: child theme blocks render here, JS moves them. {%- endcomment %}
  <div style="display:none" data-ftdc-stage aria-hidden="true">{% content_for 'blocks' %}</div>
</section>


<script>
(function () {
  var SID = {{ block.id | json }};
  var root = document.getElementById('ftdc-' + SID);
  if (!root) return;
  var BUNDLE_COUNT = parseInt({{ bundle_count | json }}, 10) || 3;
  var STEPS_ORDER = ['plans', 'products', 'upsells'];
  var state = { step: 'plans', plan: 'quarterly', selections: {} };

  /* Loop bundle mode (quarterly only). When fully configured, the pouches
     are registered with Loop's Create Bundle Transaction API and the cart
     gets pouch lines stamped with one shared loopBundleGuid so the customer
     can edit the whole bundle in Loop's portal later. */
  var LOOP_BUNDLE = {
    enabled:           {{ block.settings.loop_bundle_enabled | json }},
    bundleId:          {{ block.settings.loop_bundle_id | default: '' | json }},
    bundleVariantId:   {{ block.settings.loop_bundle_variant_id | default: '' | json }},
    bundleDiscountId:  {{ block.settings.loop_bundle_discount_id | default: '' | json }},
    apiSellingPlanId:  {{ block.settings.loop_bundle_api_selling_plan_id | default: '' | json }},
    cartSellingPlanId: {{ block.settings.loop_bundle_selling_plan_id | default: '' | json }},
    bundleName:        {{ block.settings.loop_bundle_name | default: '' | json }},
    propKey:           {{ block.settings.loop_bundle_property_key | default: '_bundleId' | json }}
  };
  var LOOP_BUNDLE_ON = !!(LOOP_BUNDLE.enabled && LOOP_BUNDLE.bundleId && LOOP_BUNDLE.apiSellingPlanId);
  function $(s, c) { return (c || root).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || root).querySelectorAll(s)); }
  function fmtMoney(c) { return '$' + (Math.max(0, c) / 100).toFixed(2); }

  function sortStagedBlocks() {
    var stage = $('[data-ftdc-stage]');
    if (!stage) return;
    var bullets = $('[data-bullets]');
    var grid = $('[data-grid]');
    var upsells = $('[data-upsells]');
    var moved = { bullet: 0, fn: 0, fnPh: 0, up: 0 };
    $$('[data-slot="bullet"]', stage).forEach(function (n) { if (bullets) { bullets.appendChild(n); moved.bullet++; } });
    $$('[data-slot="function"]', stage).forEach(function (n) { if (grid) { grid.appendChild(n); moved.fn++; } });
    $$('[data-slot="function-placeholder"]', stage).forEach(function (n) { if (grid) { grid.appendChild(n); moved.fnPh++; } });
    $$('[data-slot="upsell"]', stage).forEach(function (n) { if (upsells) { upsells.appendChild(n); moved.up++; } });
    if (bullets) bullets.hidden = moved.bullet === 0;
    var gridEmpty = $('[data-grid-empty]');
    if (gridEmpty) gridEmpty.hidden = (moved.fn > 0);
  }
  sortStagedBlocks();

  var plansContainer = $('.ftdc__plans');
  if (plansContainer && plansContainer.dataset.planOrder) {
    plansContainer.dataset.planOrder.split(',').forEach(function (name) {
      var n = name.trim(); if (!n) return;
      var plan = plansContainer.querySelector('[data-plan="' + n + '"]');
      if (plan) plansContainer.appendChild(plan);
    });
  }
  var firstPlan = plansContainer ? plansContainer.querySelector('.ftdc__plan') : null;
  if (firstPlan) {
    $$('.ftdc__plan').forEach(function (p) { p.classList.remove('is-active'); var r = p.querySelector('input'); if (r) r.checked = false; });
    firstPlan.classList.add('is-active');
    var fr = firstPlan.querySelector('input'); if (fr) { fr.checked = true; state.plan = fr.value; }
  }

  function showStep(name) {
    state.step = name;
    var idx = STEPS_ORDER.indexOf(name);
    $$('.ftdc__step').forEach(function (s) { var m = s.dataset.step === name; s.hidden = !m; s.classList.toggle('is-active', m); });
    $$('.ftdc__step-pill').forEach(function (p) { var pi = STEPS_ORDER.indexOf(p.dataset.stepPill); p.classList.toggle('is-active', pi === idx); p.classList.toggle('is-done', pi < idx); });
    updateBar();
  }

  function updateCreatineIncluded() {
    var el = $('[data-creatine-included]');
    if (el) el.hidden = state.plan !== 'quarterly';
  }

  $$('input[name="ftdc-plan-' + SID + '"]').forEach(function (r) {
    r.addEventListener('change', function () {
      state.plan = r.value;
      $$('.ftdc__plan').forEach(function (p) { p.classList.remove('is-active'); });
      var l = r.closest('.ftdc__plan'); if (l) l.classList.add('is-active');
      state.selections = {};
      $$('.ftdc__card').forEach(reset);
      updateBar(); updateProgress(); updateCreatineIncluded();
    });
  });
  updateCreatineIncluded();

  function reset(c) {
    c.classList.remove('is-selected');
    var a = $('.ftdc__add', c), q = $('.ftdc__qty', c), i = $('.ftdc__qty-input', c);
    if (a) a.hidden = false; if (q) q.hidden = true; if (i) i.value = 0;
  }
  function setQty(c, n) {
    n = Math.max(0, Math.floor(n));
    if (state.plan === 'quarterly') {
      var others = totalQty() - (state.selections[c.dataset.variantId] ? state.selections[c.dataset.variantId].qty : 0);
      n = Math.min(n, Math.max(0, BUNDLE_COUNT - others));
    }
    var v = c.dataset.variantId, a = $('.ftdc__add', c), q = $('.ftdc__qty', c), i = $('.ftdc__qty-input', c);
    if (n === 0) {
      delete state.selections[v]; c.classList.remove('is-selected');
      if (a) a.hidden = false; if (q) q.hidden = true; if (i) i.value = 0;
    } else {
      state.selections[v] = { qty: n, variantId: v, fnId: c.dataset.fnId, fnLabel: c.dataset.fnLabel, flavorName: c.dataset.flavorName, planMonthly: c.dataset.planMonthly || '', planQuarterly: c.dataset.planQuarterly || '', price: parseInt(c.dataset.variantPrice, 10) || 0, compareAt: parseInt(c.dataset.variantCompare, 10) || 0 };
      c.classList.add('is-selected');
      if (a) a.hidden = true; if (q) q.hidden = false; if (i) i.value = n;
    }
    updateProgress(); updateBar();
  }

  $$('.ftdc__card[data-slot="function"]').forEach(function (c) {
    c.addEventListener('click', function (e) {
      var b = e.target.closest('[data-card-action]'); if (!b) return;
      var i = $('.ftdc__qty-input', c), cur = parseInt(i ? i.value : 0, 10) || 0;
      if (b.dataset.cardAction === 'add') setQty(c, 1);
      else if (b.dataset.cardAction === 'inc') setQty(c, cur + 1);
      else if (b.dataset.cardAction === 'dec') setQty(c, cur - 1);
    });
    var i = $('.ftdc__qty-input', c);
    if (i) i.addEventListener('change', function () { setQty(c, parseInt(i.value, 10) || 0); });
  });

  function totalQty() { var n = 0; Object.keys(state.selections).forEach(function (k) { n += state.selections[k].qty; }); return n; }
  function bundleSize() { return state.plan === 'quarterly' ? BUNDLE_COUNT : 0; }
  function updateProgress() {
    var n = totalQty(), s = bundleSize(), pt = $('[data-progress-text]'), pf = $('[data-progress-fill]');
    if (!pt || !pf) return;
    if (s) { pt.textContent = n + ' of ' + s + ' selected'; pf.style.width = Math.min(100, n / s * 100) + '%'; }
    else   { pt.textContent = n ? (n + ' selected') : 'Choose your pouches'; pf.style.width = n > 0 ? '100%' : '0%'; }
  }
  function compute() {
    var mu = ({{ block.settings.monthly_estimate_pct | default: 90 }} / 100);
    var qu = ({{ block.settings.quarterly_estimate_pct | default: 90 }} / 100);
    var mul = state.plan === 'monthly' ? mu : state.plan === 'quarterly' ? qu : 1;
    var t = 0, sa = 0;
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k]; var u = s.price * mul; t += u * s.qty;
      var c = s.compareAt > s.price ? s.compareAt : s.price;
      sa += Math.max(0, c - u) * s.qty;
    });
    return { total: Math.round(t), saved: Math.round(sa) };
  }
  function updateBar() {
    var t = compute(), bt = $('[data-bar-total]'), sw = $('[data-bar-saved-wrap]'), sv = $('[data-bar-saved]');
    if (bt) bt.textContent = fmtMoney(t.total);
    if (sw && sv) { if (t.saved > 0) { sw.hidden = false; sv.textContent = fmtMoney(t.saved); } else sw.hidden = true; }
    var lab = $('[data-bar-label]'), btn = $('.ftdc__bar-action'), r = canProc();
    if (state.step === 'plans') { if (lab) lab.textContent = 'Continue'; if (btn) btn.disabled = false; }
    else if (state.step === 'products') { if (lab) lab.textContent = 'Continue'; if (btn) btn.disabled = !r; }
    else { if (lab) lab.textContent = 'Checkout'; if (btn) btn.disabled = !r; }
  }
  function canProc() {
    if (state.step === 'plans') return !!state.plan;
    if (state.step === 'products') { var n = totalQty(), s = bundleSize(); return s ? n === s : n > 0; }
    return true;
  }

  $$('[data-step-back]').forEach(function (b) { b.addEventListener('click', function () { showStep(b.dataset.stepBack); }); });
  var actBtn = $('.ftdc__bar-action');
  if (actBtn) actBtn.addEventListener('click', function () {
    if (state.step === 'plans') showStep('products');
    else if (state.step === 'products') { if (canProc()) showStep('upsells'); }
    else doCheckout();
  });
  var coBtn = $('[data-action="checkout"]');
  if (coBtn) coBtn.addEventListener('click', doCheckout);

  function buildItems() {
    var items = [];
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k]; var it = { id: parseInt(s.variantId, 10), quantity: s.qty };
      if (state.plan === 'monthly') { var p = parseInt(s.planMonthly, 10); if (p) it.selling_plan = p; }
      else if (state.plan === 'quarterly') {
        var p = parseInt(s.planQuarterly, 10); if (p) it.selling_plan = p;
        /* Marked for Loop bundle grouping; stripped before /cart/add.js. */
        it._bundleable = true;
      }
      items.push(it);
    });
    var cr = $('[data-creatine-input]');
    if (cr && cr.checked) {
      var cv = parseInt(cr.dataset.variant, 10);
      if (cv) {
        var ci = { id: cv, quantity: 1 };
        if (state.plan === 'monthly') { var p = parseInt(cr.dataset.planMonthly, 10); if (p) ci.selling_plan = p; }
        else if (state.plan === 'quarterly') { var p = parseInt(cr.dataset.planQuarterlyFree, 10); if (p) ci.selling_plan = p; }
        else { ci.properties = { _upsell: 'creatine-onetime' }; }
        items.push(ci);
      }
    }
    return items;
  }

  /* Loop's bundle.loopwork.co returns { message, data: { loopBundleGuid } } */
  function extractBundleTxnId(b) {
    var pools = [b, b && b.data, b && b.transaction, b && b.data && b.data.transaction];
    for (var i = 0; i < pools.length; i++) {
      var p = pools[i]; if (!p || typeof p !== 'object') continue;
      var v = (p.data && (p.data.loopBundleGuid || p.data.txnId || p.data.id))
            || p.loopBundleGuid || p.txnId || p.transactionId || p.id;
      if (v) return v;
    }
    return null;
  }
  function loopBundleItems(items) {
    var picks = items.filter(function (it) { return it._bundleable; });
    var rest  = items.filter(function (it) { return !it._bundleable; });
    if (!picks.length) return Promise.resolve(items);
    var body = {
      bundleId:         parseInt(LOOP_BUNDLE.bundleId, 10),
      bundleVariantId:  parseInt(LOOP_BUNDLE.bundleVariantId, 10)  || null,
      bundleDiscountId: parseInt(LOOP_BUNDLE.bundleDiscountId, 10) || null,
      sellingPlanId:    parseInt(LOOP_BUNDLE.apiSellingPlanId, 10)
    };
    return fetch('https://bundle.loopwork.co/api/transactions/create', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) {
        if (!r.ok) throw new Error('Loop bundle API ' + r.status + ': ' + ((b && (b.message || b.error)) || ''));
        return b;
      }); })
      .then(function (b) {
        var txn = extractBundleTxnId(b);
        if (!txn) throw new Error('Loop response missing transaction id');
        var cartPlanId = parseInt(LOOP_BUNDLE.cartSellingPlanId, 10);
        var key = LOOP_BUNDLE.propKey || '_bundleId';
        picks.forEach(function (it) {
          it.properties = it.properties || {};
          it.properties[key] = String(txn);
          if (LOOP_BUNDLE.bundleName) it.properties.bundleName = LOOP_BUNDLE.bundleName;
          if (cartPlanId) it.selling_plan = cartPlanId;
        });
        return picks.concat(rest);
      });
  }

  function doCheckout() {
    if (!canProc()) return;
    var items = buildItems(); if (!items.length) return;
    if (actBtn) actBtn.disabled = true; if (coBtn) coBtn.disabled = true;
    var cr = $('[data-creatine-input]');
    var ot = state.plan === 'onetime' && cr && cr.checked;
    var d = ot ? (cr.dataset.discountOnetime || '') : '';

    function postCart(finalItems) {
      finalItems.forEach(function (it) { delete it._bundleable; });
      return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: finalItems }) })
        .then(function (r) { if (!r.ok) return r.json().then(function (b) { throw new Error((b && b.message) || 'Cart error'); }); return r.json(); })
        .then(function () { window.location.href = d ? ('/discount/' + encodeURIComponent(d) + '?redirect=/checkout') : '/checkout'; });
    }

    var run;
    if (LOOP_BUNDLE_ON && state.plan === 'quarterly') {
      run = loopBundleItems(items).then(postCart, function (err) {
        /* Loop unreachable or misconfigured: fall back to individual lines. */
        try { console.warn('[FTDC] Loop bundle failed, falling back. Error:', err); } catch (_) {}
        return postCart(items);
      });
    } else {
      run = postCart(items);
    }
    run.catch(function (e) { if (actBtn) actBtn.disabled = false; if (coBtn) coBtn.disabled = false; alert(e.message || 'Something went wrong'); });
  }

  showStep('plans'); updateProgress(); updateBar();
})();
</script>

