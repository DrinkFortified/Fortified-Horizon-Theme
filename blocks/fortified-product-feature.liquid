{% render 'fortified-base' %}

{%- liquid
  assign img = block.settings.image
  assign primary_label = block.settings.cta_primary_label
  assign primary_url = block.settings.cta_primary_url | default: '#'
  assign secondary_label = block.settings.cta_secondary_label
  assign secondary_url = block.settings.cta_secondary_url | default: '#'
  assign image_side = block.settings.image_side
-%}

<div
  class="fortified-product-feature fortified-product-feature--{{ image_side }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-product-feature__inner">
    <div class="fortified-product-feature__media">
      {% if img != blank %}
        {{ img | image_url: width: 1400 | image_tag:
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            class: 'fortified-product-feature__img',
            alt: img.alt | default: block.settings.heading,
            loading: 'lazy' }}
      {% else %}
        <div class="fortified-product-feature__placeholder">{{ 'product-1' | placeholder_svg_tag: 'fortified-product-feature__placeholder-svg' }}</div>
      {% endif %}
    </div>

    <div class="fortified-product-feature__copy">
      {% if block.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.body != blank %}
        <p class="fortified-body fortified-product-feature__body">{{ block.settings.body }}</p>
      {% endif %}
      {% if primary_label != blank or secondary_label != blank %}
        <div class="fortified-product-feature__ctas">
          {% if primary_label != blank %}
            <a href="{{ primary_url }}" class="fortified-btn fortified-btn--primary">{{ primary_label }}</a>
          {% endif %}
          {% if secondary_label != blank %}
            <a href="{{ secondary_url }}" class="fortified-btn fortified-btn--ghost">{{ secondary_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fortified-product-feature {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
    overflow: hidden;
  }
  .fortified-product-feature__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fortified-product-feature__inner { grid-template-columns: 1fr 1fr; }
    .fortified-product-feature--left .fortified-product-feature__inner { direction: rtl; }
    .fortified-product-feature--left .fortified-product-feature__inner > * { direction: ltr; }
  }
  .fortified-product-feature__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .fortified-product-feature__body { max-width: 52ch; margin: 4px 0 8px; }
  .fortified-product-feature__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .fortified-product-feature__media {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 280px;
  }
  .fortified-product-feature__img {
    width: 100%;
    height: auto;
    max-width: 640px;
    object-fit: contain;
    border-radius: 16px;
  }
  .fortified-product-feature__placeholder-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    color: var(--fortified-gray-light);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Product Feature",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FORMULATED FOR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CLEAN HYDRATION MAX PERFORMANCE" },
    { "type": "textarea", "id": "body", "label": "Body text" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "LEARN MORE" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified Product Feature", "category": "Fortified" }
  ]
}
{% endschema %}
