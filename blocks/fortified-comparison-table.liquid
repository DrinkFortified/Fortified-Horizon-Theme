{% render 'fortified-base' %}

{%- liquid
  assign brand_name = block.settings.brand_name | default: 'FORTIFIED'
  assign comp_1 = block.settings.competitor_1_name
  assign comp_2 = block.settings.competitor_2_name
  assign comp_3 = block.settings.competitor_3_name
-%}

<div
  class="fortified-comparison color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container">
    {% if block.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2 fortified-comparison__heading">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="fortified-comparison__wrap">
      <table class="fortified-comparison__table">
        <thead>
          <tr>
            <th></th>
            <th class="fortified-comparison__th fortified-comparison__th--ours">{{ brand_name }}</th>
            {% if comp_1 != blank %}<th class="fortified-comparison__th">{{ comp_1 }}</th>{% endif %}
            {% if comp_2 != blank %}<th class="fortified-comparison__th">{{ comp_2 }}</th>{% endif %}
            {% if comp_3 != blank %}<th class="fortified-comparison__th">{{ comp_3 }}</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for i in (1..8) %}
            {%- assign label_key = 'row_' | append: i | append: '_label' -%}
            {%- assign forti_key = 'row_' | append: i | append: '_fortified' -%}
            {%- assign c1_key = 'row_' | append: i | append: '_competitor_1' -%}
            {%- assign c2_key = 'row_' | append: i | append: '_competitor_2' -%}
            {%- assign c3_key = 'row_' | append: i | append: '_competitor_3' -%}
            {%- assign check_key = 'row_' | append: i | append: '_is_checkmark' -%}
            {%- assign label = block.settings[label_key] -%}
            {%- assign forti = block.settings[forti_key] -%}
            {%- assign c1 = block.settings[c1_key] -%}
            {%- assign c2 = block.settings[c2_key] -%}
            {%- assign c3 = block.settings[c3_key] -%}
            {%- assign is_check = block.settings[check_key] -%}
            {% if label != blank %}
              <tr>
                <th scope="row" class="fortified-comparison__row-label">{{ label }}</th>
                {% if is_check %}
                  <td class="fortified-comparison__td fortified-comparison__td--ours">{% if forti contains "yes" or forti == "✓" or forti == "true" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>
                  {% if comp_1 != blank %}<td class="fortified-comparison__td">{% if c1 contains "yes" or c1 == "✓" or c1 == "true" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                  {% if comp_2 != blank %}<td class="fortified-comparison__td">{% if c2 contains "yes" or c2 == "✓" or c2 == "true" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                  {% if comp_3 != blank %}<td class="fortified-comparison__td">{% if c3 contains "yes" or c3 == "✓" or c3 == "true" %}<span class="fortified-comparison__check">✓</span>{% else %}<span class="fortified-comparison__x">✗</span>{% endif %}</td>{% endif %}
                {% else %}
                  <td class="fortified-comparison__td fortified-comparison__td--ours">{{ forti }}</td>
                  {% if comp_1 != blank %}<td class="fortified-comparison__td">{{ c1 }}</td>{% endif %}
                  {% if comp_2 != blank %}<td class="fortified-comparison__td">{{ c2 }}</td>{% endif %}
                  {% if comp_3 != blank %}<td class="fortified-comparison__td">{{ c3 }}</td>{% endif %}
                {% endif %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if block.settings.cta_label != blank %}
      <div class="fortified-comparison__cta">
        <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .fortified-comparison {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-comparison__heading { text-align: center; margin-bottom: 32px; }
  .fortified-comparison__wrap { overflow-x: auto; }
  .fortified-comparison__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-fortified-body);
    min-width: 600px;
  }
  .fortified-comparison__th {
    padding: 14px 12px;
    text-align: center;
    font-family: var(--font-fortified-display);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--fortified-gray-light);
    color: var(--fortified-black);
    border-bottom: 2px solid var(--fortified-gray-light);
  }
  .fortified-comparison__th--ours { background: var(--fortified-teal); color: #fff; }
  .fortified-comparison__row-label {
    text-align: left;
    padding: 14px 12px;
    font-weight: 600;
    font-size: 14px;
    background: var(--fortified-off-white);
    border-bottom: 1px solid var(--fortified-gray-light);
  }
  .fortified-comparison__td {
    padding: 14px 12px;
    text-align: center;
    font-size: 14px;
    border-bottom: 1px solid var(--fortified-gray-light);
  }
  .fortified-comparison__td--ours {
    background: rgb(0 184 184 / .08);
    font-weight: 700;
    color: var(--fortified-teal);
  }
  .fortified-comparison__check { color: var(--fortified-teal); font-weight: 700; font-size: 18px; }
  .fortified-comparison__x { color: var(--fortified-gray-mid); font-size: 18px; }
  .fortified-comparison__cta {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }
{% endstylesheet %}

