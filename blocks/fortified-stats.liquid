{% render 'fortified-base' %}

<div
  class="fortified-stats color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-stats__inner">
    {% if block.settings.heading != blank or block.settings.eyebrow != blank %}
      <header class="fortified-stats__header">
        {% if block.settings.eyebrow != blank %}
          <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="fortified-stats__grid">
      {% for i in (1..4) %}
        {%- assign num_key = 'stat_' | append: i | append: '_number' -%}
        {%- assign label_key = 'stat_' | append: i | append: '_label' -%}
        {%- assign caption_key = 'stat_' | append: i | append: '_caption' -%}
        {%- assign num = block.settings[num_key] -%}
        {%- assign label = block.settings[label_key] -%}
        {%- assign caption = block.settings[caption_key] -%}
        {% if num != blank or label != blank %}
          <div class="fortified-stats__card">
            {% if num != blank %}
              <div class="fortified-stats__number">{{ num }}</div>
            {% endif %}
            {% if label != blank %}
              <div class="fortified-stats__label">{{ label }}</div>
            {% endif %}
            {% if caption != blank %}
              <p class="fortified-stats__caption">{{ caption }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.cta_label != blank %}
      <div class="fortified-stats__cta">
        <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .fortified-stats {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-stats__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(28px, 4vw, 48px);
  }
  .fortified-stats__header { text-align: center; max-width: 760px; }
  .fortified-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 28px);
    width: 100%;
  }
  @media (min-width: 750px) {
    .fortified-stats__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .fortified-stats__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .fortified-stats__card {
    background: var(--fortified-off-white);
    border-radius: 16px;
    padding: clamp(20px, 2.5vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .fortified-stats__number {
    font-family: var(--font-fortified-display);
    font-size: clamp(40px, 5vw, 64px);
    color: var(--fortified-teal);
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .fortified-stats__label {
    font-family: var(--font-fortified-display);
    font-size: clamp(18px, 2vw, 24px);
    text-transform: uppercase;
    line-height: 1.1;
  }
  .fortified-stats__caption { margin: 0; font-size: 14px; line-height: 1.5; opacity: .8; }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Stats",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "WHY WE BEAT THE REST" },
    { "type": "header", "content": "Stat 1" },
    { "type": "text", "id": "stat_1_number", "label": "Number", "default": "2.3x" },
    { "type": "text", "id": "stat_1_label", "label": "Label", "default": "Better Hydration" },
    { "type": "text", "id": "stat_1_caption", "label": "Caption" },
    { "type": "header", "content": "Stat 2" },
    { "type": "text", "id": "stat_2_number", "label": "Number", "default": "+24%" },
    { "type": "text", "id": "stat_2_label", "label": "Label", "default": "Improved Endurance" },
    { "type": "text", "id": "stat_2_caption", "label": "Caption" },
    { "type": "header", "content": "Stat 3" },
    { "type": "text", "id": "stat_3_number", "label": "Number", "default": "0g" },
    { "type": "text", "id": "stat_3_label", "label": "Label", "default": "Added Sugar" },
    { "type": "text", "id": "stat_3_caption", "label": "Caption" },
    { "type": "header", "content": "Stat 4" },
    { "type": "text", "id": "stat_4_number", "label": "Number" },
    { "type": "text", "id": "stat_4_label", "label": "Label" },
    { "type": "text", "id": "stat_4_caption", "label": "Caption" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified Stats", "category": "Fortified" }
  ]
}
{% endschema %}
