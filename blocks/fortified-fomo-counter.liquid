{% comment %}
  Block: FTD - FOMO Counter
  Category: Fortified Blocks
  ----------------------------------------------------------------------
  Standalone "spots remaining" counter for a limited-time subscription
  perk. Shows an active state ("Only 247 of 1,000 left") with an optional
  progress bar; flips to an exhausted state ("All 1,000 claimed") once
  the count hits the cap.

  This is the BLOCK twin of sections/fortified-fomo-counter.liquid.
  Keep both in sync.

  Source of truth for the claimed count:
    1. If `metafield_namespace` AND `metafield_key` are set AND the shop
       metafield resolves to a number, that is used.
    2. Otherwise the merchant-supplied "claimed" count from the editor is
       used. Because Shopify range settings cap at ~101 steps, the
       editable count is split into a thousands slider (0-5) and a units
       slider (0-990, step 10); the two are summed.
{% endcomment %}

{%- liquid
  assign bid  = block.id | replace: '_', '' | downcase
  assign root = 'ftfomo-' | append: bid

  assign total = block.settings.total_spots | default: 1000

  # Resolve claimed count: metafield override, else merchant setting split.
  assign claimed = 0
  assign mf_ns  = block.settings.metafield_namespace | strip
  assign mf_key = block.settings.metafield_key | strip
  assign mf_resolved = false
  if mf_ns != blank and mf_key != blank
    assign mf_obj = shop.metafields[mf_ns][mf_key]
    if mf_obj != blank
      assign mf_num = mf_obj.value | plus: 0
      assign claimed = mf_num
      assign mf_resolved = true
    endif
  endif
  unless mf_resolved
    assign thousands = block.settings.claimed_count_thousands | default: 0
    assign units     = block.settings.claimed_count_units | default: 0
    assign claimed   = thousands | times: 1000 | plus: units
  endunless

  if claimed < 0
    assign claimed = 0
  endif
  if claimed > total
    assign claimed = total
  endif

  assign remaining = total | minus: claimed | at_least: 0
  assign is_exhausted = false
  if remaining == 0
    assign is_exhausted = true
  endif

  assign fill_pct = 0
  if total > 0
    assign fill_pct = claimed | times: 100 | divided_by: total | at_most: 100
  endif

  # ---- Format numbers with comma thousands separators ----
  capture remaining_fmt
    assign n_str = remaining | append: ''
    assign n_size = n_str | size
    assign acc = ''
    for i in (1..n_size)
      assign idx = n_size | minus: i
      assign ch = n_str | slice: idx, 1
      assign acc = ch | append: acc
      assign mod = i | modulo: 3
      if mod == 0 and i != n_size
        assign acc = ',' | append: acc
      endif
    endfor
    echo acc
  endcapture
  assign remaining_fmt = remaining_fmt | strip

  capture total_fmt
    assign n_str = total | append: ''
    assign n_size = n_str | size
    assign acc = ''
    for i in (1..n_size)
      assign idx = n_size | minus: i
      assign ch = n_str | slice: idx, 1
      assign acc = ch | append: acc
      assign mod = i | modulo: 3
      if mod == 0 and i != n_size
        assign acc = ',' | append: acc
      endif
    endfor
    echo acc
  endcapture
  assign total_fmt = total_fmt | strip

  # ---- Pick + populate the active/exhausted template ----
  if is_exhausted
    assign tpl = block.settings.exhausted_template
    assign sub_text = block.settings.exhausted_sub
  else
    assign tpl = block.settings.active_template
    assign sub_text = block.settings.active_sub
  endif
  assign line = tpl | replace: '{remaining}', remaining_fmt | replace: '{total}', total_fmt

  # ---- Markdown bold (**text**) -> <strong>text</strong> ----
  capture rendered_line
    assign parts = line | split: '**'
    for part in parts
      if forloop.index0 == 0
        echo part
      else
        assign mod = forloop.index0 | modulo: 2
        if mod == 1
          echo '<strong>'
          echo part
        else
          echo '</strong>'
          echo part
        endif
      endif
    endfor
    assign parts_len = parts | size
    assign parts_last = parts_len | minus: 1
    assign last_mod = parts_last | modulo: 2
    if last_mod == 1 and parts_len > 1
      echo '</strong>'
    endif
  endcapture

  assign eyebrow_c = block.settings.eyebrow_color | default: '#1FA8A1'
  assign bar_active_c = block.settings.bar_active_color | default: '#E8833A'
  assign bar_exhausted_c = block.settings.bar_exhausted_color | default: '#9CA3AF'
  assign bar_track_c = block.settings.bar_track_color | default: '#EFEAE3'
-%}

<style>
  #{{ root }} {
    --ftfomo-max-w: {{ block.settings.content_max_width }}px;
    --ftfomo-eyebrow: {{ eyebrow_c }};
    --ftfomo-bar-active: {{ bar_active_c }};
    --ftfomo-bar-exhausted: {{ bar_exhausted_c }};
    --ftfomo-bar-track: {{ bar_track_c }};
    --ftfomo-bar-height: {{ block.settings.bar_height }}px;
    --ftfomo-align: {{ block.settings.text_align }};
    background: var(--color-background);
    color: var(--color-foreground);
    padding-block-start: {{ block.settings.padding-block-start }}px;
    padding-block-end: {{ block.settings.padding-block-end }}px;
    width: 100%;
  }
  #{{ root }} .ftfomo__inner {
    max-width: var(--ftfomo-max-w, 720px);
    margin: 0 auto;
    text-align: var(--ftfomo-align, center);
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-inline: 20px;
    box-sizing: border-box;
  }
  #{{ root }} .ftfomo__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ftfomo-eyebrow);
  }
  #{{ root }} .ftfomo__desc { margin: 0 0 18px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.5; opacity: 0.85; }
  #{{ root }} .ftfomo__line {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(18px, 2.4vw, 30px);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-foreground-heading, var(--color-foreground));
  }
  #{{ root }} .ftfomo__line strong {
    color: var(--ftfomo-bar-active);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  #{{ root }}.ftfomo--exhausted .ftfomo__line strong {
    color: var(--ftfomo-bar-exhausted);
  }
  #{{ root }} .ftfomo__bar {
    width: 100%;
    height: var(--ftfomo-bar-height, 10px);
    background: var(--ftfomo-bar-track);
    border-radius: 999px;
    overflow: hidden;
  }
  #{{ root }} .ftfomo__bar-fill {
    display: block;
    height: 100%;
    background: var(--ftfomo-bar-active);
    border-radius: 999px;
    transition: width 0.8s ease;
  }
  #{{ root }}.ftfomo--exhausted .ftfomo__bar-fill {
    background: var(--ftfomo-bar-exhausted);
  }
  #{{ root }} .ftfomo__sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground);
    opacity: 0.9;
  }
  {{ block.settings.custom_css }}
</style>

<div
  id="{{ root }}"
  class="ftfomo color-{{ block.settings.color_scheme }}{% if is_exhausted %} ftfomo--exhausted{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="ftfomo__inner">
    {%- if block.settings.eyebrow != blank -%}
      <p class="ftfomo__eyebrow">{{ block.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if block.settings.description != blank -%}
      <p class="ftfomo__desc">{{ block.settings.description }}</p>
    {%- endif -%}

    <p class="ftfomo__line">{{ rendered_line }}</p>

    {%- if block.settings.show_progress_bar -%}
      <div class="ftfomo__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fill_pct }}">
        <span class="ftfomo__bar-fill" style="width: {{ fill_pct }}%;"></span>
      </div>
    {%- endif -%}

    {%- if sub_text != blank -%}
      <p class="ftfomo__sub">{{ sub_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Block - FOMO Counter",
  "settings": [
    {
      "type": "header",
      "content": "Counter source"
    },
    {
      "type": "paragraph",
      "content": "The editable claimed count is split into a thousands slider (0-5) and a units slider (0-990, step 10) — added together to form the count. This works around Shopify's range step ceiling."
    },
    {
      "type": "range",
      "id": "total_spots",
      "label": "Total spots",
      "min": 100,
      "max": 5000,
      "step": 50,
      "default": 1000
    },
    {
      "type": "range",
      "id": "claimed_count_thousands",
      "label": "Claimed (thousands)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "claimed_count_units",
      "label": "Claimed (units, step 10)",
      "min": 0,
      "max": 990,
      "step": 10,
      "default": 750
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace (optional)"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key (optional)"
    },
    {
      "type": "paragraph",
      "content": "If both namespace and key are filled, the counter reads `shop.metafields[namespace][key]` as the claimed count. Otherwise it uses the manual setting above. Use Shopify Flow to bump the metafield on each qualifying order."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE TRUTH"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Optional. Sits between the eyebrow and the spots-left line.",
      "default": "First 1,000 Quarterly Plan Subscribers get a free creatine for the lifetime of their subscription."
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#1FA8A1"
    },
    {
      "type": "textarea",
      "id": "active_template",
      "label": "Active line",
      "default": "Only **{remaining}** of **{total}** subscription spots left",
      "info": "Use {remaining} and {total} tokens. Wrap **text** in double asterisks to bold."
    },
    {
      "type": "text",
      "id": "active_sub",
      "label": "Active subline",
      "default": "Lock in your free creatine while spots last."
    },
    {
      "type": "textarea",
      "id": "exhausted_template",
      "label": "Exhausted line",
      "default": "All **{total}** subscription spots claimed."
    },
    {
      "type": "text",
      "id": "exhausted_sub",
      "label": "Exhausted subline",
      "default": "Yours still ships as a one-time gift."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bar_active_color",
      "label": "Bar (active)",
      "default": "#E8833A"
    },
    {
      "type": "color",
      "id": "bar_exhausted_color",
      "label": "Bar (exhausted)",
      "default": "#9CA3AF"
    },
    {
      "type": "color",
      "id": "bar_track_color",
      "label": "Bar track",
      "default": "#EFEAE3"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:content.advanced"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Targets this block."
    }
  ],
  "presets": [
    {
      "name": "Block - FOMO Counter",
      "category": "Fortified"
    }
  ]
}
{% endschema %}
