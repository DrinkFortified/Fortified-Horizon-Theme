{% doc %}
  @prompt
    Create a "Water is Dead" marketing section with the following layout and features:
    
    **Content (left side):**
    - Large heading: "Water is Dead" with an underline/strikethrough accent on "Dead"
    - Subtitle text: "Stop diluting yourself and start hydrating with real minerals"
    - Four stat rows with dotted dividers between them:
      1. "500x More Electrolytes" with subtext "Than a bottle of spring water."
      2. "0 Sugar" with subtext "Sweetened with Monk Fruit & OnonSweet®"
      3. "1,550mg Total Electrolytes" with subtext "Bring Water Back to Life"
      4. "3 Essential Electrolytes" with subtext "Sodium, Potassium, and Magnesium"
    
    **Visual (right side):**
    - A bar chart comparing two bars: "Spring Water" (very short bar) vs "Fortified" (tall bar reaching ~500%)
    - Y-axis labels: 100%, 200%, 300%, 400%, 500%
    - A "+500%" label above the Fortified bar
    - The Fortified bar label styled with a pill/badge shape in an accent color
    
    **Personalization options (theme settings):**
    - Color scheme selector (background color, heading color, body text color, accent/highlight color, bar chart colors)
    - Font size controls for the heading and stats
    - Toggle to show/hide the underline accent on "Dead"
    - Editable heading text
    - Editable subtitle text
    - Each stat: editable number/value, editable label, editable subtext
    - Toggle to show/hide each stat row
    - Bar chart: editable labels for both bars, editable percentage value for the tall bar
    - Toggle to show/hide the bar chart
    - Section padding controls (top/bottom)
    
    **Animations:**
    - Stats count up from 0 when scrolled into view
    - The tall bar animates growing upward on scroll into view
    - Fade-in animation for the heading and subtitle
    - Staggered fade-in for each stat row
    
    Make it fully responsive and visually polished with a clean, minimal aesthetic matching the off-white/cream background style shown., make it mobile friendly, heading text part 2 is underlined not crossed, give me text customization in the text fields and allow me to move the graph from bottom to top and viceversa on mobile, Make the heading one fully featured text field with all editing features
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-water-dead-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-water-dead-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-water-dead-content-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-water-dead-content-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} {
    animation: ai-fade-in-{{ ai_gen_id }} 0.8s ease-out forwards;
  }

  .ai-water-dead-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.1;
    font-weight: 700;
  }

  .ai-water-dead-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.body_text_color }};
    margin: 0 0 40px;
    line-height: 1.5;
  }

  .ai-water-dead-stats-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ai-water-dead-stat-{{ ai_gen_id }} {
    padding: 24px 0;
    border-bottom: 2px dotted {{ block.settings.divider_color }};
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-water-dead-stat-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-water-dead-stat-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} {
    animation: ai-fade-in-{{ ai_gen_id }} 0.6s ease-out forwards;
  }

  .ai-water-dead-stat-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ai-water-dead-stat-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_subtext_size }}px;
    color: {{ block.settings.body_text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-water-dead-chart-{{ ai_gen_id }} {
    position: relative;
    height: 500px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 80px;
    padding: 60px 40px 40px;
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-water-dead-chart-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} {
    animation: ai-fade-in-{{ ai_gen_id }} 0.8s ease-out 0.3s forwards;
  }

  .ai-water-dead-y-axis-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 60px;
    bottom: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 12px;
    color: {{ block.settings.body_text_color }};
  }

  .ai-water-dead-bar-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .ai-water-dead-bar-container-{{ ai_gen_id }} {
    width: 100px;
    height: 400px;
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .ai-water-dead-bar-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.bar_color_1 }};
    border-radius: 8px 8px 0 0;
    position: relative;
    transform-origin: bottom;
    height: 0;
  }

  .ai-water-dead-bar-{{ ai_gen_id }}.ai-bar-animated-{{ ai_gen_id }} {
    animation: ai-bar-grow-{{ ai_gen_id }} 1.5s ease-out 0.5s forwards;
  }

  .ai-water-dead-bar-tall-{{ ai_gen_id }} {
    background-color: {{ block.settings.bar_color_2 }};
  }

  .ai-water-dead-bar-label-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    text-align: center;
  }

  .ai-water-dead-bar-label-pill-{{ ai_gen_id }} {
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.pill_text_color }};
    padding: 8px 20px;
    border-radius: 20px;
    display: inline-block;
  }

  .ai-water-dead-percentage-badge-{{ ai_gen_id }} {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 24px;
    font-weight: 700;
    color: {{ block.settings.accent_color }};
    opacity: 0;
  }

  .ai-water-dead-percentage-badge-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} {
    animation: ai-fade-in-{{ ai_gen_id }} 0.5s ease-out 1.8s forwards;
  }

  @keyframes ai-fade-in-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ai-bar-grow-{{ ai_gen_id }} {
    to {
      height: var(--ai-bar-height-{{ ai_gen_id }});
    }
  }

  @media screen and (max-width: 768px) {
    .ai-water-dead-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-water-dead-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    {% if block.settings.mobile_chart_position == 'top' %}
      .ai-water-dead-chart-{{ ai_gen_id }} {
        order: -1;
      }
    {% endif %}

    .ai-water-dead-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      margin-bottom: 16px;
    }

    .ai-water-dead-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
      margin-bottom: 32px;
    }

    .ai-water-dead-stat-{{ ai_gen_id }} {
      padding: 20px 0;
    }

    .ai-water-dead-stat-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_size_mobile }}px;
      margin-bottom: 6px;
    }

    .ai-water-dead-stat-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_subtext_size_mobile }}px;
    }

    .ai-water-dead-chart-{{ ai_gen_id }} {
      height: 350px;
      gap: 50px;
      padding: 50px 30px 30px;
    }

    .ai-water-dead-y-axis-{{ ai_gen_id }} {
      left: 0;
      top: 50px;
      bottom: 30px;
      font-size: 10px;
    }

    .ai-water-dead-bar-container-{{ ai_gen_id }} {
      width: 70px;
      height: 270px;
    }

    .ai-water-dead-bar-label-{{ ai_gen_id }} {
      font-size: 13px;
    }

    .ai-water-dead-bar-label-pill-{{ ai_gen_id }} {
      padding: 6px 14px;
      font-size: 13px;
    }

    .ai-water-dead-percentage-badge-{{ ai_gen_id }} {
      font-size: 18px;
      top: -35px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-water-dead-chart-{{ ai_gen_id }} {
      gap: 35px;
      padding: 45px 20px 25px;
    }

    .ai-water-dead-bar-container-{{ ai_gen_id }} {
      width: 60px;
    }

    .ai-water-dead-bar-label-{{ ai_gen_id }} {
      font-size: 12px;
    }

    .ai-water-dead-bar-label-pill-{{ ai_gen_id }} {
      padding: 5px 12px;
      font-size: 12px;
    }
  }
{% endstyle %}

<water-dead-section-{{ ai_gen_id }} class="ai-water-dead-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
