</water-dead-section-{{ ai_gen_id }}>

<script>
  (function() {
    class WaterDeadSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animated = false;
        this.countUpElements = [];
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.2
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !this.animated) {
              this.animated = true;
              this.animateElements();
            }
          });
        }, options);

        observer.observe(this);
      }

      animateElements() {
        const animateElements = this.querySelectorAll('[data-animate]');
        animateElements.forEach((el, index) => {
          const delay = parseFloat(el.dataset.delay || 0);
          setTimeout(() => {
            el.classList.add('ai-animated-{{ ai_gen_id }}');
          }, delay * 1000);
        });

        const bars = this.querySelectorAll('[data-bar]');
        bars.forEach(bar => {
          setTimeout(() => {
            bar.classList.add('ai-bar-animated-{{ ai_gen_id }}');
          }, 500);
        });

        const badge = this.querySelector('[data-badge]');
        if (badge) {
          setTimeout(() => {
            badge.classList.add('ai-animated-{{ ai_gen_id }}');
          }, 1800);
        }

        const countUpElements = this.querySelectorAll('[data-count-up]');
        countUpElements.forEach(el => {
          const delay = parseFloat(el.closest('[data-delay]')?.dataset.delay || 0);
          setTimeout(() => {
            this.animateCountUp(el);
          }, delay * 1000 + 100);
        });
      }

      animateCountUp(element) {
        const target = parseInt(element.dataset.target);
        const duration = 1500;
        const startTime = performance.now();
        const suffix = element.textContent.replace(/[0-9]/g, '');

        const animate = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          
          const easeOutQuart = 1 - Math.pow(1 - progress, 4);
          const current = Math.floor(easeOutQuart * target);
          
          element.textContent = current + suffix;

          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            element.textContent = target + suffix;
          }
        };

        requestAnimationFrame(animate);
      }
    }

    customElements.define('water-dead-section-{{ ai_gen_id }}', WaterDeadSection{{ ai_gen_id }});
  })();
</script>

