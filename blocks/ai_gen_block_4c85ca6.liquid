{% doc %}
  @prompt
    I want to generate horizontal bar chart that is animated , allow me to change the color for each bar
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bar-chart-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-bar-chart__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-bar-chart__bars-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.bar_gap }}px;
  }

  .ai-bar-chart__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-bar-chart__label-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ai-bar-chart__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-bar-chart__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.value_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-bar-chart__bar-container-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.bar_height }}px;
    background-color: {{ block.settings.bar_background_color }};
    border-radius: {{ block.settings.bar_border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-bar-chart__bar-fill-{{ ai_gen_id }} {
    height: 100%;
    border-radius: {{ block.settings.bar_border_radius }}px;
    width: 0;
    transition: width {{ block.settings.animation_duration }}s ease-out;
  }

  .ai-bar-chart__bar-fill-{{ ai_gen_id }}.animated {
    width: var(--bar-width);
  }

  @media screen and (max-width: 749px) {
    .ai-bar-chart-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<horizontal-bar-chart-{{ ai_gen_id }}
  class="ai-bar-chart-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h3 class="ai-bar-chart__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  {% endif %}

  <div class="ai-bar-chart__bars-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign label_key = 'bar_' | append: i | append: '_label'
        assign value_key = 'bar_' | append: i | append: '_value'
        assign color_key = 'bar_' | append: i | append: '_color'
        assign label = block.settings[label_key]
        assign value = block.settings[value_key]
        assign color = block.settings[color_key]
      %}

      {% if label != blank and value > 0 %}
        <div class="ai-bar-chart__item-{{ ai_gen_id }}">
          <div class="ai-bar-chart__label-row-{{ ai_gen_id }}">
            <span class="ai-bar-chart__label-{{ ai_gen_id }}">{{ label }}</span>
            {% if block.settings.show_values %}
              <span class="ai-bar-chart__value-{{ ai_gen_id }}">{{ value }}{{ block.settings.value_suffix }}</span>
            {% endif %}
          </div>
          <div class="ai-bar-chart__bar-container-{{ ai_gen_id }}">
            <div
              class="ai-bar-chart__bar-fill-{{ ai_gen_id }}"
              style="--bar-width: {{ value }}%; background-color: {{ color }};"
              data-value="{{ value }}"
            ></div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</horizontal-bar-chart-{{ ai_gen_id }}>

<script>
  (function() {
    class HorizontalBarChart{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animated = false;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !this.animated) {
              this.animateBars();
              this.animated = true;
            }
          });
        }, options);

        observer.observe(this);
      }

      animateBars() {
        const bars = this.querySelectorAll('.ai-bar-chart__bar-fill-{{ ai_gen_id }}');
        bars.forEach((bar, index) => {
          setTimeout(() => {
            bar.classList.add('animated');
          }, index * {{ block.settings.stagger_delay }});
        });
      }
    }

    customElements.define('horizontal-bar-chart-{{ ai_gen_id }}', HorizontalBarChart{{ ai_gen_id }});
  })();
</script>

