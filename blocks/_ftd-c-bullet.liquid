{%- comment -%}
  Self-rendering bullet point. JS in the parent section moves it
  from the hidden staging area into the .ftdc__bullets list on init.
{%- endcomment -%}
<li class="ftdc__bullet" data-slot="bullet" {{ block.shopify_attributes }}>
  <span class="ftdc__bullet-dot" aria-hidden="true"></span>
  <span class="ftdc__bullet-text">{{ block.settings.text }}</span>
</li>

{% schema %}
{
  "name": "Bullet point",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Real Fruit Organic Flavors"
    }
  ]
}
{% endschema %}
