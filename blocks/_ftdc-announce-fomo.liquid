{%- comment -%}
  Self-rendering slim FOMO-counter announcement bar for FTD Product
  Selector C. Parent wizard JS moves it from staging into .ftdc__announce.

  Claimed-count source: optional shop metafield wins, otherwise the
  thousands+units sliders combine (Shopify range steps cap at ~101).
{%- endcomment -%}
{%- liquid
  assign total = block.settings.total_spots | default: 1000

  assign claimed = 0
  assign mf_ns  = block.settings.metafield_namespace | strip
  assign mf_key = block.settings.metafield_key | strip
  assign mf_resolved = false
  if mf_ns != blank and mf_key != blank
    assign mf_obj = shop.metafields[mf_ns][mf_key]
    if mf_obj != blank
      assign claimed = mf_obj.value | plus: 0
      assign mf_resolved = true
    endif
  endif
  unless mf_resolved
    assign thousands = block.settings.claimed_count_thousands | default: 0
    assign units     = block.settings.claimed_count_units | default: 0
    assign claimed   = thousands | times: 1000 | plus: units
  endunless
  if claimed < 0
    assign claimed = 0
  endif
  if claimed > total
    assign claimed = total
  endif

  assign remaining = total | minus: claimed | at_least: 0
  assign is_exhausted = false
  if remaining == 0
    assign is_exhausted = true
  endif
  assign fill_pct = 0
  if total > 0
    assign fill_pct = claimed | times: 100 | divided_by: total | at_most: 100
  endif

  # Comma-format helper inlined (Liquid has no built-in)
  capture rem_fmt
    assign n_str = remaining | append: ''
    assign n_size = n_str | size
    assign acc = ''
    for i in (1..n_size)
      assign idx = n_size | minus: i
      assign ch = n_str | slice: idx, 1
      assign acc = ch | append: acc
      assign mod = i | modulo: 3
      if mod == 0 and i != n_size
        assign acc = ',' | append: acc
      endif
    endfor
    echo acc
  endcapture
  assign rem_fmt = rem_fmt | strip

  capture tot_fmt
    assign n_str = total | append: ''
    assign n_size = n_str | size
    assign acc = ''
    for i in (1..n_size)
      assign idx = n_size | minus: i
      assign ch = n_str | slice: idx, 1
      assign acc = ch | append: acc
      assign mod = i | modulo: 3
      if mod == 0 and i != n_size
        assign acc = ',' | append: acc
      endif
    endfor
    echo acc
  endcapture
  assign tot_fmt = tot_fmt | strip

  if is_exhausted
    assign tpl = block.settings.exhausted_template
  else
    assign tpl = block.settings.active_template
  endif
  assign line = tpl | replace: '{remaining}', rem_fmt | replace: '{total}', tot_fmt
  assign bar_color = block.settings.bar_active_color | default: '#E8833A'
  if is_exhausted
    assign bar_color = block.settings.bar_exhausted_color | default: '#9CA3AF'
  endif
  assign bg = block.settings.bg | default: '#0A0A0A'
  assign fg = block.settings.fg | default: '#FFFFFF'
-%}
<div class="ftdc__announce-bar ftdc__announce-bar--fomo{% if is_exhausted %} is-exhausted{% endif %}" data-slot="announce"
     style="background:{{ bg }}; color:{{ fg }};"
     {{ block.shopify_attributes }}>
  <div class="ftdc__announce-fomo-row">
    <span class="ftdc__announce-fomo-line">{{ line | replace: '**', '§§' | replace_first: '§§', '<strong>' | replace_first: '§§', '</strong>' | replace_first: '§§', '<strong>' | replace_first: '§§', '</strong>' }}</span>
  </div>
  {%- if block.settings.show_progress_bar -%}
    <div class="ftdc__announce-fomo-bar" style="--ftdc-fomo-track:{{ block.settings.bar_track_color | default: 'rgba(255,255,255,0.18)' }}; --ftdc-fomo-fill:{{ bar_color }}; --ftdc-fomo-h:{{ block.settings.bar_height | default: 6 }}px;" aria-hidden="true">
      <div class="ftdc__announce-fomo-bar-fill" style="width:{{ fill_pct }}%;"></div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announce — FOMO Counter",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Counter source"
    },
    {
      "type": "paragraph",
      "content": "Shopify range steps cap around 101 ticks, so the claimed count is split into a thousands slider and a units slider that are added together."
    },
    {
      "type": "range",
      "id": "total_spots",
      "label": "Total spots",
      "min": 100,
      "max": 5000,
      "step": 50,
      "default": 1000
    },
    {
      "type": "range",
      "id": "claimed_count_thousands",
      "label": "Claimed (thousands)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "claimed_count_units",
      "label": "Claimed (units, step 10)",
      "min": 0,
      "max": 990,
      "step": 10,
      "default": 0
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace (optional)"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key (optional)",
      "info": "If both are filled, shop.metafields[namespace][key] wins over the sliders."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "textarea",
      "id": "active_template",
      "label": "Active line",
      "default": "Only **{remaining}** of **{total}** subscription spots left",
      "info": "Tokens: {remaining} {total}. Wrap **text** to bold."
    },
    {
      "type": "textarea",
      "id": "exhausted_template",
      "label": "Exhausted line",
      "default": "All **{total}** subscription spots claimed."
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bar_active_color",
      "label": "Bar (active)",
      "default": "#E8833A"
    },
    {
      "type": "color",
      "id": "bar_exhausted_color",
      "label": "Bar (exhausted)",
      "default": "#9CA3AF"
    },
    {
      "type": "color",
      "id": "bar_track_color",
      "label": "Bar track",
      "default": "rgba(255,255,255,0.18)"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 4,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
