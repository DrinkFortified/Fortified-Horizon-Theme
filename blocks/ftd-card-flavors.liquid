{%- comment -%}
  Flavour picker for a product card.

  Horizon's own Swatches block would do this, but it only renders when
  option_value.swatch exists, and Shopify fills that in solely for
  metafield-linked product options. Linking the Flavor option would mean a
  product-data migration on live products that carry Loop and Timesact selling
  plans, so this block does the same job from data the products already have:
  every flavour here has its own pack shot attached to its variant.

  Scope is deliberately narrow. One option, more than one variant — the
  flavour case. With two or more options a single click cannot resolve a
  variant, and guessing would put the wrong thing in the cart, so the block
  renders nothing and the card is left as it was.
{%- endcomment -%}

{% liquid
  assign product = closest.product
  assign show = false
  if product != blank and product.options.size == 1 and product.variants.size > 1
    assign show = true
  endif

  assign selected_id = product.selected_or_first_available_variant.id
  assign size = block.settings.thumb_size | default: 44
  assign fetch_width = size | times: 3
%}

{% if show %}
  <ftd-card-flavors
    class="ftd-flavors"
    style="--ftd-flavor-size: {{ size }}px; justify-content: {{ block.settings.alignment }};"
    {{ block.shopify_attributes }}
  >
    {%- for variant in product.variants -%}
      {%- liquid
        # The variant pack shot is the default, and a good one — it is already
        # per-flavour. An uploaded thumbnail wins when its name matches this
        # flavour, so a 44px circle can be art rather than a shrunken pouch.
        #
        # Matched on the option value's name, not on position, because the
        # same card block draws every product in the collection. All three
        # flavoured products here use the same two names, so one upload per
        # flavour covers the lot.
        assign thumb = variant.featured_media.preview_image
        assign flavour = variant.title | downcase | strip

        for i in (1..4)
          assign name_key = 'flavor_' | append: i | append: '_name'
          assign image_key = 'flavor_' | append: i | append: '_image'
          assign candidate = block.settings[name_key] | downcase | strip
          if candidate != blank and candidate == flavour and block.settings[image_key] != blank
            assign thumb = block.settings[image_key]
            break
          endif
        endfor

        # An SVG goes out at its own URL. Shopify's image CDN resizes raster
        # formats; handing it a vector buys nothing and risks a URL that does
        # not resolve, which would show as a broken thumbnail rather than as
        # an error anyone would notice.
        assign thumb_src = thumb.src
        if thumb_src contains '.svg'
          assign thumb_url = thumb_src
        else
          assign thumb_url = thumb | image_url: width: fetch_width
        endif
      -%}
      <button
        type="button"
        class="ftd-flavors__item"
        aria-pressed="{% if variant.id == selected_id %}true{% else %}false{% endif %}"
        data-variant-id="{{ variant.id }}"
        {%- if variant.featured_media %}
          data-media-id="{{ variant.featured_media.id }}"
        {%- endif %}
        data-price="{{ variant.price | money }}"
        {%- unless variant.available %}
          disabled
        {%- endunless %}
      >
        {%- if thumb != blank -%}
          <img
            class="ftd-flavors__img"
            src="{{ thumb_url }}"
            alt=""
            width="{{ size }}"
            height="{{ size }}"
            loading="lazy"
          >
        {%- else -%}
          <span class="ftd-flavors__text" aria-hidden="true">{{ variant.title | slice: 0, 2 }}</span>
        {%- endif -%}
        {%- comment -%}
          The flavour name is the button's only accessible name — the image is
          decorative, since "a picture of the orange pouch" is not something a
          screen reader can usefully describe here.
        {%- endcomment -%}
        <span class="visually-hidden">{{ variant.title }}</span>
      </button>
    {%- endfor -%}
  </ftd-card-flavors>

  <script src="{{ 'ftd-card-flavors.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .ftd-flavors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .ftd-flavors__item {
    display: block;
    padding: 0;
    border: 1px solid rgb(from var(--color-foreground) r g b / 20%);
    border-radius: 50%;
    background: var(--color-background);
    cursor: pointer;
    line-height: 0;
    overflow: hidden;
    width: var(--ftd-flavor-size, 44px);
    height: var(--ftd-flavor-size, 44px);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .ftd-flavors__item[aria-pressed='true'] {
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  /* Focus has to be visible on its own, not only via the pressed ring, or the
     picker becomes unusable from a keyboard. */
  .ftd-flavors__item:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .ftd-flavors__item[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ftd-flavors__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ftd-flavors__text {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    line-height: 1;
    font-size: 0.75rem;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Flavor picker",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows one thumbnail per variant, using the image attached to that variant. Only appears on products with a single option and more than one variant."
    },
    {
      "type": "range",
      "id": "thumb_size",
      "label": "Thumbnail size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Flavor thumbnails"
    },
    {
      "type": "paragraph",
      "content": "Optional. Upload a thumbnail and it replaces that flavor's pack shot in the picker. The name has to match the product's option value exactly, for example Salty Orange. Leave a slot empty and that flavor keeps using its variant image. These apply to every card in the section, so one upload per flavor covers all the products that share it."
    },
    {
      "type": "text",
      "id": "flavor_1_name",
      "label": "Flavor 1 name",
      "default": "Salty Orange"
    },
    {
      "type": "image_picker",
      "id": "flavor_1_image",
      "label": "Flavor 1 thumbnail"
    },
    {
      "type": "text",
      "id": "flavor_2_name",
      "label": "Flavor 2 name",
      "default": "Salty Watermelon"
    },
    {
      "type": "image_picker",
      "id": "flavor_2_image",
      "label": "Flavor 2 thumbnail"
    },
    {
      "type": "text",
      "id": "flavor_3_name",
      "label": "Flavor 3 name"
    },
    {
      "type": "image_picker",
      "id": "flavor_3_image",
      "label": "Flavor 3 thumbnail"
    },
    {
      "type": "text",
      "id": "flavor_4_name",
      "label": "Flavor 4 name"
    },
    {
      "type": "image_picker",
      "id": "flavor_4_image",
      "label": "Flavor 4 thumbnail"
    }
  ],
  "presets": [
    {
      "name": "Flavor picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
