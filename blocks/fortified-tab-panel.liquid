{% comment %}
  Fortified Tab Panel
  ----------------------------------------------------------------------
  One panel inside a fortified-tabs section. The tab label becomes the
  tab text; the panel's children render the actual content.

  Accepts any theme block as a child — drop in native group/text/image
  blocks, or the custom fortified-checkmark-list block for a checkmark
  column.

  Visibility is driven PURELY by CSS in the parent section
  (sections/fortified-tabs.liquid): a hidden radio input + the
  `:checked ~ .ft-tabs__panel[data-ftp-index="N"]` selector shows the
  matching panel. This block therefore:
    1. Emits a stable `data-ftp-index` (1-based position among the
       section's fortified-tab-panel blocks) for the selector to match.
    2. Does NOT set `display` inline — an inline `display:flex` would beat
       the stylesheet's `display:none` base rule and keep every panel
       visible (this was the original bug). The base layout
       (flex/gap/padding) is applied by the section stylesheet; the
       per-panel gap/padding values are passed via CSS custom properties.
{% endcomment %}

{%- liquid
  # Compute this panel's 1-based index among fortified-tab-panel siblings,
  # matching the radio ids generated by the section (which loops the same
  # `where: 'type', 'fortified-tab-panel'` set in the same order).
  assign ftp_index = 0
  assign counter = 0
  for sib in section.blocks
    if sib.type == 'fortified-tab-panel'
      assign counter = counter | plus: 1
      if sib.id == block.id
        assign ftp_index = counter
      endif
    endif
  endfor

  assign panel_uid = 'ft-tabs-' | append: section.id | replace: '_', '' | downcase | append: '-panel-' | append: block.id

  # Canonical 4-way padding. Fall back to the legacy single-axis padding
  # (padding_top / padding_bottom) on any block that pre-dates the 4-way
  # control, so existing tab panels keep their spacing.
  assign pad_top = block.settings['padding-block-start']
  assign pad_bottom = block.settings['padding-block-end']
  assign pad_left = block.settings['padding-inline-start']
  assign pad_right = block.settings['padding-inline-end']
  assign pad_sum = pad_top | plus: pad_bottom | plus: pad_left | plus: pad_right
  if pad_sum == 0
    assign pad_top = block.settings.padding_top | default: 16
    assign pad_bottom = block.settings.padding_bottom | default: 16
  endif

  case block.settings.content_alignment
    when 'center'
      assign align_items = 'center'
    when 'right'
      assign align_items = 'flex-end'
    else
      assign align_items = 'stretch'
  endcase
-%}

{%- comment -%}
  Padding / gap / alignment are applied here via an ID-scoped <style> rule
  (ID beats the section's class-based rules) — NOT inline `display`, which
  would beat the stylesheet's display:none base rule and keep every panel
  visible (the original tabs bug). Visibility stays 100% controlled by the
  section's :checked ~ panel selector.
{%- endcomment -%}
<style>
  #{{ panel_uid }} {
    gap: {{ block.settings.row_gap }}px;
    align-items: {{ align_items }};
    padding: {{ pad_top }}px {{ pad_right }}px {{ pad_bottom }}px {{ pad_left }}px;
  }
</style>

<div
  class="ft-tabs__panel{% if block.settings.color_scheme != blank %} color-{{ block.settings.color_scheme }}{% endif %}"
  id="{{ panel_uid }}"
  role="tabpanel"
  data-panel-id="{{ block.id }}"
  data-ftp-index="{{ ftp_index }}"
  style="
    --ftp-gap: {{ block.settings.row_gap }}px;
    --ftp-pad-top: {{ pad_top }}px;
    --ftp-pad-bottom: {{ pad_bottom }}px;
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Tab Panel",
  "settings": [
    { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Hydration" },
    { "type": "checkbox", "id": "start_active", "label": "Show this tab by default", "default": false, "info": "If multiple panels have this enabled, the first one wins." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "row_gap", "label": "Gap between child blocks (px)", "min": 0, "max": 80, "step": 4, "default": 24 },
    {
      "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "stretch",
      "options": [
        { "value": "stretch", "label": "Fill width" },
        { "value": "left",    "label": "Left" },
        { "value": "center",  "label": "Center" },
        { "value": "right",   "label": "Right" }
      ]
    },

    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "" },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start",  "label": "Top",    "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end",    "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-start", "label": "Left",   "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end",   "label": "Right",  "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Tab Panel" }
  ]
}
{% endschema %}
