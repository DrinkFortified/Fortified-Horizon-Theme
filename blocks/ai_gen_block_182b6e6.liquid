{% doc %}
  @prompt
    progress bar emptying going from 50 to 5% from orange to red, animated
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-progress-bar-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.container_padding }}px;
  }

  .ai-progress-bar-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-progress-bar-label-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
  }

  .ai-progress-bar-title-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-progress-bar-percentage-{{ ai_gen_id }} {
    font-weight: 700;
  }

  .ai-progress-bar-track-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.bar_height }}px;
    background-color: {{ block.settings.track_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-progress-bar-fill-{{ ai_gen_id }} {
    height: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    transition: width {{ block.settings.animation_duration }}s ease-in-out, background-color {{ block.settings.animation_duration }}s ease-in-out;
    width: 50%;
    background-color: {{ block.settings.start_color }};
  }

  .ai-progress-bar-fill-{{ ai_gen_id }}.animated {
    width: 5%;
    background-color: {{ block.settings.end_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-progress-bar-container-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<progress-bar-{{ ai_gen_id }}
  class="ai-progress-bar-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-progress-bar-wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_label %}
      <div class="ai-progress-bar-label-{{ ai_gen_id }}">
        <span class="ai-progress-bar-title-{{ ai_gen_id }}">{{ block.settings.label_text }}</span>
        <span class="ai-progress-bar-percentage-{{ ai_gen_id }}" data-percentage>50%</span>
      </div>
    {% endif %}
    <div class="ai-progress-bar-track-{{ ai_gen_id }}">
      <div class="ai-progress-bar-fill-{{ ai_gen_id }}" data-fill></div>
    </div>
  </div>
</progress-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class ProgressBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.fill = null;
        this.percentageDisplay = null;
        this.animationStarted = false;
      }

      connectedCallback() {
        this.fill = this.querySelector('[data-fill]');
        this.percentageDisplay = this.querySelector('[data-percentage]');
        
        if (this.fill) {
          this.setupAnimation();
        }
      }

      setupAnimation() {
        const autoStart = {{ block.settings.auto_start | json }};
        
        if (autoStart) {
          setTimeout(() => {
            this.startAnimation();
          }, {{ block.settings.delay | times: 1000 }});
        } else {
          this.setupIntersectionObserver();
        }
      }

      setupIntersectionObserver() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !this.animationStarted) {
              this.startAnimation();
              observer.unobserve(this);
            }
          });
        }, {
          threshold: 0.5
        });

        observer.observe(this);
      }

      startAnimation() {
        this.animationStarted = true;
        
        requestAnimationFrame(() => {
          this.fill.classList.add('animated');
        });

        if (this.percentageDisplay) {
          this.animatePercentage(50, 5, {{ block.settings.animation_duration | times: 1000 }});
        }
      }

      animatePercentage(start, end, duration) {
        const startTime = performance.now();
        const difference = end - start;

        const updatePercentage = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          
          const easeInOut = progress < 0.5
            ? 2 * progress * progress
            : 1 - Math.pow(-2 * progress + 2, 2) / 2;
          
          const currentValue = Math.round(start + (difference * easeInOut));
          this.percentageDisplay.textContent = currentValue + '%';

          if (progress < 1) {
            requestAnimationFrame(updatePercentage);
          }
        };

        requestAnimationFrame(updatePercentage);
      }
    }

    customElements.define('progress-bar-{{ ai_gen_id }}', ProgressBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Emptying progress bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Battery level"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Label font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Track color",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "start_color",
      "label": "Start color",
      "default": "#ff8c00"
    },
    {
      "type": "color",
      "id": "end_color",
      "label": "End color",
      "default": "#ff0000"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Container padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Duration",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "auto_start",
      "label": "Auto start on page load",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay before start",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "s",
      "default": 0.5
    }
  ],
  "presets": [
    {
      "name": "Emptying progress bar"
    }
  ]
}
{% endschema %}