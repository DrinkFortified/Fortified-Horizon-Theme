{% doc %}
  @prompt
    Create a "Salt of the Earth" product feature section optimized for mobile, with the following layout:
    
    **Heading:**
    - Large bold heading: "Salt of the Earth" with a decorative underline accent
    - Subtitle: "What makes us great"
    - Centered text, clean and minimal
    
    **Layout - Desktop:**
    - Three-column layout: left features | center product image | right features
    - 3 feature callouts on the left, 3 on the right, all pointing toward the center product with connecting lines
    
    **Layout - Mobile (priority):**
    - Stack vertically: heading → product image → features in a 2-column grid below
    - Product image centered and prominent
    - Features displayed in a 2x3 grid (2 columns, 3 rows) below the image
    - Each feature: icon on top, bold short label, smaller subtext below
    
    **6 Feature Callouts (customizable):**
    1. Icon: crystal/mineral - "Sun Dried Salt Works® Salt" / "From the Clean Waters of Australia, Kissed by the Sun"
    2. Icon: lightning bolt - "1,550mg of Pure Electrolytes" / "Balanced & Effective"
    3. Icon: citrus/no symbol - "Organic Monk Fruit Sweetener" / "No Sugar, No Stevia, No Worries"
    4. Icon: fruit slice - "Organic Real Fruit Natural Flavors" / "Nothing Weird"
    5. Icon: gear/settings - "Hydration With Purpose" / "Custom Blends for Your Lifestyle"
    6. Icon: shield/checkmark - "NO Worries" / "No Fillers, No Citric Acid, No Artificial Anything"
    
    **Center Product:**
    - A slot for a product image (tall vertical packet/stick pack shape)
    - Subtle water splash / bokeh background effect using CSS (teal/blue-green gradient with soft radial blurs to mimic the underwater feel)
    - The background should be a teal-to-dark-teal gradient with soft light orbs
    
    **Personalization settings:**
    - Editable heading and subtitle
    - Background color / gradient start and end colors
    - Each feature: editable icon (emoji or SVG choice), editable title, editable subtext, toggle show/hide
    - Product image upload
    - Toggle connecting lines on desktop on/off
    - Font color controls (heading, feature title, feature subtext)
    - Section padding top/bottom
    - Mobile image size control
    
    **Animations:**
    - Features fade and slide in from left/right (desktop) or from bottom (mobile) when scrolled into view
    - Staggered animation delay for each feature
    - Subtle floating/pulsing animation on the product image
    - Background has a slow animated gradient shift (teal tones)
    
    Make it fully responsive, mobile-first, with a premium hydration brand aesthetic., allow me to change the size of the image always, allow mw to change the icons for images and to modify the background for gradients, colors or images., allow me to. make the image even smaller
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-salt-earth-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    {% if block.settings.bg_type == 'gradient' %}
      background: linear-gradient(135deg, {{ block.settings.bg_gradient_start }} 0%, {{ block.settings.bg_gradient_end }} 100%);
    {% elsif block.settings.bg_type == 'image' and block.settings.bg_image %}
      background-image: url('{{ block.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% else %}
      background-color: {{ block.settings.bg_solid_color }};
    {% endif %}
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.bg_type == 'gradient' %}
  .ai-salt-earth-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 30%, {{ block.settings.bg_gradient_start }}40 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, {{ block.settings.bg_gradient_end }}40 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, {{ block.settings.bg_gradient_start }}20 0%, transparent 60%);
    animation: ai-salt-earth-bg-shift-{{ ai_gen_id }} 8s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes ai-salt-earth-bg-shift-{{ ai_gen_id }} {
    0% {
      opacity: 0.3;
      transform: scale(1);
    }
    100% {
      opacity: 0.6;
      transform: scale(1.1);
    }
  }
  {% endif %}

  .ai-salt-earth-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-salt-earth-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-salt-earth-subtitle-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ block.settings.subtitle_color }};
    margin-bottom: 12px;
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-salt-earth-subtitle-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
    animation: ai-salt-earth-fade-up-{{ ai_gen_id }} 0.8s ease-out forwards;
  }

  .ai-salt-earth-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    position: relative;
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-salt-earth-title-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
    animation: ai-salt-earth-fade-up-{{ ai_gen_id }} 0.8s ease-out 0.2s forwards;
  }

  .ai-salt-earth-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 4px;
    background: {{ block.settings.accent_color }};
    border-radius: 2px;
  }

  .ai-salt-earth-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-salt-earth-product-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
  }

  .ai-salt-earth-product-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 300px;
    height: 300px;
    {% if block.settings.bg_type == 'gradient' %}
      background: radial-gradient(circle, {{ block.settings.bg_gradient_start }}60 0%, transparent 70%);
    {% else %}
      background: radial-gradient(circle, {{ block.settings.bg_solid_color }}60 0%, transparent 70%);
    {% endif %}
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0;
    animation: ai-salt-earth-pulse-{{ ai_gen_id }} 3s ease-in-out infinite;
  }

  .ai-salt-earth-product-bg-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
    opacity: 1;
  }

  @keyframes ai-salt-earth-pulse-{{ ai_gen_id }} {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 0.8;
    }
  }

  .ai-salt-earth-product-image-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: {{ block.settings.mobile_image_size }}px;
    width: 100%;
    opacity: 0;
    transform: scale(0.9);
  }

  .ai-salt-earth-product-image-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
    animation: ai-salt-earth-float-in-{{ ai_gen_id }} 1s ease-out 0.4s forwards;
  }

  .ai-salt-earth-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    animation: ai-salt-earth-float-{{ ai_gen_id }} 4s ease-in-out infinite;
  }

  @keyframes ai-salt-earth-float-{{ ai_gen_id }} {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes ai-salt-earth-float-in-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .ai-salt-earth-features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .ai-salt-earth-feature-{{ ai_gen_id }} {
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
  }

  .ai-salt-earth-feature-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
    animation: ai-salt-earth-fade-up-{{ ai_gen_id }} 0.6s ease-out forwards;
  }

  .ai-salt-earth-feature-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    margin-bottom: 12px;
    display: block;
  }

  .ai-salt-earth-feature-icon-{{ ai_gen_id }} img {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: inline-block;
    object-fit: contain;
  }

  .ai-salt-earth-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.feature_title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-salt-earth-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  @keyframes ai-salt-earth-fade-up-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-salt-earth-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr auto 1fr;
      gap: 60px;
    }

    .ai-salt-earth-features-left-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      gap: 40px;
      align-items: flex-end;
    }

    .ai-salt-earth-features-right-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      gap: 40px;
      align-items: flex-start;
    }

    .ai-salt-earth-feature-{{ ai_gen_id }} {
      max-width: 280px;
      position: relative;
    }

    .ai-salt-earth-features-left-{{ ai_gen_id }} .ai-salt-earth-feature-{{ ai_gen_id }} {
      text-align: right;
    }

    .ai-salt-earth-features-right-{{ ai_gen_id }} .ai-salt-earth-feature-{{ ai_gen_id }} {
      text-align: left;
    }

    {% if block.settings.show_connecting_lines %}
    .ai-salt-earth-feature-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      top: 20px;
      width: 60px;
      height: 2px;
      background: {{ block.settings.accent_color }};
      opacity: 0.3;
    }

    .ai-salt-earth-features-left-{{ ai_gen_id }} .ai-salt-earth-feature-{{ ai_gen_id }}::after {
      right: -60px;
    }

    .ai-salt-earth-features-right-{{ ai_gen_id }} .ai-salt-earth-feature-{{ ai_gen_id }}::after {
      left: -60px;
    }
    {% endif %}

    .ai-salt-earth-features-left-{{ ai_gen_id }} .ai-salt-earth-feature-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
      animation: ai-salt-earth-slide-right-{{ ai_gen_id }} 0.6s ease-out forwards;
    }

    .ai-salt-earth-features-right-{{ ai_gen_id }} .ai-salt-earth-feature-{{ ai_gen_id }}.ai-salt-earth-visible-{{ ai_gen_id }} {
      animation: ai-salt-earth-slide-left-{{ ai_gen_id }} 0.6s ease-out forwards;
    }

    @keyframes ai-salt-earth-slide-right-{{ ai_gen_id }} {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes ai-salt-earth-slide-left-{{ ai_gen_id }} {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .ai-salt-earth-product-image-{{ ai_gen_id }} {
      max-width: {{ block.settings.desktop_image_size }}px;
    }

    .ai-salt-earth-features-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-salt-earth-features-left-{{ ai_gen_id }},
    .ai-salt-earth-features-right-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<salt-earth-section-{{ ai_gen_id }} class="ai-salt-earth-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-salt-earth-container-{{ ai_gen_id }}">
    <div class="ai-salt-earth-header-{{ ai_gen_id }}">
      {% if block.settings.subtitle != blank %}
        <div class="ai-salt-earth-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-salt-earth-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="ai-salt-earth-layout-{{ ai_gen_id }}">
      <div class="ai-salt-earth-features-left-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign show_key = 'feature_' | append: i | append: '_show'
            assign icon_type_key = 'feature_' | append: i | append: '_icon_type'
            assign icon_emoji_key = 'feature_' | append: i | append: '_icon_emoji'
            assign icon_image_key = 'feature_' | append: i | append: '_icon_image'
            assign title_key = 'feature_' | append: i | append: '_title'
            assign text_key = 'feature_' | append: i | append: '_text'
            
            assign show_feature = block.settings[show_key]
            assign icon_type = block.settings[icon_type_key]
            assign icon_emoji = block.settings[icon_emoji_key]
            assign icon_image = block.settings[icon_image_key]
            assign title = block.settings[title_key]
            assign text = block.settings[text_key]
          %}
          
          {% if show_feature %}
            <div class="ai-salt-earth-feature-{{ ai_gen_id }}" data-delay="{{ forloop.index | times: 0.1 }}">
              <span class="ai-salt-earth-feature-icon-{{ ai_gen_id }}">
                {% if icon_type == 'image' and icon_image %}
                  <img src="{{ icon_image | image_url: width: 100 }}" alt="{{ title | escape }}">
                {% else %}
                  {{ icon_emoji }}
                {% endif %}
              </span>
              <h3 class="ai-salt-earth-feature-title-{{ ai_gen_id }}">{{ title }}</h3>
              <p class="ai-salt-earth-feature-text-{{ ai_gen_id }}">{{ text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-salt-earth-product-wrapper-{{ ai_gen_id }}">
        <div class="ai-salt-earth-product-bg-{{ ai_gen_id }}"></div>
        <div class="ai-salt-earth-product-image-{{ ai_gen_id }}">
          {% if block.settings.product_image %}
            <img
              src="{{ block.settings.product_image | image_url: width: 700 }}"
              alt="{{ block.settings.product_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_image.width }}"
              height="{{ block.settings.product_image.height }}"
            >
          {% else %}
            <div style="width: 100%; max-width: 300px; margin: 0 auto;">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-salt-earth-features-right-{{ ai_gen_id }}">
        {% for i in (4..6) %}
          {% liquid
            assign show_key = 'feature_' | append: i | append: '_show'
            assign icon_type_key = 'feature_' | append: i | append: '_icon_type'
            assign icon_emoji_key = 'feature_' | append: i | append: '_icon_emoji'
            assign icon_image_key = 'feature_' | append: i | append: '_icon_image'
            assign title_key = 'feature_' | append: i | append: '_title'
            assign text_key = 'feature_' | append: i | append: '_text'
            
            assign show_feature = block.settings[show_key]
            assign icon_type = block.settings[icon_type_key]
            assign icon_emoji = block.settings[icon_emoji_key]
            assign icon_image = block.settings[icon_image_key]
            assign title = block.settings[title_key]
            assign text = block.settings[text_key]
          %}
          
          {% if show_feature %}
            <div class="ai-salt-earth-feature-{{ ai_gen_id }}" data-delay="{{ forloop.index | times: 0.1 }}">
              <span class="ai-salt-earth-feature-icon-{{ ai_gen_id }}">
                {% if icon_type == 'image' and icon_image %}
                  <img src="{{ icon_image | image_url: width: 100 }}" alt="{{ title | escape }}">
                {% else %}
                  {{ icon_emoji }}
                {% endif %}
              </span>
              <h3 class="ai-salt-earth-feature-title-{{ ai_gen_id }}">{{ title }}</h3>
              <p class="ai-salt-earth-feature-text-{{ ai_gen_id }}">{{ text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-salt-earth-features-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign show_key = 'feature_' | append: i | append: '_show'
            assign icon_type_key = 'feature_' | append: i | append: '_icon_type'
            assign icon_emoji_key = 'feature_' | append: i | append: '_icon_emoji'
            assign icon_image_key = 'feature_' | append: i | append: '_icon_image'
            assign title_key = 'feature_' | append: i | append: '_title'
            assign text_key = 'feature_' | append: i | append: '_text'
            
            assign show_feature = block.settings[show_key]
            assign icon_type = block.settings[icon_type_key]
            assign icon_emoji = block.settings[icon_emoji_key]
            assign icon_image = block.settings[icon_image_key]
            assign title = block.settings[title_key]
            assign text = block.settings[text_key]
          %}
          
          {% if show_feature %}
            <div class="ai-salt-earth-feature-{{ ai_gen_id }}" data-delay="{{ forloop.index | times: 0.1 }}">
              <span class="ai-salt-earth-feature-icon-{{ ai_gen_id }}">
                {% if icon_type == 'image' and icon_image %}
                  <img src="{{ icon_image | image_url: width: 100 }}" alt="{{ title | escape }}">
                {% else %}
                  {{ icon_emoji }}
                {% endif %}
              </span>
              <h3 class="ai-salt-earth-feature-title-{{ ai_gen_id }}">{{ title }}</h3>
              <p class="ai-salt-earth-feature-text-{{ ai_gen_id }}">{{ text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</salt-earth-section-{{ ai_gen_id }}>

<script>
  (function() {
    class SaltEarthSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.observer = null;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.animateElements();
              this.observer.unobserve(entry.target);
            }
          });
        }, options);

        this.observer.observe(this);
      }

      animateElements() {
        const subtitle = this.querySelector('.ai-salt-earth-subtitle-{{ ai_gen_id }}');
        const title = this.querySelector('.ai-salt-earth-title-{{ ai_gen_id }}');
        const productBg = this.querySelector('.ai-salt-earth-product-bg-{{ ai_gen_id }}');
        const productImage = this.querySelector('.ai-salt-earth-product-image-{{ ai_gen_id }}');
        const features = this.querySelectorAll('.ai-salt-earth-feature-{{ ai_gen_id }}');

        if (subtitle) {
          subtitle.classList.add('ai-salt-earth-visible-{{ ai_gen_id }}');
        }

        if (title) {
          title.classList.add('ai-salt-earth-visible-{{ ai_gen_id }}');
        }

        if (productBg) {
          productBg.classList.add('ai-salt-earth-visible-{{ ai_gen_id }}');
        }

        if (productImage) {
          productImage.classList.add('ai-salt-earth-visible-{{ ai_gen_id }}');
        }

        features.forEach((feature, index) => {
          const delay = parseFloat(feature.getAttribute('data-delay')) || 0;
          setTimeout(() => {
            feature.classList.add('ai-salt-earth-visible-{{ ai_gen_id }}');
          }, (delay + 0.6) * 1000);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('salt-earth-section-{{ ai_gen_id }}', SaltEarthSection{{ ai_gen_id }});
  })();
</script>

