{% comment %}
  Block: Product Selector (PDP)
  Category: Fortified Elements
  Purpose: Theme-block version of the FTD - Product Selector section,
    addressable on product page templates via the theme editor.
    LEFT  : gallery (thumbnails + main image + doctor badge + rating +
            certification badges + caption).
    RIGHT : rating, title, subtitle, benefit rows,
            Step 1 "Choose Your Plan" (1 a month / 3 every 3 months cards),
            Step 2 "Build N-Pouch Bundle" (function product-cards w/ flavor),
            optional creatine add-on, Add to Cart, sticky mobile bar.
    Prices auto-calc from the selected product's subscription plan, falling
    back to the manual text fields when no product/plan is available.
{% endcomment %}

{%- liquid
  assign sid             = block.id
  assign function_blocks = block.blocks | where: "type", "_ftd-ps-function"
  assign benefit_blocks  = block.blocks | where: "type", "_ftd-ps-benefit"
  assign cert_blocks     = block.blocks | where: "type", "_ftd-ps-cert"
  assign gallery_blocks  = block.blocks | where: "type", "_ftd-ps-gallery"

  assign show_monthly    = block.settings.show_monthly
  assign show_quarterly  = block.settings.show_quarterly
  assign bundle_count    = block.settings.bundle_count | default: 3
  assign img_position    = block.settings.image_position | default: 'center center'
  assign btn_style       = block.settings.button_style | default: 'filled'
  assign flavor_label    = block.settings.flavor_label | default: 'Choose Flavor:'
  assign coming_soon_txt = block.settings.coming_soon_text | default: 'Soon'

  assign addon = block.settings.addon_product
  assign addon_variant_id = ''
  if addon != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif

  assign rating_num = block.settings.rating_value | times: 1.0
  assign rating_round = rating_num | round

  assign monthly_title_lines   = block.settings.monthly_title   | newline_to_br | split: '<br />'
  assign quarterly_title_lines = block.settings.quarterly_title | newline_to_br | split: '<br />'
  assign monthly_list   = block.settings.monthly_checklist   | newline_to_br | split: '<br />'
  assign quarterly_list = block.settings.quarterly_checklist | newline_to_br | split: '<br />'

  assign default_main = ''
  if gallery_blocks.size > 0 and gallery_blocks.first.settings.image != blank
    assign default_main = gallery_blocks.first.settings.image | image_url: width: 1200
  endif
-%}

<div
  id="fe-{{ sid }}"
  class="fe-section fe-block fe-block--{{ block.settings.section_width }} color-{{ block.settings.color_scheme }}"
  data-block-id="{{ sid }}"
  style="
    {% render 'spacing-padding', settings: block.settings %}
    --fe-btn-radius: {{ block.settings.button_radius }}px;
    --fe-card-radius: {{ block.settings.card_radius }}px;
    --fe-img-padding: {{ block.settings.image_padding }}px;
    --fe-img-position: {{ img_position }};
    --fe-media-height-mobile: {{ block.settings.media_height_mobile }}px;
    --fe-media-height-desktop: {{ block.settings.media_height_desktop }}px;
    --fe-selection-color: {{ block.settings.selection_color }};
    --fe-star-color: {{ block.settings.star_color }};
    --fe-doctor-bg: {{ block.settings.doctor_badge_bg }};
    --fe-monthly-badge: {{ block.settings.monthly_badge_color }};
    --fe-quarterly-badge: {{ block.settings.quarterly_badge_color }};
    --fe-panel-width: {{ block.settings.panel_width }}px;
    --fe-max-width: {{ block.settings.content_max_width }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="fe-container" data-layout="{{ block.settings.layout_direction | default: 'image-left' }}">

    {%- comment %} ───────── LEFT: GALLERY ───────── {%- endcomment %}
    <div class="fe-gallery" data-thumbpos="{{ block.settings.thumbnail_position | default: 'left' }}">
      {%- if gallery_blocks.size > 1 and block.settings.show_thumbnails != false -%}
        <div class="fe-thumbs" role="group" aria-label="Product images">
          {%- for gb in gallery_blocks -%}
            {%- if gb.settings.image != blank -%}
              <button type="button" class="fe-thumb{% if forloop.first %} is-active{% endif %}"
                data-full="{{ gb.settings.image | image_url: width: 1200 }}"
                {{ gb.shopify_attributes }}>
                <img src="{{ gb.settings.image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="fe-gallery-col">
        <div class="fe-gallery-main color-{{ block.settings.media_color_scheme }}">
          {%- if block.settings.show_doctor_badge and block.settings.doctor_badge_text != blank -%}
            <span class="fe-doctor-badge">{{ block.settings.doctor_badge_text }}</span>
          {%- endif -%}

          {%- if block.settings.show_rating -%}
            <span class="fe-rating fe-rating--gallery">
              <span class="fe-stars" aria-hidden="true">
                {%- for i in (1..5) -%}<span class="fe-star{% if i <= rating_round %} is-on{% endif %}">★</span>{%- endfor -%}
              </span>
              <span class="fe-rating-text">{{ block.settings.rating_value }} <span class="fe-rating-count">{{ block.settings.rating_count }}</span></span>
            </span>
          {%- endif -%}

          {%- if cert_blocks.size > 0 -%}
            <span class="fe-certs">
              {%- for cb in cert_blocks -%}
                <span class="fe-cert" {{ cb.shopify_attributes }}>
                  {%- if cb.settings.image != blank -%}
                    <img src="{{ cb.settings.image | image_url: width: 96 }}" alt="{{ cb.settings.label | escape }}" width="40" height="40" loading="lazy">
                  {%- else -%}
                    <span class="fe-cert-text">{{ cb.settings.label }}</span>
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </span>
          {%- endif -%}

          <img class="fe-main-img" id="fe-main-img-{{ sid }}"
            src="{{ default_main }}"
            alt="{{ block.settings.heading | escape }}"
            width="1200" height="1200"
            {% unless default_main != blank %}style="display:none"{% endunless %}>
          {%- unless default_main != blank -%}
            <div class="fe-main-ph"><span>{{ block.settings.heading }}</span></div>
          {%- endunless -%}
        </div>

        {%- if block.settings.gallery_caption != blank -%}
          <p class="fe-gallery-caption">{{ block.settings.gallery_caption }}</p>
        {%- endif -%}

        {%- if block.settings.show_progress -%}
          <ol class="fe-progress" id="fe-progress-{{ sid }}" aria-label="Progress">
            <li class="fe-progress-step is-active" data-step="1"><span class="fe-progress-dot">1</span><span class="fe-progress-label">{{ block.settings.progress_label_1 | default: 'Plan' }}</span></li>
            <li class="fe-progress-step" data-step="2"><span class="fe-progress-dot">2</span><span class="fe-progress-label">{{ block.settings.progress_label_2 | default: 'Build' }}</span></li>
            <li class="fe-progress-step" data-step="3"><span class="fe-progress-dot">3</span><span class="fe-progress-label">{{ block.settings.progress_label_3 | default: 'Review' }}</span></li>
          </ol>
        {%- endif -%}
      </div>
    </div>

    {%- comment %} ───────── RIGHT: PANEL ───────── {%- endcomment %}
    <div class="fe-panel color-{{ block.settings.panel_color_scheme }}" id="fe-panel-{{ sid }}">

      {%- if block.settings.show_rating -%}
        <span class="fe-rating fe-rating--panel">
          <span class="fe-stars" aria-hidden="true">
            {%- for i in (1..5) -%}<span class="fe-star{% if i <= rating_round %} is-on{% endif %}">★</span>{%- endfor -%}
          </span>
          <span class="fe-rating-text">{{ block.settings.rating_value }} <span class="fe-rating-count">{{ block.settings.rating_count }}</span></span>
        </span>
      {%- endif -%}

      {%- if block.settings.heading != blank -%}<h2 class="fe-heading">{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.subheading != blank -%}<p class="fe-subheading">{{ block.settings.subheading }}</p>{%- endif -%}

      {%- if benefit_blocks.size > 0 -%}
        <ul class="fe-benefits">
          {%- for bb in benefit_blocks -%}
            <li class="fe-benefit" {{ bb.shopify_attributes }}>
              {%- if bb.settings.icon != blank -%}
                <span class="fe-benefit-icon"><img src="{{ bb.settings.icon | image_url: width: 64 }}" alt="" width="28" height="28"></span>
              {%- else -%}
                <span class="fe-benefit-icon fe-benefit-icon--dot" aria-hidden="true"></span>
              {%- endif -%}
              <span class="fe-benefit-text">{{ bb.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment %} ───── STEP 1: PLAN ───── {%- endcomment %}
      <div class="fe-step" id="fe-plan-group-{{ sid }}">
        <div class="fe-step-head">
          <p class="fe-step-title"><span class="fe-step-num">1</span>{{ block.settings.plan_step_label | default: 'Choose Your Plan' }}</p>
          {%- if block.settings.plan_step_note != blank -%}<span class="fe-step-note">{{ block.settings.plan_step_note }}</span>{%- endif -%}
        </div>

        <div class="fe-plans">
          {%- if show_monthly -%}
            <label class="fe-plan" data-plan="monthly">
              <input type="radio" name="fe-plan-{{ sid }}" value="monthly">
              <span class="fe-plan-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 12 12" fill="none"><polyline points="1.5,6 4.5,9 10.5,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {%- if block.settings.monthly_badge != blank -%}<span class="fe-plan-badge fe-plan-badge--monthly">{{ block.settings.monthly_badge }}</span>{%- endif -%}
              <span class="fe-plan-title">
                {%- for line in monthly_title_lines -%}{%- assign lt = line | strip -%}{%- if lt != blank -%}<span class="fe-plan-title-line">{{ lt }}</span>{%- endif -%}{%- endfor -%}
              </span>
              {%- if block.settings.monthly_desc != blank -%}<span class="fe-plan-desc">{{ block.settings.monthly_desc }}</span>{%- endif -%}
              <span class="fe-plan-price-row">
                <span class="fe-plan-price" data-plan-price="monthly">{{ block.settings.monthly_price }}</span>
                <span class="fe-plan-period">{{ block.settings.monthly_period }}</span>
              </span>
              <span class="fe-plan-was" data-plan-was="monthly">{{ block.settings.monthly_was }}</span>
              {%- if monthly_list.size > 0 -%}
                <span class="fe-plan-list">
                  {%- for li in monthly_list -%}{%- assign lt = li | strip -%}{%- if lt != blank -%}<span class="fe-plan-li"><span class="fe-li-check" aria-hidden="true">✓</span>{{ lt }}</span>{%- endif -%}{%- endfor -%}
                </span>
              {%- endif -%}
            </label>
          {%- endif -%}

          {%- if show_quarterly -%}
            <label class="fe-plan" data-plan="quarterly">
              <input type="radio" name="fe-plan-{{ sid }}" value="quarterly">
              <span class="fe-plan-tick" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 12 12" fill="none"><polyline points="1.5,6 4.5,9 10.5,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {%- if block.settings.quarterly_badge != blank -%}<span class="fe-plan-badge fe-plan-badge--quarterly">{{ block.settings.quarterly_badge }}</span>{%- endif -%}
              <span class="fe-plan-title">
                {%- for line in quarterly_title_lines -%}{%- assign lt = line | strip -%}{%- if lt != blank -%}<span class="fe-plan-title-line">{{ lt }}</span>{%- endif -%}{%- endfor -%}
              </span>
              {%- if block.settings.quarterly_desc != blank -%}<span class="fe-plan-desc">{{ block.settings.quarterly_desc }}</span>{%- endif -%}
              <span class="fe-plan-price-row">
                <span class="fe-plan-price" data-plan-price="quarterly">{{ block.settings.quarterly_price }}</span>
                <span class="fe-plan-period">{{ block.settings.quarterly_period }}</span>
              </span>
              <span class="fe-plan-was" data-plan-was="quarterly">{{ block.settings.quarterly_was }}</span>
              {%- if quarterly_list.size > 0 -%}
                <span class="fe-plan-list">
                  {%- for li in quarterly_list -%}{%- assign lt = li | strip -%}{%- if lt != blank -%}<span class="fe-plan-li"><span class="fe-li-check" aria-hidden="true">✓</span>{{ lt }}</span>{%- endif -%}{%- endfor -%}
                </span>
              {%- endif -%}
            </label>
          {%- endif -%}
        </div>
      </div>

      {%- comment %} ───── STEP 2: BUILD BUNDLE ───── {%- endcomment %}
      <div class="fe-step fe-step--locked" id="fe-build-group-{{ sid }}" aria-disabled="true">
        <div class="fe-step-head">
          <p class="fe-step-title"><span class="fe-step-num">2</span><span id="fe-build-label-{{ sid }}">{{ block.settings.build_step_label | default: 'Build Your Bundle' }}</span></p>
          <span class="fe-step-note" id="fe-counter-{{ sid }}"></span>
        </div>

        {%- comment %} Monthly: one pouch {%- endcomment %}
        <div class="fe-build-view fe-build-view--monthly" data-build-view="monthly">
          <div class="fe-fcards" data-config="monthly">
            {%- for fb in function_blocks -%}
              {%- if fb.settings.enabled -%}
                {%- render 'fortified-fn-card', card_block: fb, config: 'monthly', flavor_label: flavor_label, coming_soon_text: coming_soon_txt -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- comment %} Quarterly: one pouch group per unit {%- endcomment %}
        <div class="fe-build-view fe-build-view--quarterly" data-build-view="quarterly">
          {%- for i in (1..bundle_count) -%}
            <div class="fe-pouch">
              <p class="fe-pouch-title">{{ block.settings.unit_label_prefix | default: 'Pouch' }} {{ i }}</p>
              <div class="fe-fcards" data-config="q{{ i }}">
                {%- for fb in function_blocks -%}
                  {%- if fb.settings.enabled -%}
                    {%- render 'fortified-fn-card', card_block: fb, config: 'q', flavor_label: flavor_label, coming_soon_text: coming_soon_txt -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment %} ───── CREATINE ADD-ON (visible toggle card; adapts monthly / quarterly-2nd) ───── {%- endcomment %}
      {%- if block.settings.show_addon and addon != blank -%}
        {%- assign addon_img = block.settings.addon_image | default: addon.featured_image -%}
        <div class="fe-creatine" id="fe-creatine-{{ sid }}" hidden>
          <p class="fe-cr-free" id="fe-cr-free-{{ sid }}" hidden><span class="fe-cr-tick" aria-hidden="true">✓</span>{{ block.settings.quarterly_free_text | default: 'Free Creatine + Sample Pack included with your bundle' }}</p>
          <label class="fe-cr-card">
            <span class="fe-cr-media">
              {%- if addon_img != blank -%}<img src="{{ addon_img | image_url: width: 120 }}" alt="" width="58" height="58" loading="lazy">{%- else -%}<span class="fe-cr-ph">5g</span>{%- endif -%}
            </span>
            <span class="fe-cr-text">
              <span class="fe-cr-title" id="fe-cr-title-{{ sid }}">{{ block.settings.addon_label | default: 'Add Creatine — 50% off' }}</span>
              {%- if block.settings.addon_desc != blank -%}<span class="fe-cr-desc" id="fe-cr-desc-{{ sid }}">{{ block.settings.addon_desc }}</span>{%- endif -%}
            </span>
            <span class="fe-cr-pricing">
              {%- if block.settings.addon_price_text != blank -%}<span class="fe-cr-now">{{ block.settings.addon_price_text }}</span>{%- endif -%}
              {%- if block.settings.addon_was_text != blank -%}<span class="fe-cr-was">{{ block.settings.addon_was_text }}</span>{%- endif -%}
            </span>
            <input type="checkbox" id="fe-addon-{{ sid }}"
              data-addon-variant="{{ addon_variant_id }}"
              data-addon-plan-monthly="{{ block.settings.addon_loop_plan_monthly }}"
              data-addon-plan-quarterly-free="{{ block.settings.addon_loop_plan_quarterly }}"
              data-addon-plan-quarterly-50off="{{ block.settings.addon_loop_plan_quarterly_50off }}">
            <span class="fe-cr-switch" aria-hidden="true"></span>
          </label>
        </div>
      {%- endif -%}

      {%- comment %} ───── ORDER OVERVIEW (before Add to Cart) ───── {%- endcomment %}
      <div class="fe-overview" id="fe-overview-{{ sid }}" hidden>
        <p class="fe-ov-label">{{ block.settings.summary_label | default: 'Your Order' }}</p>
        <ul class="fe-ov-lines" id="fe-ov-lines-{{ sid }}"></ul>
        <div class="fe-ov-total"><span>{{ block.settings.total_label | default: 'Total' }}</span><span class="fe-ov-total-val" id="fe-ov-total-{{ sid }}">--</span></div>
        {%- if block.settings.overview_note != blank -%}<p class="fe-ov-note">{{ block.settings.overview_note }}</p>{%- endif -%}
      </div>

      {%- comment %} ───── QUANTITY + ADD TO CART ───── {%- endcomment %}
      <div class="fe-atc-wrap">
        <div class="fe-atc-row">
          <button
            type="button"
            class="fe-atc-btn fe-atc-btn--{{ btn_style }}"
            id="fe-atc-{{ sid }}"
            disabled
            aria-disabled="true"
          >
            <span class="fe-atc-label">{{ block.settings.atc_label | default: 'Add to Cart' }}</span>
            <span class="fe-atc-total" id="fe-atc-total-{{ sid }}"></span>
            <span class="fe-atc-loading" aria-hidden="true"></span>
          </button>
        </div>

        {%- if block.settings.onetime_prefix != blank or block.settings.onetime_price_text != blank -%}
          {%- if block.settings.onetime_link != blank -%}
            <a class="fe-onetime" href="{{ block.settings.onetime_link }}">
              <span class="fe-onetime-prefix">{{ block.settings.onetime_prefix }}</span>
              <span class="fe-onetime-price">{{ block.settings.onetime_price_text }}</span>
            </a>
          {%- else -%}
            <button type="button" class="fe-onetime" id="fe-onetime-{{ sid }}" {% unless block.settings.onetime_clickable %}data-static="true"{% endunless %}>
              <span class="fe-onetime-prefix">{{ block.settings.onetime_prefix }}</span>
              <span class="fe-onetime-price">{{ block.settings.onetime_price_text }}</span>
            </button>
          {%- endif -%}
        {%- endif -%}

        <p class="fe-atc-message" id="fe-atc-msg-{{ sid }}" aria-live="polite"></p>
      </div>

    </div>
  </div>

  {%- comment %} ───── MOBILE STICKY ADD-TO-CART BAR (mirrors the real button) ───── {%- endcomment %}
  <div class="fe-stickybar color-{{ block.settings.panel_color_scheme }}" id="fe-stickybar-{{ sid }}">
    <div class="fe-stickybar-info">
      <span class="fe-stickybar-counter" id="fe-sb-counter-{{ sid }}"></span>
      <span class="fe-stickybar-total" id="fe-sb-total-{{ sid }}" data-empty="{{ block.settings.plan_step_label | default: 'Choose your plan' | escape }}"></span>
    </div>
    <button type="button" class="fe-stickybar-btn" id="fe-sb-atc-{{ sid }}" disabled aria-disabled="true">{{ block.settings.atc_label | default: 'Add to Cart' }}</button>
  </div>
</div>

<style>
#fe-{{ sid }} *, #fe-{{ sid }} *::before, #fe-{{ sid }} *::after { box-sizing: border-box; }

#fe-{{ sid }}.fe-section {
  background: rgb(var(--color-background)); color: rgb(var(--color-foreground));
  font-family: inherit; overflow-x: clip;
  display: block; width: 100%;
}
#fe-{{ sid }} .fe-container { display: grid; grid-template-columns: 1fr; gap: 1.5rem; max-width: var(--fe-max-width, 1400px); margin: 0 auto; width: 100%; padding: 0 1rem; }
@media (min-width: 900px) {
  #fe-{{ sid }} .fe-container { grid-template-columns: 1fr var(--fe-panel-width, 460px); gap: 2.5rem; padding: 0 1.5rem; align-items: start; }
  #fe-{{ sid }} .fe-container[data-layout="panel-left"] { grid-template-columns: var(--fe-panel-width, 460px) 1fr; }
  #fe-{{ sid }} .fe-container[data-layout="panel-left"] .fe-gallery { order: 2; }
  #fe-{{ sid }} .fe-container[data-layout="panel-left"] .fe-panel { order: 1; }
}

/* ── Gallery ── */
#fe-{{ sid }} .fe-gallery { display: flex; gap: 0.75rem; }
@media (min-width: 900px) { #fe-{{ sid }} .fe-gallery { position: sticky; top: 1.5rem; } }
#fe-{{ sid }} .fe-thumbs { display: flex; flex-direction: column; gap: 0.6rem; flex-shrink: 0; }
#fe-{{ sid }} .fe-thumb {
  width: 56px; height: 56px; padding: 0; border-radius: 10px; overflow: hidden;
  border: 2px solid rgba(var(--color-foreground), 0.12); background: rgba(var(--color-foreground), 0.03);
  cursor: pointer; transition: border-color 0.15s;
}
#fe-{{ sid }} .fe-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
#fe-{{ sid }} .fe-thumb.is-active { border-color: var(--fe-selection-color, rgb(var(--color-button))); }
#fe-{{ sid }} .fe-gallery-col { flex: 1; min-width: 0; }
#fe-{{ sid }} .fe-gallery[data-thumbpos="right"] { flex-direction: row-reverse; }
#fe-{{ sid }} .fe-gallery[data-thumbpos="bottom"] { flex-direction: column; }
#fe-{{ sid }} .fe-gallery[data-thumbpos="bottom"] .fe-thumbs { flex-direction: row; flex-wrap: wrap; order: 2; }
#fe-{{ sid }} .fe-gallery[data-thumbpos="bottom"] .fe-gallery-col { order: 1; }
#fe-{{ sid }} .fe-gallery-main {
  position: relative; border-radius: var(--fe-card-radius, 12px); overflow: hidden;
  background: color-mix(in srgb, rgb(var(--color-foreground)) 5%, rgb(var(--color-background)));
  height: var(--fe-media-height-mobile, 420px); padding: var(--fe-img-padding, 0px);
  display: flex; align-items: center; justify-content: center;
}
@media (min-width: 900px) { #fe-{{ sid }} .fe-gallery-main { height: var(--fe-media-height-desktop, 560px); } }
#fe-{{ sid }} .fe-main-img { width: 100%; height: 100%; object-fit: contain; object-position: var(--fe-img-position, center center); display: block; transition: opacity 0.3s ease; }
#fe-{{ sid }} .fe-main-ph { color: rgba(var(--color-foreground), 0.3); font-size: 1rem; letter-spacing: 0.08em; }
#fe-{{ sid }} .fe-doctor-badge {
  position: absolute; top: 12px; left: 12px; z-index: 2;
  background: var(--fe-doctor-bg, #0A0A0A); color: #fff;
  font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
  padding: 0.4em 0.7em; border-radius: 6px;
}
#fe-{{ sid }} .fe-rating--gallery { position: absolute; top: 12px; right: 12px; z-index: 2; }
#fe-{{ sid }} .fe-certs { position: absolute; top: 64px; left: 12px; z-index: 2; display: flex; flex-direction: column; gap: 0.5rem; }
#fe-{{ sid }} .fe-cert { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
#fe-{{ sid }} .fe-cert img { width: 100%; height: 100%; object-fit: contain; }
#fe-{{ sid }} .fe-cert-text {
  font-size: 0.5rem; font-weight: 800; text-transform: uppercase; text-align: center; line-height: 1.1;
  background: rgba(255,255,255,0.9); color: #0A0A0A; border: 1px solid rgba(0,0,0,0.15);
  border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; padding: 2px;
}
