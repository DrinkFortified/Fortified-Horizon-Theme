{% comment %}
  Block: FTD - Product Selector D — Slide-over
  ----------------------------------------------------------------------
  Trigger button slides a full-screen panel in from the right; inside,
  the same wizard (Plan -> Products -> Upsells -> Cart) as the
  standalone Section C variant.

  Architecture: child theme blocks (_ftd-c-function, _ftd-c-bullet,
  _ftd-c-upsell) self-render their own markup with data-slot attrs.
  We render them via content_for 'blocks' into a hidden staging div,
  then JS moves each one into the right container on init.
{% endcomment %}

{%- liquid
  assign sid = block.id
  assign show_onetime   = block.settings.show_onetime
  assign show_monthly   = block.settings.show_monthly
  assign show_quarterly = block.settings.show_quarterly
  assign bundle_count   = block.settings.bundle_count | default: 3
  assign addon          = block.settings.addon_product
  assign addon_variant_id = ''
  if addon != blank and addon.selected_or_first_available_variant != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif
  assign acc_monthly   = block.settings.monthly_accent_color   | default: '#1FA8A1'
  assign acc_quarterly = block.settings.quarterly_accent_color | default: '#E8833A'
  assign acc_onetime   = block.settings.onetime_accent_color   | default: '#8E8E93'
-%}

{{ 'ftdc.css' | asset_url | stylesheet_tag }}

<style>
  /* Per-plan accent: override --ftdc-accent on each plan card so EVERYTHING
     that reads the accent (badge background, top stripe, selected border,
     tick, glow) uses that plan's color consistently. */
  #ftdc-{{ sid }} .ftdc__plan[data-plan="monthly"] { --ftdc-accent: {{ acc_monthly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="quarterly"] { --ftdc-accent: {{ acc_quarterly }}; }
  #ftdc-{{ sid }} .ftdc__plan[data-plan="onetime"] { --ftdc-accent: {{ acc_onetime }}; }
  #ftdc-{{ sid }} .ftdc__plan { border-top: 4px solid var(--ftdc-accent, var(--color-primary-button-background)); }
  /* Image stacks on top of the plans inside the slide-over (panel is too
     narrow for a side-by-side layout), then the plans below: two
     subscriptions on the top row, Buy Once spanning the full width below. */
  #ftdc-{{ sid }} .ftdc__step--has-image.is-active { display: block; }
  #ftdc-{{ sid }} .ftdc__plans-image { margin-bottom: 1rem; }
  #ftdc-{{ sid }} .ftdc__plans-image img { width: 100%; height: auto; display: block; border-radius: var(--ftdc-radius, 12px); object-fit: cover; max-height: 280px; }
  #ftdc-{{ sid }} .ftdc__plans { grid-template-columns: 1fr 1fr; }
  #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-column: 1 / -1; }
  /* Center the bundle (Step 2) cards: fixed-width tracks + justify-content
     so a partial row sits centered instead of left-aligned. Desktop only —
     the mobile 2-column layout from ftdc.css is left as-is. */
  #ftdc-{{ sid }} .ftdc__grid { justify-content: center; }
  @media (min-width: 600px) {
    /* auto-fit (not auto-fill): collapses unused tracks to 0 width so a
       partial row of cards centers as a group instead of leaving trailing
       empty columns that push the visible cards to the left. */
    #ftdc-{{ sid }} .ftdc__grid { grid-template-columns: repeat(auto-fit, minmax(200px, 230px)); }
  }
  @media (max-width: 749px) {
    #ftdc-{{ sid }} .ftdc__plans-image img { max-height: 200px; }
    #ftdc-{{ sid }} .ftdc__plans { grid-template-columns: 1fr; }
    #ftdc-{{ sid }} .ftdc__plans .ftdc__plan[data-plan="onetime"] { grid-column: auto; }
    #ftdc-{{ sid }} .ftdc__bullets { grid-template-columns: 1fr; }
  }

  /* Bottom action bar: no longer pinned — sits in normal flow at the end of
     the step content, so visitors scroll down to reach it. */
  #ftdc-{{ sid }} .ftdc__bar { position: static; bottom: auto; }

  /* Bundle progress header stays pinned while scrolling the product grid. */
  #ftdc-{{ sid }} .ftdc__step[data-step="products"] .ftdc__bundle-head {
    position: sticky;
    top: 0;
    z-index: 6;
    background: var(--color-background);
    padding-block: 0.75rem 0.5rem;
  }

  /* Badge: tighter, closer to the text. justify-self: start stops it from
     stretching to the full grid-column width (its parent .ftdc__plan is a
     CSS Grid, so with no justify-self it defaults to stretch — the badge
     was filling the whole card width instead of wrapping its own text). */
  #ftdc-{{ sid }} .ftdc__plan-badge { padding: 0.05rem 0.4rem; line-height: 1.5; justify-self: start; }

  /* Header description: room for ~4 lines of copy without feeling cramped. */
  #ftdc-{{ sid }} .ftdc__desc { max-width: 44em; }

  /* Bullets in two columns instead of one stacked column, kept tight to
     their own dot/text pairing (not stretched by the grid). */
  #ftdc-{{ sid }} .ftdc__bullets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 1.75rem; max-width: 34em; align-items: start; }
  #ftdc-{{ sid }} .ftdc__bullet { justify-self: start; gap: 0.5rem; }
  #ftdc-{{ sid }} .ftdc__bullet-dot { flex-shrink: 0; }

  /* "Was" price: keep the muted styling, drop the strikethrough. */
  #ftdc-{{ sid }} .ftdc__plan-was { text-decoration: none; }

  /* Header (heading/description/bullets) only makes sense on the Plan step. */
  #ftdc-{{ sid }}[data-active-step="products"] .ftdc__header,
  #ftdc-{{ sid }}[data-active-step="review"] .ftdc__header { display: none; }
  /* Announcement bar (slot above wizard header). One or more bars stacked. */
  #ftdc-{{ sid }} .ftdc__announce { display: flex; flex-direction: column; margin: -1rem -1rem 1rem; }
  #ftdc-{{ sid }} .ftdc__announce[hidden] { display: none; }
  #ftdc-{{ sid }} .ftdc__announce-bar { padding: 0.55rem 1rem; font-size: 0.82rem; line-height: 1.3; text-align: center; }
  #ftdc-{{ sid }} .ftdc__announce-bar--fomo { padding: 0.55rem 1rem 0.65rem; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-row { display: block; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-line strong { font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-bar { display: block; margin: 0.4rem auto 0; max-width: 320px; height: var(--ftdc-fomo-h, 6px); background: var(--ftdc-fomo-track); border-radius: 999px; overflow: hidden; }
  #ftdc-{{ sid }} .ftdc__announce-fomo-bar-fill { height: 100%; background: var(--ftdc-fomo-fill); transition: width 0.35s ease; }
  #ftdc-{{ sid }} .ftdc__announce-link { text-decoration: none; }
  #ftdc-{{ sid }} .ftdc__announce-link:hover { text-decoration: underline; }

  /* "Add N more selections to continue" now lives under the progress bar
     instead of inside the bottom pill (where it broke the pill's rounded
     shape and looked visually broken). */
  #ftdc-{{ sid }} .ftdc__bundle-warning {
    margin: 0.5rem auto 0;
    max-width: 32em;
    font-size: 0.82rem;
    font-weight: 700;
    text-align: center;
    color: #92400E;
  }
  #ftdc-{{ sid }} .ftdc__bundle-warning[hidden] { display: none; }

  /* Merged step 2 add-ons section (was step 3) */
  #ftdc-{{ sid }} .ftdc__bundle-addons { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px dashed rgb(var(--color-foreground-rgb) / 0.18); display: flex; flex-direction: column; gap: 0.75rem; }
  #ftdc-{{ sid }} .ftdc__bundle-addons-head { margin: 0 0 0.25rem; }
  /* Pills are now interactive — hover affordance. */
  #ftdc-{{ sid }} .ftdc__step-pill { transition: opacity 0.15s; }
  #ftdc-{{ sid }} .ftdc__step-pill:hover { opacity: 0.85; }

  /* Step 4 — Review */
  #ftdc-{{ sid }} .ftdc__review-plan { margin: 0.25rem 0 0; font-weight: 700; }
  #ftdc-{{ sid }} .ftdc__review-lines { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  #ftdc-{{ sid }} .ftdc__review-line { display: grid; grid-template-columns: 56px 1fr auto auto; align-items: center; gap: 0.85rem; padding: 0.75rem 0; border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12); }
  #ftdc-{{ sid }} .ftdc__review-line:first-child { border-top: 0; padding-top: 0; }
  #ftdc-{{ sid }} .ftdc__review-line-thumb { width: 56px; height: 56px; border-radius: 8px; background: rgb(var(--color-foreground-rgb) / 0.06); overflow: hidden; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  #ftdc-{{ sid }} .ftdc__review-line-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ftdc-{{ sid }} .ftdc__review-line-name { font-weight: 600; line-height: 1.25; }
  #ftdc-{{ sid }} .ftdc__review-line-qty { color: rgb(var(--color-foreground-rgb) / 0.6); font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-line-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-line-price--free { color: var(--ftdc-accent, #1FA8A1); }
  #ftdc-{{ sid }} .ftdc__review-extra { margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed rgb(var(--color-foreground-rgb) / 0.2); }
  #ftdc-{{ sid }} .ftdc__review-extra .ftdc__review-line--extra { grid-template-columns: 56px 1fr auto; border-top: 0; padding-top: 0.5rem; padding-bottom: 0.5rem; }
  /* Review step: savings sits inline, to the left of the total. */
  #ftdc-{{ sid }} .ftdc__review-totals { margin: 1rem 0 1.25rem; padding-top: 0.75rem; border-top: 2px solid rgb(var(--color-foreground-rgb) / 0.2); display: flex; flex-direction: row; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; gap: 0.35rem 1.25rem; }
  #ftdc-{{ sid }} .ftdc__review-row { display: flex; align-items: baseline; justify-content: flex-start; gap: 0.4rem; margin: 0; }
  #ftdc-{{ sid }} .ftdc__review-row dt { margin: 0; font-weight: 600; }
  #ftdc-{{ sid }} .ftdc__review-row dd { margin: 0; font-variant-numeric: tabular-nums; }
  #ftdc-{{ sid }} .ftdc__review-row--total dt, #ftdc-{{ sid }} .ftdc__review-row--total dd { font-size: 1.15rem; font-weight: 800; }
  #ftdc-{{ sid }} .ftdc__review-row--saved dd { color: var(--ftdc-accent, #1FA8A1); }
</style>

<div class="ftdc-slideover-wrap" {{ block.shopify_attributes }}>
  {%- assign _trig_cls = 'button' -%}
  {%- if block.settings.button_style == 'outline' -%}{%- assign _trig_cls = 'button button-secondary' -%}{%- endif -%}
  <button class="{{ _trig_cls }}"
          type="button"
          data-ftdc-slideover-open="{{ sid }}"
          aria-haspopup="dialog"
          aria-controls="ftdc-slideover-{{ sid }}">
    {{ block.settings.button_label | default: 'Build Your Bundle' }}
  </button>

  <div class="ftdc-slideover" id="ftdc-slideover-{{ sid }}" style="--ftdc-slideover-w: {{ block.settings.slideover_width | default: 560 }}px;" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ block.settings.button_label | default: 'Build Your Bundle' | escape }}">
    <div class="ftdc-slideover__backdrop" data-ftdc-slideover-close="{{ sid }}" aria-hidden="true"></div>
    <div class="ftdc-slideover__panel" role="document">
      <button class="ftdc-slideover__close" type="button" data-ftdc-slideover-close="{{ sid }}" aria-label="{{ block.settings.close_label | default: 'Close' | escape }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      <div class="ftdc-slideover__inner">
        <section
          id="ftdc-{{ sid }}"
          class="ftdc color-{{ block.settings.color_scheme }}"
          data-section-id="{{ sid }}"
          style="--ftdc-accent: {{ block.settings.accent_color }}; --ftdc-radius: {{ block.settings.card_radius }}px; --ftdc-max-w: {{ block.settings.content_max_width }}px; padding-block-start: {{ block.settings.padding-block-start | default: 24 }}px; padding-block-end: {{ block.settings.padding-block-end | default: 24 }}px;"
        >
          <div class="ftdc__inner">

            <div class="ftdc__announce" data-announce hidden></div>

            <header class="ftdc__header">
              {%- if block.settings.heading != blank -%}<h2 class="ftdc__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.description != blank -%}<div class="ftdc__desc">{{ block.settings.description }}</div>{%- endif -%}
              <ul class="ftdc__bullets list-unstyled" data-bullets hidden></ul>
            </header>

            <ol class="ftdc__steps" role="list" aria-label="Order steps">
              <li class="ftdc__step-pill is-active" data-step-pill="plans" role="button" tabindex="0"><span class="ftdc__step-num">1</span><span class="ftdc__step-label">{{ block.settings.step_label_1 | default: 'Plan' }}</span></li>
              <li class="ftdc__step-pill" data-step-pill="products" role="button" tabindex="0"><span class="ftdc__step-num">2</span><span class="ftdc__step-label">{{ block.settings.step_label_2 | default: 'Bundle' }}</span></li>
              <li class="ftdc__step-pill" data-step-pill="review" role="button" tabindex="0"><span class="ftdc__step-num">3</span><span class="ftdc__step-label">{{ block.settings.step_label_4 | default: 'Review' }}</span></li>
            </ol>

            {%- comment %} ───── STEP 1 — PLANS ───── {%- endcomment %}
            {%- assign plan_img_mob = block.settings.plan_image_mobile | default: block.settings.plan_image -%}
            {%- assign has_plan_img = false -%}
            {%- if block.settings.plan_image != blank or block.settings.plan_image_mobile != blank -%}
              {%- assign has_plan_img = true -%}
            {%- endif -%}
            <div class="ftdc__step is-active{% if has_plan_img %} ftdc__step--has-image{% endif %}" data-step="plans">
              {%- if has_plan_img -%}
                <div class="ftdc__plans-image">
                  <picture>
                    {%- if plan_img_mob != blank -%}
                      <source media="(max-width: 749px)" srcset="{{ plan_img_mob | image_url: width: 800 }}">
                    {%- endif -%}
                    {%- assign plan_img_desk = block.settings.plan_image | default: block.settings.plan_image_mobile -%}
                    <img src="{{ plan_img_desk | image_url: width: 1000 }}" alt="" width="560" height="560" loading="lazy">
                  </picture>
                </div>
              {%- endif -%}
              <div class="ftdc__plans" data-plan-order="{{ block.settings.plan_order | default: 'quarterly,monthly,onetime' }}">
                {%- if show_quarterly -%}
                  <label class="ftdc__plan is-active" data-plan="quarterly">
                    <input type="radio" name="ftdc-plan-{{ sid }}" value="quarterly" checked>
                    <span class="ftdc__plan-tick" aria-hidden="true"></span>
                    {%- if block.settings.quarterly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.quarterly_badge }}</span>{%- endif -%}
                    <div class="ftdc__plan-title">{{ block.settings.quarterly_title | default: '3 Pouches Every 3 Months' }}</div>
                    {%- if block.settings.quarterly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.quarterly_desc }}</div>{%- endif -%}
                    <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.quarterly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ block.settings.quarterly_period | default: '/ month' }}</span></div>
                    {%- if block.settings.quarterly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.quarterly_was }}</div>{%- endif -%}
                  </label>
                {%- endif -%}
                {%- if show_monthly -%}
                  <label class="ftdc__plan" data-plan="monthly">
                    <input type="radio" name="ftdc-plan-{{ sid }}" value="monthly">
                    <span class="ftdc__plan-tick" aria-hidden="true"></span>
                    {%- if block.settings.monthly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.monthly_badge }}</span>{%- endif -%}
                    <div class="ftdc__plan-title">{{ block.settings.monthly_title | default: '1 Pouch Every Month' }}</div>
                    {%- if block.settings.monthly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.monthly_desc }}</div>{%- endif -%}
                    <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.monthly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ block.settings.monthly_period | default: '/ month' }}</span></div>
                    {%- if block.settings.monthly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.monthly_was }}</div>{%- endif -%}
                  </label>
                {%- endif -%}
                {%- if show_onetime -%}
                  <label class="ftdc__plan" data-plan="onetime">
                    <input type="radio" name="ftdc-plan-{{ sid }}" value="onetime">
                    <span class="ftdc__plan-tick" aria-hidden="true"></span>
                    {%- if block.settings.onetime_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.onetime_badge }}</span>{%- endif -%}
                    <div class="ftdc__plan-title">{{ block.settings.onetime_title | default: 'Single Pouch' }}</div>
                    {%- if block.settings.onetime_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.onetime_desc }}</div>{%- endif -%}
                    <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.onetime_price | default: '$59.00' }}</span><span class="ftdc__plan-period">{{ block.settings.onetime_period | default: '/ pouch' }}</span></div>
                    {%- assign _ow = block.settings.onetime_was | strip -%}
                    {%- if _ow != blank and _ow != '-' and _ow != '—' -%}<div class="ftdc__plan-was">{{ block.settings.onetime_was }}</div>{%- endif -%}
                  </label>
                {%- endif -%}
              </div>
            </div>

            {%- comment %} ───── STEP 2 — PRODUCTS ───── {%- endcomment %}
            <div class="ftdc__step" data-step="products" hidden>
              <button class="ftdc__back" type="button" data-step-back="plans" aria-label="Back to plan"><span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}</button>
              <div class="ftdc__bundle-head">
                <p class="ftdc__bundle-eyebrow">{{ block.settings.bundle_label | default: 'Your Bundle' }}</p>
                <p class="ftdc__bundle-progress-text" data-progress-text>0 {{ block.settings.of_word | default: 'of' }} {{ bundle_count }} {{ block.settings.selected_word | default: 'selected' }}</p>
                <div class="ftdc__bundle-bar"><div class="ftdc__bundle-bar-fill" data-progress-fill style="width:0%"></div></div>
                <p class="ftdc__bundle-warning" data-bar-warning hidden role="status"></p>
              </div>
              <div class="ftdc__empty" data-grid-empty hidden>
                <p><strong>No products configured yet.</strong></p>
                <p>In the theme editor sidebar, click each <em>Function</em> block inside this slide-over and pick a Shopify product. Each product variant will render as a selectable card here.</p>
              </div>
              <div class="ftdc__grid" data-grid></div>

              {%- comment %} ── Add-ons (merged from old Step 3) ── {%- endcomment %}
              <div class="ftdc__bundle-addons">
                <p class="ftdc__bundle-eyebrow ftdc__bundle-addons-head">{{ block.settings.addons_label | default: 'Add to your order' }}</p>

                {%- assign included_img = block.settings.addon_image | default: addon.featured_image -%}
                <div class="ftdc__upsell ftdc__upsell--included" data-creatine-included hidden aria-hidden="true">
                  <div class="ftdc__upsell-media">
                    {%- if included_img != blank -%}
                      <img src="{{ included_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">
                    {%- endif -%}
                  </div>
                  <div class="ftdc__upsell-body">
                    <p class="ftdc__upsell-title">Creatine — Included</p>
                    <p class="ftdc__upsell-desc">Free with your 3-month bundle.</p>
                    <div class="ftdc__upsell-pricing">
                      <span class="ftdc__upsell-price ftdc__upsell-price--free">FREE</span>
                    </div>
                  </div>
                  <div class="ftdc__upsell-toggle">
                    <span class="ftdc__included-check" aria-label="Included" role="img">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4 4 10-10" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                </div>

                {%- if addon != blank -%}
                  <div class="ftdc__upsell ftdc__upsell--creatine" data-upsell-creatine>
                    <div class="ftdc__upsell-media">
                      {%- assign addon_img = block.settings.addon_image | default: addon.featured_image -%}
                      {%- if addon_img != blank -%}<img src="{{ addon_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">{%- endif -%}
                    </div>
                    <div class="ftdc__upsell-body">
                      <p class="ftdc__upsell-title" data-creatine-title>{{ block.settings.addon_label_monthly | default: 'Add Creatine — 50% off' }}</p>
                      <p class="ftdc__upsell-desc" data-creatine-desc>{{ block.settings.addon_desc_monthly | default: '' }}</p>
                      <div class="ftdc__upsell-pricing">
                        <span class="ftdc__upsell-price" data-creatine-price>{{ block.settings.addon_price_monthly | default: '$12.00' }}</span>
                        {%- if block.settings.addon_was_monthly != blank -%}<s class="ftdc__upsell-was" data-creatine-was>{{ block.settings.addon_was_monthly }}</s>{%- endif -%}
                      </div>
                    </div>
                    <div class="ftdc__upsell-toggle">
                      <input type="checkbox" id="ftdc-cr-{{ sid }}" class="visually-hidden" data-creatine-input data-variant="{{ addon_variant_id }}" data-plan-monthly="{{ block.settings.addon_loop_plan_monthly }}" data-plan-quarterly-free="{{ block.settings.addon_loop_plan_quarterly_free }}" data-plan-quarterly-50off="{{ block.settings.addon_loop_plan_quarterly_50off }}" data-discount-onetime="{{ block.settings.addon_discount_code_onetime }}">
                      <label for="ftdc-cr-{{ sid }}" class="ftdc__switch" aria-hidden="true"></label>
                    </div>
                  </div>
                {%- endif -%}

                <div class="ftdc__upsells" data-upsells></div>
              </div>
            </div>

            {%- comment %} ───── STEP 4 — REVIEW ───── {%- endcomment %}
            <div class="ftdc__step" data-step="review" hidden>
              <button class="ftdc__back" type="button" data-step-back="products" aria-label="Back to bundle"><span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}</button>
              <div class="ftdc__bundle-head">
                <p class="ftdc__bundle-eyebrow">{{ block.settings.review_eyebrow | default: 'Review your order' }}</p>
                <p class="ftdc__review-plan" data-review-plan></p>
              </div>
              <ul class="ftdc__review-lines list-unstyled" data-review-lines></ul>
              <div class="ftdc__review-extra" data-review-extra hidden></div>
              <dl class="ftdc__review-totals">
                <div class="ftdc__review-row ftdc__review-row--saved" data-review-saved-wrap hidden>
                  <dt>{{ block.settings.saved_word | default: 'Saved' }}</dt>
                  <dd data-review-saved>$0.00</dd>
                </div>
                <div class="ftdc__review-row ftdc__review-row--total">
                  <dt>{{ block.settings.total_label | default: 'Total' }}</dt>
                  <dd data-review-total>$0.00</dd>
                </div>
              </dl>
              <div class="ftdc__step-actions">
                <button class="ftdc__btn ftdc__btn--ghost" type="button" data-step-back="products">{{ block.settings.edit_order_label | default: 'Edit Order' }}</button>
                <button class="ftdc__btn ftdc__btn--primary" type="button" data-action="checkout">{{ block.settings.checkout_label | default: 'Checkout' }}</button>
              </div>
            </div>

            <div class="ftdc__bar" data-bar>
              <div class="ftdc__bar-summary">
                <span class="ftdc__bar-total"><strong>{{ block.settings.total_label | default: 'Total' }}:</strong> <span data-bar-total>$0.00</span></span>
                <span class="ftdc__bar-saved" data-bar-saved-wrap hidden>({{ block.settings.saved_word | default: 'Saved' }} <span data-bar-saved>$0.00</span>)</span>
              </div>
              <button class="ftdc__bar-action" type="button" data-action="next"><span data-bar-label>{{ block.settings.action_label_step1 | default: 'Continue' }}</span></button>
            </div>

          </div>

          {%- comment %} Hidden staging: child theme blocks render here, JS moves them. {%- endcomment %}
          <div style="display:none" data-ftdc-stage aria-hidden="true">{% content_for 'blocks' %}</div>
        </section>
      </div>
    </div>
  </div>
</div>


<script>
  (window.__ftdDSOQueue = window.__ftdDSOQueue || []).push({
    SID: {{ block.id | json }},
    BUNDLE_COUNT: {{ bundle_count | json }},
    PLAN_NAMES: {
    monthly:   {{ block.settings.monthly_title   | default: 'Monthly Subscription' | json }},
    quarterly: {{ block.settings.quarterly_title | default: 'Quarterly Bundle'     | json }},
    onetime:   {{ block.settings.onetime_title   | default: 'One-Time Purchase'    | json }}
  },
    BAR_LABELS: {
    plans:    {{ block.settings.action_label_step1 | default: 'Continue'     | json }},
    products: {{ block.settings.action_label_step2 | default: 'Review Order' | json }},
    review:   {{ block.settings.checkout_label      | default: 'Checkout'     | json }}
  },
    LOOP_BUNDLE: {
    enabled:           {{ block.settings.loop_bundle_enabled | json }},
    bundleId:          {{ block.settings.loop_bundle_id | default: '' | json }},
    bundleVariantId:   {{ block.settings.loop_bundle_variant_id | default: '' | json }},
    bundleDiscountId:  {{ block.settings.loop_bundle_discount_id | default: '' | json }},
    apiSellingPlanId:  {{ block.settings.loop_bundle_api_selling_plan_id | default: '' | json }},
    cartSellingPlanId: {{ block.settings.loop_bundle_selling_plan_id | default: '' | json }},
    bundleName:        {{ block.settings.loop_bundle_name | default: '' | json }},
    propKey:           {{ block.settings.loop_bundle_property_key | default: '_bundleId' | json }}
  },
    TRIGGER_HREF: {{ block.settings.trigger_href | default: '#open-bundle' | json }},
    CART_CLICK_ON: {{ block.settings.open_on_cart_click | default: true | json }},
    CART_CLICK_SEL: {{ block.settings.cart_trigger_selector | default: '[data-testid="cart-drawer-trigger"], [data-testid="cart-icon"], a.action__cart' | json }},
    MONTHLY_PCT: {{ block.settings.monthly_estimate_pct | default: 90 }},
    QUARTERLY_PCT: {{ block.settings.quarterly_estimate_pct | default: 90 }}
  });
  if (window.__ftdDSOMain) window.__ftdDSOMain();
</script>
<script src="{{ 'ftd-selector-d-so.js' | asset_url }}" defer></script>

