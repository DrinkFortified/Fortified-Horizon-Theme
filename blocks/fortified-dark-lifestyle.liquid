{% render 'fortified-base' %}

{%- liquid
  assign img = block.settings.image
  assign cta_label = block.settings.cta_label
  assign cta_url = block.settings.cta_url | default: '#'
-%}

<div
  class="fortified-dark-lifestyle color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-dark-lifestyle__inner">
    <div class="fortified-dark-lifestyle__media">
      {% if img != blank %}
        {{ img | image_url: width: 1600 | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            class: 'fortified-dark-lifestyle__img',
            alt: img.alt | default: block.settings.heading,
            loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="fortified-dark-lifestyle__copy">
      {% if block.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ block.settings.heading | newline_to_br }}</h2>
      {% endif %}
      {% if block.settings.body != blank %}
        <p class="fortified-body fortified-dark-lifestyle__body">{{ block.settings.body }}</p>
      {% endif %}
      {% if cta_label != blank %}
        <a href="{{ cta_url }}" class="fortified-btn fortified-btn--white">{{ cta_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fortified-dark-lifestyle {
    background: var(--color-background, #0A0A0A);
    color: var(--color-foreground, #fff);
    padding-block: var(--fortified-section-py);
    overflow: hidden;
  }
  .fortified-dark-lifestyle__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fortified-dark-lifestyle__inner { grid-template-columns: 1fr 1fr; }
  }
  .fortified-dark-lifestyle__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
  }
  .fortified-dark-lifestyle__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fortified-dark-lifestyle__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .fortified-dark-lifestyle__body {
    max-width: 52ch;
    margin: 4px 0 8px;
    opacity: .9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Dark Lifestyle",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE TRUTH" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "MORE THAN HYDRATION\nIT'S DAILY SUPPORT" },
    { "type": "textarea", "id": "body", "label": "Body text" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "EXPLORE ALL FLAVORS" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified Dark Lifestyle", "category": "Fortified" }
  ]
}
{% endschema %}
