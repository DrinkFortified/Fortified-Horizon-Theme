{% comment %}
  Fortified Stat Chart
  ----------------------------------------------------------------------
  A comparison stat card: large headline number (with count-up
  animation), descriptive headline + subtitle, two vertical bars over
  3 reference lines (0 / 50 / 100), and an optional footnote.

  Every text element exposes Shopify-style typography controls (font,
  size, weight, line-height, letter-spacing, case, color).

  Animations:
    - Headline counts up from 0 on scroll into view.
    - Bars grow from 0 to their target height.
    - Honors prefers-reduced-motion.

  Accessibility:
    - role="img" with auto-generated aria-label describing both bars.
    - Grid lines + Y-axis labels are aria-hidden.
{% endcomment %}

{% liquid
  assign id = block.id | replace: '_', '' | downcase
  assign root = 'fsc-' | append: id

  assign hn   = block.settings.headline_number
  assign ht   = block.settings.headline_text
  assign sub  = block.settings.subtitle_text
  assign foot = block.settings.footnote_text
  assign b1l  = block.settings.bar1_label
  assign b1v  = block.settings.bar1_value
  assign b2l  = block.settings.bar2_label
  assign b2v  = block.settings.bar2_value

  capture aria
    echo 'Comparison chart. '
    echo b1l | append: ': ' | append: b1v | append: '. '
    echo b2l | append: ': ' | append: b2v | append: '.'
  endcapture
%}

{%- comment -%} Resolve Y-axis padding once so we don't repeat the conditional. {%- endcomment -%}
{% if block.settings.yaxis_show %}
  {% assign yaxis_pad = 38 %}
{% else %}
  {% assign yaxis_pad = 0 %}
{% endif %}

<style>
  .{{ root }} {
    --fsc-bg:        {{ block.settings.background_color }};
    --fsc-border:    {{ block.settings.border_color }};
    --fsc-border-w:  {{ block.settings.border_width }}px;
    --fsc-radius:    {{ block.settings.border_radius }}px;
    --fsc-pad:       {{ block.settings.padding }}px;
    --fsc-gap:       {{ block.settings.section_gap }}px;

    --fsc-grid:      {{ block.settings.grid_line_color }};
    --fsc-scale:     {{ block.settings.scale_label_color }};
    --fsc-bar1:      {{ block.settings.bar1_color }};
    --fsc-bar2:      {{ block.settings.bar2_color }};
    --fsc-bar-w:     {{ block.settings.bar_width }}px;
    --fsc-bar-gap:   {{ block.settings.bar_gap }}px;
    --fsc-bar-r:     {{ block.settings.bar_border_radius }}px;
    --fsc-chart-h:   {{ block.settings.chart_height }}px;

    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-width: 0;
    flex: 1 1 0;
    margin: 0 auto;
    background: var(--fsc-bg);
    border: var(--fsc-border-w) solid var(--fsc-border);
    border-radius: var(--fsc-radius);
    padding: var(--fsc-pad);
    box-sizing: border-box;
    text-align: {{ block.settings.text_alignment }};
    display: flex;
    flex-direction: column;
    gap: var(--fsc-gap);
  }

  /* ── Equal-width fix ──────────────────────────────────────────────
     This card is wrapped by Horizon's group block:
       .group-block--width-fill  (the flex item, gets `flex: 1`)
         > .group-block-content.layout-panel-flex--column
             > .{{ root }}  (this card)
     The flex item that's actually distributed is the WRAPPER, not this
     card. `flex: 1` resolves to `flex: 1 1 0%` but the wrapper keeps the
     default `min-width: auto`, so its min-content width (driven by this
     card's fixed-px bars + Y-axis padding + card padding) sets a floor it
     refuses to shrink below. A sibling card with small content (the
     checkmark list) shrinks freely, so the columns end up unequal.
     Setting min-width:0 on the wrapper + its content lets the flex
     algorithm distribute all columns to an equal 1/3 share. */
  .group-block--width-fill:has(> .group-block-content > .{{ root }}),
  .group-block--width-fill:has(> .group-block-content > .{{ root }}) > .group-block-content {
    min-width: 0;
  }

  /* Let the card's own internal flex children shrink too, so the card's
     min-content width isn't pinned wide by the bar/label rows. */
  .{{ root }} .fsc-chart,
  .{{ root }} .fsc-chart-wrap,
  .{{ root }} .fsc-bars,
  .{{ root }} .fsc-lbls {
    min-width: 0;
  }

  /* ── Typography (per-element, generated from schema settings) ── */
  .{{ root }} .fsc-num {
    font-family: {{ block.settings.num_font }};
    font-size: {{ block.settings.num_size }}px;
    font-weight: {{ block.settings.num_weight }};
    line-height: {{ block.settings.num_line_height }};
    letter-spacing: {{ block.settings.num_letter_spacing }};
    text-transform: {{ block.settings.num_case }};
    color: {{ block.settings.num_color }};
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .{{ root }} .fsc-headline {
    font-family: {{ block.settings.headline_font }};
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    line-height: {{ block.settings.headline_line_height }};
    letter-spacing: {{ block.settings.headline_letter_spacing }};
    text-transform: {{ block.settings.headline_case }};
    color: {{ block.settings.headline_color }};
    margin: 0;
  }
  .{{ root }} .fsc-sub {
    font-family: {{ block.settings.sub_font }};
    font-size: {{ block.settings.sub_size }}px;
    font-weight: {{ block.settings.sub_weight }};
    line-height: {{ block.settings.sub_line_height }};
    letter-spacing: {{ block.settings.sub_letter_spacing }};
    text-transform: {{ block.settings.sub_case }};
    color: {{ block.settings.sub_color }};
    margin: 0;
  }
  .{{ root }} .fsc-lbl {
    font-family: {{ block.settings.lbl_font }};
    font-size: {{ block.settings.lbl_size }}px;
    font-weight: {{ block.settings.lbl_weight }};
    line-height: {{ block.settings.lbl_line_height }};
    letter-spacing: {{ block.settings.lbl_letter_spacing }};
    text-transform: {{ block.settings.lbl_case }};
    color: {{ block.settings.lbl_color }};
    margin: 0;
  }
  .{{ root }} .fsc-foot {
    font-family: {{ block.settings.foot_font }};
    font-size: {{ block.settings.foot_size }}px;
    font-weight: {{ block.settings.foot_weight }};
    font-style: {{ block.settings.foot_style }};
    line-height: {{ block.settings.foot_line_height }};
    letter-spacing: {{ block.settings.foot_letter_spacing }};
    text-transform: {{ block.settings.foot_case }};
    color: {{ block.settings.foot_color }};
    margin: 0;
  }

  /* ── Head group ── */
  .{{ root }} .fsc-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* ── Chart ── */
  .{{ root }} .fsc-chart {
    position: relative;
    height: var(--fsc-chart-h);
    padding-left: {{ yaxis_pad }}px;
  }

  /* Y-axis labels on the left */
  .{{ root }} .fsc-y {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    color: var(--fsc-scale);
    font-family: {{ block.settings.scale_font }};
    font-size: {{ block.settings.scale_size }}px;
    font-weight: 400;
    line-height: 1;
  }
  .{{ root }} .fsc-y--0   { top: calc(100% - 1px); }
  .{{ root }} .fsc-y--50  { top: 50%; }
  .{{ root }} .fsc-y--100 { top: 0; }

  /* Dashed reference lines */
  .{{ root }} .fsc-grid {
    position: absolute;
    left: calc({{ yaxis_pad }}px);
    right: 0;
    height: 0;
    border-top: 1px dashed var(--fsc-grid);
  }
  .{{ root }} .fsc-grid--0   { top: calc(100% - 1px); }
  .{{ root }} .fsc-grid--50  { top: 50%; }
  .{{ root }} .fsc-grid--100 { top: 0; }

  /* Bars area — bars are direct flex children so % heights resolve correctly */
  .{{ root }} .fsc-bars {
    position: absolute;
    left: calc({{ yaxis_pad }}px);
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: var(--fsc-bar-gap);
    pointer-events: none;
  }
  .{{ root }} .fsc-bar {
    width: var(--fsc-bar-w);
    max-width: 38%;
    /* Height is set inline per-bar via style="height:N%". This guarantees
       the bar renders at its target height even if JS never fires
       (e.g. theme editor iframe quirks). JS only re-animates from 0. */
    border-radius: var(--fsc-bar-r) var(--fsc-bar-r) 0 0;
    transition: height 1100ms cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: height;
    pointer-events: auto;
  }
  .{{ root }} .fsc-bar:nth-child(1) { background: var(--fsc-bar1); }
  .{{ root }} .fsc-bar:nth-child(2) { background: var(--fsc-bar2); }

  /* Labels under bars */
  .{{ root }} .fsc-lbls {
    display: flex;
    justify-content: center;
    gap: var(--fsc-bar-gap);
    padding-left: calc({{ yaxis_pad }}px);
    margin-top: 14px;
  }
  .{{ root }} .fsc-lbl {
    width: var(--fsc-bar-w);
    max-width: 38%;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .{{ root }} .fsc-bar { transition: none !important; }
  }

  @media (max-width: 600px) {
    .{{ root }} { padding: max(20px, calc(var(--fsc-pad) * 0.6)); }
    .{{ root }} .fsc-chart { height: calc(var(--fsc-chart-h) * 0.8); }
  }
</style>

<div
  class="{{ root }}"
  data-block-id="{{ block.id }}"
  role="img"
  aria-label="{{ aria | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% if hn != blank or ht != blank or sub != blank %}
    <div class="fsc-head">
      {% if hn != blank %}<p class="fsc-num" data-target="{{ hn | strip }}">{{ hn }}</p>{% endif %}
      {% if ht != blank %}<p class="fsc-headline">{{ ht }}</p>{% endif %}
      {% if sub != blank %}<p class="fsc-sub">{{ sub }}</p>{% endif %}
    </div>
  {% endif %}

  <div class="fsc-chart-wrap">
    <div class="fsc-chart">
      {% if block.settings.yaxis_show %}
        <span class="fsc-y fsc-y--100" aria-hidden="true">100</span>
        <span class="fsc-y fsc-y--50"  aria-hidden="true">50</span>
        <span class="fsc-y fsc-y--0"   aria-hidden="true">0</span>
      {% endif %}

      <div class="fsc-grid fsc-grid--100" aria-hidden="true"></div>
      <div class="fsc-grid fsc-grid--50"  aria-hidden="true"></div>
      <div class="fsc-grid fsc-grid--0"   aria-hidden="true"></div>

      <div class="fsc-bars" aria-hidden="true">
        <div class="fsc-bar" data-target="{{ b1v }}" style="height: {{ b1v }}%;"></div>
        <div class="fsc-bar" data-target="{{ b2v }}" style="height: {{ b2v }}%;"></div>
      </div>
    </div>

    <div class="fsc-lbls" aria-hidden="true">
      <p class="fsc-lbl">{{ b1l }}</p>
      <p class="fsc-lbl">{{ b2l }}</p>
    </div>
  </div>

  {% if foot != blank %}
    <p class="fsc-foot">{{ foot }}</p>
  {% endif %}
</div>

<script>
(function () {
  var root = document.querySelector('[data-block-id="{{ block.id }}"]');
  if (!root) return;

  var bars     = root.querySelectorAll('.fsc-bar');
  var numberEl = root.querySelector('.fsc-num');
  var reduce   = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Bars already render at their target height inline. If reduced motion
  // is on or IntersectionObserver isn't available, leave them as-is —
  // they're already correct.
  if (reduce || !('IntersectionObserver' in window)) return;

  // Save target heights, briefly snap to 0, then on scroll-in animate up.
  var targets = [];
  bars.forEach(function (bar) {
    targets.push(bar.style.height || '0%');
    bar.style.height = '0%';
  });

  function countUp () {
    if (!numberEl) return;
    var raw   = numberEl.getAttribute('data-target') || '';
    var match = raw.match(/-?\d+(\.\d+)?/);
    if (!match) return;
    var target = parseFloat(match[0]);
    if (isNaN(target)) return;
    var prefix   = raw.slice(0, match.index);
    var suffix   = raw.slice(match.index + match[0].length);
    var decimals = (match[0].split('.')[1] || '').length;

    var start    = performance.now();
    var duration = 1200;

    function frame (now) {
      var t = Math.min(1, (now - start) / duration);
      var eased = 1 - Math.pow(1 - t, 3);
      var current = (target * eased).toFixed(decimals);
      numberEl.textContent = prefix + current + suffix;
      if (t < 1) requestAnimationFrame(frame);
    }
    numberEl.textContent = prefix + (0).toFixed(decimals) + suffix;
    requestAnimationFrame(frame);
  }

  function reveal () {
    // Force reflow so the transition catches the height change.
    void root.offsetWidth;
    bars.forEach(function (bar, i) {
      bar.style.height = targets[i];
    });
    countUp();
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        reveal();
        io.disconnect();
      }
    });
  }, { threshold: 0.15 });

  io.observe(root);

  // Failsafe: if the observer hasn't fired within 2 seconds, just paint
  // the bars at their target heights. Catches edge cases like Shopify
  // theme editor iframes that don't always trigger IO.
  setTimeout(function () {
    var anyAt0 = false;
    bars.forEach(function (bar) {
      if (bar.style.height === '0%') anyAt0 = true;
    });
    if (anyAt0) {
      bars.forEach(function (bar, i) { bar.style.height = targets[i]; });
    }
  }, 2000);
})();
</script>

{% schema %}
