  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "section_gap",        "label": "Gap between blocks",    "min": 8,  "max": 64,  "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width",      "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },

    { "type": "header", "content": "Card container" },
