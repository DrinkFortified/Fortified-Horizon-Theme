{% comment %}
  Fortified Checkmark List
  ----------------------------------------------------------------------
  A heading + a list of checkmark items. Each item is a child block of
  type "fortified-checkmark-item" — the merchant adds/removes/reorders
  items in the editor.

  Designed as a drop-in replacement for any "row" of content inside a
  Tab Panel — for example, swap an ingredient row with this for a
  "Improve Hydration / Boost Energy / Support Muscle Function" list.
{% endcomment %}

{% liquid
  assign id = block.id | replace: '_', '' | downcase
  assign root = 'fcl-' | append: id

  # Canonical 4-way padding (Horizon standard IDs). To avoid breaking
  # existing blocks that only saved the legacy single `padding`, fall back
  # to that value on any side whose 4-way control is still 0.
  assign pad_legacy = block.settings.padding
  assign pad_top = block.settings['padding-block-start']
  assign pad_bottom = block.settings['padding-block-end']
  assign pad_left = block.settings['padding-inline-start']
  assign pad_right = block.settings['padding-inline-end']
  assign pad_sum = pad_top | plus: pad_bottom | plus: pad_left | plus: pad_right
  if pad_sum == 0
    assign pad_top = pad_legacy
    assign pad_bottom = pad_legacy
    assign pad_left = pad_legacy
    assign pad_right = pad_legacy
  endif

  assign background_c   = block.settings.background_color      | default: 'var(--color-background)'
  assign border_c       = block.settings.border_color          | default: 'var(--color-border)'
  assign text_c         = block.settings.text_color            | default: 'var(--color-foreground)'
  assign num_color_c    = block.settings.headline_number_color | default: 'var(--color-foreground-heading)'
  assign headline_c     = block.settings.headline_color        | default: 'var(--color-foreground-heading)'
  assign subtitle_c     = block.settings.subtitle_color        | default: 'var(--color-foreground)'
  assign footnote_c     = block.settings.footnote_color        | default: 'var(--color-foreground)'
%}

<style>
  /* ── Equal-width fix ──────────────────────────────────────────────
     VERIFIED against snippets/group.liquid: every group block renders
         <div class="group-block group-block--width-fill ...">
           <div class="group-block-content layout-panel-flex ...">
             {{ children }}   <-- this card, .{{ root }}
     and base.css 3824: `.layout-panel-flex--row > .group-block--width-fill
     { flex: 1; }`. The distributed flex item is the WRAPPER, whose default
     `min-width: auto` lets a heavier sibling (the stat chart, ~280px of
     fixed-px bars) keep this lighter column below its 1/3 share. Clear the
     min-width floor on the wrapper, its content, and (via the row-level
     :has) on every width-fill sibling so all columns equalize. */
  /* ── Equal size: every card in the row gets the same width AND height ──
     Each card sits in a .group-block--width-fill wrapper inside the row.
     (a) divide width evenly (clear the min-width floor, flex-basis:0);
     (b) force the row to stretch every wrapper to the tallest card;
     (c) make each wrapper, its content panel, and the card itself fill
     that height. These target EVERY width-fill sibling in the row, so the
     stat-chart cards are equalised to match this list (and vice-versa). */
  .group-block--width-fill:has(> .group-block-content > .{{ root }}),
  .group-block--width-fill:has(> .group-block-content > .{{ root }}) > .group-block-content {
    min-width: 0;
  }
  .layout-panel-flex--row:has(> .group-block--width-fill > .group-block-content > .{{ root }}) {
    align-items: stretch !important;
  }
  .layout-panel-flex--row:has(> .group-block--width-fill > .group-block-content > .{{ root }}) > .group-block--width-fill {
    min-width: 0;
    flex-basis: 0;
    align-self: stretch;
  }
  .layout-panel-flex--row:has(> .group-block--width-fill > .group-block-content > .{{ root }}) > .group-block--width-fill > .group-block-content {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .layout-panel-flex--row:has(> .group-block--width-fill > .group-block-content > .{{ root }}) > .group-block--width-fill > .group-block-content > * {
    height: 100%;
  }

  {% if block.settings.mobile_scroll %}
  /* ── Mobile: scroll the cards sideways instead of stacking ── */
  @media (max-width: 749px) {
    .layout-panel-flex--row:has(> .group-block--width-fill > .group-block-content > .{{ root }}) {
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding-inline: 16px;
    }
    .layout-panel-flex--row:has(> .group-block--width-fill > .group-block-content > .{{ root }}) > .group-block--width-fill {
      flex: 0 0 82% !important;
      scroll-snap-align: start;
    }
  }
  {% endif %}

  .{{ root }} {
    /* Fill the column when this block sits inside a flex row.
       flex: 1 1 0 + min-width: 0 ensures equal share with sibling cards
       (e.g. fortified-stat-chart). width: 100% is the fallback when the
       parent isn't a flex container. When "Fit content" is chosen the card
       shrinks to its content instead of filling the row. */
    {% if block.settings.block_width == 'fit' %}
    flex: 0 0 auto;
    width: auto;
    {% else %}
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    {% endif %}
    {% if block.settings.match_sibling_height %}
    align-self: stretch;
    display: flex;
    flex-direction: column;
    {% endif %}
    background: {{ background_c }};
    border: {{ block.settings.border_width }}px solid {{ border_c }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ pad_top }}px {{ pad_right }}px {{ pad_bottom }}px {{ pad_left }}px;
    box-sizing: border-box;
    font-family: var(--font-body--family, inherit);
    color: {{ text_c }};
    text-align: {{ block.settings.text_alignment }};
  }
  {% if block.settings.match_sibling_height %}
  .{{ root }} .fcl-items {
    margin-top: auto;
  }
  {% endif %}
  .{{ root }} .fcl-head {
    margin: 0 0 {{ block.settings.gap_after_heading }}px;
  }
  .{{ root }} .fcl-num {
    font-family: var(--font-heading--family, inherit);
    font-size: {{ block.settings.headline_number_size }}px;
    font-weight: 800;
    line-height: 1;
    color: {{ num_color_c }};
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }
  .{{ root }} .fcl-headline {
    font-family: var(--font-heading--family, inherit);
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ headline_c }};
    margin: 0;
  }
  .{{ root }} .fcl-subtitle {
    font-family: var(--font-body--family, inherit);
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ subtitle_c }};
    line-height: 1.4;
    margin: 6px 0 0;
  }
  .{{ root }} .fcl-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_gap }}px;
  }

  /* Footnote — small grey italic line at the bottom of the card, matching
     the .fsc-foot treatment on the stat-chart card so all three cards in
     the row share the same bottom text. Placed after the items. */
  .{{ root }} .fcl-foot {
    margin: {{ block.settings.footnote_gap }}px 0 0;
    font-family: var(--font-body--family, inherit);
    font-size: {{ block.settings.footnote_size }}px;
    font-style: italic;
    line-height: 1.4;
    color: {{ footnote_c }};
  }
</style>

<div class="{{ root }}{% if block.settings.color_scheme != blank %} color-{{ block.settings.color_scheme }}{% endif %}" {{ block.shopify_attributes }}>
  {% if block.settings.headline_number != blank
        or block.settings.headline_text != blank
        or block.settings.subtitle != blank %}
    <div class="fcl-head">
      {% if block.settings.headline_number != blank %}
        <p class="fcl-num">{{ block.settings.headline_number }}</p>
      {% endif %}
      {% if block.settings.headline_text != blank %}
        <p class="fcl-headline">{{ block.settings.headline_text }}</p>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="fcl-subtitle">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if block.blocks.size > 0 %}
    <ul class="fcl-items">
      {% content_for 'blocks' %}
    </ul>
  {% endif %}

  {% if block.settings.footnote_text != blank %}
    <p class="fcl-foot">{{ block.settings.footnote_text }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "FTD - Checkmark List",
  "settings": [
    {
      "type": "header",
      "content": "Headline (optional)"
    },
    {
      "type": "text",
      "id": "headline_number",
      "label": "Number",
      "default": "0%"
    },
    {
      "type": "range",
      "id": "headline_number_size",
      "label": "Number size",
      "min": 32,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "color",
      "id": "headline_number_color",
      "label": "Number color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Headline",
      "default": "No Sugar. No Crash."
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "in high intensity workouts *"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "gap_after_heading",
      "label": "Gap below heading (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "header",
      "content": "Items"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items (px)",
      "min": 4,
      "max": 28,
      "step": 2,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "match_sibling_height",
      "label": "Match height of sibling cards",
      "default": true,
      "info": "When this card sits beside taller cards in a row layout, push the checkmarks to the bottom so the card fills the row height."
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "text",
      "id": "footnote_text",
      "label": "Text",
      "default": "* Based on internal product testing",
      "info": "Small grey italic line at the bottom of the card, matching the stat cards."
    },
    {
      "type": "range",
      "id": "footnote_size",
      "label": "Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "footnote_gap",
      "label": "Gap above footnote (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "color",
      "id": "footnote_color",
      "label": "Color",
      "default": "#888888"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E5E7EB"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding (legacy / fallback)",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32,
      "info": "Used as the card padding on all sides unless you set per-side values in the Padding group below."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text color",
      "default": "#0A0A0A"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "Fill column"
        },
        {
          "value": "fit",
          "label": "Fit content"
        }
      ],
      "info": "Fill makes the card share row width equally with sibling cards. Fit shrinks it to its content."
    },
    {
      "type": "checkbox",
      "id": "mobile_scroll",
      "label": "Scroll cards sideways on mobile",
      "default": true,
      "info": "On phones, the cards in this row scroll horizontally (swipe) instead of stacking."
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "fortified-checkmark-item"
    }
  ],
  "presets": [
    {
      "name": "FTD - Checkmark List",
      "category": "Fortified",
      "blocks": [
        {
          "type": "fortified-checkmark-item",
          "settings": {
            "text": "Improve Hydration"
          }
        },
        {
          "type": "fortified-checkmark-item",
          "settings": {
            "text": "Boost Energy Naturally"
          }
        },
        {
          "type": "fortified-checkmark-item",
          "settings": {
            "text": "Support Muscle Function"
          }
        }
      ]
    }
  ]
}
{% endschema %}
