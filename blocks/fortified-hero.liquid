{% render 'fortified-base' %}

{%- liquid
  assign img = block.settings.image
  assign primary_label = block.settings.cta_primary_label
  assign primary_url = block.settings.cta_primary_url | default: '#'
  assign secondary_label = block.settings.cta_secondary_label
  assign secondary_url = block.settings.cta_secondary_url | default: '#'
  assign image_side = block.settings.image_side
-%}

<div
  class="fortified-hero fortified-hero--{{ image_side }}"
  style="--fortified-hero-bg: {{ block.settings.bg_color }}; --fortified-hero-fg: {{ block.settings.text_color }};"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-hero__inner">
    <div class="fortified-hero__copy">
      {% if block.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h1 class="fortified-heading fortified-h1">{{ block.settings.heading }}</h1>
      {% endif %}
      {% if block.settings.body != blank %}
        <p class="fortified-body fortified-hero__body">{{ block.settings.body }}</p>
      {% endif %}
      {% if primary_label != blank or secondary_label != blank %}
        <div class="fortified-hero__ctas">
          {% if primary_label != blank %}
            <a href="{{ primary_url }}" class="fortified-btn fortified-btn--primary">{{ primary_label }}</a>
          {% endif %}
          {% if secondary_label != blank %}
            <a href="{{ secondary_url }}" class="fortified-btn fortified-btn--ghost">{{ secondary_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="fortified-hero__art">
      {% if img != blank %}
        {{ img | image_url: width: 1600 | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            class: 'fortified-hero__image',
            alt: img.alt | default: block.settings.heading,
            loading: 'eager',
            fetchpriority: 'high' }}
      {% else %}
        <div class="fortified-hero__image-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'fortified-hero__image-placeholder-svg' }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fortified-hero {
    background: var(--fortified-hero-bg, var(--fortified-off-white));
    color: var(--fortified-hero-fg, var(--fortified-black));
    padding-block: var(--fortified-section-py);
    overflow: hidden;
  }
  .fortified-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fortified-hero__inner { grid-template-columns: 1.05fr 1fr; }
    .fortified-hero--left .fortified-hero__inner { direction: rtl; }
    .fortified-hero--left .fortified-hero__inner > * { direction: ltr; }
  }
  .fortified-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .fortified-hero__body { max-width: 52ch; margin: 4px 0 8px; }
  .fortified-hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .fortified-hero__art {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 280px;
  }
  .fortified-hero__image {
    width: 100%;
    height: auto;
    max-width: 640px;
    object-fit: contain;
  }
  .fortified-hero__image-placeholder-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    color: var(--fortified-gray-light);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Hero",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FORMULATED FOR" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "HYDRATION THAT HITS" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Premium electrolytes that fuel your every move. Clinically dosed, clean, and zero sugar." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "LEARN MORE" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "image_picker", "id": "image", "label": "Hero product image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#F7F7F7" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0A0A0A" }
  ],
  "presets": [
    {
      "name": "Fortified Hero",
      "category": "Fortified"
    }
  ]
}
{% endschema %}
