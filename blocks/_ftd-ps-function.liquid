{%- comment -%}
  Nested theme block: a single "function" inside the FTD Product Selector.

  Self-rendering. Theme blocks cannot be iterated from the parent's Liquid
  scope — block.blocks comes back empty — so the parent renders us into a
  hidden staging area with {% content_for 'blocks' %} and its JS reads the
  data attributes below to build a card per pouch. Same approach the
  homepage selector (_ftd-c-function) uses.

  Nothing here reads parent settings: this block sits inside a BLOCK inside
  a section, so block.section.settings would resolve to the enclosing
  product-information section, not the selector. Labels come from the
  parent's JS config instead.
{%- endcomment -%}

{%- liquid
  assign prod = block.settings.product
  assign cardimg = block.settings.card_image | default: block.settings.thumbnail_image
  if cardimg == blank and prod != blank
    assign cardimg = prod.featured_image
  endif

  # Which variant option holds the flavor.
  assign flavor_opt = null
  if prod != blank and prod.options_with_values.size > 0
    assign want = block.settings.flavor_option | downcase | strip
    if want != blank
      for opt in prod.options_with_values
        assign have = opt.name | downcase | strip
        if have == want
          assign flavor_opt = opt
        endif
      endfor
    endif
    if flavor_opt == null
      assign flavor_opt = prod.options_with_values.first
    endif
  endif
-%}

<div
  data-ftd-ps-fn
  data-fn-id="{{ block.id }}"
  data-fn-label="{{ block.settings.function_label | escape }}"
  data-enabled="{% if block.settings.enabled %}1{% else %}0{% endif %}"
  data-product-handle="{{ prod.handle }}"
  data-coming-soon="{% if block.settings.coming_soon %}1{% else %}0{% endif %}"
  data-spec-1="{{ block.settings.spec_1 | escape }}"
  data-spec-2="{{ block.settings.spec_2 | escape }}"
  data-spec-3="{{ block.settings.spec_3 | escape }}"
  data-description="{{ block.settings.description | escape }}"
  data-plan-monthly="{{ block.settings.loop_plan_monthly }}"
  data-plan-quarterly="{{ block.settings.loop_plan_quarterly }}"
  data-card-image="{% if cardimg != blank %}{{ cardimg | image_url: width: 480 }}{% endif %}"
  data-thumbnail="{% if block.settings.thumbnail_image != blank %}{{ block.settings.thumbnail_image | image_url: width: 200 }}{% elsif cardimg != blank %}{{ cardimg | image_url: width: 200 }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if flavor_opt != null and flavor_opt.values.size > 0 -%}
    {%- for val in flavor_opt.values -%}
      {%- assign vthumb = '' -%}
      {%- for v in prod.variants -%}
        {%- if v.options contains val -%}
          {%- if v.featured_image != blank -%}{%- assign vthumb = v.featured_image | image_url: width: 80 -%}{%- endif -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      <span data-ftd-ps-flavor data-flavor-name="{{ val | escape }}" data-thumbnail="{{ vthumb }}"></span>
    {%- endfor -%}
  {%- else -%}
    {%- assign manual_flavors = block.settings.manual_flavors | newline_to_br | split: '<br />' -%}
    {%- for m in manual_flavors -%}
      {%- assign mt = m | strip -%}
      {%- if mt != blank -%}
        <span data-ftd-ps-flavor data-flavor-name="{{ mt | escape }}" data-thumbnail=""></span>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Function",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable this function",
      "default": true
    },
    {
      "type": "text",
      "id": "function_label",
      "label": "Function name",
      "default": "Fortified Everyday"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "coming_soon",
      "label": "Mark as Coming Soon",
      "default": false
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Card image",
      "info": "Large product image shown on the card. Falls back to the summary thumbnail."
    },
    {
      "type": "text",
      "id": "spec_1",
      "label": "Spec tag 1",
      "default": "152mg Caffeine"
    },
    {
      "type": "text",
      "id": "spec_2",
      "label": "Spec tag 2",
      "default": "1,200mg NA"
    },
    {
      "type": "text",
      "id": "spec_3",
      "label": "Spec tag 3"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "152mg Natural Caffeine from coffee beans. Complete electrolyte matrix."
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image",
      "label": "Summary thumbnail"
    },
    {
      "type": "image_picker",
      "id": "pill_icon",
      "label": "Icon (optional)"
    },
    {
      "type": "header",
      "content": "Flavors"
    },
    {
      "type": "paragraph",
      "content": "Flavors come from this product's variants. Pick the variant option that holds the flavor below (leave blank to use the product's first option)."
    },
    {
      "type": "text",
      "id": "flavor_option",
      "label": "Flavor option name",
      "info": "e.g. Flavor. Must match the product's option name. Blank = first option."
    },
    {
      "type": "textarea",
      "id": "manual_flavors",
      "label": "Manual flavors (fallback)",
      "info": "One per line. Only used when no product is set, so the card can still preview."
    },
    {
      "type": "header",
      "content": "Loop Subscription Plan IDs"
    },
    {
      "type": "paragraph",
      "content": "In Shopify Admin open the product, scroll to Purchase options, click a selling plan, and copy the ID from the end of the URL."
    },
    {
      "type": "text",
      "id": "loop_plan_monthly",
      "label": "Monthly plan ID",
      "default": "2852487324"
    },
    {
      "type": "text",
      "id": "loop_plan_quarterly",
      "label": "Every 3 months plan ID",
      "default": "2852520092"
    }
  ]
}
{% endschema %}
