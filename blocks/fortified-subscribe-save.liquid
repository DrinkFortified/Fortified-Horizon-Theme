{% render 'fortified-base' %}

{%- liquid
  assign bg = block.settings.background_image
  assign primary_label = block.settings.cta_primary_label
  assign primary_url = block.settings.cta_primary_url | default: '#'
  assign secondary_label = block.settings.cta_secondary_label
  assign secondary_url = block.settings.cta_secondary_url | default: '#'
-%}

<div
  class="fortified-subscribe color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  {% if bg != blank %}
    {{ bg | image_url: width: 2400 | image_tag:
        widths: '800, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'fortified-subscribe__bg',
        alt: bg.alt | default: block.settings.heading,
        loading: 'lazy' }}
  {% endif %}
  <div class="fortified-subscribe__overlay" aria-hidden="true"></div>
  <div class="fortified-container fortified-subscribe__inner">
    {% if block.settings.eyebrow != blank %}
      <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.body != blank %}
      <p class="fortified-body fortified-subscribe__body">{{ block.settings.body }}</p>
    {% endif %}
    {% if primary_label != blank or secondary_label != blank %}
      <div class="fortified-subscribe__ctas">
        {% if primary_label != blank %}
          <a href="{{ primary_url }}" class="fortified-btn fortified-btn--primary">{{ primary_label }}</a>
        {% endif %}
        {% if secondary_label != blank %}
          <a href="{{ secondary_url }}" class="fortified-btn fortified-btn--white">{{ secondary_label }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .fortified-subscribe {
    position: relative;
    background: var(--color-background, #0A0A0A);
    color: #fff;
    padding-block: var(--fortified-section-py);
    isolation: isolate;
    overflow: hidden;
  }
  .fortified-subscribe__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: .55;
  }
  .fortified-subscribe__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / .55), rgb(0 0 0 / .75));
    z-index: -1;
  }
  .fortified-subscribe__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 720px;
  }
  .fortified-subscribe__body {
    max-width: 52ch;
    margin: 4px 0 8px;
    opacity: .9;
  }
  .fortified-subscribe__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Subscribe Save",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MEMBER PERK" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "SUBSCRIBE & SAVE 15%" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Never run out. Cancel anytime. Free shipping on every order." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "SUBSCRIBE NOW" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "LEARN MORE" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified Subscribe Save", "category": "Fortified" }
  ]
}
{% endschema %}
