{% comment %}
  Block: FTD - Product Selector C — Slide-over
  ----------------------------------------------------------------------
  Variant 3 of 3 (theme block + slide-over). Renders a trigger button; clicking it slides a full-screen panel in from the right (full-width on mobile, 560px on desktop) containing the entire multi-step selector.
  to follow — all three will share the same flow logic; for v1 the
  markup/CSS/JS lives inline here so the section is self-contained.

  Flow: Plan → Products → Upsells → Cart (linear wizard).
    Step 1  Plan picker (3 toggleable plans: One-time / Monthly / 3-pack)
    Step 2  Product grid with qty steppers + progress indicator
    Step 3  Creatine upsell (logic mirrors B) + custom upsell blocks
            + Add More (back to Step 2) and Checkout buttons
  Sticky bottom bar shows total + saved + a context-aware action label.

  Loop bundle integration (bundle.loopwork.co transactions) is held for
  the next iteration so the cart-add path stays simple for v1. Quarterly
  orders still ship as a per-pouch selling-plan subscription until the
  Loop hook lands.
{% endcomment %}

{%- liquid
  assign sid = block.id
  assign function_blocks = block.blocks | where: 'type', '_ftd-c-function'
  assign upsell_blocks   = block.blocks | where: 'type', '_ftd-c-upsell'
  assign bullet_blocks   = block.blocks | where: 'type', '_ftd-c-bullet'

  assign show_onetime   = block.settings.show_onetime
  assign show_monthly   = block.settings.show_monthly
  assign show_quarterly = block.settings.show_quarterly
  assign bundle_count   = block.settings.bundle_count | default: 3

  assign addon          = block.settings.addon_product
  assign addon_variant_id = ''
  if addon != blank and addon.selected_or_first_available_variant != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif
-%}

<div class="ftdc-slideover-wrap" {{ block.shopify_attributes }}>
  <button class="ftdc-slideover-trigger ftdc-slideover-trigger--{{ block.settings.button_style | default: 'filled' }}"
          type="button"
          data-ftdc-slideover-open="{{ block.id }}"
          aria-haspopup="dialog"
          aria-controls="ftdc-slideover-{{ block.id }}">
    {{ block.settings.button_label | default: 'Build Your Bundle' }}
  </button>

  <div class="ftdc-slideover" id="ftdc-slideover-{{ block.id }}" style="--ftdc-slideover-w: {{ block.settings.slideover_width | default: 560 }}px;" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ block.settings.button_label | default: 'Build Your Bundle' | escape }}">
    <div class="ftdc-slideover__backdrop" data-ftdc-slideover-close="{{ block.id }}" aria-hidden="true"></div>
    <div class="ftdc-slideover__panel" role="document">
      <button class="ftdc-slideover__close" type="button" data-ftdc-slideover-close="{{ block.id }}" aria-label="{{ block.settings.close_label | default: 'Close' | escape }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <div class="ftdc-slideover__inner">

<div class="section-background color-{{ block.settings.color_scheme }}"></div>

<section
  id="ftdc-{{ sid }}"
  class="ftdc spacing-style color-{{ block.settings.color_scheme }}"
  data-section-id="{{ sid }}"
  style="
    
    --ftdc-accent: {{ block.settings.accent_color }};
    --ftdc-radius: {{ block.settings.card_radius }}px;
    --ftdc-max-w: {{ block.settings.content_max_width }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="ftdc__inner">

    {%- comment %} ───── HEADER ───── {%- endcomment %}
    <header class="ftdc__header">
      {%- if block.settings.heading != blank -%}
        <h2 class="ftdc__heading">{{ block.settings.heading }}</h2>
      {%- endif -%}
      {%- if block.settings.description != blank -%}
        <div class="ftdc__desc">{{ block.settings.description }}</div>
      {%- endif -%}
      {%- if bullet_blocks.size > 0 -%}
        <ul class="ftdc__bullets list-unstyled">
          {%- for b in bullet_blocks -%}
            <li class="ftdc__bullet">
              <span class="ftdc__bullet-dot" aria-hidden="true"></span>
              <span class="ftdc__bullet-text">{{ b.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- comment %} ───── STEP PROGRESS ───── {%- endcomment %}
    <ol class="ftdc__steps" role="list" aria-label="Order steps">
      <li class="ftdc__step-pill is-active" data-step-pill="plans"><span class="ftdc__step-num">1</span><span class="ftdc__step-label">{{ block.settings.step_label_1 | default: 'Plan' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="products"><span class="ftdc__step-num">2</span><span class="ftdc__step-label">{{ block.settings.step_label_2 | default: 'Bundle' }}</span></li>
      <li class="ftdc__step-pill" data-step-pill="upsells"><span class="ftdc__step-num">3</span><span class="ftdc__step-label">{{ block.settings.step_label_3 | default: 'Boost' }}</span></li>
    </ol>

    {%- comment %} ───── STEP 1 — PLANS ───── {%- endcomment %}
    <div class="ftdc__step is-active" data-step="plans">
      <div class="ftdc__plans">
        {%- if show_quarterly -%}
          <label class="ftdc__plan is-active" data-plan="quarterly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="quarterly" checked>
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if block.settings.quarterly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.quarterly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ block.settings.quarterly_title | default: '3 Pouches Every 3 Months' }}</div>
            {%- if block.settings.quarterly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.quarterly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing">
              <span class="ftdc__plan-price">{{ block.settings.quarterly_price | default: '$53.10' }}</span>
              <span class="ftdc__plan-period">{{ block.settings.quarterly_period | default: '/ month' }}</span>
            </div>
            {%- if block.settings.quarterly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.quarterly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_monthly -%}
          <label class="ftdc__plan" data-plan="monthly">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="monthly">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if block.settings.monthly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.monthly_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ block.settings.monthly_title | default: '1 Pouch Every Month' }}</div>
            {%- if block.settings.monthly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.monthly_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing">
              <span class="ftdc__plan-price">{{ block.settings.monthly_price | default: '$53.10' }}</span>
              <span class="ftdc__plan-period">{{ block.settings.monthly_period | default: '/ month' }}</span>
            </div>
            {%- if block.settings.monthly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.monthly_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
        {%- if show_onetime -%}
          <label class="ftdc__plan" data-plan="onetime">
            <input type="radio" name="ftdc-plan-{{ sid }}" value="onetime">
            <span class="ftdc__plan-tick" aria-hidden="true"></span>
            {%- if block.settings.onetime_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.onetime_badge }}</span>{%- endif -%}
            <div class="ftdc__plan-title">{{ block.settings.onetime_title | default: 'Single Pouch' }}</div>
            {%- if block.settings.onetime_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.onetime_desc }}</div>{%- endif -%}
            <div class="ftdc__plan-pricing">
              <span class="ftdc__plan-price">{{ block.settings.onetime_price | default: '$59.00' }}</span>
              <span class="ftdc__plan-period">{{ block.settings.onetime_period | default: '/ pouch' }}</span>
            </div>
            {%- assign _ow = block.settings.onetime_was | strip -%}{%- if _ow != blank and _ow != '-' and _ow != '—' -%}<div class="ftdc__plan-was">{{ block.settings.onetime_was }}</div>{%- endif -%}
          </label>
        {%- endif -%}
      </div>
    </div>

    {%- comment %} ───── STEP 2 — PRODUCTS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="products" hidden>
      <button class="ftdc__back" type="button" data-step-back="plans" aria-label="Back to plan">
        <span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}
      </button>
      <div class="ftdc__bundle-head">
        <p class="ftdc__bundle-eyebrow">{{ block.settings.bundle_label | default: 'Your Bundle' }}</p>
        <p class="ftdc__bundle-progress-text" data-progress-text>0 {{ block.settings.of_word | default: 'of' }} {{ bundle_count }} {{ block.settings.selected_word | default: 'selected' }}</p>
        <div class="ftdc__bundle-bar"><div class="ftdc__bundle-bar-fill" data-progress-fill style="width:0%"></div></div>
      </div>

      <div class="ftdc__grid">
        {%- for fb in function_blocks -%}
          {%- assign prod = fb.settings.product -%}
          {%- if prod != blank -%}
            {%- assign flavor_opt_name = '' -%}
            {%- assign matched = false -%}
            {%- assign want = fb.settings.flavor_option | downcase | strip -%}
            {%- if want != '' -%}
              {%- for opt in prod.options_with_values -%}
                {%- assign have = opt.name | downcase | strip -%}
                {%- if have == want -%}
                  {%- assign flavor_opt_name = opt.name -%}
                  {%- assign matched = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- unless matched -%}
              {%- if prod.options_with_values.first != blank -%}
                {%- assign flavor_opt_name = prod.options_with_values.first.name -%}
              {%- endif -%}
            {%- endunless -%}

            {%- for v in prod.variants -%}
              {%- assign show_card = true -%}
              {%- if fb.settings.coming_soon and v == prod.variants.first -%}{%- endif -%}
              {%- assign flavor_name = '' -%}
              {%- if flavor_opt_name != '' -%}
                {%- for o in v.options -%}
                  {%- assign idx = forloop.index0 -%}
                  {%- assign opt_name = prod.options_with_values[idx].name -%}
                  {%- if opt_name == flavor_opt_name -%}
                    {%- assign flavor_name = o -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if flavor_name == '' -%}{%- assign flavor_name = v.title -%}{%- endif -%}

              {%- assign card_img = v.featured_image -%}
              {%- if card_img == blank -%}{%- assign card_img = fb.settings.card_image -%}{%- endif -%}
              {%- if card_img == blank -%}{%- assign card_img = prod.featured_image -%}{%- endif -%}

              <article class="ftdc__card"
                       data-fn-id="{{ fb.id }}"
                       data-fn-label="{{ fb.settings.function_label | escape }}"
                       data-variant-id="{{ v.id }}"
                       data-product-handle="{{ prod.handle }}"
                       data-flavor-name="{{ flavor_name | escape }}"
                       data-plan-monthly="{{ fb.settings.loop_plan_monthly }}"
                       data-plan-quarterly="{{ fb.settings.loop_plan_quarterly }}"
                       data-variant-price="{{ v.price }}"
                       data-variant-compare="{{ v.compare_at_price | default: 0 }}"
                       {%- if fb.settings.coming_soon %} data-coming-soon="true" aria-disabled="true"{%- endif %}>
                <div class="ftdc__card-media">
                  {%- if card_img != blank -%}
                    <img src="{{ card_img | image_url: width: 480 }}" alt="{{ fb.settings.function_label | escape }} – {{ flavor_name | escape }}" loading="lazy" width="240" height="240">
                  {%- else -%}
                    <div class="ftdc__card-ph" aria-hidden="true"></div>
                  {%- endif -%}
                  <span class="ftdc__card-tick" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><polyline points="1.5,6 4.5,9 10.5,3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
                <div class="ftdc__card-body">
                  {%- if fb.settings.spec_top != blank and fb.settings.spec_top != '-' -%}<span class="ftdc__card-spec-top">{{ fb.settings.spec_top }}</span>{%- endif -%}
                  <h3 class="ftdc__card-name">{{ fb.settings.function_label }}{%- if flavor_name != blank %} <span class="ftdc__card-flavor">{{ flavor_name }}</span>{%- endif -%}</h3>
                  {%- if fb.settings.spec_1 != blank or fb.settings.spec_2 != blank or fb.settings.spec_3 != blank -%}
                    <div class="ftdc__card-specs">
                      {%- if fb.settings.spec_1 != blank -%}<span class="ftdc__spec">{{ fb.settings.spec_1 }}</span>{%- endif -%}
                      {%- if fb.settings.spec_2 != blank -%}<span class="ftdc__spec">{{ fb.settings.spec_2 }}</span>{%- endif -%}
                      {%- if fb.settings.spec_3 != blank -%}<span class="ftdc__spec">{{ fb.settings.spec_3 }}</span>{%- endif -%}
                    </div>
                  {%- endif -%}
                  <div class="ftdc__card-pricing">
                    <span class="ftdc__card-price" data-card-price>{{ v.price | money }}</span>
                    {%- if v.compare_at_price > v.price -%}<s class="ftdc__card-was">{{ v.compare_at_price | money }}</s>{%- endif -%}
                  </div>
                  <div class="ftdc__card-action">
                    <button class="ftdc__add" type="button" data-card-action="add">{{ block.settings.add_label | default: 'ADD' }}</button>
                    <div class="ftdc__qty" hidden>
                      <button class="ftdc__qty-btn" type="button" data-card-action="dec" aria-label="Decrease">−</button>
                      <input class="ftdc__qty-input" type="number" min="0" value="0" inputmode="numeric" aria-label="Quantity">
                      <button class="ftdc__qty-btn" type="button" data-card-action="inc" aria-label="Increase">+</button>
                    </div>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment %} ───── STEP 3 — UPSELLS ───── {%- endcomment %}
    <div class="ftdc__step" data-step="upsells" hidden>
      <button class="ftdc__back" type="button" data-step-back="products" aria-label="Back to bundle">
        <span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}
      </button>

      {%- if addon != blank -%}
        <div class="ftdc__upsell ftdc__upsell--creatine" data-upsell-creatine>
          <div class="ftdc__upsell-media">
            {%- assign addon_img = block.settings.addon_image | default: addon.featured_image -%}
            {%- if addon_img != blank -%}<img src="{{ addon_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">{%- endif -%}
          </div>
          <div class="ftdc__upsell-body">
            <p class="ftdc__upsell-title" data-creatine-title>{{ block.settings.addon_label_monthly | default: 'Add Creatine — 50% off' }}</p>
            <p class="ftdc__upsell-desc" data-creatine-desc>{{ block.settings.addon_desc_monthly | default: '' }}</p>
            <div class="ftdc__upsell-pricing">
              <span class="ftdc__upsell-price" data-creatine-price>{{ block.settings.addon_price_monthly | default: '$12.00' }}</span>
              {%- if block.settings.addon_was_monthly != blank -%}<s class="ftdc__upsell-was" data-creatine-was>{{ block.settings.addon_was_monthly }}</s>{%- endif -%}
            </div>
          </div>
          <div class="ftdc__upsell-toggle">
            <input type="checkbox" id="ftdc-cr-{{ sid }}" class="visually-hidden" data-creatine-input
                   data-variant="{{ addon_variant_id }}"
                   data-plan-monthly="{{ block.settings.addon_loop_plan_monthly }}"
                   data-plan-quarterly-free="{{ block.settings.addon_loop_plan_quarterly_free }}"
                   data-plan-quarterly-50off="{{ block.settings.addon_loop_plan_quarterly_50off }}"
                   data-discount-onetime="{{ block.settings.addon_discount_code_onetime }}">
            <label for="ftdc-cr-{{ sid }}" class="ftdc__switch" aria-hidden="true"></label>
          </div>
        </div>
      {%- endif -%}

      {%- for ub in upsell_blocks -%}
        {%- assign u_prod = ub.settings.product -%}
        {%- if u_prod != blank -%}
          {%- assign u_variant = u_prod.selected_or_first_available_variant -%}
          {%- assign u_img = ub.settings.image | default: u_prod.featured_image -%}
          <div class="ftdc__upsell" data-upsell-block
               data-variant="{{ u_variant.id }}"
               data-plans-allowed="{{ ub.settings.plans_allowed | default: 'onetime,monthly,quarterly' }}">
            <div class="ftdc__upsell-media">
              {%- if u_img != blank -%}<img src="{{ u_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">{%- endif -%}
            </div>
            <div class="ftdc__upsell-body">
              <p class="ftdc__upsell-title">{{ ub.settings.title | default: u_prod.title }}</p>
              {%- if ub.settings.description != blank -%}<p class="ftdc__upsell-desc">{{ ub.settings.description }}</p>{%- endif -%}
              <div class="ftdc__upsell-pricing">
                <span class="ftdc__upsell-price">{{ ub.settings.price_text | default: u_variant.price | money }}</span>
                {%- if ub.settings.was_text != blank -%}<s class="ftdc__upsell-was">{{ ub.settings.was_text }}</s>{%- endif -%}
              </div>
            </div>
            <div class="ftdc__upsell-toggle">
              <input type="checkbox" id="ftdc-up-{{ sid }}-{{ ub.id }}" class="visually-hidden" data-upsell-input>
              <label for="ftdc-up-{{ sid }}-{{ ub.id }}" class="ftdc__switch" aria-hidden="true"></label>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="ftdc__step-actions">
        <button class="ftdc__btn ftdc__btn--ghost" type="button" data-step-back="products">
          {{ block.settings.add_more_label | default: 'Add More' }}
        </button>
        <button class="ftdc__btn ftdc__btn--primary" type="button" data-action="checkout">
          {{ block.settings.checkout_label | default: 'Checkout' }}
        </button>
      </div>
    </div>

    {%- comment %} ───── STICKY CART BAR ───── {%- endcomment %}
    <div class="ftdc__bar" data-bar>
      <div class="ftdc__bar-summary">
        <span class="ftdc__bar-total">
          <strong>{{ block.settings.total_label | default: 'Total' }}:</strong>
          <span data-bar-total>$0.00</span>
        </span>
        <span class="ftdc__bar-saved" data-bar-saved-wrap hidden>
          ({{ block.settings.saved_word | default: 'Saved' }} <span data-bar-saved>$0.00</span>)
        </span>
      </div>
      <button class="ftdc__bar-action" type="button" data-action="next">
        <span data-bar-label>{{ block.settings.action_label_step1 | default: 'Continue' }}</span>
      </button>
    </div>

  </div>
</section>

      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ftdc { position: relative; }
  .ftdc__inner { max-width: var(--ftdc-max-w, 1240px); margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); padding-block-end: 96px; }

  /* Header */
  .ftdc__header { text-align: center; margin-block-end: clamp(20px, 3vw, 32px); }
  .ftdc__heading { margin: 0 0 0.5em; font-size: clamp(28px, 4.4vw, 56px); font-weight: 900; line-height: 1; text-transform: uppercase; color: var(--color-foreground); }
  .ftdc__desc { margin: 0 auto 1em; font-size: clamp(15px, 1.25vw, 17px); line-height: 1.55; opacity: 0.75; max-width: 36em; color: var(--color-foreground); }
  .ftdc__bullets { display: flex; flex-direction: column; gap: 0.65rem; align-items: flex-start; max-width: 22em; margin: 1.25rem auto 0; padding: 0; list-style: none; }
  .ftdc__bullet { display: flex; align-items: center; gap: 0.75rem; }
  .ftdc__bullet-dot { width: 22px; height: 22px; border-radius: 50%; background: color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 18%, transparent); position: relative; flex-shrink: 0; }
  .ftdc__bullet-dot::after { content: ''; position: absolute; inset: 6px; border-radius: 50%; background: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__bullet-text { font-size: 15px; font-weight: 700; color: var(--color-foreground); }

  /* Step progress pills */
  .ftdc__steps { display: flex; justify-content: center; gap: 0.75rem; padding: 0; margin: 0 0 clamp(20px, 3vw, 32px); list-style: none; }
  .ftdc__step-pill { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.85rem; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; background: rgb(var(--color-foreground-rgb) / 0.06); color: rgb(var(--color-foreground-rgb) / 0.6); transition: background 0.18s, color 0.18s; }
  .ftdc__step-pill.is-active { background: var(--color-foreground); color: var(--color-background); }
  .ftdc__step-pill.is-done   { color: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__step-num { width: 18px; height: 18px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; background: currentColor; color: var(--color-background); }
  .ftdc__step-pill.is-active .ftdc__step-num { background: var(--color-background); color: var(--color-foreground); }

  /* Step container */
  .ftdc__step { display: none; }
  .ftdc__step.is-active { display: block; animation: ftdc-fade-in 0.2s ease; }
  @keyframes ftdc-fade-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  [hidden] { display: none !important; }

  .ftdc__back { display: inline-flex; align-items: center; gap: 0.35rem; background: none; border: 0; padding: 0.25rem 0.5rem 0.75rem; font-size: 13px; font-weight: 700; letter-spacing: 0.05em; color: var(--color-foreground); cursor: pointer; opacity: 0.7; transition: opacity 0.15s; }
  .ftdc__back:hover { opacity: 1; }

  /* Step 1 — plans */
  .ftdc__plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.85rem; }
  .ftdc__plan { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.45rem; padding: 1rem 1.1rem; border: 2px solid rgb(var(--color-foreground-rgb) / 0.12); border-radius: var(--ftdc-radius, 12px); background: var(--color-background); cursor: pointer; transition: border-color 0.18s, box-shadow 0.18s; overflow: hidden; min-width: 0; }
  .ftdc__plan:hover { border-color: rgb(var(--color-foreground-rgb) / 0.3); }
  .ftdc__plan.is-active { border-color: var(--ftdc-accent, var(--color-primary-button-background)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 14%, transparent); }
  .ftdc__plan input { position: absolute; opacity: 0; pointer-events: none; }
  .ftdc__plan-tick { position: absolute; top: 12px; right: 12px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgb(var(--color-foreground-rgb) / 0.25); display: inline-flex; align-items: center; justify-content: center; transition: background 0.18s, border-color 0.18s; }
  .ftdc__plan.is-active .ftdc__plan-tick { background: var(--ftdc-accent, var(--color-primary-button-background)); border-color: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__plan.is-active .ftdc__plan-tick::after { content: ''; width: 6px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); margin-top: -2px; }
  .ftdc__plan-badge { display: inline-flex; align-self: flex-start; padding: 0.15rem 0.55rem; border-radius: 4px; font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; background: var(--ftdc-accent, var(--color-primary-button-background)); color: #fff; }
  .ftdc__plan-title { font-size: 17px; font-weight: 800; line-height: 1.2; color: var(--color-foreground); padding-right: 36px; overflow-wrap: break-word; }
  .ftdc__plan-desc { font-size: 13px; line-height: 1.4; opacity: 0.7; color: var(--color-foreground); overflow-wrap: break-word; }
  .ftdc__plan-price { font-size: 22px; font-weight: 800; color: var(--color-foreground); }
  .ftdc__plan-period { font-size: 13px; opacity: 0.7; color: var(--color-foreground); }
  .ftdc__plan-pricing { display: flex; align-items: baseline; gap: 0.35rem; margin-top: 0.25rem; flex-wrap: wrap; min-width: 0; }
  .ftdc__plan-was { display: block; font-size: 12px; color: rgb(var(--color-foreground-rgb) / 0.5); text-decoration: line-through; overflow-wrap: break-word; }

  /* Step 2 — bundle head + grid */
  .ftdc__bundle-head { text-align: center; margin: 0.5rem 0 1.25rem; }
  .ftdc__bundle-eyebrow { margin: 0 0 0.35rem; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.6; color: var(--color-foreground); }
  .ftdc__bundle-progress-text { margin: 0 0 0.6rem; font-size: 14px; color: var(--color-foreground); }
  .ftdc__bundle-bar { width: 100%; max-width: 32em; margin: 0 auto; height: 6px; background: rgb(var(--color-foreground-rgb) / 0.08); border-radius: 999px; overflow: hidden; }
  .ftdc__bundle-bar-fill { height: 100%; background: var(--ftdc-accent, var(--color-primary-button-background)); border-radius: inherit; transition: width 0.25s ease; }

  .ftdc__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.85rem; }
  @media (max-width: 599px) { .ftdc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; } }

  .ftdc__card { position: relative; display: flex; flex-direction: column; background: var(--color-background); border: 2px solid rgb(var(--color-foreground-rgb) / 0.12); border-radius: var(--ftdc-radius, 12px); overflow: hidden; transition: border-color 0.18s, box-shadow 0.18s; min-width: 0; }
  .ftdc__card.is-selected { border-color: var(--color-foreground); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-foreground) 12%, transparent); }
  .ftdc__card[data-coming-soon] { opacity: 0.55; pointer-events: none; }
  .ftdc__card-media { position: relative; aspect-ratio: 1 / 1; background: rgb(var(--color-foreground-rgb) / 0.04); display: flex; align-items: center; justify-content: center; padding: 0.65rem; flex-shrink: 0; }
  .ftdc__card-media img { width: 100%; height: 100%; object-fit: contain; }
  .ftdc__card-ph { width: 100%; height: 100%; }
  .ftdc__card-tick { position: absolute; top: 8px; right: 8px; width: 22px; height: 22px; border-radius: 50%; background: var(--ftdc-accent, var(--color-primary-button-background)); color: #fff; display: inline-flex; align-items: center; justify-content: center; opacity: 0; transform: scale(0.6); transition: opacity 0.18s, transform 0.18s; pointer-events: none; }
  .ftdc__card.is-selected .ftdc__card-tick { opacity: 1; transform: scale(1); }
  .ftdc__card-body { padding: 0.85rem 0.9rem 0.95rem; display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; flex: 1; }
  .ftdc__card-spec-top { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--color-foreground-rgb) / 0.55); margin: 0; }
  .ftdc__card-name { margin: 0; font-size: 12.5px; font-weight: 800; line-height: 1.3; text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-foreground); overflow-wrap: break-word; word-break: break-word; hyphens: auto; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
  .ftdc__card-flavor { font-weight: 700; opacity: 0.85; display: block; margin-top: 0.15rem; }
  .ftdc__card-specs { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .ftdc__spec { font-size: 9.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.22rem 0.45rem; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 80%, transparent); color: var(--ftdc-accent, var(--color-primary-button-background)); white-space: nowrap; }
  .ftdc__card-pricing { display: flex; align-items: baseline; gap: 0.45rem; flex-wrap: wrap; margin-top: auto; }
  .ftdc__card-price { font-weight: 800; font-size: 15px; color: var(--color-foreground); }
  .ftdc__card-was { font-size: 12px; color: rgb(var(--color-foreground-rgb) / 0.5); text-decoration: line-through; }
  .ftdc__card-action { margin-top: 0.4rem; }
  .ftdc__add { width: 100%; padding: 0.55rem 0.75rem; font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 8px; border: 1.5px solid var(--color-foreground); background: transparent; color: var(--color-foreground); cursor: pointer; transition: background 0.15s, color 0.15s; }
  .ftdc__add:hover { background: var(--color-foreground); color: var(--color-background); }
  .ftdc__qty { display: grid; grid-template-columns: auto 1fr auto; align-items: stretch; border-radius: 8px; border: 1.5px solid var(--color-foreground); overflow: hidden; }
  .ftdc__qty-btn { padding: 0.55rem 0.7rem; background: var(--color-foreground); color: var(--color-background); border: 0; font-size: 14px; font-weight: 800; cursor: pointer; }
  .ftdc__qty-input { border: 0; text-align: center; font-size: 14px; font-weight: 800; background: var(--color-background); color: var(--color-foreground); width: 100%; -moz-appearance: textfield; padding: 0; }
  .ftdc__qty-input::-webkit-outer-spin-button,
  .ftdc__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* Step 3 — upsells */
  .ftdc__upsell { display: grid; grid-template-columns: 80px 1fr auto; gap: 0.85rem; align-items: center; padding: 0.85rem 1rem; border-radius: var(--ftdc-radius, 12px); border: 2px solid rgb(var(--color-foreground-rgb) / 0.12); background: var(--color-background); margin-bottom: 0.75rem; }
  .ftdc__upsell-media { width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: rgb(var(--color-foreground-rgb) / 0.06); display: inline-flex; align-items: center; justify-content: center; }
  .ftdc__upsell-media img { width: 100%; height: 100%; object-fit: cover; }
  .ftdc__upsell-body { min-width: 0; }
  .ftdc__upsell-title { margin: 0; font-size: 15px; font-weight: 800; line-height: 1.25; color: var(--color-foreground); }
  .ftdc__upsell-desc { margin: 0.2rem 0 0.35rem; font-size: 12px; line-height: 1.4; opacity: 0.7; color: var(--color-foreground); }
  .ftdc__upsell-pricing { display: flex; align-items: baseline; gap: 0.4rem; }
  .ftdc__upsell-price { font-weight: 800; font-size: 15px; color: var(--color-foreground); }
  .ftdc__upsell-was { font-size: 12px; color: rgb(var(--color-foreground-rgb) / 0.5); text-decoration: line-through; }
  .ftdc__upsell-toggle { display: inline-flex; }
  .ftdc__switch { display: inline-flex; width: 44px; height: 26px; background: rgb(var(--color-foreground-rgb) / 0.2); border-radius: 999px; position: relative; cursor: pointer; transition: background 0.18s; }
  .ftdc__switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--color-background); transition: transform 0.18s, background 0.18s; box-shadow: 0 1px 2px rgb(0 0 0 / 0.2); }
  .ftdc__upsell input:checked + .ftdc__switch { background: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__upsell input:checked + .ftdc__switch::after { transform: translateX(18px); }

  .ftdc__step-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 1.25rem; }
  .ftdc__btn { padding: 0.85rem 1.25rem; font-size: 13px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 10px; cursor: pointer; transition: opacity 0.15s, background 0.15s, color 0.15s; border: 1.5px solid var(--color-foreground); }
  .ftdc__btn--ghost { background: transparent; color: var(--color-foreground); }
  .ftdc__btn--ghost:hover { background: var(--color-foreground); color: var(--color-background); }
  .ftdc__btn--primary { background: var(--color-foreground); color: var(--color-background); }
  .ftdc__btn--primary:hover { opacity: 0.88; }

  /* Sticky cart bar */
  .ftdc__bar { position: sticky; bottom: clamp(8px, 2vw, 18px); z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1.1rem; margin: 1.5rem auto 0; max-width: 38em; background: var(--color-background); border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.12); border-radius: 999px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.08); }
  .ftdc__bar-summary { display: flex; align-items: baseline; gap: 0.5rem; font-size: 14px; color: var(--color-foreground); min-width: 0; }
  .ftdc__bar-total { font-weight: 700; white-space: nowrap; }
  .ftdc__bar-saved { font-size: 12px; opacity: 0.7; white-space: nowrap; }
  .ftdc__bar-action { padding: 0.55rem 1.25rem; background: var(--color-foreground); color: var(--color-background); border: 0; border-radius: 999px; font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: opacity 0.15s; }
  .ftdc__bar-action:hover:not(:disabled) { opacity: 0.88; }
  .ftdc__bar-action:disabled { opacity: 0.4; cursor: not-allowed; }

  @media (max-width: 599px) {
    .ftdc__bar { border-radius: 16px; padding: 0.75rem 0.9rem; }
    .ftdc__step-actions { grid-template-columns: 1fr; }
    .ftdc__steps { gap: 0.4rem; }
    .ftdc__step-pill { padding: 0.3rem 0.6rem; font-size: 10px; }
  }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }


  /* ───── Slide-over trigger + panel ───── */
  .ftdc-slideover-wrap { display: inline-block; }
  .ftdc-slideover-trigger {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.85rem 1.6rem;
    font-size: 14px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    border-radius: 10px; cursor: pointer;
    border: 1.5px solid var(--color-foreground);
    transition: opacity 0.15s, background 0.15s, color 0.15s;
  }
  .ftdc-slideover-trigger--filled  { background: var(--color-foreground); color: var(--color-background); }
  .ftdc-slideover-trigger--filled:hover  { opacity: 0.88; }
  .ftdc-slideover-trigger--outline { background: transparent; color: var(--color-foreground); }
  .ftdc-slideover-trigger--outline:hover { background: var(--color-foreground); color: var(--color-background); }

  .ftdc-slideover {
    position: fixed; inset: 0; z-index: 1000;
    pointer-events: none; visibility: hidden;
    transition: visibility 0s linear 0.3s;
  }
  .ftdc-slideover.is-open {
    pointer-events: auto; visibility: visible;
    transition: visibility 0s linear 0s;
  }
  .ftdc-slideover__backdrop {
    position: absolute; inset: 0;
    background: rgb(0 0 0 / 0);
    transition: background 0.3s ease;
  }
  .ftdc-slideover.is-open .ftdc-slideover__backdrop { background: rgb(0 0 0 / 0.55); }
  .ftdc-slideover__panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: min(var(--ftdc-slideover-w, 560px), 100vw);
    max-width: 100vw;
    background: var(--color-background);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
    overflow-y: auto; -webkit-overflow-scrolling: touch;
    box-shadow: -12px 0 40px rgb(0 0 0 / 0.18);
    display: flex; flex-direction: column;
  }
  .ftdc-slideover.is-open .ftdc-slideover__panel { transform: translateX(0); }
  .ftdc-slideover__close {
    position: sticky; top: 12px; align-self: flex-end;
    margin: 12px 12px 0; z-index: 2;
    width: 36px; height: 36px; border-radius: 50%;
    border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.18);
    background: var(--color-background);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--color-foreground);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .ftdc-slideover__close:hover { background: var(--color-foreground); color: var(--color-background); border-color: var(--color-foreground); }
  .ftdc-slideover__inner { padding-top: 4px; padding-bottom: 24px; }
  /* Section inside the panel: cap its own max-width so the layout breathes */
  .ftdc-slideover__inner .ftdc { --ftdc-max-w: 100%; }
  .ftdc-slideover__inner .ftdc__inner { padding-block-end: 24px; }
  .ftdc-slideover__inner .ftdc__bar { position: sticky; bottom: 12px; }

  @media (max-width: 599px) {
    .ftdc-slideover__panel { width: 100vw; box-shadow: none; }
    .ftdc-slideover__inner .ftdc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

{% endstylesheet %}

<script>
(function () {
  var SID = {{ block.id | json }};
  var root = document.getElementById('ftdc-' + SID);
  if (!root) return;

  var BUNDLE_COUNT = parseInt({{ bundle_count | json }}, 10) || 3;

  /* Creatine labels / pricing per plan (mirrors B). */
  var ADDON_LABEL_M  = {{ block.settings.addon_label_monthly   | default: 'Add Creatine — 50% off'           | json }};
  var ADDON_LABEL_Q  = {{ block.settings.addon_label_quarterly | default: 'Add a 2nd Creatine — 50% off'     | json }};
  var ADDON_LABEL_OT = {{ block.settings.addon_label_onetime   | default: 'Add Creatine — 25% off'           | json }};
  var ADDON_DESC_M   = {{ block.settings.addon_desc_monthly    | default: ''                                 | json }};
  var ADDON_DESC_Q   = {{ block.settings.addon_desc_quarterly  | default: '1st Creatine is free with your bundle. Add a second at 50% off.' | json }};
  var ADDON_DESC_OT  = {{ block.settings.addon_desc_onetime    | default: 'One-time purchase. Discount applied at checkout.'                | json }};
  var ADDON_PRICE_M  = {{ block.settings.addon_price_monthly   | default: '$12.00'                           | json }};
  var ADDON_PRICE_Q  = {{ block.settings.addon_price_quarterly | default: '$12.00'                           | json }};
  var ADDON_PRICE_OT = {{ block.settings.addon_price_onetime   | default: '$18.00'                           | json }};
  var ADDON_WAS_M    = {{ block.settings.addon_was_monthly     | default: '$24.00'                           | json }};
  var ADDON_WAS_Q    = {{ block.settings.addon_was_quarterly   | default: '$24.00'                           | json }};
  var ADDON_WAS_OT   = {{ block.settings.addon_was_onetime     | default: '$24.00'                           | json }};

  var ACTION_LABEL_PLANS    = {{ block.settings.action_label_step1 | default: 'Continue' | json }};
  var ACTION_LABEL_PRODUCTS = {{ block.settings.action_label_step2 | default: 'Continue' | json }};
  var CHECKOUT_LABEL        = {{ block.settings.checkout_label     | default: 'Checkout' | json }};

  /* State */
  var STEPS_ORDER = ['plans', 'products', 'upsells'];
  var state = {
    step: 'plans',
    plan: 'quarterly',
    selections: {}  /* variantId -> {qty, fnId, productHandle, planMonthly, planQuarterly, price, compareAt} */
  };

  /* Helpers */
  function $(sel, ctx) { return (ctx || root).querySelector(sel); }
  function $$(sel, ctx) { return Array.prototype.slice.call((ctx || root).querySelectorAll(sel)); }
  function fmtMoney(c) { return '$' + (Math.max(0, c) / 100).toFixed(2); }

  /* Determine the default plan from the rendered checked radio. */
  var pre = $('input[name="ftdc-plan-' + SID + '"]:checked');
  if (pre) state.plan = pre.value;

  /* ---------- Step nav ---------- */
  function showStep(name) {
    if (STEPS_ORDER.indexOf(name) === -1) return;
    state.step = name;
    var idx = STEPS_ORDER.indexOf(name);
    $$('.ftdc__step', root).forEach(function (s) {
      var match = s.getAttribute('data-step') === name;
      s.hidden = !match;
      s.classList.toggle('is-active', match);
    });
    $$('.ftdc__step-pill', root).forEach(function (pill) {
      var pillIdx = STEPS_ORDER.indexOf(pill.getAttribute('data-step-pill'));
      pill.classList.toggle('is-active', pillIdx === idx);
      pill.classList.toggle('is-done', pillIdx < idx);
    });
    updateBar();
  }

  /* ---------- Plan picker ---------- */
  $$('input[name="ftdc-plan-' + SID + '"]', root).forEach(function (radio) {
    radio.addEventListener('change', function () {
      state.plan = radio.value;
      $$('.ftdc__plan', root).forEach(function (p) { p.classList.remove('is-active'); });
      var lbl = radio.closest('.ftdc__plan');
      if (lbl) lbl.classList.add('is-active');
      /* Plan changes -> reset selections (rules differ per plan). */
      state.selections = {};
      $$('.ftdc__card', root).forEach(resetCardSelection);
      updateProgress();
      updateCreatineCard();
      updateBar();
    });
  });

  /* ---------- Cards: add / qty stepper ---------- */
  function resetCardSelection(card) {
    card.classList.remove('is-selected');
    var add  = $('.ftdc__add', card);
    var qty  = $('.ftdc__qty', card);
    var qInp = $('.ftdc__qty-input', card);
    if (add) add.hidden = false;
    if (qty) qty.hidden = true;
    if (qInp) qInp.value = 0;
  }
  function setCardQty(card, n) {
    if (card.dataset.comingSoon === 'true') return;
    n = Math.max(0, Math.floor(n));
    /* Quarterly cap: don't let the customer exceed bundle_count across all cards. */
    if (state.plan === 'quarterly') {
      var others = totalSelectedQty() - (state.selections[card.dataset.variantId] ? state.selections[card.dataset.variantId].qty : 0);
      var capForThis = Math.max(0, BUNDLE_COUNT - others);
      if (n > capForThis) n = capForThis;
    }
    var vid = card.dataset.variantId;
    var add = $('.ftdc__add', card);
    var qty = $('.ftdc__qty', card);
    var qInp = $('.ftdc__qty-input', card);
    if (n === 0) {
      delete state.selections[vid];
      card.classList.remove('is-selected');
      if (add) add.hidden = false;
      if (qty) qty.hidden = true;
      if (qInp) qInp.value = 0;
    } else {
      state.selections[vid] = {
        qty: n,
        variantId: vid,
        fnId: card.dataset.fnId,
        fnLabel: card.dataset.fnLabel,
        flavorName: card.dataset.flavorName,
        productHandle: card.dataset.productHandle,
        planMonthly: card.dataset.planMonthly || '',
        planQuarterly: card.dataset.planQuarterly || '',
        price: parseInt(card.dataset.variantPrice, 10) || 0,
        compareAt: parseInt(card.dataset.variantCompare, 10) || 0
      };
      card.classList.add('is-selected');
      if (add) add.hidden = true;
      if (qty) qty.hidden = false;
      if (qInp) qInp.value = n;
    }
    updateProgress();
    updateBar();
  }
  $$('.ftdc__card', root).forEach(function (card) {
    card.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-card-action]');
      if (!btn) return;
      var action = btn.getAttribute('data-card-action');
      var qInp = $('.ftdc__qty-input', card);
      var cur = parseInt(qInp ? qInp.value : 0, 10) || 0;
      if (action === 'add') setCardQty(card, 1);
      else if (action === 'inc') setCardQty(card, cur + 1);
      else if (action === 'dec') setCardQty(card, cur - 1);
    });
    var qInp = $('.ftdc__qty-input', card);
    if (qInp) {
      qInp.addEventListener('change', function () {
        setCardQty(card, parseInt(qInp.value, 10) || 0);
      });
    }
  });

  /* ---------- Progress, total, bar ---------- */
  function totalSelectedQty() {
    var n = 0;
    Object.keys(state.selections).forEach(function (k) { n += state.selections[k].qty; });
    return n;
  }
  function bundleSize() {
    return state.plan === 'quarterly' ? BUNDLE_COUNT : 0;
  }
  function updateProgress() {
    var n = totalSelectedQty();
    var size = bundleSize();
    var pt = $('[data-progress-text]', root);
    var pf = $('[data-progress-fill]', root);
    if (!pt || !pf) return;
    if (size) {
      pt.textContent = n + ' of ' + size + ' selected';
      pf.style.width = Math.min(100, n / size * 100) + '%';
    } else {
      pt.textContent = n ? (n + ' selected') : 'Choose your pouches';
      pf.style.width = n > 0 ? '100%' : '0%';
    }
  }
  function computeTotal() {
    /* Estimate display total. Real prices apply at checkout via the
       selling-plan discount. We approximate using plan-typical discounts
       so the bar matches what the customer sees on the cart page. */
    var monthlyMul   = (parseInt({{ block.settings.monthly_estimate_pct   | default: 90 | json }}, 10) || 90) / 100;
    var quarterlyMul = (parseInt({{ block.settings.quarterly_estimate_pct | default: 90 | json }}, 10) || 90) / 100;
    var mul = 1;
    if (state.plan === 'monthly')   mul = monthlyMul;
    if (state.plan === 'quarterly') mul = quarterlyMul;
    var total = 0, saved = 0;
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k];
      var unit = s.price * mul;
      total += unit * s.qty;
      var compare = s.compareAt > s.price ? s.compareAt : s.price;
      saved += Math.max(0, compare - unit) * s.qty;
    });
    return { total: Math.round(total), saved: Math.round(saved) };
  }
  function updateBar() {
    var t = computeTotal();
    var bt = $('[data-bar-total]', root);
    var sw = $('[data-bar-saved-wrap]', root);
    var sv = $('[data-bar-saved]', root);
    if (bt) bt.textContent = fmtMoney(t.total);
    if (sw && sv) {
      if (t.saved > 0) { sw.hidden = false; sv.textContent = fmtMoney(t.saved); }
      else sw.hidden = true;
    }
    var label = $('[data-bar-label]', root);
    var btn   = $('.ftdc__bar-action', root);
    var ready = canProceed();
    if (state.step === 'plans')         { if (label) label.textContent = ACTION_LABEL_PLANS;    if (btn) btn.disabled = false; }
    else if (state.step === 'products') { if (label) label.textContent = ACTION_LABEL_PRODUCTS; if (btn) btn.disabled = !ready; }
    else                                { if (label) label.textContent = CHECKOUT_LABEL;        if (btn) btn.disabled = !ready; }
  }
  function canProceed() {
    if (state.step === 'plans')    return !!state.plan;
    if (state.step === 'products') {
      var n = totalSelectedQty();
      var size = bundleSize();
      return size ? n === size : n > 0;
    }
    return true;
  }

  /* ---------- Creatine card swap on plan change ---------- */
  function updateCreatineCard() {
    var t = $('[data-creatine-title]', root);
    var d = $('[data-creatine-desc]',  root);
    var p = $('[data-creatine-price]', root);
    var w = $('[data-creatine-was]',   root);
    if (!t) return;
    if (state.plan === 'quarterly')      { t.textContent = ADDON_LABEL_Q;  d.textContent = ADDON_DESC_Q;  if (p) p.textContent = ADDON_PRICE_Q;  if (w) w.textContent = ADDON_WAS_Q; }
    else if (state.plan === 'monthly')   { t.textContent = ADDON_LABEL_M;  d.textContent = ADDON_DESC_M;  if (p) p.textContent = ADDON_PRICE_M;  if (w) w.textContent = ADDON_WAS_M; }
    else                                  { t.textContent = ADDON_LABEL_OT; d.textContent = ADDON_DESC_OT; if (p) p.textContent = ADDON_PRICE_OT; if (w) w.textContent = ADDON_WAS_OT; }
  }

  /* ---------- Step actions: next / back / checkout ---------- */
  $$('[data-step-back]', root).forEach(function (b) {
    b.addEventListener('click', function () { showStep(b.getAttribute('data-step-back')); });
  });
  var actionBtn = $('.ftdc__bar-action', root);
  if (actionBtn) {
    actionBtn.addEventListener('click', function () {
      if (state.step === 'plans')         showStep('products');
      else if (state.step === 'products') { if (canProceed()) showStep('upsells'); }
      else                                doCheckout();
    });
  }
  var checkoutBtn = $('[data-action="checkout"]', root);
  if (checkoutBtn) checkoutBtn.addEventListener('click', doCheckout);

  /* ---------- Cart-add ---------- */
  function buildCartItems() {
    var items = [];
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k];
      var item = { id: parseInt(s.variantId, 10), quantity: s.qty };
      if (state.plan === 'monthly') {
        var pm = parseInt(s.planMonthly, 10); if (pm) item.selling_plan = pm;
      } else if (state.plan === 'quarterly') {
        var pq = parseInt(s.planQuarterly, 10); if (pq) item.selling_plan = pq;
      }
      items.push(item);
    });
    /* Creatine */
    var crInput = $('[data-creatine-input]', root);
    if (crInput && crInput.checked) {
      var crVid = parseInt(crInput.getAttribute('data-variant'), 10);
      if (crVid) {
        var crItem = { id: crVid, quantity: 1 };
        if (state.plan === 'monthly') {
          var crpm = parseInt(crInput.getAttribute('data-plan-monthly'), 10);
          if (crpm) crItem.selling_plan = crpm;
        } else if (state.plan === 'quarterly') {
          /* Free first-creatine via the configured free selling-plan. */
          var crpfree = parseInt(crInput.getAttribute('data-plan-quarterly-free'), 10);
          if (crpfree) crItem.selling_plan = crpfree;
        } else {
          /* One-time creatine -> tag so the post-add flow can redirect through /discount/CODE */
          crItem.properties = { _upsell: 'creatine-onetime' };
        }
        items.push(crItem);
      }
    }
    /* Custom upsells */
    $$('[data-upsell-block]', root).forEach(function (u) {
      var allowed = (u.getAttribute('data-plans-allowed') || '').split(',').map(function (x) { return x.trim(); });
      if (allowed.length && allowed.indexOf(state.plan) === -1) return;
      var input = $('[data-upsell-input]', u);
      if (!input || !input.checked) return;
      var vid = parseInt(u.getAttribute('data-variant'), 10);
      if (vid) items.push({ id: vid, quantity: 1 });
    });
    return items;
  }

  function doCheckout() {
    if (!canProceed()) return;
    var items = buildCartItems();
    if (!items.length) return;
    actionBtn && (actionBtn.disabled = true);
    checkoutBtn && (checkoutBtn.disabled = true);

    var crInput = $('[data-creatine-input]', root);
    var creatineOT = state.plan === 'onetime' && crInput && crInput.checked;
    var discountOT = creatineOT ? (crInput.getAttribute('data-discount-onetime') || '') : '';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      if (!r.ok) return r.json().then(function (b) { throw new Error((b && (b.description || b.message)) || 'Cart error'); });
      return r.json();
    }).then(function () {
      if (discountOT) {
        window.location.href = '/discount/' + encodeURIComponent(discountOT) + '?redirect=/checkout';
      } else {
        window.location.href = '/checkout';
      }
    }).catch(function (e) {
      /* Soft fail -> re-enable, surface message in console */
      console.error('ftdc checkout', e);
      actionBtn && (actionBtn.disabled = false);
      checkoutBtn && (checkoutBtn.disabled = false);
      alert(e.message || 'Something went wrong. Please try again.');
    });
  }

  /* ---------- Init ---------- */
  showStep('plans');
  updateProgress();
  updateCreatineCard();
  updateBar();
})();
</script>


<script>
(function () {
  var triggers = document.querySelectorAll('[data-ftdc-slideover-open="{{ block.id }}"]');
  var closers  = document.querySelectorAll('[data-ftdc-slideover-close="{{ block.id }}"]');
  var dialog   = document.getElementById('ftdc-slideover-{{ block.id }}');
  if (!dialog) return;
  var lastFocus = null;

  function open() {
    lastFocus = document.activeElement;
    dialog.classList.add('is-open');
    dialog.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    /* Focus the close button so keyboard users can dismiss easily */
    var close = dialog.querySelector('.ftdc-slideover__close');
    if (close) setTimeout(function () { close.focus(); }, 80);
  }
  function close() {
    dialog.classList.remove('is-open');
    dialog.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }
  Array.prototype.forEach.call(triggers, function (t) { t.addEventListener('click', open); });
  Array.prototype.forEach.call(closers,  function (c) { c.addEventListener('click', close); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && dialog.classList.contains('is-open')) close();
  });
})();
</script>

