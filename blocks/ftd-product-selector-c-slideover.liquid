{% comment %}
  Block: FTD - Product Selector C — Slide-over
  ----------------------------------------------------------------------
  Trigger button slides a full-screen panel in from the right; inside,
  the same wizard (Plan -> Products -> Upsells -> Cart) as the
  standalone Section C variant.

  Architecture: child theme blocks (_ftd-c-function, _ftd-c-bullet,
  _ftd-c-upsell) self-render their own markup with data-slot attrs.
  We render them via content_for 'blocks' into a hidden staging div,
  then JS moves each one into the right container on init.
{% endcomment %}

{%- liquid
  assign sid = block.id
  assign show_onetime   = block.settings.show_onetime
  assign show_monthly   = block.settings.show_monthly
  assign show_quarterly = block.settings.show_quarterly
  assign bundle_count   = block.settings.bundle_count | default: 3
  assign addon          = block.settings.addon_product
  assign addon_variant_id = ''
  if addon != blank and addon.selected_or_first_available_variant != blank
    assign addon_variant_id = addon.selected_or_first_available_variant.id
  endif
-%}

<div class="ftdc-slideover-wrap" {{ block.shopify_attributes }}>
  <button class="ftdc-slideover-trigger ftdc-slideover-trigger--{{ block.settings.button_style | default: 'filled' }}"
          type="button"
          data-ftdc-slideover-open="{{ sid }}"
          aria-haspopup="dialog"
          aria-controls="ftdc-slideover-{{ sid }}">
    {{ block.settings.button_label | default: 'Build Your Bundle' }}
  </button>

  <div class="ftdc-slideover" id="ftdc-slideover-{{ sid }}" style="--ftdc-slideover-w: {{ block.settings.slideover_width | default: 560 }}px;" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ block.settings.button_label | default: 'Build Your Bundle' | escape }}">
    <div class="ftdc-slideover__backdrop" data-ftdc-slideover-close="{{ sid }}" aria-hidden="true"></div>
    <div class="ftdc-slideover__panel" role="document">
      <button class="ftdc-slideover__close" type="button" data-ftdc-slideover-close="{{ sid }}" aria-label="{{ block.settings.close_label | default: 'Close' | escape }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      <div class="ftdc-slideover__inner">
        <section
          id="ftdc-{{ sid }}"
          class="ftdc color-{{ block.settings.color_scheme }}"
          data-section-id="{{ sid }}"
          style="--ftdc-accent: {{ block.settings.accent_color }}; --ftdc-radius: {{ block.settings.card_radius }}px; --ftdc-max-w: {{ block.settings.content_max_width }}px;"
        >
          <div class="ftdc__inner">

            <header class="ftdc__header">
              {%- if block.settings.heading != blank -%}<h2 class="ftdc__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.description != blank -%}<div class="ftdc__desc">{{ block.settings.description }}</div>{%- endif -%}
              <ul class="ftdc__bullets list-unstyled" data-bullets hidden></ul>
            </header>

            <ol class="ftdc__steps" role="list" aria-label="Order steps">
              <li class="ftdc__step-pill is-active" data-step-pill="plans"><span class="ftdc__step-num">1</span><span class="ftdc__step-label">{{ block.settings.step_label_1 | default: 'Plan' }}</span></li>
              <li class="ftdc__step-pill" data-step-pill="products"><span class="ftdc__step-num">2</span><span class="ftdc__step-label">{{ block.settings.step_label_2 | default: 'Bundle' }}</span></li>
              <li class="ftdc__step-pill" data-step-pill="upsells"><span class="ftdc__step-num">3</span><span class="ftdc__step-label">{{ block.settings.step_label_3 | default: 'Boost' }}</span></li>
            </ol>

            {%- comment %} ───── STEP 1 — PLANS ───── {%- endcomment %}
            <div class="ftdc__step is-active" data-step="plans">
              <div class="ftdc__plans" data-plan-order="{{ block.settings.plan_order | default: 'quarterly,monthly,onetime' }}">
                {%- if show_quarterly -%}
                  <label class="ftdc__plan is-active" data-plan="quarterly">
                    <input type="radio" name="ftdc-plan-{{ sid }}" value="quarterly" checked>
                    <span class="ftdc__plan-tick" aria-hidden="true"></span>
                    {%- if block.settings.quarterly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.quarterly_badge }}</span>{%- endif -%}
                    <div class="ftdc__plan-title">{{ block.settings.quarterly_title | default: '3 Pouches Every 3 Months' }}</div>
                    {%- if block.settings.quarterly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.quarterly_desc }}</div>{%- endif -%}
                    <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.quarterly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ block.settings.quarterly_period | default: '/ month' }}</span></div>
                    {%- if block.settings.quarterly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.quarterly_was }}</div>{%- endif -%}
                  </label>
                {%- endif -%}
                {%- if show_monthly -%}
                  <label class="ftdc__plan" data-plan="monthly">
                    <input type="radio" name="ftdc-plan-{{ sid }}" value="monthly">
                    <span class="ftdc__plan-tick" aria-hidden="true"></span>
                    {%- if block.settings.monthly_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.monthly_badge }}</span>{%- endif -%}
                    <div class="ftdc__plan-title">{{ block.settings.monthly_title | default: '1 Pouch Every Month' }}</div>
                    {%- if block.settings.monthly_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.monthly_desc }}</div>{%- endif -%}
                    <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.monthly_price | default: '$53.10' }}</span><span class="ftdc__plan-period">{{ block.settings.monthly_period | default: '/ month' }}</span></div>
                    {%- if block.settings.monthly_was != blank -%}<div class="ftdc__plan-was">{{ block.settings.monthly_was }}</div>{%- endif -%}
                  </label>
                {%- endif -%}
                {%- if show_onetime -%}
                  <label class="ftdc__plan" data-plan="onetime">
                    <input type="radio" name="ftdc-plan-{{ sid }}" value="onetime">
                    <span class="ftdc__plan-tick" aria-hidden="true"></span>
                    {%- if block.settings.onetime_badge != blank -%}<span class="ftdc__plan-badge">{{ block.settings.onetime_badge }}</span>{%- endif -%}
                    <div class="ftdc__plan-title">{{ block.settings.onetime_title | default: 'Single Pouch' }}</div>
                    {%- if block.settings.onetime_desc != blank -%}<div class="ftdc__plan-desc">{{ block.settings.onetime_desc }}</div>{%- endif -%}
                    <div class="ftdc__plan-pricing"><span class="ftdc__plan-price">{{ block.settings.onetime_price | default: '$59.00' }}</span><span class="ftdc__plan-period">{{ block.settings.onetime_period | default: '/ pouch' }}</span></div>
                    {%- assign _ow = block.settings.onetime_was | strip -%}
                    {%- if _ow != blank and _ow != '-' and _ow != '—' -%}<div class="ftdc__plan-was">{{ block.settings.onetime_was }}</div>{%- endif -%}
                  </label>
                {%- endif -%}
              </div>
            </div>

            {%- comment %} ───── STEP 2 — PRODUCTS ───── {%- endcomment %}
            <div class="ftdc__step" data-step="products" hidden>
              <button class="ftdc__back" type="button" data-step-back="plans" aria-label="Back to plan"><span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}</button>
              <div class="ftdc__bundle-head">
                <p class="ftdc__bundle-eyebrow">{{ block.settings.bundle_label | default: 'Your Bundle' }}</p>
                <p class="ftdc__bundle-progress-text" data-progress-text>0 {{ block.settings.of_word | default: 'of' }} {{ bundle_count }} {{ block.settings.selected_word | default: 'selected' }}</p>
                <div class="ftdc__bundle-bar"><div class="ftdc__bundle-bar-fill" data-progress-fill style="width:0%"></div></div>
              </div>
              <div class="ftdc__empty" data-grid-empty hidden>
                <p><strong>No products configured yet.</strong></p>
                <p>In the theme editor sidebar, click each <em>Function</em> block inside this slide-over and pick a Shopify product. Each product variant will render as a selectable card here.</p>
              </div>
              <div class="ftdc__grid" data-grid></div>
            </div>

            {%- comment %} ───── STEP 3 — UPSELLS ───── {%- endcomment %}
            <div class="ftdc__step" data-step="upsells" hidden>
              <button class="ftdc__back" type="button" data-step-back="products" aria-label="Back to bundle"><span aria-hidden="true">←</span> {{ block.settings.back_label | default: 'Back' }}</button>

              {%- comment %} Hardcoded "Creatine included free" indicator — only
              shown on quarterly. Title/desc/FREE label are not exposed in
              theme settings; image reuses the addon image so the merchant
              only manages one creatine asset. {%- endcomment %}
              {%- assign included_img = block.settings.addon_image | default: addon.featured_image -%}
              <div class="ftdc__upsell ftdc__upsell--included" data-creatine-included hidden aria-hidden="true">
                <div class="ftdc__upsell-media">
                  {%- if included_img != blank -%}
                    <img src="{{ included_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">
                  {%- endif -%}
                </div>
                <div class="ftdc__upsell-body">
                  <p class="ftdc__upsell-title">Creatine — Included</p>
                  <p class="ftdc__upsell-desc">Free with your 3-month bundle.</p>
                  <div class="ftdc__upsell-pricing">
                    <span class="ftdc__upsell-price ftdc__upsell-price--free">FREE</span>
                  </div>
                </div>
                <div class="ftdc__upsell-toggle">
                  <span class="ftdc__included-check" aria-label="Included" role="img">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4 4 10-10" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </div>

              {%- if addon != blank -%}
                <div class="ftdc__upsell ftdc__upsell--creatine" data-upsell-creatine>
                  <div class="ftdc__upsell-media">
                    {%- assign addon_img = block.settings.addon_image | default: addon.featured_image -%}
                    {%- if addon_img != blank -%}<img src="{{ addon_img | image_url: width: 240 }}" alt="" width="80" height="80" loading="lazy">{%- endif -%}
                  </div>
                  <div class="ftdc__upsell-body">
                    <p class="ftdc__upsell-title" data-creatine-title>{{ block.settings.addon_label_monthly | default: 'Add Creatine — 50% off' }}</p>
                    <p class="ftdc__upsell-desc" data-creatine-desc>{{ block.settings.addon_desc_monthly | default: '' }}</p>
                    <div class="ftdc__upsell-pricing">
                      <span class="ftdc__upsell-price" data-creatine-price>{{ block.settings.addon_price_monthly | default: '$12.00' }}</span>
                      {%- if block.settings.addon_was_monthly != blank -%}<s class="ftdc__upsell-was" data-creatine-was>{{ block.settings.addon_was_monthly }}</s>{%- endif -%}
                    </div>
                  </div>
                  <div class="ftdc__upsell-toggle">
                    <input type="checkbox" id="ftdc-cr-{{ sid }}" class="visually-hidden" data-creatine-input data-variant="{{ addon_variant_id }}" data-plan-monthly="{{ block.settings.addon_loop_plan_monthly }}" data-plan-quarterly-free="{{ block.settings.addon_loop_plan_quarterly_free }}" data-plan-quarterly-50off="{{ block.settings.addon_loop_plan_quarterly_50off }}" data-discount-onetime="{{ block.settings.addon_discount_code_onetime }}">
                    <label for="ftdc-cr-{{ sid }}" class="ftdc__switch" aria-hidden="true"></label>
                  </div>
                </div>
              {%- endif -%}

              <div class="ftdc__upsells" data-upsells></div>

              <div class="ftdc__step-actions">
                <button class="ftdc__btn ftdc__btn--ghost" type="button" data-step-back="products">{{ block.settings.add_more_label | default: 'Add More' }}</button>
                <button class="ftdc__btn ftdc__btn--primary" type="button" data-action="checkout">{{ block.settings.checkout_label | default: 'Checkout' }}</button>
              </div>
            </div>

            <div class="ftdc__bar" data-bar>
              <div class="ftdc__bar-summary">
                <span class="ftdc__bar-total"><strong>{{ block.settings.total_label | default: 'Total' }}:</strong> <span data-bar-total>$0.00</span></span>
                <span class="ftdc__bar-saved" data-bar-saved-wrap hidden>({{ block.settings.saved_word | default: 'Saved' }} <span data-bar-saved>$0.00</span>)</span>
              </div>
              <button class="ftdc__bar-action" type="button" data-action="next"><span data-bar-label>{{ block.settings.action_label_step1 | default: 'Continue' }}</span></button>
            </div>

          </div>

          {%- comment %} Hidden staging: child theme blocks render here, JS moves them. {%- endcomment %}
          <div style="display:none" data-ftdc-stage aria-hidden="true">{% content_for 'blocks' %}</div>
        </section>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Slide-over wrapper */
  .ftdc-slideover-wrap { display: inline-block; }
  .ftdc-slideover-trigger { display: inline-flex; align-items: center; justify-content: center; padding: 0.95rem 1.5rem; font-size: 14px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 999px; cursor: pointer; border: 1.5px solid var(--color-foreground); transition: opacity 0.18s, transform 0.15s; }
  .ftdc-slideover-trigger--filled { background: var(--color-foreground); color: var(--color-background); }
  .ftdc-slideover-trigger--outline { background: transparent; color: var(--color-foreground); }
  .ftdc-slideover-trigger:hover { opacity: 0.9; }
  .ftdc-slideover { position: fixed; inset: 0; z-index: 2147483647; pointer-events: none; visibility: hidden; }
  .ftdc-slideover.is-open { pointer-events: auto; visibility: visible; }
  .ftdc-slideover__backdrop { position: absolute; inset: 0; background: rgb(0 0 0 / 0.45); opacity: 0; transition: opacity 0.25s ease; }
  .ftdc-slideover.is-open .ftdc-slideover__backdrop { opacity: 1; }
  .ftdc-slideover__panel { position: absolute; inset: 0; background: var(--color-background); transform: translateX(100%); transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1); overflow-y: auto; overscroll-behavior: contain; }
  .ftdc-slideover.is-open .ftdc-slideover__panel { transform: translateX(0); }
  .ftdc-slideover__close { position: absolute; top: 16px; right: 16px; width: 44px; height: 44px; border-radius: 50%; background: var(--color-background); color: var(--color-foreground); border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.15); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; }
  .ftdc-slideover__close:hover { background: rgb(var(--color-foreground-rgb) / 0.05); }
  .ftdc-slideover__inner { padding-top: 60px; }

  /* Wizard (mirrors the section) */
  .ftdc { position: relative; }
  .ftdc__inner { max-width: var(--ftdc-max-w, 1240px); margin-inline: auto; padding-inline: clamp(16px, 4vw, 28px); padding-block-end: 96px; }
  .ftdc__header { text-align: center; margin-block-end: clamp(20px, 3vw, 32px); }
  .ftdc__heading { margin: 0 0 0.5em; font-size: clamp(28px, 4.4vw, 56px); font-weight: 900; line-height: 1; text-transform: uppercase; color: var(--color-foreground); }
  .ftdc__desc { margin: 0 auto 1em; font-size: clamp(15px, 1.25vw, 17px); line-height: 1.55; opacity: 0.75; max-width: 36em; color: var(--color-foreground); }
  .ftdc__bullets { display: flex; flex-direction: column; gap: 0.65rem; align-items: flex-start; max-width: 22em; margin: 1.25rem auto 0; padding: 0; list-style: none; }
  .ftdc__bullets[hidden] { display: none; }
  .ftdc__bullet { display: flex; align-items: center; gap: 0.75rem; }
  .ftdc__bullet-dot { width: 22px; height: 22px; border-radius: 50%; background: color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 18%, transparent); position: relative; flex-shrink: 0; }
  .ftdc__bullet-dot::after { content: ''; position: absolute; inset: 6px; border-radius: 50%; background: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__bullet-text { font-size: 15px; font-weight: 700; color: var(--color-foreground); }
  .ftdc__steps { display: flex; justify-content: center; gap: 0.75rem; padding: 0; margin: 0 0 clamp(20px, 3vw, 32px); list-style: none; }
  .ftdc__step-pill { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.85rem; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; background: rgb(var(--color-foreground-rgb) / 0.06); color: rgb(var(--color-foreground-rgb) / 0.6); transition: background 0.18s, color 0.18s; }
  .ftdc__step-pill.is-active { background: var(--color-foreground); color: var(--color-background); }
  .ftdc__step-pill.is-done   { color: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__step-num { width: 18px; height: 18px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; background: currentColor; color: var(--color-background); }
  .ftdc__step-pill.is-active .ftdc__step-num { background: var(--color-background); color: var(--color-foreground); }
  .ftdc__step { display: none; }
  .ftdc__step.is-active { display: block; }
  [hidden] { display: none !important; }
  .ftdc__back { display: inline-flex; align-items: center; gap: 0.35rem; background: none; border: 0; padding: 0.25rem 0.5rem 0.75rem; font-size: 13px; font-weight: 700; letter-spacing: 0.05em; color: var(--color-foreground); cursor: pointer; opacity: 0.7; }
  .ftdc__plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; }
  .ftdc .ftdc__plan { position: relative !important; display: grid !important; grid-template-columns: minmax(0, 1fr) !important; gap: 0.45rem !important; padding: 1rem 1.1rem !important; border: 2px solid rgb(var(--color-foreground-rgb) / 0.12); border-radius: var(--ftdc-radius, 12px); background: var(--color-background); cursor: pointer; overflow: hidden; min-width: 0 !important; width: 100% !important; }
  .ftdc .ftdc__plan > * { min-width: 0; max-width: 100%; }
  .ftdc .ftdc__plan-title, .ftdc .ftdc__plan-desc, .ftdc .ftdc__plan-pricing, .ftdc .ftdc__plan-was { display: block !important; width: 100% !important; }
  .ftdc .ftdc__plan-pricing { display: flex !important; align-items: baseline; gap: 0.35rem; margin-top: 0.25rem; flex-wrap: wrap; }
  .ftdc__plan.is-active { border-color: var(--ftdc-accent, var(--color-primary-button-background)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 14%, transparent); }
  .ftdc__plan input { position: absolute; opacity: 0; pointer-events: none; }
  .ftdc__plan-tick { position: absolute; top: 12px; right: 12px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgb(var(--color-foreground-rgb) / 0.25); display: inline-flex; align-items: center; justify-content: center; }
  .ftdc__plan.is-active .ftdc__plan-tick { background: var(--ftdc-accent, var(--color-primary-button-background)); border-color: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__plan.is-active .ftdc__plan-tick::after { content: ''; width: 6px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); margin-top: -2px; }
  .ftdc__plan-badge { display: inline-flex; align-self: flex-start; padding: 0.15rem 0.55rem; border-radius: 4px; font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; background: var(--ftdc-accent, var(--color-primary-button-background)); color: #fff; }
  .ftdc__plan-title { font-size: 17px; font-weight: 800; line-height: 1.2; color: var(--color-foreground); padding-right: 36px; overflow-wrap: break-word; }
  .ftdc__plan-desc { font-size: 13px; line-height: 1.4; opacity: 0.7; color: var(--color-foreground); }
  .ftdc__plan-price { font-size: 22px; font-weight: 800; color: var(--color-foreground); }
  .ftdc__plan-period { font-size: 13px; opacity: 0.7; color: var(--color-foreground); }
  .ftdc__plan-was { display: block; font-size: 12px; color: rgb(var(--color-foreground-rgb) / 0.5); text-decoration: line-through; }
  .ftdc__bundle-head { text-align: center; margin: 0.5rem 0 1.25rem; }
  .ftdc__bundle-eyebrow { margin: 0 0 0.35rem; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.6; color: var(--color-foreground); }
  .ftdc__bundle-progress-text { margin: 0 0 0.6rem; font-size: 14px; color: var(--color-foreground); }
  .ftdc__bundle-bar { width: 100%; max-width: 32em; margin: 0 auto; height: 6px; background: rgb(var(--color-foreground-rgb) / 0.08); border-radius: 999px; overflow: hidden; }
  .ftdc__bundle-bar-fill { height: 100%; background: var(--ftdc-accent, var(--color-primary-button-background)); border-radius: inherit; transition: width 0.25s ease; }
  .ftdc__empty { padding: 1.25rem 1.25rem; border-radius: var(--ftdc-radius, 12px); border: 2px dashed rgb(var(--color-foreground-rgb) / 0.2); background: rgb(var(--color-foreground-rgb) / 0.03); text-align: center; max-width: 38em; margin: 0 auto 1.25rem; color: var(--color-foreground); }
  .ftdc__empty p { margin: 0 0 0.5rem; font-size: 14px; line-height: 1.5; }
  .ftdc__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; }
  @media (max-width: 599px) { .ftdc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; } }
  .ftdc__card { position: relative; display: flex; flex-direction: column; background: var(--color-background); border: 2px solid rgb(var(--color-foreground-rgb) / 0.12); border-radius: var(--ftdc-radius, 12px); overflow: hidden; min-width: 0; }
  .ftdc__card.is-selected { border-color: var(--color-foreground); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-foreground) 12%, transparent); }
  .ftdc__card--placeholder { opacity: 0.6; outline: 2px dashed rgb(var(--color-foreground-rgb) / 0.2); }
  .ftdc__card-media { position: relative; aspect-ratio: 1 / 1; background: rgb(var(--color-foreground-rgb) / 0.04); display: flex; align-items: center; justify-content: center; padding: 0.65rem; flex-shrink: 0; }
  .ftdc__card-media img { width: 100%; height: 100%; object-fit: contain; }
  .ftdc__card-tick { position: absolute; top: 8px; right: 8px; width: 22px; height: 22px; border-radius: 50%; background: var(--ftdc-accent, var(--color-primary-button-background)); color: #fff; display: inline-flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; }
  .ftdc__card.is-selected .ftdc__card-tick { opacity: 1; }
  .ftdc__card-body { padding: 0.85rem 0.9rem; display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; flex: 1; }
  .ftdc__card-hint { margin: 0; font-size: 11px; opacity: 0.7; }
  .ftdc__card-spec-top { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--color-foreground-rgb) / 0.55); }
  .ftdc__card-name { margin: 0; font-size: 12.5px; font-weight: 800; line-height: 1.3; text-transform: uppercase; color: var(--color-foreground); overflow-wrap: break-word; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
  .ftdc__card-flavor { font-weight: 700; opacity: 0.85; display: block; margin-top: 0.15rem; }
  .ftdc__card-specs { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .ftdc__spec { font-size: 9.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.22rem 0.45rem; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 80%, transparent); color: var(--ftdc-accent, var(--color-primary-button-background)); white-space: nowrap; }
  .ftdc__card-pricing { display: flex; align-items: baseline; gap: 0.45rem; flex-wrap: wrap; margin-top: auto; }
  .ftdc__card-price { font-weight: 800; font-size: 15px; color: var(--color-foreground); }
  .ftdc__card-was { font-size: 12px; color: rgb(var(--color-foreground-rgb) / 0.5); text-decoration: line-through; }
  .ftdc__card-action { margin-top: 0.4rem; }
  .ftdc__add { width: 100%; padding: 0.55rem 0.75rem; font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 8px; border: 1.5px solid var(--color-foreground); background: transparent; color: var(--color-foreground); cursor: pointer; }
  .ftdc__qty { display: grid; grid-template-columns: auto 1fr auto; align-items: stretch; border-radius: 8px; border: 1.5px solid var(--color-foreground); overflow: hidden; }
  .ftdc__qty-btn { padding: 0.55rem 0.7rem; background: var(--color-foreground); color: var(--color-background); border: 0; font-size: 14px; font-weight: 800; cursor: pointer; }
  .ftdc__qty-input { border: 0; text-align: center; font-size: 14px; font-weight: 800; background: var(--color-background); color: var(--color-foreground); width: 100%; padding: 0; }
  .ftdc__upsell { display: grid; grid-template-columns: 80px 1fr auto; gap: 0.85rem; align-items: center; padding: 0.85rem 1rem; border-radius: var(--ftdc-radius, 12px); border: 2px solid rgb(var(--color-foreground-rgb) / 0.12); background: var(--color-background); margin-bottom: 0.75rem; }
  .ftdc__upsell-media { width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: rgb(var(--color-foreground-rgb) / 0.06); display: inline-flex; align-items: center; justify-content: center; }
  .ftdc__upsell-media img { width: 100%; height: 100%; object-fit: cover; }
  .ftdc__upsell-title { margin: 0; font-size: 15px; font-weight: 800; line-height: 1.25; color: var(--color-foreground); }
  .ftdc__upsell-desc { margin: 0.2rem 0 0.35rem; font-size: 12px; line-height: 1.4; opacity: 0.7; color: var(--color-foreground); }
  .ftdc__upsell-pricing { display: flex; align-items: baseline; gap: 0.4rem; }
  .ftdc__upsell-price { font-weight: 800; font-size: 15px; color: var(--color-foreground); }
  .ftdc__upsell-was { font-size: 12px; color: rgb(var(--color-foreground-rgb) / 0.5); text-decoration: line-through; }
  .ftdc__switch { display: inline-flex; width: 44px; height: 26px; background: rgb(var(--color-foreground-rgb) / 0.2); border-radius: 999px; position: relative; cursor: pointer; }
  .ftdc__switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--color-background); transition: transform 0.18s; box-shadow: 0 1px 2px rgb(0 0 0 / 0.2); }
  .ftdc__upsell input:checked + .ftdc__switch { background: var(--ftdc-accent, var(--color-primary-button-background)); }
  .ftdc__upsell input:checked + .ftdc__switch::after { transform: translateX(18px); }
  .ftdc__upsell--included { border-color: var(--ftdc-accent, var(--color-primary-button-background)); background: color-mix(in srgb, var(--ftdc-accent, var(--color-primary-button-background)) 8%, var(--color-background)); }
  .ftdc__upsell-price--free { color: var(--ftdc-accent, var(--color-primary-button-background)); letter-spacing: 0.06em; }
  .ftdc__included-check { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ftdc-accent, var(--color-primary-button-background)); color: #fff; }
  .ftdc__step-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 1.25rem; }
  .ftdc__btn { padding: 0.85rem 1.25rem; font-size: 13px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 10px; cursor: pointer; border: 1.5px solid var(--color-foreground); }
  .ftdc__btn--ghost { background: transparent; color: var(--color-foreground); }
  .ftdc__btn--primary { background: var(--color-foreground); color: var(--color-background); }
  .ftdc__bar { position: sticky; bottom: 12px; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1.1rem; margin: 1.5rem auto 0; max-width: 38em; background: var(--color-background); border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.12); border-radius: 999px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.08); }
  .ftdc__bar-summary { display: flex; align-items: baseline; gap: 0.5rem; font-size: 14px; color: var(--color-foreground); }
  .ftdc__bar-total { font-weight: 700; white-space: nowrap; }
  .ftdc__bar-saved { font-size: 12px; opacity: 0.7; white-space: nowrap; }
  .ftdc__bar-action { padding: 0.55rem 1.25rem; background: var(--color-foreground); color: var(--color-background); border: 0; border-radius: 999px; font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; }
  .ftdc__bar-action:disabled { opacity: 0.4; cursor: not-allowed; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
{% endstylesheet %}

<script>
(function () {
  var SID = {{ block.id | json }};
  var root = document.getElementById('ftdc-' + SID);
  if (!root) return;
  var BUNDLE_COUNT = parseInt({{ bundle_count | json }}, 10) || 3;
  var STEPS_ORDER = ['plans', 'products', 'upsells'];
  var state = { step: 'plans', plan: 'quarterly', selections: {} };

  /* Loop bundle mode (quarterly only). When fully configured, the pouches
     are registered with Loop's Create Bundle Transaction API and the cart
     gets pouch lines stamped with one shared loopBundleGuid so the customer
     can edit the whole bundle in Loop's portal later. */
  var LOOP_BUNDLE = {
    enabled:           {{ block.settings.loop_bundle_enabled | json }},
    bundleId:          {{ block.settings.loop_bundle_id | default: '' | json }},
    bundleVariantId:   {{ block.settings.loop_bundle_variant_id | default: '' | json }},
    bundleDiscountId:  {{ block.settings.loop_bundle_discount_id | default: '' | json }},
    apiSellingPlanId:  {{ block.settings.loop_bundle_api_selling_plan_id | default: '' | json }},
    cartSellingPlanId: {{ block.settings.loop_bundle_selling_plan_id | default: '' | json }},
    bundleName:        {{ block.settings.loop_bundle_name | default: '' | json }},
    propKey:           {{ block.settings.loop_bundle_property_key | default: '_bundleId' | json }}
  };
  function _loopBundleSentinel(v) { return v && v !== '-' && v !== '—'; }
  var LOOP_BUNDLE_ON = !!(LOOP_BUNDLE.enabled && _loopBundleSentinel(LOOP_BUNDLE.bundleId) && _loopBundleSentinel(LOOP_BUNDLE.apiSellingPlanId));
  function $(s, c) { return (c || root).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || root).querySelectorAll(s)); }
  function fmtMoney(c) { return '$' + (Math.max(0, c) / 100).toFixed(2); }

  function sortStagedBlocks() {
    var stage = $('[data-ftdc-stage]');
    if (!stage) return;
    var bullets = $('[data-bullets]');
    var grid = $('[data-grid]');
    var upsells = $('[data-upsells]');
    var moved = { bullet: 0, fn: 0, fnPh: 0, up: 0 };
    $$('[data-slot="bullet"]', stage).forEach(function (n) { if (bullets) { bullets.appendChild(n); moved.bullet++; } });
    $$('[data-slot="function"]', stage).forEach(function (n) { if (grid) { grid.appendChild(n); moved.fn++; } });
    $$('[data-slot="function-placeholder"]', stage).forEach(function (n) { if (grid) { grid.appendChild(n); moved.fnPh++; } });
    $$('[data-slot="upsell"]', stage).forEach(function (n) { if (upsells) { upsells.appendChild(n); moved.up++; } });
    if (bullets) bullets.hidden = moved.bullet === 0;
    var gridEmpty = $('[data-grid-empty]');
    if (gridEmpty) gridEmpty.hidden = (moved.fn > 0);
  }
  sortStagedBlocks();

  var plansContainer = $('.ftdc__plans');
  if (plansContainer && plansContainer.dataset.planOrder) {
    plansContainer.dataset.planOrder.split(',').forEach(function (name) {
      var n = name.trim(); if (!n) return;
      var plan = plansContainer.querySelector('[data-plan="' + n + '"]');
      if (plan) plansContainer.appendChild(plan);
    });
  }
  var firstPlan = plansContainer ? plansContainer.querySelector('.ftdc__plan') : null;
  if (firstPlan) {
    $$('.ftdc__plan').forEach(function (p) { p.classList.remove('is-active'); var r = p.querySelector('input'); if (r) r.checked = false; });
    firstPlan.classList.add('is-active');
    var fr = firstPlan.querySelector('input'); if (fr) { fr.checked = true; state.plan = fr.value; }
  }

  function showStep(name) {
    state.step = name;
    var idx = STEPS_ORDER.indexOf(name);
    $$('.ftdc__step').forEach(function (s) { var m = s.dataset.step === name; s.hidden = !m; s.classList.toggle('is-active', m); });
    $$('.ftdc__step-pill').forEach(function (p) { var pi = STEPS_ORDER.indexOf(p.dataset.stepPill); p.classList.toggle('is-active', pi === idx); p.classList.toggle('is-done', pi < idx); });
    updateBar();
  }

  function updateCreatineIncluded() {
    var el = $('[data-creatine-included]');
    if (el) el.hidden = state.plan !== 'quarterly';
  }

  $$('input[name="ftdc-plan-' + SID + '"]').forEach(function (r) {
    r.addEventListener('change', function () {
      state.plan = r.value;
      $$('.ftdc__plan').forEach(function (p) { p.classList.remove('is-active'); });
      var l = r.closest('.ftdc__plan'); if (l) l.classList.add('is-active');
      state.selections = {};
      $$('.ftdc__card').forEach(reset);
      updateBar(); updateProgress(); updateCreatineIncluded();
    });
  });
  updateCreatineIncluded();

  function reset(c) {
    c.classList.remove('is-selected');
    var a = $('.ftdc__add', c), q = $('.ftdc__qty', c), i = $('.ftdc__qty-input', c);
    if (a) a.hidden = false; if (q) q.hidden = true; if (i) i.value = 0;
  }
  function setQty(c, n) {
    n = Math.max(0, Math.floor(n));
    if (state.plan === 'quarterly') {
      var others = totalQty() - (state.selections[c.dataset.variantId] ? state.selections[c.dataset.variantId].qty : 0);
      n = Math.min(n, Math.max(0, BUNDLE_COUNT - others));
    }
    var v = c.dataset.variantId, a = $('.ftdc__add', c), q = $('.ftdc__qty', c), i = $('.ftdc__qty-input', c);
    if (n === 0) {
      delete state.selections[v]; c.classList.remove('is-selected');
      if (a) a.hidden = false; if (q) q.hidden = true; if (i) i.value = 0;
    } else {
      state.selections[v] = { qty: n, variantId: v, fnId: c.dataset.fnId, fnLabel: c.dataset.fnLabel, flavorName: c.dataset.flavorName, planMonthly: c.dataset.planMonthly || '', planQuarterly: c.dataset.planQuarterly || '', price: parseInt(c.dataset.variantPrice, 10) || 0, compareAt: parseInt(c.dataset.variantCompare, 10) || 0 };
      c.classList.add('is-selected');
      if (a) a.hidden = true; if (q) q.hidden = false; if (i) i.value = n;
    }
    updateProgress(); updateBar();
  }

  $$('.ftdc__card[data-slot="function"]').forEach(function (c) {
    c.addEventListener('click', function (e) {
      var b = e.target.closest('[data-card-action]'); if (!b) return;
      var i = $('.ftdc__qty-input', c), cur = parseInt(i ? i.value : 0, 10) || 0;
      if (b.dataset.cardAction === 'add') setQty(c, 1);
      else if (b.dataset.cardAction === 'inc') setQty(c, cur + 1);
      else if (b.dataset.cardAction === 'dec') setQty(c, cur - 1);
    });
    var i = $('.ftdc__qty-input', c);
    if (i) i.addEventListener('change', function () { setQty(c, parseInt(i.value, 10) || 0); });
  });

  function totalQty() { var n = 0; Object.keys(state.selections).forEach(function (k) { n += state.selections[k].qty; }); return n; }
  function bundleSize() { return state.plan === 'quarterly' ? BUNDLE_COUNT : 0; }
  function updateProgress() {
    var n = totalQty(), s = bundleSize(), pt = $('[data-progress-text]'), pf = $('[data-progress-fill]');
    if (!pt || !pf) return;
    if (s) { pt.textContent = n + ' of ' + s + ' selected'; pf.style.width = Math.min(100, n / s * 100) + '%'; }
    else   { pt.textContent = n ? (n + ' selected') : 'Choose your pouches'; pf.style.width = n > 0 ? '100%' : '0%'; }
  }
  function compute() {
    var mu = ({{ block.settings.monthly_estimate_pct | default: 90 }} / 100);
    var qu = ({{ block.settings.quarterly_estimate_pct | default: 90 }} / 100);
    var mul = state.plan === 'monthly' ? mu : state.plan === 'quarterly' ? qu : 1;
    var t = 0, sa = 0;
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k]; var u = s.price * mul; t += u * s.qty;
      var c = s.compareAt > s.price ? s.compareAt : s.price;
      sa += Math.max(0, c - u) * s.qty;
    });
    return { total: Math.round(t), saved: Math.round(sa) };
  }
  function updateBar() {
    var t = compute(), bt = $('[data-bar-total]'), sw = $('[data-bar-saved-wrap]'), sv = $('[data-bar-saved]');
    if (bt) bt.textContent = fmtMoney(t.total);
    if (sw && sv) { if (t.saved > 0) { sw.hidden = false; sv.textContent = fmtMoney(t.saved); } else sw.hidden = true; }
    var lab = $('[data-bar-label]'), btn = $('.ftdc__bar-action'), r = canProc();
    if (state.step === 'plans') { if (lab) lab.textContent = 'Continue'; if (btn) btn.disabled = false; }
    else if (state.step === 'products') { if (lab) lab.textContent = 'Continue'; if (btn) btn.disabled = !r; }
    else { if (lab) lab.textContent = 'Checkout'; if (btn) btn.disabled = !r; }
  }
  function canProc() {
    if (state.step === 'plans') return !!state.plan;
    if (state.step === 'products') { var n = totalQty(), s = bundleSize(); return s ? n === s : n > 0; }
    return true;
  }

  $$('[data-step-back]').forEach(function (b) { b.addEventListener('click', function () { showStep(b.dataset.stepBack); }); });
  var actBtn = $('.ftdc__bar-action');
  if (actBtn) actBtn.addEventListener('click', function () {
    if (state.step === 'plans') showStep('products');
    else if (state.step === 'products') { if (canProc()) showStep('upsells'); }
    else doCheckout();
  });
  var coBtn = $('[data-action="checkout"]');
  if (coBtn) coBtn.addEventListener('click', doCheckout);

  function buildItems() {
    var items = [];
    Object.keys(state.selections).forEach(function (k) {
      var s = state.selections[k]; var it = { id: parseInt(s.variantId, 10), quantity: s.qty };
      if (state.plan === 'monthly') { var p = parseInt(s.planMonthly, 10); if (p) it.selling_plan = p; }
      else if (state.plan === 'quarterly') {
        var p = parseInt(s.planQuarterly, 10); if (p) it.selling_plan = p;
        /* Marked for Loop bundle grouping; stripped before /cart/add.js. */
        it._bundleable = true;
      }
      items.push(it);
    });
    var cr = $('[data-creatine-input]');
    if (cr && cr.checked) {
      var cv = parseInt(cr.dataset.variant, 10);
      if (cv) {
        var ci = { id: cv, quantity: 1 };
        if (state.plan === 'monthly') { var p = parseInt(cr.dataset.planMonthly, 10); if (p) ci.selling_plan = p; }
        else if (state.plan === 'quarterly') { var p = parseInt(cr.dataset.planQuarterlyFree, 10); if (p) ci.selling_plan = p; }
        else { ci.properties = { _upsell: 'creatine-onetime' }; }
        items.push(ci);
      }
    }
    return items;
  }

  /* Loop's bundle.loopwork.co returns { message, data: { loopBundleGuid } } */
  function extractBundleTxnId(b) {
    var pools = [b, b && b.data, b && b.transaction, b && b.data && b.data.transaction];
    for (var i = 0; i < pools.length; i++) {
      var p = pools[i]; if (!p || typeof p !== 'object') continue;
      var v = (p.data && (p.data.loopBundleGuid || p.data.txnId || p.data.id))
            || p.loopBundleGuid || p.txnId || p.transactionId || p.id;
      if (v) return v;
    }
    return null;
  }
  function loopBundleItems(items) {
    var picks = items.filter(function (it) { return it._bundleable; });
    var rest  = items.filter(function (it) { return !it._bundleable; });
    if (!picks.length) return Promise.resolve(items);
    var body = {
      bundleId:         parseInt(LOOP_BUNDLE.bundleId, 10),
      bundleVariantId:  parseInt(LOOP_BUNDLE.bundleVariantId, 10)  || null,
      bundleDiscountId: parseInt(LOOP_BUNDLE.bundleDiscountId, 10) || null,
      sellingPlanId:    parseInt(LOOP_BUNDLE.apiSellingPlanId, 10)
    };
    return fetch('https://bundle.loopwork.co/api/transactions/create', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) {
        if (!r.ok) throw new Error('Loop bundle API ' + r.status + ': ' + ((b && (b.message || b.error)) || ''));
        return b;
      }); })
      .then(function (b) {
        var txn = extractBundleTxnId(b);
        if (!txn) throw new Error('Loop response missing transaction id');
        var cartPlanId = parseInt(LOOP_BUNDLE.cartSellingPlanId, 10);
        var key = LOOP_BUNDLE.propKey || '_bundleId';
        picks.forEach(function (it) {
          it.properties = it.properties || {};
          it.properties[key] = String(txn);
          if (LOOP_BUNDLE.bundleName) it.properties.bundleName = LOOP_BUNDLE.bundleName;
          if (cartPlanId) it.selling_plan = cartPlanId;
        });
        return picks.concat(rest);
      });
  }

  function doCheckout() {
    if (!canProc()) return;
    var items = buildItems(); if (!items.length) return;
    if (actBtn) actBtn.disabled = true; if (coBtn) coBtn.disabled = true;
    var cr = $('[data-creatine-input]');
    var ot = state.plan === 'onetime' && cr && cr.checked;
    var d = ot ? (cr.dataset.discountOnetime || '') : '';

    function postCart(finalItems) {
      finalItems.forEach(function (it) { delete it._bundleable; });
      return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: finalItems }) })
        .then(function (r) { if (!r.ok) return r.json().then(function (b) { throw new Error((b && b.message) || 'Cart error'); }); return r.json(); })
        .then(function () { window.location.href = d ? ('/discount/' + encodeURIComponent(d) + '?redirect=/checkout') : '/checkout'; });
    }

    var run;
    if (LOOP_BUNDLE_ON && state.plan === 'quarterly') {
      run = loopBundleItems(items).then(postCart, function (err) {
        /* Loop unreachable or misconfigured: fall back to individual lines. */
        try { console.warn('[FTDC] Loop bundle failed, falling back. Error:', err); } catch (_) {}
        return postCart(items);
      });
    } else {
      run = postCart(items);
    }
    run.catch(function (e) { if (actBtn) actBtn.disabled = false; if (coBtn) coBtn.disabled = false; alert(e.message || 'Something went wrong'); });
  }

  showStep('plans'); updateProgress(); updateBar();

  /* Slide-over open/close. Portal to <body> so no ancestor's
     transform/filter/will-change traps the dialog inside its
     stacking context. */
  var dialog = document.getElementById('ftdc-slideover-' + SID);
  if (!dialog) return;
  if (dialog.parentNode !== document.body) document.body.appendChild(dialog);
  var triggers = document.querySelectorAll('[data-ftdc-slideover-open="' + SID + '"]');
  var closers  = document.querySelectorAll('[data-ftdc-slideover-close="' + SID + '"]');
  var lastFocus = null;
  function openDlg() {
    lastFocus = document.activeElement;
    dialog.classList.add('is-open');
    dialog.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    var close = dialog.querySelector('.ftdc-slideover__close');
    if (close) setTimeout(function () { close.focus(); }, 80);
  }
  function closeDlg() {
    dialog.classList.remove('is-open');
    dialog.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }
  Array.prototype.forEach.call(triggers, function (t) { t.addEventListener('click', openDlg); });
  Array.prototype.forEach.call(closers,  function (c) { c.addEventListener('click', closeDlg); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && dialog.classList.contains('is-open')) closeDlg();
  });
})();
</script>

{% schema %}
{
  "name": "FTD - ProductSelector-CS",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Slide-over trigger" },
    { "type": "text", "id": "button_label", "label": "Trigger button label", "default": "Build Your Bundle" },
    { "type": "select", "id": "button_style", "label": "Trigger button style", "default": "filled", "options": [ { "value": "filled", "label": "Filled" }, { "value": "outline", "label": "Outline" } ] },
    { "type": "range", "id": "slideover_width", "label": "Slide-over width (desktop)", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "text", "id": "close_label", "label": "Close button aria-label", "default": "Close" },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Clean Hydration Ritual" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Mix any function, with any organic flavor.</p>" },
    { "type": "text", "id": "step_label_1", "label": "Step 1", "default": "Plan" },
    { "type": "text", "id": "step_label_2", "label": "Step 2", "default": "Bundle" },
    { "type": "text", "id": "step_label_3", "label": "Step 3", "default": "Boost" },
    { "type": "text", "id": "back_label", "label": "Back label", "default": "Back" },
