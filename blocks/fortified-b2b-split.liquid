{% render 'fortified-base' %}

<div
  class="fortified-b2b color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-b2b__inner">
    {% for i in (1..2) %}
      {%- assign img_key = 'card_' | append: i | append: '_image' -%}
      {%- assign eyebrow_key = 'card_' | append: i | append: '_eyebrow' -%}
      {%- assign heading_key = 'card_' | append: i | append: '_heading' -%}
      {%- assign body_key = 'card_' | append: i | append: '_body' -%}
      {%- assign cta_label_key = 'card_' | append: i | append: '_cta_label' -%}
      {%- assign cta_url_key = 'card_' | append: i | append: '_cta_url' -%}
      {%- assign img = block.settings[img_key] -%}
      {%- assign eyebrow = block.settings[eyebrow_key] -%}
      {%- assign heading = block.settings[heading_key] -%}
      {%- assign body = block.settings[body_key] -%}
      {%- assign cta_label = block.settings[cta_label_key] -%}
      {%- assign cta_url = block.settings[cta_url_key] | default: '#' -%}
      {% if img != blank or heading != blank or body != blank or cta_label != blank %}
        <article class="fortified-b2b__card">
          {% if img != blank %}
            {{ img | image_url: width: 1200 | image_tag:
                widths: '600, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'fortified-b2b__bg',
                alt: img.alt | default: heading,
                loading: 'lazy' }}
          {% endif %}
          <div class="fortified-b2b__content">
            {% if eyebrow != blank %}
              <span class="fortified-eyebrow">{{ eyebrow }}</span>
            {% endif %}
            {% if heading != blank %}
              <h3 class="fortified-heading fortified-h3">{{ heading }}</h3>
            {% endif %}
            {% if body != blank %}
              <p class="fortified-b2b__body">{{ body }}</p>
            {% endif %}
            {% if cta_label != blank %}
              <a href="{{ cta_url }}" class="fortified-btn fortified-btn--primary">{{ cta_label }}</a>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .fortified-b2b {
    background: var(--color-background, #fff);
    padding-block: var(--fortified-section-py);
  }
  .fortified-b2b__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 2vw, 24px);
  }
  @media (min-width: 750px) {
    .fortified-b2b__inner { grid-template-columns: repeat(2, 1fr); }
  }
  .fortified-b2b__card {
    position: relative;
    min-height: 420px;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: #fff;
    isolation: isolate;
  }
  .fortified-b2b__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .fortified-b2b__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / .5);
    z-index: -1;
  }
  .fortified-b2b__content {
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
  }
  .fortified-b2b__content .fortified-eyebrow { color: var(--fortified-teal); }
  .fortified-b2b__body {
    margin: 0 0 8px;
    font-family: var(--font-fortified-body);
    font-size: 15px;
    line-height: 1.55;
    max-width: 380px;
    opacity: .9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified B2B Split",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Card 1" },
    { "type": "image_picker", "id": "card_1_image", "label": "Background image" },
    { "type": "text", "id": "card_1_eyebrow", "label": "Eyebrow", "default": "WHOLESALE" },
    { "type": "text", "id": "card_1_heading", "label": "Heading", "default": "BECOME A WHOLESALER" },
    { "type": "textarea", "id": "card_1_body", "label": "Body" },
    { "type": "text", "id": "card_1_cta_label", "label": "CTA label", "default": "JOIN NOW" },
    { "type": "url", "id": "card_1_cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Card 2" },
    { "type": "image_picker", "id": "card_2_image", "label": "Background image" },
    { "type": "text", "id": "card_2_eyebrow", "label": "Eyebrow", "default": "PARTNERS" },
    { "type": "text", "id": "card_2_heading", "label": "Heading", "default": "BECOME A PARTNER" },
    { "type": "textarea", "id": "card_2_body", "label": "Body" },
    { "type": "text", "id": "card_2_cta_label", "label": "CTA label", "default": "APPLY NOW" },
    { "type": "url", "id": "card_2_cta_url", "label": "CTA URL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified B2B Split", "category": "Fortified" }
  ]
}
{% endschema %}
