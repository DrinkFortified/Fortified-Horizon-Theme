{% render 'fortified-base' %}

<div
  class="fortified-faq color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-faq__inner">
    <aside class="fortified-faq__side">
      {% if block.settings.eyebrow != blank %}
        <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.cta_label != blank %}
        <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--ghost">{{ block.settings.cta_label }}</a>
      {% endif %}
    </aside>

    <div class="fortified-faq__list">
      {% for i in (1..6) %}
        {%- assign q_key = 'question_' | append: i -%}
        {%- assign a_key = 'answer_' | append: i -%}
        {%- assign q = block.settings[q_key] -%}
        {%- assign a = block.settings[a_key] -%}
        {% if q != blank %}
          <details class="fortified-faq__item">
            <summary class="fortified-faq__q">
              <span>{{ q }}</span>
              <span class="fortified-faq__icon" aria-hidden="true">+</span>
            </summary>
            <div class="fortified-faq__a">{{ a }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fortified-faq {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-faq__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 64px);
  }
  @media (min-width: 1024px) {
    .fortified-faq__inner { grid-template-columns: 1fr 1.4fr; }
  }
  .fortified-faq__side { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .fortified-faq__list { display: flex; flex-direction: column; gap: 8px; }
  .fortified-faq__item {
    border-bottom: 1px solid var(--fortified-gray-light);
    padding: 4px 0;
  }
  .fortified-faq__q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    font-family: var(--font-fortified-body);
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 600;
    min-height: 44px;
  }
  .fortified-faq__q::-webkit-details-marker { display: none; }
  .fortified-faq__icon {
    font-size: 22px;
    line-height: 1;
    color: var(--fortified-teal);
    transition: transform .2s ease;
  }
  .fortified-faq__item[open] .fortified-faq__icon { transform: rotate(45deg); }
  .fortified-faq__a {
    padding: 0 4px 18px;
    font-family: var(--font-fortified-body);
    font-size: 15px;
    line-height: 1.6;
    opacity: .85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified FAQ",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FREQUENTLY ASKED QUESTIONS" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Question 1" },
    { "type": "text", "id": "question_1", "label": "Question", "default": "What is Fortified?" },
    { "type": "richtext", "id": "answer_1", "label": "Answer", "default": "<p>Premium electrolytes formulated for performance.</p>" },
    { "type": "header", "content": "Question 2" },
    { "type": "text", "id": "question_2", "label": "Question", "default": "Why is it important?" },
    { "type": "richtext", "id": "answer_2", "label": "Answer" },
    { "type": "header", "content": "Question 3" },
    { "type": "text", "id": "question_3", "label": "Question", "default": "Who should take it?" },
    { "type": "richtext", "id": "answer_3", "label": "Answer" },
    { "type": "header", "content": "Question 4" },
    { "type": "text", "id": "question_4", "label": "Question", "default": "What is the recommended dosage?" },
    { "type": "richtext", "id": "answer_4", "label": "Answer" },
    { "type": "header", "content": "Question 5" },
    { "type": "text", "id": "question_5", "label": "Question" },
    { "type": "richtext", "id": "answer_5", "label": "Answer" },
    { "type": "header", "content": "Question 6" },
    { "type": "text", "id": "question_6", "label": "Question" },
    { "type": "richtext", "id": "answer_6", "label": "Answer" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified FAQ", "category": "Fortified" }
  ]
}
{% endschema %}
