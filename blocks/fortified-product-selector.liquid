#fe-{{ sid }} .fe-ov-label { margin: 0 0 0.6rem; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(var(--color-foreground-rgb) / 0.6); }
#fe-{{ sid }} .fe-ov-lines { list-style: none; margin: 0 0 0.6rem; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
#fe-{{ sid }} .fe-ov-line { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.82rem; color: var(--color-foreground); }
#fe-{{ sid }} .fe-ov-line-name { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
#fe-{{ sid }} .fe-ov-thumb { width: 30px; height: 30px; border-radius: 6px; object-fit: cover; flex-shrink: 0; background: rgb(var(--color-foreground-rgb) / 0.06); display: inline-block; }
#fe-{{ sid }} .fe-ov-line-txt { min-width: 0; }
#fe-{{ sid }} .fe-ov-line-sub { display: block; font-size: 0.7rem; opacity: 0.55; }
#fe-{{ sid }} .fe-ov-line-price { flex-shrink: 0; font-weight: 700; white-space: nowrap; }
#fe-{{ sid }} .fe-ov-line-price.is-free { color: var(--fe-selection-color, var(--color-primary-button-background)); }
#fe-{{ sid }} .fe-ov-total { display: flex; align-items: baseline; justify-content: space-between; padding-top: 0.6rem; border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12); font-size: 0.85rem; font-weight: 700; color: var(--color-foreground); }
#fe-{{ sid }} .fe-ov-total-val { font-size: 1.05rem; font-weight: 800; }
#fe-{{ sid }} .fe-ov-note { margin: 0.5rem 0 0; font-size: 0.68rem; opacity: 0.5; color: var(--color-foreground); }

/* ── Quantity + ATC ── */
#fe-{{ sid }} .fe-atc-wrap { display: flex; flex-direction: column; gap: 0.6rem; }
#fe-{{ sid }} .fe-atc-row { display: flex; gap: 0.6rem; align-items: stretch; }
#fe-{{ sid }} .fe-atc-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 0.95rem 1.5rem; border-radius: var(--fe-btn-radius, 8px);
  font-size: 0.95rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;
  cursor: pointer; overflow: hidden; transition: filter 0.2s, transform 0.15s, background 0.2s, color 0.2s, border-color 0.2s;
}
#fe-{{ sid }} .fe-atc-btn--filled { background: var(--color-primary-button-background); color: var(--color-primary-button-text); border: none; }
#fe-{{ sid }} .fe-atc-btn--filled:hover:not([disabled]):not([aria-disabled="true"]) { filter: brightness(1.1); }
#fe-{{ sid }} .fe-atc-btn--outline { background: transparent; color: var(--color-primary-button-background); border: 2px solid var(--color-primary-button-background); }
#fe-{{ sid }} .fe-atc-btn--outline:hover:not([disabled]):not([aria-disabled="true"]) { background: var(--color-primary-button-background); color: var(--color-primary-button-text); }
#fe-{{ sid }} .fe-atc-btn--ghost { background: transparent; color: var(--color-foreground); border: none; }
#fe-{{ sid }} .fe-atc-btn[disabled], #fe-{{ sid }} .fe-atc-btn[aria-disabled="true"] { opacity: 0.4; cursor: not-allowed; filter: none; }
#fe-{{ sid }} .fe-atc-total { font-weight: 800; }
#fe-{{ sid }} .fe-atc-loading { width: 16px; height: 16px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; display: none; animation: fe-spin 0.7s linear infinite; }
#fe-{{ sid }} .fe-atc-btn.is-loading .fe-atc-loading { display: block; }
#fe-{{ sid }} .fe-atc-btn.is-loading .fe-atc-label, #fe-{{ sid }} .fe-atc-btn.is-loading .fe-atc-total { opacity: 0.4; }
@keyframes fe-spin { to { transform: rotate(360deg); } }
#fe-{{ sid }} .fe-onetime { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; background: none; border: none; padding: 0.15rem; cursor: pointer; font-size: 0.82rem; color: rgb(var(--color-foreground-rgb) / 0.7); font-family: inherit; }
#fe-{{ sid }} .fe-onetime:not([data-static="true"]) .fe-onetime-price { text-decoration: underline; text-underline-offset: 2px; }
#fe-{{ sid }} .fe-onetime[data-static="true"] { cursor: default; }
#fe-{{ sid }} .fe-onetime-price { font-weight: 700; color: var(--color-foreground); }
#fe-{{ sid }} .fe-atc-message { margin: 0; font-size: 0.8rem; text-align: center; min-height: 1.1em; color: var(--color-primary-button-background); }
#fe-{{ sid }} .fe-atc-message.is-error { color: rgb(var(--color-error, 176 0 0)); }

/* ── Quantity selector (visible when one-time is selected) ── */
#fe-{{ sid }} .fe-qty-group { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
#fe-{{ sid }} .fe-qty-group[hidden] { display: none !important; }
#fe-{{ sid }} .fe-qty-label { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.65; }
#fe-{{ sid }} .fe-qty-stepper { display: inline-flex; align-items: stretch; border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.18); border-radius: 8px; overflow: hidden; }
#fe-{{ sid }} .fe-qty-btn { width: 38px; height: 38px; background: transparent; border: 0; cursor: pointer; font-size: 18px; font-weight: 700; color: inherit; }
#fe-{{ sid }} .fe-qty-btn:hover:not([disabled]) { background: rgb(var(--color-foreground-rgb) / 0.06); }
#fe-{{ sid }} .fe-qty-input { width: 44px; text-align: center; border: 0; border-left: 1.5px solid rgb(var(--color-foreground-rgb) / 0.18); border-right: 1.5px solid rgb(var(--color-foreground-rgb) / 0.18); font-weight: 700; background: transparent; color: inherit; -moz-appearance: textfield; }
#fe-{{ sid }} .fe-qty-input::-webkit-outer-spin-button, #fe-{{ sid }} .fe-qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

/* ── Free shipping progress bar ── */
#fe-{{ sid }} .fe-ship { display: flex; flex-direction: column; gap: 8px; }
#fe-{{ sid }} .fe-ship[hidden] { display: none !important; }
#fe-{{ sid }} .fe-ship-bar { height: 8px; border-radius: 999px; background: var(--fe-ship-track, #EFEAE3); overflow: hidden; }
#fe-{{ sid }} .fe-ship-fill { display: block; height: 100%; background: var(--fe-ship-fill, #1FA8A1); border-radius: 999px; transition: width 0.4s ease, background 0.3s ease; }
#fe-{{ sid }} .fe-ship.is-unlocked .fe-ship-fill { background: var(--fe-ship-unlocked, #16A34A); }
#fe-{{ sid }} .fe-ship-text { margin: 0; font-size: 13px; font-weight: 700; opacity: 0.85; }

@media (prefers-reduced-motion: reduce) {
  #fe-{{ sid }} .fe-fcard, #fe-{{ sid }} .fe-plan, #fe-{{ sid }} .fe-flavor-opt, #fe-{{ sid }} .fe-plan-tick, #fe-{{ sid }} .fe-fcard-tick { transition: none; }
}

/* ── Mobile sticky Add-to-Cart bar + collapsed wizard steps ── */
#fe-stickybar-{{ sid }} { display: none; }
@media (max-width: 899px) {
  #fe-{{ sid }} .fe-panel { padding-bottom: 84px; }
  #fe-stickybar-{{ sid }}.is-onscreen { display: flex; }
  #fe-stickybar-{{ sid }} {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    align-items: center; gap: 0.75rem;
    padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background: var(--color-background);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    box-shadow: 0 -6px 22px rgba(0, 0, 0, 0.14);
  }
  #fe-stickybar-{{ sid }} .fe-stickybar-info { display: flex; flex-direction: column; min-width: 0; flex: 1 1 auto; }
  #fe-stickybar-{{ sid }} .fe-stickybar-counter { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.65; color: var(--color-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #fe-stickybar-{{ sid }} .fe-stickybar-total { font-size: 1.05rem; font-weight: 800; color: var(--color-foreground); line-height: 1.1; }
  #fe-stickybar-{{ sid }} .fe-stickybar-total:empty::before { content: attr(data-empty); font-size: 0.85rem; font-weight: 700; opacity: 0.6; }
  #fe-stickybar-{{ sid }} .fe-stickybar-btn {
    flex: 0 0 auto; min-width: 46%;
    padding: 0.85rem 1.1rem; border: none; border-radius: var(--fe-btn-radius, 8px);
    background: var(--color-primary-button-background); color: var(--color-primary-button-text);
    font-family: inherit; font-weight: 800; font-size: 0.95rem; letter-spacing: 0.02em;
    cursor: pointer; transition: filter 0.2s, opacity 0.2s;
  }
  #fe-stickybar-{{ sid }} .fe-stickybar-btn:hover:not([disabled]) { filter: brightness(1.08); }
  #fe-stickybar-{{ sid }} .fe-stickybar-btn[disabled] { opacity: 0.4; cursor: not-allowed; }
  /* Collapse a locked step to just its header so the panel isn't a long scroll */
  #fe-{{ sid }} .fe-step--locked { opacity: 1; }
  #fe-{{ sid }} .fe-step--locked > :not(.fe-step-head) { display: none; }
  #fe-{{ sid }} .fe-step--locked .fe-step-head { opacity: 0.5; margin-bottom: 0; }
}
{{ block.settings.custom_css }}
</style>

<script>
(function () {
  'use strict';

  var SID          = {{ sid | json }};
  var BUNDLE_COUNT = {{ bundle_count | json }};
  var BUILD_LABEL  = {{ block.settings.build_step_label | json }} || 'Build {count}-Pouch Bundle';
  var POUCHES_WORD = {{ block.settings.pouches_word | default: 'Pouches' | json }};
  var SHOW_TOTAL   = {{ block.settings.show_total_on_button | json }};

  /* Creatine add-on copy adapts: monthly = add at 50% off; quarterly = 1st free, add a 2nd at 50%. */
  var CR_LABEL_M = {{ block.settings.addon_label | default: 'Add Creatine — 50% off' | json }};
  var CR_LABEL_Q = {{ block.settings.addon_label_quarterly | default: 'Add a 2nd Creatine — 50% off' | json }};
  var CR_DESC_M  = {{ block.settings.addon_desc | default: '' | json }};
  var CR_DESC_Q  = {{ block.settings.addon_desc_quarterly | default: '1st Creatine is free with your bundle. Add a second at 50% off.' | json }};
  var FOMO_GIFT_ON   = {{ fomo_gift_enabled | json }};
  var FOMO_SOLD_OUT  = {{ fomo_sold_out | json }};
  var FOMO_GIFT_TEXT = {{ block.settings.fomo_gift_text | default: 'Free creatine gift with your first order' | json }};
  var CR_PRICE   = parseFloat(({{ block.settings.addon_price_text | default: '' | json }} + '').replace(/[^0-9.]/g, '')) || 0;
  {%- if addon_img != blank -%}
  var ADDON_IMG_URL = {{ addon_img | image_url: width: 90 | json }};
  {%- else -%}
  var ADDON_IMG_URL = '';
  {%- endif -%}
  var PLAN_LABEL_M = {{ block.settings.monthly_label | default: '1 a Month' | json }};
  var PLAN_LABEL_Q = {{ block.settings.quarterly_label | default: '3 Every 3 Months' | json }};
  var PLAN_LABEL_OT = {{ block.settings.onetime_card_label | default: 'One Time' | json }};
  var ONETIME_HANDLE = {{ onetime_handle | json }};
  var FUNCTION_BLOCKS_COUNT = {{ function_blocks.size | json }};
  var SIMPLE_SUBS = {{ block.settings.simplified_for_subs | json }} && !!ONETIME_HANDLE;
  var SIMPLE_SUBS_Q = !!ONETIME_HANDLE && FUNCTION_BLOCKS_COUNT === 0;
  var SIMPLE_SUBS_PLAN_M = {{ block.settings.simple_plan_monthly | json }};
  var SIMPLE_SUBS_PLAN_Q = {{ block.settings.simple_plan_quarterly | json }};

  /* Loop bundle mode (quarterly only). When fully configured, the 3 pouches
     are registered with Loop's Create Bundle Transaction API and the cart
     gets ONE bundle line instead of 3 subscription lines, so the customer
     can edit the whole bundle in Loop's portal later. */
  var LOOP_BUNDLE = {
    enabled:           {{ block.settings.loop_bundle_enabled | json }},
    bundleId:          {{ block.settings.loop_bundle_id | default: '' | json }},
    bundleVariantId:   {{ block.settings.loop_bundle_variant_id | default: '' | json }},
    bundleDiscountId:  {{ block.settings.loop_bundle_discount_id | default: '' | json }},
    apiSellingPlanId:  {{ block.settings.loop_bundle_api_selling_plan_id | default: '' | json }},
    cartSellingPlanId: {{ block.settings.loop_bundle_selling_plan_id | default: '' | json }},
    bundleName:        {{ block.settings.loop_bundle_name | default: '' | json }},
    propKey:           {{ block.settings.loop_bundle_property_key | default: '_bundleId' | json }}
  };
  var LOOP_BUNDLE_ON = !!(LOOP_BUNDLE.enabled && LOOP_BUNDLE.bundleId && LOOP_BUNDLE.apiSellingPlanId);
  try {
    if (!LOOP_BUNDLE_ON && LOOP_BUNDLE.enabled) {
      console.warn('[FORTIFIED] Loop bundle mode ENABLED but settings incomplete. Need: bundleId + apiSellingPlanId. Current:', LOOP_BUNDLE);
    } else if (LOOP_BUNDLE_ON) {
      console.log('[FORTIFIED] Loop bundle mode ready. bundleId=' + LOOP_BUNDLE.bundleId + ' apiSellingPlanId=' + LOOP_BUNDLE.apiSellingPlanId);
    }
  } catch (_) {}

  /* Free shipping bar */
  var SHOW_SHIPPING    = {{ block.settings.show_shipping_bar | json }};
  var SHIP_THRESHOLD   = ({{ block.settings.shipping_threshold_dollars | default: 100 | json }}) * 100;
  var SHIP_TEXT_SUB      = {{ block.settings.shipping_text_subscription | default: 'Subscriptions ship free' | json }};
  var SHIP_TEXT_PROGRESS = {{ block.settings.shipping_text_progress | json }} || 'Add {amount} more for FREE shipping';
  var SHIP_TEXT_UNLOCKED = {{ block.settings.shipping_text_unlocked | default: 'FREE shipping unlocked' | json }};

  var root = document.getElementById('fe-' + SID);
  if (!root) return;

  var atcBtn   = root.querySelector('#fe-atc-' + SID);
  var atcTotal = root.querySelector('#fe-atc-total-' + SID);
  var atcMsg   = root.querySelector('#fe-atc-msg-' + SID);
  var buildGroup = root.querySelector('#fe-build-group-' + SID);
  var buildLabelEl = root.querySelector('#fe-build-label-' + SID);
  var counterEl = root.querySelector('#fe-counter-' + SID);
  var qtyInput = root.querySelector('#fe-qty-' + SID);
  var addonInput = root.querySelector('#fe-addon-' + SID);
  var creatineGroup = root.querySelector('#fe-creatine-' + SID);
  var crFree = root.querySelector('#fe-cr-free-' + SID);
  var crTitle = root.querySelector('#fe-cr-title-' + SID);
  var crDesc = root.querySelector('#fe-cr-desc-' + SID);
  var overview = root.querySelector('#fe-overview-' + SID);
  var ovLines = root.querySelector('#fe-ov-lines-' + SID);
  var ovTotal = root.querySelector('#fe-ov-total-' + SID);
  var oneTimeBtn = root.querySelector('#fe-onetime-' + SID);
  var monthlyView = root.querySelector('.fe-build-view--monthly');
  var quarterlyView = root.querySelector('.fe-build-view--quarterly');
  var qtyGroup = root.querySelector('#fe-qty-group-' + SID);
  var shipEl   = root.querySelector('#fe-ship-' + SID);
  var shipFill = root.querySelector('#fe-ship-fill-' + SID);
  var shipText = root.querySelector('#fe-ship-text-' + SID);

  /* Replace the {count} placeholder on load so it never shows literally
     before a plan is picked. Updated again per-plan in applyPurchaseType. */
  if (buildLabelEl) buildLabelEl.textContent = BUILD_LABEL.replace('{count}', BUNDLE_COUNT);

  var state = { purchaseType: null };
  var slots = {};
  function newSlot() { return { functionId: null, handle: null, label: null, planMonthly: null, planQuarterly: null, flavorName: null, product: null, variant: null, configId: null }; }
  slots.monthly = newSlot();
  for (var n = 1; n <= BUNDLE_COUNT; n++) { slots['q' + n] = newSlot(); }
  slots.onetime = newSlot();
  if (ONETIME_HANDLE) {
    slots.onetime.handle = ONETIME_HANDLE;
    slots.onetime.configId = 'onetime';
    slots.onetime.functionId = 'onetime';
    slots.onetime.label = {{ onetime_product.title | default: '' | json }};
    {%- if onetime_product != blank and onetime_product.variants.first != blank -%}
    slots.onetime.flavorName = {{ onetime_product.variants.first.title | json }};
    {%- endif -%}
  }
  function seedSimpleSlot(id) {
      slots[id].handle = ONETIME_HANDLE;
      slots[id].functionId = 'simple-' + id;
      slots[id].label = {{ onetime_product.title | default: '' | json }};
      slots[id].configId = id;
      slots[id].planMonthly = SIMPLE_SUBS_PLAN_M;
      slots[id].planQuarterly = SIMPLE_SUBS_PLAN_Q;
      {%- if onetime_product != blank and onetime_product.variants.first != blank -%}
      slots[id].flavorName = {{ onetime_product.variants.first.title | json }};
      {%- endif -%}
    }
  if (SIMPLE_SUBS) seedSimpleSlot('monthly');
  if (SIMPLE_SUBS_Q) { for (var qi = 1; qi <= BUNDLE_COUNT; qi++) seedSimpleSlot('q' + qi); }

  function formatMoney(c) { return (c / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }); }
  function setMsg(m, err) { if (atcMsg) { atcMsg.textContent = m || ''; atcMsg.classList.toggle('is-error', !!err); } }
  function pushEvent(e, d) { window.dataLayer = window.dataLayer || []; window.dataLayer.push(Object.assign({ event: e, block_id: SID }, d)); }
  function setAtcEnabled(on) { if (!atcBtn) return; if (on) { atcBtn.removeAttribute('disabled'); atcBtn.removeAttribute('aria-disabled'); } else { atcBtn.setAttribute('disabled', ''); atcBtn.setAttribute('aria-disabled', 'true'); } }
  function getQty() { var q = qtyInput ? parseInt(qtyInput.value, 10) : 1; return (isNaN(q) || q < 1) ? 1 : q; }

  var productCache = {};
  function fetchProduct(handle) {
    if (!handle) return Promise.resolve(null);
    if (productCache[handle]) return Promise.resolve(productCache[handle]);
    return fetch('/products/' + handle + '.js').then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) { if (d) productCache[handle] = d; return d; }).catch(function () { return null; });
  }
  function findVariant(p, flavor) {
    if (!p || !p.variants.length) return null;
    var fl = (flavor || '').toLowerCase().trim();
    if (!fl) return p.variants.find(function (v) { return v.available; }) || p.variants[0];
    var m = p.variants.find(function (v) { return v.options.some(function (o) { return o.toLowerCase() === fl; }) && v.available; });
    if (!m) m = p.variants.find(function (v) { return v.options.some(function (o) { return o.toLowerCase() === fl; }); });
    if (!m) m = p.variants.find(function (v) { return v.title.toLowerCase().indexOf(fl) !== -1 && v.available; });
    if (!m) m = p.variants.find(function (v) { return v.available; });
    return m || p.variants[0];
  }
  function findSellingPlanId(p, raw) {
    if (!p || !raw) return null;
    var id = parseInt(raw, 10), g = p.selling_plan_groups || [];
    for (var i = 0; i < g.length; i++) { var pl = g[i].selling_plans || []; for (var j = 0; j < pl.length; j++) { if (pl[j].id === id) return pl[j].id; } }
    return null;
  }
  function subPrice(p, v, raw) {
    if (!p || !v) return null;
    if (!raw) return v.price;
    var id = parseInt(raw, 10), g = p.selling_plan_groups || [];
    for (var i = 0; i < g.length; i++) { var pl = g[i].selling_plans || []; for (var j = 0; j < pl.length; j++) {
      if (pl[j].id !== id) continue;
      var a = pl[j].price_adjustments && pl[j].price_adjustments[0];
      if (!a) return v.price;
      if (a.value_type === 'percentage') return Math.round(v.price * (1 - a.value / 100));
      if (a.value_type === 'fixed_amount') return Math.max(0, v.price - a.value);
      if (a.value_type === 'price') return a.value;
      return v.price;
    } }
    return v.price;
  }

  function activeSlotIds() {
    if (state.purchaseType === 'monthly') return ['monthly'];
    if (state.purchaseType === 'onetime') {
      if (slots.onetime && slots.onetime.handle) return ['onetime'];
      return ['monthly'];
    }
    if (state.purchaseType === 'quarterly') { var a = []; for (var i = 1; i <= BUNDLE_COUNT; i++) a.push('q' + i); return a; }
    return [];
  }
  function slotPlanRaw(s) {
    if (state.purchaseType === 'onetime') return null;
    return state.purchaseType === 'monthly' ? s.planMonthly : s.planQuarterly;
  }

  /* Update the plan-card price displays from the best available slot */
  function updatePlanPrices() {
    var mEl = root.querySelector('[data-plan-price="monthly"]'), mWas = root.querySelector('[data-plan-was="monthly"]');
    var qEl = root.querySelector('[data-plan-price="quarterly"]'), qWas = root.querySelector('[data-plan-was="quarterly"]');
    var oEl = root.querySelector('[data-plan-price="onetime"]');
    var ms = slots.monthly;
    if (mEl && ms.product && ms.variant) {
      var mp = subPrice(ms.product, ms.variant, ms.planMonthly);
      if (mp != null) { mEl.textContent = formatMoney(mp); if (mWas && ms.variant.price > mp) mWas.textContent = 'was ' + formatMoney(ms.variant.price); }
    }
    if (qEl) {
      var qs = null; for (var i = 1; i <= BUNDLE_COUNT; i++) { if (slots['q' + i].product && slots['q' + i].variant) { qs = slots['q' + i]; break; } }
      if (qs) { var qp = subPrice(qs.product, qs.variant, qs.planQuarterly); if (qp != null) { qEl.textContent = formatMoney(qp); if (qWas && qs.variant.price > qp) qWas.textContent = 'was ' + formatMoney(qs.variant.price); } }
    }
    /* One-time: variant.price (no selling plan discount). Falls back to monthly slot, which is
       what one-time also uses for its build view. */
    if (oEl && ms.product && ms.variant) {
      oEl.textContent = formatMoney(ms.variant.price);
    }
  }

  function esc(t) { var d = document.createElement('div'); d.textContent = (t == null ? '' : t); return d.innerHTML; }

  function slotThumb(s) {
    if (s.variant && s.variant.featured_image && s.variant.featured_image.src) return s.variant.featured_image.src;
    if (s.product && s.product.featured_image) return s.product.featured_image;
    return '';
  }

  function recompute() {
    var ids = activeSlotIds();
    var completed = 0, pouchSubtotal = 0, ready = ids.length > 0;
    var lines = [];
    ids.forEach(function (id) {
      var s = slots[id];
      if (s.functionId && s.flavorName && s.product && s.variant) {
        completed++;
        var pr = subPrice(s.product, s.variant, slotPlanRaw(s));
        if (pr == null) pr = s.variant.price;
        pouchSubtotal += pr;
        lines.push({ name: s.label, sub: s.flavorName, price: pr, thumb: slotThumb(s) });
      } else { ready = false; }
    });

    var qty = getQty();
    var addonOn = !!(addonInput && addonInput.checked);
    var creatineCents = 0;
    /* Subscription plans get the 50%-off display price.
       One-time adds the creatine at full price (no plan, no discount). */
    if (addonOn && (state.purchaseType === 'monthly' || state.purchaseType === 'quarterly')) {
      creatineCents = Math.round(CR_PRICE * 100);
    } else if (addonOn && state.purchaseType === 'onetime') {
      /* Use the addon variant price if known, else fall back to CR_PRICE * 2 (assume CR_PRICE is the 50%-off price). */
      creatineCents = Math.round(CR_PRICE * 2 * 100);
    }
    var total = (pouchSubtotal + creatineCents) * qty;

    if (counterEl && state.purchaseType) counterEl.textContent = completed + ' / ' + ids.length + ' ' + POUCHES_WORD;
    if (atcTotal) atcTotal.textContent = (SHOW_TOTAL && ready && total > 0) ? ('· ' + formatMoney(total)) : '';

    /* ── Order overview ── */
    if (ovLines) {
      var html = '';
      if (state.purchaseType) {
        var planLabel;
        if (state.purchaseType === 'quarterly') planLabel = PLAN_LABEL_Q;
        else if (state.purchaseType === 'onetime') planLabel = PLAN_LABEL_OT;
        else planLabel = PLAN_LABEL_M;
        html += '<li class="fe-ov-line"><span class="fe-ov-line-name">' + esc(planLabel) + '</span></li>';
      }
      lines.forEach(function (l, i) {
        var thumb = l.thumb ? '<img class="fe-ov-thumb" src="' + l.thumb + '" alt="">' : '<span class="fe-ov-thumb"></span>';
        html += '<li class="fe-ov-line"><span class="fe-ov-line-name">' + thumb + '<span class="fe-ov-line-txt">' + esc(l.name || ('Pouch ' + (i + 1))) + (l.sub ? '<span class="fe-ov-line-sub">' + esc(l.sub) + '</span>' : '') + '</span></span><span class="fe-ov-line-price">' + formatMoney(l.price * qty) + '</span></li>';
      });
      /* "1st included free" creatine row — quarterly bundles only. */
      if (state.purchaseType === 'quarterly') {
        var crThumbFree = ADDON_IMG_URL ? '<img class="fe-ov-thumb" src="' + ADDON_IMG_URL + '" alt="">' : '<span class="fe-ov-thumb"></span>';
        html += '<li class="fe-ov-line"><span class="fe-ov-line-name">' + crThumbFree + '<span class="fe-ov-line-txt">Creatine<span class="fe-ov-line-sub">1st included free</span></span></span><span class="fe-ov-line-price is-free">FREE</span></li>';
      }
      /* Paid creatine row — labelled per plan. Skip the "2nd / 50% off" row for one-time. */
      if (creatineCents > 0) {
        var crLabel;
        if (state.purchaseType === 'quarterly') crLabel = '2nd Creatine (50% off)';
        else if (state.purchaseType === 'onetime') crLabel = 'Creatine';
        else crLabel = 'Creatine (50% off)';
        var crThumbPaid = ADDON_IMG_URL ? '<img class="fe-ov-thumb" src="' + ADDON_IMG_URL + '" alt="">' : '<span class="fe-ov-thumb"></span>';
        html += '<li class="fe-ov-line"><span class="fe-ov-line-name">' + crThumbPaid + '<span class="fe-ov-line-txt">' + crLabel + '</span></span><span class="fe-ov-line-price">' + formatMoney(creatineCents * qty) + '</span></li>';
      }
      ovLines.innerHTML = html;
    }
    if (ovTotal) ovTotal.textContent = (ready || lines.length) ? formatMoney(total) : '--';

    updatePlanPrices();
    updateShipping(total);
    setAtcEnabled(ready);
    return ready;
  }

  function updateShipping(t) {
    if (!SHOW_SHIPPING || !shipEl) return;
    shipEl.hidden = false;
    if (state.purchaseType === 'monthly' || state.purchaseType === 'quarterly') {
      if (shipFill) shipFill.style.width = '100%';
      shipEl.classList.add('is-unlocked');
      if (shipText) shipText.textContent = SHIP_TEXT_SUB;
    } else if (state.purchaseType === 'onetime') {
      if (t >= SHIP_THRESHOLD) {
        if (shipFill) shipFill.style.width = '100%';
        shipEl.classList.add('is-unlocked');
        if (shipText) shipText.textContent = SHIP_TEXT_UNLOCKED;
      } else {
        var pct = SHIP_THRESHOLD > 0 ? (t / SHIP_THRESHOLD * 100) : 0;
        if (shipFill) shipFill.style.width = pct.toFixed(1) + '%';
        shipEl.classList.remove('is-unlocked');
        var remaining = Math.max(SHIP_THRESHOLD - t, 0);
        if (shipText) shipText.textContent = SHIP_TEXT_PROGRESS.replace('{amount}', formatMoney(remaining));
      }
    } else {
      shipEl.hidden = true;
    }
  }

  function loadSlotProduct(id) {
    var s = slots[id];
    if (!s.handle) return;
    fetchProduct(s.handle).then(function (p) {
      if (!p) { setMsg('Product not found. Check the product handle in theme settings.', true); return; }
      s.product = p;
      s.variant = findVariant(p, s.flavorName);
      recompute();
    });
  }

  function applyPurchaseType(type) {
    state.purchaseType = type;
    /* Onetime uses its own view when an explicit one-time product is configured;
       otherwise it falls back to the monthly single-pouch function-card view. */
    var onetimeDedicated = type === 'onetime' && !!ONETIME_HANDLE;
    var monthlyLike = type === 'monthly' || (type === 'onetime' && !ONETIME_HANDLE);
    if (monthlyView) monthlyView.classList.toggle('is-active', monthlyLike);
    if (quarterlyView) quarterlyView.classList.toggle('is-active', type === 'quarterly');
    var onetimeView = root.querySelector('.fe-build-view--onetime');
    if (onetimeView) onetimeView.classList.toggle('is-active', onetimeDedicated);
    /* The One-Time plan card now contains its own flavor picker, so the
       Step 2 panel adds no value when a dedicated one-time product is set. */
    if (buildGroup) {
      if (type === 'onetime' && ONETIME_HANDLE) buildGroup.style.display = 'none';
      else buildGroup.style.display = '';
    }
    if (buildGroup) { buildGroup.classList.remove('fe-step--locked'); buildGroup.removeAttribute('aria-disabled'); }
    var count = (monthlyLike || onetimeDedicated) ? 1 : BUNDLE_COUNT;
    if (buildLabelEl) buildLabelEl.textContent = BUILD_LABEL.replace('{count}', count);

    /* When the dedicated one-time view is active, pre-load the product and
       pre-pick the first variant so prices + ATC are immediately ready. */
    if (onetimeDedicated) {
      loadSlotProduct('onetime');
      var firstFlavorBtn = root.querySelector('.fe-flavor-opt[data-onetime-variant-id]');
      if (firstFlavorBtn) {
        slots.onetime.flavorName = firstFlavorBtn.dataset.flavorName;
        if (slots.onetime.product) {
          slots.onetime.variant = findVariant(slots.onetime.product, slots.onetime.flavorName);
        }
      }
    }

    /* Simplified subs: pre-pick the first flavor for each active slot so the
       ATC button is immediately usable. */
    function presimplePick(slotId, viewSelector) {
      var s = slots[slotId];
      var firstBtn = root.querySelector(viewSelector + ' [data-simple-slot-id="' + slotId + '"]');
      if (!s || !firstBtn) return;
      s.flavorName = firstBtn.dataset.flavorName;
      if (s.product) s.variant = findVariant(s.product, s.flavorName);
    }
    if (SIMPLE_SUBS && type === 'monthly') {
      presimplePick('monthly', '.fe-build-view--monthly');
    }
    if (SIMPLE_SUBS_Q && type === 'quarterly') {
      for (var pq = 1; pq <= BUNDLE_COUNT; pq++) presimplePick('q' + pq, '.fe-build-view--quarterly');
    }

    /* Creatine card: unlock + adapt copy. Quarterly shows the "1st free" line and offers a 2nd at 50%.
       On one-time the toggle still shows so customers can add a creatine — but it's a regular,
       full-price, one-time line (no selling plan, see buildItems). */
    var q = type === 'quarterly';
    if (creatineGroup) creatineGroup.hidden = false;
    if (crTitle) crTitle.textContent = q ? CR_LABEL_Q : CR_LABEL_M;
    if (crDesc)  crDesc.textContent  = q ? CR_DESC_Q : CR_DESC_M;
    /* "1st included free" line shows only on quarterly. */
    if (crFree)  crFree.hidden = type !== 'quarterly';
      if (crFree && type === 'quarterly' && FOMO_GIFT_ON && FOMO_SOLD_OUT) { crFree.innerHTML = '<span class="fe-cr-tick" aria-hidden="true">\u2713</span>' + FOMO_GIFT_TEXT; }

    /* Quantity stepper appears only for one-time. */
    if (qtyGroup) qtyGroup.hidden = type !== 'onetime';

    if (overview) overview.hidden = false;
    recompute();
  }

  /* Plan radios */
  root.querySelectorAll('input[name="fe-plan-' + SID + '"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      root.querySelectorAll('.fe-plan').forEach(function (l) { l.classList.remove('is-active'); });
      var label = radio.closest('.fe-plan'); if (label) label.classList.add('is-active');
      pushEvent('fe_plan_selected', { plan: radio.value });
      applyPurchaseType(radio.value);
    });
  });

  /* Select a function card for a config slot. Free switching: clicking
     any card activates it and clears the previously-selected card's
     visual state (CSS hides the inactive card's flavor picker, so only
     one shows as selected at a time). */
  function selectFunction(card, resetFlavor) {
    var cfg = card.closest('.fe-fcards').dataset.config;
    var s = slots[cfg]; if (!s) return;
    s.configId = cfg;
    root.querySelectorAll('.fe-fcards[data-config="' + cfg + '"] .fe-fcard').forEach(function (c) {
      c.classList.remove('is-active'); c.setAttribute('aria-pressed', 'false');
      /* Clear sibling cards' flavor selections so only the active card shows
         a picked flavor. The newly active card keeps its existing flavor
         until resetFlavor explicitly clears it below. */
      if (c !== card) {
        c.querySelectorAll('.fe-flavor-opt').forEach(function (b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
      }
    });
    card.classList.add('is-active'); card.setAttribute('aria-pressed', 'true');
    s.functionId = card.dataset.functionId;
    s.handle = card.dataset.productHandle;
    s.label = card.dataset.functionLabel;
    s.planMonthly = card.dataset.planMonthly || null;
    s.planQuarterly = card.dataset.planQuarterly || null;
    if (resetFlavor) {
      card.querySelectorAll('.fe-flavor-opt').forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
      s.flavorName = null;
    }
    loadSlotProduct(cfg);
  }

  /* Delegated clicks: flavor first, then function card */
  root.addEventListener('click', function (e) {
    var simpleFlavor = e.target.closest('.fe-flavor-opt[data-simple-slot-id]');
    if (simpleFlavor && root.contains(simpleFlavor)) {
      var slotId = simpleFlavor.dataset.simpleSlotId;
      var sSimple = slots[slotId];
      if (!sSimple) return;
      var grpS = simpleFlavor.closest('[data-simple-slot-group]');
      if (grpS) grpS.querySelectorAll('.fe-flavor-opt').forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
      simpleFlavor.classList.add('is-active'); simpleFlavor.setAttribute('aria-pressed', 'true');
      sSimple.flavorName = simpleFlavor.dataset.flavorName;
      if (sSimple.product) { sSimple.variant = findVariant(sSimple.product, sSimple.flavorName); }
      pushEvent('fe_simple_flavor_selected', { slot: slotId, flavor: sSimple.flavorName });
      recompute();
      return;
    }
    var otFlavor = e.target.closest('.fe-flavor-opt[data-onetime-variant-id]');
    if (otFlavor && root.contains(otFlavor)) {
      /* If the flavor picker lives inside the One-Time plan card, prevent the
         enclosing <label> from re-toggling the radio, and ensure the radio
         actually becomes checked if it isn't yet. */
      var inPlanCard = otFlavor.closest('.fe-plan[data-plan="onetime"]');
      if (inPlanCard) {
        e.preventDefault();
        var planRadio = inPlanCard.querySelector('input[type="radio"]');
        if (planRadio && !planRadio.checked) {
          planRadio.checked = true;
          planRadio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
      var grp = otFlavor.closest('[data-onetime-flavor-group]');
      if (grp) grp.querySelectorAll('.fe-flavor-opt').forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
      otFlavor.classList.add('is-active'); otFlavor.setAttribute('aria-pressed', 'true');
      var s = slots.onetime;
      s.flavorName = otFlavor.dataset.flavorName;
      if (s.product) { s.variant = findVariant(s.product, s.flavorName); }
      pushEvent('fe_onetime_flavor_selected', { flavor: s.flavorName });
      recompute();
      return;
    }
    var flavor = e.target.closest('.fe-flavor-opt');
    if (flavor && root.contains(flavor)) {
      var card = flavor.closest('.fe-fcard');
      if (!card) return;
      if (card.dataset.comingSoon === 'true') return;
      if (!card.classList.contains('is-active')) {
        selectFunction(card, false);
        /* If sticky logic rejected the activation, bail — don't change the
           flavor selection on a non-active card. */
        if (!card.classList.contains('is-active')) return;
      }
      card.querySelectorAll('.fe-flavor-opt').forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
      flavor.classList.add('is-active'); flavor.setAttribute('aria-pressed', 'true');
      var s = slots[card.closest('.fe-fcards').dataset.config];
      s.flavorName = flavor.dataset.flavorName;
      if (s.product) { s.variant = findVariant(s.product, s.flavorName); }
      pushEvent('fe_flavor_selected', { config: s.configId, flavor: s.flavorName });
      recompute();
      return;
    }
    var fcard = e.target.closest('.fe-fcard');
    if (fcard && root.contains(fcard)) {
      if (fcard.dataset.comingSoon === 'true') return;
      pushEvent('fe_function_selected', { function_id: fcard.dataset.functionId });
      selectFunction(fcard, true);
    }
  });

  /* Keyboard select on function card */
  root.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var fcard = e.target.closest('.fe-fcard');
    if (fcard && root.contains(fcard) && fcard === e.target) { e.preventDefault(); if (fcard.dataset.comingSoon !== 'true') selectFunction(fcard, true); }
  });

  /* Quantity */
  root.querySelectorAll('.fe-qty-btn').forEach(function (b) {
    b.addEventListener('click', function () {
      var step = parseInt(b.dataset.qtyStep, 10) || 0;
      var q = getQty() + step; if (q < 1) q = 1;
      if (qtyInput) qtyInput.value = q;
      recompute();
    });
  });
  if (qtyInput) qtyInput.addEventListener('change', recompute);
  if (addonInput) addonInput.addEventListener('change', function () { pushEvent('fe_addon_toggled', { checked: addonInput.checked }); recompute(); });

  function buildItems(oneTime) {
    var items = [], ids = activeSlotIds(), qty = getQty();
    /* Legacy one-time button under the ATC: send the first valid slot variant at qty,
       with no selling plan. */
    if (oneTime) {
      var first = ids.map(function (id) { return slots[id]; }).find(function (s) { return s && s.variant; });
      if (!first) return null;
      return [{ id: first.variant.id, quantity: qty }];
    }
    /* state-driven one-time plan: each active slot variant, no selling plan; qty multiplies each line. */
    var isOnetime = state.purchaseType === 'onetime';
    for (var k = 0; k < ids.length; k++) {
      var s = slots[ids[k]];
      if (!s.variant) return null;
      var item = { id: s.variant.id, quantity: qty };
      if (!isOnetime) {
        var plan = findSellingPlanId(s.product, slotPlanRaw(s));
        if (plan) item.selling_plan = plan;
        if (state.purchaseType === 'quarterly') {
          item._bundleable = true;
          item._label = (s.label || '') + (s.flavorName ? ' — ' + s.flavorName : '');
        }
      }
      items.push(item);
    }
    // Quarterly auto-includes the FREE 1st creatine. The merchant must configure
    // the addon-plan-quarterly-free Loop plan to apply 100% off so the line is $0.
    // Skipped entirely for monthly and one-time.
    if (state.purchaseType === 'quarterly' && addonInput) {
      var avFree = parseInt(addonInput.dataset.addonVariant, 10);
      if (avFree) {
        if (FOMO_GIFT_ON && FOMO_SOLD_OUT) {
          // Spots gone: creatine as a one-time gift. A native "buy bundle, get
          // creatine free" automatic discount zeroes this line at checkout.
          items.push({ id: avFree, quantity: qty, properties: { '_gift': 'First-order creatine gift' } });
        } else {
          var freePlanId = parseInt(addonInput.dataset.addonPlanQuarterlyFree, 10);
          if (freePlanId) items.push({ id: avFree, quantity: qty, selling_plan: freePlanId });
        }
      }
    }
    // Toggle adds the paid creatine:
    //   - monthly  -> creatine at 50% off (selling plan)
    //   - quarterly -> OPTIONAL 2nd creatine at 50% off (selling plan)
    //   - onetime  -> creatine at full price as a one-time line (NO selling plan)
    if (addonInput && addonInput.checked) {
      var av = parseInt(addonInput.dataset.addonVariant, 10);
      if (av) {
        var addonItem = { id: av, quantity: qty };
        if (!isOnetime) {
          var addonPlanRaw = state.purchaseType === 'monthly' ? addonInput.dataset.addonPlanMonthly : addonInput.dataset.addonPlanQuarterly50off;
          if (addonPlanRaw) {
            var addonPlanId = parseInt(addonPlanRaw, 10);
            if (addonPlanId) addonItem.selling_plan = addonPlanId;
          }
        }
        items.push(addonItem);
      }
    }
    return items;
  }

  /* Loop bundle mode: register the picks with Loop (Create Bundle
     Transaction), then swap the per-pouch lines for ONE bundle line that
     carries the returned transaction id as a line-item property. Loop's
     order webhook matches that id and creates a single, portal-editable
     bundle subscription. Creatine add-on lines stay separate on purpose
     (they are their own selling plans, not part of the bundle). */
  function extractBundleTxnId(b) {
    var pools = [b, b && b.data, b && b.transaction, b && b.data && b.data.transaction];
    for (var i = 0; i < pools.length; i++) {
      var p = pools[i];
      if (!p || typeof p !== 'object') continue;
      /* Loop's bundle.loopwork.co returns { message, data: { loopBundleGuid } } */
      var v = (p.data && (p.data.loopBundleGuid || p.data.txnId || p.data.id))
            || p.loopBundleGuid || p.txnId || p.transactionId || p.id;
      if (v) return v;
    }
    return null;
  }

  function loopBundleItems(items) {
    var picks = items.filter(function (it) { return it._bundleable; });
    var rest  = items.filter(function (it) { return !it._bundleable; });
    if (!picks.length) return Promise.resolve(items);

    /* Loop's internal Bundles SDK endpoint — same call Loop's own bundle page
       uses, verified by capturing the request from livefortified.com/a/loop_
       subscriptions/bundle/{...}. Takes Loop's INTERNAL numeric IDs (not
       Shopify IDs, not the hex slug). Response:
         { message: "Transaction created successfully",
           data: { loopBundleGuid: "01K..." } }
       We stamp the ULID onto every pouch line so Loop's order webhook
       groups them into one editable bundle subscription. Anonymous endpoint,
       no Authorization header. */
    var body = {
      bundleId:         parseInt(LOOP_BUNDLE.bundleId, 10),
      bundleVariantId:  parseInt(LOOP_BUNDLE.bundleVariantId, 10)  || null,
      bundleDiscountId: parseInt(LOOP_BUNDLE.bundleDiscountId, 10) || null,
      sellingPlanId:    parseInt(LOOP_BUNDLE.apiSellingPlanId, 10)
    };

    return fetch('https://bundle.loopwork.co/api/transactions/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
      .then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (b) {
          if (!r.ok) {
            var msg = (b && (b.message || b.error)) || ('HTTP ' + r.status);
            throw new Error('Loop bundle API error ' + r.status + ': ' + msg);
          }
          return b;
        });
      })
      .then(function (b) {
        try { console.log('[FORTIFIED] Loop bundle API raw response:', b); } catch (_) {}
        var txn = extractBundleTxnId(b);
        if (!txn) throw new Error('Loop response missing transaction id (keys: ' + Object.keys(b || {}).join(',') + ')');
        var cartPlanId = parseInt(LOOP_BUNDLE.cartSellingPlanId, 10);
        var key = LOOP_BUNDLE.propKey || '_bundleId';
        try { console.log('[FORTIFIED] Loop bundle transaction created:', txn); } catch (_) {}
        picks.forEach(function (it) {
          it.properties = it.properties || {};
          /* Underscored key = hidden from checkout customer view but on order.
             Loop's order webhook reads this to group lines into one bundle. */
          it.properties[key] = String(txn);
          /* Visible bundle name matches what Loop's own bundle page sets. */
          if (LOOP_BUNDLE.bundleName) it.properties.bundleName = LOOP_BUNDLE.bundleName;
          /* Shopify selling plan on each line drives the discount + recurrence. */
          if (cartPlanId) it.selling_plan = cartPlanId;
        });
        return picks.concat(rest);
      });
  }

  function addToCart(oneTime) {
    setMsg('');
    if (!oneTime && !state.purchaseType) { setMsg('Please choose a plan.', true); return; }
    var items = buildItems(oneTime);
    if (!items) { setMsg(oneTime ? 'Select a function and flavor first.' : 'Please complete every pouch (function + flavor).', true); return; }

    atcBtn.classList.add('is-loading'); setAtcEnabled(false);
    pushEvent('fe_add_to_cart_attempt', { purchase_type: oneTime ? 'onetime' : state.purchaseType, lines: items.length });

    /* Horizon pattern: collect every cart-items-component's section id so
       /cart/add.js returns the freshly rendered HTML, then dispatch a
       cart:update event so the drawer (and any cart-items-component on
       the page) re-renders without a reload. */
    var sectionIds = [];
    document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
      sectionIds.push(el.dataset.sectionId);
    });

    var proceed = function (finalItems) {
      finalItems.forEach(function (it) { delete it._bundleable; delete it._label; });
      var payload = { items: finalItems };
      if (sectionIds.length) payload.sections = sectionIds.join(',');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
        .then(function (resp) {
          if (!resp.ok) { throw new Error((resp.body && (resp.body.description || resp.body.message)) || 'Cart error'); }
          var addResponse = resp.body;
          return fetch('/cart.js').then(function (x) { return x.json(); }).then(function (cart) {
            return { cart: cart, sections: addResponse.sections || null };
          });
        })
        .then(function (data) {
          var cart = data.cart;
          var sections = data.sections;
          var totalQty = finalItems.reduce(function (sum, it) { return sum + (it.quantity || 1); }, 0);

          /* Dispatch Horizon's cart:update event so cart-items-component re-renders */
          var evt = new Event('cart:update', { bubbles: true });
          evt.detail = {
            resource: cart,
            sourceId: 'fe-' + SID,
            data: {
              source: 'fortified-product-selector',
              itemCount: totalQty,
              sections: sections
            }
          };
          document.dispatchEvent(evt);

          /* Open the cart drawer if it exists */
          var drawer = document.querySelector('cart-drawer-component');
          if (drawer && typeof drawer.open === 'function') drawer.open();

          pushEvent('fe_add_to_cart_success', { purchase_type: oneTime ? 'onetime' : state.purchaseType });
        })
        .catch(function (err) { setMsg(err.message || 'Something went wrong. Please try again.', true); pushEvent('fe_add_to_cart_error', { error: err.message }); })
        .finally(function () { atcBtn.classList.remove('is-loading'); recompute(); });
    };

    if (LOOP_BUNDLE_ON && !oneTime && state.purchaseType === 'quarterly') {
      try { console.log('[FORTIFIED] Loop bundle mode active - posting to https://bundle.loopwork.co/api/transactions/create'); } catch (_) {}
      loopBundleItems(items).then(proceed, function (err) {
        /* Loop unreachable or misconfigured: fall back to individual
           subscription lines so the sale is never lost. */
        try { console.warn('[FORTIFIED] Loop bundle API failed, falling back to per-pouch subs. Error:', err); } catch (_) {}
        pushEvent('fe_loop_bundle_fallback', { error: String((err && err.message) || err) });
        proceed(items);
      });
    } else {
      proceed(items);
    }
  }

  if (atcBtn) atcBtn.addEventListener('click', function () { addToCart(false); });
  if (oneTimeBtn && oneTimeBtn.dataset.static !== 'true') oneTimeBtn.addEventListener('click', function () { addToCart(true); });

  /* Eager-load the dedicated one-time product so prices are ready before the
     customer picks the One Time plan. Pre-seed the flavor from the first option. */
  if (ONETIME_HANDLE) {
    var firstOtFlavorBtn = root.querySelector('.fe-flavor-opt[data-onetime-variant-id]');
    if (firstOtFlavorBtn) slots.onetime.flavorName = firstOtFlavorBtn.dataset.flavorName;
    loadSlotProduct('onetime');
  }
  if (SIMPLE_SUBS) {
    loadSlotProduct('monthly');
  }
  if (SIMPLE_SUBS_Q) {
    for (var nn = 1; nn <= BUNDLE_COUNT; nn++) loadSlotProduct('q' + nn);
  }

})();
</script>

<script>
(function () {
  'use strict';
  var SID = {{ sid | json }};
  var root = document.getElementById('fe-' + SID);
  if (!root) return;
  var bar = document.getElementById('fe-stickybar-' + SID);
  var realBtn = document.getElementById('fe-atc-' + SID);
  if (!bar || !realBtn) return;
  var realTotal = document.getElementById('fe-atc-total-' + SID);
  var realCounter = document.getElementById('fe-counter-' + SID);
  var buildGroup = document.getElementById('fe-build-group-' + SID);
  var sbBtn = document.getElementById('fe-sb-atc-' + SID);
  var sbTotal = document.getElementById('fe-sb-total-' + SID);
  var sbCounter = document.getElementById('fe-sb-counter-' + SID);

  function sync() {
    var off = realBtn.hasAttribute('disabled') || realBtn.getAttribute('aria-disabled') === 'true';
    if (off) { sbBtn.setAttribute('disabled', ''); sbBtn.setAttribute('aria-disabled', 'true'); }
    else { sbBtn.removeAttribute('disabled'); sbBtn.removeAttribute('aria-disabled'); }
    if (sbTotal) { sbTotal.textContent = realTotal ? realTotal.textContent.replace(/^[\s·•]+/, '') : ''; }
    if (sbCounter && realCounter) { sbCounter.textContent = realCounter.textContent || ''; }
  }

  sbBtn.addEventListener('click', function () { realBtn.click(); });

  if (window.MutationObserver) {
    var mo = new MutationObserver(sync);
    mo.observe(realBtn, { attributes: true, attributeFilter: ['disabled', 'aria-disabled'] });
    if (realTotal) mo.observe(realTotal, { childList: true, characterData: true, subtree: true });
    if (realCounter) mo.observe(realCounter, { childList: true, characterData: true, subtree: true });
    if (buildGroup) {
      var bo = new MutationObserver(function () {
        if (!buildGroup.classList.contains('fe-step--locked') && window.matchMedia('(max-width: 899px)').matches) {
          try { buildGroup.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) {}
        }
      });
      bo.observe(buildGroup, { attributes: true, attributeFilter: ['class'] });
    }
  }

  if (window.IntersectionObserver) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { bar.classList.toggle('is-onscreen', e.isIntersecting); });
    }, { rootMargin: '0px 0px -45% 0px' });
    io.observe(root);
  } else {
    bar.classList.add('is-onscreen');
  }

  sync();
})();
</script>

