      <span class="fe-stickybar-counter" id="fe-sb-counter-{{ sid }}"></span>
      <span class="fe-stickybar-total" id="fe-sb-total-{{ sid }}" data-empty="{{ block.settings.plan_step_label | default: 'Choose your plan' | escape }}"></span>
    </div>
    <button type="button" class="fe-stickybar-btn" id="fe-sb-atc-{{ sid }}" disabled aria-disabled="true">{{ block.settings.atc_label | default: 'Add to Cart' }}</button>
  </div>
</div>

