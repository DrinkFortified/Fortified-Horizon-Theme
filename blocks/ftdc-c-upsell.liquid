{% comment %}
  Theme block: FTD-C Upsell
  Stores one custom upsell for the FTD Product Selector C family.
  Renders nothing visible — the parent selector reads block.settings.
{% endcomment %}

<div style="display:none" data-ftdc-c="upsell" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "FTD-C Upsell",
  "tag": null,
  "settings": [
    { "type": "text",         "id": "title",         "label": "Title",                                          "default": "Add-on" },
    { "type": "text",         "id": "description",   "label": "Description",                                    "default": "-" },
    { "type": "image_picker", "id": "image",         "label": "Image (override)" },
    { "type": "product",      "id": "product",       "label": "Product" },
    { "type": "text",         "id": "price_text",    "label": "Price (display, optional)",                      "default": "-" },
    { "type": "text",         "id": "was_text",      "label": "Compare-at (display, optional)",                 "default": "-" },
    { "type": "text",         "id": "plans_allowed", "label": "Plans to show on (comma-separated)",             "default": "onetime,monthly,quarterly", "info": "Use any of: onetime, monthly, quarterly. Comma-separated. Default = all." }
  ]
}
{% endschema %}
