
{% liquid
  assign block_settings = block.settings

  assign has_desktop = false
  if block_settings.desktop_video != blank
    assign has_desktop = true
  endif

  assign has_mobile = false
  if block_settings.mobile_video != blank
    assign has_mobile = true
  endif

  assign swap = false
  if has_desktop and has_mobile
    assign swap = true
  endif

  assign controls = block_settings.show_controls

  assign muted = false
  if block_settings.video_autoplay
    assign muted = true
  endif
%}

{% capture class %}
  video-responsive video-responsive--{{ block.id }} spacing-style size-style{% if swap %} video-responsive--swap{% endif %}
{% endcapture %}

{% capture style %}
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

<div
  class="{{ class }}"
  style="{{ style }}"
  {{ block.shopify_attributes }}
>
  {%- if has_desktop -%}
    {{
      block_settings.desktop_video
      | video_tag:
        class: 'video-responsive__media video-responsive__media--desktop border-style',
        autoplay: block_settings.video_autoplay,
        loop: block_settings.video_loop,
        muted: muted,
        controls: controls,
        image_size: '1920x'
    }}
  {%- endif -%}

  {%- if has_mobile -%}
    {{
      block_settings.mobile_video
      | video_tag:
        class: 'video-responsive__media video-responsive__media--mobile border-style',
        autoplay: block_settings.video_autoplay,
        loop: block_settings.video_loop,
        muted: muted,
        controls: controls,
        image_size: '1280x'
    }}
  {%- endif -%}

  {%- unless has_desktop or has_mobile -%}
    <div class="video-responsive__placeholder border-style">
      {{ 'hero-apparel-3' | placeholder_svg_tag }}
    </div>
  {%- endunless -%}
</div>

{% stylesheet %}
  .video-responsive {
    display: flex;
    justify-content: var(--horizontal-alignment, center);
    width: 100%;
  }

  .video-responsive__media,
  .video-responsive__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .video-responsive__placeholder svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Only swap when both videos exist; otherwise the single video shows
     at every breakpoint. */
  .video-responsive--swap .video-responsive__media--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .video-responsive--swap .video-responsive__media--desktop {
      display: none;
    }

    .video-responsive--swap .video-responsive__media--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video Responsive",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video",
      "info": "Shown on mobile (≤749px). If empty, the desktop video is used on all screens."
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay (muted)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Video Responsive",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
