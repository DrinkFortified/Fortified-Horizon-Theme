{% render 'fortified-base' %}

<div
  class="fortified-ingredients color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="fortified-container fortified-ingredients__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank %}
      <header class="fortified-ingredients__header">
        {% if block.settings.eyebrow != blank %}
          <span class="fortified-eyebrow">{{ block.settings.eyebrow }}</span>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h2 class="fortified-heading fortified-h2">{{ block.settings.heading }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="fortified-ingredients__grid">
      {% for i in (1..4) %}
        {%- assign img_key = 'pillar_' | append: i | append: '_image' -%}
        {%- assign title_key = 'pillar_' | append: i | append: '_title' -%}
        {%- assign text_key = 'pillar_' | append: i | append: '_text' -%}
        {%- assign img = block.settings[img_key] -%}
        {%- assign title = block.settings[title_key] -%}
        {%- assign text = block.settings[text_key] -%}
        {% if img != blank or title != blank or text != blank %}
          <article class="fortified-ingredients__panel">
            <div class="fortified-ingredients__media">
              {% if img != blank %}
                {{ img | image_url: width: 600 | image_tag:
                    widths: '200, 400, 600',
                    sizes: '(min-width: 1024px) 22vw, (min-width: 750px) 45vw, 90vw',
                    class: 'fortified-ingredients__img',
                    alt: img.alt | default: title,
                    loading: 'lazy' }}
              {% else %}
                <div class="fortified-ingredients__placeholder">{{ 'product-1' | placeholder_svg_tag: 'fortified-ingredients__placeholder-svg' }}</div>
              {% endif %}
            </div>
            <div class="fortified-ingredients__body">
              {% if title != blank %}
                <h3 class="fortified-ingredients__name">{{ title }}</h3>
              {% endif %}
              {% if text != blank %}
                <p class="fortified-ingredients__desc">{{ text }}</p>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.cta_label != blank %}
      <div class="fortified-ingredients__cta">
        <a href="{{ block.settings.cta_url | default: '#' }}" class="fortified-btn fortified-btn--primary">{{ block.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .fortified-ingredients {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #0A0A0A);
    padding-block: var(--fortified-section-py);
  }
  .fortified-ingredients__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 3vw, 40px);
  }
  .fortified-ingredients__header { text-align: center; max-width: 800px; }
  .fortified-ingredients__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    width: 100%;
  }
  @media (min-width: 750px) {
    .fortified-ingredients__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .fortified-ingredients__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .fortified-ingredients__panel {
    background: var(--fortified-off-white);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fortified-ingredients__img,
  .fortified-ingredients__placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
  }
  .fortified-ingredients__placeholder-svg {
    width: 100%;
    height: 100%;
    color: var(--fortified-gray-light);
  }
  .fortified-ingredients__name {
    font-family: var(--font-fortified-display);
    font-size: 22px;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .fortified-ingredients__desc {
    font-family: var(--font-fortified-body);
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    opacity: .85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fortified Ingredients Pillars",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE TRUTH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FORMULATED FOR PERFORMANCE" },
    { "type": "header", "content": "Pillar 1" },
    { "type": "image_picker", "id": "pillar_1_image", "label": "Icon" },
    { "type": "text", "id": "pillar_1_title", "label": "Title", "default": "Sodium Citrate" },
    { "type": "textarea", "id": "pillar_1_text", "label": "Description" },
    { "type": "header", "content": "Pillar 2" },
    { "type": "image_picker", "id": "pillar_2_image", "label": "Icon" },
    { "type": "text", "id": "pillar_2_title", "label": "Title", "default": "Magnesium Glycinate" },
    { "type": "textarea", "id": "pillar_2_text", "label": "Description" },
    { "type": "header", "content": "Pillar 3" },
    { "type": "image_picker", "id": "pillar_3_image", "label": "Icon" },
    { "type": "text", "id": "pillar_3_title", "label": "Title", "default": "Potassium" },
    { "type": "textarea", "id": "pillar_3_text", "label": "Description" },
    { "type": "header", "content": "Pillar 4" },
    { "type": "image_picker", "id": "pillar_4_image", "label": "Icon" },
    { "type": "text", "id": "pillar_4_title", "label": "Title", "default": "Creatine" },
    { "type": "textarea", "id": "pillar_4_text", "label": "Description" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "SHOP FORTIFIED NOW" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Fortified Ingredients Pillars", "category": "Fortified" }
  ]
}
{% endschema %}
